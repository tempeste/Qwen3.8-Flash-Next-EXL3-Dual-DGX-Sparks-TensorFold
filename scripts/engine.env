# The engine settings this recipe serves with: every TENSORFOLD_*, TF_FLASHNEXT_* and TF_EXL3_* variable (and the one
# NCCL setting) of the deployment these patches were built for and measured on, with the same values. start.sh passes
# each line to both ranks as a container environment variable (the ranks compare their settings when they connect).
#
# One KEY=VALUE a line, plain values only (letters, digits and _ . , : / + = -). Override a line from the environment,
# scripts/local.sh or .env (they win over this file); drop one with ENGINE_UNSET="KEY1 KEY2" (scripts/config.sh).
# Every flag is described in the patch that adds it (its message lists "Flags this patch adds"); the groups below name it.
# Some of these paths are relaxed rather than bit-exact (TP_PROMPT_RELAXED, GDN_CHUNK_RELAXED, TP_SCATTER_BF16,
# MIXED_BESIDE_PACK_ANY, REPLY_KEEP) and EXPERT_REROUTE changes replies: production accepted each on quality evals
# (README, "What the defaults are").
#
# Not set here: TF_FLASHNEXT_EXPERTS_TOPK, the five-expert switch (off; README, "Five experts").

# TensorFold's own settings (in the base tree): the memory reserve, vision budgets, the draft chain's length and
# confidence, sampled streams in the batched draft head, the shared expert on its own stream, the LM head split by
# vocabulary columns; NCCL_MAX_NCHANNELS is read by NCCL itself on both ranks. Five of these have no reader in the
# patched tree, so they change nothing: TENSORFOLD_MAX_IMAGES, TENSORFOLD_IMAGE_TOKENS and
# TENSORFOLD_VISION_WORKSPACE_MIB (this engine decodes images natively; the --vision-* arguments start.sh passes set the
# budgets), TF_FLASHNEXT_GATHER_READ and TF_FLASHNEXT_PROMPT_EXPERT_TILE_ROWS. They stay so the set is exactly the one
# the measurements in the README ran with.
TENSORFOLD_NO_UPDATE_CHECK=1
TENSORFOLD_MEMORY_RESERVE_GIB=3
TENSORFOLD_MAX_IMAGES=50
TENSORFOLD_IMAGE_TOKENS=16384
TENSORFOLD_VIDEO_TOKENS=16384
TENSORFOLD_VISION_WORKSPACE_MIB=2048
TF_FLASHNEXT_CONFIDENCE=-0.4
TF_FLASHNEXT_DRAFTS=6
TF_FLASHNEXT_SAMPLED_HEADS=1
TF_FLASHNEXT_GATHER_READ=pread
TF_FLASHNEXT_PROMPT_EXPERT_TILE_ROWS=256
TF_FLASHNEXT_SHARED_SIDE=1
NCCL_MAX_NCHANNELS=4
TF_FLASHNEXT_SHARD_HEAD=1

# patches/0002: sampled-candidate draws, n-gram gathers, host draw threads, the draft stop rule, prompt HC read-out and
# prompt tiles, the shared memory pool (TENSORFOLD_MEMORY_FLOOR_GIB is its floor) and YaRN (factor 2: 2 x 262,144 = 524,288
# positions, enough for CONTEXT=409600).
TENSORFOLD_MEMORY_FLOOR_GIB=5
TF_FLASHNEXT_PRODUCT_STREAMS=5
TF_FLASHNEXT_SAMPLE_CAND=1
TF_FLASHNEXT_GATHER_EARLY=1
TF_FLASHNEXT_HOST_DRAW_THREADS=7
TF_FLASHNEXT_PROMPT_HC2=1
TF_FLASHNEXT_PROMPT_SHARED_DIRECT=1
TF_FLASHNEXT_HEAD_PIECE=1536
TF_FLASHNEXT_PROMPT_GEMM2=1
TF_FLASHNEXT_HC2_MIN=256
TF_FLASHNEXT_YARN=2
TF_FLASHNEXT_SHARED_POOL=1

# patches/0003: --tp 2 collectives (async NCCL, the one-shot RoCE exchange, fused and partial MoE sums), shared decode
# rounds (DeltaNet lanes, draft lanes, rows a stream), prompt tails and solo chunks, kept-state head restores.
TF_FLASHNEXT_DRAFT_AHEAD=1
TF_FLASHNEXT_PREFILL_TAIL=512
TF_FLASHNEXT_GDN_LANES=1
TF_FLASHNEXT_TP_ASYNC_COLL=1
TF_FLASHNEXT_DRAFT_LANES=32
TF_FLASHNEXT_GDN_LANE_GROUPS=1
TF_FLASHNEXT_ROUND_ROWS_PER_STREAM=3
TF_FLASHNEXT_TP_MOE_PARTIAL=1
TF_FLASHNEXT_TP_PROMPT_RELAXED=1
TF_FLASHNEXT_TP_HEAD_ONCE=1
TF_FLASHNEXT_TP_FUSE_REDUCE=2
TF_FLASHNEXT_TP_MOE_OWN=1
TF_FLASHNEXT_TP_SHARED_SLOT=1
TF_FLASHNEXT_RESTORE_HEAD_KV=1
TF_FLASHNEXT_TP_ROCE=1
TF_FLASHNEXT_CHUNK_SOLO=3072
TF_FLASHNEXT_TP_ROCE_MAX_KB=16384

# patches/0004: the routed experts from the EXL3 experts-only folder. TF_FLASHNEXT_EXPERTS_EXL3 is a path inside the
# containers; start.sh sets it from EXL3_PACK (scripts/config.sh), so the value here is a placeholder and is replaced.
TF_FLASHNEXT_EXPERTS_EXL3=/root/.cache/huggingface/EXL3_PACK
TF_FLASHNEXT_EXPERTS_EXL3_LAYERS=all
TF_EXL3_PROMPT_ROWS=1

# patches/0005: --tp 2 prompt passes (sequence-parallel layers, split sums, indexer row halves, the MTP head on a side
# stream), wide HC tiles, MMA index scores, chunked DeltaNet, prompt lookup drafts, kept batches, shared-prefix keeps.
TF_FLASHNEXT_TP_SPLIT_SUM=1
TF_FLASHNEXT_PROMPT_LOOKUP=1
TF_FLASHNEXT_TP_SEQPAR=1
TF_FLASHNEXT_TP_INDEX_ROWS=1
TF_FLASHNEXT_TP_MTP_SIDE=1
TF_FLASHNEXT_HC_WIDE=1
TF_FLASHNEXT_INDEX_MMA=1
TF_FLASHNEXT_TP_KEEP_BATCH=1
TF_FLASHNEXT_GDN_CHUNKED=1
TENSORFOLD_PCACHE_SHARED_MIN=4096

# patches/0006: the prompt pipeline (overlap, prompt frames, gather and index ahead, keep frames), visit budgets and the
# decode/prefill share, n-gram warm-ahead, lane tiles.
TF_FLASHNEXT_WARM_AHEAD=1
TF_FLASHNEXT_KEEP_LANES=1
TF_FLASHNEXT_MTP_PROMPT=1
TF_FLASHNEXT_TP_PROMPT_FRAME=1
TF_FLASHNEXT_TP_SCATTER_BF16=1
TF_FLASHNEXT_LANE_TILE=1
TF_FLASHNEXT_PROMPT_MX_PERM=1
TF_FLASHNEXT_TP_GATHER_AHEAD=1
TF_FLASHNEXT_TP_SEQ_KEEP=1
TF_FLASHNEXT_TP_FRAME_FIRST=1
TF_FLASHNEXT_TP_KEEP_EARLY=1
TF_FLASHNEXT_TP_KEEP_LATE=1
TENSORFOLD_PREFILL_VISIT_MS=800
TENSORFOLD_PREFILL_SHARE=0.8
TENSORFOLD_PREFILL_SHARE_SHORT=1
TF_FLASHNEXT_ATTN_LANES_ANY=1
TF_FLASHNEXT_OVERLAP=4096
TF_FLASHNEXT_WARM_BESIDE=1
TF_FLASHNEXT_TP_INDEX_AHEAD=1
TF_FLASHNEXT_GDN_YS_BF16=1

# patches/0007: batched draft and verify picks, early and split snapshots, marks inside a pass, mixed rounds (a prompt piece
# rides a decode round), route beside, prompt dtiles, shared kept rows in the prompt cache.
TF_FLASHNEXT_MTP_CACHE_ONLY=1
TF_FLASHNEXT_SNAP_EARLY=1
TF_FLASHNEXT_SNAP_SPLIT=1
TF_FLASHNEXT_MARK_IN_PASS=64
TF_FLASHNEXT_DRAFT_PICK_BATCH=1
TF_FLASHNEXT_VERIFY_PICK_BATCH=1
TF_FLASHNEXT_HC_DECODE_SPLIT=1
TF_FLASHNEXT_PCACHE_EXPLAIN=1
TF_FLASHNEXT_TP_SEQPAR_EXACT=1
TF_FLASHNEXT_MIXED_LAST=1
TF_FLASHNEXT_MIXED_SEQPAR=1
TF_FLASHNEXT_MIXED_RIDE_FAST=1
TF_FLASHNEXT_TP_ROUTE_BESIDE=1
TF_FLASHNEXT_PROMPT_DTILE=1
TF_FLASHNEXT_PCACHE_SHARE=1

# patches/0029: relaxed DeltaNet paths (compact, wide lanes, bf16 readouts, relaxed chunk products) and prompt pieces
# beside decode rounds (MIXED_BESIDE, its smallest piece).
TF_FLASHNEXT_GDN_COMPACT=1
TF_FLASHNEXT_GDN_LANES_WIDE=1
TF_FLASHNEXT_GDN_CHUNK_RELAXED=1
TF_FLASHNEXT_Y_BF16=1
TF_FLASHNEXT_MIXED_BESIDE=1
TF_FLASHNEXT_MIXED_BESIDE_MIN=512

# patches/0030: picture prompts at text speed and skipping kept pictures, whole prompts beside, and expert re-route
# (5,24,8: from 8 streams each row keeps its top 5 experts and fills its other 5 slots from experts other rows picked,
# within its own top 24; this changes replies).
TF_FLASHNEXT_IMAGE_FAST=1
TF_FLASHNEXT_IMAGE_SKIP_KEPT=1
TF_FLASHNEXT_EXPERT_REROUTE=5,24,8
TF_FLASHNEXT_MIXED_BESIDE_WHOLE=1

# patches/0031: LATE_SKIP (short drafted windows skip DeltaNet end-state writes) and beside packing (PACK, PACK_ANY: a
# beside pass may take a second waiting prompt's piece; PACK_ANY is relaxed above 1,536 rows).
TF_FLASHNEXT_LATE_SKIP=16
TF_FLASHNEXT_MIXED_BESIDE_PACK=2944
TF_FLASHNEXT_MIXED_BESIDE_PACK_ANY=1

# patches/0032: reply-keep (a finished reply keeps its lane's state for the next turn; relaxed).
TF_FLASHNEXT_REPLY_KEEP=1
