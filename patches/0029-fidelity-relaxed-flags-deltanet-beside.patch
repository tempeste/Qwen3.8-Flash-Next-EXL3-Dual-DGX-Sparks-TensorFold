+    const h: Heads = .half;
+    const ms = @as(f64, g3.layers) / 1000;
+    const sets = [2]chunk.Fns{ try chunk.Fns.loadWith(batch, "_h8", tri_variants[0].o), try chunk.Fns.loadWith(batch, "_h8", withTri(tri_variants[0].o)) };
+    for (rows) |m| {
+        var r = try Rig.init(gpu, arena.allocator(), prng.random());
+        defer r.deinit();
+        const in = try g3.inputs(&r, h, m, .fast);
+        const Block = struct {
+            f: *const lay.Fns,
+            c: *const chunk.Fns,
+            in: [7]u64,
+            x: g3.Scan,
+            o: g3.Out,
+            m: usize,
+            pub fn go(t: @This(), rr: *Rig) !void {
+                try g3.block(rr, t.f, t.c, .half, t.m, t.in, t.o.st, t.x, t.o);
+            }
+        };
+        const Pair = struct {
+            c: *const chunk.Fns,
+            x: g3.Scan,
+            o: g3.Out,
+            m: usize,
+            in: [7]u64,
+            pub fn go(t: @This(), rr: *Rig) !void {
+                try chunk.launchAt(t.c, rr.s, .half, t.m, t.x.qn, t.x.kn, t.x.v, t.x.gb, t.o.st, t.o.st, t.o.wy, 0, .{ .proj = t.in[0], .norm_w = t.in[5], .out = t.o.out, .xs = t.o.xs });
+            }
+        };
+        var blk: [2]f64 = undefined;
+        var ps: [2]f64 = undefined;
+        for (&sets, 0..) |*c, j| {
+            const x = try g3.scan(&r, h, m);
+            const o = try g3.outs(&r, h, m, 2);
+            const b: Block = .{ .f = &f, .c = c, .in = in, .x = x, .o = o, .m = m };
