+test "fidelity gate: twice the floor passes, ten times fails, a top-1 or acceptance drop fails, non-finite fails" {
+    const gpa = std.testing.allocator;
+    const n = 200;
+    var kinds: [n]Row = undefined;
+    var floor_kl: [n]f64 = undefined;
+    var near_kl: [n]f64 = undefined;
+    var far_kl: [n]f64 = undefined;
+    var all_top: [n]bool = @splat(true);
+    var drop_top: [n]bool = @splat(true);
+    var acc: [n]bool = undefined;
+    var acc_drop: [n]bool = undefined;
+    for (0..n) |i| {
+        kinds[i] = .{ .kind = if (i < n / 2) .prompt else .decode, .context = 1, .pos = @intCast(i) };
+        floor_kl[i] = 1e-3 * @as(f64, @floatFromInt(1 + i % 7));
+        near_kl[i] = 1.5 * floor_kl[i];
+        far_kl[i] = 10 * floor_kl[i];
+        drop_top[i] = i % 10 != 0;
+        acc[i] = i % 3 != 0;
+        acc_drop[i] = acc[i] and i % 5 != 0;
+    }
+    var floor = try testPerRow(gpa, &floor_kl, &all_top, &acc, &acc);
+    defer floor.deinit(gpa);
+    var near = try testPerRow(gpa, &near_kl, &all_top, &acc, &acc);
+    defer near.deinit(gpa);
+    var far = try testPerRow(gpa, &far_kl, &all_top, &acc, &acc);
+    defer far.deinit(gpa);
+    var top_drop = try testPerRow(gpa, &near_kl, &drop_top, &acc, &acc);
+    defer top_drop.deinit(gpa);
+    var acc_worse = try testPerRow(gpa, &near_kl, &all_top, &acc_drop, &acc);
+    defer acc_worse.deinit(gpa);
+    const ok = try gate(gpa, near, floor, &kinds, 0, n, 2, 2000, 1);
+    try std.testing.expect(ok.passed());
+    try std.testing.expect(ok.kl_arm.lo <= ok.kl_arm.mid and ok.kl_arm.mid <= ok.kl_arm.hi);
+    const bad = try gate(gpa, far, floor, &kinds, 0, n, 2, 2000, 1);
+    try std.testing.expect(bad.fail_kl and !bad.passed());
+    const tb = try gate(gpa, top_drop, floor, &kinds, 0, n, 2, 2000, 1);
+    try std.testing.expect(tb.fail_top1 and !tb.fail_kl);
+    const ab = try gate(gpa, acc_worse, floor, &kinds, 0, n, 2, 2000, 1);
+    try std.testing.expect(ab.fail_accept and !ab.fail_top1);
+    const pr = try gate(gpa, acc_worse, floor, &kinds, 0, n / 2, 2, 2000, 1);
+    try std.testing.expect(pr.accept_margin == null and pr.passed());
+    near.finite[3] = false;
+    const nf = try gate(gpa, near, floor, &kinds, 0, n, 2, 2000, 1);
+    try std.testing.expect(nf.nonfinite == 1 and !nf.passed());
+}
