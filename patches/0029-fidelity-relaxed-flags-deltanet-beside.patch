diff --git a/zig/src/families/flashnext/cuda_fidelity.zig b/zig/src/families/flashnext/cuda_fidelity.zig
new file mode 100644
index 0000000000000000000000000000000000000000..67288750cddd40c00cd98bc98f9d4593b1353661
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_fidelity.zig
@@ -0,0 +1,605 @@
+const std = @import("std");
+
+pub const default_contexts = [_]usize{ 2048, 20480, 102400, 204800 };
+pub const default_steps: usize = 64;
+pub const default_piece: usize = 3072;
+pub const default_factor: f64 = 2.0;
+pub const default_resamples: usize = 10000;
+pub const default_seed: u64 = 3970;
+pub const margin_pp: f64 = 2.0;
+pub const header = "fidelity-relax v1";
+
+pub const Kind = enum { prompt, decode };
+
+pub const Row = struct {
+    kind: Kind,
+    context: u32,
+    pos: u32,
+    draft_top: u32 = 0,
+};
+
+pub const Error = error{ BadFidelityList, BadFidelityIndex, FidelityRowsDiffer };
+
+pub fn contextsFrom(gpa: std.mem.Allocator, v: ?[]const u8) ![]usize {
+    const text = v orelse return gpa.dupe(usize, &default_contexts);
+    var out: std.ArrayList(usize) = .empty;
+    errdefer out.deinit(gpa);
+    var it = std.mem.splitScalar(u8, text, ',');
+    while (it.next()) |w| {
+        const c = std.fmt.parseInt(usize, w, 10) catch return error.BadFidelityList;
+        if (c < 2 or (out.items.len > 0 and c <= out.items[out.items.len - 1])) return error.BadFidelityList;
+        try out.append(gpa, c);
+    }
+    if (out.items.len == 0) return error.BadFidelityList;
+    return out.toOwnedSlice(gpa);
+}
+
+pub fn countFrom(v: ?[]const u8, default: usize, max: usize) error{BadFidelityList}!usize {
+    const text = v orelse return default;
+    const n = std.fmt.parseInt(usize, text, 10) catch return error.BadFidelityList;
+    if (n == 0 or n > max) return error.BadFidelityList;
+    return n;
+}
+
+pub fn factorFrom(v: ?[]const u8) error{BadFidelityList}!f64 {
+    const text = v orelse return default_factor;
+    const f = std.fmt.parseFloat(f64, text) catch return error.BadFidelityList;
+    if (!std.math.isFinite(f) or f < 1.0) return error.BadFidelityList;
+    return f;
+}
+
+pub fn promptStops(gpa: std.mem.Allocator, context: usize, piece: usize) ![]usize {
+    var out: std.ArrayList(usize) = .empty;
+    errdefer out.deinit(gpa);
+    var at: usize = 0;
+    while (at < context) {
+        at = @min(context, at + piece);
+        try out.append(gpa, at);
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+pub fn bf16(v: u16) f64 {
+    return @as(f32, @bitCast(@as(u32, v) << 16));
+}
+
+pub fn argmax(row: []const u16) u32 {
+    var at: usize = 0;
+    var top = -std.math.inf(f64);
+    for (row, 0..) |x, i| {
+        const f = bf16(x);
+        if (f > top) {
+            top = f;
+            at = i;
+        }
+    }
+    return @intCast(at);
+}
+
+fn logSumExp(row: []const u16) ?struct { max: f64, lse: f64 } {
+    var top = -std.math.inf(f64);
+    for (row) |x| {
+        const f = bf16(x);
+        if (std.math.isNan(f) or f == std.math.inf(f64)) return null;
+        top = @max(top, f);
+    }
+    if (top == -std.math.inf(f64)) return null;
+    var sum: f64 = 0;
+    for (row) |x| sum += @exp(bf16(x) - top);
+    return .{ .max = top, .lse = top + @log(sum) };
+}
+
+pub const Dist = struct {
+    kl: f64,
+    tv: f64,
+    same_top: bool,
+    finite: bool,
+};
+
+pub fn compare(base: []const u16, arm: []const u16) Dist {
+    std.debug.assert(base.len == arm.len);
+    const same_top = argmax(base) == argmax(arm);
+    const a = logSumExp(base) orelse return .{ .kl = std.math.inf(f64), .tv = 1, .same_top = same_top, .finite = false };
+    const b = logSumExp(arm) orelse return .{ .kl = std.math.inf(f64), .tv = 1, .same_top = same_top, .finite = false };
+    var kl: f64 = 0;
+    var tv: f64 = 0;
+    for (base, arm) |x, y| {
+        const la = bf16(x) - a.lse;
+        const lb = bf16(y) - b.lse;
+        const pa = @exp(la);
+        const pb = @exp(lb);
+        tv += @abs(pa - pb);
+        if (pa > 0) kl += pa * (la - lb);
+    }
+    if (!std.math.isFinite(kl)) return .{ .kl = std.math.inf(f64), .tv = 0.5 * tv, .same_top = same_top, .finite = false };
+    return .{ .kl = @max(kl, 0), .tv = 0.5 * tv, .same_top = same_top, .finite = true };
+}
+
+pub fn formatRow(w: *std.Io.Writer, r: Row) !void {
+    try w.print("{s} {d} {d} {d}\n", .{ @tagName(r.kind), r.context, r.pos, r.draft_top });
+}
+
+pub const Index = struct {
+    vocab: usize,
+    draft_vocab: usize,
+    rows: []Row,
+
+    pub fn deinit(x: *Index, gpa: std.mem.Allocator) void {
+        gpa.free(x.rows);
+    }
+
+    pub fn decodeRows(x: Index) usize {
+        var n: usize = 0;
+        for (x.rows) |r| n += @intFromBool(r.kind == .decode);
+        return n;
+    }
+};
+
+pub fn parseIndex(gpa: std.mem.Allocator, text: []const u8) !Index {
+    var lines = std.mem.tokenizeScalar(u8, text, '\n');
+    const first = lines.next() orelse return error.BadFidelityIndex;
+    var head = std.mem.tokenizeScalar(u8, first, ' ');
+    const h0 = head.next() orelse return error.BadFidelityIndex;
+    const h1 = head.next() orelse return error.BadFidelityIndex;
+    if (!std.mem.eql(u8, h0, "fidelity-relax") or !std.mem.eql(u8, h1, "v1")) return error.BadFidelityIndex;
+    var vocab: usize = 0;
+    var draft_vocab: usize = 0;
+    var count: usize = 0;
+    while (head.next()) |key| {
+        const val = std.fmt.parseInt(usize, head.next() orelse return error.BadFidelityIndex, 10) catch return error.BadFidelityIndex;
+        if (std.mem.eql(u8, key, "vocab")) vocab = val else if (std.mem.eql(u8, key, "draft")) draft_vocab = val else if (std.mem.eql(u8, key, "rows")) count = val else return error.BadFidelityIndex;
+    }
+    if (vocab == 0 or draft_vocab == 0) return error.BadFidelityIndex;
+    var rows: std.ArrayList(Row) = .empty;
+    errdefer rows.deinit(gpa);
+    while (lines.next()) |line| {
+        var f = std.mem.tokenizeScalar(u8, line, ' ');
+        const kind = std.meta.stringToEnum(Kind, f.next() orelse return error.BadFidelityIndex) orelse return error.BadFidelityIndex;
+        var nums: [3]u32 = undefined;
+        for (&nums) |*n| n.* = std.fmt.parseInt(u32, f.next() orelse return error.BadFidelityIndex, 10) catch return error.BadFidelityIndex;
+        if (f.next() != null) return error.BadFidelityIndex;
+        try rows.append(gpa, .{ .kind = kind, .context = nums[0], .pos = nums[1], .draft_top = nums[2] });
+    }
+    if (rows.items.len != count) return error.BadFidelityIndex;
+    return .{ .vocab = vocab, .draft_vocab = draft_vocab, .rows = try rows.toOwnedSlice(gpa) };
+}
+
+pub fn sameRows(a: Index, b: Index) Error!void {
+    if (a.vocab != b.vocab or a.draft_vocab != b.draft_vocab or a.rows.len != b.rows.len) return error.FidelityRowsDiffer;
+    for (a.rows, b.rows) |x, y| if (x.kind != y.kind or x.context != y.context or x.pos != y.pos) return error.FidelityRowsDiffer;
+}
+
+pub const Group = struct {
+    kind: Kind,
+    context: u32,
+    first: usize,
+    count: usize,
+};
+
+pub fn groups(gpa: std.mem.Allocator, x: Index) ![]Group {
+    var out: std.ArrayList(Group) = .empty;
+    errdefer out.deinit(gpa);
+    for (x.rows, 0..) |r, i| {
+        if (out.items.len > 0) {
+            const g = &out.items[out.items.len - 1];
+            if (g.kind == r.kind and g.context == r.context and g.first + g.count == i) {
+                g.count += 1;
+                continue;
+            }
+        }
+        try out.append(gpa, .{ .kind = r.kind, .context = r.context, .first = i, .count = 1 });
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+pub const PerRow = struct {
+    kl: []f64,
+    tv: []f64,
+    top: []bool,
+    finite: []bool,
+    draft_kl: []f64,
+    accept_arm: []bool,
+    accept_base: []bool,
+
+    pub fn alloc(gpa: std.mem.Allocator, rows: usize) !PerRow {
+        var p: PerRow = undefined;
+        p.kl = try gpa.alloc(f64, rows);
+        errdefer gpa.free(p.kl);
+        p.tv = try gpa.alloc(f64, rows);
+        errdefer gpa.free(p.tv);
+        p.top = try gpa.alloc(bool, rows);
+        errdefer gpa.free(p.top);
+        p.finite = try gpa.alloc(bool, rows);
+        errdefer gpa.free(p.finite);
+        p.draft_kl = try gpa.alloc(f64, rows);
+        errdefer gpa.free(p.draft_kl);
+        p.accept_arm = try gpa.alloc(bool, rows);
+        errdefer gpa.free(p.accept_arm);
+        p.accept_base = try gpa.alloc(bool, rows);
+        @memset(p.draft_kl, 0);
+        @memset(p.accept_arm, false);
+        @memset(p.accept_base, false);
+        return p;
+    }
+
+    pub fn deinit(p: *PerRow, gpa: std.mem.Allocator) void {
+        inline for (.{ p.kl, p.tv, p.draft_kl }) |s| gpa.free(s);
+        inline for (.{ p.top, p.finite, p.accept_arm, p.accept_base }) |s| gpa.free(s);
+    }
+};
+
+pub fn perRow(gpa: std.mem.Allocator, base_idx: Index, arm_idx: Index, base_main: []const u16, arm_main: []const u16, base_draft: []const u16, arm_draft: []const u16) !PerRow {
+    try sameRows(base_idx, arm_idx);
+    const v = base_idx.vocab;
+    const dv = base_idx.draft_vocab;
+    const n = base_idx.rows.len;
+    const decodes = base_idx.decodeRows();
+    if (base_main.len != n * v or arm_main.len != n * v or base_draft.len != decodes * dv or arm_draft.len != decodes * dv) return error.FidelityRowsDiffer;
+    var p = try PerRow.alloc(gpa, n);
+    errdefer p.deinit(gpa);
+    var d: usize = 0;
+    for (base_idx.rows, arm_idx.rows, 0..) |rb, ra, i| {
+        const mb = base_main[i * v ..][0..v];
+        const ma = arm_main[i * v ..][0..v];
+        const c = compare(mb, ma);
+        p.kl[i] = c.kl;
+        p.tv[i] = c.tv;
+        p.top[i] = c.same_top;
+        p.finite[i] = c.finite;
+        if (rb.kind != .decode) continue;
+        const db = base_draft[d * dv ..][0..dv];
+        const da = arm_draft[d * dv ..][0..dv];
+        const dc = compare(db, da);
+        p.draft_kl[i] = dc.kl;
+        p.finite[i] = p.finite[i] and dc.finite;
+        p.accept_base[i] = rb.draft_top == argmax(mb);
+        p.accept_arm[i] = ra.draft_top == argmax(ma);
+        d += 1;
+    }
+    return p;
+}
+
+pub const Summary = struct {
+    rows: usize = 0,
+    kl_mean: f64 = 0,
+    kl_p99: f64 = 0,
+    kl_max: f64 = 0,
+    tv_mean: f64 = 0,
+    top1: f64 = 0,
+    nonfinite: usize = 0,
+    decode_rows: usize = 0,
+    draft_kl: f64 = 0,
+    accept_arm: f64 = 0,
+    accept_base: f64 = 0,
+};
+
+pub fn summarize(gpa: std.mem.Allocator, p: PerRow, kinds: []const Row, first: usize, count: usize) !Summary {
+    var s: Summary = .{ .rows = count };
+    if (count == 0) return s;
+    const kls = try gpa.alloc(f64, count);
+    defer gpa.free(kls);
+    var top: usize = 0;
+    var acc_a: usize = 0;
+    var acc_b: usize = 0;
+    for (first..first + count, 0..) |i, j| {
+        kls[j] = p.kl[i];
+        s.kl_mean += p.kl[i];
+        s.tv_mean += p.tv[i];
+        top += @intFromBool(p.top[i]);
+        s.nonfinite += @intFromBool(!p.finite[i]);
+        if (kinds[i].kind == .decode) {
+            s.decode_rows += 1;
+            s.draft_kl += p.draft_kl[i];
+            acc_a += @intFromBool(p.accept_arm[i]);
+            acc_b += @intFromBool(p.accept_base[i]);
+        }
+    }
+    const n: f64 = @floatFromInt(count);
+    s.kl_mean /= n;
+    s.tv_mean /= n;
+    s.top1 = 100 * @as(f64, @floatFromInt(top)) / n;
+    std.mem.sort(f64, kls, {}, std.sort.asc(f64));
+    s.kl_max = kls[count - 1];
+    s.kl_p99 = kls[@min(count - 1, (count * 99 + 99) / 100 - 1)];
+    if (s.decode_rows > 0) {
+        const m: f64 = @floatFromInt(s.decode_rows);
+        s.draft_kl /= m;
+        s.accept_arm = 100 * @as(f64, @floatFromInt(acc_a)) / m;
+        s.accept_base = 100 * @as(f64, @floatFromInt(acc_b)) / m;
+    }
+    return s;
+}
+
+pub const Interval = struct { lo: f64, mid: f64, hi: f64 };
+
+pub const Verdict = struct {
+    kl_arm: Interval,
+    kl_floor: Interval,
+    top1_margin: Interval,
+    accept_margin: ?Interval,
+    nonfinite: usize,
+    fail_kl: bool,
+    fail_top1: bool,
+    fail_accept: bool,
+
+    pub fn passed(v: Verdict) bool {
+        return !v.fail_kl and !v.fail_top1 and !v.fail_accept and v.nonfinite == 0;
+    }
+};
+
+fn percentile(sorted: []const f64, q: f64) f64 {
+    const at: usize = @intFromFloat(@floor(q * @as(f64, @floatFromInt(sorted.len - 1)) + 0.5));
+    return sorted[@min(at, sorted.len - 1)];
+}
+
+pub fn gate(gpa: std.mem.Allocator, arm: PerRow, floor: PerRow, kinds: []const Row, first: usize, count: usize, factor: f64, resamples: usize, seed: u64) !Verdict {
+    std.debug.assert(count > 0 and resamples > 1);
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rnd = prng.random();
+    const ka = try gpa.alloc(f64, resamples);
+    defer gpa.free(ka);
+    const kf = try gpa.alloc(f64, resamples);
+    defer gpa.free(kf);
+    const tm = try gpa.alloc(f64, resamples);
+    defer gpa.free(tm);
+    const am = try gpa.alloc(f64, resamples);
+    defer gpa.free(am);
+    var decodes: usize = 0;
+    var nonfinite: usize = 0;
+    for (first..first + count) |i| {
+        decodes += @intFromBool(kinds[i].kind == .decode);
+        nonfinite += @intFromBool(!arm.finite[i]);
+    }
+    for (0..resamples) |b| {
+        var sa: f64 = 0;
+        var sf: f64 = 0;
+        var t: f64 = 0;
+        var acc: f64 = 0;
+        var dn: f64 = 0;
+        for (0..count) |_| {
+            const i = first + rnd.uintLessThan(usize, count);
+            sa += if (arm.finite[i]) arm.kl[i] else 0;
+            sf += if (floor.finite[i]) floor.kl[i] else 0;
+            t += @as(f64, @floatFromInt(@intFromBool(arm.top[i]))) - @as(f64, @floatFromInt(@intFromBool(floor.top[i])));
+            if (kinds[i].kind == .decode) {
+                dn += 1;
+                acc += @as(f64, @floatFromInt(@intFromBool(arm.accept_arm[i]))) - @as(f64, @floatFromInt(@intFromBool(arm.accept_base[i])));
+            }
+        }
+        const n: f64 = @floatFromInt(count);
+        ka[b] = sa / n;
+        kf[b] = sf / n;
+        tm[b] = 100 * t / n;
+        am[b] = if (dn > 0) 100 * acc / dn else 0;
+    }
+    inline for (.{ ka, kf, tm, am }) |s| std.mem.sort(f64, s, {}, std.sort.asc(f64));
+    const iv = struct {
+        fn f(s: []const f64) Interval {
+            return .{ .lo = percentile(s, 0.025), .mid = percentile(s, 0.5), .hi = percentile(s, 0.975) };
+        }
+    }.f;
+    const kl_arm = iv(ka);
+    const kl_floor = iv(kf);
+    const top1_margin = iv(tm);
+    const accept_margin: ?Interval = if (decodes > 0) iv(am) else null;
+    return .{
+        .kl_arm = kl_arm,
+        .kl_floor = kl_floor,
+        .top1_margin = top1_margin,
+        .accept_margin = accept_margin,
+        .nonfinite = nonfinite,
+        .fail_kl = kl_arm.lo > factor * kl_floor.hi,
+        .fail_top1 = top1_margin.hi < -margin_pp,
+        .fail_accept = if (accept_margin) |m| m.hi < -margin_pp else false,
+    };
+}
+
+fn testRow(gpa: std.mem.Allocator, logits: []const f32) ![]u16 {
+    const out = try gpa.alloc(u16, logits.len);
+    for (out, logits) |*o, l| o.* = @truncate(@as(u32, @bitCast(l)) >> 16);
+    return out;
+}
