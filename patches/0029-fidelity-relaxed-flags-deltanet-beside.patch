+const wire = @import("cuda_rank_wire.zig");
+const Collective = @import("cuda_collective.zig").Collective;
+const Engine = prompt.Engine;
+const Seq = prompt.Seq;
+
+pub const Piece = struct { seq: *Seq, ids: []const u32, streams: u64 = 0, streams_free: ?cuda.Event = null, prompt: bool = true, last: bool = false };
+
+pub const channel_timeout_ms: u64 = 30_000;
+pub const now = wire.now;
+
+pub const Beside = struct {
+    gpa: std.mem.Allocator,
+    driver: *const cuda.Driver,
+    stream: cuda.Stream,
+    s: batch.Scratch,
+    k: batch.Kernels,
+    kit: ?*exl3x.Kit = null,
+    scores: cuda.DeviceBuffer,
+    score_cap: usize,
+    channel: ?Collective = null,
+    work: ?*Work = null,
+
+    pub fn init(e: *Engine, rows: usize, cap: usize) !*Beside {
+        if (rows == 0 or rows > batch.max_chunk or cap == 0) return error.UnexpectedTensor;
+        const x = try e.gpa.create(Beside);
+        errdefer e.gpa.destroy(x);
+        var st = try cuda.Stream.initPriority(e.driver, .default);
+        errdefer st.deinit();
+        var kit: ?*exl3x.Kit = null;
+        if (e.batch_k.exl3) |main_kit| {
+            const own = try std.heap.page_allocator.create(exl3x.Kit);
+            own.* = main_kit.*;
+            own.grouped.storage = null;
+            own.grouped.pair_cap = 0;
+            kit = own;
+        }
+        errdefer if (kit) |own| freeKit(own);
+        if (kit) |own| try own.reserve(rows);
+        var s = try batch.Scratch.alloc(e.gpa, e.driver, st, rows);
+        errdefer s.free(e.gpa);
+        var scores = try cuda.DeviceBuffer.alloc(e.driver, batch.scoreBytes(cap, rows));
+        errdefer scores.free();
+        var k = e.batch_k;
+        k.exl3 = kit;
+        x.* = .{ .gpa = e.gpa, .driver = e.driver, .stream = st, .s = s, .k = k, .kit = kit, .scores = scores, .score_cap = cap };
+        return x;
+    }
+
+    fn freeKit(kit: *exl3x.Kit) void {
+        kit.grouped.deinit();
+        std.heap.page_allocator.destroy(kit);
+    }
+
+    pub fn bytes(rows: usize, cap: usize) usize {
+        return batch.Scratch.bytes(rows) + batch.scoreBytes(cap, rows);
+    }
+
+    pub fn deinit(x: *Beside) void {
+        x.join() catch {};
+        cuda.completion.drain(x.driver, x.stream, "flashnext: the beside piece's stream did not drain");
+        if (x.channel) |*c| c.deinit();
+        x.scores.free();
+        x.s.free(x.gpa);
+        if (x.kit) |kit| freeKit(kit);
+        x.stream.deinit();
+        x.gpa.destroy(x);
+    }
+
+    pub fn open(x: *Beside, link: wire.Link, rank: usize) !void {
+        if (x.channel != null) return;
+        x.channel = try Collective.init(link, rank, channel_timeout_ms);
+    }
+
+    pub fn busy(x: *const Beside) bool {
+        return x.work != null;
+    }
+
+    pub fn finished(x: *const Beside) bool {
+        const w = x.work orelse return true;
+        return w.done.load(.acquire);
+    }
+
+    pub fn holds(x: *const Beside, seq: *const Seq) bool {
+        const w = x.work orelse return false;
+        return w.piece.seq == seq;
+    }
+
+    pub fn rankId(x: *const Beside) u64 {
+        const w = x.work orelse return 0;
+        return w.piece.seq.rank_id;
+    }
+
+    pub fn endedAt(x: *const Beside) u64 {
+        const w = x.work orelse return 0;
+        return w.end_ns.load(.acquire);
+    }
+
+    pub fn start(x: *Beside, e: *Engine, comptime Tri: type, tri: Tri, piece: Piece) !void {
+        if (comptime !@hasField(Tri, "s")) return error.UnsupportedRankOperation;
+        if (x.work != null) return error.BesideBusy;
+        if (x.channel == null) return error.TensorParallelUnavailable;
+        if (e.pockets.mask() != 0) return error.UnsupportedRankOperation;
+        const n = piece.ids.len;
+        if (n == 0 or n > x.s.cap or piece.seq.fed + n > piece.seq.cap or piece.seq.cap > x.score_cap) return error.UnexpectedTensor;
+        var ctx: cuda.abi.Context = null;
+        try x.driver.check(x.driver.api.cuCtxGetCurrent(&ctx), "cuCtxGetCurrent");
+        const w = try x.gpa.create(Work);
+        errdefer x.gpa.destroy(w);
+        const ids = try x.gpa.dupe(u32, piece.ids);
+        errdefer x.gpa.free(ids);
+        var p = piece;
+        p.ids = ids;
+        var t = tri;
+        if (comptime @hasField(Tri, "s")) t.s = x.stream;
+        var m = e.shipped();
+        m.collective = &x.channel.?;
+        m.early = null;
+        w.* = .{ .x = x, .piece = p, .ctx = ctx, .pass = .{ .gpa = e.gpa, .io = e.io, .stream = x.stream, .k = &x.k, .s = &x.s, .m = m, .seq = p.seq.view(x.scores.ptr), .hooks = .{ .logits = if (p.last) .last else .none, .streams = p.streams, .streams_free = p.streams_free, .prompt = p.prompt }, .prompt = knobs.tpPromptRelaxed() }, .run = Runner(Tri).run };
+        Runner(Tri).place(w, t);
+        w.thread = try std.Thread.spawn(.{}, Work.main, .{w});
+        x.work = w;
+    }
+
+    pub fn join(x: *Beside) !void {
+        const w = x.work orelse return;
+        x.work = null;
+        if (w.thread) |th| th.join();
+        defer {
+            x.gpa.free(w.piece.ids);
+            w.free(x.gpa);
+        }
+        if (w.err) |err| return err;
+    }
+
+    pub const Work = struct {
+        x: *Beside,
+        piece: Piece,
+        ctx: cuda.abi.Context,
+        pass: Erased,
+        run: *const fn (*Work) anyerror!void,
+        thread: ?std.Thread = null,
+        done: std.atomic.Value(bool) = .init(false),
+        end_ns: std.atomic.Value(u64) = .init(0),
+        err: ?anyerror = null,
+        tri_bytes: [tri_room]u8 align(16) = undefined,
+
+        fn main(w: *Work) void {
+            w.go() catch |err| {
+                w.err = err;
+            };
+            w.end_ns.store(wire.now(), .release);
+            w.done.store(true, .release);
+        }
+
+        fn go(w: *Work) !void {
+            const d = w.x.driver;
+            try d.check(d.api.cuCtxSetCurrent(w.ctx), "cuCtxSetCurrent");
+            cuda.copy_source.setCurrent(w.ctx);
+            try w.run(w);
+            try w.x.channel.?.finish(w.x.stream);
+            w.piece.seq.fed += w.piece.ids.len;
+        }
+
+        fn free(w: *Work, gpa: std.mem.Allocator) void {
+            gpa.destroy(w);
+        }
+    };
+
+    const tri_room = 64;
+
+    pub const Erased = struct {
+        gpa: std.mem.Allocator,
+        io: std.Io,
+        stream: cuda.Stream,
+        k: *const batch.Kernels,
+        s: *batch.Scratch,
+        m: batch.Model,
+        seq: batch.SeqState,
+        hooks: batch.Hooks,
+        prompt: bool,
+    };
+
+    fn Runner(comptime Tri: type) type {
+        return struct {
+            fn place(w: *Work, tri: Tri) void {
+                comptime std.debug.assert(@sizeOf(Tri) <= tri_room and @alignOf(Tri) <= 16);
+                @as(*Tri, @ptrCast(@alignCast(&w.tri_bytes))).* = tri;
+            }
+
+            fn run(w: *Work) anyerror!void {
+                const e = w.pass;
+                const tri = @as(*const Tri, @ptrCast(@alignCast(&w.tri_bytes))).*;
+                var p: batch.Pass(Tri) = .{ .gpa = e.gpa, .io = e.io, .stream = e.stream, .tri = tri, .k = e.k, .s = e.s, .m = e.m, .seq = e.seq, .hooks = e.hooks, .prompt = e.prompt };
+                const q = w.piece.seq;
+                try p.chunk(w.piece.ids, q.fed, if (w.piece.last) q.logits else null);
+            }
+        };
+    }
+};
+
+test "a beside piece's pass keeps the typed glue in its work's room" {
+    const Tri = @import("cuda_launch.zig").Tri;
+    try std.testing.expect(@sizeOf(Tri) <= Beside.tri_room);
+    try std.testing.expect(@alignOf(Tri) <= 16);
+}
