+                    try r.s.synchronize();
+                    if (phase == 1) t.* = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e3 / reps;
+                }
+            }
+            const yf = try r.back(f32, y32, pairs * D);
+            const yh = try r.back(u16, yb, pairs * D);
+            var routed: usize = 0;
+            var y_err: f64 = 0;
+            var y_norm: f64 = 0;
+            for (picks_h, 0..) |e, pi| {
+                if (e == count) continue;
+                routed += 1;
+                for (0..D) |c| {
+                    const want = bf16Rne(yf[pi * D + c]);
+                    const got = yh[pi * D + c];
+                    try check.expect(got == want, "{s}, {d} rows: pair {d} column {d}: bf16 y {x:0>4}, the fp32 y rounded is {x:0>4}", .{ arm.label, rows, pi, c, got, want });
+                    const d = @as(f64, bfValue(got)) - @as(f64, yf[pi * D + c]);
+                    y_err += d * d;
+                    y_norm += @as(f64, yf[pi * D + c]) * @as(f64, yf[pi * D + c]);
+                }
+            }
+            const y_rel = @sqrt(y_err / @max(y_norm, 1e-300));
+            worst_y = @max(worst_y, y_rel);
+            var sum_us: [4]f64 = undefined;
+            const fns = [4]cuda.Function{ k.moe_sum_slot, k.moe_sum_slot_yb, k.moe_sum_slot_bf, k.moe_sum_slot_bf_yb };
+            const ys = [4]u64{ y32, yb, y32, yb };
+            const outs = [4]u64{ out32, outb, outbf, outbf };
+            for (fns, ys, outs, &sum_us) |f, yy, o, *t| {
+                for (0..2) |phase| {
+                    const t0 = check.now(gpu.io);
+                    for (0..if (phase == 0) 3 else reps) |_| try slotSum(&r, f, yy, wts, picks, @intCast(count), shared, o, rows);
+                    try r.s.synchronize();
+                    if (phase == 1) t.* = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e3 / reps;
+                }
+            }
+            try slotSum(&r, k.moe_sum_slot, y32, wts, picks, @intCast(count), shared, out32, rows);
+            try slotSum(&r, k.moe_sum_slot_yb, yb, wts, picks, @intCast(count), shared, outb, rows);
+            try r.s.synchronize();
+            const s32 = try r.back(f32, out32, rows * D);
+            const sb = try r.back(f32, outb, rows * D);
+            var e2: f64 = 0;
+            var n2: f64 = 0;
+            for (0..rows) |row| for (0..D) |c| {
+                var acc: f32 = 0;
+                for (0..slots - 1) |kk| {
+                    if (picks_h[row * slots + kk] == count) continue;
+                    acc = @mulAdd(f32, bfValue(yh[(row * slots + kk) * D + c]), wts_h[row * slots + kk], acc);
+                }
+                acc = @mulAdd(f32, shared_h[row * D + c], wts_h[row * slots + slots - 1], acc);
+                const got = sb[row * D + c];
+                try check.expect(@as(u32, @bitCast(got)) == @as(u32, @bitCast(acc)), "{s}, {d} rows: row {d} column {d}: fn_moe_sum_slot_yb {e} against the fma chain over bf16 y {e}", .{ arm.label, rows, row, c, got, acc });
+                const d = @as(f64, got) - @as(f64, s32[row * D + c]);
+                e2 += d * d;
+                n2 += @as(f64, s32[row * D + c]) * @as(f64, s32[row * D + c]);
+            };
+            const rel = @sqrt(e2 / @max(n2, 1e-300));
+            worst_rel = @max(worst_rel, rel);
+            checked += routed;
+            const layer_off = us[0] + (sum_us[0] + sum_us[2]) / 2;
+            const layer_on = us[1] + (sum_us[1] + sum_us[3]) / 2;
+            const scale = @as(f64, chunk_layers) / 1e3;
+            const fr = @as(f64, @floatFromInt(rows));
+            std.debug.print("BENCH y-bf16 {d} rows ({d} routed pairs): {s}: experts {d:.1} -> {d:.1} us, slot sum {d:.1} -> {d:.1} us, slot sum bf {d:.1} -> {d:.1} us; a layer (experts + half of each sum) {d:.1} -> {d:.1} us, saves {d:.1} us = {d:.2} ms a {d}-row pass of {d} layers, {d:.2} ms a 3072-row chunk, {d:.2} ms a 1536-row piece; y rel-L2 {e:.3}, sum rel-L2 {e:.3}\n", .{ rows, routed, arm.label, us[0], us[1], sum_us[0], sum_us[1], sum_us[2], sum_us[3], layer_off, layer_on, layer_off - layer_on, (layer_off - layer_on) * scale, rows, chunk_layers, (layer_off - layer_on) * scale * 3072.0 / fr, (layer_off - layer_on) * scale * 1536.0 / fr, y_rel, rel });
+        }
+        clock.step("{d} rows: every arm's bf16 y and sums checked and timed", .{rows});
+    }
+    std.debug.print("RESULT flashnext-y-bf16 {d} routed pairs: bf16 y equal to the fp32 y rounded, fn_moe_sum_slot_yb equal to its fma chain; worst y rel-L2 {e:.3}, worst sum rel-L2 against fp32 y {e:.3}\n", .{ checked, worst_y, worst_rel });
+    check.pass("{s}: pack {s} rank {d}: bf16 y and its slot sum checked over {d} routed pairs", .{ cmd, in.pack, in.rank, checked });
+}
diff --git a/zig/tests/cuda/flashnext_fidelity_relax_tests.zig b/zig/tests/cuda/flashnext_fidelity_relax_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8c071cb2b0949e2e358a853ae1f0df6b430e720d
--- /dev/null
+++ b/zig/tests/cuda/flashnext_fidelity_relax_tests.zig
@@ -0,0 +1,308 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const fid = flash.fidelity;
+const Session = flash.rank_engine.Session;
+
+const row = prompt.vocabulary * 2;
+
+fn getenv(name: [*:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+}
+
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: *Session,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, cap: usize) !void {
+        r.gpu = gpu;
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, cap, chunk);
+        identity.mtp = 1;
+        r.session = try Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+        r.e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank) catch |err| {
+            r.session.poison();
+            r.session.deinit();
+            return err;
+        };
+        r.session.engine = r.e;
+        r.e.collective = &r.session.collective;
+        errdefer {
+            r.session.poison();
+            r.session.deinit();
+            r.e.deinit();
+        }
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        if (flash.knobs.tpRoce()) try r.session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+        _ = try r.e.reserve(@min(cap, r.e.chunk));
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    fn deinit(r: *Rig) void {
+        r.session.deinit();
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+};
+
+const Record = struct {
+    rows: std.ArrayList(fid.Row) = .empty,
+    main: std.ArrayList(u8) = .empty,
+    draft: std.ArrayList(u8) = .empty,
+    draft_vocab: usize = 0,
+
+    fn deinit(rec: *Record, gpa: std.mem.Allocator) void {
+        rec.rows.deinit(gpa);
+        rec.main.deinit(gpa);
+        rec.draft.deinit(gpa);
+    }
+};
+
+fn labelOk(label: []const u8) bool {
+    if (label.len == 0 or label.len > 64) return false;
+    for (label) |c| if (!std.ascii.isAlphanumeric(c) and c != '-' and c != '_') return false;
+    return true;
+}
+
+fn readIds(gpu: check.Gpu, path: []const u8) !std.ArrayList(u32) {
+    const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, path, gpu.gpa, .limited(1 << 26));
+    defer gpu.gpa.free(text);
+    var ids: std.ArrayList(u32) = .empty;
+    errdefer ids.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, text, " \r\n\t");
+    while (words.next()) |w| {
+        const id = try std.fmt.parseInt(u32, w, 10);
+        if (id >= prompt.vocabulary) return error.InvalidToken;
+        try ids.append(gpu.gpa, id);
+    }
+    return ids;
+}
+
+fn context(r: *Rig, ids: []const u32, c: usize, steps: usize, piece: usize, rec: *Record) !void {
+    const gpa = r.gpu.gpa;
+    const s = r.session;
+    const ops = r.ops();
+    const h = r.head.?;
+    const cap = c + steps + 1;
+    var q = try s.create(cap);
+    defer s.drop(&q);
+    var d = try mtp.Draft.init(gpa, r.e.driver, r.stream, cap, h.ids.len, r.e.chunk, r.e.heads);
+    defer d.deinit();
+    d.reset();
+    const stops = try fid.promptStops(gpa, c, piece);
+    defer gpa.free(stops);
+    const fill = ids[0..c];
+    const t0 = check.now(r.gpu.io);
+    var at: usize = 0;
+    for (stops) |stop| {
+        while (at < stop) {
+            const end = @min(stop, at + @min(r.e.chunk, d.rows_cap));
+            try ops.prefillReady(&q, &d, fill, at, end);
+            try s.forward(flash.Tri, r.tri(), &q, fill[at..end], .{ .logits = if (end == stop) .last else .none, .streams = d.streams.ptr, .streams_free = d.side_done, .prompt = true });
+            try ops.prefillHead(&d, fill, at, end);
+            at = end;
+        }
+        try rec.rows.append(gpa, .{ .kind = .prompt, .context = @intCast(c), .pos = @intCast(stop) });
+        try rec.main.appendSlice(gpa, q.logits[0..row]);
+    }
+    const t1 = check.now(r.gpu.io);
+    const dv = h.view().logical;
+    rec.draft_vocab = dv;
+    const draft_host = try gpa.alloc(u16, d.dlogits.len / 2);
+    defer gpa.free(draft_host);
+    const main_host = try gpa.alloc(u8, row);
+    defer gpa.free(main_host);
+    var rows = d.prompt_last;
+    for (0..steps) |j| {
+        const p = c + j;
+        var chain: mtp.Chain = undefined;
+        try ops.draft(&d, ids[p..][0..1], rows, q.fed + 1, 1, null, mtp.default_confidence, &chain);
+        try r.stream.synchronize();
+        try d.dlogits.download(0, std.mem.sliceAsBytes(draft_host));
+        const col = fid.argmax(draft_host[0..dv]);
+        try ops.verify(&q, &d, ids[p..][0..1]);
+        try r.stream.synchronize();
+        try d.logits.download(0, main_host);
+        try s.keep(flash.Tri, r.tri(), &q, &d, 1);
+        rows = d.streams.ptr;
+        try rec.rows.append(gpa, .{ .kind = .decode, .context = @intCast(c), .pos = @intCast(p + 1), .draft_top = h.ids[col] });
+        try rec.main.appendSlice(gpa, main_host);
+        try rec.draft.appendSlice(gpa, std.mem.sliceAsBytes(draft_host[0..dv]));
+    }
+    try r.stream.synchronize();
+    const t2 = check.now(r.gpu.io);
+    std.debug.print("fidelity context {d}: fill {d:.1} s ({d} prompt rows), {d} decode steps {d:.1} s\n", .{ c, @as(f64, @floatFromInt(t1 - t0)) / 1e9, stops.len, steps, @as(f64, @floatFromInt(t2 - t1)) / 1e9 });
+}
+
+fn pathOf(gpa: std.mem.Allocator, out: []const u8, label: []const u8, ext: []const u8) ![]u8 {
+    const name = try std.fmt.allocPrint(gpa, "{s}.{s}", .{ label, ext });
+    defer gpa.free(name);
+    return std.fs.path.join(gpa, &.{ out, name });
+}
+
+fn writeRecord(gpu: check.Gpu, out: []const u8, label: []const u8, rec: *const Record) !void {
+    const gpa = gpu.gpa;
+    var idx: std.Io.Writer.Allocating = .init(gpa);
+    defer idx.deinit();
+    try idx.writer.print("{s} vocab {d} draft {d} rows {d}\n", .{ fid.header, prompt.vocabulary, rec.draft_vocab, rec.rows.items.len });
+    for (rec.rows.items) |x| try fid.formatRow(&idx.writer, x);
+    for ([_][]const u8{ "idx", "main", "draft" }, [_][]const u8{ idx.written(), rec.main.items, rec.draft.items }) |ext, data| {
+        const path = try pathOf(gpa, out, label, ext);
+        defer gpa.free(path);
+        try std.Io.Dir.cwd().writeFile(gpu.io, .{ .sub_path = path, .data = data });
+        var digest: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(data, &digest, .{});
+        const hex = std.fmt.bytesToHex(digest, .lower);
+        std.debug.print("fidelity wrote {s} ({d} bytes) sha256={s}\n", .{ path, data.len, &hex });
+    }
+}
+
+const Loaded = struct {
+    idx: fid.Index,
+    main: []u8,
+    draft: []u8,
+
+    fn load(gpu: check.Gpu, out: []const u8, label: []const u8) !Loaded {
+        const gpa = gpu.gpa;
+        var files: [3][]u8 = undefined;
+        var got: usize = 0;
+        errdefer for (files[0..got]) |f| gpa.free(f);
+        for ([_][]const u8{ "idx", "main", "draft" }, 0..) |ext, i| {
+            const path = try pathOf(gpa, out, label, ext);
+            defer gpa.free(path);
+            files[i] = try std.Io.Dir.cwd().readFileAlloc(gpu.io, path, gpa, .limited(1 << 32));
+            got += 1;
+        }
+        defer gpa.free(files[0]);
+        const idx = try fid.parseIndex(gpa, files[0]);
+        return .{ .idx = idx, .main = files[1], .draft = files[2] };
+    }
+
+    fn deinit(l: *Loaded, gpa: std.mem.Allocator) void {
+        l.idx.deinit(gpa);
+        gpa.free(l.main);
+        gpa.free(l.draft);
+    }
+
+    fn u16s(b: []const u8) []const u16 {
+        return @alignCast(std.mem.bytesAsSlice(u16, b));
+    }
+};
+
+fn perRow(gpa: std.mem.Allocator, base: *const Loaded, arm: *const Loaded) !fid.PerRow {
+    return fid.perRow(gpa, base.idx, arm.idx, Loaded.u16s(base.main), Loaded.u16s(arm.main), Loaded.u16s(base.draft), Loaded.u16s(arm.draft));
+}
+
+fn printSummary(what: []const u8, label: []const u8, base: []const u8, s: fid.Summary) void {
+    std.debug.print("{s} {s} vs {s} rows={d} kl_mean={e:.3} kl_p99={e:.3} kl_max={e:.3} top1={d:.2}% tv_mean={e:.3} draft_rows={d} draft_kl={e:.3} accept={d:.2}% base_accept={d:.2}% nonfinite={d}\n", .{ what, label, base, s.rows, s.kl_mean, s.kl_p99, s.kl_max, s.top1, s.tv_mean, s.decode_rows, s.draft_kl, s.accept_arm, s.accept_base, s.nonfinite });
+}
+
+pub fn compareFiles(gpu: check.Gpu, out: []const u8, base_label: []const u8, arm_label: []const u8, floor_label: ?[]const u8) !void {
+    const gpa = gpu.gpa;
+    for ([_]?[]const u8{ base_label, arm_label, floor_label }) |l| if (l) |x| if (!labelOk(x)) return error.BadLabel;
+    var base = try Loaded.load(gpu, out, base_label);
+    defer base.deinit(gpa);
+    var arm = try Loaded.load(gpu, out, arm_label);
+    defer arm.deinit(gpa);
+    var p = try perRow(gpa, &base, &arm);
+    defer p.deinit(gpa);
+    const gs = try fid.groups(gpa, base.idx);
+    defer gpa.free(gs);
+    for (gs) |g| {
+        const s = try fid.summarize(gpa, p, base.idx.rows, g.first, g.count);
+        var what_buf: [64]u8 = undefined;
+        const what = try std.fmt.bufPrint(&what_buf, "FID {s} ctx={d}", .{ @tagName(g.kind), g.context });
+        printSummary(what, arm_label, base_label, s);
+    }
+    const all = try fid.summarize(gpa, p, base.idx.rows, 0, base.idx.rows.len);
+    printSummary("RESULT flashnext-fidelity-relax", arm_label, base_label, all);
+    const floor_name = floor_label orelse return;
+    var floor = try Loaded.load(gpu, out, floor_name);
+    defer floor.deinit(gpa);
+    var fp = try perRow(gpa, &base, &floor);
+    defer fp.deinit(gpa);
+    const ff = try fid.summarize(gpa, fp, base.idx.rows, 0, base.idx.rows.len);
+    printSummary("FLOOR", floor_name, base_label, ff);
+    const factor = try fid.factorFrom(getenv("TF_FIDELITY_FACTOR"));
+    var failed: usize = 0;
+    for (gs) |g| {
+        const v = try fid.gate(gpa, p, fp, base.idx.rows, g.first, g.count, factor, fid.default_resamples, fid.default_seed);
+        const ok = v.passed();
+        failed += @intFromBool(!ok);
+        std.debug.print("GATE {s} {s} ctx={d} rows={d}: KL {e:.3} [95% {e:.3}, {e:.3}] vs floor {e:.3} [95% {e:.3}, {e:.3}] x{d:.1}; top1 margin {d:.2} pp [95% {d:.2}, {d:.2}]", .{ if (ok) "PASS" else "FAIL", @tagName(g.kind), g.context, g.count, v.kl_arm.mid, v.kl_arm.lo, v.kl_arm.hi, v.kl_floor.mid, v.kl_floor.lo, v.kl_floor.hi, factor, v.top1_margin.mid, v.top1_margin.lo, v.top1_margin.hi });
+        if (v.accept_margin) |m| std.debug.print("; acceptance margin {d:.2} pp [95% {d:.2}, {d:.2}]", .{ m.mid, m.lo, m.hi });
+        std.debug.print("; nonfinite {d}{s}{s}{s}\n", .{ v.nonfinite, if (v.fail_kl) "; FAIL kl" else "", if (v.fail_top1) "; FAIL top1" else "", if (v.fail_accept) "; FAIL acceptance" else "" });
+    }
+    std.debug.print("RESULT flashnext-fidelity-gate {s} {s}: {d} of {d} groups failed against base {s}, floor {s} x{d:.1}, bootstrap {d} resamples seed {d}\n", .{ arm_label, if (failed == 0) "PASS" else "FAIL", failed, gs.len, base_label, floor_name, factor, fid.default_resamples, fid.default_seed });
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, out: []const u8, label: []const u8, base: ?[]const u8, floor: ?[]const u8) !void {
+    const gpa = gpu.gpa;
+    if (!labelOk(label)) return error.BadLabel;
+    if (floor != null and base == null) return error.BadLabel;
+    const contexts = try fid.contextsFrom(gpa, getenv("TF_FIDELITY_CONTEXTS"));
+    defer gpa.free(contexts);
+    const steps = try fid.countFrom(getenv("TF_FIDELITY_STEPS"), fid.default_steps, 1024);
+    const piece = try fid.countFrom(getenv("TF_FIDELITY_PIECE"), fid.default_piece, 1 << 16);
+    const longest = contexts[contexts.len - 1];
+    if (longest + steps + 1 > prompt.max_tokens) return error.BadPrompt;
+    var ids = try readIds(gpu, ids_path);
+    defer ids.deinit(gpa);
+    if (ids.items.len < longest + steps + 1) {
+        std.debug.print("FAIL flashnext-fidelity-relax: {s} holds {d} ids, the longest context needs {d}\n", .{ ids_path, ids.items.len, longest + steps + 1 });
+        return error.TestFailed;
+    }
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, longest + steps + 1);
+    defer r.deinit();
+    if (rank == 1) {
+        var logits = try cuda.DeviceBuffer.alloc(gpu.d, row);
+        defer logits.free();
+        try r.session.follow(flash.Tri, r.tri(), logits.ptr);
+        check.pass("rank 1 followed the fidelity arm {s}", .{label});
+        return;
+    }
+    var rec: Record = .{};
+    defer rec.deinit(gpa);
+    for (contexts) |c| try context(&r, ids.items, c, steps, piece, &rec);
+    try writeRecord(gpu, out, label, &rec);
+    check.pass("fidelity arm {s}: {d} rows over contexts {any}, chunk {d}, piece {d}, {d} decode steps a context", .{ label, rec.rows.items.len, contexts, r.e.chunk, piece, steps });
+    if (base) |b| try compareFiles(gpu, out, b, label, floor);
+}
