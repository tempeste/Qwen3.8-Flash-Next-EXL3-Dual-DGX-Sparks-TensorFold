+extern "C" __global__ void __launch_bounds__(512) roce_gather_pipe(
+    const uint4* __restrict__ in, uint4* __restrict__ out, int packs, int rank, char* recv, char* flags, char* send,
+    uint32_t* ctrl, long long slot_bytes, uint32_t* counters, int klass, uint32_t spin_limit, int n_hca,
+    int chunk_packs, int max_chunks) {
+    exchange_pipe<false>(in, out, packs, rank, recv, flags, send, ctrl, slot_bytes, counters, klass, spin_limit, n_hca,
+                         chunk_packs, max_chunks);
+}
+
