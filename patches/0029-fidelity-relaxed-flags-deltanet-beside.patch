+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const flash = @import("flashnext");
+const share = flash.snap.share;
+const prompt = flash.prompt;
+
+pub const Kind = enum { bf16, f32, fp8, packed_ };
+
+pub const Unit = enum { conv_row, value_head, position, block, none };
+
+pub const Section = struct { what: []const u8, layer: usize, off: usize, len: usize, kind: Kind = .packed_, row: usize = 0, unit: Unit = .none };
+
+pub const Image = struct {
+    bytes: std.ArrayList(u8) = .empty,
+    sections: std.ArrayList(Section) = .empty,
+    head_kv: ?u8 = null,
+    history: [2]i64 = .{ 0, 0 },
+    fed: usize = 0,
+
+    pub fn deinit(m: *Image, gpa: std.mem.Allocator) void {
+        m.bytes.deinit(gpa);
+        m.sections.deinit(gpa);
+    }
+
+    fn add(m: *Image, gpa: std.mem.Allocator, what: []const u8, layer: usize, b: cuda.DeviceBuffer, off: usize, n: usize, kind: Kind, row: usize, unit: Unit) !void {
+        if (n == 0) return;
+        if (off + n > b.len) return error.ImageShape;
+        const at = m.bytes.items.len;
+        try m.bytes.resize(gpa, at + n);
+        try b.download(off, m.bytes.items[at..][0..n]);
+        try m.sections.append(gpa, .{ .what = what, .layer = layer, .off = at, .len = n, .kind = kind, .row = row, .unit = unit });
+    }
+
+    pub fn of(m: *const Image, s: Section) []const u8 {
+        return m.bytes.items[s.off..][0..s.len];
+    }
+
+    pub fn sums(m: *const Image, gpa: std.mem.Allocator) !Sums {
+        const h = try gpa.alloc(u64, m.sections.items.len);
+        errdefer gpa.free(h);
+        for (m.sections.items, h) |s, *x| x.* = std.hash.Wyhash.hash(0, m.of(s));
+        const names = try gpa.alloc(Name, m.sections.items.len);
+        for (m.sections.items, names) |s, *x| x.* = .{ .what = s.what, .layer = s.layer };
+        return .{ .hashes = h, .names = names, .history = m.history, .fed = m.fed };
+    }
+};
+
+pub const Name = struct { what: []const u8, layer: usize };
+
+pub const Sums = struct {
+    hashes: []u64,
+    names: []Name,
+    history: [2]i64,
+    fed: usize,
+
+    pub fn deinit(x: *Sums, gpa: std.mem.Allocator) void {
+        gpa.free(x.hashes);
+        gpa.free(x.names);
+    }
+
+    pub fn firstDiff(a: *const Sums, b: *const Sums) ?Name {
+        if (a.fed != b.fed or !std.mem.eql(i64, &a.history, &b.history)) return .{ .what = "position or n-gram history", .layer = 0 };
+        if (a.hashes.len != b.hashes.len) return .{ .what = "section count", .layer = 0 };
+        for (a.hashes, b.hashes, a.names) |x, y, n| if (x != y) return n;
+        return null;
+    }
+};
+
+fn partName(head_piece: bool, part: anytype) []const u8 {
+    return switch (part) {
+        .key => if (head_piece) "head keys" else "keys",
+        .value => if (head_piece) "head values" else "values",
+        .raw => if (head_piece) "head raw index keys" else "raw index keys",
+        .pooled => if (head_piece) "head pooled index blocks" else "pooled index blocks",
+    };
+}
+
+pub const Scope = enum { states, all };
+
+pub fn seqImage(gpa: std.mem.Allocator, q: *const prompt.Seq, head: anytype, rows: usize, scope: Scope) !Image {
+    var m: Image = .{ .history = q.history, .fed = q.fed };
+    errdefer m.deinit(gpa);
+    for (q.conv, 0..) |b, i| try m.add(gpa, "DeltaNet conv window", i, b, 0, b.len, .bf16, q.heads.convDim() * 2, .conv_row);
+    for (q.state, 0..) |b, i| try m.add(gpa, "DeltaNet state", i, b, 0, b.len, .f32, b.len / q.heads.nv, .value_head);
+    try m.add(gpa, "n-gram tail", 0, q.tail, 0, q.tail.len, .bf16, 0, .none);
+    if (scope == .states) return m;
+    const head_kv = if (head) |d| d.kv else null;
+    if (head_kv) |k| m.head_kv = @backingInt(k);
+    const ps = share.pieces(q.kv, head_kv, q.heads, q.window.on());
+    for (ps.p[0..ps.len]) |p| for (0..p.layers) |layer| {
+        if (p.head and head == null) continue;
+        const n = (if (p.head) rows - 1 else rows) / p.per;
+        const b = if (p.head) switch (p.part) {
+            .key => head.?.kc,
+            .value => head.?.vc,
+            .raw => head.?.ikc,
+            .pooled => head.?.pooled,
+        } else switch (p.part) {
+            .key => q.kc[layer],
+            .value => q.vc[layer],
+            .raw => q.ikc[layer],
+            .pooled => q.pooled[layer],
+        };
+        const kind: Kind = switch (p.part) {
+            .raw, .pooled => .bf16,
+            .key, .value => kvKind(if (p.head) head_kv.? else q.kv, p.part == .key),
+        };
+        try m.add(gpa, partName(p.head, p.part), layer, b, 0, n * p.row, kind, p.row, if (p.per > 1) .block else .position);
+    };
+    return m;
+}
+
+fn kvKind(format: anytype, key: bool) Kind {
+    return switch (format) {
+        .bf16 => .bf16,
+        .fp8 => .fp8,
+        .fp8k_nvfp4v => if (key) .fp8 else .packed_,
+        else => .packed_,
+    };
+}
+
+pub fn image(gpa: std.mem.Allocator, cu: *flash.native.Cuda, s: *lanes.Stream, scope: Scope) !Image {
+    const l = cu.lanes.getPtr(s) orelse return error.NoLane;
+    try cu.stream.synchronize();
+    return seqImage(gpa, &l.seq, if (l.draft) |*d| d else null, s.prompt().len, scope);
+}
+
+pub fn keptImage(gpa: std.mem.Allocator, cu: *flash.native.Cuda, s: *lanes.Stream, at: usize) !?Image {
+    const l = cu.lanes.getPtr(s) orelse return error.NoLane;
+    if (l.seq.fed != at) return null;
+    try cu.stream.synchronize();
+    return try seqImage(gpa, &l.seq, @as(?*const flash.mtp.Draft, null), at, .all);
+}
+
+pub const Diff = struct { section: Section, words: usize, total: usize, first: usize, got: u32, want: u32 };
+
+pub fn firstDiff(got: *const Image, want: *const Image) ?Diff {
+    for (got.sections.items, want.sections.items) |g, w| {
+        const a = got.of(g);
+        const b = want.of(w);
+        if (a.len != b.len or std.mem.eql(u8, a, b)) continue;
+        var words: usize = 0;
+        var first: ?usize = null;
+        var i: usize = 0;
+        while (i + 4 <= a.len) : (i += 4) {
+            if (std.mem.eql(u8, a[i..][0..4], b[i..][0..4])) continue;
+            words += 1;
+            if (first == null) first = i / 4;
+        }
+        const f = first orelse 0;
+        return .{ .section = g, .words = words, .total = a.len / 4, .first = f, .got = std.mem.readInt(u32, a[f * 4 ..][0..4], .little), .want = std.mem.readInt(u32, b[f * 4 ..][0..4], .little) };
+    }
+    return null;
+}
+
+pub fn bf16Ulps(a: u32, b: u32) u32 {
+    var worst: u32 = 0;
+    for ([_]u5{ 0, 16 }) |sh| {
+        const x: i32 = @as(i16, @bitCast(@as(u16, @truncate(a >> sh))));
+        const y: i32 = @as(i16, @bitCast(@as(u16, @truncate(b >> sh))));
+        const ox = if (x < 0) -(x & 0x7fff) else x;
+        const oy = if (y < 0) -(y & 0x7fff) else y;
+        worst = @max(worst, @abs(ox - oy));
+    }
+    return worst;
+}
+
+pub const Mag = struct {
+    values: usize = 0,
+    differ: usize = 0,
+    max: f64 = 0,
+    sum: f64 = 0,
+    over2: usize = 0,
+    first: ?usize = null,
+    first_over: ?usize = null,
+    size: usize = 1,
+
+    fn note(m: *Mag, i: usize, steps: f64) void {
+        m.values += 1;
+        if (steps == 0) return;
+        m.differ += 1;
+        m.sum += steps;
+        m.max = @max(m.max, steps);
+        if (m.first == null) m.first = i;
+        if (steps > 2) {
+            m.over2 += 1;
+            if (m.first_over == null) m.first_over = i;
+        }
+    }
+
+    pub fn mean(m: Mag) f64 {
+        return if (m.differ == 0) 0 else m.sum / @as(f64, @floatFromInt(m.differ));
+    }
+
+    pub fn worstAt(m: Mag) usize {
+        return m.first_over orelse m.first orelse 0;
+    }
+};
+
+fn ordered(comptime T: type, x: T) i64 {
+    const bits = @bitSizeOf(T);
+    const sign: T = @as(T, 1) << (bits - 1);
+    const v: i64 = @intCast(x & ~sign);
+    return if (x & sign != 0) -v else v;
+}
+
+fn stepsOf(comptime T: type, a: []const u8, b: []const u8, i: usize, scale: f64) f64 {
+    const n = @sizeOf(T);
+    const x = std.mem.readInt(T, a[i * n ..][0..n], .little);
+    const y = std.mem.readInt(T, b[i * n ..][0..n], .little);
+    if (x == y) return 0;
+    return @as(f64, @floatFromInt(@abs(ordered(T, x) - ordered(T, y)))) / scale;
+}
+
+pub fn magnitude(kind: Kind, a: []const u8, b: []const u8) Mag {
+    var m: Mag = .{ .size = switch (kind) {
+        .bf16 => 2,
+        .f32 => 4,
+        .fp8, .packed_ => 1,
+    } };
+    const n = @min(a.len, b.len) / m.size;
+    for (0..n) |i| m.note(i, switch (kind) {
+        .bf16 => stepsOf(u16, a, b, i, 1),
+        .f32 => stepsOf(u32, a, b, i, 65536),
+        .fp8 => stepsOf(u8, a, b, i, 1),
+        .packed_ => if (a[i] == b[i]) 0 else std.math.inf(f64),
+    });
+    return m;
+}
+
+pub const rel_bound: f64 = 1.0 / 256.0;
+
+pub const Rel = struct {
+    values: usize = 0,
+    differ: usize = 0,
+    max_abs: f64 = 0,
+    rms: f64 = 0,
+    over: usize = 0,
+    nonfinite: usize = 0,
+    decoded: bool = true,
+
+    pub fn rel(r: Rel) f64 {
+        if (r.max_abs == 0) return 0;
+        return if (r.rms > 0) r.max_abs / r.rms else std.math.inf(f64);
+    }
+};
+
+fn e4m3(x: u8) f64 {
+    const sign: f64 = if (x & 0x80 != 0) -1 else 1;
+    const e: i32 = (x >> 3) & 0xf;
+    const m: f64 = @floatFromInt(x & 7);
+    if (e == 0xf and x & 7 == 7) return std.math.nan(f64);
+    if (e == 0) return sign * std.math.ldexp(m / 8.0, -6);
+    return sign * std.math.ldexp(1 + m / 8.0, e - 7);
+}
+
+fn valueOf(kind: Kind, b: []const u8, i: usize) f64 {
+    return switch (kind) {
+        .bf16 => @floatCast(@as(f32, @bitCast(@as(u32, std.mem.readInt(u16, b[i * 2 ..][0..2], .little)) << 16))),
+        .f32 => @floatCast(@as(f32, @bitCast(std.mem.readInt(u32, b[i * 4 ..][0..4], .little)))),
+        .fp8 => e4m3(b[i]),
+        .packed_ => 0,
+    };
+}
+
+pub fn relative(kind: Kind, a: []const u8, b: []const u8) Rel {
+    var r: Rel = .{};
+    if (kind == .packed_) {
+        r.decoded = false;
+        for (a[0..@min(a.len, b.len)], b[0..@min(a.len, b.len)]) |x, y| {
+            r.values += 1;
+            if (x != y) r.differ += 1;
+        }
+        return r;
+    }
+    const size: usize = switch (kind) {
+        .bf16 => 2,
+        .f32 => 4,
+        else => 1,
+    };
+    const n = @min(a.len, b.len) / size;
+    var sq: f64 = 0;
+    var finite: usize = 0;
+    for (0..n) |i| {
+        const y = valueOf(kind, b, i);
+        if (!std.math.isFinite(y)) continue;
+        sq += y * y;
+        finite += 1;
+    }
+    r.rms = if (finite == 0) 0 else @sqrt(sq / @as(f64, @floatFromInt(finite)));
+    for (0..n) |i| {
+        r.values += 1;
+        if (std.mem.eql(u8, a[i * size ..][0..size], b[i * size ..][0..size])) continue;
+        r.differ += 1;
+        const x = valueOf(kind, a, i);
+        const y = valueOf(kind, b, i);
+        if (!std.math.isFinite(x) or !std.math.isFinite(y)) {
+            r.nonfinite += 1;
+            continue;
+        }
+        const d = @abs(x - y);
+        r.max_abs = @max(r.max_abs, d);
+        if (d > rel_bound * r.rms) r.over += 1;
+    }
+    return r;
+}
diff --git a/zig/tests/cuda/flashnext_pshare_ride_probe.zig b/zig/tests/cuda/flashnext_pshare_ride_probe.zig
new file mode 100644
