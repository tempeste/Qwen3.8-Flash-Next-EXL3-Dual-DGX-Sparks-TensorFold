+fn testPerRow(gpa: std.mem.Allocator, kl: []const f64, top: []const bool, acc_arm: []const bool, acc_base: []const bool) !PerRow {
+    const p = try PerRow.alloc(gpa, kl.len);
+    @memcpy(p.kl, kl);
+    @memset(p.tv, 0);
+    @memcpy(p.top, top);
+    @memset(p.finite, true);
+    @memcpy(p.accept_arm, acc_arm);
+    @memcpy(p.accept_base, acc_base);
+    return p;
+}
