+constexpr int READY_WORDS = FLAG_STRIDE / 4;
+
+template <bool SUM>
+__device__ __forceinline__ void exchange_pipe(
+    const uint4* in, uint4* out, int packs, int rank, char* recv, char* flags, char* send,
+    uint32_t* ctrl, long long slot_bytes, uint32_t* counters, int klass, uint32_t spin_limit, int n_hca,
+    int chunk_packs, int max_chunks) {
+    const int tid = threadIdx.x;
+    uint32_t* chunk_stage = counters + 2 + 2 * K_CLASSES + klass * max_chunks;
+    uint32_t* tail = counters + 2 + K_CLASSES + klass;
+    if (ld_relaxed_gpu(counters + K_POISON) != 0u) return;
+    const uint32_t seq = ld_relaxed_gpu(counters + K_EPOCH) + 1u;
+    const uint32_t slot = seq & 1u;
+    const int at = blockIdx.x * blockDim.x + tid, stride = gridDim.x * blockDim.x;
+    const int chunks = (packs + chunk_packs - 1) / chunk_packs;
+    uint32_t* ready = ctrl + READY_WORDS + slot * max_chunks;
+    uint4* mine = reinterpret_cast<uint4*>(send + (long long)slot * slot_bytes);
+    uint4* own_out = out + (long long)rank * packs;
+    uint4* peer_out = out + (long long)(1 - rank) * packs;
+
+    for (int k = 0; k < chunks; ++k) {
+        const int lo = k * chunk_packs, hi = min(packs, lo + chunk_packs);
+        for (int i = lo + at; i < hi; i += stride) {
+            const uint4 v = in[i];
+            mine[i] = v;
+            if (!SUM) own_out[i] = v;
+        }
+        __syncthreads();
+        if (tid == 0) {
+            fence_sys();
+            if ((arrive(chunk_stage + k) + 1u) % gridDim.x == 0u) {
+                if (k == 0) st_relaxed_sys(ctrl + C_NBYTES + slot, (uint32_t)packs * 16u);
+                fence_sys();
+                st_relaxed_sys(ready + k, seq);
+            }
+        }
+    }
+
+    const uint4* theirs = reinterpret_cast<const uint4*>(recv + (long long)slot * slot_bytes);
+    for (int k = 0; k < chunks; ++k) {
+        if (tid < n_hca) {
+            const uint32_t* flag = reinterpret_cast<const uint32_t*>(
+                flags + (((long long)slot * max_chunks + k) * n_hca + tid) * FLAG_STRIDE);
+            uint32_t polls = 0;
+            while (ld_acquire_sys(flag) != seq) {
+                if (++polls >= spin_limit) {
+                    st_relaxed_sys(ctrl + C_HCA, (uint32_t)tid);
+                    st_relaxed_sys(ctrl + C_ERROR, seq);
+                    st_release_gpu(counters + K_POISON, seq);
+                    break;
+                }
+                if ((polls & 4095u) == 0u && ld_relaxed_gpu(counters + K_POISON) != 0u) break;
+            }
+        }
+        __syncthreads();
+        if (ld_relaxed_gpu(counters + K_POISON) != 0u) break;
+        const int lo = k * chunk_packs, hi = min(packs, lo + chunk_packs);
+        if (SUM) {
+            for (int i = lo + at; i < hi; i += stride) {
+                const uint4 own = in[i];
+                const uint4 peer = ld_relaxed_sys4(theirs + i);
+                out[i] = rank == 0 ? add_rn4(own, peer) : add_rn4(peer, own);
+            }
+        } else {
+            for (int i = lo + at; i < hi; i += stride) peer_out[i] = ld_relaxed_sys4(theirs + i);
+        }
+    }
+    fence_gpu();
+    __syncthreads();
+    if (tid == 0 && (arrive(tail) + 1u) % gridDim.x == 0u) {
+        fence_gpu();
+        if (ld_relaxed_sys(ctrl + C_ERROR) == 0u) st_release_gpu(counters + K_EPOCH, seq);
+    }
