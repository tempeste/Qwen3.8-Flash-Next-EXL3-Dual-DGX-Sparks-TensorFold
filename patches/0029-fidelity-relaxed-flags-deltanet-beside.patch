diff --git a/zig/tests/cuda/flashnext_rows_tests.zig b/zig/tests/cuda/flashnext_rows_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e74582c3ada282702430c5934812e190d241a3e3
--- /dev/null
+++ b/zig/tests/cuda/flashnext_rows_tests.zig
@@ -0,0 +1,400 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const lanes_core = @import("lanes");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const knobs = flash.knobs;
+const env = @import("sys").env;
+const Session = flash.rank_engine.Session;
+
+const knob = "TF_FLASHNEXT_ROUND_ROWS_PER_STREAM";
+const context = 4096;
+const max_streams = 32;
+const warm_rounds = 5;
+const row = prompt.vocabulary * 2;
+const settings = [_]u32{ 3, 2, 4, 5, 6 };
+
+pub const Mode = enum { budget, fixed };
+
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: *Session,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+    out: cuda.DeviceBuffer,
+    host: []u8,
+    identity: flash.rank_engine.Identity,
+    rank: usize,
+    port: u16,
+    opened: u16 = 0,
+
+    fn setKnob(k: u32) void {
+        var buf: [2:0]u8 = .{ @intCast('0' + k), 0 };
+        _ = env.setenv(knob, &buf, 1);
+    }
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, k: u32) !void {
+        _ = env.setenv("TF_FLASHNEXT_TP_KEEP_BATCH", "1", 1);
+        _ = env.setenv("TF_FLASHNEXT_KEEP_LANES", "1", 1);
+        setKnob(k);
+        r.gpu = gpu;
+        r.rank = rank;
+        r.port = port;
+        r.opened = 0;
+        r.head = null;
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        const kv = try kvCache();
+        const window = try flash.index_window.wanted();
+        r.identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        r.identity.mtp = 1;
+        r.identity.kv_cache = @intFromEnum(kv);
+        r.identity.index_window = @intFromBool(window);
+        r.session = try Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, r.identity, flash.rank_engine.linkWait());
+        r.e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank) catch |err| {
+            r.session.poison();
+            r.session.deinit();
+            return err;
+        };
+        errdefer {
+            r.session.poison();
+            r.session.deinit();
+            r.e.deinit();
+        }
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        r.e.kv = kv;
+        r.e.index_window = if (window) flash.index_window.rows(r.e.chunk) else 0;
+        try r.attach();
+        _ = try r.e.reserve(@min(context, r.e.chunk));
+        const most = knobs.roundRowsCapFor(6);
+        r.out = try cuda.DeviceBuffer.alloc(gpu.d, most * row);
+        errdefer r.out.free();
+        r.host = try gpu.gpa.alloc(u8, most * row);
+        errdefer gpu.gpa.free(r.host);
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    fn attach(r: *Rig) !void {
+        r.session.engine = r.e;
+        r.e.collective = &r.session.collective;
+        if (!r.session.keep_batch) return error.KnobUnread;
+        if (knobs.tpRoce()) try r.session.collective.openRoce(r.gpu.gpa, r.gpu.io, r.gpu.d, true, try knobs.tpRoceMaxBytes());
+    }
+
+    fn next(r: *Rig, k: u32) !void {
+        if (r.rank == 1) try r.session.follow(flash.Tri, r.tri(), r.out.ptr);
+        try r.stream.synchronize();
+        r.session.deinit();
+        setKnob(k);
+        r.identity.tp_flags = knobs.tpFlags();
+        r.opened += 1;
+        r.session = try Session.init(r.gpu.gpa, r.gpu.io, @import("flashnext_rank_tests.zig").rankHost(), r.port + r.opened, r.rank, r.identity, flash.rank_engine.linkWait());
+        try r.attach();
+    }
+
+    fn deinit(r: *Rig) void {
+        if (r.rank == 1) r.session.follow(flash.Tri, r.tri(), r.out.ptr) catch {};
+        r.session.deinit();
+        _ = env.unsetenv(knob);
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.gpu.gpa.free(r.host);
+        r.out.free();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback, .rollback_many = rollbackMany } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+    fn rollbackMany(p: *anyopaque, qs: []const *prompt.Seq, ds: []const *mtp.Draft, keeps: []const usize) anyerror!void {
+        const r = of(p);
+        return r.session.keepMany(flash.Tri, r.tri(), qs, ds, keeps);
+    }
+};
+
+fn kvCache() !flash.kv_format.Kv {
+    const v = std.c.getenv("TF_TEST_KV_CACHE") orelse return .nvfp4;
+    return std.meta.stringToEnum(flash.kv_format.Kv, std.mem.span(v)) orelse error.BadKvCache;
+}
+
+const Lane = struct {
+    q: prompt.Seq,
+    d: mtp.Draft,
+    chain: mtp.Chain = .{},
+    follow: [mtp.max_rows]u32 = undefined,
+    nf: usize = 0,
+    fresh: bool = true,
+    window: [mtp.max_rows]u32 = undefined,
+    nw: usize = 0,
+    base: u64 = 0,
+};
+
+const Record = struct {
+    tokens: [max_streams]std.ArrayList(u32) = @splat(.empty),
+    ms: f64 = 0,
+    rows: f64 = 0,
+    kept: f64 = 0,
+    rounds: usize = 0,
+
+    fn deinit(rec: *Record, gpa: std.mem.Allocator) void {
+        for (&rec.tokens) |*t| t.deinit(gpa);
+    }
+
+    fn shortest(rec: *const Record, n: usize) usize {
+        var least: usize = std.math.maxInt(usize);
+        for (rec.tokens[0..n]) |t| least = @min(least, t.items.len);
+        return least;
+    }
+};
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+fn best(bytes: []const u8) u32 {
+    const v = std.mem.bytesAsSlice(u16, bytes);
+    var at: usize = 0;
+    var top = -std.math.inf(f32);
+    for (v, 0..) |x, i| {
+        const f = bf16(x);
+        if (f > top) {
+            top = f;
+            at = i;
+        }
+    }
+    return @intCast(at);
+}
+
+fn samplingOf(i: usize) ?mtp.Sampling {
+    if (i % 2 == 0) return null;
+    return .{ .seed = 0x5eed_0000 + i, .temperature = 0.7, .top_k = 20, .top_p = 0.95 };
+}
+
+fn pick(gpa: std.mem.Allocator, bytes: []const u8, sm: ?mtp.Sampling, position: u64) !u32 {
+    const s = sm orelse return best(bytes);
+    return mtp.drawRow(gpa, @alignCast(std.mem.bytesAsSlice(u16, bytes)), null, position, s);
+}
+
+pub fn roundRows(k: u32, n: usize) usize {
+    return @max(n, @min(knobs.roundRowsCapFor(k), @max(mtp.round_rows, @as(usize, k) * n)));
+}
+
+fn grant(gpa: std.mem.Allocator, chains: []const []const f64, budget: usize, out: []usize) !void {
+    const fixed: [max_streams]u32 = @splat(1);
+    const empty: lanes_core.table.Table = .{};
+    const counts = try lanes_core.allocate.allocate(gpa, fixed[0..chains.len], chains, &empty, 0, budget);
+    defer gpa.free(counts);
+    for (out, counts) |*o, c| o.* = c;
+}
+
+fn decode(r: *Rig, seed: []const u32, n: usize, k: u32, mode: Mode, sampled: bool, want: usize, most_rounds: usize, rec: *Record) !void {
+    const gpa = r.gpu.gpa;
+    const s = r.session;
+    const ops = r.ops();
+    var lanes: [max_streams]Lane = undefined;
+    var made: usize = 0;
+    defer for (lanes[0..made]) |*l| {
+        l.d.deinit();
+        s.drop(&l.q);
+    };
+    var ids: [96]u32 = undefined;
+    for (0..n) |i| {
+        const l = &lanes[i];
+        l.* = .{ .q = try s.create(context), .d = undefined };
+        l.d = mtp.Draft.init(gpa, r.e.driver, r.stream, context, r.head.?.ids.len, r.e.chunk, r.e.heads) catch |err| {
+            s.drop(&l.q);
+            return err;
+        };
+        made += 1;
+        const len = 40 + (i * 11) % 48;
+        for (ids[0..len], 0..) |*t, j| t.* = seed[(i * 31 + j * 7) % seed.len];
+        try ops.prefill(&l.q, &l.d, ids[0..len]);
+        l.base = len;
+        const sm = if (sampled) samplingOf(i) else null;
+        l.follow[0] = try pick(gpa, l.q.logits[0..row], sm, l.base);
+        l.nf = 1;
+        try rec.tokens[i].append(gpa, l.follow[0]);
+    }
+    var qs: [max_streams]*prompt.Seq = undefined;
+    var ds: [max_streams]*mtp.Draft = undefined;
+    var nexts: [max_streams][]const u32 = undefined;
+    var rows: [max_streams]u64 = undefined;
+    var counts: [max_streams]usize = undefined;
+    var positions: [max_streams]u64 = undefined;
+    var sms: [max_streams]?mtp.Sampling = undefined;
+    var outs: [max_streams]*mtp.Chain = undefined;
+    var idss: [max_streams][]const u32 = undefined;
+    var keeps: [max_streams]usize = undefined;
+    var chances: [max_streams][mtp.max_chain]f64 = undefined;
+    var chains: [max_streams][]const f64 = undefined;
+    var granted: [max_streams]usize = undefined;
+    const confidence: f64 = if (mode == .fixed) 0 else mtp.confidenceFor(-0.4, n, 5);
+    var total: i96 = 0;
+    var timed: usize = 0;
+    var round: usize = 0;
+    while (round < most_rounds and (want == 0 or round < warm_rounds + 1 or rec.shortest(n) < want)) : (round += 1) {
+        const t0 = check.now(r.gpu.io);
+        for (lanes[0..n], 0..) |*l, i| {
+            qs[i] = &l.q;
+            ds[i] = &l.d;
+            nexts[i] = l.follow[0..l.nf];
+            rows[i] = if (l.fresh) l.d.prompt_last else l.d.streams.ptr;
+            counts[i] = @min(mtp.default_depth, l.q.cap - l.q.fed - 1);
+            positions[i] = l.q.fed + 1;
+            sms[i] = if (sampled) samplingOf(i) else null;
+            outs[i] = &l.chain;
+        }
+        try ops.draftMany(ds[0..n], nexts[0..n], rows[0..n], counts[0..n], positions[0..n], sms[0..n], confidence, outs[0..n], null);
+        for (lanes[0..n], 0..) |*l, i| {
+            var c: f64 = 1;
+            for (l.chain.probs[0..l.chain.n], 0..) |p, j| {
+                c *= p;
+                chances[i][j] = c;
+            }
+            chains[i] = chances[i][0..l.chain.n];
+        }
+        switch (mode) {
+            .budget => try grant(gpa, chains[0..n], roundRows(k, n), granted[0..n]),
+            .fixed => for (lanes[0..n], granted[0..n]) |*l, *g| {
+                g.* = @min(l.chain.n, k - 1);
+            },
+        }
+        var total_rows: usize = 0;
+        for (lanes[0..n], granted[0..n], 0..) |*l, g, i| {
+            l.window[0] = l.follow[l.nf - 1];
+            @memcpy(l.window[1..][0..g], l.chain.slice()[0..g]);
+            l.nw = 1 + g;
+            idss[i] = l.window[0..l.nw];
+            total_rows += l.nw;
+        }
+        try s.verifyMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], idss[0..n], r.out.ptr);
+        try r.stream.synchronize();
+        const scores = r.host[0 .. total_rows * row];
+        try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoH_v2(scores.ptr, r.out.ptr, scores.len), "cuMemcpyDtoH");
+        var at: usize = 0;
+        var kept_all: usize = 0;
+        for (lanes[0..n], 0..) |*l, i| {
+            var kept: usize = 0;
+            while (true) {
+                const position = l.base + rec.tokens[i].items.len;
+                const g = try pick(gpa, scores[(at + kept) * row ..][0..row], sms[i], position);
+                l.follow[kept] = g;
+                try rec.tokens[i].append(gpa, g);
+                kept += 1;
+                if (kept == l.nw or l.window[kept] != g) break;
+            }
+            at += l.nw;
+            l.nf = kept;
+            l.fresh = false;
+            keeps[i] = kept;
+            kept_all += kept;
+        }
+        try s.keepMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], keeps[0..n]);
+        if (round >= warm_rounds) {
+            total += check.now(r.gpu.io) - t0;
+            rec.rows += @floatFromInt(total_rows);
+            rec.kept += @floatFromInt(kept_all);
+            timed += 1;
+        }
+    }
+    try r.stream.synchronize();
+    rec.rounds = round;
+    if (timed == 0) return error.TooFewRounds;
+    const t: f64 = @floatFromInt(timed);
+    rec.ms = @as(f64, @floatFromInt(total)) / 1e6 / t;
+    rec.rows /= t;
+    rec.kept /= t;
+}
+
+const Arm = struct { n: usize, sampled: bool };
+const arms = [_]Arm{ .{ .n = 28, .sampled = false }, .{ .n = 28, .sampled = true }, .{ .n = 12, .sampled = true } };
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, want: usize) !void {
+    if (want < 8 or want > 2048) return error.BadTokens;
+    var seed = try @import("flashnext_keep_early_tests.zig").seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, settings[0]);
+    defer r.deinit();
+    var refs: [arms.len]Record = @splat(.{});
+    defer for (&refs) |*x| x.deinit(gpu.gpa);
+    for (settings, 0..) |k, si| {
+        if (si > 0) try r.next(k);
+        if (rank == 1) continue;
+        for (arms, &refs) |a, *ref| {
+            var rec: Record = .{};
+            defer rec.deinit(gpu.gpa);
+            const into = if (si == 0) ref else &rec;
+            try decode(&r, seed.items, a.n, k, .budget, a.sampled, want, 64 * want, into);
+            std.debug.print("RESULT rows k={d} streams={d} sampled={any} rounds={d}: {d:.2} ms a round, {d:.1} rows a round, {d:.2} tokens a stream a round\n", .{ k, a.n, a.sampled, into.rounds, into.ms, into.rows, into.kept / @as(f64, @floatFromInt(a.n)) });
+            if (si == 0) continue;
+            for (ref.tokens[0..a.n], rec.tokens[0..a.n], 0..) |x, y, i| {
+                const m = @min(want, x.items.len, y.items.len);
+                try check.expect(m == want, "k={d} {d} streams: stream {d} has {d} tokens, wanted {d}", .{ k, a.n, i, m, want });
+                const first = std.mem.indexOfDiff(u32, x.items[0..m], y.items[0..m]);
+                try check.expect(first == null, "k={d} {d} streams sampled={any}: stream {d}'s tokens differ from k=3 at token {?d}", .{ k, a.n, a.sampled, i, first });
+            }
+            check.pass("k={d}, {d} streams, sampled={any}: every stream's first {d} tokens equal k=3's", .{ k, a.n, a.sampled, want });
+        }
+    }
+    if (rank == 1) return check.pass("rank 1 followed {d} sessions", .{settings.len});
+}
+
+pub fn bench(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, n: usize, rounds: usize, reps: usize, mode: Mode) !void {
+    if (n < 1 or n > max_streams or rounds <= warm_rounds or reps == 0 or reps > 16) return error.BadBench;
+    var seed = try @import("flashnext_keep_early_tests.zig").seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, settings[0]);
+    defer r.deinit();
+    var ms: [settings.len][16]f64 = undefined;
+    var rows: [settings.len]f64 = @splat(0);
+    var kept: [settings.len]f64 = @splat(0);
+    for (0..reps) |rep| {
+        for (settings, 0..) |k, si| {
+            if (rep > 0 or si > 0) try r.next(k);
+            if (rank == 1) continue;
+            var rec: Record = .{};
+            defer rec.deinit(gpu.gpa);
+            try decode(&r, seed.items, n, k, mode, false, 0, rounds, &rec);
+            ms[si][rep] = rec.ms;
+            rows[si] += rec.rows / @as(f64, @floatFromInt(reps));
+            kept[si] += rec.kept / @as(f64, @floatFromInt(reps));
+        }
+    }
+    if (rank == 1) return check.pass("rank 1 followed the bench's {d} sessions", .{settings.len * reps});
+    const base = check.median(ms[0][0..reps]);
+    for (settings, 0..) |k, si| {
+        const m = check.median(ms[si][0..reps]);
+        const gain = (kept[si] / m) / (kept[0] / base) * 100 - 100;
+        std.debug.print("BENCH rows-round mode={s} streams={d} k={d} rounds={d} reps={d} ms={d:.2} rows={d:.1} tokens={d:.2} tokens_a_stream={d:.3} tok_s={d:.1} vs_k3={s}{d:.1}%\n", .{ @tagName(mode), n, k, rounds - warm_rounds, reps, m, rows[si], kept[si], kept[si] / @as(f64, @floatFromInt(n)), kept[si] / m * 1000, if (gain >= 0) "+" else "", gain });
+    }
+}
