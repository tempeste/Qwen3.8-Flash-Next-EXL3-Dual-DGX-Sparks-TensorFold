+
+pub fn triRun(gpu: check.Gpu) !void {
+    var prng = std.Random.DefaultPrng.init(39710);
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const f = try (try lay.Fns.load(batch)).withFull(batch);
+    var checks: usize = 0;
+    for (g3.heads, 0..) |h, i| {
+        for (tri_variants) |tv| {
+            const sfx_fns = if (i == 0) [2]chunk.Fns{ try chunk.Fns.loadWith(batch, "", tv.o), try chunk.Fns.loadWith(batch, "", withTri(tv.o)) } else [2]chunk.Fns{ try chunk.Fns.loadWith(batch, "_h8", tv.o), try chunk.Fns.loadWith(batch, "_h8", withTri(tv.o)) };
+            const sb = stateN(h) * @as(usize, if (tv.o.half_state) 2 else 4);
+            for ([_]g3.Decay{ .fast, .slow }) |decay| {
+                for ([_]usize{ 3072, 1536, 1000, 129, 64, 63, 1 }) |m| {
+                    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+                    defer arena.deinit();
+                    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+                    defer r.deinit();
+                    const in = try g3.inputs(&r, h, m, decay);
+                    const s0 = try r.back(f32, in[6], stateN(h));
+                    var xo: [2]g3.Scan = undefined;
+                    var oo: [2]g3.Out = undefined;
+                    for (&xo, &oo, &sfx_fns) |*x, *o, *c| {
+                        x.* = try g3.scan(&r, h, m);
+                        o.* = try g3.outs(&r, h, m, 2);
+                        o.st = try triState(&r, s0, tv.o.half_state);
+                        try g3.block(&r, &f, c, h, m, in, o.st, x.*, o.*);
+                    }
+                    const ob = lay.bytes(.values, 2, m, h);
+                    const xb = lay.bytes(.sums, 4, m, h);
+                    var diff = try sameBytes(&r, oo[0].out, oo[1].out, ob) + try sameBytes(&r, oo[0].xs, oo[1].xs, xb) + try sameBytes(&r, oo[0].st, oo[1].st, sb);
+                    if (m >= 2) {
+                        const k = m / 2;
+                        const vd = h.valueDim();
+                        var st: [2]u64 = undefined;
+                        var out: [2]u64 = undefined;
+                        var xs: [2]u64 = undefined;
+                        const wy = try r.out(@max(chunk.scratchBytes(m), 16));
+                        for (&st, &out, &xs, &sfx_fns, xo) |*s, *o, *x, *c, sc| {
