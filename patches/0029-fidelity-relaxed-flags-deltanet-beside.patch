+                            o.* = try r.out(ob);
+                            x.* = try r.out(xb);
+                            try chunk.launchAt(c, r.s, h, k, sc.qn, sc.kn, sc.v, sc.gb, s.*, s.*, wy, 0, .{ .proj = in[0], .norm_w = in[5], .out = o.*, .xs = x.* });
+                            try chunk.launchAt(c, r.s, h, m - k, sc.qn + k * c.qkRow(h), sc.kn + k * c.qkRow(h), sc.v + k * c.vRow(h), sc.gb + k * h.nv * 8, s.*, s.*, wy, 0, .{ .proj = in[0] + k * h.projWidth() * 2, .norm_w = in[5], .out = o.* + k * vd * 2, .xs = x.* + k * (vd / 32) * 4 });
+                        }
+                        diff += try sameBytes(&r, st[0], st[1], sb) + try sameBytes(&r, out[0], out[1], ob) + try sameBytes(&r, xs[0], xs[1], xb);
