+    }
+    check.pass("flashnext-gdn-wy-tri: {d} checks (full and _h8 heads, NORM_FUSED with and without RELAXED and the fp16 state, 1 to 3,072 rows, split passes): GDN_WY_TRI gives the same bytes", .{checks});
+}
