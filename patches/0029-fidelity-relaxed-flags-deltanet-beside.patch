--- /dev/null
+++ b/zig/tests/cuda/flashnext_pshare_ride_probe.zig
@@ -0,0 +1,148 @@
+const std = @import("std");
+const lanes = @import("lanes");
+const flash = @import("flashnext");
+const img = @import("flashnext_pshare_ride_image.zig");
+
+pub const Kind = enum { observe, keep };
+
+const Saver = struct {
+    target: *anyopaque,
+    kind: Kind,
+    saves: usize = 0,
+    refused: usize = 0,
+
+    fn at(ptr: *anyopaque, s: *lanes.Stream, pos: u32) void {
+        const k: *Saver = @ptrCast(@alignCast(ptr));
+        if (k.kind == .observe) return;
+        const saved = flash.native.snap_save(k.target, s, pos) catch {
+            k.refused += 1;
+            return;
+        };
+        flash.native.snap_drop(k.target, saved);
+        k.saves += 1;
+    }
+};
+
+pub const Run = struct {
+    cuts: std.ArrayList(u32) = .empty,
+    modes: std.ArrayList(u8) = .empty,
+    states: std.ArrayList(img.Sums) = .empty,
+    final: img.Image = .{},
+    saves: usize = 0,
+    refused: usize = 0,
+
+    pub fn deinit(r: *Run, gpa: std.mem.Allocator) void {
+        r.cuts.deinit(gpa);
+        r.modes.deinit(gpa);
+        for (r.states.items) |*x| x.deinit(gpa);
+        r.states.deinit(gpa);
+        r.final.deinit(gpa);
+    }
+};
+
+const Rig = struct {
+    gpa: std.mem.Allocator,
+    engine: *lanes.Engine,
+    cu: *flash.native.Cuda,
+    piece_rows: u32,
+    reply: u32,
+};
+
+const Progress = struct { rows0: u64, ride0: u64, at: u32 = 0, ridden: u64 = 0 };
+
+fn note(r: Rig, s: *lanes.Stream, p: *Progress, run: *Run) !void {
+    const rows: u32 = @intCast(lanes.prefill_rows_run.load(.monotonic) - p.rows0);
+    if (rows == p.at) return;
+    const ridden = lanes.prompt_rows_ridden.load(.monotonic) - p.ride0;
+    const step_rows = rows - p.at;
+    const step_ridden = ridden - p.ridden;
+    const mode: u8 = if (step_ridden == 0) 'A' else if (step_ridden == step_rows) 'R' else 'M';
+    try run.modes.append(r.gpa, mode);
+    p.at = rows;
+    p.ridden = ridden;
+    try run.cuts.append(r.gpa, rows);
+    var m = try img.image(r.gpa, r.cu, s, .states);
+    defer m.deinit(r.gpa);
+    try run.states.append(r.gpa, try m.sums(r.gpa));
+}
+
+fn fill(r: Rig, toks: []const u32, marks: []const u32, kind: Kind) !Run {
+    var saver: Saver = .{ .target = r.cu, .kind = kind };
+    var s = try lanes.Stream.init(r.gpa, .{ .id = "probe", .prompt = toks, .max_new = r.reply, .reuse = .{ .marks = marks, .hook = .{ .ptr = &saver, .at = Saver.at } } });
+    defer s.deinit(r.gpa);
+    var run: Run = .{};
+    errdefer run.deinit(r.gpa);
+    var p: Progress = .{ .rows0 = lanes.prefill_rows_run.load(.monotonic), .ride0 = lanes.prompt_rows_ridden.load(.monotonic) };
+    var first = true;
+    var calls: usize = 0;
+    while (true) : (calls += 1) {
+        if (calls > 4 * (toks.len / 64 + 8)) return error.FillDidNotFinish;
+        const done = try r.engine.fillStreamCommitted(&s, first, null, r.piece_rows);
+        first = false;
+        try note(r, &s, &p, &run);
+        if (done) break;
+        try r.engine.step();
+        try note(r, &s, &p, &run);
+    }
+    run.final = try img.image(r.gpa, r.cu, &s, .all);
+    run.saves = saver.saves;
+    run.refused = saver.refused;
+    while (!s.finished) try r.engine.step();
+    return run;
+}
+
+fn compare(where: []const u8, what: []const u8, a: *const Run, b: *const Run) ?bool {
+    if (!std.mem.eql(u32, a.cuts.items, b.cuts.items)) {
+        std.debug.print("PROBE {s} {s}: not comparable, passes ended at {any} against {any}\n", .{ where, what, a.cuts.items, b.cuts.items });
+        return null;
+    }
+    var cut: ?usize = null;
+    var name: img.Name = .{ .what = "", .layer = 0 };
+    for (a.states.items, b.states.items, 0..) |*x, *y, i| if (x.firstDiff(y)) |n| {
+        cut = i;
+        name = n;
+        break;
+    };
+    const d = img.firstDiff(&a.final, &b.final);
+    const meta = a.final.fed != b.final.fed or !std.mem.eql(i64, &a.final.history, &b.final.history);
+    if (cut == null and d == null and !meta) {
+        std.debug.print("PROBE {s} {s}: byte-equal (passes end at {any}, modes {s} and {s})\n", .{ where, what, a.cuts.items, a.modes.items, b.modes.items });
+        return true;
+    }
+    std.debug.print("PROBE {s} {s}: DIFFER (passes end at {any}, modes {s} against {s}); ", .{ where, what, a.cuts.items, a.modes.items, b.modes.items });
+    if (cut) |i| std.debug.print("states first differ after the pass ending at {d} ({s} of layer {d}); ", .{ a.cuts.items[i], name.what, name.layer }) else std.debug.print("states equal at every pass end; ", .{});
+    if (d) |x| std.debug.print("final: {s} of layer {d}, {d} of {d} words, first word {d}: {x:0>8} for {x:0>8} ({d} bf16 ulps)\n", .{ x.section.what, x.section.layer, x.words, x.total, x.first, x.got, x.want, img.bf16Ulps(x.got, x.want) }) else std.debug.print("final: sections equal, position or history differs\n", .{});
+    return false;
+}
+
+pub const Outcome = struct {
+    first_equal: ?bool,
+    steady_equal: ?bool,
+    keeps_equal: ?bool,
+
+    pub fn keepFault(o: Outcome) bool {
+        return (o.steady_equal orelse false) and !(o.keeps_equal orelse true);
+    }
+};
+
+pub fn probe(gpa: std.mem.Allocator, engine: *lanes.Engine, cu: *flash.native.Cuda, piece_rows: u32, reply: u32, where: []const u8, toks: []const u32, marks: []const u32) !Outcome {
+    const r: Rig = .{ .gpa = gpa, .engine = engine, .cu = cu, .piece_rows = piece_rows, .reply = reply };
+    var o1 = try fill(r, toks, marks, .observe);
+    defer o1.deinit(gpa);
+    var o2 = try fill(r, toks, marks, .observe);
+    defer o2.deinit(gpa);
+    var k = try fill(r, toks, marks, .keep);
+    defer k.deinit(gpa);
+    var o3 = try fill(r, toks, marks, .observe);
+    defer o3.deinit(gpa);
+    std.debug.print("PROBE {s}: a {d}-token prompt marked at {any}, four fills each run to its {d}-token reply before the next (observe, observe, keep, observe); the keep fill saved {d} states, {d} refused\n", .{ where, toks.len, marks, reply, k.saves, k.refused });
+    return .{
+        .first_equal = compare(where, "first fill against the second", &o1, &o2),
+        .steady_equal = compare(where, "second fill against the fourth", &o2, &o3),
+        .keeps_equal = compare(where, "fill that keeps at its marks against the fourth", &k, &o3),
+    };
+}
+
+pub fn tokens(out: []u32, ids: []const u32, salt: usize) void {
+    for (out, 0..) |*t, i| t.* = ids[(i * 17 + 11 + salt * 29) % ids.len];
+}
