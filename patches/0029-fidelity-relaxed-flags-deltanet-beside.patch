+                try same(&r, "compact vs production: gated-norm sums", h, m, op.xs, oc.xs, xb);
+                try same(&r, "compact vs production: state", h, m, op.st, oc.st, sb);
+                try same(&r, "compact vs YS_BF16: bf16 readouts", h, m, oy.ys, oc.ys, ob);
+                try same(&r, "compact vs production: WY blocks", h, m, op.wy, oc.wy, chunk.scratchBytes(m));
+                const xn = try scan(&r, h, m);
+                const on = try outs(&r, h, m, 2);
+                try block(&r, &l.f, &l.normed[i], h, m, in, in[6], xn, on);
+                try same(&r, "norm in the state kernel vs production: gated-norm rows", h, m, op.out, on.out, ob);
+                try same(&r, "norm in the state kernel vs production: gated-norm sums", h, m, op.xs, on.xs, xb);
+                try same(&r, "norm in the state kernel vs production: state", h, m, op.st, on.st, sb);
+                const q32 = try r.back(f32, xp.qn, m * h.nk * lay.dk);
+                const k32 = try r.back(f32, xp.kn, m * h.nk * lay.dk);
+                const v32 = try r.back(f32, xp.v, m * h.valueDim());
+                const row = l.compact[i].qkRow(h);
+                const qc = try r.back(u8, xc.qn, m * row);
+                const kc = try r.back(u8, xc.kn, m * row);
+                const vc = try r.back(u16, xc.v, m * h.valueDim());
+                var bad: usize = 0;
+                for (0..m) |t| {
+                    for (0..h.nk) |hk| {
+                        for (0..lay.dk) |d| {
+                            for ([_][]const u8{ qc, kc }, [_][]const f32{ q32, k32 }) |cb, wide| {
+                                const x: u16 = std.mem.readInt(u16, cb[t * row + (hk * lay.dk + d) * 2 ..][0..2], .little);
+                                const sc: f32 = @bitCast(std.mem.readInt(u32, cb[t * row + h.nk * lay.dk * 2 + hk * 4 ..][0..4], .little));
+                                const got: f32 = @as(f32, @bitCast(@as(u32, x) << 16)) * sc;
+                                bad += @intFromBool(@as(u32, @bitCast(got)) != @as(u32, @bitCast(wide[(t * h.nk + hk) * lay.dk + d])));
+                            }
+                        }
+                    }
+                }
+                for (vc, v32) |x, w| bad += @intFromBool(@as(u32, x) << 16 != @as(u32, @bitCast(w)));
+                try check.expect(bad == 0, "flashnext-gdn-compact {s} heads, {d} rows: {d} compact q/k/v values are not the fp32 front's bits", .{ name(h), m, bad });
+                checks += 1;
+                if (m >= 2) {
+                    const k = m / 2;
+                    const st_p = try r.dev(std.mem.sliceAsBytes(try r.back(f32, in[6], h.nv * lay.dv * lay.dk)));
+                    const st_c = try r.dev(std.mem.sliceAsBytes(try r.back(f32, in[6], h.nv * lay.dv * lay.dk)));
+                    const ys_p = try r.out(ob);
+                    const ys_c = try r.out(ob);
+                    const wy = try r.out(@max(chunk.scratchBytes(m), 16));
+                    const cy = &l.ys[i];
+                    const cc = &l.compact[i];
+                    try chunk.launch(cy, r.s, h, k, xy.qn, xy.kn, xy.v, xy.gb, st_p, st_p, wy, ys_p);
+                    try chunk.launch(cy, r.s, h, m - k, xy.qn + k * cy.qkRow(h), xy.kn + k * cy.qkRow(h), xy.v + k * cy.vRow(h), xy.gb + k * h.nv * 8, st_p, st_p, wy, ys_p + k * h.valueDim() * 2);
+                    try chunk.launch(cc, r.s, h, k, xc.qn, xc.kn, xc.v, xc.gb, st_c, st_c, wy, ys_c);
+                    try chunk.launch(cc, r.s, h, m - k, xc.qn + k * cc.qkRow(h), xc.kn + k * cc.qkRow(h), xc.v + k * cc.vRow(h), xc.gb + k * h.nv * 8, st_c, st_c, wy, ys_c + k * h.valueDim() * 2);
+                    try same(&r, "compact split at the mark: state", h, m, st_p, st_c, sb);
+                    try same(&r, "compact split at the mark: readouts", h, m, ys_p, ys_c, ob);
+                    const st_n = try r.dev(std.mem.sliceAsBytes(try r.back(f32, in[6], h.nv * lay.dv * lay.dk)));
+                    const out_n = try r.out(ob);
+                    const xs_n = try r.out(xb);
+                    const out_p = try r.out(ob);
+                    const xs_p = try r.out(xb);
+                    const cn = &l.normed[i];
+                    const vd = h.valueDim();
+                    try lay.norm(cy.norm(l.f.of(.norm, h)), r.s, h, m, ys_p, in[0], in[5], out_p, xs_p);
+                    try chunk.launchAt(cn, r.s, h, k, xn.qn, xn.kn, xn.v, xn.gb, st_n, st_n, wy, 0, .{ .proj = in[0], .norm_w = in[5], .out = out_n, .xs = xs_n });
+                    try chunk.launchAt(cn, r.s, h, m - k, xn.qn + k * cn.qkRow(h), xn.kn + k * cn.qkRow(h), xn.v + k * cn.vRow(h), xn.gb + k * h.nv * 8, st_n, st_n, wy, 0, .{ .proj = in[0] + k * h.projWidth() * 2, .norm_w = in[5], .out = out_n + k * vd * 2, .xs = xs_n + k * (vd / 32) * 4 });
+                    try same(&r, "norm in the state kernel, split at the mark: state", h, m, st_p, st_n, sb);
+                    try same(&r, "norm in the state kernel, split at the mark: gated-norm rows", h, m, out_p, out_n, ob);
+                    try same(&r, "norm in the state kernel, split at the mark: gated-norm sums", h, m, xs_p, xs_n, xb);
+                    checks += 1;
+                }
+                std.debug.print("RESULT flashnext-gdn-compact {s} heads, {d} rows, {s} decay: COMPACT and NORM_FUSED gated-norm rows, sums, state (and COMPACT's WY blocks and readouts) byte-equal to production; split at row {d} byte-equal\n", .{ name(h), m, @tagName(decay), m / 2 });
+            }
+        }
+    }
+    check.pass("flashnext-gdn-compact: {d} checks (full and _h8 heads, fast and slow decay, 1 to 3,072 rows, split passes): GDN_COMPACT and GDN_NORM_FUSED give production's bytes", .{checks});
+}
+
+pub fn median(xs: []f64) f64 {
+    std.mem.sort(f64, xs, {}, std.sort.asc(f64));
+    return xs[xs.len / 2];
+}
+
+const warm = 3;
+const reps = 25;
+
+pub fn time(r: *Rig, body: anytype) !f64 {
+    var start = try cuda.Event.init(r.gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(r.gpu.d, true);
+    defer end.deinit();
+    var us: [reps]f64 = undefined;
+    for (0..warm + reps) |i| {
+        try start.record(r.s);
+        try body.go(r);
+        try end.record(r.s);
+        try r.s.synchronize();
+        if (i >= warm) us[i - warm] = @as(f64, try start.elapsedMs(end)) * 1000;
+    }
+    return median(&us);
+}
+
+pub fn rowsArg(rest: []const []const u8, buf: []usize, default: []const usize) ![]const usize {
+    if (rest.len == 0) return default;
+    if (rest.len > buf.len) return error.GdnBenchArguments;
+    for (rest, 0..) |s, i| buf[i] = try std.fmt.parseInt(usize, s, 10);
+    return buf[0..rest.len];
+}
+
+pub fn compactBench(gpu: check.Gpu, rest: []const []const u8) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(39704);
+    var l = try Loaded.load(gpu);
+    defer l.batch.unload();
+    var buf: [8]usize = undefined;
+    const rows = try rowsArg(rest, &buf, &.{ 3072, 1536 });
+    for ([_]usize{ 1, 0 }) |i| {
+        const h = heads[i];
+        for (rows) |m| {
+            var r = try Rig.init(gpu, arena.allocator(), prng.random());
+            defer r.deinit();
+            const in = try inputs(&r, h, m, .fast);
+            const x = try scan(&r, h, m);
+            const o = try outs(&r, h, m, 4);
+            const Block = struct {
+                f: *const lay.Fns,
+                c: *const chunk.Fns,
+                h: Heads,
+                m: usize,
+                in: [7]u64,
+                x: Scan,
+                o: Out,
+                fn go(t: @This(), rr: *Rig) !void {
+                    try block(rr, t.f, t.c, t.h, t.m, t.in, t.o.st, t.x, t.o);
+                }
+            };
+            const State = struct {
+                c: *const chunk.Fns,
+                h: Heads,
+                m: usize,
+                x: Scan,
+                o: Out,
+                p: u64,
+                nw: u64,
+                fn go(t: @This(), rr: *Rig) !void {
+                    if (t.c.normed) |n| return chunk.stateNormed(n, rr.s, t.h, t.m, t.x.qn, t.x.kn, t.x.v, t.o.st, t.o.st, t.o.wy, .{ .proj = t.p, .norm_w = t.nw, .out = t.o.out, .xs = t.o.xs });
+                    const f = if (t.c.compact) |c| c.state else if (t.c.narrow) |n| n.state else t.c.state;
+                    var a: cuda.Args = .{};
+                    for ([_]u64{ t.x.qn, t.x.kn, t.x.v, t.o.wy, t.o.st, t.o.st }) |p| a.add(p);
+                    a.add(@as(c_int, @intCast(t.m)));
+                    a.add(t.o.ys);
+                    try cuda.launch.launch(f, .{ .grid = .{ .x = t.h.nv, .y = 128 / chunk.value_tile }, .block = .{ .x = chunk.threads }, .shared = chunk.state_smem }, rr.s, &a);
+                }
+            };
+            const sets = [_]*const chunk.Fns{ &l.prod[i], &l.ys[i], &l.compact[i], &l.normed[i], &l.relaxed[i], &l.relaxed_compact[i], &l.relaxed_normed[i] };
+            const names = [_][]const u8{ "production", "YS_BF16", "YS_BF16+COMPACT", "YS_BF16+COMPACT+NORM_FUSED", "RELAXED", "YS_BF16+COMPACT+RELAXED", "YS_BF16+COMPACT+NORM_FUSED+RELAXED" };
+            var blk: [sets.len]f64 = undefined;
+            var st: [sets.len]f64 = undefined;
+            for (sets, 0..) |c, j| {
+                try block(&r, &l.f, c, h, m, in, o.st, x, o);
+                blk[j] = try time(&r, Block{ .f = &l.f, .c = c, .h = h, .m = m, .in = in, .x = x, .o = o });
+                st[j] = try time(&r, State{ .c = c, .h = h, .m = m, .x = x, .o = o, .p = in[0], .nw = in[5] });
+            }
+            const ms = @as(f64, layers) / 1000;
+            for (sets, 0..) |_, j| {
+                std.debug.print("RESULT flashnext-gdn-compact-bench {s} heads, {d} rows, {s}: front+prep+state+norm {d:.1} us, state kernel {d:.1} us; per {d} layers {d:.2} ms, saves {d:.2} ms against production\n", .{ name(h), m, names[j], blk[j], st[j], layers, blk[j] * ms, (blk[0] - blk[j]) * ms });
+            }
+        }
+    }
+}
+
+pub const Err = struct {
+    max: f64 = 0,
+    num: f64 = 0,
+    den: f64 = 0,
+    sum: f64 = 0,
+    n: usize = 0,
+    bad: usize = 0,
+
+    pub fn add(e: *Err, got: f64, want: f64) void {
+        if (!std.math.isFinite(got)) e.bad += 1;
+        const d = @abs(got - want);
+        e.max = @max(e.max, d);
+        e.num += d * d;
+        e.den += want * want;
+        e.sum += d;
+        e.n += 1;
+    }
+
+    pub fn rel(e: Err) f64 {
+        return @sqrt(e.num / @max(e.den, 1e-300));
+    }
+
+    pub fn rms(e: Err) f64 {
+        return @sqrt(e.den / @as(f64, @floatFromInt(@max(e.n, 1))));
+    }
+};
+
+const Bound = struct { state_rel: f64, ys_rel: f64, out_rel: f64 };
+const relaxed_bound: Bound = .{ .state_rel = 2e-3, .ys_rel = 6e-3, .out_rel = 8e-3 };
+
+pub fn relaxedRun(gpu: check.Gpu, rest: []const []const u8) !void {
+    var prng = std.Random.DefaultPrng.init(39705);
+    var l = try Loaded.load(gpu);
+    defer l.batch.unload();
+    const passes: usize = if (rest.len > 0) try std.fmt.parseInt(usize, rest[0], 10) else 40;
+    const m: usize = if (rest.len > 1) try std.fmt.parseInt(usize, rest[1], 10) else 3072;
+    for ([_]usize{ 1, 0 }) |i| {
+        const h = heads[i];
+        for ([_]Decay{ .fast, .slow }) |decay| {
+            var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+            defer arena.deinit();
+            var r = try Rig.init(gpu, arena.allocator(), prng.random());
+            defer r.deinit();
+            const s0 = r.f32s(h.nv * lay.dv * lay.dk, -0.5, 0.5);
+            const in = try inputs(&r, h, m, decay);
+            const x = try scan(&r, h, m);
+            const xc = try scan(&r, h, m);
+            var oe = try outs(&r, h, m, 4);
+            var orl = try outs(&r, h, m, 4);
+            var oc = try outs(&r, h, m, 2);
+            var onr = try outs(&r, h, m, 2);
+            const xn = try scan(&r, h, m);
+            onr.st = try r.dev(std.mem.sliceAsBytes(s0));
+            oe.st = try r.dev(std.mem.sliceAsBytes(s0));
+            orl.st = try r.dev(std.mem.sliceAsBytes(s0));
+            oc.st = try r.dev(std.mem.sliceAsBytes(s0));
+            const st_e = oe.st;
+            const st_r = orl.st;
+            const proj: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = in[0], .len = m * h.projWidth() * 2 };
+            const host_proj = try r.a.alloc(u16, m * h.projWidth());
+            var ey: Err = .{};
+            var eo: Err = .{};
+            var out_diff: usize = 0;
+            var fmt_diff: usize = 0;
+            var worst_state: f64 = 0;
+            for (0..passes) |_| {
+                var pa: std.heap.ArenaAllocator = .init(gpu.gpa);
+                defer pa.deinit();
+                const saved = r.a;
+                r.a = pa.allocator();
+                defer r.a = saved;
+                for (host_proj) |*p| p.* = rig_.bf16((r.rng.float(f32) * 2 - 1));
+                try r.s.synchronize();
+                try proj.upload(0, std.mem.sliceAsBytes(host_proj));
+                try block(&r, &l.f, &l.prod[i], h, m, in, st_e, x, oe);
+                try block(&r, &l.f, &l.relaxed[i], h, m, in, st_r, x, orl);
+                try block(&r, &l.f, &l.relaxed_compact[i], h, m, in, oc.st, xc, oc);
+                try block(&r, &l.f, &l.relaxed_normed[i], h, m, in, onr.st, xn, onr);
+                for (try r.back(u16, onr.out, m * h.valueDim()), try r.back(u16, oc.out, m * h.valueDim())) |a, b| fmt_diff += @intFromBool(a != b);
+                const ye = try r.back(f32, oe.ys, m * h.valueDim());
+                const yr = try r.back(f32, orl.ys, m * h.valueDim());
+                for (yr, ye) |g, w| ey.add(g, w);
+                const ue = try r.back(u16, oe.out, m * h.valueDim());
+                const ur = try r.back(u16, orl.out, m * h.valueDim());
+                const uc = try r.back(u16, oc.out, m * h.valueDim());
+                for (ur, ue, uc) |g, w, c| {
+                    eo.add(rig_.bf(g), rig_.bf(w));
+                    out_diff += @intFromBool(g != w);
+                    fmt_diff += @intFromBool(g != c);
+                }
+                var ps: Err = .{};
+                for (try r.back(f32, st_r, h.nv * lay.dv * lay.dk), try r.back(f32, st_e, h.nv * lay.dv * lay.dk)) |g, w| ps.add(g, w);
+                worst_state = @max(worst_state, ps.rel());
+            }
+            var es: Err = .{};
+            for (try r.back(f32, st_r, h.nv * lay.dv * lay.dk), try r.back(f32, st_e, h.nv * lay.dv * lay.dk)) |g, w| es.add(g, w);
+            const steps = passes * m;
+            const n_out = steps * h.valueDim();
+            std.debug.print("RESULT flashnext-gdn-relaxed {s} heads, {s} decay, {d} passes of {d} rows ({d} steps): state rel-L2 {e:.3} (worst pass {e:.3}), max|err|/rms {e:.3}, mean|err|/rms {e:.3}; readouts rel-L2 {e:.3}, max|err|/rms {e:.3}, mean|err|/rms {e:.3}; " ++
+                "gated-norm rows rel-L2 {e:.3}, {d:.4} of bf16 values differ; the relaxed fp32, COMPACT and NORM_FUSED kernels differ in {d} values\n", .{
+                name(h),      @tagName(decay), passes,                         m,            steps,          es.rel(),            worst_state, es.max / es.rms(), es.sum / @as(f64, @floatFromInt(es.n)) / es.rms(), ey.rel(), ey.max / ey.rms(), ey.sum / @as(f64, @floatFromInt(ey.n)) / ey.rms(),
+                eo.rel(),     @as(f64, @floatFromInt(out_diff)) / @as(f64, @floatFromInt(n_out)), fmt_diff,
+            });
+            try check.expect(es.bad == 0 and ey.bad == 0 and eo.bad == 0, "flashnext-gdn-relaxed {s}: non-finite values", .{name(h)});
+            try check.expect(fmt_diff == 0, "flashnext-gdn-relaxed {s}: the compact relaxed kernel differs from the fp32 one in {d} values", .{ name(h), fmt_diff });
+            try check.expect(worst_state <= relaxed_bound.state_rel and ey.rel() <= relaxed_bound.ys_rel and eo.rel() <= relaxed_bound.out_rel, "flashnext-gdn-relaxed {s} {s}: state rel-L2 {e} (bound {e}), readouts {e} ({e}), gated-norm rows {e} ({e})", .{ name(h), @tagName(decay), worst_state, relaxed_bound.state_rel, ey.rel(), relaxed_bound.ys_rel, eo.rel(), relaxed_bound.out_rel });
+        }
+    }
+    check.pass("flashnext-gdn-relaxed: the relaxed chunked chain stays within state rel-L2 {e}, readouts {e} and gated-norm rows {e} of the exact one over {d} carried passes", .{ relaxed_bound.state_rel, relaxed_bound.ys_rel, relaxed_bound.out_rel, passes });
+}
+
+pub const LaneFns = struct {
+    keep: cuda.Function,
+    front: cuda.Function,
+    chain: cuda.Function,
+    shift: cuda.Function,
+    front_w: cuda.Function,
+    chain_w: cuda.Function,
+    norm: cuda.Function,
+
+    pub fn load(m: cuda.Module, comptime sfx: [:0]const u8) !LaneFns {
+        return .{
+            .keep = try m.function("fn_gdn_lanes_keep" ++ sfx),
+            .front = try m.function("fn_gdn_lanes_front" ++ sfx),
+            .chain = try m.function("fn_gdn_lanes_chain" ++ sfx),
+            .shift = try m.function("fn_gdn_lanes_shift" ++ sfx),
+            .front_w = try m.function("fn_gdn_lanes_front_w" ++ sfx),
+            .chain_w = try m.function("fn_gdn_lanes_chain_w" ++ sfx),
+            .norm = try m.function("fn_gdn_norm" ++ sfx),
+        };
+    }
+};
+
+pub const LaneBufs = struct { conv: u64, state: u64, state_out: u64, log: u64, ctl: u64, keep_proj: u64, keep_hist: u64, rows: usize };
+
+pub const Pass = struct {
+    h: Heads,
+    proj: u64,
+    cw: u64,
+    a_log: u64,
+    dt: u64,
+    nw: u64,
+    x: Scan,
+    ys: u64,
+    out: u64,
+    xs: u64,
+    lanes: []LaneBufs,
+    total: usize,
+};
+
+pub const Shape = struct { log: bool, keep: bool, spare: bool, rows: usize, np: u32, first: u32 };
+
+pub fn shapes(r: *Rig, n: usize, rows_total: usize) ![]Shape {
+    const v = try r.a.alloc(Shape, n);
+    var left = rows_total;
+    for (v, 0..) |*s, i| {
+        const share = if (i + 1 == n) left else @max(1, @min(left - (n - 1 - i), rows_total / n + r.rng.uintLessThan(usize, 2)));
+        left -= share;
+        const log = r.rng.boolean();
+        s.* = .{ .log = log, .keep = r.rng.uintLessThan(u8, 4) != 0, .spare = log or r.rng.boolean(), .rows = share, .np = r.rng.uintLessThan(u32, 4), .first = r.rng.uintLessThan(u32, @intCast(parts.late_rows)) };
+    }
+    return v;
+}
+
+pub fn makePass(r: *Rig, h: Heads, sh: []const Shape, host: *const Host) !Pass {
+    var total: usize = 0;
+    for (sh) |s| total += s.rows;
+    const ls = try r.a.alloc(LaneBufs, sh.len);
+    const sb = lay.bytes(.state, 4, 1, h);
+    for (sh, ls, 0..) |s, *b, i| {
+        b.* = .{
+            .conv = try r.dev(std.mem.sliceAsBytes(host.conv[i])),
+            .state = try r.dev(std.mem.sliceAsBytes(host.state[i])),
+            .state_out = if (s.spare) try r.out(sb) else 0,
+            .log = if (s.log) try r.dev(std.mem.sliceAsBytes(host.log[i])) else 0,
+            .ctl = if (s.log) try r.dev(std.mem.asBytes(&(s.first | s.np << 16))) else 0,
+            .keep_proj = if (s.keep) try r.out(s.rows * h.projWidth() * 2) else 0,
+            .keep_hist = if (s.keep) try r.out((lay.taps - 1) * h.convDim() * 2) else 0,
+            .rows = s.rows,
+        };
+    }
+    return .{
+        .h = h,
+        .proj = try r.dev(std.mem.sliceAsBytes(host.proj)),
+        .cw = host.cw,
+        .a_log = host.a_log,
+        .dt = host.dt,
+        .nw = host.nw,
+        .x = try scan(r, h, total),
+        .ys = try r.out(lay.bytes(.values, 4, total, h)),
+        .out = try r.out(lay.bytes(.values, 2, total, h)),
+        .xs = try r.out(lay.bytes(.sums, 4, total, h)),
+        .lanes = ls,
+        .total = total,
+    };
+}
+
+pub const Host = struct {
+    proj: []u16,
+    conv: [][]u16,
+    state: [][]f32,
+    log: [][]f32,
+    cw: u64,
+    a_log: u64,
+    dt: u64,
+    nw: u64,
+};
+
+pub fn makeHost(r: *Rig, h: Heads, sh: []const Shape) !Host {
+    var total: usize = 0;
+    for (sh) |s| total += s.rows;
+    const conv = try r.a.alloc([]u16, sh.len);
+    const state = try r.a.alloc([]f32, sh.len);
+    const log = try r.a.alloc([]f32, sh.len);
+    for (conv, state, log) |*c, *s, *g| {
+        c.* = r.bfs((lay.taps - 1) * h.convDim(), 1);
+        s.* = r.f32s(h.nv * lay.dv * lay.dk, -0.5, 0.5);
+        g.* = r.f32s(parts.late_rows * parts.lateRowBytes(h) / 4, 0, 0.5);
+    }
+    return .{
+        .proj = r.bfs(total * h.projWidth(), 1),
+        .conv = conv,
+        .state = state,
+        .log = log,
+        .cw = try r.dev(std.mem.sliceAsBytes(r.bfs(h.convDim() * lay.taps, 0.5))),
+        .a_log = try r.dev(std.mem.sliceAsBytes(r.f32s(h.nv, -1, 1))),
+        .dt = try r.dev(std.mem.sliceAsBytes(r.f32s(h.nv, -1, 1))),
+        .nw = try r.dev(std.mem.sliceAsBytes(r.bfs(lay.dv, 1.5))),
+    };
+}
+
+fn cint(v: usize) c_int {
+    return @intCast(v);
+}
+
+pub fn runOld(r: *Rig, f: *const LaneFns, p: *const Pass) !void {
+    const h = p.h;
+    const pw = h.projWidth();
+    var at: usize = 0;
+    var row0: usize = 0;
+    while (at < p.lanes.len) {
+        const count = @min(parts.gdn_lanes_max, p.lanes.len - at);
+        var t: parts.GdnLanes = .{ .n = @intCast(count) };
+        var widest: usize = 0;
+        var keeps = false;
+        for (p.lanes[at..][0..count], t.l[0..count]) |b, *x| {
+            x.* = .{ .proj = p.proj + row0 * pw * 2, .conv = b.conv, .state = b.state, .state_out = b.state_out, .log = b.log, .ctl = b.ctl, .keep_proj = b.keep_proj, .keep_hist = b.keep_hist, .row0 = @intCast(row0), .rows = @intCast(b.rows) };
+            keeps = keeps or b.keep_proj != 0;
+            widest = @max(widest, b.rows);
+            row0 += b.rows;
+        }
+        const n: u32 = @intCast(count);
+        if (keeps) {
+            var a: cuda.Args = .{};
+            a.add(t);
+            try cuda.launch.launch(f.keep, .{ .grid = .{ .x = 64, .y = n }, .block = .{ .x = 256 } }, r.s, &a);
+        }
+        var fa: cuda.Args = .{};
+        for ([_]u64{ p.cw, p.a_log, p.dt, p.x.qn, p.x.kn, p.x.v, p.x.gb }) |v| fa.add(v);
+        fa.add(cint(parts.late_rows));
+        fa.add(t);
+        try cuda.launch.launch(f.front, .{ .grid = .{ .x = @intCast(widest), .y = h.nk + h.nv, .z = n }, .block = .{ .x = 256 } }, r.s, &fa);
+        var c: cuda.Args = .{};
+        for ([_]u64{ p.x.qn, p.x.kn, p.x.v, p.x.gb, p.ys }) |v| c.add(v);
+        c.add(cint(parts.late_rows));
+        c.add(cint(parts.late_store));
+        c.add(t);
+        try cuda.launch.launch(f.chain, .{ .grid = .{ .x = h.nv, .y = lay.dv / 16, .z = n }, .block = .{ .x = 128 } }, r.s, &c);
+        var w: cuda.Args = .{};
+        w.add(t);
+        try cuda.launch.launch(f.shift, .{ .grid = .{ .x = @intCast((h.convDim() + 255) / 256), .y = n }, .block = .{ .x = 256 } }, r.s, &w);
+        at += count;
+    }
+}
+
+pub fn runWide(r: *Rig, f: *const LaneFns, p: *const Pass) !void {
+    const h = p.h;
+    const pw = h.projWidth();
+    var at: usize = 0;
+    var row0: usize = 0;
+    while (at < p.lanes.len) {
+        const count = @min(parts.gdn_lanes_wide, p.lanes.len - at);
+        const first = row0;
+        var t: parts.GdnLanesW = .{ .n = @intCast(count), .proj = p.proj + first * pw * 2 };
+        var widest: usize = 0;
+        for (p.lanes[at..][0..count], 0..) |b, i| {
+            t.conv[i] = b.conv;
+            t.state[i] = b.state;
+            t.state_out[i] = b.state_out;
+            t.log[i] = b.log;
+            t.ctl[i] = b.ctl;
+            t.keep_proj[i] = b.keep_proj;
+            t.keep_hist[i] = b.keep_hist;
+            t.row0[i] = @intCast(row0 - first);
+            t.rows[i] = @intCast(b.rows);
+            widest = @max(widest, b.rows);
+            row0 += b.rows;
+        }
+        const n: u32 = @intCast(count);
+        var fa: cuda.Args = .{};
+        for ([_]u64{ p.cw, p.a_log, p.dt, p.x.qn + first * h.nk * lay.dk * 4, p.x.kn + first * h.nk * lay.dk * 4, p.x.v + first * h.valueDim() * 4, p.x.gb + first * h.nv * 8 }) |v| fa.add(v);
+        fa.add(cint(parts.late_rows));
+        fa.add(t);
+        try cuda.launch.launch(f.front_w, .{ .grid = .{ .x = @intCast(widest), .y = h.nk + h.nv, .z = n }, .block = .{ .x = 256 } }, r.s, &fa);
+        var c: cuda.Args = .{};
+        for ([_]u64{ p.x.qn + first * h.nk * lay.dk * 4, p.x.kn + first * h.nk * lay.dk * 4, p.x.v + first * h.valueDim() * 4, p.x.gb + first * h.nv * 8, p.ys + first * h.valueDim() * 4 }) |v| c.add(v);
+        c.add(cint(parts.late_rows));
+        c.add(cint(parts.late_store));
+        c.add(t);
+        try cuda.launch.launch(f.chain_w, .{ .grid = .{ .x = h.nv, .y = lay.dv / 16, .z = n }, .block = .{ .x = 128 } }, r.s, &c);
+        at += count;
+    }
+}
+
+pub fn normPass(r: *Rig, f: *const LaneFns, p: *const Pass) !void {
+    try lay.norm(f.norm, r.s, p.h, p.total, p.ys, p.proj, p.nw, p.out, p.xs);
+}
+
+const lane_cases = [_][2]usize{ .{ 1, 1 }, .{ 4, 10 }, .{ 16, 40 }, .{ 17, 45 }, .{ 28, 75 }, .{ 32, 90 }, .{ 33, 70 }, .{ 40, 100 } };
+
+pub fn lanesRun(gpu: check.Gpu) !void {
+    var prng = std.Random.DefaultPrng.init(39706);
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const fns = [2]LaneFns{ try LaneFns.load(batch, ""), try LaneFns.load(batch, "_h8") };
+    var checks: usize = 0;
+    for (heads, &fns) |h, *f| {
+        for (lane_cases) |lc| {
+            var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+            defer arena.deinit();
+            var r = try Rig.init(gpu, arena.allocator(), prng.random());
+            defer r.deinit();
+            const sh = try shapes(&r, lc[0], lc[1]);
+            const host = try makeHost(&r, h, sh);
+            const a = try makePass(&r, h, sh, &host);
+            const b = try makePass(&r, h, sh, &host);
+            try runOld(&r, f, &a);
+            try normPass(&r, f, &a);
+            try runWide(&r, f, &b);
+            try normPass(&r, f, &b);
+            const t = a.total;
+            try same(&r, "wide lanes: q", h, t, a.x.qn, b.x.qn, lay.bytes(.keys, 4, t, h));
+            try same(&r, "wide lanes: k", h, t, a.x.kn, b.x.kn, lay.bytes(.keys, 4, t, h));
+            try same(&r, "wide lanes: v", h, t, a.x.v, b.x.v, lay.bytes(.values, 4, t, h));
+            try same(&r, "wide lanes: gates", h, t, a.x.gb, b.x.gb, lay.bytes(.gb, 4, t, h));
+            try same(&r, "wide lanes: readouts", h, t, a.ys, b.ys, lay.bytes(.values, 4, t, h));
+            try same(&r, "wide lanes: gated-norm rows", h, t, a.out, b.out, lay.bytes(.values, 2, t, h));
+            try same(&r, "wide lanes: gated-norm sums", h, t, a.xs, b.xs, lay.bytes(.sums, 4, t, h));
+            const sb = lay.bytes(.state, 4, 1, h);
+            for (a.lanes, b.lanes, sh) |x, y, s| {
+                try same(&r, "wide lanes: conv window", h, t, x.conv, y.conv, (lay.taps - 1) * h.convDim() * 2);
+                try same(&r, "wide lanes: state", h, t, x.state, y.state, sb);
+                if (s.spare) try same(&r, "wide lanes: end state", h, t, x.state_out, y.state_out, sb);
+                if (s.log) try same(&r, "wide lanes: log", h, t, x.log, y.log, parts.late_rows * parts.lateRowBytes(h));
+                if (s.keep) {
+                    try same(&r, "wide lanes: kept rows", h, t, x.keep_proj, y.keep_proj, s.rows * h.projWidth() * 2);
+                    try same(&r, "wide lanes: kept conv window", h, t, x.keep_hist, y.keep_hist, (lay.taps - 1) * h.convDim() * 2);
+                }
+            }
+            std.debug.print("RESULT flashnext-gdn-lanes-wide {s} heads, {d} lanes, {d} rows: q, k, v, gates, readouts, norm rows and sums, conv windows, states, logs and keeps byte-equal\n", .{ name(h), lc[0], t });
+            checks += 1;
+        }
+    }
+    check.pass("flashnext-gdn-lanes-wide: {d} shared passes (full and _h8 heads, 1 to 40 lanes, logs, spares and keeps mixed) give the 16-lane groups' bytes", .{checks});
+}
+
+pub fn lanesBench(gpu: check.Gpu, rest: []const []const u8) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(39707);
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const f = try LaneFns.load(batch, "_h8");
+    var cases_buf: [8][2]usize = undefined;
+    var cases: []const [2]usize = &.{ .{ 28, 75 }, .{ 4, 10 }, .{ 16, 43 } };
+    if (rest.len > 0) {
+        if (rest.len > cases_buf.len) return error.GdnBenchArguments;
+        for (rest, 0..) |s, i| {
+            var it = std.mem.splitScalar(u8, s, ':');
+            cases_buf[i] = .{ try std.fmt.parseInt(usize, it.next() orelse return error.GdnBenchArguments, 10), try std.fmt.parseInt(usize, it.next() orelse return error.GdnBenchArguments, 10) };
+        }
+        cases = cases_buf[0..rest.len];
+    }
+    const h: Heads = .half;
+    for (cases) |lc| {
+        var r = try Rig.init(gpu, arena.allocator(), prng.random());
+        defer r.deinit();
+        const sh = try shapes(&r, lc[0], lc[1]);
+        for (sh) |*s| {
+            s.log = true;
+            s.spare = true;
+            s.keep = true;
+            s.np = 2;
+        }
+        const host = try makeHost(&r, h, sh);
+        const p = try makePass(&r, h, sh, &host);
+        const Old = struct {
+            f: *const LaneFns,
+            p: *const Pass,
+            fn go(t: @This(), rr: *Rig) !void {
+                try runOld(rr, t.f, t.p);
+            }
+        };
+        const Wide = struct {
+            f: *const LaneFns,
+            p: *const Pass,
+            fn go(t: @This(), rr: *Rig) !void {
+                try runWide(rr, t.f, t.p);
+            }
+        };
+        const old = try time(&r, Old{ .f = &f, .p = &p });
+        const wide = try time(&r, Wide{ .f = &f, .p = &p });
+        const ms = @as(f64, layers) / 1000;
+        std.debug.print("RESULT flashnext-gdn-lanes-wide-bench _h8 heads, {d} lanes, {d} rows (logs, spares, keeps): 16-lane groups {d:.1} us, wide {d:.1} us a layer; per {d} layers {d:.2} vs {d:.2} ms a round, saves {d:.2} ms\n", .{ lc[0], p.total, old, wide, layers, old * ms, wide * ms, (old - wide) * ms });
+    }
+}
diff --git a/zig/tests/cuda/flashnext_gdn4_tests.zig b/zig/tests/cuda/flashnext_gdn4_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..bbb2e719cc338c12c97e2f5d17950d6b03c7b2b5
--- /dev/null
+++ b/zig/tests/cuda/flashnext_gdn4_tests.zig
@@ -0,0 +1,576 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig_ = @import("flashnext_rig.zig");
+const lay = @import("flashnext_gdn_heads.zig");
+const g3 = @import("flashnext_gdn3_tests.zig");
+
+const Rig = rig_.Rig;
+const Heads = lay.Heads;
+const chunk = flash.gdn_chunk;
+const parts = flash.batch_state;
+const Err = g3.Err;
+
+fn stateN(h: Heads) usize {
+    return h.nv * lay.dv * lay.dk;
+}
+
+fn toHalf(r: *Rig, s: []const f32) ![]f16 {
+    const o = try r.a.alloc(f16, 2 * s.len);
+    for (o[0..s.len], s) |*d, x| d.* = @floatCast(x);
+    @memset(o[s.len..], 0);
+    return o;
+}
+
+fn halfState(r: *Rig, s: []const f32) !u64 {
+    return r.dev(std.mem.sliceAsBytes(try toHalf(r, s)));
+}
+
+fn backHalf(r: *Rig, ptr: u64, n: usize) ![]f32 {
+    const hs = try r.back(f16, ptr, n);
+    const o = try r.a.alloc(f32, n);
+    for (o, hs) |*d, x| d.* = x;
+    return o;
+}
+
+fn sameBytes(r: *Rig, a: u64, b: u64, n: usize) !usize {
+    var diff: usize = 0;
+    for (try r.back(u8, a, n), try r.back(u8, b, n)) |p, q| diff += @intFromBool(p != q);
+    return diff;
+}
+
+fn stateErr(r: *Rig, h: Heads, half: u64, exact: u64) !Err {
+    var e: Err = .{};
+    for (try backHalf(r, half, stateN(h)), try r.back(f32, exact, stateN(h))) |g, w| e.add(g, w);
+    return e;
+}
+
+const Sets = struct {
+    prod: [2]chunk.Fns,
+    half: [2][7]chunk.Fns,
+
+    const names = [_][]const u8{ "fp16 state", "fp16 state + YS_BF16", "fp16 state + COMPACT", "fp16 state + NORM_FUSED", "fp16 state + RELAXED", "fp16 state + COMPACT + RELAXED", "fp16 state + NORM_FUSED + RELAXED" };
+    const opts = [_]chunk.Opts{
+        .{ .half_state = true },
+        .{ .narrow = true, .half_state = true },
+        .{ .narrow = true, .compact = true, .half_state = true },
+        .{ .narrow = true, .compact = true, .normed = true, .half_state = true },
+        .{ .relaxed = true, .half_state = true },
+        .{ .narrow = true, .compact = true, .relaxed = true, .half_state = true },
+        .{ .narrow = true, .compact = true, .relaxed = true, .normed = true, .half_state = true },
+    };
+    const ys_elem = [_]usize{ 4, 2, 2, 2, 4, 2, 2 };
+
+    fn load(batch: cuda.Module) !Sets {
+        var s: Sets = undefined;
+        s.prod = .{ try chunk.Fns.loadWith(batch, "", .{}), try chunk.Fns.loadWith(batch, "_h8", .{}) };
+        for (opts, 0..) |o, j| {
+            s.half[0][j] = try chunk.Fns.loadWith(batch, "", o);
+            s.half[1][j] = try chunk.Fns.loadWith(batch, "_h8", o);
+        }
+        return s;
+    }
+};
+
+const RowFns = struct {
+    rows: cuda.Function,
+    rows_s: cuda.Function,
+    rows_to_s: cuda.Function,
+    tpr_s: cuda.Function,
+    fused_s: cuda.Function,
+
+    fn load(m: cuda.Module, comptime sfx: [:0]const u8) !RowFns {
+        const f: RowFns = .{
+            .rows = try m.function("fn_gdn_rows" ++ sfx),
+            .rows_s = try m.function("fn_gdn_rows_s" ++ sfx),
+            .rows_to_s = try m.function("fn_gdn_rows_to_s" ++ sfx),
+            .tpr_s = try m.function("fn_gdn_chain_tpr_s" ++ sfx),
+            .fused_s = try m.function("fn_gdn_fused_s" ++ sfx),
+        };
+        try f.tpr_s.allowDynamicShared(parts.chain_tpr_smem);
+        try f.fused_s.allowDynamicShared(parts.gdn_fused_smem);
+        return f;
+    }
+};
+
+fn halfLanes(m: cuda.Module, comptime sfx: [:0]const u8) !g3.LaneFns {
+    var f = try g3.LaneFns.load(m, sfx);
+    f.chain = try m.function("fn_gdn_lanes_chain_s" ++ sfx);
+    f.chain_w = try m.function("fn_gdn_lanes_chain_w_s" ++ sfx);
+    return f;
+}
+
+const Bound = struct { state_rel: f64, ys_rel: f64, out_rel: f64 };
+const prompt_bound: Bound = .{ .state_rel = 1e-3, .ys_rel = 2e-3, .out_rel = 3e-3 };
+const drift_bound: Bound = .{ .state_rel = 1e-2, .ys_rel = 1e-2, .out_rel = 1.5e-2 };
+const round_bound: f64 = 1e-3;
+
+fn promptDrift(gpu: check.Gpu, sets: *const Sets, f: *const lay.Fns, prng: *std.Random.DefaultPrng, passes: usize, m: usize) !usize {
+    var checks: usize = 0;
+    for ([_]usize{ 1, 0 }) |i| {
+        const h = g3.heads[i];
+        for ([_]g3.Decay{ .fast, .slow }) |decay| {
+            var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+            defer arena.deinit();
+            var r = try Rig.init(gpu, arena.allocator(), prng.random());
+            defer r.deinit();
+            const s0 = r.f32s(stateN(h), -0.5, 0.5);
+            const in = try g3.inputs(&r, h, m, decay);
+            const xe = try g3.scan(&r, h, m);
+            var oe = try g3.outs(&r, h, m, 4);
+            oe.st = try r.dev(std.mem.sliceAsBytes(s0));
+            var xs: [7]g3.Scan = undefined;
+            var os: [7]g3.Out = undefined;
+            for (&xs, &os, Sets.ys_elem) |*x, *o, e| {
+                x.* = try g3.scan(&r, h, m);
+                o.* = try g3.outs(&r, h, m, e);
+                o.st = try halfState(&r, s0);
+            }
+            const proj: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = in[0], .len = m * h.projWidth() * 2 };
+            const host_proj = try r.a.alloc(u16, m * h.projWidth());
+            var ey: Err = .{};
+            var eo: Err = .{};
+            var out_diff: usize = 0;
+            var exact_diff: usize = 0;
+            var relaxed_diff: usize = 0;
+            var worst_state: f64 = 0;
+            var bad: usize = 0;
+            const ob = lay.bytes(.values, 2, m, h);
+            const sb = stateN(h) * 2;
+            for (0..passes) |_| {
+                var pa: std.heap.ArenaAllocator = .init(gpu.gpa);
+                defer pa.deinit();
+                const saved = r.a;
+                r.a = pa.allocator();
+                defer r.a = saved;
+                for (host_proj) |*p| p.* = rig_.bf16((r.rng.float(f32) * 2 - 1));
+                try r.s.synchronize();
+                try proj.upload(0, std.mem.sliceAsBytes(host_proj));
+                try g3.block(&r, f, &sets.prod[i], h, m, in, oe.st, xe, oe);
+                for (&sets.half[i], xs, os) |*c, x, o| try g3.block(&r, f, c, h, m, in, o.st, x, o);
+                for ([_]usize{ 1, 2, 3 }) |j| {
+                    exact_diff += try sameBytes(&r, os[0].out, os[j].out, ob);
+                    exact_diff += try sameBytes(&r, os[0].st, os[j].st, sb);
+                }
+                for ([_]usize{ 5, 6 }) |j| {
+                    relaxed_diff += try sameBytes(&r, os[4].out, os[j].out, ob);
+                    relaxed_diff += try sameBytes(&r, os[4].st, os[j].st, sb);
+                }
+                for (try r.back(f32, os[0].ys, m * h.valueDim()), try r.back(f32, oe.ys, m * h.valueDim())) |g, w| ey.add(g, w);
+                for (try r.back(u16, os[0].out, m * h.valueDim()), try r.back(u16, oe.out, m * h.valueDim())) |g, w| {
+                    eo.add(rig_.bf(g), rig_.bf(w));
+                    out_diff += @intFromBool(g != w);
+                }
+                const ps = try stateErr(&r, h, os[0].st, oe.st);
+                bad += ps.bad;
+                worst_state = @max(worst_state, ps.rel());
+            }
+            const steps = passes * m;
+            std.debug.print("RESULT flashnext-gdn-state-f16 prompt {s} heads, {s} decay, {d} passes of {d} rows ({d} steps): state rel-L2 worst pass {e:.3}; readouts rel-L2 {e:.3}, max|err|/rms {e:.3}; gated-norm rows rel-L2 {e:.3}, {d:.4} of bf16 values differ; fp16 exact twins differ in {d} bytes, relaxed twins in {d}\n", .{
+                g3.name(h), @tagName(decay), passes, m, steps, worst_state, ey.rel(), ey.max / ey.rms(), eo.rel(), @as(f64, @floatFromInt(out_diff)) / @as(f64, @floatFromInt(steps * h.valueDim())), exact_diff, relaxed_diff,
+            });
+            try check.expect(bad == 0 and ey.bad == 0 and eo.bad == 0, "flashnext-gdn-state-f16 prompt {s}: non-finite values", .{g3.name(h)});
+            try check.expect(exact_diff == 0 and relaxed_diff == 0, "flashnext-gdn-state-f16 prompt {s}: the fp16-state chunked twins disagree ({d} exact, {d} relaxed bytes)", .{ g3.name(h), exact_diff, relaxed_diff });
+            try check.expect(worst_state <= prompt_bound.state_rel and ey.rel() <= prompt_bound.ys_rel and eo.rel() <= prompt_bound.out_rel, "flashnext-gdn-state-f16 prompt {s} {s}: state {e} (bound {e}), readouts {e} ({e}), gated-norm rows {e} ({e})", .{ g3.name(h), @tagName(decay), worst_state, prompt_bound.state_rel, ey.rel(), prompt_bound.ys_rel, eo.rel(), prompt_bound.out_rel });
+            checks += 1;
+        }
+    }
+    return checks;
+}
+
+fn rowsAt(fun: cuda.Function, s: cuda.Stream, h: Heads, x: g3.Scan, t: usize, n: usize, st: u64, ys: u64) !void {
+    try lay.chain(fun, s, .rows, h, n, x.qn + t * h.nk * lay.dk * 4, x.kn + t * h.nk * lay.dk * 4, x.v + t * h.valueDim() * 4, x.gb + t * h.nv * 8, st, 0, ys + t * h.valueDim() * 4);
+}
+
+fn decodeDrift(gpu: check.Gpu, rf: *const [2]RowFns, f: *const lay.Fns, prng: *std.Random.DefaultPrng, cycles: usize, round_rows: usize) !usize {
+    const m: usize = 3072;
+    const marks = [_]usize{ 1000, 10000, 100000, 250000 };
+    var checks: usize = 0;
+    for ([_]usize{ 1, 0 }) |i| {
+        const h = g3.heads[i];
+        const fr = &rf[i];
+        for ([_]g3.Decay{ .fast, .slow }) |decay| {
+            var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+            defer arena.deinit();
+            var r = try Rig.init(gpu, arena.allocator(), prng.random());
+            defer r.deinit();
+            const s0 = r.f32s(stateN(h), -0.5, 0.5);
+            const in = try g3.inputs(&r, h, m, decay);
+            const x = try g3.scan(&r, h, m);
+            const st_e = try r.dev(std.mem.sliceAsBytes(s0));
+            const st_h = try halfState(&r, s0);
+            const ys_e = try r.out(lay.bytes(.values, 4, m, h));
+            const ys_h = try r.out(lay.bytes(.values, 4, m, h));
+            const out_e = try r.out(lay.bytes(.values, 2, m, h));
+            const out_h = try r.out(lay.bytes(.values, 2, m, h));
+            const xs_e = try r.out(lay.bytes(.sums, 4, m, h));
+            const xs_h = try r.out(lay.bytes(.sums, 4, m, h));
+            const proj: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = in[0], .len = m * h.projWidth() * 2 };
+            const conv: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = in[1], .len = (lay.taps - 1) * h.convDim() * 2 };
+            const host_proj = try r.a.alloc(u16, m * h.projWidth());
+            var ey: Err = .{};
+            var eo: Err = .{};
+            var out_diff: usize = 0;
+            var n_out: usize = 0;
+            var mk: usize = 0;
+            var worst: Bound = .{ .state_rel = 0, .ys_rel = 0, .out_rel = 0 };
+            var bad: usize = 0;
+            for (0..cycles) |cy| {
+                var pa: std.heap.ArenaAllocator = .init(gpu.gpa);
+                defer pa.deinit();
+                const saved = r.a;
+                r.a = pa.allocator();
+                defer r.a = saved;
+                for (host_proj) |*p| p.* = rig_.bf16((r.rng.float(f32) * 2 - 1));
+                try r.s.synchronize();
+                try proj.upload(0, std.mem.sliceAsBytes(host_proj));
+                try conv.upload(0, std.mem.sliceAsBytes(r.bfs((lay.taps - 1) * h.convDim(), 1)));
+                try lay.front(f.of(.front, h), r.s, h, m, in[0], in[1], in[2], in[3], in[4], x.qn, x.kn, x.v, x.gb);
+                if (cy == 0) {
+                    const a = try halfState(&r, s0);
+                    const b = try halfState(&r, s0);
+                    const ys_a = try r.out(lay.bytes(.values, 4, m, h));
+                    const ys_b = try r.out(lay.bytes(.values, 4, m, h));
+                    try lay.chain(fr.rows_to_s, r.s, .rows_to, h, m, x.qn, x.kn, x.v, x.gb, st_h, a, ys_a);
+                    try lay.chain(fr.tpr_s, r.s, .tpr, h, m, x.qn, x.kn, x.v, x.gb, st_h, b, ys_b);
+                    const tpr_diff = try sameBytes(&r, a, b, stateN(h) * 2) + try sameBytes(&r, ys_a, ys_b, lay.bytes(.values, 4, m, h));
+                    const c = try halfState(&r, s0);
+                    const out_a = try r.out(lay.bytes(.values, 2, m, h));
+                    const out_b = try r.out(lay.bytes(.values, 2, m, h));
+                    const xs_a = try r.out(lay.bytes(.sums, 4, m, h));
+                    const xs_b = try r.out(lay.bytes(.sums, 4, m, h));
+                    try lay.norm(f.of(.norm, h), r.s, h, m, ys_b, in[0], in[5], out_a, xs_a);
+                    try lay.fused(fr.fused_s, r.s, h, m, in[0], in[1], in[2], in[3], in[4], st_h, c, in[5], out_b, xs_b, 0);
+                    const fused_diff = try sameBytes(&r, b, c, stateN(h) * 2) + try sameBytes(&r, out_a, out_b, lay.bytes(.values, 2, m, h)) + try sameBytes(&r, xs_a, xs_b, lay.bytes(.sums, 4, m, h));
+                    try check.expect(tpr_diff == 0 and fused_diff == 0, "flashnext-gdn-state-f16 {s}: fp16 tpr vs rows_to differ in {d} bytes, fused vs front+tpr+norm in {d}", .{ g3.name(h), tpr_diff, fused_diff });
+                    checks += 1;
+                }
+                var t: usize = 0;
+                while (t < m) : (t += round_rows) {
+                    const n = @min(round_rows, m - t);
+                    try rowsAt(fr.rows, r.s, h, x, t, n, st_e, ys_e);
+                    try rowsAt(fr.rows_s, r.s, h, x, t, n, st_h, ys_h);
+                }
+                try lay.norm(f.of(.norm, h), r.s, h, m, ys_e, in[0], in[5], out_e, xs_e);
+                try lay.norm(f.of(.norm, h), r.s, h, m, ys_h, in[0], in[5], out_h, xs_h);
+                for (try r.back(f32, ys_h, m * h.valueDim()), try r.back(f32, ys_e, m * h.valueDim())) |g, w| ey.add(g, w);
+                for (try r.back(u16, out_h, m * h.valueDim()), try r.back(u16, out_e, m * h.valueDim())) |g, w| {
+                    eo.add(rig_.bf(g), rig_.bf(w));
+                    out_diff += @intFromBool(g != w);
+                }
+                n_out += m * h.valueDim();
+                const pos = (cy + 1) * m;
+                if (mk < marks.len and (pos >= marks[mk] or cy + 1 == cycles)) {
+                    const es = try stateErr(&r, h, st_h, st_e);
+                    bad += es.bad + ey.bad + eo.bad;
+                    std.debug.print("RESULT flashnext-gdn-state-f16 decode {s} heads, {s} decay, rounds of {d} rows, at {d} positions: state rel-L2 {e:.3}; since the last mark readouts rel-L2 {e:.3}, gated-norm rows rel-L2 {e:.3}, {d:.4} of bf16 values differ\n", .{ g3.name(h), @tagName(decay), round_rows, pos, es.rel(), ey.rel(), eo.rel(), @as(f64, @floatFromInt(out_diff)) / @as(f64, @floatFromInt(n_out)) });
+                    worst = .{ .state_rel = @max(worst.state_rel, es.rel()), .ys_rel = @max(worst.ys_rel, ey.rel()), .out_rel = @max(worst.out_rel, eo.rel()) };
+                    ey = .{};
+                    eo = .{};
+                    out_diff = 0;
+                    n_out = 0;
+                    while (mk < marks.len and pos >= marks[mk]) mk += 1;
+                }
+            }
+            try check.expect(bad == 0, "flashnext-gdn-state-f16 decode {s}: non-finite values", .{g3.name(h)});
+            try check.expect(worst.state_rel <= drift_bound.state_rel and worst.ys_rel <= drift_bound.ys_rel and worst.out_rel <= drift_bound.out_rel, "flashnext-gdn-state-f16 decode {s} {s}: state {e} (bound {e}), readouts {e} ({e}), gated-norm rows {e} ({e})", .{ g3.name(h), @tagName(decay), worst.state_rel, drift_bound.state_rel, worst.ys_rel, drift_bound.ys_rel, worst.out_rel, drift_bound.out_rel });
+            checks += 1;
+        }
+    }
+    return checks;
+}
+
+fn halfHost(r: *Rig, host: *const g3.Host) !g3.Host {
+    var hh = host.*;
+    hh.state = try r.a.alloc([]f32, host.state.len);
+    for (hh.state, host.state) |*d, s| {
+        const hs = try toHalf(r, s);
+        d.* = try r.a.alloc(f32, s.len);
+        @memcpy(std.mem.sliceAsBytes(d.*), std.mem.sliceAsBytes(hs));
+    }
+    return hh;
+}
+
+const lane_cases = [_][2]usize{ .{ 1, 1 }, .{ 4, 10 }, .{ 17, 45 }, .{ 28, 75 }, .{ 33, 70 } };
+
+fn lanesCheck(gpu: check.Gpu, batch: cuda.Module, prng: *std.Random.DefaultPrng) !usize {
+    const exact = [2]g3.LaneFns{ try g3.LaneFns.load(batch, ""), try g3.LaneFns.load(batch, "_h8") };
+    const half = [2]g3.LaneFns{ try halfLanes(batch, ""), try halfLanes(batch, "_h8") };
+    var checks: usize = 0;
+    for (g3.heads, &exact, &half) |h, *fe, *fh| {
+        for (lane_cases) |lc| {
+            var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+            defer arena.deinit();
+            var r = try Rig.init(gpu, arena.allocator(), prng.random());
+            defer r.deinit();
+            const sh = try g3.shapes(&r, lc[0], lc[1]);
+            const host = try g3.makeHost(&r, h, sh);
+            const hh = try halfHost(&r, &host);
+            const e = try g3.makePass(&r, h, sh, &host);
+            const a = try g3.makePass(&r, h, sh, &hh);
+            const b = try g3.makePass(&r, h, sh, &hh);
+            try g3.runOld(&r, fe, &e);
+            try g3.normPass(&r, fe, &e);
+            try g3.runOld(&r, fh, &a);
+            try g3.normPass(&r, fh, &a);
+            try g3.runWide(&r, fh, &b);
+            try g3.normPass(&r, fh, &b);
+            const t = a.total;
+            var diff = try sameBytes(&r, a.ys, b.ys, lay.bytes(.values, 4, t, h)) + try sameBytes(&r, a.out, b.out, lay.bytes(.values, 2, t, h));
+            var worst: f64 = 0;
+            var ey: Err = .{};
+            for (try r.back(f32, a.ys, t * h.valueDim()), try r.back(f32, e.ys, t * h.valueDim())) |g, w| ey.add(g, w);
+            for (a.lanes, b.lanes, e.lanes, sh) |x, y, z, s| {
+                diff += try sameBytes(&r, x.state, y.state, stateN(h) * 2);
+                worst = @max(worst, (try stateErr(&r, h, x.state, z.state)).rel());
+                if (s.spare) {
+                    diff += try sameBytes(&r, x.state_out, y.state_out, stateN(h) * 2);
+                    worst = @max(worst, (try stateErr(&r, h, x.state_out, z.state_out)).rel());
+                }
+            }
+            std.debug.print("RESULT flashnext-gdn-state-f16 lanes {s} heads, {d} lanes, {d} rows: fp16 16-lane groups vs wide differ in {d} bytes; against the fp32 state, state rel-L2 worst {e:.3}, readouts rel-L2 {e:.3}\n", .{ g3.name(h), lc[0], t, diff, worst, ey.rel() });
+            try check.expect(diff == 0, "flashnext-gdn-state-f16 lanes {s}, {d} lanes: fp16 groups and wide table differ in {d} bytes", .{ g3.name(h), lc[0], diff });
+            try check.expect(ey.bad == 0 and worst <= round_bound and ey.rel() <= round_bound, "flashnext-gdn-state-f16 lanes {s}, {d} lanes: one round's state rel-L2 {e}, readouts {e} (bound {e})", .{ g3.name(h), lc[0], worst, ey.rel(), round_bound });
+            checks += 1;
+        }
+    }
+    return checks;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const []const u8) !void {
+    var prng = std.Random.DefaultPrng.init(39708);
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const passes: usize = if (rest.len > 0) try std.fmt.parseInt(usize, rest[0], 10) else 40;
+    const cycles: usize = if (rest.len > 1) try std.fmt.parseInt(usize, rest[1], 10) else 82;
+    const round_rows: usize = if (rest.len > 2) try std.fmt.parseInt(usize, rest[2], 10) else 3;
+    const f = try (try lay.Fns.load(batch)).withFull(batch);
+    const sets = try Sets.load(batch);
+    const rf = [2]RowFns{ try RowFns.load(batch, ""), try RowFns.load(batch, "_h8") };
+    var checks = try lanesCheck(gpu, batch, &prng);
+    checks += try promptDrift(gpu, &sets, &f, &prng, passes, 3072);
+    checks += try decodeDrift(gpu, &rf, &f, &prng, cycles, round_rows);
+    check.pass("flashnext-gdn-state-f16: {d} checks: fp16-state twins agree with each other byte for byte; prompt within state {e}, readouts {e}, rows {e}; decode over {d} positions within state {e}, readouts {e}, rows {e} of the fp32 state", .{ checks, prompt_bound.state_rel, prompt_bound.ys_rel, prompt_bound.out_rel, cycles * 3072, drift_bound.state_rel, drift_bound.ys_rel, drift_bound.out_rel });
+}
+
+pub fn bench(gpu: check.Gpu, rest: []const []const u8) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(39709);
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const f = try (try lay.Fns.load(batch)).withFull(batch);
+    const sets = try Sets.load(batch);
+    var normed: [2]chunk.Fns = undefined;
+    normed[1] = try chunk.Fns.loadWith(batch, "_h8", .{ .narrow = true, .compact = true, .normed = true });
+    var rows_buf: [8]usize = undefined;
+    var cases_buf: [8][2]usize = undefined;
+    var nrows: usize = 0;
+    var ncases: usize = 0;
+    for (rest) |s| {
+        if (std.mem.indexOfScalar(u8, s, ':')) |c| {
+            if (ncases == cases_buf.len) return error.GdnBenchArguments;
+            cases_buf[ncases] = .{ try std.fmt.parseInt(usize, s[0..c], 10), try std.fmt.parseInt(usize, s[c + 1 ..], 10) };
+            ncases += 1;
+        } else {
+            if (nrows == rows_buf.len) return error.GdnBenchArguments;
+            rows_buf[nrows] = try std.fmt.parseInt(usize, s, 10);
+            nrows += 1;
+        }
+    }
