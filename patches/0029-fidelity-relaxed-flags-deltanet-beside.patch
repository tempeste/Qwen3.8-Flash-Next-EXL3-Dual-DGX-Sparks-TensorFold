diff --git a/zig/src/families/flashnext/cuda_rank_beside.zig b/zig/src/families/flashnext/cuda_rank_beside.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8af1eff23ac22bfd8dc7c58870d877b7cc045a65
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rank_beside.zig
@@ -0,0 +1,123 @@
+const std = @import("std");
+const prompt = @import("cuda_prompt.zig");
+const wire = @import("cuda_rank_wire.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const knobs = @import("cuda_knobs.zig");
+const beside = @import("cuda_beside.zig");
+const Session = @import("cuda_rank_engine.zig").Session;
+
+pub const max_piece = prompt.batch.max_chunk;
+pub const last_bit: u32 = 1 << 31;
+
+pub fn pieceRows(flags: u32) u32 {
+    return flags & ~last_bit;
+}
+
+pub fn pieceLast(flags: u32) bool {
+    return flags & last_bit != 0;
+}
+
+pub fn startShapeOk(h: wire.Header) bool {
+    const rows = pieceRows(h.flags);
+    return h.object != 0 and h.arg == 0 and rows != 0 and rows <= max_piece and h.bytes == 4 * rows;
+}
+
+pub fn joinShapeOk(h: wire.Header) bool {
+    return h.object != 0 and h.arg == 0 and h.flags == 0 and h.bytes == 0;
+}
+
+fn engineBeside(s: *Session) !*beside.Beside {
+    if (!(knobs.mixedBeside() catch false)) return error.UnsupportedRankOperation;
+    return s.engine.beside orelse error.UnsupportedRankOperation;
+}
+
+pub fn decodeIds(gpa: std.mem.Allocator, payload: []const u8) ![]u32 {
+    if (payload.len == 0 or payload.len % 4 != 0 or payload.len / 4 > max_piece) return error.BadRankFrame;
+    const ids = try gpa.alloc(u32, payload.len / 4);
+    errdefer gpa.free(ids);
+    for (ids, 0..) |*v, i| {
+        v.* = std.mem.readInt(u32, payload[i * 4 ..][0..4], .little);
+        if (v.* >= wt.vocab) return error.InvalidToken;
+    }
+    return ids;
+}
+
+pub fn start(s: *Session, comptime Tri: type, tri: Tri, piece: beside.Piece) !void {
+    const x = try engineBeside(s);
+    if (x.busy()) return error.BesideBusy;
+    const n = piece.ids.len;
+    if (piece.seq.rank_id == 0 or n == 0 or n > max_piece or piece.seq.fed + n > piece.seq.cap) return error.UnsupportedRankOperation;
+    for (piece.ids) |id| if (id >= wt.vocab) return error.InvalidToken;
+    const flags = @as(u32, @intCast(n)) | (if (piece.last) last_bit else 0);
+    const h = try s.command(.{ .kind = .beside, .object = piece.seq.rank_id, .flags = flags, .bytes = @intCast(4 * n) }, std.mem.sliceAsBytes(piece.ids));
+    errdefer s.poison();
+    try x.open(s.link, s.rank);
+    try x.start(s.engine, Tri, tri, piece);
+    try s.ack(h);
+}
+
+pub fn join(s: *Session) !void {
+    const x = try engineBeside(s);
+    const id = x.rankId();
+    if (id == 0) return error.UnsupportedRankOperation;
+    const h = try s.command(.{ .kind = .beside_join, .object = id }, &.{});
+    errdefer s.poison();
+    try x.join();
+    try s.ack(h);
+}
+
+pub fn receive(s: *Session, comptime Tri: type, tri: Tri, h: wire.Header, payload: []const u8) !void {
+    const x = try engineBeside(s);
+    if (x.busy()) return error.BesideBusy;
+    const last = pieceLast(h.flags);
+    if (last and (knobs.mixedLast() catch .off) == .off) return error.UnsupportedRankOperation;
+    const q = s.seqs.get(h.object) orelse return error.UnknownRankSequence;
+    const ids = try decodeIds(s.gpa, payload);
+    defer s.gpa.free(ids);
+    if (ids.len != pieceRows(h.flags)) return error.BadRankFrame;
+    if (q.fed + ids.len > q.cap) return error.PromptTooLong;
+    try x.open(s.link, s.rank);
+    try x.start(s.engine, Tri, tri, .{ .seq = q, .ids = ids, .prompt = try knobs.tpPromptFrame(), .last = last });
+}
+
+pub fn receiveJoin(s: *Session, h: wire.Header) !void {
+    const x = try engineBeside(s);
+    if (x.rankId() != h.object) return error.BadRankFrame;
+    try x.join();
+}
+
+pub fn holds(s: *Session, h: wire.Header) bool {
+    if (h.object == 0 or h.kind == .beside_join or !(knobs.mixedBeside() catch false)) return false;
+    const x = s.engine.beside orelse return false;
+    return x.rankId() == h.object;
+}
+
+test "a beside start frame names its sequence and rows (bit 31: the prompt's last piece) and carries exactly their ids" {
+    try std.testing.expect(startShapeOk(.{ .kind = .beside, .object = 3, .flags = 2944, .bytes = 4 * 2944 }));
+    try std.testing.expect(startShapeOk(.{ .kind = .beside, .object = 3, .flags = 1536 | last_bit, .bytes = 4 * 1536 }));
+    try std.testing.expect(!startShapeOk(.{ .kind = .beside, .object = 0, .flags = 16, .bytes = 64 }));
+    try std.testing.expect(!startShapeOk(.{ .kind = .beside, .object = 3, .arg = 1, .flags = 16, .bytes = 64 }));
+    try std.testing.expect(!startShapeOk(.{ .kind = .beside, .object = 3, .flags = 0, .bytes = 0 }));
+    try std.testing.expect(!startShapeOk(.{ .kind = .beside, .object = 3, .flags = last_bit, .bytes = 0 }));
+    try std.testing.expect(!startShapeOk(.{ .kind = .beside, .object = 3, .flags = 16, .bytes = 60 }));
+    try std.testing.expect(!startShapeOk(.{ .kind = .beside, .object = 3, .flags = max_piece + 1, .bytes = 4 * (max_piece + 1) }));
+    try std.testing.expectEqual(@as(u32, 1536), pieceRows(1536 | last_bit));
+    try std.testing.expect(pieceLast(1536 | last_bit) and !pieceLast(1536));
+    try std.testing.expect(joinShapeOk(.{ .kind = .beside_join, .object = 3 }));
+    try std.testing.expect(!joinShapeOk(.{ .kind = .beside_join, .object = 0 }));
+    try std.testing.expect(!joinShapeOk(.{ .kind = .beside_join, .object = 3, .flags = 1 }));
+    try std.testing.expect(!joinShapeOk(.{ .kind = .beside_join, .object = 3, .bytes = 4 }));
+}
+
+test "a beside start frame's ids decode exactly and refuse a ragged payload or a token past the vocabulary" {
+    const a = std.testing.allocator;
+    var raw: [16]u8 = undefined;
+    for (0..4) |i| std.mem.writeInt(u32, raw[i * 4 ..][0..4], @intCast(i * 1000), .little);
+    const ids = try decodeIds(a, &raw);
+    defer a.free(ids);
+    try std.testing.expectEqualSlices(u32, &.{ 0, 1000, 2000, 3000 }, ids);
+    try std.testing.expectError(error.BadRankFrame, decodeIds(a, raw[0..15]));
+    try std.testing.expectError(error.BadRankFrame, decodeIds(a, raw[0..0]));
+    std.mem.writeInt(u32, raw[12..16], wt.vocab, .little);
+    try std.testing.expectError(error.InvalidToken, decodeIds(a, &raw));
+}
