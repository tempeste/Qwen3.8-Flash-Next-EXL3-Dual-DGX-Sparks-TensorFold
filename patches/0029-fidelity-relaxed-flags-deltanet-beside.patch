+test "fidelity compare: equal rows have zero KL and TV, a moved row a known KL" {
+    const gpa = std.testing.allocator;
+    const a = try testRow(gpa, &.{ 2.0, 1.0, 0.0, -1.0 });
+    defer gpa.free(a);
+    const c = compare(a, a);
+    try std.testing.expect(c.finite and c.same_top);
+    try std.testing.expectEqual(@as(f64, 0), c.kl);
+    try std.testing.expectEqual(@as(f64, 0), c.tv);
+    const b = try testRow(gpa, &.{ 1.0, 2.0, 0.0, -1.0 });
+    defer gpa.free(b);
+    const d = compare(a, b);
+    var pa: [4]f64 = .{ 2, 1, 0, -1 };
+    var pb: [4]f64 = .{ 1, 2, 0, -1 };
+    var za: f64 = 0;
+    var zb: f64 = 0;
+    for (pa, pb) |x, y| {
+        za += @exp(x);
+        zb += @exp(y);
+    }
+    var kl: f64 = 0;
+    var tv: f64 = 0;
+    for (&pa, &pb) |*x, *y| {
+        x.* = @exp(x.*) / za;
+        y.* = @exp(y.*) / zb;
+        kl += x.* * @log(x.* / y.*);
+        tv += @abs(x.* - y.*);
+    }
+    try std.testing.expect(!d.same_top and d.finite);
+    try std.testing.expectApproxEqRel(kl, d.kl, 1e-12);
+    try std.testing.expectApproxEqRel(tv / 2, d.tv, 1e-12);
+}
+
+test "fidelity compare: a NaN or +inf arm row is non-finite, -inf scores are zero probability" {
