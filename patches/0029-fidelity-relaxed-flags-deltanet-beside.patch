@@ -0,0 +1,118 @@
+const std = @import("std");
+
+pub const most = 8;
+pub const growth = 3;
+
+pub const RowsLog = struct {
+    every: u64 = 1000,
+    rounds: u64 = 0,
+    streams: u64 = 0,
+    windows: u64 = 0,
+    kept: [most + 1][most + 1]u64 = @splat(@splat(0)),
+    granted: f64 = 0,
+    landed: u64 = 0,
+    cut: [growth]f64 = @splat(0),
+
+    pub fn noteWindow(l: *RowsLog, rows: usize, kept: usize) void {
+        if (rows == 0) return;
+        const w = @min(rows, most);
+        l.kept[w][@min(@max(kept, 1), w)] += 1;
+        l.windows += 1;
+        l.landed += @min(kept, rows) -| 1;
+    }
+
+    pub fn noteChances(l: *RowsLog, granted: f64, cut_descending: []const f64, streams: usize) void {
+        l.granted += granted;
+        for (&l.cut, 1..) |*c, j| {
+            for (cut_descending[0..@min(cut_descending.len, j * streams)]) |p| c.* += p;
+        }
+    }
+
+    pub fn endRound(l: *RowsLog, streams: usize) bool {
+        l.rounds += 1;
+        l.streams += streams;
+        return l.rounds >= l.every;
+    }
+
+    pub fn yieldAt(l: *const RowsLog, k: usize) f64 {
+        if (k < 2 or k > most) return -1;
+        var reached: u64 = 0;
+        var landed: u64 = 0;
+        for (k..most + 1) |w| {
+            for (k - 1..w + 1) |t| reached += l.kept[w][t];
+            for (k..w + 1) |t| landed += l.kept[w][t];
+        }
+        if (reached == 0) return -1;
+        return @as(f64, @floatFromInt(landed)) / @as(f64, @floatFromInt(reached));
+    }
+
+    pub fn windowsOf(l: *const RowsLog, rows: usize) u64 {
+        var n: u64 = 0;
+        for (l.kept[rows]) |c| n += c;
+        return n;
+    }
+
+    pub fn format(l: *const RowsLog, w: *std.Io.Writer) std.Io.Writer.Error!void {
+        const rounds: f64 = @floatFromInt(@max(l.rounds, 1));
+        const streams: f64 = @floatFromInt(@max(l.streams, 1));
+        const windows: f64 = @floatFromInt(@max(l.windows, 1));
+        try w.print("rows log: {d} shared rounds, {d:.1} streams a round; head windows by rows 1..{d}:", .{ l.rounds, streams / rounds, most });
+        for (1..most + 1) |r| try w.print(" {d}", .{l.windowsOf(r)});
+        try w.print("; a row lands given the rows before it, rows 2..{d}:", .{most});
+        for (2..most + 1) |k| try w.print(" {d:.3}", .{l.yieldAt(k)});
+        try w.print("; granted chance {d:.3} a window, landed {d:.3}; cut chance a stream at +1..+{d} rows a stream:", .{ l.granted / windows, @as(f64, @floatFromInt(l.landed)) / windows, growth });
+        for (l.cut) |c| try w.print(" {d:.3}", .{c / streams});
+    }
+
+    pub fn reset(l: *RowsLog) void {
+        l.* = .{ .every = l.every };
+    }
+};
+
+pub fn sortDescending(values: []f64) void {
+    std.mem.sort(f64, values, {}, std.sort.desc(f64));
+}
+
+test "rows log: the k-th row's yield given the rows before it, from verified rows and kept tokens" {
+    var l: RowsLog = .{ .every = 2 };
+    for (0..10) |_| l.noteWindow(3, 3);
+    for (0..10) |_| l.noteWindow(3, 2);
+    for (0..20) |_| l.noteWindow(3, 1);
+    for (0..5) |_| l.noteWindow(2, 2);
+    for (0..5) |_| l.noteWindow(2, 1);
+    try std.testing.expectApproxEqAbs(@as(f64, 25.0 / 50.0), l.yieldAt(2), 1e-12);
+    try std.testing.expectApproxEqAbs(@as(f64, 10.0 / 20.0), l.yieldAt(3), 1e-12);
+    try std.testing.expectEqual(@as(f64, -1), l.yieldAt(4));
+    try std.testing.expectEqual(@as(f64, -1), l.yieldAt(1));
+    try std.testing.expectEqual(@as(u64, 40), l.windowsOf(3));
+    try std.testing.expectEqual(@as(u64, 10 * 2 + 10 * 1 + 5), l.landed);
+    try std.testing.expect(!l.endRound(25));
+    try std.testing.expect(l.endRound(25));
+}
+
+test "rows log: wide windows clamp to the last bucket, kept never past the rows, and the cut chances fill by stream count" {
+    var l: RowsLog = .{};
+    l.noteWindow(12, 11);
+    l.noteWindow(4, 9);
+    l.noteWindow(0, 0);
+    try std.testing.expectEqual(@as(u64, 1), l.kept[most][most]);
+    try std.testing.expectEqual(@as(u64, 1), l.kept[4][4]);
+    try std.testing.expectEqual(@as(u64, 2), l.windows);
+    try std.testing.expectEqual(@as(u64, 10 + 3), l.landed);
+    var cut = [_]f64{ 0.1, 0.5, 0.3, 0.2, 0.05 };
+    sortDescending(&cut);
+    try std.testing.expectEqualSlices(f64, &.{ 0.5, 0.3, 0.2, 0.1, 0.05 }, &cut);
+    l.noteChances(1.5, &cut, 2);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.8), l.cut[0], 1e-12);
+    try std.testing.expectApproxEqAbs(@as(f64, 1.1), l.cut[1], 1e-12);
+    try std.testing.expectApproxEqAbs(@as(f64, 1.15), l.cut[2], 1e-12);
+    try std.testing.expectApproxEqAbs(@as(f64, 1.5), l.granted, 1e-12);
+    var buf: [1024]u8 = undefined;
+    var w: std.Io.Writer = .fixed(&buf);
+    _ = l.endRound(2);
+    try l.format(&w);
+    try std.testing.expect(std.mem.startsWith(u8, w.buffered(), "rows log: 1 shared rounds, 2.0 streams a round; head windows by rows 1..8: 0 0 0 1 0 0 0 1;"));
+    l.reset();
+    try std.testing.expectEqual(@as(u64, 0), l.windows);
+    try std.testing.expectEqual(@as(u64, 1000), l.every);
+}
