+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig_ = @import("flashnext_rig.zig");
+const lay = @import("flashnext_gdn_heads.zig");
+
+const Rig = rig_.Rig;
+const Heads = lay.Heads;
+const chunk = flash.gdn_chunk;
+const parts = flash.batch_state;
+
+pub const layers = 36;
+pub const Decay = enum { fast, slow };
+pub const heads = [_]Heads{ .full, .half };
+
+pub fn name(h: Heads) []const u8 {
+    return if (h.eql(.full)) "full" else "_h8";
+}
+
+pub fn inputs(r: *Rig, h: Heads, m: usize, decay: Decay) ![7]u64 {
+    const a_log = r.f32s(h.nv, -1, 1);
+    if (decay == .slow) for (a_log) |*x| {
+        x.* -= 6;
+    };
+    return .{
+        try r.dev(std.mem.sliceAsBytes(r.bfs(m * h.projWidth(), 1))),
+        try r.dev(std.mem.sliceAsBytes(r.bfs((lay.taps - 1) * h.convDim(), 1))),
+        try r.dev(std.mem.sliceAsBytes(r.bfs(h.convDim() * lay.taps, 0.5))),
+        try r.dev(std.mem.sliceAsBytes(a_log)),
+        try r.dev(std.mem.sliceAsBytes(r.f32s(h.nv, -1, 1))),
+        try r.dev(std.mem.sliceAsBytes(r.bfs(lay.dv, 1.5))),
+        try r.dev(std.mem.sliceAsBytes(r.f32s(h.nv * lay.dv * lay.dk, -0.5, 0.5))),
+    };
+}
+
+pub const Scan = struct { qn: u64, kn: u64, v: u64, gb: u64 };
+
+pub fn scan(r: *Rig, h: Heads, m: usize) !Scan {
+    return .{ .qn = try r.out(lay.bytes(.keys, 4, m, h)), .kn = try r.out(lay.bytes(.keys, 4, m, h)), .v = try r.out(lay.bytes(.values, 4, m, h)), .gb = try r.out(lay.bytes(.gb, 4, m, h)) };
+}
+
+pub const Out = struct { st: u64, ys: u64, out: u64, xs: u64, wy: u64 };
+
+pub fn outs(r: *Rig, h: Heads, m: usize, ys_elem: usize) !Out {
+    return .{
+        .st = try r.out(lay.bytes(.state, 4, m, h)),
+        .ys = try r.out(lay.bytes(.values, ys_elem, m, h)),
+        .out = try r.out(lay.bytes(.values, 2, m, h)),
+        .xs = try r.out(lay.bytes(.sums, 4, m, h)),
+        .wy = try r.out(@max(chunk.scratchBytes(m), 16)),
+    };
+}
+
+pub fn block(r: *Rig, f: *const lay.Fns, c: *const chunk.Fns, h: Heads, m: usize, in: [7]u64, st_in: u64, x: Scan, o: Out) !void {
+    try lay.front(c.front(f.of(.front, h)), r.s, h, m, in[0], in[1], in[2], in[3], in[4], x.qn, x.kn, x.v, x.gb);
+    try chunk.launchAt(c, r.s, h, m, x.qn, x.kn, x.v, x.gb, st_in, o.st, o.wy, o.ys, .{ .proj = in[0], .norm_w = in[5], .out = o.out, .xs = o.xs });
+    if (c.normed == null) try lay.norm(c.norm(f.of(.norm, h)), r.s, h, m, o.ys, in[0], in[5], o.out, o.xs);
+}
+
+pub fn same(r: *Rig, what: []const u8, h: Heads, m: usize, a: u64, b: u64, n: usize) !void {
+    const x = try r.back(u8, a, n);
+    const y = try r.back(u8, b, n);
+    var diff: usize = 0;
+    for (x, y) |p, q| diff += @intFromBool(p != q);
+    try check.expect(diff == 0, "flashnext-gdn3 {s} heads, {d} rows: {s} differs in {d} of {d} bytes", .{ name(h), m, what, diff, n });
+}
+
+const Loaded = struct {
+    batch: cuda.Module,
+    f: lay.Fns,
+    prod: [2]chunk.Fns,
+    ys: [2]chunk.Fns,
+    compact: [2]chunk.Fns,
+    relaxed: [2]chunk.Fns,
+    relaxed_compact: [2]chunk.Fns,
+    normed: [2]chunk.Fns,
+    relaxed_normed: [2]chunk.Fns,
+
+    fn load(gpu: check.Gpu) !Loaded {
+        var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+        errdefer batch.unload();
+        var l: Loaded = undefined;
+        l.batch = batch;
+        l.f = try (try lay.Fns.load(batch)).withFull(batch);
+        try l.set(0, "");
+        try l.set(1, "_h8");
+        return l;
+    }
+
+    fn set(l: *Loaded, i: usize, comptime sfx: [:0]const u8) !void {
+        l.prod[i] = try chunk.Fns.loadWith(l.batch, sfx, .{});
+        l.ys[i] = try chunk.Fns.loadWith(l.batch, sfx, .{ .narrow = true });
+        l.compact[i] = try chunk.Fns.loadWith(l.batch, sfx, .{ .narrow = true, .compact = true });
+        l.relaxed[i] = try chunk.Fns.loadWith(l.batch, sfx, .{ .relaxed = true });
+        l.relaxed_compact[i] = try chunk.Fns.loadWith(l.batch, sfx, .{ .narrow = true, .compact = true, .relaxed = true });
+        l.normed[i] = try chunk.Fns.loadWith(l.batch, sfx, .{ .narrow = true, .compact = true, .normed = true });
+        l.relaxed_normed[i] = try chunk.Fns.loadWith(l.batch, sfx, .{ .narrow = true, .compact = true, .relaxed = true, .normed = true });
+    }
+};
+
+const compact_counts = [_]usize{ 3072, 1536, 1000, 129, 64, 63, 1 };
+
+pub fn compactRun(gpu: check.Gpu) !void {
+    var prng = std.Random.DefaultPrng.init(39703);
+    var l = try Loaded.load(gpu);
+    defer l.batch.unload();
+    var checks: usize = 0;
+    for (heads, 0..) |h, i| {
+        for ([_]Decay{ .fast, .slow }) |decay| {
+            for (compact_counts) |m| {
+                var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+                defer arena.deinit();
+                var r = try Rig.init(gpu, arena.allocator(), prng.random());
+                defer r.deinit();
+                const in = try inputs(&r, h, m, decay);
+                const xp = try scan(&r, h, m);
+                const op = try outs(&r, h, m, 4);
+                try block(&r, &l.f, &l.prod[i], h, m, in, in[6], xp, op);
+                const xy = try scan(&r, h, m);
+                const oy = try outs(&r, h, m, 2);
+                try block(&r, &l.f, &l.ys[i], h, m, in, in[6], xy, oy);
+                const xc = try scan(&r, h, m);
+                const oc = try outs(&r, h, m, 2);
+                try block(&r, &l.f, &l.compact[i], h, m, in, in[6], xc, oc);
+                const ob = lay.bytes(.values, 2, m, h);
