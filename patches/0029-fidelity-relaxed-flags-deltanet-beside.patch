index 0000000000000000000000000000000000000000..be3286242660cc80d37308ef17d101ae7dc58ab0
--- /dev/null
+++ b/zig/tests/cuda/flashnext_mixed_beside_tests.zig
@@ -0,0 +1,336 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const table_tests = @import("flashnext_mixed_table_tests.zig");
+const prompt = flash.prompt;
+const plan = flash.mixed_plan;
+const env = @import("sys").env;
+const Windows = table_tests.Windows;
+
+const window_context = 4096;
+const max_windows = 28;
+const levels = [_]usize{ 4, 28 };
+const reps = 2;
+const check_rounds = 3;
+const most_rounds = 32;
+const next_rows = 64;
+const piece_room = 96 * 1024;
+const fast_knob = "TF_FLASHNEXT_MIXED_RIDE_FAST";
+const beside_knob = "TF_FLASHNEXT_MIXED_BESIDE";
+const proven_ms = 25.0;
+const dead_ms = 10.0;
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+    ids: []const u32,
+    out: u64,
+    streams: cuda.DeviceBuffer,
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, at_arg: ?[]const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const at = if (at_arg) |v| try std.fmt.parseInt(usize, v, 10) else 0;
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "1", 1);
+    _ = env.setenv(beside_knob, "1", 1);
+    _ = env.setenv(fast_knob, "0", 1);
+    defer _ = env.unsetenv(fast_knob);
+    if (!try flash.knobs.mixedSeqPar()) {
+        std.debug.print("FAIL flashnext-mixed-beside needs TF_FLASHNEXT_MIXED_SEQPAR=1 on both ranks (the MRX flags)\n", .{});
+        return error.TestFailed;
+    }
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const context = @max(window_context, at + piece_room + chunk);
+    var stream = try cuda.Stream.initPriority(gpu.d, .highest);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    const round_cap = @min(flash.knobs.roundRowsCap(), chunk);
+    const max_np = plan.pieceRows(chunk, chunk, round_cap);
+    if (max_np < 1536) return error.RankIdentity;
+    e.beside = try flash.beside.Beside.init(e, chunk, context + chunk);
+    std.debug.print("flashnext-mixed-beside rank {d}: the piece's objects, {d} rows ({d} MiB of scratch and scores, the EXL3 kit's apart)\n", .{ rank, chunk, flash.beside.Beside.bytes(chunk, context + chunk) >> 20 });
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, max_windows * 3 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed apart, riding and beside pieces (its piece on its own stream and channel while its rounds ran)", .{});
+        return;
+    }
+    const ids = try gpu.gpa.alloc(u32, context);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, max_np * prompt.hidden_wide * 2);
+    defer streams.free();
+    const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items, .ids = ids, .out = logits.ptr, .streams = streams };
+    std.debug.print("flashnext-mixed-beside: passes of {d} rows, round rows at most {d}, pieces of 1536 and {d} rows, timed pieces from position {d}; split sums from {d} rows, seqpar from {d}, gather ahead {s}, index ahead {s}, route beside {s}, RoCE {s} (the beside channel is NCCL)\n", .{ chunk, round_cap, max_np, at, try flash.knobs.splitSumMinRows(), try flash.knobs.tpSeqParMinRows(), onWord(try flash.knobs.tpGatherAhead()), onWord(try flash.knobs.tpIndexAhead()), onWord(try flash.knobs.tpRouteBeside()), onWord(flash.knobs.tpRoce()) });
+    for (levels) |d| {
+        const wr = @max(1, @min(3, round_cap / d));
+        for ([_]usize{ 1536, max_np }) |np| {
+            try compare(rig, np, d, wr, false);
+            check.pass("beside: {d} prompt rows beside {d} rounds of {d} windows of {d} rows, every round's scores, the piece's streams, the next verify and the piece's next pass equal the rounds then the piece apart", .{ np, check_rounds, d, wr });
+        }
+        try compare(rig, 1536, d, wr, true);
+        check.pass("beside: a last piece of 1536 rows beside {d} rounds of {d} windows of {d} rows, its first-token scores, streams and next rows equal it apart", .{ check_rounds, d, wr });
+    }
+    for (levels) |d| try bench(rig, at, max_np, d, @max(1, @min(3, round_cap / d)));
+}
+
+fn onWord(v: bool) []const u8 {
+    return if (v) "on" else "off";
+}
+
+const Got = struct {
+    rounds: []u8,
+    streams: []u8,
+    last: []u8,
+    next: []u8,
+
+    fn alloc(gpa: std.mem.Allocator, rounds: usize, streams: usize, row: usize, next: usize) !Got {
+        const a = try gpa.alloc(u8, rounds);
+        errdefer gpa.free(a);
+        const b = try gpa.alloc(u8, streams);
+        errdefer gpa.free(b);
+        const c = try gpa.alloc(u8, row);
+        errdefer gpa.free(c);
+        return .{ .rounds = a, .streams = b, .last = c, .next = try gpa.alloc(u8, next) };
+    }
+
+    fn free(g: Got, gpa: std.mem.Allocator) void {
+        gpa.free(g.rounds);
+        gpa.free(g.streams);
+        gpa.free(g.last);
+        gpa.free(g.next);
+    }
+};
+
+const Way = enum { apart, beside };
+
+fn compare(r: Rig, np: usize, d: usize, wr: usize, last: bool) !void {
+    const row = prompt.vocabulary * 2;
+    const nr = d * wr * row;
+    var got: [2]Got = undefined;
+    var made: usize = 0;
+    defer for (got[0..made]) |g| g.free(r.gpu.gpa);
+    for (&got) |*g| {
+        g.* = try Got.alloc(r.gpu.gpa, check_rounds * nr, np * prompt.hidden_wide * 2, row, nr + row);
+        made += 1;
+    }
+    const dr = r.e.driver;
+    for (&got, [_]Way{ .apart, .beside }) |*g, way| {
+        var w: Windows = .{ .rows = wr };
+        try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+        defer w.deinit(r.session);
+        var p = try r.session.create(window_context + np + next_rows);
+        defer r.session.drop(&p);
+        const piece: flash.beside.Piece = .{ .seq = &p, .ids = r.ids[0..np], .streams = r.streams.ptr, .last = last };
+        if (way == .beside) try r.session.besideStart(flash.Tri, r.tri, piece);
+        for (0..check_rounds) |i| {
+            try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+            try r.stream.synchronize();
+            try dr.check(dr.api.cuMemcpyDtoH_v2(g.rounds[i * nr ..].ptr, r.out, nr), "cuMemcpyDtoH");
+            try w.keepAll(r.session, r.tri);
+        }
+        if (way == .beside) {
+            try r.session.besideJoin();
+        } else try r.session.forward(flash.Tri, r.tri, &p, r.ids[0..np], .{ .logits = if (last) .last else .none, .streams = r.streams.ptr, .prompt = true });
+        try r.stream.synchronize();
+        if (p.fed != np) return error.TestFailed;
+        @memset(g.last, 0);
+        if (last) @memcpy(g.last, p.logits[0..row]);
+        try dr.check(dr.api.cuMemcpyDtoH_v2(g.streams.ptr, r.streams.ptr, g.streams.len), "cuMemcpyDtoH");
+        try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+        try r.stream.synchronize();
+        try dr.check(dr.api.cuMemcpyDtoH_v2(g.next.ptr, r.out, nr), "cuMemcpyDtoH");
+        try w.keepAll(r.session, r.tri);
+        try r.session.forward(flash.Tri, r.tri, &p, r.ids[np..][0..next_rows], .{ .logits = .last, .prompt = true });
+        try r.stream.synchronize();
+        @memcpy(g.next[nr..], p.logits[0..row]);
+    }
+    std.debug.print("beside against apart: {d} piece rows, {d} windows of {d} rows, {d} rounds{s}\n", .{ np, d, wr, check_rounds, if (last) ", last piece" else "" });
+    try check.sameBytes("every window row's scores in each round beside the piece equal the rounds before it", got[1].rounds, got[0].rounds);
+    try check.sameBytes("the piece's hidden streams beside the rounds equal its pass apart", got[1].streams, got[0].streams);
+    if (last) try check.sameBytes("a last piece's first-token scores beside the rounds equal its pass apart", got[1].last, got[0].last);
+    try check.sameBytes("the windows' next verify equals the one after the rounds and the piece apart", got[1].next[0..nr], got[0].next[0..nr]);
+    try check.sameBytes("the piece's next pass's last-row scores equal the ones after it apart", got[1].next[nr..], got[0].next[nr..]);
+}
+
+fn now(io: std.Io) u64 {
+    return @intCast(std.Io.Clock.awake.now(io).toNanoseconds());
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / std.time.ns_per_ms;
+}
+
+const Run = struct {
+    wall: u64 = 0,
+    gap: u64 = 0,
+    during: usize = 0,
+
+    fn add(a: *Run, b: Run) void {
+        a.wall += b.wall;
+        a.gap = @max(a.gap, b.gap);
+        a.during += b.during;
+    }
+};
+
+const Timer = struct {
+    r: Rig,
+    w: *Windows,
+    p: *prompt.Seq,
+
+    fn round(t: Timer) !void {
+        try t.r.session.verifyMany(flash.Tri, t.r.tri, t.w.qs[0..t.w.n], t.w.ds[0..t.w.n], t.w.idss[0..t.w.n], t.r.out);
+        try t.r.stream.synchronize();
+        try t.w.keepAll(t.r.session, t.r.tri);
+    }
+
+    fn verify(t: Timer) !u64 {
+        const t0 = now(t.r.gpu.io);
+        try t.round();
+        return now(t.r.gpu.io) - t0;
+    }
+
+    fn alone(t: Timer, np: usize) !u64 {
+        const t0 = now(t.r.gpu.io);
+        try t.piece(np);
+        return now(t.r.gpu.io) - t0;
+    }
+
+    fn piece(t: Timer, np: usize) !void {
+        try t.r.session.forward(flash.Tri, t.r.tri, t.p, t.r.ids[t.p.fed..][0..np], .{ .logits = .none, .streams = t.r.streams.ptr, .prompt = true });
+        try t.r.stream.synchronize();
+    }
+
+    fn apart(t: Timer, np: usize, n: usize) !Run {
+        const t0 = now(t.r.gpu.io);
+        var prev = t0;
+        var gap: u64 = 0;
+        for (0..n) |_| {
+            try t.round();
+            const x = now(t.r.gpu.io);
+            gap = @max(gap, x - prev);
+            prev = x;
+        }
+        try t.piece(np);
+        const end = now(t.r.gpu.io);
+        return .{ .wall = end - t0, .gap = gap };
+    }
+
+    fn riding(t: Timer, np: usize, n: usize) !Run {
+        const t0 = now(t.r.gpu.io);
+        _ = env.setenv(fast_knob, "1", 1);
+        t.r.session.mixed(flash.Tri, t.r.tri, .{ .seq = t.p, .ids = t.r.ids[t.p.fed..][0..np], .streams = t.r.streams.ptr }, t.w.qs[0..t.w.n], t.w.ds[0..t.w.n], t.w.idss[0..t.w.n], t.r.out) catch |err| {
+            _ = env.setenv(fast_knob, "0", 1);
+            return err;
+        };
+        _ = env.setenv(fast_knob, "0", 1);
+        try t.r.stream.synchronize();
+        try t.w.keepAll(t.r.session, t.r.tri);
+        var prev = now(t.r.gpu.io);
+        var gap = prev - t0;
+        for (1..n) |_| {
+            try t.round();
+            const x = now(t.r.gpu.io);
+            gap = @max(gap, x - prev);
+            prev = x;
+        }
+        return .{ .wall = prev - t0, .gap = gap, .during = 1 };
+    }
+
+    fn beside(t: Timer, np: usize, n: usize) !Run {
+        const x = t.r.e.beside.?;
+        var ends: [most_rounds]u64 = undefined;
+        const t0 = now(t.r.gpu.io);
+        try t.r.session.besideStart(flash.Tri, t.r.tri, .{ .seq = t.p, .ids = t.r.ids[t.p.fed..][0..np], .streams = t.r.streams.ptr });
+        var prev = t0;
+        var gap: u64 = 0;
+        for (ends[0..n]) |*end| {
+            try t.round();
+            const xn = now(t.r.gpu.io);
+            gap = @max(gap, xn - prev);
+            prev = xn;
+            end.* = flash.beside.now();
+        }
+        const piece_end = x.endedAt();
+        try t.r.session.besideJoin();
+        const t1 = now(t.r.gpu.io);
+        var during: usize = 0;
+        for (ends[0..n]) |end| during += @intFromBool(piece_end == 0 or end <= piece_end);
+        return .{ .wall = t1 - t0, .gap = gap, .during = during };
+    }
+};
+
+fn bench(r: Rig, at: usize, max_np: usize, d: usize, wr: usize) !void {
+    var w: Windows = .{ .rows = wr };
+    try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+    defer w.deinit(r.session);
+    var p = try r.session.create(at + piece_room + r.e.chunk);
+    defer r.session.drop(&p);
+    while (p.fed < at) try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..@min(at, p.fed + r.e.chunk)], .{ .logits = .none, .prompt = true });
+    try r.stream.synchronize();
+    const t: Timer = .{ .r = r, .w = &w, .p = &p };
+    _ = try t.verify();
+    var base: u64 = 0;
+    for (0..reps) |_| base += try t.verify();
+    base /= reps;
+    const from = p.fed;
+    for ([_]usize{ 1536, max_np }) |np| {
+        _ = try t.alone(np);
+        var alone_ns: u64 = 0;
+        for (0..reps) |_| alone_ns += try t.alone(np);
+        alone_ns /= reps;
+        const n: usize = @max(1, @min(most_rounds, (alone_ns + base / 2) / @max(base, 1)));
+        if (p.fed + (1 + reps) * 3 * np > p.cap) return error.PromptTooLong;
+        _ = try t.apart(np, n);
+        _ = try t.riding(np, n);
+        _ = try t.beside(np, n);
+        var apart: Run = .{};
+        var ride: Run = .{};
+        var bes: Run = .{};
+        for (0..reps) |_| {
+            apart.add(try t.apart(np, n));
+            ride.add(try t.riding(np, n));
+            bes.add(try t.beside(np, n));
+        }
+        const k: f64 = reps;
+        const a = ms(apart.wall) / k;
+        const rd = ms(ride.wall) / k;
+        const b = ms(bes.wall) / k;
+        const saved = a - b;
+        const verdict: []const u8 = if (d < max_windows) "reported" else if (saved >= proven_ms) "PROVEN" else if (saved <= dead_ms) "DEAD" else "between";
+        std.debug.print("RESULT flashnext-mixed-beside {d} windows x {d} rows, {d} piece rows, {d} rounds: apart {d:.1} ms, riding {d:.1} ms, beside {d:.1} ms; beside saves {d:.1} ms on apart ({d:.1} on riding); rounds done while the piece ran {d:.1} of {d} (riding 1); longest gap between rounds: apart {d:.1}, riding {d:.1}, beside {d:.1} ms; verify alone {d:.1}, piece alone {d:.1}; rule at 28 windows: proven at <= apart - {d:.0}, dead at >= apart - {d:.0}: {s}\n", .{ d, wr, np, n, a, rd, b, saved, rd - b, @as(f64, @floatFromInt(bes.during)) / k, n, ms(apart.gap), ms(ride.gap), ms(bes.gap), ms(base), ms(alone_ns), proven_ms, dead_ms, verdict });
+    }
+    std.debug.print("RESULT flashnext-mixed-beside {d} windows: pieces from position {d} to {d}\n", .{ d, from, p.fed });
+}
