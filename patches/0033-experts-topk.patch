@@ -0,0 +1,75 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+
+const ne = 512;
+const nl = ne + 1;
+const slots = 11;
+const top = 10;
+
+fn route(gpu: check.Gpu, rr: *const cuda.route_rows.RouteRows, stream: cuda.Stream, l: cuda.DeviceBuffer, picks: cuda.DeviceBuffer, wts: cuda.DeviceBuffer, rows: usize, keep: usize) !struct { p: []u8, w: []u8 } {
+    try rr.keepTopk(keep);
+    try rr.topk(stream, l.ptr, nl, ne, top, picks.ptr, wts.ptr, slots, rows, true);
+    try stream.synchronize();
+    return .{ .p = try check.download(gpu, picks), .w = try check.download(gpu, wts) };
+}
+
+pub fn kernel(gpu: check.Gpu, rows: usize, keep: usize) !void {
+    if (rows == 0 or rows > 1024) return error.BadRows;
+    if (keep == 0 or keep >= top) return error.BadKeep;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var rr = try cuda.route_rows.RouteRows.load(gpu.d);
+    defer rr.unload();
+    const gpa = gpu.gpa;
+    const logits = try gpa.alloc(f32, rows * nl);
+    defer gpa.free(logits);
+    var prng = std.Random.DefaultPrng.init(81);
+    const rnd = prng.random();
+    for (logits) |*x| x.* = @floatCast(rnd.floatNorm(f64) * 2.0);
+    for (0..rows / 8) |r| logits[r * nl + 3] = logits[r * nl + 7];
+    var l = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(logits));
+    defer l.free();
+    var picks = try cuda.DeviceBuffer.alloc(gpu.d, rows * slots * 4);
+    defer picks.free();
+    var wts = try cuda.DeviceBuffer.alloc(gpu.d, rows * slots * 4);
+    defer wts.free();
+    const off = try route(gpu, &rr, stream, l, picks, wts, rows, 0);
+    defer gpa.free(off.p);
+    defer gpa.free(off.w);
+    const on = try route(gpu, &rr, stream, l, picks, wts, rows, keep);
+    defer gpa.free(on.p);
+    defer gpa.free(on.w);
+    const back = try route(gpu, &rr, stream, l, picks, wts, rows, top);
+    defer gpa.free(back.p);
+    defer gpa.free(back.w);
+    try check.expect(std.mem.eql(u8, off.p, back.p) and std.mem.eql(u8, off.w, back.w), "keep {d} (the model's own ten) is not byte-equal to keep 0", .{top});
+    const p0: []const u32 = @alignCast(std.mem.bytesAsSlice(u32, off.p));
+    const p1: []const u32 = @alignCast(std.mem.bytesAsSlice(u32, on.p));
+    const w0: []const f32 = @alignCast(std.mem.bytesAsSlice(f32, off.w));
+    const w1: []const f32 = @alignCast(std.mem.bytesAsSlice(f32, on.w));
+    var worst: f64 = 0;
+    var nat: std.StaticBitSet(ne) = .empty;
+    var act: std.StaticBitSet(ne) = .empty;
+    for (0..rows) |r| {
+        const a = p0[r * slots ..][0..slots];
+        const b = p1[r * slots ..][0..slots];
+        try check.expect(std.mem.eql(u32, a[0..keep], b[0..keep]), "row {d}: the kept picks differ from the model's top {d}", .{ r, keep });
+        try check.expect(b[top] == ne and w1[r * slots + top] == w0[r * slots + top], "row {d}: the shared slot moved", .{r});
+        for (keep..top) |k| try check.expect(b[k] == b[0] and w1[r * slots + k] == 0, "row {d} slot {d}: a dropped pick is not the top pick at weight 0", .{ r, k });
+        const lg = logits[r * nl ..][0..nl];
+        var total: f64 = 0;
+        var sum: f64 = 0;
+        for (b[0..keep]) |e| total += @exp(@as(f64, lg[e]) - lg[b[0]]);
+        for (b[0..keep], 0..) |e, k| {
+            const w = @exp(@as(f64, lg[e]) - lg[b[0]]) / total;
+            worst = @max(worst, @abs(w1[r * slots + k] - w) / w);
+            sum += w1[r * slots + k];
+        }
+        try check.expect(@abs(sum - 1) < 1.0 / 64.0, "row {d}: kept weights sum to {d:.5}", .{ r, sum });
+        for (0..top) |k| nat.set(a[k]);
+        for (0..keep) |k| act.set(b[k]);
+    }
+    try check.expect(worst < 1.0 / 128.0, "a kept weight is {d:.5} off its renormalised value", .{worst});
+    check.pass("experts-topk kernel at {d} rows, keep {d}: kept picks equal the model's top {d}, dropped slots the top pick at weight 0, shared slot unchanged, weights within {d:.5} of the softmax over the kept; keep 10 byte-equal to keep 0; distinct experts {d} -> {d}", .{ rows, keep, keep, worst, nat.count(), act.count() });
+}
