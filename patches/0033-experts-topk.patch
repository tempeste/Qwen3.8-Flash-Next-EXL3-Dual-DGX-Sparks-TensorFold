 pub const expert_reroute_bit = 54;
 pub const reroute_picks: usize = 10;
 pub const reroute_most: usize = 32;
@@ -3235,8 +3259,28 @@ pub fn expertRerouteDigest(r: ExpertReroute) u64 {
 }
 
 fn expertRerouteBits() u64 {
-    const r = (expertReroute() catch return 0) orelse return 0;
-    return (1 | expertRerouteDigest(r) << 1) << expert_reroute_bit;
