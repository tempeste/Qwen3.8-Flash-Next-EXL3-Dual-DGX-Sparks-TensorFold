+    try std.testing.expectEqual(@as(?usize, null), try expertsTopkFrom(null));
+    try std.testing.expectEqual(@as(?usize, null), try expertsTopkFrom("0"));
+    try std.testing.expectEqual(@as(?usize, null), try expertsTopkFrom("10"));
+    try std.testing.expectEqual(@as(?usize, 5), try expertsTopkFrom("5"));
+    try std.testing.expectEqual(@as(?usize, 1), try expertsTopkFrom("1"));
+    try std.testing.expectEqual(@as(?usize, 9), try expertsTopkFrom("9"));
+    for ([_][]const u8{ "", "11", "-1", "5 ", "five", "5,24" }) |bad| try std.testing.expectError(error.BadExpertsTopk, expertsTopkFrom(bad));
+}
