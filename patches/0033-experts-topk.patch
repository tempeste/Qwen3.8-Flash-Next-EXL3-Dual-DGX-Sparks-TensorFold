diff --git a/zig/src/core/route_ref.zig b/zig/src/core/route_ref.zig
index 21200dae9ffcc6b1974b67f7eb4fd0655252a5cb..75647304d93f3dd09d1cc55d128855a24b16c232 100644
--- a/zig/src/core/route_ref.zig
+++ b/zig/src/core/route_ref.zig
@@ -30,6 +30,76 @@ pub fn topk(logits: []const f64, ids: []usize, weights: []f64) void {
     for (ids, weights) |id, *w| w.* = @exp(logits[id] - logits[ids[0]]) / total;
 }
 
+pub fn topkKept(logits: []const f64, keep: usize, ids: []usize, weights: []f64) void {
+    const k = if (keep == 0 or keep >= ids.len) ids.len else keep;
+    topk(logits, ids[0..k], weights[0..k]);
+    for (ids[k..], weights[k..]) |*id, *w| {
+        id.* = ids[0];
+        w.* = 0;
+    }
+}
+
+test "keeping all ten picks is the model's own routing, bit for bit" {
+    var prng = std.Random.DefaultPrng.init(3970);
+    const rnd = prng.random();
+    for (0..200) |_| {
+        var l: [512]f64 = undefined;
+        for (&l) |*v| v.* = rnd.floatNorm(f64) * 2;
+        var ids: [10]usize = undefined;
+        var w: [10]f64 = undefined;
+        var kids: [10]usize = undefined;
+        var kw: [10]f64 = undefined;
+        topk(&l, &ids, &w);
+        for ([_]usize{ 0, 10, 11 }) |keep| {
+            topkKept(&l, keep, &kids, &kw);
+            try std.testing.expectEqualSlices(usize, &ids, &kids);
+            try std.testing.expectEqualSlices(f64, &w, &kw);
+        }
+    }
+}
+
+test "keeping five takes the top five, renormalised over the five as norm_topk_prob does, the rest weigh nothing on the top pick" {
+    var prng = std.Random.DefaultPrng.init(81);
+    const rnd = prng.random();
+    for (0..200) |_| {
+        var l: [512]f64 = undefined;
+        for (&l) |*v| v.* = rnd.floatNorm(f64) * 2;
+        var ids: [10]usize = undefined;
+        var w: [10]f64 = undefined;
+        topk(&l, &ids, &w);
+        var kids: [10]usize = undefined;
+        var kw: [10]f64 = undefined;
+        topkKept(&l, 5, &kids, &kw);
+        try std.testing.expectEqualSlices(usize, ids[0..5], kids[0..5]);
+        var p: [512]f64 = undefined;
+        var z: f64 = 0;
+        for (l, &p) |v, *q| {
+            q.* = @exp(v);
+            z += q.*;
+        }
+        var top5: f64 = 0;
+        for (ids[0..5]) |id| top5 += p[id] / z;
+        var sum10: f64 = 0;
+        for (w[0..5]) |x| sum10 += x;
+        var total: f64 = 0;
+        for (0..5) |k| {
+            try std.testing.expectApproxEqRel((p[ids[k]] / z) / top5, kw[k], 1e-12);
+            try std.testing.expectApproxEqRel(w[k] / sum10, kw[k], 1e-12);
+            total += kw[k];
+        }
+        try std.testing.expectApproxEqAbs(@as(f64, 1), total, 1e-12);
+        for (5..10) |k| {
+            try std.testing.expectEqual(ids[0], kids[k]);
+            try std.testing.expectEqual(@as(f64, 0), kw[k]);
+        }
+        var distinct: usize = 0;
+        for (kids, 0..) |id, i| {
+            if (std.mem.indexOfScalar(usize, kids[0..i], id) == null) distinct += 1;
+        }
+        try std.testing.expectEqual(@as(usize, 5), distinct);
+    }
+}
