+test "TF_FLASHNEXT_EXPERTS_TOPK puts K in bits 55-58 with bit 54 clear, so ranks with another K or the re-route disagree" {
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_FLASHNEXT_EXPERTS_TOPK");
+    _ = env.unsetenv("TF_FLASHNEXT_EXPERTS_TOPK");
+    _ = env.unsetenv("TF_FLASHNEXT_EXPERT_REROUTE");
+    const off = tpFlags();
+    try std.testing.expectEqual(@as(u64, 0), off >> expert_reroute_bit);
+    _ = env.setenv("TF_FLASHNEXT_EXPERTS_TOPK", "10", 1);
+    try std.testing.expectEqual(off, tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_EXPERTS_TOPK", "5", 1);
+    const five = tpFlags();
+    try std.testing.expectEqual(off, five & ((@as(u64, 1) << expert_reroute_bit) - 1));
+    try std.testing.expectEqual(@as(u64, 10), five >> expert_reroute_bit);
+    _ = env.setenv("TF_FLASHNEXT_EXPERTS_TOPK", "6", 1);
+    try std.testing.expect(tpFlags() != five);
+    _ = env.setenv("TF_FLASHNEXT_EXPERTS_TOPK", "11", 1);
+    try std.testing.expectEqual(off, tpFlags());
