+pub fn expertsTopkFrom(value: ?[]const u8) error{BadExpertsTopk}!?usize {
+    const v = value orelse return null;
+    if (v.len == 0) return error.BadExpertsTopk;
+    const k = std.fmt.parseInt(usize, v, 10) catch return error.BadExpertsTopk;
+    if (k > experts_topk_most) return error.BadExpertsTopk;
+    return if (k == 0 or k == experts_topk_most) null else k;
+}
+
+pub fn expertsTopk() error{BadExpertsTopk}!?usize {
+    return expertsTopkFrom(if (std.c.getenv("TF_FLASHNEXT_EXPERTS_TOPK")) |v| std.mem.span(v) else null);
