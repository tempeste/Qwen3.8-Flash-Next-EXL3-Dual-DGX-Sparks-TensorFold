+        try t.expectError(error.BadRankFrame, rank_snap.Mark.decode(&(rank_snap.Mark.of(served + 1, .{ 0, 0 }).encode())));
+    }
+}
+
+test "the shared pool at --tp 2: rank 1's stream and kept-state bytes never pass rank 0's charge for them" {
+    const kv0: Kv = .nvfp4;
+    const fixed0 = load.streamBytesIn(kv0, 0, 1, chunk, true, .half, index_window.rows(chunk));
+    var cap: usize = 1;
+    while (cap <= 1 << 20) : (cap = cap * 3 / 2 + 7) {
+        for ([_]Kv{ .bf16, .fp8, .nvfp4, .fp8k_nvfp4v }) |kv| {
+            const r1 = load.streamBytesIn(kv, cap, null, chunk, true, .half, index_window.rows(chunk));
+            const drafting0 = prompt.seqBytesIn(kv, cap, .half, index_window.rows(chunk)) + mtp.Draft.bytesFor(kv, cap, 1, chunk, .half);
+            const plain0 = prompt.seqBytesIn(kv, cap, .half, index_window.rows(chunk));
+            try t.expect(r1 <= fixed0 + plain0);
+            try t.expect(r1 <= drafting0);
+            for ([_]bool{ false, true }) |w| {
+                try t.expect(snap.bytesIn(kv, null, cap, .half, w) <= snap.bytesIn(kv, .bf16, cap, .half, w));
+            }
+        }
+    }
+}
+
+test "memory at --tp 2 with nvfp4 caches: bytes a token a stream on each rank, the fixed part, and the 400,000-token table" {
+    const per0 = (rank0(.nvfp4, 304_000) - rank0(.nvfp4, 300_000)) / 4000;
+    const per1 = (rank1(.nvfp4, 304_000) - rank1(.nvfp4, 300_000)) / 4000;
+    try t.expectEqual(@as(usize, 5360), per0);
+    try t.expectEqual(@as(usize, 4432), per1);
+    const at_today = rank0(.nvfp4, 229_376);
+    try t.expect(at_today > 1_500_000_000 and at_today < 1_503_000_000);
+    const gib: f64 = 1 << 30;
+    std.debug.print("\nflashnext tp2 nvfp4: {d} B a token a stream on rank 0, {d} on rank 1; fixed {d:.1} MiB on rank 0\n", .{ per0, per1, @as(f64, @floatFromInt(at_today - per0 * 229_376)) / (1 << 20) });
+    for ([_]usize{ 229_376, 262_144, 327_680, 400_000, 524_288 }) |context| {
+        const s0: f64 = @as(f64, @floatFromInt(rank0(.nvfp4, context))) / gib;
+        const s1: f64 = @as(f64, @floatFromInt(rank1(.nvfp4, context))) / gib;
+        std.debug.print("  {d}: {d:.3} GiB a stream on rank 0, {d:.3} on rank 1; 20/24/28 streams reserve {d:.1}/{d:.1}/{d:.1} GiB\n", .{ context, s0, s1, 20 * s0, 24 * s0, 28 * s0 });
+    }
+}
+
+test "--tp 2 pool: rank 1's charge for a stream is its own sequence, verify window and image rows, below rank 0's" {
+    const lanes_mod = @import("cuda_lanes.zig");
+    const iw = index_window.rows(chunk);
+    for ([_]usize{ 1, 1600, 97_000, 400_032 }) |cap| {
+        const plain = lanes_mod.peerStreamBytes(.nvfp4, cap, .half, iw, chunk, 0);
+        try t.expectEqual(load.streamBytesIn(.nvfp4, cap, null, chunk, true, .half, iw), plain);
+        const seen = lanes_mod.peerStreamBytes(.nvfp4, cap, .half, iw, chunk, 16384);
+        try t.expectEqual(plain + image_rows + 16 * cap, seen);
+        try t.expect(seen <= rank0(.nvfp4, cap) + mtp.max_rows * 16);
+    }
+}
diff --git a/zig/src/families/flashnext/expert_reroute.zig b/zig/src/families/flashnext/expert_reroute.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7d23262c1b6a60468c2f8e3b7d4428747c61bc1c
--- /dev/null
+++ b/zig/src/families/flashnext/expert_reroute.zig
@@ -0,0 +1,139 @@
+const std = @import("std");
+const knobs = @import("cuda_knobs.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const route_dump = @import("route_dump.zig");
+
+pub const Rule = knobs.ExpertReroute;
+pub const Core = std.StaticBitSet(1024);
+
+pub var rule: ?Rule = null;
+pub var rounds: u64 = 0;
+
+pub fn configure() !void {
+    rule = try knobs.expertReroute();
+}
+
+pub fn takes(r: ?Rule, streams: usize) bool {
+    const x = r orelse return false;
+    return streams >= x.min;
+}
+
+pub fn mainDecodeLayer(self: anytype, layer: usize) bool {
+    return !self.mtp_head and self.lanes.len > 0 and !self.prompt_lanes and self.ride == 0 and layer < self.m.layers.len;
+}
+
+pub fn decodeRound(self: anytype, layer: usize, n: usize) !void {
+    if (!mainDecodeLayer(self, layer)) return;
+    const applied = takes(rule, self.lanes.len);
+    if (applied) {
+        const r = rule.?;
+        const s = self.s;
+        const g = self.tri.own orelse return error.NativeGlueRequired;
+        try self.copy(s.picks_ep, s.picks, n * wt.slots * 4);
+        try g.route.reroute(self.stream, s.router_l, wt.experts_n + 1, wt.experts_n, wt.slots - 1, r.k0, r.kp, s.picks_ep, s.picks, s.wts, wt.slots, n);
+        if (layer == 0) rounds += 1;
+    }
+    try route_dump.capture(self, layer, n, applied);
+}
+
+pub fn coreOf(picks: []const u32, stride: usize, k0: usize) Core {
+    var c: Core = .empty;
+    var r: usize = 0;
+    while (r + k0 <= picks.len) : (r += stride) for (picks[r..][0..k0]) |e| {
+        if (e < c.capacity()) c.set(e);
+    };
+    return c;
+}
+
+pub fn choose(ranked: []const u32, core: *const Core, k0: usize, picks: usize, out: []u32) []u32 {
+    var take: [knobs.reroute_most]bool = @splat(false);
+    var n: usize = @min(k0, picks);
+    for (0..n) |k| take[k] = true;
+    for (ranked[k0..], k0..) |e, k| {
+        if (n == picks) break;
+        if (e < core.capacity() and core.isSet(e)) {
+            take[k] = true;
+            n += 1;
+        }
+    }
+    for (k0..ranked.len) |k| {
+        if (n == picks) break;
+        if (!take[k]) {
+            take[k] = true;
+            n += 1;
+        }
+    }
+    var o: usize = 0;
+    for (ranked, 0..) |e, k| if (take[k]) {
+        out[o] = e;
+        o += 1;
+    };
+    return out[0..o];
+}
+
+test "a row whose late picks the batch's core already holds keeps its natural picks" {
+    const ranked = [_]u32{ 5, 9, 1, 7, 3, 8, 2, 11, 40, 41, 42, 43, 44, 45 };
+    var core: Core = .empty;
+    for ([_]u32{ 5, 9, 1, 7, 3, 8, 2, 11, 40, 41, 44 }) |e| core.set(e);
+    var out: [10]u32 = undefined;
+    try std.testing.expectEqualSlices(u32, ranked[0..10], choose(&ranked, &core, 4, 10, &out));
+}
+
+test "the top K0 stay, late picks outside the core give way to core candidates from the next ranks, in rank order" {
+    const ranked = [_]u32{ 5, 9, 1, 7, 3, 8, 2, 11, 40, 41, 42, 43, 44, 45, 46, 47 };
+    var core: Core = .empty;
+    for ([_]u32{ 3, 2, 43, 46, 47 }) |e| core.set(e);
+    var out: [10]u32 = undefined;
+    try std.testing.expectEqualSlices(u32, &.{ 5, 9, 1, 7, 3, 8, 2, 43, 46, 47 }, choose(&ranked, &core, 4, 10, &out));
+    try std.testing.expectEqualSlices(u32, &.{ 5, 9, 1, 7, 3, 8, 2, 11, 40, 43 }, choose(ranked[0..12], &core, 4, 10, &out));
+    core = .empty;
+    for ([_]u32{ 40, 41, 42, 43, 44, 45, 46, 47 }) |e| core.set(e);
+    try std.testing.expectEqualSlices(u32, &.{ 5, 9, 40, 41, 42, 43, 44, 45, 46, 47 }, choose(&ranked, &core, 1, 10, &out));
+}
+
+test "the top pick never changes and the core is every row's top K0" {
+    const picks = [_]u32{ 1, 2, 3, 99, 4, 5, 6, 98 };
+    const core = coreOf(&picks, 4, 2);
+    try std.testing.expect(core.isSet(1) and core.isSet(2) and core.isSet(4) and core.isSet(5));
+    try std.testing.expect(!core.isSet(3) and !core.isSet(6) and !core.isSet(99));
+    var prng = std.Random.DefaultPrng.init(3970);
+    const rnd = prng.random();
+    for (0..2000) |_| {
+        var ranked: [24]u32 = undefined;
+        for (&ranked, 0..) |*e, i| e.* = @intCast(i * 21 % 512);
+        rnd.shuffle(u32, &ranked);
+        var c: Core = .empty;
+        for (0..60) |_| c.set(rnd.uintLessThan(u32, 512));
+        const k0 = 1 + rnd.uintLessThan(usize, 9);
+        const kp = 11 + rnd.uintLessThan(usize, 14);
+        var out: [10]u32 = undefined;
+        const got = choose(ranked[0..kp], &c, k0, 10, &out);
+        try std.testing.expectEqual(@as(usize, 10), got.len);
+        try std.testing.expectEqualSlices(u32, ranked[0..k0], got[0..k0]);
+    }
+}
+
+test "the MTP head's one-layer passes are never re-routed or dumped, main decode layers are" {
+    const Fake = struct { mtp_head: bool, lanes: []const u8, prompt_lanes: bool = false, ride: usize = 0, m: struct { layers: []const u8 } };
+    const main_layers: [wt.layers_n]u8 = @splat(0);
+    const head_layer: [1]u8 = .{0};
+    const lanes: [3]u8 = @splat(0);
+    const main: Fake = .{ .mtp_head = false, .lanes = &lanes, .m = .{ .layers = &main_layers } };
+    const head: Fake = .{ .mtp_head = true, .lanes = &lanes, .m = .{ .layers = &head_layer } };
+    try std.testing.expect(mainDecodeLayer(main, 0) and mainDecodeLayer(main, wt.layers_n - 1));
+    try std.testing.expect(!mainDecodeLayer(main, wt.layers_n));
+    try std.testing.expect(!mainDecodeLayer(head, 0));
+    var lone = main;
+    lone.lanes = &.{};
+    try std.testing.expect(!mainDecodeLayer(lone, 0));
+    var mixed = main;
+    mixed.ride = 4;
+    try std.testing.expect(!mainDecodeLayer(mixed, 0));
+}
+
+test "the rule runs from MIN streams and is off without a setting" {
+    try std.testing.expect(!takes(null, 64));
+    try std.testing.expect(!takes(.{ .k0 = 4, .kp = 16, .min = 8 }, 7));
+    try std.testing.expect(takes(.{ .k0 = 4, .kp = 16, .min = 8 }, 8));
+    try std.testing.expect(knobs.reroute_picks == wt.slots - 1 and knobs.reroute_most == @import("cuda").route_rows.most_candidates);
+}
diff --git a/zig/src/families/flashnext/route_dump.zig b/zig/src/families/flashnext/route_dump.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0e99435893f02167e24eec69421f5520acd31605
--- /dev/null
+++ b/zig/src/families/flashnext/route_dump.zig
@@ -0,0 +1,224 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const knobs = @import("cuda_knobs.zig");
+const wt = @import("cuda_prompt_wt.zig");
+
+pub const magic: u32 = 0x44524654;
+pub const version: u32 = 1;
+pub const cand: usize = 24;
+pub const kind_decode: u32 = 0;
+pub const kind_mixed: u32 = 1;
+pub const header_words: usize = 8;
+pub const record_words: usize = 6;
+const slots = wt.slots;
+const picks_n = wt.slots - 1;
+const row_bytes = (slots + 2 * cand) * 4;
+const out_row = (slots + 2 * cand) * 2;
+const least_rows = 256;
+
+pub const Stats = struct {
+    rounds: u64 = 0,
+    layers: u64 = 0,
+    rows: u64 = 0,
+    natural: u64 = 0,
+    actual: u64 = 0,
+    natural_rank: u64 = 0,
+    actual_rank: u64 = 0,
+    top_moved: u64 = 0,
+};
+
+const State = struct {
+    file: ?*std.c.FILE,
+    cap: usize,
+    world: usize,
+    written: usize = 0,
+    layers: usize = 0,
+    dev: ?cuda.DeviceBuffer = null,
+    dev_rows: usize = 0,
+    host: []u8 = &.{},
+    out: []u8 = &.{},
+    rows: usize = 0,
+    seen: usize = 0,
+    full: bool = false,
+    skipped: u64 = 0,
+};
+
+pub var state: ?State = null;
+pub var stats: Stats = .{};
+const gpa = std.heap.page_allocator;
+extern "c" fn fflush(stream: ?*std.c.FILE) c_int;
+
+pub fn open(cfg: ?knobs.RouteDump, rank: usize, world: usize) !void {
+    close();
+    const c = cfg orelse return;
+    if (rank != 0) return;
+    var path: [4096:0]u8 = undefined;
+    if (c.path.len >= path.len) return error.BadRouteDump;
+    @memcpy(path[0..c.path.len], c.path);
+    path[c.path.len] = 0;
+    const f = std.c.fopen(&path, "wb") orelse return error.RouteDumpOpen;
+    state = .{ .file = f, .cap = c.cap, .world = world };
+    std.log.info("flashnext: route dump of shared decode rounds into {s}, at most {d} MiB", .{ c.path, c.cap >> 20 });
+}
+
+pub fn startStats(world: usize) void {
+    close();
+    stats = .{};
+    state = .{ .file = null, .cap = std.math.maxInt(usize), .world = world };
+}
+
+pub fn close() void {
+    const st = if (state) |*x| x else return;
+    if (st.file) |f| _ = std.c.fclose(f);
+    if (st.dev) |*d| d.free();
+    if (st.host.len > 0) gpa.free(st.host);
+    if (st.out.len > 0) gpa.free(st.out);
+    state = null;
+}
+
+pub fn mixedRound(prompt_rows: usize, ride: usize) !void {
+    const st = if (state) |*x| x else return;
+    if (st.full or st.layers == 0) return;
+    const words = [record_words]u32{ kind_mixed, @intCast(ride), 0, @intCast(prompt_rows), 0, 0 };
+    try put(st, std.mem.sliceAsBytes(&words));
+}
+
+pub fn capture(self: anytype, layer: usize, n: usize, applied: bool) !void {
+    const st = if (state) |*x| x else return;
+    if (st.full) return;
+    if (!@hasField(@TypeOf(self.tri), "own")) return;
+    const layers = self.m.layers.len;
+    if (layer == 0) {
+        st.rows = n;
+        st.seen = 0;
+    }
+    if (st.rows != n or st.seen != layer) return;
+    try ensure(st, self.stream.d, layers, n);
+    const g = self.tri.own orelse return error.NativeGlueRequired;
+    const base = st.dev.?.ptr + layer * n * row_bytes;
+    try self.copy(base, self.s.picks, n * slots * 4);
+    try g.route.topk(self.stream, self.s.router_l, wt.experts_n + 1, wt.experts_n, cand, base + n * slots * 4, base + n * (slots + cand) * 4, cand, n, false);
+    st.seen += 1;
+    if (st.seen < layers) return;
+    try self.stream.synchronize();
+    const bytes = layers * n * row_bytes;
+    try cuda.memory.download(self.stream.d, st.dev.?.ptr, st.host[0..bytes]);
+    try finish(st, n, self.lanes.len, applied);
+}
+
+fn ensure(st: *State, d: *const cuda.Driver, layers: usize, n: usize) !void {
+    if (st.layers != 0 and st.layers != layers) return error.RouteDumpLayers;
+    if (st.layers == 0) {
+        st.layers = layers;
+        const words = [header_words]u32{ magic, version, @intCast(layers), @intCast(cand), @intCast(slots), @intCast(picks_n), @intCast(wt.experts_n), @intCast(st.world) };
+        try put(st, std.mem.sliceAsBytes(&words));
+    }
+    if (st.dev != null and st.dev_rows >= n) return;
+    if (st.dev) |*b| b.free();
+    st.dev = null;
+    if (st.host.len > 0) gpa.free(st.host);
+    if (st.out.len > 0) gpa.free(st.out);
+    st.host = &.{};
+    st.out = &.{};
+    const rows = @max(n, least_rows);
+    st.dev = try cuda.DeviceBuffer.alloc(d, layers * rows * row_bytes);
+    st.dev_rows = rows;
+    st.host = try gpa.alloc(u8, layers * rows * row_bytes);
+    st.out = try gpa.alloc(u8, layers * rows * out_row);
+}
+
+fn put(st: *State, bytes: []const u8) !void {
+    if (st.file == null) return;
+    if (st.written + bytes.len > st.cap) {
+        st.full = true;
+        std.log.info("flashnext: route dump reached its cap at {d} bytes; later rounds are not recorded", .{st.written});
+        _ = fflush(st.file);
+        return;
+    }
+    if (std.c.fwrite(bytes.ptr, 1, bytes.len, st.file.?) != bytes.len) return error.RouteDumpWrite;
+    st.written += bytes.len;
+}
+
+fn finish(st: *State, n: usize, streams: usize, applied: bool) !void {
+    const layers = st.layers;
+    var o: usize = 0;
+    for (0..layers) |l| {
+        const at = st.host[l * n * row_bytes ..][0 .. n * row_bytes];
+        const picks = std.mem.bytesAsSlice(u32, at[0 .. n * slots * 4]);
+        const ids = std.mem.bytesAsSlice(u32, at[n * slots * 4 ..][0 .. n * cand * 4]);
+        const ws = std.mem.bytesAsSlice(u32, at[n * (slots + cand) * 4 ..][0 .. n * cand * 4]);
+        tally(picks, ids, n);
+        for (picks) |v| {
+            std.mem.writeInt(u16, st.out[o..][0..2], @intCast(v), .little);
+            o += 2;
+        }
+        for (ids) |v| {
+            std.mem.writeInt(u16, st.out[o..][0..2], @intCast(v), .little);
+            o += 2;
+        }
+        for (ws) |v| {
+            std.mem.writeInt(u16, st.out[o..][0..2], @intCast(v >> 16), .little);
+            o += 2;
+        }
+    }
+    stats.rounds += 1;
+    const words = [record_words]u32{ kind_decode, @intCast(n), @intCast(streams), 0, @intFromBool(applied), @intCast(layers) };
+    try put(st, std.mem.sliceAsBytes(&words));
+    try put(st, st.out[0..o]);
+    if (st.file) |f| _ = fflush(f);
+}
+
+fn tally(picks: []align(1) const u32, ids: []align(1) const u32, n: usize) void {
+    const half = wt.experts_n / 2;
+    var nat: std.StaticBitSet(wt.experts_n) = .empty;
+    var act: std.StaticBitSet(wt.experts_n) = .empty;
+    for (0..n) |r| {
+        for (picks[r * slots ..][0..picks_n]) |e| act.set(e);
+        for (ids[r * cand ..][0..picks_n]) |e| nat.set(e);
+        if (picks[r * slots] != ids[r * cand]) stats.top_moved += 1;
+    }
+    stats.layers += 1;
+    stats.rows += n;
+    stats.natural += nat.count();
+    stats.actual += act.count();
+    stats.natural_rank += @max(rankCount(&nat, 0, half), rankCount(&nat, half, wt.experts_n));
+    stats.actual_rank += @max(rankCount(&act, 0, half), rankCount(&act, half, wt.experts_n));
+}
+
+fn rankCount(b: *const std.StaticBitSet(wt.experts_n), lo: usize, hi: usize) usize {
+    var c: usize = 0;
+    for (lo..hi) |e| c += @intFromBool(b.isSet(e));
+    return c;
+}
+
+test "a dump row holds the eleven slots and 24 candidates with their weights, the file words in their places" {
+    try std.testing.expectEqual(@as(usize, 11), slots);
+    try std.testing.expectEqual(@as(usize, 236), row_bytes);
+    try std.testing.expectEqual(@as(usize, 118), out_row);
+    try std.testing.expectEqualSlices(u8, "TFRD", std.mem.asBytes(&std.mem.nativeToLittle(u32, magic)));
+    try std.testing.expect(cand <= @import("cuda").route_rows.most_picks and wt.experts_n <= std.math.maxInt(u16));
+}
+
+test "a dump keeps one layer count: a pass over another model's layers is refused" {
+    var st: State = .{ .file = null, .cap = std.math.maxInt(usize), .world = 2, .layers = wt.layers_n, .dev_rows = least_rows };
+    try std.testing.expectError(error.RouteDumpLayers, ensure(&st, undefined, 1, 8));
+}
+
+test "the tally counts distinct experts a layer, the busier rank half's and moved top picks" {
+    stats = .{};
+    defer stats = .{};
+    var picks: [2 * slots]u32 = @splat(wt.experts_n);
+    var ids: [2 * cand]u32 = @splat(0);
+    for (0..picks_n) |k| {
+        picks[k] = @intCast(k);
+        picks[slots + k] = @intCast(300 + k);
+        ids[k] = @intCast(k);
+        ids[cand + k] = @intCast(k + 1);
+    }
+    tally(&picks, &ids, 2);
+    try std.testing.expectEqual(@as(u64, 20), stats.actual);
+    try std.testing.expectEqual(@as(u64, 11), stats.natural);
+    try std.testing.expectEqual(@as(u64, 10), stats.actual_rank);
+    try std.testing.expectEqual(@as(u64, 11), stats.natural_rank);
+    try std.testing.expectEqual(@as(u64, 1), stats.top_moved);
+}
