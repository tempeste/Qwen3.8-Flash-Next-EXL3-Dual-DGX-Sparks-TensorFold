+pub const DraftDump = struct { path: [:0]const u8, cap_bytes: u64 };
+
+pub const draft_dump_default_mib: u64 = 256;
+pub const draft_dump_most_mib: u64 = 16384;
+
+pub fn draftDump() error{ BadDraftDump, BadDraftDumpCap }!?DraftDump {
+    const path: ?[:0]const u8 = if (std.c.getenv("TF_FLASHNEXT_DRAFT_DUMP")) |v| std.mem.span(v) else null;
+    const cap: ?[]const u8 = if (std.c.getenv("TF_FLASHNEXT_DRAFT_DUMP_MIB")) |v| std.mem.span(v) else null;
+    return draftDumpSetting(path, cap);
+}
+
+pub fn draftDumpSetting(path: ?[:0]const u8, cap: ?[]const u8) error{ BadDraftDump, BadDraftDumpCap }!?DraftDump {
+    const p = path orelse {
+        if (cap != null) return error.BadDraftDumpCap;
+        return null;
+    };
+    if (p.len < 2 or p.len > 1023 or p[0] != '/' or p[p.len - 1] == '/') return error.BadDraftDump;
+    for (p) |c| if (c < 0x21 or c == 0x7f) return error.BadDraftDump;
+    var mib = draft_dump_default_mib;
+    if (cap) |c| {
+        if (c.len == 0 or c.len > 5 or c[0] == '0') return error.BadDraftDumpCap;
+        for (c) |d| if (d < '0' or d > '9') return error.BadDraftDumpCap;
+        mib = std.fmt.parseInt(u64, c, 10) catch return error.BadDraftDumpCap;
+        if (mib > draft_dump_most_mib) return error.BadDraftDumpCap;
+    }
+    return .{ .path = p, .cap_bytes = mib << 20 };
+}
