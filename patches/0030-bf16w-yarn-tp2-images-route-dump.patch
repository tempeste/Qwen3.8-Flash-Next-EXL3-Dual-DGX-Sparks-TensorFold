+pub fn mixedBesideMostSetting(value: ?[]const u8) error{BadMixedBesideMost}!usize {
+    const v = value orelse return 0;
+    if (v.len == 0 or v[0] == '+') return error.BadMixedBesideMost;
+    const n = std.fmt.parseInt(usize, v, 10) catch return error.BadMixedBesideMost;
+    if (n > mixed_beside_most_cap) return error.BadMixedBesideMost;
+    return n;
+}
+
+pub fn mixedBesideWholeFits(whole: bool, beside: bool) bool {
+    return !whole or beside;
+}
+
+pub fn mixedBesideMostFits(most: usize, beside: bool) bool {
+    return most == 0 or beside;
+}
+
+pub const BesideSms = union(enum) {
+    off,
+    count: u32,
+    share: struct { num: u32, den: u32 },
+
+    pub fn on(x: BesideSms) bool {
+        return x != .off;
+    }
+
+    pub fn of(x: BesideSms, total: u32) ?u32 {
+        const n: u32 = switch (x) {
+            .off => return null,
+            .count => |c| c,
+            .share => |f| @intCast((@as(u64, total) * f.num + f.den - 1) / f.den),
+        };
+        if (n == 0 or n >= total) return null;
+        return n;
+    }
+};
+
+pub const mixed_beside_sms_cap: u32 = 1024;
+
+pub fn mixedBesideSms() error{BadMixedBesideSms}!BesideSms {
+    return mixedBesideSmsSetting(if (std.c.getenv("TF_FLASHNEXT_MIXED_BESIDE_SMS")) |v| std.mem.span(v) else null);
+}
+
+pub fn mixedBesideSmsSetting(value: ?[]const u8) error{BadMixedBesideSms}!BesideSms {
+    const v = value orelse return .off;
+    if (std.mem.indexOfScalar(u8, v, '/')) |slash| {
+        const num = besideSmsPart(v[0..slash]) orelse return error.BadMixedBesideSms;
+        const den = besideSmsPart(v[slash + 1 ..]) orelse return error.BadMixedBesideSms;
+        if (num == 0 or num >= den) return error.BadMixedBesideSms;
+        return .{ .share = .{ .num = num, .den = den } };
+    }
+    const n = besideSmsPart(v) orelse return error.BadMixedBesideSms;
+    return if (n == 0) .off else .{ .count = n };
+}
+
+fn besideSmsPart(v: []const u8) ?u32 {
+    if (v.len == 0 or v[0] == '+') return null;
+    const n = std.fmt.parseInt(u32, v, 10) catch return null;
+    return if (n > mixed_beside_sms_cap) null else n;
+}
+
+pub fn mixedBesideSmsFits(sms: BesideSms, beside: bool) bool {
+    return !sms.on() or beside;
+}
