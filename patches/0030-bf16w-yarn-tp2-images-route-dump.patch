diff --git a/zig/tests/cuda/flashnext_reroute_tests.zig b/zig/tests/cuda/flashnext_reroute_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7b07d8ca81da6fbfce051fcd896779dce9e83848
--- /dev/null
+++ b/zig/tests/cuda/flashnext_reroute_tests.zig
@@ -0,0 +1,463 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const env = @import("sys").env;
+const Session = flash.rank_engine.Session;
+const reroute = flash.expert_reroute;
+const dump = flash.route_dump;
+
+const knob = "TF_FLASHNEXT_EXPERT_REROUTE";
+const context = 4096;
+const max_streams = 32;
+const depth = mtp.default_depth;
+const warm_rounds = 5;
+const row = prompt.vocabulary * 2;
+const ne = 512;
+const nl = ne + 1;
+const slots = 11;
+const top = 10;
+
+pub fn kernel(gpu: check.Gpu, rows: usize, k0: usize, kp: usize) !void {
+    if (rows == 0 or rows > 1024) return error.BadRows;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var rr = try cuda.route_rows.RouteRows.load(gpu.d);
+    defer rr.unload();
+    const gpa = gpu.gpa;
+    const logits = try gpa.alloc(f32, rows * nl);
+    defer gpa.free(logits);
+    var prng = std.Random.DefaultPrng.init(3970);
+    const rnd = prng.random();
+    const hot = try gpa.alloc(f32, ne);
+    defer gpa.free(hot);
+    for (hot) |*h| h.* = @floatCast(rnd.floatNorm(f64) * 1.5);
+    for (0..rows) |r| for (0..nl) |e| {
+        logits[r * nl + e] = if (e < ne) hot[e] + @as(f32, @floatCast(rnd.floatNorm(f64) * 2.0)) else @floatCast(rnd.floatNorm(f64));
+    };
+    for (0..rows / 8) |r| logits[r * nl + 3] = logits[r * nl + 7];
+    var l = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(logits));
+    defer l.free();
+    var picks = try cuda.DeviceBuffer.alloc(gpu.d, rows * slots * 4);
+    defer picks.free();
+    var wts = try cuda.DeviceBuffer.alloc(gpu.d, rows * slots * 4);
+    defer wts.free();
+    var core = try cuda.DeviceBuffer.alloc(gpu.d, rows * slots * 4);
+    defer core.free();
+    var cands = try cuda.DeviceBuffer.alloc(gpu.d, rows * kp * 4);
+    defer cands.free();
+    var cw = try cuda.DeviceBuffer.alloc(gpu.d, rows * kp * 4);
+    defer cw.free();
+    try rr.topk(stream, l.ptr, nl, ne, top, picks.ptr, wts.ptr, slots, rows, true);
+    try rr.topk(stream, l.ptr, nl, ne, kp, cands.ptr, cw.ptr, kp, rows, false);
+    try stream.synchronize();
+    const p0 = try check.download(gpu, picks);
+    defer gpa.free(p0);
+    const w0 = try check.download(gpu, wts);
+    defer gpa.free(w0);
+    const ranked = try check.download(gpu, cands);
+    defer gpa.free(ranked);
+    try gpu.d.check(gpu.d.api.cuMemcpyDtoD_v2(core.ptr, picks.ptr, rows * slots * 4), "cuMemcpyDtoD");
+    try rr.reroute(stream, l.ptr, nl, ne, top, k0, kp, core.ptr, picks.ptr, wts.ptr, slots, rows);
+    try stream.synchronize();
+    const p1 = try check.download(gpu, picks);
+    defer gpa.free(p1);
+    const w1 = try check.download(gpu, wts);
+    defer gpa.free(w1);
+    const pk0: []const u32 = @alignCast(std.mem.bytesAsSlice(u32, p0));
+    const pk1: []const u32 = @alignCast(std.mem.bytesAsSlice(u32, p1));
+    const wt0: []const f32 = @alignCast(std.mem.bytesAsSlice(f32, w0));
+    const wt1: []const f32 = @alignCast(std.mem.bytesAsSlice(f32, w1));
+    const rk: []const u32 = @alignCast(std.mem.bytesAsSlice(u32, ranked));
+    const host_core = reroute.coreOf(pk0, slots, k0);
+    var same: usize = 0;
+    var moved: usize = 0;
+    var worst: f64 = 0;
+    var nat: std.StaticBitSet(ne) = .empty;
+    var act: std.StaticBitSet(ne) = .empty;
+    for (0..rows) |r| {
+        var want: [top]u32 = undefined;
+        var rank_ids: [32]u32 = undefined;
+        for (0..kp) |k| rank_ids[k] = rk[r * kp + k];
+        const got = reroute.choose(rank_ids[0..kp], &host_core, k0, top, &want);
+        const p = pk1[r * slots ..][0..slots];
+        try check.expect(std.mem.eql(u32, got, p[0..top]), "row {d}: the kernel's picks differ from the host rule", .{r});
+        try check.expect(p[0] == pk0[r * slots] and p[top] == ne, "row {d}: the top pick or the shared slot moved", .{r});
+        try check.expect(wt1[r * slots + top] == wt0[r * slots + top], "row {d}: the shared weight moved", .{r});
+        for (0..top) |k| {
+            nat.set(pk0[r * slots + k]);
+            act.set(p[k]);
+        }
+        if (std.mem.eql(u32, p[0..top], pk0[r * slots ..][0..top])) {
+            same += 1;
+            try check.expect(std.mem.eql(u8, std.mem.sliceAsBytes(wt1[r * slots ..][0..slots]), std.mem.sliceAsBytes(wt0[r * slots ..][0..slots])), "row {d}: unchanged picks with other weight bits", .{r});
+            continue;
+        }
+        moved += 1;
+        const lg = logits[r * nl ..][0..nl];
+        var total: f64 = 0;
+        for (p[0..top]) |e| total += @exp(@as(f64, lg[e]) - lg[p[0]]);
+        for (p[0..top], 0..) |e, k| {
+            const w = @exp(@as(f64, lg[e]) - lg[p[0]]) / total;
+            worst = @max(worst, @abs(wt1[r * slots + k] - w) / w);
+        }
+    }
+    try check.expect(worst < 1.0 / 128.0, "a re-routed weight is {d:.5} off its renormalised value", .{worst});
+    check.pass("re-route kernel at {d} rows, K0 {d}, KP {d}: picks equal the host rule, top and shared slots kept, {d} unchanged rows byte-equal to tf_route_topk, {d} re-routed rows' weights within {d:.5} of the renormalised softmax; distinct experts {d} -> {d}", .{ rows, k0, kp, same, moved, worst, nat.count(), act.count() });
+}
+
+const Lane = struct {
+    q: prompt.Seq,
+    d: mtp.Draft,
+    chain: mtp.Chain = .{},
+    follow: [mtp.max_rows]u32 = undefined,
+    nf: usize = 0,
+    fresh: bool = true,
+    window: [mtp.max_rows]u32 = undefined,
+    nw: usize = 0,
+};
+
+const Record = struct {
+    tokens: [max_streams]std.ArrayList(u32) = @splat(.empty),
+    digests: std.ArrayList(u64) = .empty,
+    first: []u8 = &.{},
+    windows: [max_streams][mtp.max_rows]u32 = undefined,
+    nws: [max_streams]usize = @splat(0),
+    ms: f64 = 0,
+    stats: dump.Stats = .{},
+    rerouted: u64 = 0,
+
+    fn deinit(rec: *Record, gpa: std.mem.Allocator) void {
+        for (&rec.tokens) |*t| t.deinit(gpa);
+        rec.digests.deinit(gpa);
+        if (rec.first.len > 0) gpa.free(rec.first);
+    }
+};
+
+const Arm = struct { name: []const u8, value: ?[]const u8, stats: bool };
+
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: *Session,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+    out: cuda.DeviceBuffer,
+    host: []u8,
+    identity: flash.rank_engine.Identity,
+    rank: usize,
+    port: u16,
+    opened: u16 = 0,
+
+    fn setArm(r: *Rig, a: Arm) !void {
+        var buf: [64]u8 = undefined;
+        if (a.value) |v| {
+            const z = try std.mem.printSentinel(&buf, "{s}", .{v}, 0);
+            _ = env.setenv(knob, z, 1);
+        } else _ = env.unsetenv(knob);
+        try reroute.configure();
+        reroute.rounds = 0;
+        if (a.stats and r.rank == 0) dump.startStats(2) else dump.close();
+    }
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, first: Arm) !void {
+        _ = env.setenv("TF_FLASHNEXT_TP_KEEP_BATCH", "1", 1);
+        _ = env.setenv("TF_FLASHNEXT_KEEP_LANES", "1", 1);
+        r.gpu = gpu;
+        r.rank = rank;
+        r.port = port;
+        r.opened = 0;
+        r.head = null;
+        try r.setArm(first);
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        const window = try flash.index_window.wanted();
+        r.identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        r.identity.mtp = 1;
+        r.identity.kv_cache = @intFromEnum(flash.kv_format.Kv.nvfp4);
+        r.identity.index_window = @intFromBool(window);
+        r.session = try Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, r.identity, flash.rank_engine.linkWait());
+        r.e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank) catch |err| {
+            r.session.poison();
+            r.session.deinit();
+            return err;
+        };
+        errdefer {
+            r.session.poison();
+            r.session.deinit();
+            r.e.deinit();
+        }
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        r.e.kv = .nvfp4;
+        r.e.index_window = if (window) flash.index_window.rows(r.e.chunk) else 0;
+        try r.attach();
+        _ = try r.e.reserve(@min(context, r.e.chunk));
+        r.out = try cuda.DeviceBuffer.alloc(gpu.d, max_streams * mtp.max_rows * row);
+        errdefer r.out.free();
+        r.host = try gpu.gpa.alloc(u8, max_streams * mtp.max_rows * row);
+        errdefer gpu.gpa.free(r.host);
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    fn attach(r: *Rig) !void {
+        r.session.engine = r.e;
+        r.e.collective = &r.session.collective;
+        if (flash.knobs.tpRoce()) try r.session.collective.openRoce(r.gpu.gpa, r.gpu.io, r.gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    }
+
+    fn next(r: *Rig, a: Arm) !void {
+        if (r.rank == 1) try r.session.follow(flash.Tri, r.tri(), r.out.ptr);
+        try r.stream.synchronize();
+        r.session.deinit();
+        try r.setArm(a);
+        r.opened += 1;
+        r.session = try Session.init(r.gpu.gpa, r.gpu.io, @import("flashnext_rank_tests.zig").rankHost(), r.port + r.opened, r.rank, r.identity, flash.rank_engine.linkWait());
+        try r.attach();
+    }
+
+    fn deinit(r: *Rig) void {
+        if (r.rank == 1) r.session.follow(flash.Tri, r.tri(), r.out.ptr) catch {};
+        r.session.deinit();
+        _ = env.unsetenv(knob);
+        reroute.rule = null;
+        dump.close();
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.gpu.gpa.free(r.host);
+        r.out.free();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback, .rollback_many = rollbackMany } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+    fn rollbackMany(p: *anyopaque, qs: []const *prompt.Seq, ds: []const *mtp.Draft, keeps: []const usize) anyerror!void {
+        const r = of(p);
+        return r.session.keepMany(flash.Tri, r.tri(), qs, ds, keeps);
+    }
+};
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+fn best(bytes: []const u8) u32 {
+    const v = std.mem.bytesAsSlice(u16, bytes);
+    var at: usize = 0;
+    var hi = -std.math.inf(f32);
+    for (v, 0..) |x, i| {
+        const f = bf16(x);
+        if (f > hi) {
+            hi = f;
+            at = i;
+        }
+    }
+    return @intCast(at);
+}
+
+fn seedOf(gpu: check.Gpu, ids_path: []const u8) !std.ArrayList(u32) {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    errdefer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len < 16) return error.BadPrompt;
+    return seed;
+}
+
+fn decode(r: *Rig, seed: []const u32, n: usize, rounds: usize, rec: *Record) !void {
+    const gpa = r.gpu.gpa;
+    const s = r.session;
+    const ops = r.ops();
+    var lanes: [max_streams]Lane = undefined;
+    var made: usize = 0;
+    defer for (lanes[0..made]) |*l| {
+        l.d.deinit();
+        s.drop(&l.q);
+    };
+    var ids: [96]u32 = undefined;
+    for (0..n) |i| {
+        const l = &lanes[i];
+        l.* = .{ .q = try s.create(context), .d = undefined };
+        l.d = mtp.Draft.init(gpa, r.e.driver, r.stream, context, r.head.?.ids.len, r.e.chunk, r.e.heads) catch |err| {
+            s.drop(&l.q);
+            return err;
+        };
+        made += 1;
+        const len = 40 + (i * 11) % 48;
+        for (ids[0..len], 0..) |*t, j| t.* = seed[(i * 31 + j * 7) % seed.len];
+        try ops.prefill(&l.q, &l.d, ids[0..len]);
+        l.follow[0] = best(l.q.logits[0..row]);
+        l.nf = 1;
+        try rec.tokens[i].append(gpa, l.follow[0]);
+    }
+    var qs: [max_streams]*prompt.Seq = undefined;
+    var ds: [max_streams]*mtp.Draft = undefined;
+    var nexts: [max_streams][]const u32 = undefined;
+    var rows: [max_streams]u64 = undefined;
+    var counts: [max_streams]usize = undefined;
+    var positions: [max_streams]u64 = undefined;
+    var sms: [max_streams]?mtp.Sampling = @splat(null);
+    var outs: [max_streams]*mtp.Chain = undefined;
+    var idss: [max_streams][]const u32 = undefined;
+    var keeps: [max_streams]usize = undefined;
+    var total: i96 = 0;
+    for (0..rounds) |round| {
+        const t0 = check.now(r.gpu.io);
+        for (lanes[0..n], 0..) |*l, i| {
+            qs[i] = &l.q;
+            ds[i] = &l.d;
+            nexts[i] = l.follow[0..l.nf];
+            rows[i] = if (l.fresh) l.d.prompt_last else l.d.streams.ptr;
+            counts[i] = @min(depth, l.q.cap - l.q.fed - 1);
+            positions[i] = l.q.fed + 1;
+            outs[i] = &l.chain;
+        }
+        try ops.draftMany(ds[0..n], nexts[0..n], rows[0..n], counts[0..n], positions[0..n], sms[0..n], mtp.default_confidence, outs[0..n], null);
+        var total_rows: usize = 0;
+        for (lanes[0..n], 0..) |*l, i| {
+            l.window[0] = l.follow[l.nf - 1];
+            @memcpy(l.window[1..][0..l.chain.n], l.chain.slice());
+            l.nw = 1 + l.chain.n;
+            idss[i] = l.window[0..l.nw];
+            total_rows += l.nw;
+            if (round == 0) {
+                rec.windows[i] = l.window;
+                rec.nws[i] = l.nw;
+            }
+        }
+        try s.verifyMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], idss[0..n], r.out.ptr);
+        try r.stream.synchronize();
+        const scores = r.host[0 .. total_rows * row];
+        try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoH_v2(scores.ptr, r.out.ptr, scores.len), "cuMemcpyDtoH");
+        try rec.digests.append(gpa, std.hash.Wyhash.hash(round, scores));
+        if (round == 0) rec.first = try gpa.dupe(u8, scores);
+        var at: usize = 0;
+        for (lanes[0..n], 0..) |*l, i| {
+            var kept: usize = 0;
+            while (true) {
+                const g = best(scores[(at + kept) * row ..][0..row]);
+                l.follow[kept] = g;
+                try rec.tokens[i].append(gpa, g);
+                kept += 1;
+                if (kept == l.nw or l.window[kept] != g) break;
+            }
+            at += l.nw;
+            l.nf = kept;
+            l.fresh = false;
+            keeps[i] = kept;
+        }
+        try s.keepMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], keeps[0..n]);
+        if (round >= warm_rounds) total += check.now(r.gpu.io) - t0;
+    }
+    try r.stream.synchronize();
+    rec.ms = @as(f64, @floatFromInt(total)) / 1e6 / @as(f64, @floatFromInt(rounds - warm_rounds));
+    rec.stats = dump.stats;
+    rec.rerouted = reroute.rounds;
+}
+
+fn sameRun(a: *const Record, b: *const Record, n: usize, what: []const u8) !void {
+    try check.expect(a.digests.items.len == b.digests.items.len, "{s}: {d} rounds against {d}", .{ what, b.digests.items.len, a.digests.items.len });
+    for (a.digests.items, b.digests.items, 0..) |x, y, round| try check.expect(x == y, "{s}: round {d}'s scores differ from flag off", .{ what, round });
+    for (a.tokens[0..n], b.tokens[0..n], 0..) |x, y, i| {
+        const first = std.mem.indexOfDiff(u32, x.items, y.items);
+        try check.expect(first == null, "{s}: stream {d}'s tokens differ from token {?d}", .{ what, i, first });
+    }
+}
+
+fn perLayer(st: dump.Stats, v: u64) f64 {
+    return @as(f64, @floatFromInt(v)) / @as(f64, @floatFromInt(@max(st.layers, 1)));
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, n: usize, rounds: usize, k0: usize, kp: usize) !void {
+    if (rounds <= warm_rounds or n < 2 or n > max_streams) return error.BadRounds;
+    var seed = try seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var under_buf: [32]u8 = undefined;
+    var full_buf: [32]u8 = undefined;
+    const arms = [_]Arm{
+        .{ .name = "off", .value = null, .stats = false },
+        .{ .name = "dump", .value = null, .stats = true },
+        .{ .name = "under-min", .value = try std.fmt.bufPrint(&under_buf, "{d},{d},{d}", .{ k0, kp, n + 1 }), .stats = true },
+        .{ .name = "full", .value = try std.fmt.bufPrint(&full_buf, "{d},{d},2", .{ k0, kp }), .stats = true },
+    };
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, arms[0]);
+    defer r.deinit();
+    var recs: [arms.len]Record = @splat(.{});
+    defer for (&recs) |*x| x.deinit(gpu.gpa);
+    for (arms, 0..) |a, i| {
+        if (i > 0) try r.next(a);
+        if (rank == 0) try decode(&r, seed.items, n, rounds, &recs[i]);
+    }
+    if (rank == 1) return check.pass("rank 1 followed the {d} sessions", .{arms.len});
+    try sameRun(&recs[0], &recs[1], n, "route dump on");
+    try sameRun(&recs[0], &recs[2], n, "re-route under MIN");
+    try check.expect(recs[2].rerouted == 0, "under MIN: {d} rounds were re-routed", .{recs[2].rerouted});
+    try check.expect(recs[3].rerouted == rounds, "full batch: {d} of {d} rounds were re-routed", .{ recs[3].rerouted, rounds });
+    try check.expect(recs[1].stats.natural == recs[1].stats.actual and recs[1].stats.top_moved == 0, "flag off: the dump's picks differ from its natural top ten", .{});
+    try check.expect(recs[3].stats.top_moved == 0, "full batch: {d} rows changed their top expert", .{recs[3].stats.top_moved});
+    check.pass("{d} streams, {d} rounds: the dump on and the re-route under MIN ({d} streams) are byte-equal to flag off in every round's scores and every token", .{ n, rounds, n + 1 });
+    const off = &recs[0];
+    const full = &recs[3];
+    var same_window = true;
+    for (0..n) |i| same_window = same_window and off.nws[i] == full.nws[i] and std.mem.eql(u32, off.windows[i][0..off.nws[i]], full.windows[i][0..full.nws[i]]);
+    try check.expect(same_window and off.first.len == full.first.len, "the first round's windows differ between the arms", .{});
+    var largest: f64 = 0;
+    var sum: f64 = 0;
+    var count: usize = 0;
+    var flips: usize = 0;
+    const rows_n = off.first.len / row;
+    for (0..rows_n) |x| {
+        const a = std.mem.bytesAsSlice(u16, off.first[x * row ..][0..row]);
+        const b = std.mem.bytesAsSlice(u16, full.first[x * row ..][0..row]);
+        for (a, b) |u, v| {
+            const d: f64 = @abs(@as(f64, bf16(u)) - bf16(v));
+            largest = @max(largest, d);
+            sum += d;
+            count += 1;
+        }
+        if (best(off.first[x * row ..][0..row]) != best(full.first[x * row ..][0..row])) flips += 1;
+    }
+    var same_streams: usize = 0;
+    var first_split: usize = std.math.maxInt(usize);
+    for (off.tokens[0..n], full.tokens[0..n]) |x, y| {
+        const d = std.mem.indexOfDiff(u32, x.items, y.items);
+        if (d == null) same_streams += 1 else first_split = @min(first_split, d.?);
+    }
+    const s1 = recs[1].stats;
+    const s3 = full.stats;
+    std.debug.print("RESULT flashnext-reroute K0 {d} KP {d} streams {d}: distinct experts a layer {d:.1} -> {d:.1} (busier rank half {d:.1} -> {d:.1}); rows a round {d:.1}\n", .{ k0, kp, n, perLayer(s3, s3.natural), perLayer(s3, s3.actual), perLayer(s3, s3.natural_rank), perLayer(s3, s3.actual_rank), @as(f64, @floatFromInt(s3.rows)) / @as(f64, @floatFromInt(@max(s3.layers, 1))) });
+    std.debug.print("RESULT flashnext-reroute flag-off distinct experts a layer {d:.1} (busier rank half {d:.1})\n", .{ perLayer(s1, s1.natural), perLayer(s1, s1.natural_rank) });
+    std.debug.print("RESULT flashnext-reroute first round, {d} rows: largest score change {d:.4}, mean {d:.6}, argmax changed on {d} rows ({d:.2}%)\n", .{ rows_n, largest, sum / @as(f64, @floatFromInt(@max(count, 1))), flips, 100.0 * @as(f64, @floatFromInt(flips)) / @as(f64, @floatFromInt(@max(rows_n, 1))) });
+    std.debug.print("RESULT flashnext-reroute {d} of {d} streams kept every token over {d} rounds; first split at token {d}\n", .{ same_streams, n, rounds, if (first_split == std.math.maxInt(usize)) 0 else first_split });
+    std.debug.print("BENCH flashnext-reroute streams={d} rounds={d} off_ms={d:.2} full_ms={d:.2}\n", .{ n, rounds - warm_rounds, off.ms, full.ms });
+}
diff --git a/zig/tests/cuda/flashnext_yarn_long_tests.zig b/zig/tests/cuda/flashnext_yarn_long_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6b9c4540fa8af94ba42a50de8187b45b2213e407
--- /dev/null
+++ b/zig/tests/cuda/flashnext_yarn_long_tests.zig
@@ -0,0 +1,185 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+
+const row = prompt.vocabulary * 2;
+
+fn getenv(name: [*:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+}
+
+fn labelOk(label: []const u8) bool {
+    if (label.len == 0 or label.len > 64) return false;
+    for (label) |c| if (!std.ascii.isAlphanumeric(c) and c != '-' and c != '_') return false;
+    return true;
+}
+
+pub fn contexts(gpa: std.mem.Allocator, text: ?[]const u8) !std.ArrayList(usize) {
+    var out: std.ArrayList(usize) = .empty;
+    errdefer out.deinit(gpa);
+    var parts = std.mem.tokenizeScalar(u8, text orelse "300000", ',');
+    while (parts.next()) |p| {
+        const c = std.fmt.parseInt(usize, p, 10) catch return error.BadContexts;
+        if (c == 0) return error.BadContexts;
+        try out.append(gpa, c);
+    }
+    if (out.items.len == 0) return error.BadContexts;
+    return out;
+}
+
+pub fn greedy(scores: []const u8) u32 {
+    var best: u32 = 0;
+    var top = -std.math.inf(f32);
+    for (0..scores.len / 2) |i| {
+        const bits: u32 = std.mem.readInt(u16, scores[2 * i ..][0..2], .little);
+        const v: f32 = @bitCast(bits << 16);
+        if (v > top) {
+            top = v;
+            best = @intCast(i);
+        }
+    }
+    return best;
+}
+
+fn readIds(gpu: check.Gpu, path: []const u8) !std.ArrayList(u32) {
+    const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, path, gpu.gpa, .limited(1 << 26));
+    defer gpu.gpa.free(text);
+    var ids: std.ArrayList(u32) = .empty;
+    errdefer ids.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, text, " \r\n\t");
+    while (words.next()) |w| {
+        const id = try std.fmt.parseInt(u32, w, 10);
+        if (id >= prompt.vocabulary) return error.InvalidToken;
+        try ids.append(gpu.gpa, id);
+    }
+    if (ids.items.len == 0) return error.BadPrompt;
+    return ids;
+}
+
+const Arm = struct {
+    gpu: check.Gpu,
+    e: *prompt.Engine,
+    session: ?*flash.rank_engine.Session,
+    tri: flash.Tri,
+
+    fn create(a: Arm, cap: usize) !prompt.Seq {
+        return if (a.session) |s| s.create(cap) else a.e.newSeq(cap);
+    }
+
+    fn drop(a: Arm, q: *prompt.Seq) void {
+        if (a.session) |s| s.drop(q) else q.deinit(a.gpu.gpa);
+    }
+
+    fn forward(a: Arm, q: *prompt.Seq, ids: []const u32) !void {
+        if (a.session) |s| return s.forward(flash.Tri, a.tri, q, ids, .{});
+        return a.e.forward(flash.Tri, a.tri, q, ids, .{});
+    }
+};
+
+fn one(a: Arm, seed: []const u32, c: usize, piece: usize, steps: usize, out: []const u8, label: []const u8) !void {
+    const gpa = a.gpu.gpa;
+    const ids = try gpa.alloc(u32, c);
+    defer gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed[i % seed.len];
+    const cap = c + steps + flash.mtp.max_rows;
+    var q = try a.create(cap);
+    defer a.drop(&q);
+    const rows = try gpa.alloc(u8, (steps + 1) * row);
+    defer gpa.free(rows);
+    const tokens = try gpa.alloc(u32, steps);
+    defer gpa.free(tokens);
+    const t0 = std.Io.Clock.awake.now(a.gpu.io).toNanoseconds();
+    var at: usize = 0;
+    while (at < c) : (at += piece) try a.forward(&q, ids[at..@min(c, at + piece)]);
+    const prefill_ns = std.Io.Clock.awake.now(a.gpu.io).toNanoseconds() - t0;
+    @memcpy(rows[0..row], q.logits);
+    for (0..steps) |i| {
+        tokens[i] = greedy(rows[i * row ..][0..row]);
+        try a.forward(&q, &.{tokens[i]});
+        @memcpy(rows[(i + 1) * row ..][0..row], q.logits);
+    }
+    const name = try std.fmt.allocPrint(gpa, "{s}-{d}.bf16", .{ label, c });
+    defer gpa.free(name);
+    const path = try std.fs.path.join(gpa, &.{ out, name });
+    defer gpa.free(path);
+    try std.Io.Dir.cwd().writeFile(a.gpu.io, .{ .sub_path = path, .data = rows });
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(rows, &digest, .{});
+    const hex = std.fmt.bytesToHex(digest, .lower);
+    const secs = @as(f64, @floatFromInt(prefill_ns)) / 1e9;
+    std.debug.print("RESULT flashnext-yarn-long {s} context {d} rope {s} served {d}: prefill {d:.1} s ({d:.0} tok/s in pieces of {d}), {d} greedy rows sha256 {s} tokens", .{ label, c, if (flash.rope_config.engine().yarn != null) "yarn" else "plain", prompt.maxTokens(), secs, @as(f64, @floatFromInt(c)) / secs, piece, steps + 1, &hex });
+    for (tokens) |tk| std.debug.print(" {d}", .{tk});
+    std.debug.print("\n", .{});
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank_arg: []const u8, port: u16, ids_path: []const u8, out: []const u8, label: []const u8) !void {
+    if (!labelOk(label)) return error.BadLabel;
+    var seed = try readIds(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var cs = try contexts(gpu.gpa, getenv("TF_YARN_LONG_CONTEXTS"));
+    defer cs.deinit(gpu.gpa);
+    const steps = if (getenv("TF_YARN_LONG_STEPS")) |v| try std.fmt.parseInt(usize, v, 10) else 16;
+    const piece = if (getenv("TF_YARN_LONG_PIECE")) |v| try std.fmt.parseInt(usize, v, 10) else 1536;
+    var most: usize = 0;
+    for (cs.items) |c| most = @max(most, c + steps + flash.mtp.max_rows);
+    if (most > prompt.maxTokens() or piece == 0) return error.BadPrompt;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const solo = std.mem.eql(u8, rank_arg, "solo");
+    if (solo) {
+        const e = try prompt.Engine.init(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+        defer e.deinit();
+        if (piece > e.chunk) return error.BadPrompt;
+        const a: Arm = .{ .gpu = gpu, .e = e, .session = null, .tri = tri };
+        for (cs.items) |c| try one(a, seed.items, c, piece, steps, out, label);
+        check.pass("flashnext-yarn-long solo: {d} contexts", .{cs.items.len});
+        return;
+    }
+    const rank = try std.fmt.parseInt(usize, rank_arg, 10);
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    if (piece > chunk) return error.BadPrompt;
+    const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, most, chunk);
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    if (rank == 1) {
+        var logits = try cuda.DeviceBuffer.alloc(gpu.d, prompt.vocabulary * 4);
+        defer logits.free();
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("flashnext-yarn-long rank 1 followed {d} contexts", .{cs.items.len});
+        return;
+    }
+    const a: Arm = .{ .gpu = gpu, .e = e, .session = session, .tri = tri };
+    for (cs.items) |c| try one(a, seed.items, c, piece, steps, out, label);
+    check.pass("flashnext-yarn-long rank 0: {d} contexts", .{cs.items.len});
+}
+
+test "flashnext-yarn-long reads its contexts and draws the largest bf16 score" {
+    const gpa = std.testing.allocator;
+    var cs = try contexts(gpa, null);
+    defer cs.deinit(gpa);
+    try std.testing.expectEqualSlices(usize, &.{300000}, cs.items);
+    var two = try contexts(gpa, "200000,390000");
+    defer two.deinit(gpa);
+    try std.testing.expectEqualSlices(usize, &.{ 200000, 390000 }, two.items);
+    try std.testing.expectError(error.BadContexts, contexts(gpa, "0"));
+    try std.testing.expectError(error.BadContexts, contexts(gpa, "x"));
+    const scores = [_]u8{ 0x80, 0x3f, 0x00, 0x40, 0x00, 0xc0 };
+    try std.testing.expectEqual(@as(u32, 1), greedy(&scores));
+}
