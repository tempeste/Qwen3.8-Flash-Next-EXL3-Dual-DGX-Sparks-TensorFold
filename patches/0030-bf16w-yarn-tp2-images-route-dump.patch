@@ -0,0 +1,277 @@
+import argparse
+import sys
+
+import numpy as np
+
+MAGIC = b"TFVDUMP1"
+HEADER = 16
+RECORD = 32
+VERIFIED, LANDED, KNOWN, SAMPLED = 1, 2, 4, 8
+DEPTHS = 6
+CHUNK = 1 << 20
+
+DTYPE = np.dtype(
+    [
+        ("round", "<u4"),
+        ("stream", "<u4"),
+        ("depth", "u1"),
+        ("flags", "u1"),
+        ("streams", "u1"),
+        ("verified", "u1"),
+        ("prob", "<f4"),
+        ("top1", "<f4"),
+        ("top2", "<f4"),
+        ("rate", "<f4"),
+        ("tail", "<u4"),
+    ]
+)
+
+USAGE = """Fit a verify gate for Flash Next's MTP drafts from TF_FLASHNEXT_DRAFT_DUMP files.
+
+Each record is one drafted position of a head window in a shared round: the draft's shipped probability, the head's
+top-1 and top-2 probabilities, its depth, the stream's acceptance so far, whether the round verified it and whether it
+landed. A logistic regression on those features predicts P(draft lands | the drafts before it landed), fitted on the
+streams outside the held-out split. On the held-out split it prints drafts verified and accepted a round under:
+  current      the rows the engine verified;
+  shipped-cum  the same rows a round, given to the drafts with the highest running product of shipped probabilities;
+  fitted       the same rows a round, given to the drafts with the highest running product of the fitted chances;
+  fitted-tau   each window verifies while its fitted running chance is at least tau (tau chosen on the training split
+               for the most tokens a ms, with --row-ms and --round-ms);
+  perfect      every verified draft lands and no landing draft is left out.
+A rule can verify at most one draft past what the engine verified, the last draft whose outcome the dump knows, so
+rows a rule adds past it are never credited."""
+
+
+def load(paths):
+    parts = []
+    for path in paths:
+        with open(path, "rb") as f:
+            raw = f.read()
+        if raw[:8] != MAGIC or int.from_bytes(raw[8:12], "little") != RECORD:
+            sys.exit(f"{path}: not a draft dump (header {raw[:16]!r})")
+        body = raw[HEADER:]
+        parts.append(np.frombuffer(body[: len(body) // RECORD * RECORD], dtype=DTYPE))
+    return np.concatenate(parts) if parts else np.zeros(0, dtype=DTYPE)
+
+
+def windows(r):
+    start = r["depth"] == 0
+    win = np.cumsum(start) - 1
+    if len(r) and not start[0]:
+        sys.exit("the dump does not start at a window's first draft")
+    run = np.cumsum(np.r_[0, (np.diff(r["round"].astype(np.int64)) < 0).astype(np.int64)])
+    round_key = (run << 32) | r["round"].astype(np.int64)
+    return win, round_key
+
+
+def features(r):
+    p = np.clip(r["prob"].astype(np.float64), 1e-6, 1 - 1e-6)
+    has_top = r["top1"] >= 0
+    t1 = np.where(has_top, r["top1"], p).astype(np.float64)
+    t2 = np.where(has_top, r["top2"], 0).astype(np.float64)
+    rate = r["rate"].astype(np.float64)
+    known_rate = rate >= 0
+    fill = rate[known_rate].mean() if known_rate.any() else 0.5
+    cols = [
+        p,
+        np.log(p / (1 - p)),
+        t1 - t2,
+        np.log(np.clip(t1, 1e-6, 1)),
+        np.where(known_rate, rate, fill),
+        (~known_rate).astype(np.float64),
+        ((r["flags"] & SAMPLED) > 0).astype(np.float64),
+        np.log(np.maximum(r["streams"].astype(np.float64), 1)),
+    ]
+    depth = np.minimum(r["depth"], DEPTHS - 1)
+    cols += [(depth == d).astype(np.float64) for d in range(1, DEPTHS)]
+    return np.stack(cols, axis=1)
+
+
+def fit(x, y, l2, iters=40):
+    mu = x.mean(0)
+    sd = x.std(0)
+    sd[sd == 0] = 1
+    k = x.shape[1] + 1
+    w = np.zeros(k)
+    ridge = l2 * np.diag(np.r_[0.0, np.ones(k - 1)])
+    for _ in range(iters):
+        g = ridge @ w
+        h = ridge.copy()
+        for a in range(0, len(x), CHUNK):
+            z = np.hstack([np.ones((min(CHUNK, len(x) - a), 1)), (x[a : a + CHUNK] - mu) / sd])
+            q = 1 / (1 + np.exp(-(z @ w)))
+            g += z.T @ (q - y[a : a + CHUNK])
+            h += (z * (q * (1 - q))[:, None]).T @ z
+        step = np.linalg.solve(h, g)
+        w -= step
+        if np.abs(step).max() < 1e-9:
+            break
+    return w, mu, sd
+
+
+def predict(model, x):
+    w, mu, sd = model
+    out = np.empty(len(x))
+    for a in range(0, len(x), CHUNK):
+        z = np.hstack([np.ones((min(CHUNK, len(x) - a), 1)), (x[a : a + CHUNK] - mu) / sd])
+        out[a : a + CHUNK] = 1 / (1 + np.exp(-(z @ w)))
+    return out
+
+
+def auc(score, y):
+    order = np.argsort(score, kind="mergesort")
+    ranks = np.empty(len(score))
+    ranks[order] = np.arange(1, len(score) + 1)
+    pos = y > 0
+    n1, n0 = pos.sum(), (~pos).sum()
+    if n1 == 0 or n0 == 0:
+        return float("nan")
+    return (ranks[pos].sum() - n1 * (n1 + 1) / 2) / (n1 * n0)
+
+
+def logloss(q, y):
+    q = np.clip(q, 1e-6, 1 - 1e-6)
+    return float(-(y * np.log(q) + (1 - y) * np.log(1 - q)).mean())
+
+
+def calibration(name, q, y):
+    edges = np.linspace(0, 1, 11)
+    cells = []
+    for lo, hi in zip(edges[:-1], edges[1:]):
+        m = (q >= lo) & (q < hi if hi < 1 else q <= hi)
+        if m.sum():
+            cells.append(f"{lo:.1f}-{hi:.1f}: {q[m].mean():.3f}->{y[m].mean():.3f} ({m.sum()})")
+    print(f"  {name} predicted->landed by bin: " + "; ".join(cells))
+
+
+class Split:
+    def __init__(self, r, win, round_key, mask):
+        self.r = r[mask]
+        self.win_all = win[mask]
+        ids, self.win = np.unique(self.win_all, return_inverse=True)
+        first = np.r_[0, np.flatnonzero(np.diff(self.win)) + 1]
+        self.windows = len(ids)
+        self.v = self.r["verified"][first].astype(np.int64)
+        self.landed = (self.r["tail"][first] >> 24).astype(np.int64) - 1
+        self.n = np.bincount(self.win, minlength=self.windows)
+        at_v = (self.r["depth"].astype(np.int64) == self.v[self.win]) & ((self.r["flags"] & LANDED) > 0)
+        extra = np.zeros(self.windows, dtype=np.int64)
+        np.add.at(extra, self.win[at_v], 1)
+        self.true = np.where(self.landed < self.v, self.landed, self.v + extra)
+        rk = round_key[mask][first]
+        self.rounds_key, self.round = np.unique(rk, return_inverse=True)
+        self.rounds = len(self.rounds_key)
+        self.depth = self.r["depth"].astype(np.int64)
+        self.first = first
+
+    def cum(self, q):
+        lq = np.log(np.clip(q, 1e-12, 1))
+        c = np.cumsum(lq)
+        base = np.r_[0.0, c][self.first]
+        return np.exp(c - base[self.win])
+
+    def candidates(self):
+        return self.depth <= self.v[self.win]
+
+    def same_rows(self, score):
+        cand = self.candidates()
+        idx = np.flatnonzero(cand)
+        rec_round = self.round[self.win[idx]]
+        budget = np.bincount(self.round, weights=self.v, minlength=self.rounds).astype(np.int64)
+        order = np.lexsort((self.depth[idx], -score[idx], rec_round))
+        sorted_round = rec_round[order]
+        starts = np.r_[0, np.flatnonzero(np.diff(sorted_round)) + 1]
+        pos = np.arange(len(order)) - np.repeat(starts, np.diff(np.r_[starts, len(order)]))
+        take = pos < budget[sorted_round]
+        g = np.zeros(self.windows, dtype=np.int64)
+        np.add.at(g, self.win[idx[order[take]]], 1)
+        return g
+
+    def threshold(self, c, tau):
+        keep = self.candidates() & (c >= tau)
+        broken = np.cumsum(~keep)
+        base = np.r_[0, broken][self.first]
+        prefix = (broken - base[self.win]) == 0
+        g = np.zeros(self.windows, dtype=np.int64)
+        np.add.at(g, self.win[keep & prefix], 1)
+        return g
+
+    def score(self, g):
+        acc = np.minimum(g, self.true)
+        return g.sum() / self.rounds, acc.sum() / self.rounds
+
+
+def gain(rows0, acc0, rows, acc, windows_round, full_windows, row_ms, round_ms):
+    t0 = acc0 + windows_round
+    t = acc + windows_round
+    added = (rows - rows0) / windows_round * full_windows
+    return (t / t0) / ((round_ms + added * row_ms) / round_ms) - 1
+
+
+def main():
+    ap = argparse.ArgumentParser(description=USAGE, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("dumps", nargs="+", help="TF_FLASHNEXT_DRAFT_DUMP files (appended runs are fine)")
+    ap.add_argument("--holdout", type=int, default=5, help="one stream in N (by stream key) is held out (default 5)")
+    ap.add_argument("--row-ms", type=float, default=0.8, help="ms one more verified row adds to a round (default 0.8)")
+    ap.add_argument("--round-ms", type=float, default=295.5, help="ms of an average round (default 295.5)")
+    ap.add_argument("--min-streams", type=int, default=2, help="only rounds with at least this many streams")
+    ap.add_argument("--max-streams", type=int, default=255, help="only rounds with at most this many streams")
+    ap.add_argument("--l2", type=float, default=1e-2, help="ridge on the standardized weights (default 0.01)")
+    a = ap.parse_args()
+    r = load(a.dumps)
+    if len(r) == 0:
+        sys.exit("no records")
+    win, round_key = windows(r)
+    keep = (r["streams"] >= a.min_streams) & (r["streams"] <= a.max_streams)
+    held = (r["stream"] % a.holdout) == 0
+    has_top = (r["top1"] >= 0).mean()
+    print(f"records {len(r)}, windows {win.max() + 1}, with head top-1/top-2 {has_top:.1%}; rounds with {a.min_streams}-{a.max_streams} streams; held out: stream key % {a.holdout} == 0")
+    train = Split(r, win, round_key, keep & ~held)
+    test = Split(r, win, round_key, keep & held)
+    if train.windows == 0 or test.windows == 0:
+        sys.exit("a split is empty: more streams are needed")
+    x_tr = features(train.r)
+    cond_tr = ((train.r["flags"] & KNOWN) > 0) & (train.depth <= train.landed[train.win])
+    y_tr = ((train.r["flags"] & LANDED) > 0).astype(np.float64)
+    model = fit(x_tr[cond_tr], y_tr[cond_tr], a.l2)
+    q_tr = predict(model, x_tr)
+    x_te = features(test.r)
+    q_te = predict(model, x_te)
+    cond_te = ((test.r["flags"] & KNOWN) > 0) & (test.depth <= test.landed[test.win])
+    y_te = ((test.r["flags"] & LANDED) > 0).astype(np.float64)
+    names = ["const", "p", "logit p", "top1-top2", "log top1", "rate", "no rate", "sampled", "log streams"] + [f"depth {d}" for d in range(1, DEPTHS)]
+    print("weights (standardized): " + ", ".join(f"{n} {w:+.3f}" for n, w in zip(names, model[0])))
+    p_te = test.r["prob"].astype(np.float64)
+    print(f"held-out drafts whose earlier drafts landed: {int(cond_te.sum())}, landed {y_te[cond_te].mean():.3f}")
+    print(f"  shipped p: log loss {logloss(p_te[cond_te], y_te[cond_te]):.4f}, AUC {auc(p_te[cond_te], y_te[cond_te]):.4f}")
+    print(f"  fitted:    log loss {logloss(q_te[cond_te], y_te[cond_te]):.4f}, AUC {auc(q_te[cond_te], y_te[cond_te]):.4f}")
+    calibration("shipped p", p_te[cond_te], y_te[cond_te])
+    calibration("fitted", q_te[cond_te], y_te[cond_te])
+    full = len(np.unique(win[keep])) / len(np.unique(round_key[keep]))
+    c_tr = train.cum(q_tr)
+    rows0_tr, acc0_tr = train.score(train.v)
+    best = (-np.inf, 1.0)
+    for tau in np.linspace(0.0, 0.9, 91):
+        rows, acc = train.score(train.threshold(c_tr, tau))
+        gv = gain(rows0_tr, acc0_tr, rows, acc, train.windows / train.rounds, full, a.row_ms, a.round_ms)
+        if gv > best[0]:
+            best = (gv, tau)
+    tau = best[1]
+    wr = test.windows / test.rounds
+    rows0, acc0 = test.score(test.v)
+    rules = [
+        ("current", test.v),
+        ("shipped-cum", test.same_rows(test.cum(p_te))),
+        ("fitted", test.same_rows(test.cum(q_te))),
+        (f"fitted-tau {tau:.2f}", test.threshold(test.cum(q_te), tau)),
+        ("perfect", test.true),
+    ]
+    print(f"held-out: {test.rounds} rounds, {wr:.2f} held-out head windows a round of {full:.2f}; --row-ms {a.row_ms} --round-ms {a.round_ms}")
+    print(f"  {'rule':<16} {'drafts verified a round':>24} {'accepted a round':>17} {'accepted a draft':>17} {'decode vs current (estimate)':>29}")
+    for name, g in rules:
+        rows, acc = test.score(g)
+        print(f"  {name:<16} {rows:>24.3f} {acc:>17.3f} {acc / max(rows, 1e-9):>17.3f} {gain(rows0, acc0, rows, acc, wr, full, a.row_ms, a.round_ms):>+28.2%}")
+
+
+if __name__ == "__main__":
+    main()
