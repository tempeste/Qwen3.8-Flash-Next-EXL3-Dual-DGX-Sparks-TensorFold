diff --git a/zig/src/core/lanes/draft_dump.zig b/zig/src/core/lanes/draft_dump.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e1432fed3a5b25a5fe640b6eea193a6420b776fd
--- /dev/null
+++ b/zig/src/core/lanes/draft_dump.zig
@@ -0,0 +1,321 @@
+const std = @import("std");
+
+pub const Target = struct { path: [:0]const u8, cap_bytes: u64 };
+
+pub const most = 16;
+pub const record_bytes = 32;
+pub const magic = "TFVDUMP1";
+pub const header_bytes = 16;
+pub const version: u32 = 1;
+pub const buffer_bytes = 1 << 16;
+
+pub const verified_bit: u8 = 1;
+pub const landed_bit: u8 = 2;
+pub const known_bit: u8 = 4;
+pub const sampled_bit: u8 = 8;
+
+pub const Record = struct {
+    round: u32,
+    stream: u32,
+    depth: u8,
+    flags: u8,
+    streams: u8,
+    verified: u8,
+    prob: f32,
+    top1: f32,
+    top2: f32,
+    rate: f32,
+    drafted: u32,
+    kept: u32,
+
+    pub fn encode(r: Record, out: *[record_bytes]u8) void {
+        std.mem.writeInt(u32, out[0..4], r.round, .little);
+        std.mem.writeInt(u32, out[4..8], r.stream, .little);
+        out[8] = r.depth;
+        out[9] = r.flags;
+        out[10] = r.streams;
+        out[11] = r.verified;
+        std.mem.writeInt(u32, out[12..16], @bitCast(r.prob), .little);
+        std.mem.writeInt(u32, out[16..20], @bitCast(r.top1), .little);
+        std.mem.writeInt(u32, out[20..24], @bitCast(r.top2), .little);
+        std.mem.writeInt(u32, out[24..28], @bitCast(r.rate), .little);
+        std.mem.writeInt(u32, out[28..32], (r.drafted & 0xffffff) | (@as(u32, @min(r.kept, 255)) << 24), .little);
+    }
+
+    pub fn decode(in: *const [record_bytes]u8) Record {
+        const tail = std.mem.readInt(u32, in[28..32], .little);
+        return .{
+            .round = std.mem.readInt(u32, in[0..4], .little),
+            .stream = std.mem.readInt(u32, in[4..8], .little),
+            .depth = in[8],
+            .flags = in[9],
+            .streams = in[10],
+            .verified = in[11],
+            .prob = @bitCast(std.mem.readInt(u32, in[12..16], .little)),
+            .top1 = @bitCast(std.mem.readInt(u32, in[16..20], .little)),
+            .top2 = @bitCast(std.mem.readInt(u32, in[20..24], .little)),
+            .rate = @bitCast(std.mem.readInt(u32, in[24..28], .little)),
+            .drafted = tail & 0xffffff,
+            .kept = tail >> 24,
+        };
+    }
+};
+
+pub const Window = struct {
+    stream: *const anyopaque,
+    key: u32,
+    n: u8,
+    sampled: bool,
+    rate: f32,
+    drafted: u32,
+    tokens: [most]u32 = @splat(0),
+    probs: [most]f32 = @splat(0),
+    top1: [most]f32 = @splat(-1),
+    top2: [most]f32 = @splat(-1),
+};
+
+pub fn flagsOf(j: usize, verified: usize, landed: usize, bonus: ?u32, token: u32) u8 {
+    var f: u8 = 0;
+    if (j < verified) {
+        f |= verified_bit | known_bit;
+        if (j < landed) f |= landed_bit;
+        return f;
+    }
+    if (j == verified and landed == verified) if (bonus) |b| {
+        f |= known_bit;
+        if (b == token) f |= landed_bit;
+    };
+    return f;
+}
+
+pub fn records(w: *const Window, round: u32, streams: usize, verified: usize, got: []const u32, out: []Record) usize {
+    const landed = if (got.len > 0) got.len - 1 else 0;
+    const bonus: ?u32 = if (got.len > 0) got[got.len - 1] else null;
+    const n = @min(@as(usize, w.n), out.len);
+    for (out[0..n], 0..) |*r, j| {
+        var f = flagsOf(j, verified, landed, bonus, w.tokens[j]);
+        if (w.sampled) f |= sampled_bit;
+        r.* = .{
+            .round = round,
+            .stream = w.key,
+            .depth = @intCast(j),
+            .flags = f,
+            .streams = @intCast(@min(streams, 255)),
+            .verified = @intCast(@min(verified, 255)),
+            .prob = w.probs[j],
+            .top1 = w.top1[j],
+            .top2 = w.top2[j],
+            .rate = w.rate,
+            .drafted = w.drafted,
+            .kept = @intCast(got.len),
+        };
+    }
+    return n;
+}
+
+pub fn keyOf(serial: u32) u32 {
+    const k: u32 = @truncate(std.hash.Wyhash.hash(0x7466_7664, std.mem.asBytes(&serial)));
+    return if (k == 0) 1 else k;
+}
+
+pub fn probe(path: [:0]const u8) error{DraftDumpUnwritable}!void {
+    const fd = std.c.open(path.ptr, .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true, .CLOEXEC = true }, @as(std.c.mode_t, 0o644));
+    if (fd < 0) return error.DraftDumpUnwritable;
+    _ = std.c.close(fd);
+}
+
+pub const Dump = struct {
+    fd: c_int = -1,
+    stopped: bool = false,
+    written: u64 = 0,
+    round: u32 = 0,
+    buf: []u8 = &.{},
+    len: usize = 0,
+    windows: std.ArrayList(Window) = .empty,
+    streams: usize = 0,
+    serial: u32 = 0,
+
+    pub fn keyFor(d: *Dump, key: *u32) u32 {
+        if (key.* == 0) {
+            d.serial +%= 1;
+            key.* = keyOf(d.serial);
+        }
+        return key.*;
+    }
+
+    pub fn begin(d: *Dump, streams: usize) void {
+        d.windows.clearRetainingCapacity();
+        d.streams = streams;
+    }
+
+    pub fn add(d: *Dump, gpa: std.mem.Allocator, w: Window) !void {
+        if (d.stopped) return;
+        try d.windows.append(gpa, w);
+    }
+
+    pub fn conclude(d: *Dump, gpa: std.mem.Allocator, target: Target, stream: *const anyopaque, verified: usize, got: []const u32) void {
+        if (d.stopped) return;
+        const w = for (d.windows.items) |*x| {
+            if (x.stream == stream) break x;
+        } else return;
+        var out: [most]Record = undefined;
+        const n = records(w, d.round, d.streams, verified, got, &out);
+        for (out[0..n]) |r| d.put(gpa, target, r);
+    }
+
+    pub fn endRound(d: *Dump) void {
+        d.windows.clearRetainingCapacity();
+        d.round +%= 1;
+    }
+
+    fn open(d: *Dump, gpa: std.mem.Allocator, target: Target) bool {
+        if (d.fd >= 0) return true;
+        if (d.stopped) return false;
+        d.buf = gpa.alloc(u8, buffer_bytes) catch return d.stop(gpa, "no memory for its buffer");
+        const fd = std.c.open(target.path.ptr, .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true, .CLOEXEC = true }, @as(std.c.mode_t, 0o644));
+        if (fd < 0) return d.stop(gpa, "the file did not open");
+        d.fd = fd;
+        const end = std.c.lseek(fd, 0, std.c.SEEK.END);
+        if (end < 0) return d.stop(gpa, "the file did not seek");
+        d.written = @intCast(end);
+        if (d.written == 0) {
+            var head: [header_bytes]u8 = undefined;
+            @memcpy(head[0..8], magic);
+            std.mem.writeInt(u32, head[8..12], record_bytes, .little);
+            std.mem.writeInt(u32, head[12..16], version, .little);
+            @memcpy(d.buf[0..header_bytes], &head);
+            d.len = header_bytes;
+        }
+        std.log.info("draft dump: appending {d}-byte records to {s} from {d} bytes, up to {d}", .{ record_bytes, target.path, d.written, target.cap_bytes });
+        return true;
+    }
+
+    fn put(d: *Dump, gpa: std.mem.Allocator, target: Target, r: Record) void {
+        if (!d.open(gpa, target)) return;
+        if (d.written + d.len + record_bytes > target.cap_bytes) {
+            _ = d.flush(gpa);
+            _ = d.stop(gpa, "the cap");
+            return;
+        }
+        if (d.len + record_bytes > d.buf.len and !d.flush(gpa)) return;
+        r.encode(d.buf[d.len..][0..record_bytes]);
+        d.len += record_bytes;
+    }
+
+    fn flush(d: *Dump, gpa: std.mem.Allocator) bool {
+        if (d.fd < 0) return false;
+        var at: usize = 0;
+        while (at < d.len) {
+            const n = std.c.write(d.fd, d.buf[at..d.len].ptr, d.len - at);
+            if (n <= 0) {
+                d.len = 0;
+                return d.stop(gpa, "a write failed");
+            }
+            at += @intCast(n);
+        }
+        d.written += d.len;
+        d.len = 0;
+        return true;
+    }
+
+    fn stop(d: *Dump, gpa: std.mem.Allocator, why: []const u8) bool {
+        if (!d.stopped) std.log.info("draft dump: stopped at {d} bytes ({s})", .{ d.written, why });
+        d.stopped = true;
+        if (d.fd >= 0) _ = std.c.close(d.fd);
+        d.fd = -1;
+        if (d.buf.len > 0) gpa.free(d.buf);
+        d.buf = &.{};
+        d.len = 0;
+        d.windows.clearRetainingCapacity();
+        return false;
+    }
+
+    pub fn deinit(d: *Dump, gpa: std.mem.Allocator) void {
+        if (d.fd >= 0) {
+            _ = d.flush(gpa);
+            _ = d.stop(gpa, "the engine closed");
+        }
+        if (d.buf.len > 0) gpa.free(d.buf);
+        d.buf = &.{};
+        d.windows.deinit(gpa);
+    }
+};
+
+test "draft dump: a record round-trips its 32 bytes" {
+    const r: Record = .{ .round = 7, .stream = 0xdeadbeef, .depth = 3, .flags = verified_bit | known_bit, .streams = 24, .verified = 4, .prob = 0.75, .top1 = 0.8, .top2 = 0.1, .rate = 0.66, .drafted = 12345, .kept = 3 };
+    var b: [record_bytes]u8 = undefined;
+    r.encode(&b);
+    try std.testing.expectEqual(r, Record.decode(&b));
+}
+
+test "draft dump: verified rows land up to the kept path, the first unverified draft is judged by the bonus token only when every verified row landed" {
+    var w: Window = .{ .stream = @ptrFromInt(8), .key = 1, .n = 4, .sampled = false, .rate = 0.5, .drafted = 10 };
+    w.tokens[0..4].* = .{ 11, 12, 13, 14 };
+    var out: [most]Record = undefined;
+    try std.testing.expectEqual(@as(usize, 4), records(&w, 0, 2, 2, &.{ 11, 99 }, &out));
+    try std.testing.expectEqual(verified_bit | known_bit | landed_bit, out[0].flags);
+    try std.testing.expectEqual(verified_bit | known_bit, out[1].flags);
+    try std.testing.expectEqual(@as(u8, 0), out[2].flags);
+    try std.testing.expectEqual(@as(u8, 0), out[3].flags);
+    _ = records(&w, 0, 2, 2, &.{ 11, 12, 13 }, &out);
+    try std.testing.expectEqual(verified_bit | known_bit | landed_bit, out[1].flags);
+    try std.testing.expectEqual(known_bit | landed_bit, out[2].flags);
