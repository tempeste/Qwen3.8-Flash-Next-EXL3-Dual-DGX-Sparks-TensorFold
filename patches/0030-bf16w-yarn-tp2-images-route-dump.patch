+    fn done(x: *QueueSim, p: Waiting(u32).Piece) void {
+        const l = &x.lanes[p.key];
+        l.waits = false;
+        const a = after(l.len, x.marks, p.stop);
+        l.filled = a.filled;
+        if (a.mark > 0) l.mark_due = a.mark;
+    }
+
+    fn step(x: *QueueSim, k: u32, piece: usize) !void {
+        const l = &x.lanes[k];
+        if (l.gone or l.waits) return;
+        if (!x.decoders()) while (x.w.take()) |p| {
+            x.alone += 1;
+            x.done(p);
+        };
+        if (l.mark_due > 0) {
+            try std.testing.expectEqual(@as(?usize, l.mark_due), l.filled);
+            x.marks_kept += 1;
+            l.mark_due = 0;
+        }
+        const at = l.filled orelse return;
+        const stop = @import("cuda_chunk.zig").planStop(piece, l.len, at, x.marks, 64);
+        if (!x.decoders()) {
+            x.alone += 1;
+            x.done(.{ .key = k, .at = at, .stop = stop });
+            return;
+        }
+        if (x.w.full()) return;
+        try x.w.put(.{ .key = k, .at = at, .stop = stop });
+        l.waits = true;
+        l.put_round = x.round;
+    }
