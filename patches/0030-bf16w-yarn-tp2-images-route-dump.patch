+++ b/zig/src/core/lanes/alone_ledger.zig
@@ -0,0 +1,114 @@
+const std = @import("std");
+
+pub const Why = enum {
+    flush_other,
+    flush_own,
+    flush_first,
+    no_decoders,
+    off,
+    media,
+    merged,
+    not_riding,
+    left_by_round,
+    blocking,
+
+    pub fn name(w: Why) []const u8 {
+        return switch (w) {
+            .flush_other => "flush-other",
+            .flush_own => "flush-own",
+            .flush_first => "flush-first",
+            .no_decoders => "no-decoders",
+            .off => "off",
+            .media => "media",
+            .merged => "merged",
+            .not_riding => "not-riding",
+            .left_by_round => "left-by-round",
+            .blocking => "blocking",
+        };
+    }
+};
+
+pub const Row = struct { n: u64 = 0, rows: u64 = 0, ns: [3]u64 = @splat(0) };
+
+pub const reasons = std.enums.values(Why).len;
+
+pub const Counts = struct {
+    by: [reasons]Row = @splat(.{}),
+    opens_only: u64 = 0,
+    open_only_ns: u64 = 0,
+    firsts: u64 = 0,
+    first_ns: u64 = 0,
+
+    pub fn total(c: *const Counts) Row {
+        var t: Row = .{};
+        for (c.by) |r| {
+            t.n += r.n;
+            t.rows += r.rows;
+            for (&t.ns, r.ns) |*a, b| a.* += b;
+        }
+        return t;
+    }
+
+    pub fn format(c: *const Counts, buf: []u8) []const u8 {
+        var w: std.Io.Writer = .fixed(buf);
+        const t = c.total();
+        const ms = struct {
+            fn of(ns: u64) u64 {
+                return (ns + std.time.ns_per_ms / 2) / std.time.ns_per_ms;
+            }
+        }.of;
+        w.print("; alone calls {d} ({d} rows; open {d}, pass {d}, head {d} ms)", .{ t.n, t.rows, ms(t.ns[0]), ms(t.ns[1]), ms(t.ns[2]) }) catch return buf[0..0];
+        for (c.by, 0..) |r, i| {
+            if (r.n == 0) continue;
+            w.print(", {s} {d} ({d} rows; {d}/{d}/{d} ms)", .{ @as(Why, @enumFromInt(i)).name(), r.n, r.rows, ms(r.ns[0]), ms(r.ns[1]), ms(r.ns[2]) }) catch return buf[0..0];
+        }
+        w.print("; opens without an alone pass {d} in {d} ms; first tokens {d} in {d} ms", .{ c.opens_only, ms(c.open_only_ns), c.firsts, ms(c.first_ns) }) catch return buf[0..0];
+        return w.buffered();
+    }
+};
+
+pub var on: std.atomic.Value(bool) = .init(false);
+
+var mutex: std.atomic.Mutex = .unlocked;
+var counts: Counts = .{};
+
+fn hold() void {
+    while (!mutex.tryLock()) std.atomic.spinLoopHint();
+}
+
+pub fn enabled() bool {
+    return on.load(.monotonic);
+}
+
+pub fn record(why: Why, rows: u64, open_ns: u64, pass_ns: u64, head_ns: u64) void {
+    hold();
+    defer mutex.unlock();
+    const r = &counts.by[@intFromEnum(why)];
+    r.n += 1;
+    r.rows += rows;
+    r.ns[0] += open_ns;
+    r.ns[1] += pass_ns;
+    r.ns[2] += head_ns;
+}
+
+pub fn openOnly(ns: u64) void {
+    hold();
+    defer mutex.unlock();
+    counts.opens_only += 1;
+    counts.open_only_ns += ns;
+}
+
+pub fn first(ns: u64) void {
+    hold();
+    defer mutex.unlock();
+    counts.firsts += 1;
+    counts.first_ns += ns;
+}
+
+pub fn take() Counts {
+    hold();
+    defer mutex.unlock();
+    const c = counts;
+    counts = .{};
+    return c;
+}
