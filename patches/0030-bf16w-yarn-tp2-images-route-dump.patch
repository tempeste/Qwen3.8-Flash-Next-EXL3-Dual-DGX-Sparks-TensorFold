+pub fn expertReroute() error{BadExpertReroute}!?ExpertReroute {
+    return expertRerouteFrom(if (std.c.getenv("TF_FLASHNEXT_EXPERT_REROUTE")) |v| std.mem.span(v) else null);
+}
+
+pub fn expertRerouteDigest(r: ExpertReroute) u64 {
+    return ((r.k0 * 33 + r.kp) * 1031 + r.min) % 511;
+}
+
+fn expertRerouteBits() u64 {
+    const r = (expertReroute() catch return 0) orelse return 0;
+    return (1 | expertRerouteDigest(r) << 1) << expert_reroute_bit;
