+pub const ExpertReroute = struct { k0: usize, kp: usize, min: usize };
+
+pub fn expertRerouteFrom(value: ?[]const u8) error{BadExpertReroute}!?ExpertReroute {
+    const v = value orelse return null;
+    if (std.mem.eql(u8, v, "0")) return null;
+    var it = std.mem.splitScalar(u8, v, ',');
+    var x: [3]usize = undefined;
+    for (&x) |*f| f.* = std.fmt.parseInt(usize, it.next() orelse return error.BadExpertReroute, 10) catch return error.BadExpertReroute;
+    if (it.next() != null) return error.BadExpertReroute;
+    const r: ExpertReroute = .{ .k0 = x[0], .kp = x[1], .min = x[2] };
+    if (r.k0 < 1 or r.k0 >= reroute_picks or r.kp <= reroute_picks or r.kp > reroute_most or r.min < 2 or r.min > reroute_most_streams) return error.BadExpertReroute;
+    return r;
