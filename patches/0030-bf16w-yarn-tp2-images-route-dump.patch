+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const images = flash.images;
+const env = @import("sys").env;
+
+const context = 4096;
+const window_rows = 3;
+const max_windows = 24;
+const pic_at = 601;
+const pic_grid = 32;
+const pic_rows = (pic_grid / 2) * (pic_grid / 2);
+const rest = 300;
+const reps = 3;
+
+const Record = struct {
+    rows: []u8,
+    streams: []u8,
+    last: []u8,
+    next: []u8,
+    ns: u64 = 0,
+
+    fn init(a: std.mem.Allocator, nd: usize, np: usize, windows: usize) !Record {
+        const row = prompt.vocabulary * 2;
+        return .{ .rows = try a.alloc(u8, nd * row), .streams = try a.alloc(u8, np * prompt.hidden_wide * 2), .last = try a.alloc(u8, row), .next = try a.alloc(u8, windows * row) };
+    }
+
+    fn deinit(r: Record, a: std.mem.Allocator) void {
+        a.free(r.rows);
+        a.free(r.streams);
+        a.free(r.last);
+        a.free(r.next);
+    }
+};
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    vision: *images.Vision,
+    seed: []const u32,
+    ids: []const u32,
+    text: []const u32,
+    out: u64,
+
+    fn of(r: Rig, picture: bool) []const u32 {
+        return if (picture) r.ids else r.text;
+    }
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    if (chunk < 1024) return error.RankIdentity;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    const vision = try images.Vision.load(gpu.gpa, gpu.io, gpu.d, stream, dir, .{}, 1, glue.f.prep_media, glue.f.pool_media, glue.f.prep_media_paged, glue.f.pool_media_paged);
+    defer vision.deinit();
+    if (e.kv.quantIndex()) |q| vision.prep8 = glue.f.quant[q].prep_media;
+    e.image_factory = vision;
+    defer e.image_factory = null;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, max_windows * window_rows * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed the picture prompt's mixed and separate rounds", .{});
+        return;
+    }
+    const nd_most = max_windows * window_rows;
+    const np = (chunk - nd_most) / 64 * 64;
+    if (np < pic_at + pic_rows + 64) return error.RankIdentity;
+    const ids = try gpu.gpa.alloc(u32, np + rest);
+    defer gpu.gpa.free(ids);
+    const text = try gpu.gpa.alloc(u32, np + rest);
+    defer gpu.gpa.free(text);
+    for (ids, text, 0..) |*v, *t, i| {
+        v.* = seed.items[(i * 13 + 5) % seed.items.len];
+        t.* = v.*;
+    }
+    ids[pic_at - 1] = vision.marks.open;
+    @memset(ids[pic_at..][0..pic_rows], vision.marks.image);
+    ids[pic_at + pic_rows] = vision.marks.close;
+    const r: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .vision = vision, .seed = seed.items, .ids = ids, .text = text, .out = logits.ptr };
+    const yb = try flash.knobs.yBf16();
+    const exl3_rows: usize = if (e.batch_k.exl3) |x| x.prompt_rows else 0;
+    std.debug.print("flashnext-image-ride: passes of {d} rows; a piece of {d} rows: {d} text, a {d}x{d} picture ({d} rows), {d} text, and the same piece all text; MIXED_SEQPAR {s}, MIXED_RIDE_FAST {s}, IMAGE_FAST {s}, Y_BF16 {s}, EXL3 prompt rows {d}\n", .{ chunk, np, pic_at, pic_grid, pic_grid, pic_rows, np - pic_at - pic_rows, onWord(flash.knobs.mixedSeqPar() catch false), onWord(flash.knobs.mixedRideFast() catch false), onWord(flash.knobs.imageFast() catch false), @tagName(yb), exl3_rows });
+    var failed = false;
+    for ([_]usize{ 4, max_windows }) |windows| {
+        if (!try compare(r, np, windows, yb, exl3_rows)) failed = true;
+    }
+    for ([_]usize{ 4, max_windows }) |windows| try bench(r, np, windows);
+    if (failed) {
+        std.debug.print("FAIL flashnext-image-ride: a byte check above failed\n", .{});
+        return error.TestFailed;
+    }
+}
+
+fn yBfTakes(yb: flash.knobs.YBf16, exl3_rows: usize, rows: usize) bool {
+    return flash.knobs.yBf16Takes(yb, rows) and exl3_rows != 0 and rows >= exl3_rows;
+}
+
+fn same(failed: *bool, what: []const u8, got: []const u8, want: []const u8) void {
+    check.sameBytes(what, got, want) catch {
+        failed.* = true;
+    };
+}
+
+fn compare(r: Rig, np: usize, windows: usize, yb: flash.knobs.YBf16, exl3_rows: usize) !bool {
+    const nd = windows * window_rows;
+    var recs: [2][2]Record = undefined;
+    var made: usize = 0;
+    defer for (0..made) |i| recs[i / 2][i % 2].deinit(r.gpu.gpa);
+    for (0..4) |i| {
+        recs[i / 2][i % 2] = try Record.init(r.gpu.gpa, nd, np, windows);
+        made += 1;
+    }
+    for ([_]bool{ false, true }, 0..) |picture, pi| for ([_]bool{ false, true }, 0..) |mixed, mi| {
+        _ = try arm(r, np, windows, mixed, picture, recs[pi][mi]);
+    };
+    const text_alone = recs[0][0];
+    const text_ride = recs[0][1];
+    const pic_alone = recs[1][0];
+    const pic_ride = recs[1][1];
+    const split = yBfTakes(yb, exl3_rows, np + nd) != yBfTakes(yb, exl3_rows, nd);
+    const why = if (split) "bf16 expert outputs in the round (Y_BF16 at its rows), fp32 in the verify" else "one arithmetic";
+    std.debug.print("image ride, {d} windows: window rows riding vs their own verify are {s}\n", .{ windows, if (split) "reported" else "gated" });
+    scoreSpread(windows, "text piece, window rows riding vs the verify", why, text_ride.rows, text_alone.rows);
+    scoreSpread(windows, "picture piece, window rows riding vs the verify", why, pic_ride.rows, pic_alone.rows);
+    scoreSpread(windows, "picture piece, next rows after riding vs after the verify", why, pic_ride.next, pic_alone.next);
+    scoreSpread(windows, "window rows riding beside the picture vs beside text", "one arithmetic", pic_ride.rows, text_ride.rows);
+    scoreSpread(windows, "picture piece, the prompt's last row after riding vs alone", "one arithmetic", pic_ride.last, pic_alone.last);
+    streamSpread(windows, "picture piece, hidden streams riding vs alone", pic_ride.streams, pic_alone.streams);
+    streamSpread(windows, "text piece, hidden streams riding vs alone", text_ride.streams, text_alone.streams);
+    var failed = false;
+    same(&failed, "each window row's verify scores after the picture piece equal them after the text piece", pic_alone.rows, text_alone.rows);
+    same(&failed, "each window row's scores riding beside the picture piece equal them riding beside the text piece", pic_ride.rows, text_ride.rows);
+    same(&failed, "each window's next row after riding beside the picture piece equals it after riding beside the text piece", pic_ride.next, text_ride.next);
+    same(&failed, "the picture piece's hidden streams riding a round equal its own pass's", pic_ride.streams, pic_alone.streams);
+    same(&failed, "the picture prompt's last-row scores after the riding piece equal them after the piece alone", pic_ride.last, pic_alone.last);
+    same(&failed, "the text piece's hidden streams riding a round equal its own pass's", text_ride.streams, text_alone.streams);
+    same(&failed, "the text prompt's last-row scores after the riding piece equal them after the piece alone", text_ride.last, text_alone.last);
+    if (!split) {
+        same(&failed, "each window row's scores beside the picture piece equal the shared verify's", pic_ride.rows, pic_alone.rows);
+        same(&failed, "each window's next row after a partial keep equals the separate round's", pic_ride.next, pic_alone.next);
+    }
+    if (failed) return false;
+    if (split) {
+        check.pass("image ride: {d} prompt rows (a picture of {d} rows inside) beside {d} windows of {d} rows: the piece's streams and last row equal the piece alone, every window byte equals the same round beside text; window rows against their verify differ only by Y_BF16 (reported above)", .{ np, pic_rows, windows, window_rows });
+    } else check.pass("image ride: {d} prompt rows (a picture of {d} rows inside) beside {d} windows of {d} rows, every compared byte equal to the piece alone and to the round beside text", .{ np, pic_rows, windows, window_rows });
+    return true;
+}
+
+fn onWord(v: bool) []const u8 {
+    return if (v) "on" else "off";
+}
+
+fn scoreSpread(windows: usize, what: []const u8, why: []const u8, got: []const u8, want: []const u8) void {
+    const row = prompt.vocabulary;
+    const g: []align(1) const u16 = std.mem.bytesAsSlice(u16, got);
+    const w: []align(1) const u16 = std.mem.bytesAsSlice(u16, want);
+    var held: usize = 0;
+    var words: usize = 0;
+    var worst: f32 = 0;
+    for (0..g.len / row) |i| {
+        var bg: usize = 0;
+        var bw: usize = 0;
+        for (0..row) |j| {
+            const x = bf16(g[i * row + j]);
+            const y = bf16(w[i * row + j]);
+            if (g[i * row + j] != w[i * row + j]) words += 1;
+            worst = @max(worst, @abs(x - y));
+            if (x > bf16(g[i * row + bg])) bg = j;
+            if (y > bf16(w[i * row + bw])) bw = j;
+        }
+        held += @intFromBool(bg == bw);
+    }
+    std.debug.print("image ride, {d} windows, {s} ({s}): {d} of {d} scores differ, argmax held on {d}/{d} rows, max |score change| {d:.5}\n", .{ windows, what, why, words, g.len, held, g.len / row, worst });
+}
+
+fn streamSpread(windows: usize, what: []const u8, got: []const u8, want: []const u8) void {
+    const g: []align(1) const u16 = std.mem.bytesAsSlice(u16, got);
+    const w: []align(1) const u16 = std.mem.bytesAsSlice(u16, want);
+    var values: usize = 0;
+    var worst: f32 = 0;
+    for (g, w) |x, y| {
+        if (x == y) continue;
+        values += 1;
+        worst = @max(worst, @abs(bf16(x) - bf16(y)));
+    }
+    std.debug.print("image ride, {d} windows, {s}: {d} of {d} bf16 values differ, max |change| {d:.5}\n", .{ windows, what, values, g.len, worst });
+}
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+fn attach(r: Rig, p: *prompt.Seq, n: usize) !void {
+    const runs = [_]images.Run{.{ .at = pic_at, .gh = pic_grid, .gw = pic_grid }};
+    p.media = try r.vision.receive(n, &runs);
+    const m = &p.media.?;
+    const host = try r.gpu.gpa.alloc(u16, m.image.features.len / 2);
+    defer r.gpu.gpa.free(host);
+    for (host, 0..) |*v, i| {
+        const x: f32 = @as(f32, @floatFromInt(@as(i32, @intCast((i * 2654435761) % 2001)) - 1000)) / 4000.0;
+        v.* = @truncate(@as(u32, @bitCast(x)) >> 16);
+    }
+    try m.image.features.upload(0, std.mem.sliceAsBytes(host));
+    try r.session.setMedia(p);
+}
+
+fn now(io: std.Io) u64 {
+    return @intCast(std.Io.Clock.awake.now(io).toNanoseconds());
+}
+
+fn arm(r: Rig, np: usize, windows: usize, mixed: bool, picture: bool, rec: Record) !u64 {
+    const gpu = r.gpu;
+    const session = r.session;
+    const tri = r.tri;
+    const e = r.e;
+    var seqs: [max_windows]prompt.Seq = undefined;
+    var drafts: [max_windows]mtp.Draft = undefined;
+    var made: usize = 0;
+    defer for (seqs[0..made], drafts[0..made]) |*q, *d| {
+        d.deinit();
+        session.drop(q);
+    };
+    var tokens: [max_windows][window_rows]u32 = undefined;
+    for (0..windows) |w| {
+        seqs[w] = try session.create(context);
+        drafts[w] = mtp.Draft.init(gpu.gpa, e.driver, r.stream.*, context, 1, 32, e.heads) catch |err| {
+            session.drop(&seqs[w]);
+            return err;
+        };
+        made += 1;
+        var base: [40]u32 = undefined;
+        for (&base, 0..) |*v, i| v.* = r.seed[(w * 31 + i * 7) % r.seed.len];
+        try session.forward(flash.Tri, tri, &seqs[w], base[0 .. 24 + w % 16], .{});
+        for (&tokens[w], 0..) |*v, i| v.* = r.seed[(w * 3 + i * 17 + 1) % r.seed.len];
+    }
+    const ids = r.of(picture);
+    var p = try session.create(context);
+    defer session.drop(&p);
+    if (picture) try attach(r, &p, ids.len);
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, np * prompt.hidden_wide * 2);
+    defer streams.free();
+    var qs: [max_windows]*prompt.Seq = undefined;
+    var ds: [max_windows]*mtp.Draft = undefined;
+    var idss: [max_windows][]const u32 = undefined;
+    for (0..windows) |w| {
+        qs[w] = &seqs[w];
+        ds[w] = &drafts[w];
+        idss[w] = &tokens[w];
+    }
+    try r.stream.synchronize();
+    const t0 = now(gpu.io);
+    if (mixed) {
+        try session.mixed(flash.Tri, tri, .{ .seq = &p, .ids = ids[0..np], .streams = streams.ptr }, qs[0..windows], ds[0..windows], idss[0..windows], r.out);
+    } else {
+        try session.forward(flash.Tri, tri, &p, ids[0..np], .{ .logits = .none, .streams = streams.ptr, .prompt = true });
+        try session.verifyMany(flash.Tri, tri, qs[0..windows], ds[0..windows], idss[0..windows], r.out);
+    }
+    try r.stream.synchronize();
+    const ns = now(gpu.io) - t0;
+    if (rec.rows.len == 0) return ns;
+    const d = e.driver;
+    try d.check(d.api.cuMemcpyDtoH_v2(rec.rows.ptr, r.out, rec.rows.len), "cuMemcpyDtoH");
+    try d.check(d.api.cuMemcpyDtoH_v2(rec.streams.ptr, streams.ptr, rec.streams.len), "cuMemcpyDtoH");
+    try session.forward(flash.Tri, tri, &p, ids[np..], .{ .logits = .last, .prompt = true });
+    @memcpy(rec.last, p.logits);
+    const row = prompt.vocabulary * 2;
+    for (0..windows) |w| {
+        try session.keep(flash.Tri, tri, &seqs[w], &drafts[w], 2);
+        try session.forward(flash.Tri, tri, &seqs[w], &.{13}, .{});
+        @memcpy(rec.next[w * row ..][0..row], seqs[w].logits);
+    }
+    return ns;
+}
+
+fn bench(r: Rig, np: usize, windows: usize) !void {
+    const none: Record = .{ .rows = &.{}, .streams = &.{}, .last = &.{}, .next = &.{} };
+    var ms: [2][2]f64 = undefined;
+    for ([_]bool{ false, true }, 0..) |picture, pi| for ([_]bool{ false, true }, 0..) |mixed, mi| {
+        _ = try arm(r, np, windows, mixed, picture, none);
+        var sum: u64 = 0;
+        for (0..reps) |_| sum += try arm(r, np, windows, mixed, picture, none);
+        ms[pi][mi] = @as(f64, @floatFromInt(sum / reps)) / std.time.ns_per_ms;
+    };
+    const rows: f64 = @floatFromInt(np);
+    for ([_][]const u8{ "text", "picture" }, ms) |what, m| {
+        std.debug.print("RESULT flashnext-image-ride {s} piece of {d} rows beside {d} windows x {d} rows: flag-off path (piece alone, then the verify) {d:.1} ms = {d:.0} prompt rows/s; flag-on path (riding the round) {d:.1} ms = {d:.0} prompt rows/s\n", .{ what, np, windows, window_rows, m[0], rows * 1000.0 / m[0], m[1], rows * 1000.0 / m[1] });
+    }
+}
