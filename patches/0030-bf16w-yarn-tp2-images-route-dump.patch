diff --git a/zig/kernels/cuda/qmmf.cu b/zig/kernels/cuda/qmmf.cu
index ff2f5ee85462604f33b141d9a126715e438d7e70..a73e03ec3c769f5c3e283214736fc529b57dca4b 100644
--- a/zig/kernels/cuda/qmmf.cu
+++ b/zig/kernels/cuda/qmmf.cu
@@ -1464,6 +1464,301 @@ __device__ __forceinline__ void dtile_body(
         }
 }
 
+template <int OP, int BM, int BN, int WM, int WN, int STAGES>
+struct BwTile {
+    static constexpr int THREADS = WM * WN * 32;
+    static constexpr int MT = BM / WM / 16;
+    static constexpr int NT = BN / WN / 8;
+    static constexpr int ROW = 64;
+    static constexpr int X = BM * ROW;
+    static constexpr int W = BN * ROW;
+    static constexpr int S = OP == DCHAIN ? 0 : BN * 2;
+    static constexpr int STAGE = (X + W + S + 127) / 128 * 128;
+    static constexpr int SMEM = STAGES * STAGE;
+    static constexpr int PARK = THREADS / 2 * MT * NT * 4 * 2;
+};
+
+__device__ __forceinline__ int bw_swz(int r, int c) { return c ^ ((r >> 1) & 3); }
+
+template <int OP, int BM, int BN, int WM, int WN, int STAGES, bool F32>
+__device__ __forceinline__ void bw_body(
+        const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ w, const uint8_t* __restrict__ bs,
+        const __nv_bfloat16* __restrict__ w2, const uint8_t* __restrict__ bs2, float scale, float scale2,
+        void* __restrict__ out, int M, int N, int K, int SK, int ldx, int group) {
+    using T = BwTile<OP, BM, BN, WM, WN, STAGES>;
+    constexpr bool GU = OP == DGU;
+    constexpr int OUT_BN = GU ? BN / 2 : BN;
+    static_assert(BN % 64 == 0 && T::MT >= 1 && T::NT % 2 == 0 && STAGES >= 2, "whole 64-column tiles, n8 tile pairs, two stages");
+    static_assert(!GU || (BN == 128 && WN % 2 == 0 && T::PARK <= T::SMEM), "a gate and up block holds 64 columns of each and parks the up half");
+    extern __shared__ __align__(128) unsigned char buf[];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int wm = warp / WN, wn = warp % WN;
+    const int KB = K / 32, KG = K / GS;
+    const int2 at = tile_of(blockIdx.x, M, N, BM, OUT_BN, group);
+    const int m0 = at.x, n0 = at.y;
+    const int last = (N + 63) / 64 - 1;
+
+    auto load = [&](int s, int kb) {
+        unsigned char* p = buf + s * T::STAGE;
+        const int k0 = kb * 32;
+        for (int c = tid; c < BM * 4; c += T::THREADS) {
+            const int r = c >> 2, ch = c & 3;
+            cp16z(p + r * T::ROW + bw_swz(r, ch) * 16, x + static_cast<size_t>(min(m0 + r, M - 1)) * ldx + k0 + ch * 8, m0 + r < M);
+        }
+        unsigned char* pw = p + T::X;
+        for (int c = tid; c < BN * 4; c += T::THREADS) {
+            const int r = c >> 2, ch = c & 3;
+            const bool second = GU && r >= 64;
+            const int row = min(n0 + (second ? r - 64 : r), N - 1);
+            cp16(pw + r * T::ROW + bw_swz(r, ch) * 16, (second ? w2 : w) + static_cast<size_t>(row) * K + k0 + ch * 8);
+        }
+        if constexpr (OP != DCHAIN) {
+            unsigned char* ps = pw + T::W;
+            const int g = kb >> 1;
+            for (int c = tid; c < BN / 8; c += T::THREADS) {
+                const int t = c >> 3;
+                const int tc = GU ? n0 / 64 : min(n0 / 64 + t, last);
+                cp16(ps + c * 16, (GU && t ? bs2 : bs) + (static_cast<size_t>(tc) * KG + g) * 128 + (c & 7) * 16);
+            }
+        }
+    };
+
+    auto lda = [&](uint32_t (&a)[T::MT][4], const unsigned char* p, int kt) {
+#pragma unroll
+        for (int i = 0; i < T::MT; ++i) {
+            const int r = wm * (BM / WM) + i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
+            ldmatrix4(a[i], p + r * T::ROW + bw_swz(r, kt * 2 + (lane >> 4)) * 16);
+        }
+    };
+    auto ldb = [&](uint32_t (&b)[T::NT][2], const unsigned char* pw, int kt) {
+#pragma unroll
+        for (int jp = 0; jp < T::NT / 2; ++jp) {
+            const int n = wn * (BN / WN) + jp * 16 + ((lane >> 4) & 1) * 8 + (lane & 7);
+            uint32_t q[4];
+            ldmatrix4(q, pw + n * T::ROW + bw_swz(n, kt * 2 + ((lane >> 3) & 1)) * 16);
+            b[2 * jp][0] = q[0];
+            b[2 * jp][1] = q[1];
+            b[2 * jp + 1][0] = q[2];
+            b[2 * jp + 1][1] = q[3];
+        }
+    };
+
