diff --git a/zig/src/cuda/green.zig b/zig/src/cuda/green.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d14a1c3289cdb5dcb28b4889be48de9f6014d2b5
--- /dev/null
+++ b/zig/src/cuda/green.zig
@@ -0,0 +1,79 @@
+const std = @import("std");
+const abi = @import("abi.zig");
+const Driver = @import("driver.zig").Driver;
+const Error = @import("driver.zig").Error;
+const Stream = @import("stream.zig").Stream;
+
+pub const Green = struct {
+    d: *const Driver,
+    handle: abi.GreenCtx,
+    sms: u32,
+    device_sms: u32,
+    alignment: u32,
+
+    pub fn init(d: *const Driver, sms: u32) Error!Green {
+        const api = d.green orelse return error.MissingSymbol;
+        var dev: abi.Device = 0;
+        try d.check(d.api.cuCtxGetDevice(&dev), "cuCtxGetDevice");
+        var all: abi.DevResource = .{};
+        try d.check(api.cuDeviceGetDevResource(dev, &all, abi.dev_resource_type_sm), "cuDeviceGetDevResource");
+        if (all.kind != abi.dev_resource_type_sm) return error.Invalid;
+        const total = all.data.sm.sm_count;
+        if (sms == 0 or sms >= total) return error.Invalid;
+        var part: [1]abi.DevResource = .{.{}};
+        var rest: abi.DevResource = .{};
+        var groups: c_uint = 1;
+        try d.check(api.cuDevSmResourceSplitByCount(&part, &groups, &all, &rest, 0, sms), "cuDevSmResourceSplitByCount");
+        if (groups != 1 or part[0].kind != abi.dev_resource_type_sm) return error.Invalid;
+        const got = part[0].data.sm.sm_count;
+        if (got < sms or got >= total) return error.Invalid;
+        var desc: abi.DevResourceDesc = null;
+        try d.check(api.cuDevResourceGenerateDesc(&desc, &part, 1), "cuDevResourceGenerateDesc");
+        var g: abi.GreenCtx = null;
+        try d.check(api.cuGreenCtxCreate(&g, desc, dev, abi.green_ctx_none), "cuGreenCtxCreate");
+        return .{ .d = d, .handle = g, .sms = got, .device_sms = total, .alignment = all.data.sm.coscheduled_alignment };
+    }
+
+    pub fn stream(self: *const Green, priority: Stream.Priority) Error!Stream {
+        const api = self.d.green orelse return error.MissingSymbol;
+        var least: c_int = 0;
+        var greatest: c_int = 0;
+        try self.d.check(self.d.api.cuCtxGetStreamPriorityRange(&least, &greatest), "cuCtxGetStreamPriorityRange");
+        const p: c_int = switch (priority) {
+            .default => 0,
+            .highest => greatest,
+        };
+        var s: abi.Stream = null;
+        try self.d.check(api.cuGreenCtxStreamCreate(&s, self.handle, abi.stream_non_blocking, p), "cuGreenCtxStreamCreate");
+        return .{ .d = self.d, .handle = s };
+    }
+
+    pub fn deinit(self: *Green) void {
+        if (self.d.green) |api| _ = api.cuGreenCtxDestroy(self.handle);
+        self.* = undefined;
+    }
+};
+
+pub fn deviceSms(d: *const Driver) Error!u32 {
+    const api = d.green orelse return error.MissingSymbol;
+    var dev: abi.Device = 0;
+    try d.check(d.api.cuCtxGetDevice(&dev), "cuCtxGetDevice");
+    var all: abi.DevResource = .{};
+    try d.check(api.cuDeviceGetDevResource(dev, &all, abi.dev_resource_type_sm), "cuDeviceGetDevResource");
+    if (all.kind != abi.dev_resource_type_sm) return error.Invalid;
+    return all.data.sm.sm_count;
+}
+
+pub fn streamIn(d: *const Driver, green: ?*const Green, priority: Stream.Priority) Error!Stream {
+    if (green) |g| return g.stream(priority);
+    return switch (priority) {
+        .default => Stream.init(d, true),
+        .highest => Stream.initPriority(d, .highest),
+    };
+}
+
+test "a green context and the device's SM count need the driver's green entry points" {
+    const d: Driver = .{ .lib = undefined, .api = undefined };
+    try std.testing.expectError(error.MissingSymbol, Green.init(&d, 16));
+    try std.testing.expectError(error.MissingSymbol, deviceSms(&d));
+}
