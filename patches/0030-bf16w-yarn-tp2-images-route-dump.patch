diff --git a/zig/tests/cuda/flashnext_mixed_queue_tests.zig b/zig/tests/cuda/flashnext_mixed_queue_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..41efca67a82f38db03e2cbb2a0f2d6d6ffc8bb91
--- /dev/null
+++ b/zig/tests/cuda/flashnext_mixed_queue_tests.zig
@@ -0,0 +1,232 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const table_tests = @import("flashnext_mixed_table_tests.zig");
+const prompt = flash.prompt;
+const plan = flash.mixed_plan;
+const env = @import("sys").env;
+const Windows = table_tests.Windows;
+
+const window_context = 4096;
+const windows_n = 28;
+const default_at = 81920;
+const queued = [_]usize{ 512, 768, 1024 };
+const bench_rows = [_]usize{ 512, 768, 1024, 2944 };
+const reps = 3;
+const next_rows = 64;
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+    ids: []const u32,
+    out: u64,
+    streams: cuda.DeviceBuffer,
+    at: usize,
+    wr: usize,
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, at_arg: ?[]const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const at = if (at_arg) |v| try std.fmt.parseInt(usize, v, 10) else default_at;
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "1", 1);
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    var room: usize = 0;
+    for (bench_rows) |np| room += 2 * (reps + 1) * np;
+    const context = @max(window_context, at + room + chunk);
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, windows_n * 3 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed the queued pieces' mixed rounds", .{});
+        return;
+    }
+    const round_cap = @min(flash.knobs.roundRowsCap(), chunk);
+    const max_np = plan.pieceRows(chunk, chunk, round_cap);
+    const wr: usize = @max(1, @min(3, round_cap / windows_n));
+    for (bench_rows) |np| if (np > max_np or !plan.fits(np, @as(usize, windows_n) * wr, chunk)) return error.RankIdentity;
+    const ids = try gpu.gpa.alloc(u32, context);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, max_np * prompt.hidden_wide * 2);
+    defer streams.free();
+    const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items, .ids = ids, .out = logits.ptr, .streams = streams, .at = at, .wr = wr };
+    std.debug.print("flashnext-mixed-queue: passes of {d} rows, {d} windows of {d} rows, queued pieces of 512, 768 and 1024 rows (the last a prompt's last piece) from position {d}; split sums from {d} rows, seqpar from {d}, ride fast {s}\n", .{ chunk, windows_n, wr, at, try flash.knobs.splitSumMinRows(), try flash.knobs.tpSeqParMinRows(), if (try flash.knobs.mixedRideFast()) "on" else "off" });
+    try compare(rig);
+    for (bench_rows) |np| try bench(rig, np);
+}
+
+const Got = struct {
+    streams: []u8,
+    first: []u8,
+    next: []u8,
+
+    fn alloc(gpa: std.mem.Allocator, np: usize) !Got {
+        const row = prompt.vocabulary * 2;
+        const a = try gpa.alloc(u8, np * prompt.hidden_wide * 2);
+        errdefer gpa.free(a);
+        const b = try gpa.alloc(u8, row);
+        errdefer gpa.free(b);
+        return .{ .streams = a, .first = b, .next = try gpa.alloc(u8, row) };
+    }
+
+    fn free(g: Got, gpa: std.mem.Allocator) void {
+        gpa.free(g.streams);
+        gpa.free(g.first);
+        gpa.free(g.next);
+    }
+};
+
+fn prefix(r: Rig, len: usize) !prompt.Seq {
+    var p = try r.session.create(r.at + len + next_rows + 64);
+    errdefer r.session.drop(&p);
+    while (p.fed < r.at) try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..@min(r.at, p.fed + r.e.chunk)], .{ .logits = .none, .prompt = true });
+    try r.stream.synchronize();
+    return p;
+}
+
+fn ride(r: Rig, w: *Windows, p: *prompt.Seq, np: usize, last: bool, g: Got) !void {
+    const dr = r.e.driver;
+    try r.session.mixed(flash.Tri, r.tri, .{ .seq = p, .ids = r.ids[p.fed..][0..np], .streams = r.streams.ptr, .last = last }, w.qs[0..w.n], w.ds[0..w.n], w.idss[0..w.n], r.out);
+    try r.stream.synchronize();
+    try dr.check(dr.api.cuMemcpyDtoH_v2(g.streams.ptr, r.streams.ptr, g.streams.len), "cuMemcpyDtoH");
+    @memset(g.first, 0);
+    if (last) @memcpy(g.first, p.logits[0..g.first.len]);
+    try w.keepAll(r.session, r.tri);
+}
+
+fn nextPass(r: Rig, p: *prompt.Seq, g: Got) !void {
+    try r.session.forward(flash.Tri, r.tri, p, r.ids[p.fed..][0..next_rows], .{ .logits = .last, .prompt = true });
+    try r.stream.synchronize();
+    @memcpy(g.next, p.logits[0..g.next.len]);
+}
+
+fn compare(r: Rig) !void {
+    const gpa = r.gpu.gpa;
+    var slot: [queued.len]Got = undefined;
+    var queue: [queued.len]Got = undefined;
+    var made: usize = 0;
+    defer for (slot[0..made], queue[0..made]) |a, b| {
+        a.free(gpa);
+        b.free(gpa);
+    };
+    for (queued, 0..) |np, i| {
+        slot[i] = try Got.alloc(gpa, np);
+        queue[i] = Got.alloc(gpa, np) catch |err| {
+            slot[i].free(gpa);
+            return err;
+        };
+        made += 1;
+    }
+    for (queued, 0..) |np, i| {
+        var w: Windows = .{ .rows = r.wr };
+        try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, windows_n);
+        defer w.deinit(r.session);
+        var p = try prefix(r, np);
+        defer r.session.drop(&p);
+        try ride(r, &w, &p, np, i == queued.len - 1, slot[i]);
+        if (i < queued.len - 1) try nextPass(r, &p, slot[i]) else @memset(slot[i].next, 0);
+    }
+    var w: Windows = .{ .rows = r.wr };
+    try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, windows_n);
+    defer w.deinit(r.session);
+    var lanes: [queued.len]prompt.Seq = undefined;
+    var opened: usize = 0;
+    defer for (lanes[0..opened]) |*q| r.session.drop(q);
+    for (queued) |np| {
+        lanes[opened] = try prefix(r, np);
+        opened += 1;
+    }
+    for (queued, 0..) |np, i| try ride(r, &w, &lanes[i], np, i == queued.len - 1, queue[i]);
+    for (queued, 0..) |_, i| {
+        if (i < queued.len - 1) try nextPass(r, &lanes[i], queue[i]) else @memset(queue[i].next, 0);
+    }
+    for (queued, 0..) |np, i| {
+        std.debug.print("flashnext-mixed-queue: the {d}-row piece rode round {d} of the queue against round 1 beside fresh windows\n", .{ np, i + 1 });
+        try check.sameBytes("a queued piece's hidden streams equal the same piece riding the next round from the single slot", queue[i].streams, slot[i].streams);
+        if (i == queued.len - 1) {
+            try check.sameBytes("a queued last piece's first-token scores equal the same piece riding from the single slot", queue[i].first, slot[i].first);
+        } else try check.sameBytes("the next pass's last-row scores after a queued piece (its states) equal the ones after the single slot's", queue[i].next, slot[i].next);
+    }
+    check.pass("queued pieces of 512, 768 and 1024 rows at position {d} riding rounds 1 to 3 beside {d} windows leave the bytes of the same pieces riding the next round from one slot", .{ r.at, windows_n });
+}
+
+fn now(io: std.Io) u64 {
+    return @intCast(std.Io.Clock.awake.now(io).toNanoseconds());
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / std.time.ns_per_ms;
+}
+
+fn bench(r: Rig, np: usize) !void {
+    var w: Windows = .{ .rows = r.wr };
+    try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, windows_n);
+    defer w.deinit(r.session);
+    var p = try r.session.create(r.at + 2 * (reps + 1) * np + r.e.chunk);
+    defer r.session.drop(&p);
+    while (p.fed < r.at) try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..@min(r.at, p.fed + r.e.chunk)], .{ .logits = .none, .prompt = true });
+    try r.stream.synchronize();
+    const from = p.fed;
+    var verify_ns: u64 = 0;
+    var alone_ns: u64 = 0;
+    var mixed_ns: u64 = 0;
+    for (0..reps + 1) |k| {
+        var t0 = now(r.gpu.io);
+        try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..w.n], w.ds[0..w.n], w.idss[0..w.n], r.out);
+        try r.stream.synchronize();
+        const v = now(r.gpu.io) - t0;
+        try w.keepAll(r.session, r.tri);
+        t0 = now(r.gpu.io);
+        try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..][0..np], .{ .logits = .none, .streams = r.streams.ptr, .prompt = true });
+        try r.stream.synchronize();
+        const a = now(r.gpu.io) - t0;
+        t0 = now(r.gpu.io);
+        try r.session.mixed(flash.Tri, r.tri, .{ .seq = &p, .ids = r.ids[p.fed..][0..np], .streams = r.streams.ptr }, w.qs[0..w.n], w.ds[0..w.n], w.idss[0..w.n], r.out);
+        try r.stream.synchronize();
+        const m = now(r.gpu.io) - t0;
+        try w.keepAll(r.session, r.tri);
+        if (k == 0) continue;
+        verify_ns += v;
+        alone_ns += a;
+        mixed_ns += m;
+    }
+    verify_ns /= reps;
+    alone_ns /= reps;
+    mixed_ns /= reps;
+    const rows: f64 = @floatFromInt(np);
+    std.debug.print("RESULT flashnext-mixed-queue {d} windows x {d} rows, {d} piece rows from position {d} to {d}: verify alone {d:.1} ms, piece alone {d:.1} ms ({d:.3} ms a row), mixed {d:.1} ms (riding {d:.3} ms a row), riding saves {d:.1} ms a piece\n", .{ windows_n, r.wr, np, from, p.fed, ms(verify_ns), ms(alone_ns), ms(alone_ns) / rows, ms(mixed_ns), (ms(mixed_ns) - ms(verify_ns)) / rows, ms(verify_ns) + ms(alone_ns) - ms(mixed_ns) });
+}
