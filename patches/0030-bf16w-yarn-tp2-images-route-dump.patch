+
+test "draft dump: the file starts with its header, takes whole records and stops at the cap" {
+    const gpa = std.testing.allocator;
+    var name: [64]u8 = undefined;
+    const path = try std.fmt.bufPrintSentinel(&name, "/tmp/tf-draft-dump-test-{d}.bin", .{std.c.getpid()}, 0);
+    _ = std.c.unlink(path.ptr);
+    defer _ = std.c.unlink(path.ptr);
+    try probe(path);
+    const target: Target = .{ .path = path, .cap_bytes = header_bytes + 3 * record_bytes };
+    var d: Dump = .{};
+    defer d.deinit(gpa);
+    var w: Window = .{ .stream = @ptrFromInt(16), .key = 2, .n = 2, .sampled = false, .rate = 0.5, .drafted = 4 };
+    w.tokens[0..2].* = .{ 1, 2 };
+    for (0..3) |_| {
+        d.begin(2);
+        try d.add(gpa, w);
+        d.conclude(gpa, target, @ptrFromInt(16), 2, &.{ 1, 2, 3 });
+        d.conclude(gpa, target, @ptrFromInt(24), 2, &.{ 1, 2, 3 });
+        d.endRound();
+    }
+    try std.testing.expect(d.stopped);
+    try std.testing.expectEqual(@as(u64, header_bytes + 3 * record_bytes), d.written);
+    const fd = std.c.open(path.ptr, .{ .ACCMODE = .RDONLY }, @as(std.c.mode_t, 0));
+    try std.testing.expect(fd >= 0);
+    defer _ = std.c.close(fd);
+    var back: [header_bytes + 4 * record_bytes]u8 = undefined;
+    const n = std.c.read(fd, &back, back.len);
+    try std.testing.expectEqual(@as(isize, header_bytes + 3 * record_bytes), n);
+    try std.testing.expectEqualStrings(magic, back[0..8]);
+    const second = Record.decode(back[header_bytes + record_bytes ..][0..record_bytes]);
+    try std.testing.expectEqual(@as(u8, 1), second.depth);
+    try std.testing.expectEqual(verified_bit | known_bit | landed_bit, second.flags);
+    try std.testing.expectEqual(@as(u32, 3), second.kept);
+}
+
+test "draft dump: each stream keeps one key of its own whatever its id, and the keys split by stream into held-out fifths" {
+    var d: Dump = .{};
+    var keys: [500]u32 = @splat(0);
+    var held: usize = 0;
+    for (&keys, 0..) |*k, i| {
+        const first = d.keyFor(k);
+        try std.testing.expect(first != 0);
+        try std.testing.expectEqual(first, d.keyFor(k));
+        for (keys[0..i]) |other| try std.testing.expect(other != first);
+        held += @intFromBool(first % 5 == 0);
+    }
+    try std.testing.expect(held > 60 and held < 140);
+}
