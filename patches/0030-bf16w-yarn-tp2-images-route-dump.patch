diff --git a/zig/src/core/prompt_cache_image_cut.zig b/zig/src/core/prompt_cache_image_cut.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2311b946a7029cfe0c976e44cbc0d9f48f3f0551
--- /dev/null
+++ b/zig/src/core/prompt_cache_image_cut.zig
@@ -0,0 +1,35 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+
+pub const TEXT_TAIL: u32 = 64;
+
+pub fn at(s: *const pc.Store, prompt_len: usize) u32 {
+    if (!s.image_cut or s.rules.planned) return 0;
+    const images = s.image_query orelse return 0;
+    var first: u32 = std.math.maxInt(u32);
+    for (images) |i| first = @min(first, i.at);
+    const back = 1 + s.rules.lookahead + TEXT_TAIL;
+    if (first == std.math.maxInt(u32) or first <= back) return 0;
+    const cut = first - back;
+    return if (cut < prompt_len) cut else 0;
+}
+
+pub fn add(s: *pc.Store, a: std.mem.Allocator, prompt_len: usize, from: u32, marks: []const u32) ![]const u32 {
+    const cut = at(s, prompt_len);
+    if (cut == 0 or cut <= from or s.hold) return marks;
+    for (marks) |m| if (m <= cut and cut - m < s.rules.min_gap) return marks;
+    var used: u64 = s.family.vtable.bytes(s.family.ptr, cut);
+    for (marks) |m| used +|= s.family.vtable.bytes(s.family.ptr, m);
+    if (used > s.budget or marks.len + 1 > s.most) return marks;
+    const out = try a.alloc(u32, marks.len + 1);
+    @memcpy(out[0..marks.len], marks);
+    out[marks.len] = cut;
+    std.mem.sort(u32, out, {}, std.sort.asc(u32));
+    a.free(marks);
+    return out;
+}
+
+pub fn isCut(s: *const pc.Store, prompt_len: usize, kept_at: u32) bool {
+    const cut = at(s, prompt_len);
+    return cut != 0 and cut == kept_at;
+}
