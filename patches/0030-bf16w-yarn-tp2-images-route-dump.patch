diff --git a/tools/flashnext_route_dump.py b/tools/flashnext_route_dump.py
new file mode 100644
index 0000000000000000000000000000000000000000..e2924187513063b3456593ead82d5ff514e8f2be
--- /dev/null
+++ b/tools/flashnext_route_dump.py
@@ -0,0 +1,213 @@
+import argparse
+import array
+import struct
+import sys
+
+MAGIC = 0x44524654
+HEADER = 8
+RECORD = 6
+BUCKETS = [(1, 8), (9, 16), (17, 32), (33, 48), (49, 64), (65, 96), (97, 128), (129, 192), (193, 1 << 30)]
+DEFAULT_GRID = "4,12,8;4,16,8;6,16,8;7,16,8;7,20,8;8,16,8;8,24,8;7,16,16"
+
+
+def bf16(bits):
+    return struct.unpack("<f", struct.pack("<I", bits << 16))[0]
+
+
+def rounds_of(data, head, every, max_rounds):
+    at = HEADER * 4
+    seen = 0
+    kept = 0
+    mixed = 0
+    slots, cand, picks_n = head["slots"], head["cand"], head["picks"]
+    while at + RECORD * 4 <= len(data):
+        kind, rows, streams, prompt_rows, applied, layers = struct.unpack_from("<6I", data, at)
+        at += RECORD * 4
+        if kind == 1:
+            mixed += 1
+            continue
+        need = rows * (slots + 2 * cand) * 2 * layers
+        if at + need > len(data):
+            break
+        start = at
+        at += need
+        seen += 1
+        if (seen - 1) % every:
+            continue
+        v = array.array("H")
+        v.frombytes(data[start:start + need])
+        if sys.byteorder != "little":
+            v.byteswap()
+        out = []
+        per = rows * (slots + 2 * cand)
+        for layer in range(layers):
+            o = layer * per
+            p = v[o:o + rows * slots]
+            i = v[o + rows * slots:o + rows * (slots + cand)]
+            w = v[o + rows * (slots + cand):o + per]
+            out.append((
+                [tuple(p[r * slots:r * slots + picks_n]) for r in range(rows)],
+                [tuple(i[r * cand:(r + 1) * cand]) for r in range(rows)],
+                [tuple(bf16(x) for x in w[r * cand:(r + 1) * cand]) for r in range(rows)],
+            ))
+        yield dict(rows=rows, streams=streams, applied=applied, layers=out), mixed
+        kept += 1
+        if max_rounds and kept >= max_rounds:
+            return
+
+
+def owner_of(experts, stride):
+    return [(e % 2) if stride else int(e >= experts // 2) for e in range(experts)]
+
+
+def counts(chosen, owner):
+    halves = [0, 0]
+    for e in chosen:
+        halves[owner[e]] += 1
+    return len(chosen), max(halves)
+
+
+def reroute(ids, w, k0, kp, picks_n):
+    core = set()
+    for row in ids:
+        core.update(row[:k0])
+    need = picks_n - k0
+    chosen = set()
+    moved = 0.0
+    changed = 0
+    top = 0
+    for row, wr in zip(ids, w):
+        late = row[k0:picks_n]
+        if all(e in core for e in late):
+            chosen.update(row[:picks_n])
+            continue
+        take = list(range(k0))
+        hits = [k for k in range(k0, kp) if row[k] in core][:need]
+        rest = need - len(hits)
+        fill = [k for k in range(k0, kp) if k not in hits][:rest] if rest > 0 else []
+        take += sorted(hits + fill)
+        if take[0] != 0:
+            top += 1
+        if take[-1] < picks_n:
+            chosen.update(row[:picks_n])
+            continue
+        changed += 1
+        chosen.update(row[k] for k in take)
+        s_old = sum(wr[:picks_n])
+        s_new = sum(wr[k] for k in take)
+        ts = set(take)
+        d = 0.0
+        for k in range(kp):
+            a = wr[k] / s_old if k < picks_n else 0.0
+            b = wr[k] / s_new if k in ts else 0.0
+            d += abs(a - b)
+        moved += 0.5 * d
+    return chosen, moved, changed, top
+
+
+def bucket_of(rows):
+    for i, (lo, hi) in enumerate(BUCKETS):
+        if lo <= rows <= hi:
+            return i
+    return len(BUCKETS) - 1
+
+
+def label(b):
+    lo, hi = BUCKETS[b]
+    return f"{lo}-{hi}" if hi < 1 << 29 else f"{lo}+"
+
+
+def main():
+    ap = argparse.ArgumentParser(description="Distinct experts a layer in a TF_FLASHNEXT_ROUTE_DUMP file, today and under the batch-aware re-route rule: keep each row's top K0 picks, prefer the batch's core (every row's top K0) among its top KP, only in rounds of MIN streams or more. Standard library only.")
+    ap.add_argument("dump")
+    ap.add_argument("--grid", default=DEFAULT_GRID, help="K0,KP,MIN settings separated by ';' (KP at most the dump's 24 candidates)")
+    ap.add_argument("--stride", action="store_true", help="rank halves as TF_FLASHNEXT_TP_EXPERT_STRIDE=1 splits them (even and odd ids); default contiguous halves, the engine's default")
+    ap.add_argument("--mb-per-expert", type=float, default=1.555, help="MB a rank reads for one distinct expert in one layer (2.5 bpw EXL3: 1.536 MB of trellis plus 0.019 MB of scales)")
+    ap.add_argument("--every", type=int, default=1, help="read every Nth decode round")
+    ap.add_argument("--max-rounds", type=int, default=0)
+    a = ap.parse_args()
+    with open(a.dump, "rb") as f:
+        data = f.read()
+    if len(data) < HEADER * 4:
+        sys.exit("dump too short")
+    h = struct.unpack_from("<8I", data, 0)
+    if h[0] != MAGIC or h[1] != 1:
+        sys.exit("not a version 1 route dump")
+    head = dict(layers=h[2], cand=h[3], slots=h[4], picks=h[5], experts=h[6], world=h[7])
+    P, E = head["picks"], head["experts"]
+    grid = [tuple(int(x) for x in g.split(",")) for g in a.grid.split(";") if g]
+    for k0, kp, mn in grid:
+        if not (1 <= k0 < P < kp <= head["cand"] and mn >= 2):
+            sys.exit(f"bad setting {k0},{kp},{mn}")
+    owner = owner_of(E, a.stride)
+    nb = len(BUCKETS)
+    z = lambda: [0.0] * nb
+    agg = dict(n=z(), rows=z(), streams=z(), today=z(), half=z(), loaded=z(), applied=z())
+    sim = {g: dict(d=z(), half=z(), moved=z(), changed=z(), rows=z(), top=0) for g in grid}
+    total = 0
+    mixed = 0
+    for rd, mixed in rounds_of(data, head, max(a.every, 1), a.max_rounds):
+        total += 1
+        b = bucket_of(rd["rows"])
+        L = len(rd["layers"])
+        agg["n"][b] += 1
+        agg["rows"][b] += rd["rows"]
+        agg["streams"][b] += rd["streams"]
+        agg["applied"][b] += rd["applied"]
+        for picks, ids, w in rd["layers"]:
+            nat = set()
+            for row in ids:
+                nat.update(row[:P])
+            d, dh = counts(nat, owner)
+            agg["today"][b] += d / L
+            agg["half"][b] += dh / L
+            loaded = set()
+            for row in picks:
+                loaded.update(row)
+            agg["loaded"][b] += len(loaded) / L
+            for g in grid:
+                k0, kp, mn = g
+                s = sim[g]
+                s["rows"][b] += rd["rows"] / L
+                if rd["streams"] < mn:
+                    s["d"][b] += d / L
+                    s["half"][b] += dh / L
+                    continue
+                chosen, moved, changed, top = reroute(ids, w, k0, kp, P)
+                cd, ch = counts(chosen, owner)
+                s["d"][b] += cd / L
+                s["half"][b] += ch / L
+                s["moved"][b] += moved / L
+                s["changed"][b] += changed / L
+                s["top"] += top
+    if not total:
+        sys.exit("no decode rounds in the dump")
+    print(f"dump: {total} shared decode rounds read (every {max(a.every, 1)}), {mixed} mixed rounds (a prompt piece rode, not re-routed), {head['layers']} layers, {E} experts, top {P}, {head['cand']} candidates a row, rank halves {'strided' if a.stride else 'contiguous'}")
+    if any(agg["applied"]):
+        print(f"note: {int(sum(agg['applied']))} rounds were re-routed when dumped; 'today' is the natural top {P} from the candidates, 'loaded' what the engine read")
+    print()
+    print("rows       rounds  streams  rows/round  distinct/layer  busier-half  loaded  MB/round(busier rank)")
+    for b in range(nb):
+        n = agg["n"][b]
+        if not n:
+            continue
+        mb = agg["half"][b] / n * head["layers"] * a.mb_per_expert
+        print(f"{label(b):9} {int(n):7}  {agg['streams'][b] / n:7.1f}  {agg['rows'][b] / n:10.1f}  {agg['today'][b] / n:14.1f}  {agg['half'][b] / n:11.1f}  {agg['loaded'][b] / n:6.1f}  {mb:10.0f}")
+    for g in grid:
+        k0, kp, mn = g
+        s = sim[g]
+        print()
+        print(f"re-route K0={k0} KP={kp} MIN={mn} streams")
+        print("rows       distinct/layer  busier-half  fewer-bytes(busier)  weight-moved  rows-changed")
+        for b in range(nb):
+            n = agg["n"][b]
+            if not n:
+                continue
+            fewer = 1.0 - s["half"][b] / max(agg["half"][b], 1e-9)
+            rows = max(s["rows"][b], 1e-9)
+            print(f"{label(b):9} {s['d'][b] / n:15.1f}  {s['half'][b] / n:11.1f}  {100 * fewer:18.1f}%  {100 * s['moved'][b] / rows:11.2f}%  {100 * s['changed'][b] / rows:11.1f}%")
+        print(f"rows whose top-1 expert changed: {s['top']} (0 by construction)")
+
+
+if __name__ == "__main__":
+    main()
