index 0000000000000000000000000000000000000000..14c256859718381c6dfa00474269e326f502ace5
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_bf16w.zig
@@ -0,0 +1,78 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+
+const Q4 = wt.Q4;
+
+pub const Kind = enum { chain, block };
+
+pub const chain_exact_lo: u32 = 3;
+pub const chain_exact_hi: u32 = 134;
+
+pub const Report = struct {
+    weights: usize = 0,
+    bytes: usize = 0,
+    chain_lo: u32 = 255,
+    chain_hi: u32 = 0,
+    block_lo: u32 = 255,
+    block_hi: u32 = 0,
+
+    pub fn chainExact(r: Report) bool {
+        return r.chain_hi < r.chain_lo or (r.chain_lo >= chain_exact_lo and r.chain_hi <= chain_exact_hi);
+    }
+};
+
+pub fn roleOf(comptime field: []const u8) Kind {
+    return if (std.mem.eql(u8, field, "proj")) .chain else .block;
+}
+
+pub fn copy(d: *const cuda.Driver, s: cuda.Stream, lane: *const cuda.qmmf.Lane, p: *Q4, kind: Kind, range: u64, r: *Report) !void {
+    const w = p.native orelse return;
+    if (w.mode != .mxfp8 or p.bw != null) return;
+    var b = try cuda.DeviceBuffer.alloc(d, cuda.qmmf.bwBytes(w));
+    errdefer b.free();
+    try lane.bwPack(s, w, kind == .chain, b.ptr, range + @as(u64, if (kind == .chain) 0 else 8));
+    p.bw = b;
+    p.native.?.bw = b.ptr;
+    p.native.?.bw_chain = kind == .chain;
+    r.weights += 1;
+    r.bytes += b.len;
+}
+
+pub fn attach(d: *const cuda.Driver, s: cuda.Stream, lane: *const cuda.qmmf.Lane, layers: anytype) !Report {
+    var r: Report = .{};
+    const init = [4]u32{ 255, 0, 255, 0 };
+    var range = try cuda.DeviceBuffer.fromHost(d, std.mem.asBytes(&init));
+    defer range.free();
+    for (layers) |*l| {
+        try copy(d, s, lane, &l.proj, roleOf("proj"), range.ptr, &r);
+        try copy(d, s, lane, &l.out, roleOf("out"), range.ptr, &r);
+        if (l.native_experts) |*e| for (&e.shared) |*p| try copy(d, s, lane, p, .block, range.ptr, &r);
+    }
+    try s.synchronize();
+    var got: [4]u32 = undefined;
+    try range.download(0, std.mem.asBytes(&got));
+    r.chain_lo = got[0];
+    r.chain_hi = got[1];
+    r.block_lo = got[2];
+    r.block_hi = got[3];
+    return r;
+}
+
+pub fn bytesOf(mx_codes: u64) u64 {
+    return 2 * mx_codes;
+}
+
+test "the in-projection takes the chain copy and every other dense weight the block copy" {
+    try std.testing.expectEqual(Kind.chain, roleOf("proj"));
+    try std.testing.expectEqual(Kind.block, roleOf("out"));
+}
+
+test "chain copies are exact only while every scale byte keeps the bf16 unit and its products in range" {
+    try std.testing.expect((Report{}).chainExact());
+    try std.testing.expect((Report{ .chain_lo = 100, .chain_hi = 130 }).chainExact());
+    try std.testing.expect((Report{ .chain_lo = 3, .chain_hi = 134 }).chainExact());
+    try std.testing.expect(!(Report{ .chain_lo = 2, .chain_hi = 130 }).chainExact());
+    try std.testing.expect(!(Report{ .chain_lo = 100, .chain_hi = 135 }).chainExact());
+    try std.testing.expectEqual(@as(u64, 2 * 1000), bytesOf(1000));
+}
