+pub const RouteDump = struct { path: []const u8, cap: usize };
+pub const route_dump_default_mb: usize = 1024;
+pub const route_dump_most_mb: usize = 16384;
+
+pub fn routeDumpFrom(path: ?[]const u8, mb: ?[]const u8) error{BadRouteDump}!?RouteDump {
+    const p = path orelse return null;
+    if (p.len == 0) return null;
+    if (p[0] != '/') return error.BadRouteDump;
+    const m = if (mb) |v| std.fmt.parseInt(usize, v, 10) catch return error.BadRouteDump else route_dump_default_mb;
+    if (m == 0 or m > route_dump_most_mb) return error.BadRouteDump;
+    return .{ .path = p, .cap = m << 20 };
+}
+
+pub fn routeDump() error{BadRouteDump}!?RouteDump {
+    const span = struct {
+        fn f(name: [*:0]const u8) ?[]const u8 {
+            return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+        }
+    }.f;
+    return routeDumpFrom(span("TF_FLASHNEXT_ROUTE_DUMP"), span("TF_FLASHNEXT_ROUTE_DUMP_MB"));
+}
+
+test "TF_FLASHNEXT_ROUTE_DUMP is off unset or empty, takes an absolute path and a cap in MiB, refuses anything else and stays out of tp_flags" {
+    try std.testing.expectEqual(@as(?RouteDump, null), try routeDumpFrom(null, null));
+    try std.testing.expectEqual(@as(?RouteDump, null), try routeDumpFrom("", "5"));
+    const d = (try routeDumpFrom("/tmp/r.bin", null)).?;
+    try std.testing.expectEqualStrings("/tmp/r.bin", d.path);
+    try std.testing.expectEqual(route_dump_default_mb << 20, d.cap);
+    try std.testing.expectEqual(@as(usize, 64 << 20), (try routeDumpFrom("/x", "64")).?.cap);
+    try std.testing.expectError(error.BadRouteDump, routeDumpFrom("rel.bin", null));
+    for ([_][]const u8{ "0", "", "x", "-1", "16385" }) |bad| try std.testing.expectError(error.BadRouteDump, routeDumpFrom("/x", bad));
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_FLASHNEXT_ROUTE_DUMP");
+    _ = env.unsetenv("TF_FLASHNEXT_ROUTE_DUMP");
+    const off = tpFlags();
+    _ = env.setenv("TF_FLASHNEXT_ROUTE_DUMP", "/tmp/r.bin", 1);
+    try std.testing.expectEqual(off, tpFlags());
+}
+
+pub fn imageFast() error{BadImageFast}!bool {
+    return onOff(if (std.c.getenv("TF_FLASHNEXT_IMAGE_FAST")) |v| std.mem.span(v) else null) orelse error.BadImageFast;
+}
+
+test "TF_FLASHNEXT_IMAGE_FAST is off unset or 0, on at 1, refuses anything else and sets tp_flags bit 53 alone" {
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_FLASHNEXT_IMAGE_FAST");
+    _ = env.unsetenv("TF_FLASHNEXT_IMAGE_FAST");
+    const off = tpFlags();
+    try std.testing.expectEqual(@as(u64, 0), off >> image_fast_bit);
+    try std.testing.expect(!try imageFast());
+    _ = env.setenv("TF_FLASHNEXT_IMAGE_FAST", "0", 1);
+    try std.testing.expect(!try imageFast());
+    try std.testing.expectEqual(off, tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_IMAGE_FAST", "1", 1);
+    try std.testing.expect(try imageFast());
+    try std.testing.expectEqual(off | @as(u64, 1) << image_fast_bit, tpFlags());
+    for ([_][:0]const u8{ "", "2", "on", "true", " 1" }) |bad| {
+        _ = env.setenv("TF_FLASHNEXT_IMAGE_FAST", bad, 1);
