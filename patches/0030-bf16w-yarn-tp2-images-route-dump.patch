--- /dev/null
+++ b/zig/src/core/prompt_cache_image_cut_test.zig
@@ -0,0 +1,354 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const Fake = @import("prompt_cache_fake.zig").Fake;
+const Image = @import("lanes").stream.Image;
+const Store = pc.Store;
+
+const user_at: u32 = 3;
+const pic_at: u32 = 9001;
+const pic_rows: u32 = 64;
+const question: u32 = 100;
+const gen: u32 = 3;
+const rules: pc.Rules = .{ .lookahead = 1, .min_gap = 256, .min_prompt = 512, .chunk = 1 };
+const cut_at: u32 = pic_at - 2 - @import("prompt_cache_image_cut.zig").TEXT_TAIL;
+
+const Turn = struct {
+    tokens: []u32,
+    images: []const Image,
+    history: u32,
+    user: u32,
+    user_end: u32,
+};
+
+fn picture(hash: u64) Image {
+    return .{ .pixels = &.{}, .gh = 16, .gw = 16, .at = pic_at, .tokens = pic_rows, .hash = hash };
+}
+
+fn word(hash: u64, j: u32) u32 {
+    return 0x8000_0000 | @as(u32, @truncate((hash *% 0x9E37_79B9_7F4A_7C15 +% j) & 0x7fff_ffff));
+}
+
+fn first(a: std.mem.Allocator, tag: u32, img: ?Image, after: u32, img_buf: *[1]Image) !Turn {
+    var t: std.ArrayList(u32) = .empty;
+    for (0..pic_at - 1) |i| try t.append(a, @intCast(i % 50_000));
+    if (img) |p| {
+        try t.append(a, word(p.hash, 0xffff_0000));
+        for (0..pic_rows) |j| try t.append(a, word(p.hash, @intCast(j)));
+        try t.append(a, word(p.hash, 0xffff_0001));
+    }
+    for (0..after) |i| try t.append(a, 50_000 + @as(u32, @intCast(i % 5000)));
+    for (0..question) |i| try t.append(a, 60_000 + tag * 1000 + @as(u32, @intCast(i)));
+    const user_end: u32 = @intCast(t.items.len);
+    for (0..gen) |i| try t.append(a, 70_000 + @as(u32, @intCast(i)));
+    if (img) |p| img_buf[0] = p;
+    return .{ .tokens = t.items, .images = img_buf[0..@intFromBool(img != null)], .history = user_end, .user = user_at, .user_end = user_end };
+}
+
+fn next(a: std.mem.Allocator, prev: Turn, tag: u32, extra: ?Image, img_buf: *[2]Image) !Turn {
+    var t: std.ArrayList(u32) = .empty;
+    try t.appendSlice(a, prev.tokens);
+    for (0..40) |i| try t.append(a, 80_000 + tag * 100 + @as(u32, @intCast(i)));
+    const user: u32 = @intCast(t.items.len);
+    var n: usize = 0;
+    for (prev.images) |p| {
+        img_buf[n] = p;
+        n += 1;
+    }
+    if (extra) |p| {
+        var q = p;
+        q.at = @intCast(t.items.len + 1);
+        try t.append(a, word(q.hash, 0xffff_0000));
+        for (0..q.tokens) |j| try t.append(a, word(q.hash, @intCast(j)));
+        try t.append(a, word(q.hash, 0xffff_0001));
+        img_buf[n] = q;
+        n += 1;
+    }
+    for (0..20) |i| try t.append(a, 90_000 + tag * 100 + @as(u32, @intCast(i)));
+    const user_end: u32 = @intCast(t.items.len);
+    for (0..gen) |i| try t.append(a, 70_000 + @as(u32, @intCast(i)));
+    return .{ .tokens = t.items, .images = img_buf[0..n], .history = user_end, .user = user, .user_end = user_end };
+}
+
+fn pass(f: *Fake, s: *Store, a: std.mem.Allocator, t: Turn) !u32 {
+    const born: u32 = @intCast(t.tokens.len);
+    const told = t.images.len == 0 or s.image_cut;
+    const l = try s.lookupUserImages(a, t.tokens, born, t.history, if (told) t.user else 0, if (told) t.user_end else 0, &.{}, &.{}, &.{}, t.images);
+    if (l.entry) |e| try served(e, t);
+    var from: u32 = 0;
+    if (l.entry) |e| {
+        from = e.at;
+        s.resumedWithReason(e, t.tokens, null);
+    }
+    for (l.marks) |m| {
+        f.at = m;
+        _ = s.keepBornImages(t.tokens, born, m, null, &.{}, &.{}, t.images);
+    }
+    return from;
+}
+
+fn served(e: *const pc.Entry, t: Turn) !void {
+    try std.testing.expect(e.tokens.len <= t.tokens.len and std.mem.eql(u32, e.tokens, t.tokens[0..e.tokens.len]));
+    var n: usize = 0;
+    for (t.images) |i| if (i.at < e.tokens.len) {
+        try std.testing.expect(n < e.images.len);
+        const k = e.images[n];
+        try std.testing.expect(k.at == i.at and k.tokens == i.tokens and k.gh == i.gh and k.gw == i.gw and k.hash == i.hash);
+        n += 1;
+    };
+    try std.testing.expectEqual(e.images.len, n);
+}
+
+fn store(f: *Fake, cut: bool) Store {
+    var s = Store.init(f.gpa, f.snapshots(), rules, 1 << 40);
+    s.image_cut = cut;
+    return s;
+}
+
+test "pcache image cut: the same text and picture after a next turn resume past the picture on, at nothing off" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |cut| {
+        var f: Fake = .{ .gpa = std.testing.allocator };
+        var s = store(&f, cut);
+        defer s.deinit();
+        var b1: [1]Image = undefined;
+        var b2: [2]Image = undefined;
+        const one = try first(a, 1, picture(7), 3000, &b1);
+        try std.testing.expectEqual(@as(u32, 0), try pass(&f, &s, a, one));
+        const two = try next(a, one, 1, null, &b2);
+        try std.testing.expectEqual(one.history, try pass(&f, &s, a, two));
+        var bb: [1]Image = undefined;
+        const edited = try first(a, 2, picture(7), 3000, &bb);
+        const at = try pass(&f, &s, a, edited);
+        if (cut) try std.testing.expect(at > pic_at + pic_rows);
+        if (!cut) try std.testing.expectEqual(@as(u32, 0), at);
+    }
+}
+
+test "pcache image cut: another picture resumes up to the picture and no further; on, right before its marker" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |cut| {
+        var f: Fake = .{ .gpa = std.testing.allocator };
+        var s = store(&f, cut);
+        defer s.deinit();
+        var b1: [1]Image = undefined;
+        var b2: [1]Image = undefined;
+        const one = try first(a, 1, picture(7), 0, &b1);
+        _ = try pass(&f, &s, a, one);
+        const other = try first(a, 1, picture(8), 0, &b2);
+        const at = try pass(&f, &s, a, other);
+        try std.testing.expect(at <= cut_at);
+        if (cut) try std.testing.expectEqual(cut_at, at);
+        if (!cut) try std.testing.expect(at < cut_at);
+        for (s.entries.items) |e| if (e.at > cut_at and e.tokens.len <= other.tokens.len and std.mem.eql(u32, e.tokens, other.tokens[0..e.tokens.len])) {
+            try std.testing.expect(e.images.len == 1 and e.images[0].hash == 8);
+        };
+    }
+}
+
+test "pcache image cut: a picture added in a later turn resumes past the first picture" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |cut| {
+        var f: Fake = .{ .gpa = std.testing.allocator };
+        var s = store(&f, cut);
+        defer s.deinit();
+        var b1: [1]Image = undefined;
+        var b2: [2]Image = undefined;
+        const one = try first(a, 1, picture(7), 0, &b1);
+        _ = try pass(&f, &s, a, one);
+        const two = try next(a, one, 1, picture(9), &b2);
+        try std.testing.expectEqual(@as(usize, 2), two.images.len);
+        try std.testing.expectEqual(one.history, try pass(&f, &s, a, two));
+    }
+}
+
+test "pcache image cut: the same text with the picture removed resumes before where the picture stood" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |cut| {
+        var f: Fake = .{ .gpa = std.testing.allocator };
+        var s = store(&f, cut);
+        defer s.deinit();
+        var b1: [1]Image = undefined;
+        var b2: [1]Image = undefined;
+        const one = try first(a, 1, picture(7), 0, &b1);
+        _ = try pass(&f, &s, a, one);
+        const plain = try first(a, 1, null, 0, &b2);
+        const at = try pass(&f, &s, a, plain);
+        try std.testing.expectEqual(if (cut) cut_at else @as(u32, 0), at);
+    }
+}
+
+test "pcache image cut: the 11-11 sequence (picture, next turn, other picture) misses off and resumes at the cut on" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |cut| {
+        var f: Fake = .{ .gpa = std.testing.allocator };
+        var s = store(&f, cut);
+        defer s.deinit();
+        var b1: [1]Image = undefined;
+        var b2: [2]Image = undefined;
+        var b3: [1]Image = undefined;
+        const k = try first(a, 1, picture(7), 0, &b1);
+        _ = try pass(&f, &s, a, k);
+        var has_cut = false;
+        for (s.entries.items) |e| has_cut = has_cut or (e.at == cut_at and e.image_cut);
+        try std.testing.expectEqual(cut, has_cut);
+        const k_next = try next(a, k, 1, null, &b2);
+        try std.testing.expectEqual(k.history, try pass(&f, &s, a, k_next));
+        try std.testing.expect(s.evictBut(null, k_next.tokens, @intCast(k_next.tokens.len)));
+        try std.testing.expect(s.evictBut(null, k_next.tokens, @intCast(k_next.tokens.len)));
+        const k2 = try first(a, 1, picture(8), 0, &b3);
+        const at = try pass(&f, &s, a, k2);
+        try std.testing.expectEqual(if (cut) cut_at else @as(u32, 0), at);
+    }
+}
+
+test "pcache image cut: off, a lookup plans exactly the marks it planned before" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = std.testing.allocator };
+    var s = store(&f, false);
+    defer s.deinit();
+    var b1: [1]Image = undefined;
+    const one = try first(a, 1, picture(7), 0, &b1);
+    const l = try s.lookupUserImages(a, one.tokens, @intCast(one.tokens.len), one.history, one.user, one.user_end, &.{}, &.{}, &.{}, one.images);
+    try std.testing.expect(std.mem.indexOfScalar(u32, l.marks, cut_at) == null);
+    s.image_cut = true;
+    const m = try s.lookupUserImages(a, one.tokens, @intCast(one.tokens.len), one.history, one.user, one.user_end, &.{}, &.{}, &.{}, one.images);
+    try std.testing.expectEqual(l.marks.len + 1, m.marks.len);
+    try std.testing.expect(std.mem.indexOfScalar(u32, m.marks, cut_at) != null);
+}
+
+fn both(a: std.mem.Allocator, tag: u32, first_hash: u64, second_hash: u64, img_buf: *[2]Image) !Turn {
+    var t: std.ArrayList(u32) = .empty;
+    for (0..pic_at - 1) |i| try t.append(a, @intCast(i % 50_000));
+    var n: usize = 0;
+    for ([_]u64{ first_hash, second_hash }) |h| {
+        var p = picture(h);
+        p.at = @intCast(t.items.len + 1);
+        try t.append(a, word(h, 0xffff_0000));
+        for (0..pic_rows) |j| try t.append(a, word(h, @intCast(j)));
+        try t.append(a, word(h, 0xffff_0001));
+        img_buf[n] = p;
+        n += 1;
+        if (n == 1) for (0..3000) |i| try t.append(a, 50_000 + @as(u32, @intCast(i % 5000)));
+    }
+    for (0..question) |i| try t.append(a, 60_000 + tag * 1000 + @as(u32, @intCast(i)));
+    const user_end: u32 = @intCast(t.items.len);
+    for (0..gen) |i| try t.append(a, 70_000 + @as(u32, @intCast(i)));
+    return .{ .tokens = t.items, .images = img_buf[0..2], .history = user_end, .user = user_at, .user_end = user_end };
+}
+
+fn parted(x: []const u32, y: []const u32) u32 {
+    return @intCast(std.mem.indexOfDiff(u32, x, y) orelse @min(x.len, y.len));
+}
+
+test "pcache image cut: picture removed where the text's last tokens tokenize otherwise resumes at the cut on" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]u32{ 1, @import("prompt_cache_image_cut.zig").TEXT_TAIL }) |merged| {
+        for ([_]bool{ false, true }) |cut| {
+            var f: Fake = .{ .gpa = std.testing.allocator };
+            var s = store(&f, cut);
+            defer s.deinit();
+            var b1: [1]Image = undefined;
+            var b2: [1]Image = undefined;
+            const one = try first(a, 1, picture(7), 0, &b1);
+            _ = try pass(&f, &s, a, one);
+            const plain = try first(a, 2, null, 0, &b2);
+            for (pic_at - 1 - merged..pic_at - 1) |i| plain.tokens[i] = 49_999;
+            const at = try pass(&f, &s, a, plain);
+            try std.testing.expectEqual(if (cut) cut_at else @as(u32, 0), at);
+            try std.testing.expect(at + rules.lookahead <= parted(one.tokens, plain.tokens));
+        }
+    }
+}
+
+test "pcache image cut: same text and picture, another question resumes at the interior cut past the picture on" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |cut| {
+        var f: Fake = .{ .gpa = std.testing.allocator };
+        var s = store(&f, cut);
+        defer s.deinit();
+        var b1: [1]Image = undefined;
+        var b2: [1]Image = undefined;
+        const one = try first(a, 1, picture(7), 3000, &b1);
+        _ = try pass(&f, &s, a, one);
+        const other = try first(a, 2, picture(7), 3000, &b2);
+        const at = try pass(&f, &s, a, other);
+        if (!cut) try std.testing.expectEqual(@as(u32, 0), at);
+        if (cut) {
+            try std.testing.expectEqual(one.user_end - @import("prompt_interior.zig").QUESTION_TOKENS - rules.lookahead, at);
+            try std.testing.expect(at > pic_at + pic_rows);
+            try std.testing.expect(at + rules.lookahead <= parted(one.tokens, other.tokens));
+        }
+        var b3: [1]Image = undefined;
+        const third = try first(a, 2, picture(8), 3000, &b3);
+        const at3 = try pass(&f, &s, a, third);
+        try std.testing.expect(at3 <= cut_at);
+        if (cut) try std.testing.expectEqual(cut_at, at3);
+    }
+}
+
+test "pcache image cut: two pictures resume past the first only when the first matches and never past a changed one" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |cut| {
+        var f: Fake = .{ .gpa = std.testing.allocator };
+        var s = store(&f, cut);
+        defer s.deinit();
+        var b1: [2]Image = undefined;
+        var b2: [2]Image = undefined;
+        var b3: [2]Image = undefined;
+        var b4: [2]Image = undefined;
+        const one = try both(a, 1, 7, 9, &b1);
+        _ = try pass(&f, &s, a, one);
+        const second_changed = try both(a, 1, 7, 10, &b2);
+        const at = try pass(&f, &s, a, second_changed);
+        try std.testing.expect(at < second_changed.images[1].at);
+        if (cut) try std.testing.expect(at > pic_at + pic_rows);
+        if (!cut) try std.testing.expectEqual(@as(u32, 0), at);
+        const first_changed = try both(a, 1, 8, 9, &b3);
+        const at2 = try pass(&f, &s, a, first_changed);
+        try std.testing.expect(at2 <= cut_at);
+        if (cut) try std.testing.expectEqual(cut_at, at2);
+        const same = try both(a, 2, 7, 9, &b4);
+        const at3 = try pass(&f, &s, a, same);
+        if (cut) try std.testing.expect(at3 > pic_at + pic_rows);
+        try std.testing.expect(at3 + rules.lookahead <= parted(one.tokens, same.tokens));
+    }
+}
+
+test "pcache image cut: on, the interior cut after a picture lands on the chunk grid that starts at the image cut" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = std.testing.allocator };
+    var chunked = rules;
+    chunked.chunk = 512;
+    var s = Store.init(f.gpa, f.snapshots(), chunked, 1 << 40);
+    s.image_cut = true;
+    defer s.deinit();
+    var b1: [1]Image = undefined;
+    var b2: [1]Image = undefined;
+    const one = try first(a, 1, picture(7), 3000, &b1);
+    _ = try pass(&f, &s, a, one);
+    const other = try first(a, 2, picture(7), 3000, &b2);
+    const at = try pass(&f, &s, a, other);
+    const limit = one.user_end - @import("prompt_interior.zig").QUESTION_TOKENS - chunked.lookahead;
+    try std.testing.expect(at > pic_at + pic_rows and at <= limit and limit - at < chunked.chunk);
+    try std.testing.expectEqual(@as(u32, 0), (at - cut_at) % chunked.chunk);
+}
