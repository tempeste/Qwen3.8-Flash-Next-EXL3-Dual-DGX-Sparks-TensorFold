+pub fn digestOf(rope: Rope) Error![32]u8 {
+    if (rope.yarn == null) return @splat(0);
+    var inv: [max_half]f32 = undefined;
+    const h = rope.half();
+    try rope.invFreq(inv[0..h]);
+    var sha = std.crypto.hash.sha2.Sha256.init(.{});
+    sha.update(std.mem.sliceAsBytes(inv[0..h]));
+    const scale_bits: u32 = @bitCast(rope.scale());
+    const window_tokens: u64 = rope.window(trained_window);
+    sha.update(std.mem.asBytes(&scale_bits));
+    sha.update(std.mem.asBytes(&window_tokens));
+    var out: [32]u8 = undefined;
+    sha.final(&out);
+    return out;
+}
+
+pub fn engineDigest() [32]u8 {
+    return digestOf(engine()) catch unreachable;
+}
