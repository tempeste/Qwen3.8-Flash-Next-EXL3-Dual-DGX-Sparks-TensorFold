+        qmmf.dtile = s.dtile;
+        qmmf.out_tile = s.out_tile;
+        qmmf.decode_gemm = s.decode;
+        qmmf.bf16w = s.bf16w;
+        qmmf.bf16w_min_rows = s.min_rows;
+    }
+};
+
+fn production(b: qmmf.Bf16w) void {
+    qmmf.prompt_mx_min_n = 1024;
+    qmmf.mx2_tile = true;
+    qmmf.mx_perm = true;
+    qmmf.tile2 = false;
+    qmmf.fp8mma = false;
+    qmmf.lane_tile = true;
+    qmmf.lane_tile_wide = false;
+    qmmf.dtile = .all;
+    qmmf.out_tile = 0;
+    qmmf.decode_gemm = false;
+    qmmf.bf16w = b;
+    qmmf.bf16w_min_rows = 256;
+}
+
+const Role = enum { delta_in, attn_in, delta_out, attn_out, gate, up, down };
+
+fn chainRole(r: Role) bool {
+    return r == .delta_in or r == .attn_in;
+}
+
+fn perChunk(r: Role) f64 {
+    return switch (r) {
+        .delta_in, .delta_out => 36,
+        .attn_in, .attn_out => 12,
+        .gate, .up, .down => 48,
+    };
+}
+
+const Site = struct {
+    role: Role,
+    layer: usize,
+    q: Q4,
+
+    fn w(s: Site) qmmf.Weight {
+        return s.q.native.?;
+    }
+};
+
+const Sites = struct {
+    list: std.ArrayList(Site) = .empty,
+
+    fn deinit(s: *Sites, a: std.mem.Allocator) void {
+        for (s.list.items) |*x| x.q.free();
+        s.list.deinit(a);
+    }
+
+    fn find(s: *Sites, role: Role, layer: usize) ?*Site {
+        for (s.list.items) |*x| if (x.role == role and x.layer == layer) return x;
+        return null;
+    }
+};
+
+fn loadSites(gpu: check.Gpu, store: *Store, rank: usize, layers: []const usize, sites: *Sites) !void {
+    const heads = try flash.dense_split.heads(store, 2);
+    if (heads.eql(.full)) return error.CheckpointNotHeadSplit;
+    var buf: [200]u8 = undefined;
+    for (layers) |layer| {
+        const linear = layer % 4 != 3;
+        const root = try std.fmt.bufPrint(&buf, "language_model.model.layers.{d}.{s}", .{ layer, if (linear) "linear_attn" else "self_attn" });
+        var root_buf: [120]u8 = undefined;
+        @memcpy(root_buf[0..root.len], root);
+        const pre = root_buf[0..root.len];
+        const st = if (linear) try flash.heads_cut.delta(heads, rank) else try flash.heads_cut.attention(heads, rank);
+        const parts: []const []const u8 = if (linear) &flash.heads_cut.delta_parts else &flash.heads_cut.attention_parts;
+        const in_q = try cuts.loadStitchedCut(gpu.gpa, gpu.d, store, pre, parts, &st.ranges, st.n, dims, st.sk);
+        try sites.list.append(gpu.gpa, .{ .role = if (linear) .delta_in else .attn_in, .layer = layer, .q = in_q });
+        const out_k: usize = 6144;
+        const out_name = try std.fmt.bufPrint(&buf, "{s}.{s}", .{ pre, if (linear) "out_proj" else "o_proj" });
+        const out_q = try cuts.loadCut(gpu.gpa, gpu.d, store, out_name, dims, out_k, try Cut.init(out_k, 2, rank), .cols);
+        try sites.list.append(gpu.gpa, .{ .role = if (linear) .delta_out else .attn_out, .layer = layer, .q = out_q });
+        const mlp = try std.fmt.bufPrint(&buf, "language_model.model.layers.{d}.mlp.shared_expert", .{layer});
+        var mlp_buf: [120]u8 = undefined;
+        @memcpy(mlp_buf[0..mlp.len], mlp);
+        const mp = mlp_buf[0..mlp.len];
+        for ([_]Role{ .gate, .up }, [_][]const u8{ "gate_proj", "up_proj" }) |role, name| {
+            const q = try cuts.loadCut(gpu.gpa, gpu.d, store, try std.fmt.bufPrint(&buf, "{s}.{s}", .{ mp, name }), shared_w, dims, try Cut.init(shared_w, 2, rank), .rows);
+            try sites.list.append(gpu.gpa, .{ .role = role, .layer = layer, .q = q });
+        }
+        const down = try cuts.loadCut(gpu.gpa, gpu.d, store, try std.fmt.bufPrint(&buf, "{s}.down_proj", .{mp}), dims, shared_w, try Cut.init(shared_w, 2, rank), .cols);
+        try sites.list.append(gpu.gpa, .{ .role = .down, .layer = layer, .q = down });
+    }
+}
+
+const Rig = struct {
+    lane: qmmf.Lane,
+    s: cuda.Stream,
+    dx: cuda.DeviceBuffer,
+    dy: cuda.DeviceBuffer,
+    dz: cuda.DeviceBuffer,
+    part: cuda.DeviceBuffer,
+    range: cuda.DeviceBuffer,
+    report: bw.Report = .{},
+
+    fn init(gpu: check.Gpu, x: []const u16, max_m: usize, max_n: usize) !Rig {
+        var lane = try qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+        errdefer lane.unload();
+        var s = try cuda.Stream.init(gpu.d, false);
+        errdefer s.deinit();
+        var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+        errdefer dx.free();
+        var dy = try cuda.DeviceBuffer.alloc(gpu.d, max_m * max_n * 4);
+        errdefer dy.free();
+        var dz = try cuda.DeviceBuffer.alloc(gpu.d, max_m * max_n * 4);
+        errdefer dz.free();
+        var part = try cuda.DeviceBuffer.alloc(gpu.d, 8 * max_m * max_n * 4);
+        errdefer part.free();
+        const init_range = [4]u32{ 255, 0, 255, 0 };
+        const range = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&init_range));
+        return .{ .lane = lane, .s = s, .dx = dx, .dy = dy, .dz = dz, .part = part, .range = range };
+    }
+
+    fn deinit(r: *Rig) void {
+        r.range.free();
+        r.part.free();
+        r.dz.free();
+        r.dy.free();
+        r.dx.free();
+        r.s.deinit();
+        r.lane.unload();
+    }
+
+    fn copy(r: *Rig, gpu: check.Gpu, site: *Site) !void {
+        try bw.copy(gpu.d, r.s, &r.lane, &site.q, if (chainRole(site.role)) .chain else .block, r.range.ptr, &r.report);
+        try r.s.synchronize();
+    }
+
+    fn ranges(r: *Rig) !void {
+        var got: [4]u32 = undefined;
+        try r.range.download(0, std.mem.asBytes(&got));
+        r.report.chain_lo = got[0];
+        r.report.chain_hi = got[1];
+        r.report.block_lo = got[2];
+        r.report.block_hi = got[3];
+    }
+
+    fn take(r: *Rig, buf: cuda.DeviceBuffer, into: []u8) !void {
+        try r.s.synchronize();
+        try buf.download(0, into);
+    }
+
+    fn poison(r: *Rig) !void {
+        try r.dy.fill8(0xff, r.s.handle);
+        try r.dz.fill8(0x7f, r.s.handle);
+    }
+};
+
+fn inputs(gpu: check.Gpu, m: usize, k: usize, ldx: usize, seed: u64) ![]u16 {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rng = prng.random();
+    const x = try gpu.gpa.alloc(u16, m * ldx);
+    @memset(x, 0x7fc0);
+    for (0..m) |row| for (x[row * ldx ..][0..k], 0..) |*v, i| {
+        const g: f32 = @floatCast(rng.floatNorm(f64));
+        const f = if (i % 97 == 5) g * 16 else g;
+        v.* = @truncate(@as(u32, @bitCast(f)) >> 16);
+    };
+    x[0..3].* = .{ 0x7fc0, 0x7f80, 0xff80 };
+    return x;
+}
+
+fn compareChain(r: *Rig, gpu: check.Gpu, site: *Site, m: usize, ldx: usize, out: qmmf.Out) !void {
+    const w0 = site.w();
+    var plain = w0;
+    plain.bw = 0;
+    const bytes = m * w0.n * @as(usize, if (out == .f32) 4 else 2);
+    const want = try gpu.gpa.alloc(u8, bytes);
+    defer gpu.gpa.free(want);
+    const got = try gpu.gpa.alloc(u8, bytes);
+    defer gpu.gpa.free(got);
+    production(.off);
+    try r.poison();
+    try r.lane.matmulPrompt(r.s, r.dx.ptr, ldx, m, plain, r.dy.ptr, out, r.part.ptr);
+    try r.take(r.dy, want);
+    for ([_]bool{ false, true }) |narrow| {
+        try r.lane.promptDtile(r.s, r.dx.ptr, ldx, m, plain, r.dz.ptr, out, narrow);
+        try r.take(r.dz, got);
+        try check.sameBytes("the other dtile chain tile", got, want);
+    }
+    for ([_]qmmf.Bf16w{ .c128, .c256 }) |tile| {
+        try r.poison();
+        try r.lane.bwChain(r.s, r.dx.ptr, ldx, m, w0, r.dz.ptr, out, tile);
+        try r.take(r.dz, got);
+        try check.sameBytes(if (tile == .c128) "bf16-weight 128-column chain against dtile" else "bf16-weight 256-column chain against dtile", got, want);
+        production(tile);
+        try r.poison();
+        try r.lane.matmulPrompt(r.s, r.dx.ptr, ldx, m, w0, r.dz.ptr, out, r.part.ptr);
+        try r.take(r.dz, got);
+        try check.sameBytes("matmulPrompt with TF_FLASHNEXT_PROMPT_BF16W against dtile", got, want);
+        production(.off);
+    }
+}
+
+fn compareBlock(r: *Rig, gpu: check.Gpu, site: *Site, m: usize, ldx: usize, out: qmmf.Out) !bool {
+    const w0 = site.w();
+    var plain = w0;
+    plain.bw = 0;
+    const p = qmmf.planFor(m, plain, r.lane.clusters);
+    production(.off);
+    if (!qmmf.dtileBlockTakes(m, plain, p)) return false;
+    const bytes = m * w0.n * @as(usize, if (out == .f32) 4 else 2);
+    const want = try gpu.gpa.alloc(u8, bytes);
+    defer gpu.gpa.free(want);
+    const got = try gpu.gpa.alloc(u8, bytes);
+    defer gpu.gpa.free(got);
+    try r.poison();
+    try r.lane.matmulOut(r.s, r.dx.ptr, ldx, m, plain, r.dy.ptr, out, r.part.ptr);
+    try r.take(r.dy, want);
+    try r.lane.dtileBlock(r.s, r.dx.ptr, ldx, m, plain, r.dz.ptr, out, p.sk);
+    try r.take(r.dz, got);
+    try check.sameBytes("dtile block through matmulOut and direct", got, want);
+    try r.poison();
+    try r.lane.bwBlock(r.s, r.dx.ptr, ldx, m, w0, r.dz.ptr, out, p.sk);
+    try r.take(r.dz, got);
+    try check.sameBytes("bf16-weight block tile against dtile", got, want);
+    for ([_]qmmf.Bf16w{ .c128, .c256 }) |tile| {
+        production(tile);
+        try r.poison();
+        try r.lane.matmulOut(r.s, r.dx.ptr, ldx, m, w0, r.dz.ptr, out, r.part.ptr);
+        try r.take(r.dz, got);
+        try check.sameBytes("matmulOut with TF_FLASHNEXT_PROMPT_BF16W against dtile", got, want);
+    }
+    production(.off);
+    return true;
+}
+
+fn compareGateUp(r: *Rig, gpu: check.Gpu, gate: *Site, up: *Site, m: usize, ldx: usize) !void {
+    var pg = gate.w();
+    pg.bw = 0;
+    var pu = up.w();
+    pu.bw = 0;
+    const bytes = m * pg.n * 2;
+    const want = try gpu.gpa.alloc(u8, bytes);
+    defer gpu.gpa.free(want);
+    const got = try gpu.gpa.alloc(u8, bytes);
+    defer gpu.gpa.free(got);
+    production(.off);
+    const sk = qmmf.planFor(m, pg, r.lane.clusters).sk;
+    try r.poison();
+    try r.lane.sharedGateUp(r.s, r.dx.ptr, ldx, m, pg, pu, r.dy.ptr);
+    try r.take(r.dy, want);
+    for ([_]bool{ false, true }) |wide| {
+        try r.lane.dtileGateUp(r.s, r.dx.ptr, ldx, m, pg, pu, r.dz.ptr, sk, wide);
+        try r.take(r.dz, got);
+        try check.sameBytes("the other dtile gate+up tile", got, want);
+    }
+    try r.poison();
+    try r.lane.bwGateUp(r.s, r.dx.ptr, ldx, m, gate.w(), up.w(), r.dz.ptr, sk);
+    try r.take(r.dz, got);
+    try check.sameBytes("bf16-weight gate+up+SwiGLU against dtile", got, want);
+    production(.c128);
+    try r.poison();
+    try r.lane.sharedGateUp(r.s, r.dx.ptr, ldx, m, gate.w(), up.w(), r.dz.ptr);
+    try r.take(r.dz, got);
+    try check.sameBytes("sharedGateUp with TF_FLASHNEXT_PROMPT_BF16W against dtile", got, want);
+    production(.off);
+}
+
+const check_layers = [_]usize{ 0, 3, 46, 47 };
+
+pub fn run(gpu: check.Gpu, dir: []const u8) !void {
+    const saved = Saved.now();
+    defer saved.restore();
+    var store = try Store.open(gpu.gpa, gpu.io, dir);
+    defer store.deinit();
+    try store.detectNorms();
+    const max_m = 3072;
+    const ldx = 6144 + 64;
+    const x = try inputs(gpu, max_m, 6144, ldx, 0xbf16_0001);
+    defer gpu.gpa.free(x);
+    var r = try Rig.init(gpu, x, max_m, 8320);
+    defer r.deinit();
+    var compared: usize = 0;
+    for (0..2) |rank| {
+        var sites: Sites = .{};
+        defer sites.deinit(gpu.gpa);
+        try loadSites(gpu, &store, rank, &check_layers, &sites);
+        for (sites.list.items) |*site| {
+            if (site.w().mode != .mxfp8) {
+                std.debug.print("RESULT prompt-bf16w rank {d} layer {d} {s}: {s} weights, not MXFP8: no copy\n", .{ rank, site.layer, @tagName(site.role), @tagName(site.w().mode) });
+                continue;
+            }
+            try r.copy(gpu, site);
+        }
+        for (sites.list.items) |*site| {
+            if (site.w().mode != .mxfp8 or site.role == .gate or site.role == .up) continue;
+            const k = site.w().k;
+            for (check_rows) |m| for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+                if (chainRole(site.role)) {
+                    try compareChain(&r, gpu, site, m, ldx, out);
+                    compared += 1;
+                } else if (try compareBlock(&r, gpu, site, m, ldx, out)) compared += 1;
+            };
+            check.pass("prompt-bf16w rank {d} layer {d} {s} [{d} x {d}]: the bf16-weight tiles equal dtile byte for byte at {d} row counts, bf16 and fp32", .{ rank, site.layer, @tagName(site.role), site.w().n, k, check_rows.len });
+        }
+        for (check_layers) |layer| {
+            const gate = sites.find(.gate, layer) orelse continue;
+            const up = sites.find(.up, layer) orelse continue;
+            if (gate.w().mode != .mxfp8 or up.w().mode != .mxfp8) continue;
+            for (check_rows) |m| if (m >= qmmf.fused_rows) {
+                try compareGateUp(&r, gpu, gate, up, m, ldx);
+                compared += 1;
+            };
+            check.pass("prompt-bf16w rank {d} layer {d} shared gate+up [{d} x {d}]: the bf16-weight tile equals dtile byte for byte", .{ rank, layer, gate.w().n, gate.w().k });
+        }
+    }
+    try r.ranges();
+    try check.expect(compared > 0, "no projection was compared", .{});
+    std.debug.print("RESULT prompt-bf16w {d} calls byte-equal to dtile; chain scale bytes {d}..{d} ({s}), block scale bytes {d}..{d}\n", .{ compared, r.report.chain_lo, r.report.chain_hi, if (r.report.chainExact()) "exact: every e4m3 code times its scale is a bf16" else "outside 3..134", r.report.block_lo, r.report.block_hi });
+    try check.expect(r.report.chainExact(), "chain scale bytes {d}..{d} leave the exact range 3..134", .{ r.report.chain_lo, r.report.chain_hi });
+    try synthetic(gpu);
+}
+
+fn synthetic(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const saved = Saved.now();
+    defer saved.restore();
+    const max_m = 1536;
+    const k = 2560;
+    const ldx = k + 64;
+    const x = try inputs(gpu, max_m, k, ldx, 0xbf16_0002);
+    defer a.free(x);
+    var r = try Rig.init(gpu, x, max_m, 8240);
+    defer r.deinit();
+    var prng = std.Random.DefaultPrng.init(0xbf16_0003);
+    const rng = prng.random();
+    for ([_]usize{ 8240, 1001, 70 }) |n| {
+        const codes = try a.alloc(u8, n * k);
+        defer a.free(codes);
+        rng.bytes(codes);
+        const scales = try a.alloc(u8, n * (k / 32));
+        defer a.free(scales);
+        for (scales) |*v| v.* = rng.uintLessThan(u8, 255);
+        const npad = cuda.mxfp8.padded(n);
+        const pc = try a.alloc(u8, npad * k);
+        defer a.free(pc);
+        cuda.mxfp8.packCodes(pc, codes, n, k);
+        const ps = try a.alloc(u8, npad * (k / 32));
+        defer a.free(ps);
+        cuda.mxfp8.packScales(ps, scales, n, k);
+        var q = Q4.empty(gpu.d);
+        q.w = try cuda.DeviceBuffer.fromHost(gpu.d, pc);
+        q.s = try cuda.DeviceBuffer.fromHost(gpu.d, ps);
+        q.n = n;
+        q.k = k;
+        q.native = cuda.mxfp8.weight(q.w.ptr, q.s.ptr, n, k);
+        for ([_]Role{ .delta_in, .delta_out }) |role| {
+            var site: Site = .{ .role = role, .layer = 0, .q = q };
+            site.q.bw = null;
+            site.q.native.?.bw = 0;
+            try r.copy(gpu, &site);
+            defer if (site.q.bw) |*b| b.free();
+            for ([_]usize{ 1536, 1000, 284, 256 }) |m| for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+                if (role == .delta_in) try compareChain(&r, gpu, &site, m, ldx, out) else _ = try compareBlock(&r, gpu, &site, m, ldx, out);
+            };
+        }
+        q.free();
+    }
+    check.pass("prompt-bf16w: random e4m3 codes (NaN codes included) under scale bytes 0..254 give dtile's bytes on the bf16-weight tiles, chain and block, n 70 to 8240", .{});
+}
+
+const reps = 20;
+
+const Timer = struct {
+    t0: cuda.Event,
+    t1: cuda.Event,
+
+    fn ms(tm: *Timer, s: cuda.Stream, ctx: Call, f: *const fn (Call) anyerror!void) !f64 {
+        var out: f64 = 0;
+        for (0..2) |round| {
+            try tm.t0.record(s);
+            for (0..reps) |_| try f(ctx);
+            try tm.t1.record(s);
+            try tm.t1.synchronize();
+            if (round == 1) out = @as(f64, try cuda.Event.elapsedMs(tm.t0, tm.t1)) / reps;
+        }
+        return out;
+    }
+};
+
+fn tflops(m: usize, n: usize, k: usize, ms: f64) f64 {
+    return 2.0 * @as(f64, @floatFromInt(m)) * @as(f64, @floatFromInt(n)) * @as(f64, @floatFromInt(k)) / (ms * 1e9);
+}
+
+const Call = struct { r: *Rig, m: usize, ldx: usize, w: qmmf.Weight, w2: qmmf.Weight, out: qmmf.Out, tile: qmmf.Bf16w = .off, q27: ?*Q27 = null };
+
+fn prodChain(c: Call) anyerror!void {
+    production(c.tile);
+    try c.r.lane.matmulPrompt(c.r.s, c.r.dx.ptr, c.ldx, c.m, c.w, c.r.dy.ptr, c.out, c.r.part.ptr);
+}
+fn prodBlock(c: Call) anyerror!void {
+    production(c.tile);
+    try c.r.lane.matmulOut(c.r.s, c.r.dx.ptr, c.ldx, c.m, c.w, c.r.dy.ptr, c.out, c.r.part.ptr);
+}
+fn prodGateUp(c: Call) anyerror!void {
+    production(c.tile);
+    try c.r.lane.sharedGateUp(c.r.s, c.r.dx.ptr, c.ldx, c.m, c.w, c.w2, c.r.dy.ptr);
+}
+fn ref27(c: Call) anyerror!void {
+    try c.q27.?.run(c.r.s, c.r.dx.ptr, c.ldx, c.m, c.w.n, c.w.k, c.r.dy.ptr);
+}
+
+const Q27 = struct {
+    mod: cuda.Module,
+    f: cuda.Function,
+    w: cuda.DeviceBuffer,
+    sb: cuda.DeviceBuffer,
+    const smem: u32 = 3 * (128 * 128 + 128 * 32 + 2 * 128 * 2);
+
+    fn init(gpu: check.Gpu, max_n: usize, max_k: usize) !Q27 {
+        var mod = try cuda.Module.load(gpu.d, cuda.kernels.qmm_prefill);
+        errdefer mod.unload();
+        const f = try mod.function(cuda.qlinear.symbols.prefill);
+        try f.allowDynamicShared(smem);
+        const npad = (max_n + 127) / 128 * 128;
+        const words = try gpu.gpa.alloc(u8, npad * max_k / 2);
+        defer gpu.gpa.free(words);
+        var prng = std.Random.DefaultPrng.init(0x27b);
+        prng.random().bytes(words);
+        var w = try cuda.DeviceBuffer.fromHost(gpu.d, words);
+        errdefer w.free();
+        const sv = try gpu.gpa.alloc(u16, 2 * npad * (max_k / 64));
+        defer gpu.gpa.free(sv);
+        for (sv, 0..) |*v, i| v.* = if (i % 2 == 0) 0x3c00 else 0xbc00;
+        const sb = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(sv));
+        return .{ .mod = mod, .f = f, .w = w, .sb = sb };
+    }
+
+    fn deinit(q: *Q27) void {
+        q.sb.free();
+        q.w.free();
+        q.mod.unload();
+    }
+
+    fn run(q: *Q27, s: cuda.Stream, x: u64, ldx: usize, m: usize, n: usize, k: usize, y: u64) !void {
+        const npad = (n + 127) / 128 * 128;
+        const rows_t = (m + 127) / 128;
+        const band = @max(1, @min(rows_t, (12 << 20) / (128 * k * 2)));
+        var args: cuda.Args = .{};
+        args.add(x);
+        args.add(q.w.ptr);
+        args.add(q.sb.ptr);
+        args.add(q.sb.ptr + npad * (k / 64) * 2);
+        args.add(y);
+        for ([_]usize{ m, n, k, npad, ldx, band }) |v| args.add(@as(i32, @intCast(v)));
+        try cuda.launch.launch(q.f, .{ .grid = .{ .x = @intCast(rows_t * ((n + 127) / 128)) }, .block = .{ .x = 256 }, .shared = smem }, s, &args);
+    }
+};
+
+pub fn bench(gpu: check.Gpu, dir: []const u8) !void {
+    const saved = Saved.now();
+    defer saved.restore();
+    var store = try Store.open(gpu.gpa, gpu.io, dir);
+    defer store.deinit();
+    try store.detectNorms();
+    const max_m = 3072;
+    const ldx = 6144;
+    const x = try inputs(gpu, max_m, 6144, ldx, 0xbf16_0004);
+    defer gpu.gpa.free(x);
+    var r = try Rig.init(gpu, x, max_m, 8320);
+    defer r.deinit();
+    var sites: Sites = .{};
+    defer sites.deinit(gpu.gpa);
+    try loadSites(gpu, &store, 0, &.{ 0, 3 }, &sites);
+    for (sites.list.items) |*site| if (site.w().mode == .mxfp8) try r.copy(gpu, site);
+    var q27 = try Q27.init(gpu, 8320, 6144);
+    defer q27.deinit();
+    var tm: Timer = .{ .t0 = try cuda.Event.init(gpu.d, true), .t1 = try cuda.Event.init(gpu.d, true) };
+    defer tm.t0.deinit();
+    defer tm.t1.deinit();
+    std.debug.print("ms a launch (TFLOPS) and ms a 3072-row chunk (a chunk: 36 DeltaNet in and out, 12 attention in and out, 48 shared gate+up and down, scaled by 3072 / rows); dtile = production (PROMPT_DTILE=1, GEMM2, MX_PERM, LANE_TILE); bw1/bw2 = TF_FLASHNEXT_PROMPT_BF16W=1/2; qmm27 = the 27B's 4-bit qmm_prefill tile on the same shape (random codes)\n", .{});
+    for (bench_rows) |m| {
+        const scale = 3072.0 / @as(f64, @floatFromInt(m));
+        var sum = [3]f64{ 0, 0, 0 };
+        var gain = [2]f64{ 0, 0 };
+        for (sites.list.items) |*site| {
+            const w = site.w();
+            if (w.mode != .mxfp8 or site.role == .up) continue;
+            var c: Call = .{ .r = &r, .m = m, .ldx = w.k, .w = w, .w2 = w, .out = if (chainRole(site.role)) .bf16 else .f32, .q27 = &q27 };
+            var t: [3]f64 = undefined;
+            var n = w.n;
+            if (site.role == .gate) {
+                const up = sites.find(.up, site.layer) orelse continue;
+                c.w2 = up.w();
+                n = 2 * w.n;
+                for ([_]qmmf.Bf16w{ .off, .c128, .c256 }, &t) |tile, *v| {
+                    c.tile = tile;
+                    v.* = try tm.ms(r.s, c, &prodGateUp);
+                }
+            } else for ([_]qmmf.Bf16w{ .off, .c128, .c256 }, &t) |tile, *v| {
+                c.tile = tile;
+                v.* = try tm.ms(r.s, c, if (chainRole(site.role)) &prodChain else &prodBlock);
+            }
+            c.tile = .off;
+            const t27 = try tm.ms(r.s, c, &ref27);
+            const per = perChunk(site.role) * scale;
+            for (&sum, t) |*sv, tv| sv.* += tv * per;
+            if (m == 3072 and site.role == .delta_in) gain[0] = t[0] / @min(t[1], t[2]);
+            if (m == 3072 and site.role == .delta_out) gain[1] = t[0] / @min(t[1], t[2]);
+            std.debug.print("RESULT prompt-bf16w-bench rows {d} {s} n {d} k {d}: dtile {d:.3} ({d:.0}) bw1 {d:.3} ({d:.0}) bw2 {d:.3} ({d:.0}) qmm27 {d:.3} ({d:.0}); a chunk dtile {d:.2} ms bw1 {d:.2} bw2 {d:.2}\n", .{ m, @tagName(site.role), n, w.k, t[0], tflops(m, n, w.k, t[0]), t[1], tflops(m, n, w.k, t[1]), t[2], tflops(m, n, w.k, t[2]), t27, tflops(m, n, w.k, t27), t[0] * per, t[1] * per, t[2] * per });
+        }
+        std.debug.print("RESULT prompt-bf16w-bench rows {d} a 3072-row chunk: dtile {d:.2} ms, bw1 {d:.2} ms ({d:.2} saved), bw2 {d:.2} ms ({d:.2} saved)\n", .{ m, sum[0], sum[1], sum[0] - sum[1], sum[2], sum[0] - sum[2] });
+        if (m == 3072) std.debug.print("RESULT prompt-bf16w-kill 3072 rows: DeltaNet in {d:.2}x, out {d:.2}x dtile's speed (kill unless both >= 1.25)\n", .{ gain[0], gain[1] });
+    }
+}
+
+const e2e_chunks = 3;
+
+pub fn e2e(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const knobs = flash.knobs;
+    const given: qmmf.Bf16w = @enumFromInt(@intFromEnum(try knobs.promptBf16w()));
+    if (given == .off) {
+        std.debug.print("FAIL flashnext-prompt-bf16w-e2e needs TF_FLASHNEXT_PROMPT_BF16W=1 or 2 (and TF_FLASHNEXT_PROMPT_DTILE=1) on both ranks\n", .{});
+        return error.TestFailed;
+    }
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const rows = e2e_chunks * chunk;
+    const context = rows + 64;
+    if (context > flash.prompt.max_tokens) return error.BadPrompt;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, rows + 1);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*a, i| a.* = seed.items[i % seed.items.len];
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const e = try flash.prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank);
+    defer e.deinit();
+    defer qmmf.bf16w = given;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * flash.prompt.vocabulary * 2);
+    defer logits.free();
+    const row = flash.prompt.vocabulary * 2;
+    const want_last = try gpu.gpa.alloc(u8, row);
+    defer gpu.gpa.free(want_last);
+    const want_next = try gpu.gpa.alloc(u8, row);
+    defer gpu.gpa.free(want_next);
+    var want_sums: ?img.Sums = null;
+    defer if (want_sums) |*s| s.deinit(gpu.gpa);
+    var ms = [2]f64{ 0, 0 };
+    for ([_]qmmf.Bf16w{ .off, given }, 0..) |arm, ai| {
+        qmmf.bf16w = arm;
+        const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port + @as(u16, @intCast(ai)), rank, identity, flash.rank_engine.linkWait());
+        defer {
+            e.collective = null;
+            session.deinit();
+        }
+        session.engine = e;
+        e.collective = &session.collective;
+        if (knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+        if (rank == 1) {
+            try session.follow(flash.Tri, tri, logits.ptr);
+            check.pass("rank 1 followed the bf16w={d} arm", .{@intFromEnum(arm)});
+            continue;
+        }
+        var q = try session.create(context);
+        defer session.drop(&q);
+        const t0 = check.now(gpu.io);
+        for (0..e2e_chunks) |c| try session.forward(flash.Tri, tri, &q, ids[c * chunk ..][0..chunk], .{ .logits = if (c + 1 == e2e_chunks) .last else .none, .prompt = true });
+        ms[ai] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+        try stream.synchronize();
+        var image = try img.seqImage(gpu.gpa, &q, @as(?*const flash.mtp.Draft, null), rows, .all);
+        defer image.deinit(gpu.gpa);
+        var sums = try image.sums(gpu.gpa);
+        if (ai == 0) {
+            @memcpy(want_last, q.logits);
+            want_sums = sums;
+        } else {
+            defer sums.deinit(gpu.gpa);
+            try check.sameBytes("last row's logits", q.logits, want_last);
+            if (img.Sums.firstDiff(&sums, &want_sums.?)) |d| {
+                std.debug.print("FAIL kept state differs first at {s}, layer {d}\n", .{ d.what, d.layer });
+                return error.TestFailed;
+            }
+        }
+        try session.forward(flash.Tri, tri, &q, ids[rows..][0..1], .{});
+        if (ai == 0) @memcpy(want_next, q.logits) else try check.sameBytes("next row's logits", q.logits, want_next);
+    }
+    if (rank == 1) return;
+    std.debug.print("RESULT flashnext-prompt-bf16w-e2e {d} chunks of {d} rows: last logits, kept state (DeltaNet states, conv windows, tail, keys, values, index blocks) and the next row byte-equal with TF_FLASHNEXT_PROMPT_BF16W={d}; {d:.1} ms off, {d:.1} ms on (one cold run each, includes first-launch costs)\n", .{ e2e_chunks, chunk, @intFromEnum(given), ms[0], ms[1] });
+}
