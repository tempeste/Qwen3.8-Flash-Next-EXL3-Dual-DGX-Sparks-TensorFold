From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shuuul <6903405+shuuul@users.noreply.github.com>
Date: Thu, 5 Nov 2026 10:46:33 +0000
Subject: [PATCH 11/34] cuda: forget the staged download's cached device after
 its tests

Upstream TensorFold commit by shuuul, ported onto this series (upstream main 1d891001b989).

The integrated test cached its reading by the fake driver's address;
a later test whose fake lands there would reuse it and call
cuMemHostAlloc on a table that does not set it. Both tests clear it.

(cherry picked from commit 1d891001b989172be772e6e14f6a63ce596d387d)
---
 zig/src/cuda/download_stage_test.zig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/zig/src/cuda/download_stage_test.zig b/zig/src/cuda/download_stage_test.zig
index a0c493e9e0030d847444e5c4fa7d2ca5f6441720..0cdb01f4646009a555c365f238bd148b94c397e5 100644
--- a/zig/src/cuda/download_stage_test.zig
+++ b/zig/src/cuda/download_stage_test.zig
@@ -57,6 +57,7 @@ test "an integrated GPU's download lands in pinned memory, not the caller's page
     allocations = 0;
     stage.forget();
     stage.drop();
+    defer stage.forget();
     defer stage.drop();
     const before = memory.usage(false).host;
     var d = driver();
@@ -75,6 +76,7 @@ test "a discrete GPU's download copies straight into the caller's slice" {
     allocations = 0;
     stage.forget();
     stage.drop();
+    defer stage.forget();
     defer stage.drop();
     var d = driver();
     var out: [64]u8 = @splat(0xaa);
