From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Armin <2369138+Arminova@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:45:25 +0000
Subject: [PATCH] cuda route_rows: tf_route_logits_wide walks the expert blocks
 first, so a row tile's input rows are read once

Upstream TensorFold commit by Armin, ported onto this series (see the note below for its upstream source).

Part of upstream 2a92fb6c9 (#1764): the wide router tile's grid swaps x and y (x the expert blocks, y the
128-row tiles), so the blocks of one row tile run together and its input rows come from DRAM once. Each
block computes the same sums as before: same bits. The route_rows contract test launches the new grid.

(cherry picked from commit 2a92fb6c9e87bad0053117ba2e008dde2ba5761b, route_rows hunks only)
---
 zig/kernels/cuda/route_rows.cu         | 8 ++++----
 zig/src/cuda/route_rows.zig            | 4 ++--
 zig/tests/cuda/contract_route_rows.zig | 2 +-
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/zig/kernels/cuda/route_rows.cu b/zig/kernels/cuda/route_rows.cu
index 66e3bb86f1eb175e3107a43e4b1f83aca62a3116..77c1575ca253658743e71e10b09b9b8d129e71e2 100644
--- a/zig/kernels/cuda/route_rows.cu
+++ b/zig/kernels/cuda/route_rows.cu
@@ -46,13 +46,13 @@ __device__ __forceinline__ void block_best(float& v, int& i, float (*sv)[NT / 32
 using namespace tf_route;
 
 // OUT[m, e] = x[m] . w[e], 8 experts a warp, RT tiles of 16 rows, one mma chain over K, STAGES of KC (row sums fixed).
-template <int WARPS, int STAGES, int KC, int RT = 1>
+template <int WARPS, int STAGES, int KC, int RT = 1, bool EFAST = false>  // EFAST: x walks the expert blocks, rows read once
 __device__ __forceinline__ void route_logits(const __nv_bfloat16* __restrict__ X, int x_ld, const __nv_bfloat16* __restrict__ W,
                                              float* __restrict__ OUT, int M, int D, int E) {
     constexpr int LD = KC + 8, EB = 8 * WARPS, XR = 16 * RT, ROWS = XR + EB;
     extern __shared__ __align__(16) unsigned char smem_raw[];
     auto tile = reinterpret_cast<__nv_bfloat16 (*)[ROWS][LD]>(smem_raw);  // [STAGES] XR input rows, then EB expert rows
-    const int m0 = blockIdx.x * XR, e0 = blockIdx.y * EB;
+    const int m0 = (EFAST ? blockIdx.y : blockIdx.x) * XR, e0 = (EFAST ? blockIdx.x : blockIdx.y) * EB;
     const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
     const int stages = (D + KC - 1) / KC;
     const int xr = min(XR, M - m0);  // input rows past M stay zero: written once, never staged
@@ -116,11 +116,11 @@ extern "C" __global__ void __launch_bounds__(128) tf_route_logits(const __nv_bfl
     route_logits<4, 2, 128>(X, x_ld, W, OUT, M, D, E);
 }
 
-// route_logits over 128 rows and 64 experts a block, eight warps (from 64 rows), the same sums.
+// route_logits over 128 rows and 64 experts a block, eight warps (from 64 rows), the same sums; EFAST block order.
 extern "C" __global__ void __launch_bounds__(256) tf_route_logits_wide(const __nv_bfloat16* __restrict__ X, int x_ld,
                                                                        const __nv_bfloat16* __restrict__ W, float* __restrict__ OUT,
                                                                        int M, int D, int E) {
-    route_logits<8, 2, 64, 8>(X, x_ld, W, OUT, M, D, E);
+    route_logits<8, 2, 64, 8, true>(X, x_ld, W, OUT, M, D, E);
 }
 
 // route_logits with three stages of 256 in flight (up to 16 rows, where the router rows' reads set its time).
diff --git a/zig/src/cuda/route_rows.zig b/zig/src/cuda/route_rows.zig
index 75c1f71ccd42ba7ffdba153a22da4bb88f4d668d..81a5057988825358981657dd3dce9fe5dcb174bd 100644
--- a/zig/src/cuda/route_rows.zig
+++ b/zig/src/cuda/route_rows.zig
@@ -60,8 +60,8 @@ pub const RouteRows = struct {
         // up to 16 rows, deeper staging (the same sums: the router rows' reads set the time)
         const few = rows <= 16;
         if (rows >= 64) {
-            // 128 rows and 64 experts a block: each router row read once per 128 input rows (the same sums)
-            try launch_.launch(g.wide_fn, .{ .grid = .{ .x = @intCast((rows + 127) / 128), .y = @intCast((e + 63) / 64), .z = 1 }, .block = .{ .x = 256 }, .shared = wide_shared }, s, &a);
+            // 128 rows and 64 experts a block (the same sums); x walks the expert blocks: a row tile's run together
+            try launch_.launch(g.wide_fn, .{ .grid = .{ .x = @intCast((e + 63) / 64), .y = @intCast((rows + 127) / 128), .z = 1 }, .block = .{ .x = 256 }, .shared = wide_shared }, s, &a);
             return;
         }
         try launch_.launch(if (few) g.few_fn else g.logits_fn, .{ .grid = .{ .x = @intCast((rows + 15) / 16), .y = @intCast((e + 31) / 32), .z = 1 }, .block = .{ .x = 128 }, .shared = if (few) few_shared else many_shared }, s, &a);
diff --git a/zig/tests/cuda/contract_route_rows.zig b/zig/tests/cuda/contract_route_rows.zig
index e73f8fbc17017fb51e10d40ad4167f8081874209..f2189666f79a1919b4313fa0b77934aa48696c98 100644
--- a/zig/tests/cuda/contract_route_rows.zig
+++ b/zig/tests/cuda/contract_route_rows.zig
@@ -93,7 +93,7 @@ pub const Logits = struct {
         for ([_]usize{ sh.rows, sh.k, sh.n }) |v| a.add(@as(i32, @intCast(v)));
         const r = self.route;
         switch (kind) {
-            .wide => try cuda.launch.launch(r.wide_fn, .{ .grid = .{ .x = @intCast((sh.rows + 127) / 128), .y = @intCast((sh.n + 63) / 64) }, .block = .{ .x = 256 }, .shared = rr.wide_shared }, self.rig.s, &a),
+            .wide => try cuda.launch.launch(r.wide_fn, .{ .grid = .{ .x = @intCast((sh.n + 63) / 64), .y = @intCast((sh.rows + 127) / 128) }, .block = .{ .x = 256 }, .shared = rr.wide_shared }, self.rig.s, &a),
             .few => try cuda.launch.launch(r.few_fn, .{ .grid = .{ .x = @intCast((sh.rows + 15) / 16), .y = @intCast((sh.n + 31) / 32) }, .block = .{ .x = 128 }, .shared = rr.few_shared }, self.rig.s, &a),
             .logits => try cuda.launch.launch(r.logits_fn, .{ .grid = .{ .x = @intCast((sh.rows + 15) / 16), .y = @intCast((sh.n + 31) / 32) }, .block = .{ .x = 128 }, .shared = rr.many_shared }, self.rig.s, &a),
         }
