diff --git a/zig/src/families/flashnext/cuda_exl3_prompt.zig b/zig/src/families/flashnext/cuda_exl3_prompt.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0613820e7c57939f0e65aa485596e49606391580
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_exl3_prompt.zig
@@ -0,0 +1,154 @@
+//! TF_EXL3_PROMPT_ROWS=n: TF_FLASHNEXT_EXPERTS_EXL3's routed experts on passes of n rows or more through x3gm v2's
+//! 64-member items (exl3_fnx_prompt.cuh): each item decodes its expert's 128-column block once for up to 64 pairs and
+//! runs one fp32 mma chain an output with the epilogues fused, where the grouped (decode) kernels decode it once a 16
+//! pairs and sum split-K partials. Three launches after the route: the gate and up inputs' rotation, gate/up (bf16 act
+//! rows and the rotated down input) and down (fp32 y rows), the contract moe_native.exl3's grouped path keeps.
+//! Unset: 256 rows. 0: never (every pass through the grouped kernels). TF_EXL3_PROMPT_DN=v3 (default: x3gm v3's 8-warp
+//! down tile) or dn0 (GM_DN0's 4 warps): the down kernel's tile; both write the same bits.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const ex = cuda.exl3_experts;
+
+/// Members an item holds at most: the route's tile for this path (the kernels' 64-member passes).
+pub const members: usize = 64;
+/// The half-bit widths the kernels dispatch (exl3_fnx_prompt.cuh FNX_CASE): 2, 2.5, 3 and 4 bpw.
+pub const widths = [_]u32{ 4, 5, 6, 8 };
+pub const default_rows: usize = 256;
+
+pub const Down = enum { v3, dn0 };
+
+/// TF_EXL3_PROMPT_ROWS: unset 256, 0 never (returned as 0), else the rows from which a pass takes this path.
+pub fn rowsFrom(value: ?[*:0]const u8) !usize {
+    const v = std.mem.span(value orelse return default_rows);
+    return std.fmt.parseInt(usize, v, 10) catch error.BadExl3PromptRows;
+}
+
+/// TF_EXL3_PROMPT_DN: v3 (unset) or dn0.
+pub fn downFrom(value: ?[*:0]const u8) !Down {
+    const v = std.mem.span(value orelse return .v3);
+    return std.meta.stringToEnum(Down, v) orelse error.BadExl3PromptDown;
+}
+
+/// Whether a pass of `n` rows takes this path: rows at or past the switch, and a layer the kernels take.
+pub fn takes(rows: usize, n: usize, layer_ok: bool) bool {
+    return rows != 0 and n >= rows and layer_ok;
+}
+
+/// Whether one expert's gate, up and down widths are ones the kernels take, gate's and up's equal (one item decodes both
+/// at one width).
+pub fn expertOk(gate: u32, up: u32, down: u32) bool {
+    if (gate != up) return false;
+    for ([_]u32{ gate, down }) |h| if (std.mem.indexOfScalar(u32, &widths, h) == null) return false;
+    return true;
+}
+
+/// exl3_fnx_prompt.cuh's FnxArgs: x3gm's Args (exl3_block_x3gm.GmArgs' fields), then the Grouped plan and act.
+pub const Args = extern struct {
+    x0: u64 = 0,
+    x1: u64 = 0,
+    t0: u64 = 0,
+    t1: u64 = 0,
+    tp0: u64 = 0,
+    tp1: u64 = 0,
+    k2e: u64 = 0,
+    order: u64 = 0,
+    pe: u64 = 0,
+    poff: u64 = 0,
+    pcnt: u64 = 0,
+    npass: u64 = 0,
+    ticket: u64 = 0,
+    sv0: u64 = 0,
+    sv1: u64 = 0,
+    sd: u64 = 0,
+    xd: u64 = 0,
+    y: u64 = 0,
+    K: c_int = 0,
+    N: c_int = 0,
+    limit: f32 = 0,
+    items: u64 = 0,
+    counts: u64 = 0,
+    members: u64 = 0,
+    k2u: u64 = 0,
+    act: u64 = 0,
+    skip: c_int = 0,
+};
+
+comptime {
+    std.debug.assert(@sizeOf(Args) == 208 and @offsetOf(Args, "K") == 144 and @offsetOf(Args, "limit") == 152 and @offsetOf(Args, "items") == 160 and @offsetOf(Args, "skip") == 200);
+}
+
+/// Scratch the path takes for `cap` pairs: the gate and up inputs [cap, dims] fp16 and the down input [cap, width] fp16.
+pub fn scratchBytes(dims: usize, width: usize, cap: usize) usize {
+    return cap * (4 * dims + 2 * width);
+}
+
+/// The rank's routed experts of `pairs` pairs (`p` routed in `members`-pair items, at most `items` of them): act [pairs,
+/// width] bf16 and y [pairs, dims] fp32 rows of the pairs routed here; `storage` holds scratchBytes for `cap` pairs.
+pub fn run(k: *const ex.Experts, s: cuda.Stream, w: ex.Layer, storage: u64, storage_len: usize, cap: usize, x: u64, stride: usize, slots: usize, picks: u64, p: cuda.grouped.Plan, act: u64, y: u64, pairs: usize, items: usize, skip: i32, dn: Down) !void {
+    if (w.codebook != .mul1 or w.act_mode != 1 or w.limit != 0 or w.gu_stride != 0) return error.Exl3Shape;
+    if (w.dims % 128 != 0 or w.width % 128 != 0 or (w.dims / 16) % 2 != 0 or (w.width / 16) % 4 != 0) return error.Exl3Shape;
+    if (pairs > cap or scratchBytes(w.dims, w.width, cap) > storage_len or stride < w.dims) return error.Exl3ScratchShort;
+    if (pairs == 0 or items == 0) return;
+    const x0 = storage;
+    const x1 = x0 + cap * w.dims * 2;
+    const xd = x1 + cap * w.dims * 2;
+    const i = struct {
+        fn f(v: usize) c_int {
+            return @intCast(v);
+        }
+    }.f;
+    var rot: cuda.Args = .{};
+    rot.add(x);
+    rot.add(i(stride));
+    for ([_]u64{ picks, w.suh_g, w.suh_u, x0, x1 }) |v| rot.add(v);
+    for ([_]usize{ w.dims, slots, pairs }) |v| rot.add(i(v));
+    rot.add(skip);
+    const warps = pairs * (w.dims / 128);
+    try cuda.launch.launch(k.fnx_rotate, .{ .grid = .{ .x = @intCast((warps + 7) / 8) }, .block = .{ .x = 256 } }, s, &rot);
+
+    const gu: Args = .{ .x0 = x0, .x1 = x1, .tp0 = w.gate, .tp1 = w.up, .k2e = w.gate_k2, .sv0 = w.svh_g, .sv1 = w.svh_u, .sd = w.suh_d, .xd = xd, .K = i(w.dims), .N = i(w.width), .items = p.items, .counts = p.counts, .members = p.members, .k2u = w.up_k2, .act = act, .skip = skip };
+    var ga: cuda.Args = .{};
+    ga.add(gu);
+    try cuda.launch.launch(k.fnx_gu, .{ .grid = .{ .x = @intCast(items * (w.width / 128)) }, .block = .{ .x = 256 }, .shared = ex.fnx_smem }, s, &ga);
+
+    const down: Args = .{ .x0 = xd, .x1 = xd, .tp0 = w.down, .tp1 = w.down, .k2e = w.down_k2, .sv0 = w.svh_d, .y = y, .K = i(w.width), .N = i(w.dims), .items = p.items, .counts = p.counts, .members = p.members, .skip = skip };
+    var da: cuda.Args = .{};
+    da.add(down);
+    const f = if (dn == .v3) k.fnx_dn else k.fnx_dn0;
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(items * (w.dims / 128)) }, .block = .{ .x = if (dn == .v3) 256 else 128 }, .shared = ex.fnx_smem }, s, &da);
+}
+
+test "TF_EXL3_PROMPT_ROWS: 256 unset, 0 never, a row count, nothing else" {
+    try std.testing.expectEqual(default_rows, try rowsFrom(null));
+    try std.testing.expectEqual(@as(usize, 0), try rowsFrom("0"));
+    try std.testing.expectEqual(@as(usize, 1536), try rowsFrom("1536"));
+    try std.testing.expectError(error.BadExl3PromptRows, rowsFrom("x"));
+    try std.testing.expectError(error.BadExl3PromptRows, rowsFrom(""));
+    try std.testing.expect(!takes(0, 4096, true));
+    try std.testing.expect(!takes(256, 255, true));
+    try std.testing.expect(takes(256, 256, true));
+    try std.testing.expect(!takes(256, 4096, false));
+}
+
+test "TF_EXL3_PROMPT_DN takes v3 (the default) or dn0" {
+    try std.testing.expectEqual(Down.v3, try downFrom(null));
+    try std.testing.expectEqual(Down.dn0, try downFrom("dn0"));
+    try std.testing.expectError(error.BadExl3PromptDown, downFrom("4"));
+}
+
+test "the prompt path takes an expert at 2, 2.5, 3 or 4 bpw with gate and up at one width" {
+    try std.testing.expect(expertOk(5, 5, 5));
+    try std.testing.expect(expertOk(6, 6, 8));
+    try std.testing.expect(!expertOk(5, 6, 5));
+    try std.testing.expect(!expertOk(7, 7, 7));
+    try std.testing.expect(!expertOk(5, 5, 10));
+}
+
+test "the prompt path's scratch fits in the grouped kernels' reservation for the same pairs" {
+    const g = cuda.exl3_grouped.Grouped;
+    for ([_]usize{ 1, 70 * 11, 4096 * 11 }) |cap| {
+        const up = try g.pairBytes(2560, 640, cap, try ex.plan(2560, 640, true), 2);
+        try std.testing.expect(scratchBytes(2560, 640, cap) <= up);
+    }
+}
diff --git a/zig/src/families/flashnext/cuda_exl3_routed.zig b/zig/src/families/flashnext/cuda_exl3_routed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7450fef7080e785de7e36bdb6c71ac37836bd784
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_exl3_routed.zig
@@ -0,0 +1,189 @@
+//! A rank's EXL3 routed experts as one device image: trellises, pointer tables, widths and stacked fp16 scales.
+const std = @import("std");
+const cuda = @import("cuda");
+const routed = @import("cuda_modelopt_experts.zig");
+
+const exl3e = cuda.exl3_experts;
+const prompt = @import("cuda_exl3_prompt.zig");
+
+pub const hadamard: usize = 128;
+pub const tile: usize = 16;
+pub const align_bytes: usize = 256;
+
+pub const Proj = enum(u2) { gate = 0, up = 1, down = 2 };
+
+/// One projection's source tensors: the int16 trellis, fp16 suh [k] and svh [n], and its half-bit width.
+pub const Source = struct { trellis: []const u8, suh: []const u8, svh: []const u8, halves: u32 };
+
+pub fn kn(p: Proj, dims: usize, width: usize) [2]usize {
+    return if (p == .down) .{ width, dims } else .{ dims, width };
+}
+
+/// Trellis bytes of a k x n projection at `halves` half-bits a weight: halves * 8 int16 words a 16 x 16 tile.
+pub fn trellisBytes(k: usize, n: usize, halves: u32) !usize {
+    if (k == 0 or n == 0 or k % hadamard != 0 or n % hadamard != 0) return error.Exl3Shape;
+    if (halves < 2 or halves > 16) return error.Exl3Width;
+    return (k / tile) * (n / tile) * @as(usize, halves) * tile;
+}
+
+fn up256(n: usize) usize {
+    return (n + align_bytes - 1) / align_bytes * align_bytes;
+}
+
+/// Where every part of one rank's layer lives in its image; `halves` is [3][count], gate then up then down.
+pub const Layout = struct {
+    count: usize,
+    dims: usize,
+    width: usize,
+    trellis: [3][]usize,
+    ptrs: [3]usize,
+    k2: [3]usize,
+    suh: [3]usize,
+    svh: [3]usize,
+    total: usize,
+    /// Every expert's widths are ones TF_EXL3_PROMPT_ROWS's kernels take (cuda_exl3_prompt.expertOk).
+    prompt_ok: bool,
+
+    pub fn init(a: std.mem.Allocator, dims: usize, width: usize, halves: [3][]const u32) !Layout {
+        const count = halves[0].len;
+        if (count == 0 or halves[1].len != count or halves[2].len != count) return error.BadExperts;
+        var l: Layout = .{ .count = count, .dims = dims, .width = width, .trellis = undefined, .ptrs = undefined, .k2 = undefined, .suh = undefined, .svh = undefined, .total = 0, .prompt_ok = true };
+        for (0..count) |e| l.prompt_ok = l.prompt_ok and prompt.expertOk(halves[0][e], halves[1][e], halves[2][e]);
+        var made: usize = 0;
+        errdefer for (l.trellis[0..made]) |t| a.free(t);
+        var at: usize = 0;
+        for (0..3) |p| {
+            l.trellis[p] = try a.alloc(usize, count);
+            made += 1;
+            const s = kn(@fromBackingInt(@intCast(p)), dims, width);
+            for (halves[p], 0..) |h, e| {
+                l.trellis[p][e] = at;
+                at += up256(try trellisBytes(s[0], s[1], h));
+            }
+        }
+        for (0..3) |p| {
+            l.ptrs[p] = at;
+            at += up256(count * 8);
+            l.k2[p] = at;
+            at += up256(count * 4);
+        }
+        for (0..3) |p| {
+            const s = kn(@fromBackingInt(@intCast(p)), dims, width);
+            l.suh[p] = at;
+            at += up256(count * s[0] * 2);
+            l.svh[p] = at;
+            at += up256(count * s[1] * 2);
+        }
+        l.total = at;
+        return l;
+    }
+
+    pub fn deinit(l: *Layout, a: std.mem.Allocator) void {
+        for (l.trellis) |t| a.free(t);
+        l.* = undefined;
+    }
+
+    /// Writes expert `e`'s projection `p` into the host image `img` (the layout's total bytes, `base` its device address).
+    pub fn put(l: Layout, img: []u8, base: u64, p: Proj, e: usize, src: Source, halves: u32) !void {
+        if (img.len != l.total or e >= l.count) return error.BadExperts;
+        const i = @backingInt(p);
+        const s = kn(p, l.dims, l.width);
+        const tb = try trellisBytes(s[0], s[1], halves);
+        if (src.trellis.len != tb or src.suh.len != s[0] * 2 or src.svh.len != s[1] * 2 or src.halves != halves) return error.BadExperts;
+        const at = l.trellis[i][e];
+        @memcpy(img[at..][0..tb], src.trellis);
+        std.mem.writeInt(u64, img[l.ptrs[i] + e * 8 ..][0..8], base + at, .little);
+        std.mem.writeInt(i32, img[l.k2[i] + e * 4 ..][0..4], @intCast(halves), .little);
+        @memcpy(img[l.suh[i] + e * s[0] * 2 ..][0 .. s[0] * 2], src.suh);
+        @memcpy(img[l.svh[i] + e * s[1] * 2 ..][0 .. s[1] * 2], src.svh);
+    }
+
+    /// The kernels' layer over the image at `base`: Qwen's unclamped SwiGLU with fp32 silu(gate) * up (qwen3_5's mode).
+    pub fn layer(l: Layout, base: u64, act_mode: i32) exl3e.Layer {
+        return .{
+            .gate = base + l.ptrs[0],
+            .up = base + l.ptrs[1],
+            .down = base + l.ptrs[2],
+            .gate_k2 = base + l.k2[0],
+            .up_k2 = base + l.k2[1],
+            .down_k2 = base + l.k2[2],
+            .suh_g = base + l.suh[0],
+            .suh_u = base + l.suh[1],
+            .svh_g = base + l.svh[0],
+            .svh_u = base + l.svh[1],
+            .suh_d = base + l.suh[2],
+            .svh_d = base + l.svh[2],
+            .experts = l.count,
+            .dims = l.dims,
+            .width = l.width,
+            .codebook = .mul1,
+            .limit = 0,
+            .act_mode = act_mode,
+        };
+    }
+
+    pub fn view(l: Layout, base: u64, act_mode: i32) cuda.experts.Layer {
+        return .{ .format = .exl3, .exl3 = l.layer(base, act_mode), .up = 0, .down = 0, .width = l.width, .dims = l.dims, .experts = l.count, .swiglu = true };
+    }
+};
+
+/// Device bytes of a rank's whole experts for one layer at one uniform width (the memory ledger's EXL3 term).
+pub fn rankLayerBytes(a: std.mem.Allocator, total: usize, world: usize, rank: usize, dims: usize, width: usize, halves: u32) !usize {
+    const own = try routed.Experts.init(total, world, rank);
+    const hs = try a.alloc(u32, own.count);
+    defer a.free(hs);
+    @memset(hs, halves);
+    var l = try Layout.init(a, dims, width, .{ hs, hs, hs });
+    defer l.deinit(a);
+    return l.total;
+}
+
+test "exl3 routed: trellis bytes follow the half-bit width and refuse shapes the Hadamard blocks cannot cover" {
+    try std.testing.expectEqual(@as(usize, 614_400), try trellisBytes(2560, 640, 6));
+    try std.testing.expectEqual(@as(usize, 512_000), try trellisBytes(640, 2560, 5));
+    try std.testing.expectEqual(@as(usize, 819_200), try trellisBytes(2560, 640, 8));
+    try std.testing.expectError(error.Exl3Shape, trellisBytes(2560, 600, 6));
+    try std.testing.expectError(error.Exl3Width, trellisBytes(2560, 640, 1));
+}
+
+test "exl3 routed: a Flash Next rank's 3-bit layer is about two thirds of its NVFP4 bytes" {
+    const a = std.testing.allocator;
+    const r0 = try rankLayerBytes(a, 512, 2, 0, 2560, 640, 6);
+    const r1 = try rankLayerBytes(a, 512, 2, 1, 2560, 640, 6);
+    try std.testing.expectEqual(r0, r1);
+    const nvfp4 = 256 * 3 * 921_600;
+    try std.testing.expect(r0 > 256 * 1_862_400);
+    try std.testing.expect(r0 < 256 * 1_862_400 + 64 * 1024);
+    try std.testing.expect(r0 * 100 / nvfp4 == 67);
+    const half = try rankLayerBytes(a, 512, 2, 0, 2560, 640, 5);
+    try std.testing.expect(half * 100 / nvfp4 == 56);
+}
+
+test "exl3 routed: put fills the pointer table, widths and stacked scales of an expert" {
+    const a = std.testing.allocator;
+    const dims = 256;
+    const width = 128;
+    const hs = [_]u32{ 6, 5 };
+    var l = try Layout.init(a, dims, width, .{ &hs, &hs, &hs });
+    defer l.deinit(a);
+    const img = try a.alloc(u8, l.total);
+    defer a.free(img);
+    @memset(img, 0);
+    const base: u64 = 0x7000_0000;
+    const tb = try trellisBytes(width, dims, 5);
+    const tr = try a.alloc(u8, tb);
+    defer a.free(tr);
+    @memset(tr, 0xab);
+    const su: [width * 2]u8 = @splat(1);
+    const sv: [dims * 2]u8 = @splat(2);
+    try l.put(img, base, .down, 1, .{ .trellis = tr, .suh = &su, .svh = &sv, .halves = 5 }, 5);
+    try std.testing.expectEqual(base + l.trellis[2][1], std.mem.readInt(u64, img[l.ptrs[2] + 8 ..][0..8], .little));
+    try std.testing.expectEqual(@as(i32, 5), std.mem.readInt(i32, img[l.k2[2] + 4 ..][0..4], .little));
+    try std.testing.expectEqual(@as(u8, 0xab), img[l.trellis[2][1]]);
+    try std.testing.expectEqual(@as(u8, 2), img[l.svh[2] + dims * 2]);
+    try std.testing.expectError(error.BadExperts, l.put(img, base, .down, 1, .{ .trellis = tr, .suh = &su, .svh = &sv, .halves = 5 }, 6));
+    for (l.trellis) |t| for (t) |off| try std.testing.expect(off % align_bytes == 0);
+    const v = l.view(base, 1);
+    try std.testing.expectEqual(cuda.experts.Format.exl3, v.format);
+    try std.testing.expectEqual(base + l.svh[2], v.exl3.?.svh_d);
+}
