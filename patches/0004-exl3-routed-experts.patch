+extern "C" __global__ void __launch_bounds__(256) tf_exl3_fnx_rotate(const __nv_bfloat16* __restrict__ x, int x_stride,
+        const int* __restrict__ picks, const half* __restrict__ suh_g, const half* __restrict__ suh_u, half* __restrict__ x0,
+        half* __restrict__ x1, int K, int slots, int pairs, int skip) {
+    const int item = blockIdx.x * 8 + (threadIdx.x >> 5);
+    const int KB = K >> 7;
+    if (item >= pairs * KB) return;
+    const int p = item / KB, blk = item % KB, lane = threadIdx.x & 31;
+    const int e = picks[p];
+    if (e < 0 || e >= skip) return;
