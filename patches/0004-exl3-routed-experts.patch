@@ -0,0 +1,737 @@
+//! TF_FLASHNEXT_EXPERTS_EXL3 on the device: moe_native.exl3 at Flash Next's shapes against FP64 (both ranks on
+//! synthetic experts, then this host's rank of the staged pack), decode shapes through the grouped kernels and prompt
+//! shapes through TF_EXL3_PROMPT_ROWS's kernels (cuda_exl3_prompt.zig), and `flashnext-exl3-bench`: EXL3 against NVFP4
+//! grouped experts at a --tp 2 rank's 256 experts.
+//!
+//! Both commands take PACK RANK: an experts-only EXL3 folder (its model.safetensors.index.json, manifest.json
+//! and each rank's expert files) and the rank whose files this host holds (0 on the head, 1 on the worker). Before any
+//! GPU work they check the folder's index, its manifest and every file the manifest lists for RANK at its size, and exit
+//! at once when one is missing. Each step prints a "STEP +s" line as it ends, and a watchdog thread ends the process
+//! with status 124 after `deadline_s` (a step that never returns cannot outlive the run's timeout unseen).
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const D = 2560; // dims
+const NI = 640; // expert width
+const slots = 11; // ten routed picks a row, then the shared slot
+const picked = slots - 1;
+const global = 512; // routed experts across both ranks
+const layout = flash.exl3_routed;
+const X = flash.exl3_experts;
+const projs = [3][]const u8{ "gate_proj", "up_proj", "down_proj" };
+
+/// Seconds after which the watchdog ends the process (status 124): the bench finishes in about 2 min on a GB10 and the
+/// check, with its prompt shapes, in about 3 (estimated); a 600 s timeout applies, so the test names the hang
+/// itself first.
+const deadline_s = 540;
+
+/// A rank's experts in the synthetic check, alternating 2.5 and 3 bpw (a width mix-up shows). Two ranks' worth must
+/// hold ten distinct picks a row: with fewer, localPicks could never finish a row.
+const fixture_count = 6;
+const fixture_halves = [fixture_count]u32{ 5, 6, 5, 6, 5, 6 };
+comptime {
+    std.debug.assert(2 * fixture_count >= picked);
+}
+
+/// The pack's layers the device check and the bench load: an edge layer (3.0 bpw in the 2.68 bpw self-calibrated quant), a middle one (2.5 bpw),
+/// and the MTP head's (all 512 experts, rank 0 only).
+const Real = struct { label: []const u8, prefix: []const u8, world: usize };
+const real_layers = [_]Real{
+    .{ .label = "layer 0", .prefix = "language_model.model.layers.0.mlp", .world = 2 },
+    .{ .label = "layer 24", .prefix = "language_model.model.layers.24.mlp", .world = 2 },
+    .{ .label = "MTP head", .prefix = "language_model.mtp.layers.0.mlp", .world = 1 },
+};
+/// Per row count of the pack check: distinct experts dequantized to FP64, and pairs of each checked.
+const real_experts = 4;
+const real_pairs = 4;
+
+/// The pass fields moe_native.exl3 reads.
+const Pass = struct {
+    s: struct { mixed: u64, moe_act: u64, y: u64 },
+    k: *const flash.batch_state.Kernels,
+    stream: cuda.Stream,
+};
+
+const Inputs = struct { pack: []const u8, rank: usize };
+
+fn refuse(comptime fmt: []const u8, args: anytype) error{BadInputs} {
+    std.debug.print("FAIL " ++ fmt ++ "\n", args);
+    return error.BadInputs;
+}
+
+/// PACK RANK from `args`, checked against the folder: its index, manifest.json (world 2, 512 experts) and each of the
+/// manifest's files for RANK present at its size. `extra` names the command's optional arguments in the usage line.
+fn inputs(io: std.Io, a: std.mem.Allocator, cmd: []const u8, extra: []const u8, args: []const [:0]const u8) !Inputs {
+    if (args.len < 2) return refuse("{s}: usage: {s} PACK RANK{s} (PACK: the staged experts-only folder, e.g. /root/.cache/huggingface/exl3-experts; RANK: the rank whose files this host holds, 0 on the head, 1 on the worker); got {d} argument(s)", .{ cmd, cmd, extra, args.len });
+    const pack: []const u8 = args[0];
+    const rank = std.fmt.parseInt(usize, args[1], 10) catch return refuse("{s}: RANK {s} is not 0 or 1", .{ cmd, args[1] });
+    if (rank > 1) return refuse("{s}: RANK {d} is not 0 or 1", .{ cmd, rank });
+    const dir = std.Io.Dir.cwd();
+    const index = try std.fs.path.join(a, &.{ pack, "model.safetensors.index.json" });
+    _ = dir.statFile(io, index, .{}) catch |e| return refuse("{s}: {s}: {t} (is PACK staged and mounted?)", .{ cmd, index, e });
+    const mpath = try std.fs.path.join(a, &.{ pack, "manifest.json" });
+    const text = dir.readFileAlloc(io, mpath, a, .limited(1 << 20)) catch |e| return refuse("{s}: {s}: {t}", .{ cmd, mpath, e });
+    const m = std.json.parseFromSliceLeaky(std.json.Value, a, text, .{}) catch |e| return refuse("{s}: {s}: {t}", .{ cmd, mpath, e });
+    if (m != .object) return refuse("{s}: {s} is not an object", .{ cmd, mpath });
+    const world = m.object.get("world") orelse return refuse("{s}: {s} has no world", .{ cmd, mpath });
+    const experts = m.object.get("experts") orelse return refuse("{s}: {s} has no experts", .{ cmd, mpath });
+    if (world != .integer or world.integer != 2 or experts != .integer or experts.integer != global) return refuse("{s}: {s} is not a world-2, {d}-expert pack", .{ cmd, mpath, global });
+    var key: [4]u8 = undefined;
+    const ranks = m.object.get("ranks") orelse return refuse("{s}: {s} has no ranks", .{ cmd, mpath });
+    if (ranks != .object) return refuse("{s}: {s}: ranks is not an object", .{ cmd, mpath });
+    const mine = ranks.object.get(try std.fmt.bufPrint(&key, "{d}", .{rank})) orelse return refuse("{s}: {s} has no rank {d}", .{ cmd, mpath, rank });
+    if (mine != .object) return refuse("{s}: {s}: rank {d} is not an object", .{ cmd, mpath, rank });
+    const files = mine.object.get("files") orelse return refuse("{s}: {s}: rank {d} lists no files", .{ cmd, mpath, rank });
+    if (files != .array or files.array.items.len == 0) return refuse("{s}: {s}: rank {d} lists no files", .{ cmd, mpath, rank });
+    var bytes: u64 = 0;
+    for (files.array.items) |f| {
+        if (f != .object) return refuse("{s}: {s}: a rank {d} file entry is not an object", .{ cmd, mpath, rank });
+        const name = f.object.get("file") orelse return refuse("{s}: {s}: a rank {d} file has no name", .{ cmd, mpath, rank });
+        const want = f.object.get("bytes") orelse return refuse("{s}: {s}: a rank {d} file has no size", .{ cmd, mpath, rank });
+        if (name != .string or want != .integer) return refuse("{s}: {s}: a rank {d} file entry is malformed", .{ cmd, mpath, rank });
+        const path = try std.fs.path.join(a, &.{ pack, name.string });
+        const st = dir.statFile(io, path, .{}) catch |e| return refuse("{s}: {s}: {t} (rank {d}'s files are not staged on this host: is RANK right?)", .{ cmd, path, e, rank });
+        if (st.size != @as(u64, @intCast(want.integer))) return refuse("{s}: {s}: {d} bytes, the manifest says {d} (a partial copy?)", .{ cmd, path, st.size, want.integer });
+        bytes += st.size;
+    }
+    std.debug.print("STEP {s}: pack {s} rank {d}: index, manifest and {d} files ({d:.1} GiB) present\n", .{ cmd, pack, rank, files.array.items.len, @as(f64, @floatFromInt(bytes)) / (1 << 30) });
+    return .{ .pack = pack, .rank = rank };
+}
+
+/// Ends the process with status 124 once `deadline_s` passes, whatever the main thread waits on.
+fn watchdog(cmd: []const u8) void {
+    const T = struct {
+        fn run(name: []const u8) void {
+            var left: std.c.timespec = .{ .sec = deadline_s, .nsec = 0 };
+            var rem: std.c.timespec = undefined;
+            while (std.c.nanosleep(&left, &rem) != 0) left = rem;
+            std.debug.print("FAIL {s}: not finished after {d} s (a step never returned); exiting 124\n", .{ name, deadline_s });
+            std.process.exit(124);
+        }
+    };
+    const t = std.Thread.spawn(.{}, T.run, .{cmd}) catch |e| {
+        std.debug.print("{s}: no watchdog ({t}); the caller's timeout is the only bound\n", .{ cmd, e });
+        return;
+    };
+    t.detach();
+}
+
+const Clock = struct {
+    io: std.Io,
+    cmd: []const u8,
+    t0: i96,
+
+    fn start(io: std.Io, cmd: []const u8) Clock {
+        return .{ .io = io, .cmd = cmd, .t0 = check.now(io) };
+    }
+
+    fn step(c: Clock, comptime fmt: []const u8, args: anytype) void {
+        const s = @as(f64, @floatFromInt(check.now(c.io) - c.t0)) / 1e9;
+        std.debug.print("STEP {s} +{d:.1} s: " ++ fmt ++ "\n", .{ c.cmd, s } ++ args);
+    }
+};
+
+/// A rank's `count` experts at `halves[e]` half-bits, as one image: random trellis words and scales on the host too.
+const Image = struct {
+    l: layout.Layout,
+    base: u64,
+    host: []u8,
+    trellis: [3][][]i16,
+    suh: [3][][]f16,
+    svh: [3][][]f16,
+
+    fn init(r: *rig.Rig, count: usize, halves: []const u32, keep: bool) !Image {
+        var im: Image = undefined;
+        im.l = try layout.Layout.init(r.a, D, NI, .{ halves, halves, halves });
+        const buf = try cuda.DeviceBuffer.alloc(r.gpu.d, im.l.total);
+        try r.bufs.append(r.gpu.gpa, buf);
+        im.base = buf.ptr;
+        im.host = try r.a.alloc(u8, im.l.total);
+        @memset(im.host, 0);
+        for (0..3) |p| {
+            const proj: layout.Proj = @fromBackingInt(@intCast(p));
+            const s = layout.kn(proj, D, NI);
+            im.trellis[p] = try r.a.alloc([]i16, count);
+            im.suh[p] = try r.a.alloc([]f16, count);
+            im.svh[p] = try r.a.alloc([]f16, count);
+            for (0..count) |e| {
+                const tb = try layout.trellisBytes(s[0], s[1], halves[e]);
+                const t = try r.a.alloc(i16, tb / 2);
+                r.rng.bytes(std.mem.sliceAsBytes(t));
+                const su = try r.a.alloc(f16, s[0]);
+                for (su) |*v| v.* = @floatCast(if (r.rng.boolean()) @as(f32, 0.03) else -0.03);
+                const sv = try r.a.alloc(f16, s[1]);
+                for (sv) |*v| v.* = @floatCast(if (r.rng.boolean()) @as(f32, 0.03) else -0.03);
+                try im.l.put(im.host, im.base, proj, e, .{ .trellis = std.mem.sliceAsBytes(t), .suh = std.mem.sliceAsBytes(su), .svh = std.mem.sliceAsBytes(sv), .halves = halves[e] }, halves[e]);
+                if (keep) {
+                    im.trellis[p][e] = t;
+                    im.suh[p][e] = su;
+                    im.svh[p][e] = sv;
+                }
+            }
+        }
+        try buf.upload(0, im.host);
+        return im;
+    }
+
+    fn owned(im: Image, d: *const cuda.Driver, first: usize, count: usize) flash.modelopt_experts.Owned {
+        const empty: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+        return .{ .up = empty, .down = empty, .up_scale = empty, .down_scale = empty, .width = NI, .dims = D, .count = count, .first = first, .format = .exl3, .exl3 = im.l.layer(im.base, X.act_mode), .exl3_prompt = im.l.prompt_ok };
+    }
+};
+
+/// FP64 weights of one expert: gate and up [D][NI], down [NI][D] (exl3_format.dequantize, the format's reference
+/// decoder, about 0.4 s a projection on one core), the three projections on three threads, in buffers reused from
+/// expert to expert.
+const Weights = struct {
+    w: [3][]f64,
+    scratch: [3][]f64,
+
+    /// One projection's trellis words, sign scales and half-bit width, host copies dequantize can read aligned.
+    const Proj = struct { halves: u32, trellis: []const i16, suh: []const f16, svh: []const f16 };
+
+    fn init(gpa: std.mem.Allocator) !Weights {
+        var out: Weights = undefined;
+        for (&out.w, &out.scratch) |*w, *s| {
+            w.* = try gpa.alloc(f64, D * NI);
+            s.* = try gpa.alloc(f64, 2 * D * NI);
+        }
+        return out;
+    }
+
+    fn deinit(self: *Weights, gpa: std.mem.Allocator) void {
+        for (self.w, self.scratch) |w, s| {
+            gpa.free(w);
+            gpa.free(s);
+        }
+    }
+
+    fn one(self: *Weights, p: usize, src: Proj) void {
+        const s = layout.kn(@fromBackingInt(@intCast(p)), D, NI);
+        core.exl3_format.dequantize(.{ .halves = @intCast(src.halves) }, .mul1, src.trellis, s[0] / 16, s[1] / 16, src.suh, src.svh, self.w[p], self.scratch[p]);
+    }
+
+    fn set(self: *Weights, src: [3]Proj) void {
+        var ts: [3]?std.Thread = undefined;
+        for (&ts, 0..) |*t, p| t.* = std.Thread.spawn(.{}, one, .{ self, p, src[p] }) catch null;
+        for (ts, 0..) |t, p| if (t) |th| th.join() else self.one(p, src[p]);
+    }
+
+    /// The pack's expert `e` of the layer at `prefix`, copied out of the store's mapping; its gate's half-bit width.
+    fn setFrom(self: *Weights, gpa: std.mem.Allocator, store: *X.Store, prefix: []const u8, e: usize) !u32 {
+        var src: [3]Proj = undefined;
+        var made: usize = 0;
+        defer for (src[0..made]) |q| {
+            gpa.free(q.trellis);
+            gpa.free(q.suh);
+            gpa.free(q.svh);
+        };
+        var buf: [256]u8 = undefined;
+        for (&src, 0..) |*q, p| {
+            const s = layout.kn(@fromBackingInt(@intCast(p)), D, NI);
+            const g = try X.group(store, try std.fmt.bufPrint(&buf, "{s}.experts.{d}.{s}", .{ prefix, e, projs[p] }), s[0], s[1]);
+            const t = try gpa.alloc(i16, g.trellis.len / 2);
+            errdefer gpa.free(t);
+            @memcpy(std.mem.sliceAsBytes(t), g.trellis);
+            const su = try gpa.alloc(f16, s[0]);
+            errdefer gpa.free(su);
+            @memcpy(std.mem.sliceAsBytes(su), g.suh);
+            const sv = try gpa.alloc(f16, s[1]);
+            @memcpy(std.mem.sliceAsBytes(sv), g.svh);
+            q.* = .{ .halves = g.halves, .trellis = t, .suh = su, .svh = sv };
+            made += 1;
+        }
+        self.set(src);
+        return src[0].halves;
+    }
+
+    /// Rel L2 errors of one pair against FP64: its bf16 silu(gate) * up row `act`, and its fp32 down row `y` from the
+    /// kernel's own act (so a down error is not an act error carried on).
+    fn pairError(self: *const Weights, xr: []const u16, act: []const u16, y: []const f32) [2]f64 {
+        var g: [NI]f64 = @splat(0);
+        var u: [NI]f64 = @splat(0);
+        for (0..D) |i| {
+            const xv = rig.bf(xr[i]);
+            const wg = self.w[0][i * NI ..][0..NI];
+            const wu = self.w[1][i * NI ..][0..NI];
+            for (0..NI) |j| {
+                g[j] += xv * wg[j];
+                u[j] += xv * wu[j];
+            }
+        }
+        var ae: f64 = 0;
+        var an: f64 = 0;
+        for (0..NI) |j| {
+            const want = g[j] / (1 + @exp(-g[j])) * u[j];
+            const have = rig.bf(act[j]);
+            ae += (have - want) * (have - want);
+            an += want * want;
+        }
+        var s: [D]f64 = @splat(0);
+        for (0..NI) |i| {
+            const av = rig.bf(act[i]);
+            const wd = self.w[2][i * D ..][0..D];
+            for (0..D) |j| s[j] += av * wd[j];
+        }
+        var ye: f64 = 0;
+        var yn: f64 = 0;
+        for (0..D) |j| {
+            const have: f64 = y[j];
+            ye += (have - s[j]) * (have - s[j]);
+            yn += s[j] * s[j];
+        }
+        return .{ @sqrt(ae / @max(an, 1e-300)), @sqrt(ye / @max(yn, 1e-300)) };
+    }
+};
+
+fn plan(r: *rig.Rig, pairs: usize, entries: usize) !cuda.grouped.Plan {
+    return .{
+        .members = try r.out(pairs * 4),
+        .items = try r.out(((pairs + 15) / 16 + entries) * 12),
+        .counts = try r.out(8),
+        .rank = try r.out(pairs * 4),
+        .hist = try r.out(((pairs + cuda.grouped.small - 1) / cuda.grouped.small) * entries * 4),
+    };
+}
+
+/// Rank-local picks: ten distinct global experts a row (another rank's, and the shared slot, mapped to `count`).
+fn localPicks(a: std.mem.Allocator, rng: std.Random, rows: usize, first: usize, count: usize, total: usize) ![]i32 {
+    if (total < picked) return error.TooFewExperts;
+    const out = try a.alloc(i32, rows * slots);
+    var g: [picked]usize = undefined;
+    for (0..rows) |row| {
+        for (0..picked) |j| {
+            var e = rng.uintLessThan(usize, total);
+            while (std.mem.indexOfScalar(usize, g[0..j], e) != null) e = rng.uintLessThan(usize, total);
+            g[j] = e;
+            out[row * slots + j] = if (e >= first and e < first + count) @intCast(e - first) else @intCast(count);
+        }
+        out[row * slots + picked] = @intCast(count);
+    }
+    return out;
+}
+
+/// One moe_native.exl3 call on `rows` rows of `x` with `owned`; the act and y rows back on the host, and the picks.
+const Call = struct { picks: []i32, act: []u16, y: []f32 };
+
+fn call(r: *rig.Rig, k: *const flash.batch_state.Kernels, dx: u64, owned: *const flash.modelopt_experts.Owned, rows: usize) !Call {
+    const total = if (owned.count == global) global else 2 * owned.count; // the MTP head's 512, else two ranks' worth
+    return callWith(r, k, dx, owned, rows, try localPicks(r.a, r.rng, rows, owned.first, owned.count, total));
+}
+
+fn callWith(r: *rig.Rig, k: *const flash.batch_state.Kernels, dx: u64, owned: *const flash.modelopt_experts.Owned, rows: usize, picks: []i32) !Call {
+    const pairs = rows * slots;
+    const p = try plan(r, pairs, owned.count + 1);
+    const act = try r.out(pairs * NI * 2);
+    const y = try r.out(pairs * D * 4);
+    var pass: Pass = .{ .s = .{ .mixed = dx, .moe_act = act, .y = y }, .k = k, .stream = r.s };
+    try flash.moe_native.exl3(&pass, try r.dev(std.mem.sliceAsBytes(picks)), owned, p, pairs, rows, owned.count + 1, @intCast(owned.count));
+    try r.s.synchronize();
+    return .{ .picks = picks, .act = try r.back(u16, act, pairs * NI), .y = try r.back(f32, y, pairs * D) };
+}
+
+/// Every pair routed elsewhere left its y row untouched (0xff); the number routed here, which must be > 0.
+fn skipped(c: Call, count: usize, what: []const u8, rows: usize) !usize {
+    var routed: usize = 0;
+    for (c.picks, 0..) |e, pi| {
+        if (e == count) {
+            for (std.mem.sliceAsBytes(c.y[pi * D ..][0..D])) |v| try check.expect(v == 0xff, "{s}, {d} rows: a skipped pair's row untouched", .{ what, rows });
+        } else routed += 1;
+    }
+    try check.expect(routed > 0, "{s}, {d} rows: some pairs routed to this rank", .{ what, rows });
+    return routed;
+}
+
+fn checkPair(w: *const Weights, x: []const u16, c: Call, pi: usize, what: []const u8, rows: usize, expert: usize) !f64 {
+    const row = pi / slots;
+    const err = w.pairError(x[row * D ..][0..D], c.act[pi * NI ..][0..NI], c.y[pi * D ..][0..D]);
+    try check.expect(err[0] < 1e-2 and err[1] < 1e-2, "{s}, {d} rows, pair {d} (expert {d}): rel L2 error act {e:.2}, down {e:.2} (bound 1e-2)", .{ what, rows, pi, expert, err[0], err[1] });
+    return @max(err[0], err[1]);
+}
+
+/// Decode shapes through the grouped kernels (5 rows, and 70: NVFP4's prompt tile), then prompt shapes through
+/// TF_EXL3_PROMPT_ROWS's kernels: just past its default 256 rows, and a 1,536-row prompt chunk (multi-item experts).
+const row_counts = [_]usize{ 5, 70, 300, 1536 };
+const most = 1536;
+/// Routed pairs of one synthetic expert checked against FP64 a row count past 70 rows (5 and 70: every pair).
+const synth_cap = 40;
+/// Bound on the rel L2 distance of the prompt kernels' act and y from the grouped kernels' on the same picks (the same
+/// rotated inputs and weights, other summation orders, so a few bf16 act values round the other way).
+const path_bound = 1e-2;
+
+/// Rel L2 distance of `b` from `a` over the pairs routed here (act and y), and whether the y bytes are equal.
+fn pathDistance(a: Call, b: Call, count: usize) struct { act: f64, y: f64, same_y: bool } {
+    var ad: f64 = 0;
+    var an: f64 = 0;
+    var yd: f64 = 0;
+    var yn: f64 = 0;
+    var same = true;
+    for (a.picks, 0..) |e, pi| {
+        if (e == count) continue;
+        for (a.act[pi * NI ..][0..NI], b.act[pi * NI ..][0..NI]) |x, y| {
+            const d = rig.bf(x) - rig.bf(y);
+            ad += d * d;
+            an += rig.bf(x) * rig.bf(x);
+        }
+        for (a.y[pi * D ..][0..D], b.y[pi * D ..][0..D]) |x, y| {
+            const d = @as(f64, x) - y;
+            yd += d * d;
+            yn += @as(f64, x) * x;
+            same = same and @as(u32, @bitCast(x)) == @as(u32, @bitCast(y));
+        }
+    }
+    return .{ .act = @sqrt(ad / @max(an, 1e-300)), .y = @sqrt(yd / @max(yn, 1e-300)), .same_y = same };
+}
+
+/// `flashnext-exl3-experts PACK RANK`: synthetic experts on both ranks (every routed pair against FP64), then the
+/// pack's layers for RANK through the loader (cuda_exl3_experts.loadShape), a sample of pairs against FP64.
+pub fn run(gpu: check.Gpu, args: []const [:0]const u8) !void {
+    const cmd = "flashnext-exl3-experts";
+    if (std.c.getenv("TF_FLASHNEXT_FACT_ROWS") != null) return check.expect(false, "{s} runs with TF_FLASHNEXT_FACT_ROWS unset", .{cmd});
+    for ([_][:0]const u8{ "TF_EXL3_PROMPT_ROWS", "TF_EXL3_PROMPT_DN" }) |v| if (std.c.getenv(v) != null) return check.expect(false, "{s} runs with {s} unset (it checks the defaults' paths)", .{ cmd, v });
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const in = try inputs(gpu.io, a, cmd, "", args);
+    watchdog(cmd);
+    const clock = Clock.start(gpu.io, cmd);
+    var rng = std.Random.DefaultPrng.init(0xe3e3);
+    var r = try rig.Rig.init(gpu, a, rng.random());
+    defer r.deinit();
+    var k = try flash.batch_state.Kernels.load(gpu.d);
+    defer k.deinit();
+    if (k.exl3 == null) k.exl3 = try X.Kit.load(gpu.d);
+    try k.exl3.?.reserve(most);
+    const kit: struct { prompt_rows: usize, prompt_dn: X.prompt.Down } = .{ .prompt_rows = k.exl3.?.prompt_rows, .prompt_dn = k.exl3.?.prompt_dn };
+    try check.expect(kit.prompt_rows > 70 and kit.prompt_rows <= 300, "{s}: the prompt kernels take 300 rows and not 70 (TF_EXL3_PROMPT_ROWS default {d})", .{ cmd, kit.prompt_rows });
+    const x = r.bfs(most * D, 1.0);
+    const dx = try r.dev(std.mem.sliceAsBytes(x));
+    var w = try Weights.init(gpu.gpa);
+    defer w.deinit(gpu.gpa);
+    clock.step("kernels loaded, {d} rows reserved", .{most});
+    var worst: f64 = 0;
+    var worst_path: f64 = 0;
+    var checked: usize = 0;
+    for (0..2) |rank| {
+        const im = try Image.init(&r, fixture_count, &fixture_halves, true);
+        const owned = im.owned(gpu.d, rank * fixture_count, fixture_count);
+        var calls: [row_counts.len]Call = undefined;
+        for (row_counts, &calls) |rows, *c| c.* = try call(&r, &k, dx, &owned, rows);
+        for (0..fixture_count) |e| {
+            var src: [3]Weights.Proj = undefined;
+            for (&src, 0..) |*q, p| q.* = .{ .halves = fixture_halves[e], .trellis = im.trellis[p][e], .suh = im.suh[p][e], .svh = im.svh[p][e] };
+            w.set(src);
+            for (row_counts, calls) |rows, c| {
+                if (e == 0) _ = try skipped(c, fixture_count, "synthetic", rows);
+                var m: usize = 0;
+                for (c.picks, 0..) |pe, pi| if (pe == e and (rows <= 70 or m < synth_cap)) {
+                    worst = @max(worst, try checkPair(&w, x, c, pi, if (rows >= kit.prompt_rows) "synthetic prompt" else "synthetic", rows, rank * fixture_count + e));
+                    checked += 1;
+                    m += 1;
+                };
+            }
+        }
+        clock.step("synthetic rank {d}: 5 and 70 rows every routed pair, 300 and {d} rows (prompt kernels) {d} pairs an expert, within 1e-2 (worst so far {e:.2})", .{ rank, most, synth_cap, worst });
+    }
+    var store = try X.Store.open(gpu.gpa, gpu.io, in.pack);
+    defer store.deinit();
+    for (real_layers) |spec| {
+        if (spec.world == 1 and in.rank != 0) continue;
+        const rk = if (spec.world == 1) 0 else in.rank;
+        var owned = try X.loadShape(gpu.gpa, gpu.d, &store, spec.prefix, spec.world, rk, D, NI, global);
+        defer owned.free();
+        defer store.loaded();
+        clock.step("pack {s}: experts {d}..{d} loaded ({d} MiB image)", .{ spec.label, owned.first, owned.first + owned.count - 1, owned.image.?.len >> 20 });
+        for (row_counts) |rows| {
+            const c = try call(&r, &k, dx, &owned, rows);
+            const routed = try skipped(c, owned.count, spec.label, rows);
+            // experts spread over the rows: the picks visited at a prime stride (7919 divides no rows * 11 here)
+            var chosen: [real_experts]i32 = @splat(-1);
+            var n: usize = 0;
+            var pi: usize = 0;
+            while (pi < c.picks.len and n < real_experts) : (pi += 1) {
+                const e = c.picks[(pi * 7919) % c.picks.len];
+                if (e == owned.count or std.mem.indexOfScalar(i32, chosen[0..n], e) != null) continue;
+                chosen[n] = e;
+                n += 1;
+            }
+            var halves: u32 = 0;
+            for (chosen[0..n]) |e| {
+                const ue: usize = @intCast(e);
+                halves = try w.setFrom(gpu.gpa, &store, spec.prefix, owned.first + ue);
+                var m: usize = 0;
+                for (c.picks, 0..) |pe, qi| if (pe == e and m < real_pairs) {
+                    worst = @max(worst, try checkPair(&w, x, c, qi, spec.label, rows, owned.first + ue));
+                    checked += 1;
+                    m += 1;
+                };
+            }
+            clock.step("pack {s}, {d} rows ({s}): {d} routed pairs, {d} experts at {d} half-bits checked, within 1e-2 (worst so far {e:.2})", .{ spec.label, rows, if (rows >= kit.prompt_rows) "prompt kernels" else "grouped kernels", routed, n, halves, worst });
+        }
+        // the same picks through both paths and both down tiles: every routed pair's act and y, not a sample
+        const picks = try localPicks(r.a, r.rng, most, owned.first, owned.count, if (spec.world == 1) global else 2 * owned.count);
+        const prompt_v3 = try callWith(&r, &k, dx, &owned, most, picks);
+        k.exl3.?.prompt_dn = .dn0;
+        const prompt_dn0 = try callWith(&r, &k, dx, &owned, most, picks);
+        k.exl3.?.prompt_dn = kit.prompt_dn;
+        k.exl3.?.prompt_rows = 0;
+        const grouped = try callWith(&r, &k, dx, &owned, most, picks);
+        k.exl3.?.prompt_rows = kit.prompt_rows;
+        const tiles = pathDistance(prompt_v3, prompt_dn0, owned.count);
+        try check.expect(tiles.same_y, "pack {s}, {d} rows: the prompt down tiles v3 and dn0 write the same y bytes", .{ spec.label, most });
+        const d = pathDistance(grouped, prompt_v3, owned.count);
+        try check.expect(d.act < path_bound and d.y < path_bound, "pack {s}, {d} rows: prompt vs grouped kernels rel L2 act {e:.2}, y {e:.2} (bound {e:.0})", .{ spec.label, most, d.act, d.y, path_bound });
+        worst_path = @max(worst_path, @max(d.act, d.y));
+        clock.step("pack {s}, {d} rows: prompt vs grouped kernels over every routed pair: rel L2 act {e:.2}, y {e:.2}; down tiles v3 and dn0 byte-equal", .{ spec.label, most, d.act, d.y });
+    }
+    check.pass("{s}: synthetic both ranks and pack {s} rank {d} (layers 0, 24{s}), decode 5 / 70 and prompt 300 / {d} rows: {d} pairs, worst rel L2 error {e:.2} against FP64; prompt vs grouped kernels {e:.2}", .{ cmd, in.pack, in.rank, if (in.rank == 0) ", MTP" else "", most, checked, worst, worst_path });
+}
+
+/// One way the grouped kernels run a layer: the router's items (`tile` members at most) and the k tiles of words a warp
+/// keeps in flight; every variant of a layer must write the same act and y bytes as the first.
+const Variant = struct {
+    label: []const u8,
+    tile: usize,
+    depth: u8,
+    x_ahead: bool = false,
+    fit: cuda.exl3_grouped.Fit = .base,
+    /// false: a roofline probe (the same words read, no decode), timed but neither the bits nor checked.
+    exact: bool = true,
+    /// Set: TF_EXL3_PROMPT_ROWS's kernels at this down tile (route and items its own), compared with the first such.
+    prompt: ?X.prompt.Down = null,
+};
+
+/// Rel L2 distance of `cur` from `ref` (act, y) over the pairs routed here (picks not `count`).
+fn relL2(picks: []const i32, count: usize, ref_act: []const u16, ref_y: []const u32, cur_act: []const u16, cur_y: []const u32) [2]f64 {
+    var s: [4]f64 = @splat(0);
+    for (picks, 0..) |e, pi| {
+        if (e == count) continue;
+        for (ref_act[pi * NI ..][0..NI], cur_act[pi * NI ..][0..NI]) |r, c| {
+            const d = rig.bf(r) - rig.bf(c);
+            s[0] += d * d;
+            s[1] += rig.bf(r) * rig.bf(r);
+        }
+        for (ref_y[pi * D ..][0..D], cur_y[pi * D ..][0..D]) |r, c| {
+            const rf: f64 = @as(f32, @bitCast(r));
+            const d = rf - @as(f32, @bitCast(c));
+            s[2] += d * d;
+            s[3] += rf * rf;
+        }
+    }
+    return .{ @sqrt(s[0] / @max(s[1], 1e-300)), @sqrt(s[2] / @max(s[3], 1e-300)) };
+}
+
+/// tile 64 depth 1 is the first EXL3 route (NVFP4's tiles, four 16-member programs an item); Kit.load's is tile 16 with the
+/// A fragments ahead (TF_EXL3_GROUPED_XA) at TF_EXL3_GROUPED_PF's depth.
+const variants = [_]Variant{
+    .{ .label = "nvfp4 tiles, depth 1", .tile = 64, .depth = 1 },
+    .{ .label = "tile 16, depth 1", .tile = 16, .depth = 1 },
+    .{ .label = "tile 16, depth 2", .tile = 16, .depth = 2 },
+    .{ .label = "tile 16, depth 1, A ahead", .tile = 16, .depth = 1, .x_ahead = true },
+    .{ .label = "tile 16, depth 2, A ahead", .tile = 16, .depth = 2, .x_ahead = true },
+    .{ .label = "tile 16, A ahead, lean (4 an SM)", .tile = 16, .depth = 1, .x_ahead = true, .fit = .lean },
+    .{ .label = "tile 16, A ahead, narrow (6 an SM)", .tile = 16, .depth = 1, .x_ahead = true, .fit = .narrow },
+    .{ .label = "tile 16, cp.async ring 3 stages (4 an SM)", .tile = 16, .depth = 1, .x_ahead = true, .fit = .cp3 },
+    .{ .label = "tile 16, cp.async ring 4 stages (4 an SM)", .tile = 16, .depth = 1, .x_ahead = true, .fit = .cp4 },
+    .{ .label = "roofline: same words, 16-byte loads, no decode", .tile = 16, .depth = 1, .x_ahead = true, .fit = .roof_v4, .exact = false },
+    .{ .label = "roofline: same words, per-lane loads, no decode", .tile = 16, .depth = 1, .x_ahead = true, .fit = .roof_lane, .exact = false },
+    .{ .label = "prompt kernels, x3gm 64-pair items, down v3 tile", .tile = 16, .depth = 1, .x_ahead = true, .fit = .cp4, .prompt = .v3 },
+    .{ .label = "prompt kernels, x3gm 64-pair items, down dn0 tile", .tile = 16, .depth = 1, .x_ahead = true, .fit = .cp4, .prompt = .dn0 },
+};
+/// The first prompt variant: the one the others of its kind are compared with byte for byte.
+const first_prompt = blk: {
+    for (variants, 0..) |v, i| if (v.prompt != null) break :blk i;
+    unreachable;
+};
+
+/// `flashnext-exl3-bench PACK RANK [ROWS...]`: one MoE layer's routed experts at a --tp 2 rank (256 of 512, ten picks a
+/// row and the shared slot skipped), routed as the engine routes them (nvfp4_tile.size): NVFP4 against EXL3 at 2.5 and
+/// 3.0 bpw (synthetic) and against the pack's layers 24 and 0 for RANK. GB/s counts the weight bytes of the experts a
+/// call touches. Each arm runs every `variants` entry (grouped bytes checked equal to the first's, prompt bytes to the
+/// first prompt variant's, and the prompt kernels' rel L2 distance from the grouped kernels' printed); exit 3 when the
+/// served one (Kit.load's tile, TF_EXL3_GROUPED_PF depth and TF_EXL3_GROUPED_XA below TF_EXL3_PROMPT_ROWS, the prompt
+/// kernels at TF_EXL3_PROMPT_DN's tile from it) of any EXL3 arm falls below 0.6x NVFP4's at a decode row count. At
+/// prompt row counts the served variant's time against NVFP4's is the measure: `BENCH prompt` lines.
+pub fn bench(gpu: check.Gpu, args: []const [:0]const u8) !void {
