+        float v[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) v[j] = xv[j] * __half2float(su[j]);
+        tf_exl3::fwht128(v, lane);
+        half* o = (m ? x1 : x0) + (size_t)p * K + blk * 128 + 4 * lane;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) o[j] = __float2half_rn(v[j] * tf_exl3::HAD_SCALE);
+    }
