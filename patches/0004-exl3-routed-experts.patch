+++ b/zig/src/families/flashnext/cuda_exl3_experts.zig
@@ -0,0 +1,345 @@
+//! TF_FLASHNEXT_EXPERTS_EXL3=DIR: the routed experts from an experts-only EXL3 folder (mul1 trellises under the EXL3
+//! checkpoint's names, model.safetensors.index.json beside them); router, shared expert and the rest load as before.
+//! TF_FLASHNEXT_EXPERTS_EXL3_LAYERS=all (default) | main (the 48 decoder layers) | mtp (the MTP head's layer only).
+//! Unset or empty DIR: nothing here runs and the NVFP4 / block-FP8 experts load and run exactly as without it.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const routed = @import("cuda_modelopt_experts.zig");
+const layout = @import("cuda_exl3_routed.zig");
+pub const prompt = @import("cuda_exl3_prompt.zig");
+
+const ex = cuda.exl3_experts;
+/// The folder reader `load` takes, for the device tests that open a staged pack themselves.
+pub const Store = wt.Store;
+const Proj = layout.Proj;
+
+/// The mul1 codebook marker each projection carries (exl3_format.Mul1Mul).
+pub const mul1_magic: u32 = core.exl3_format.Mul1Mul;
+/// plan_finish's fp32 silu(gate) * up, unclamped (Flash Next's SwiGLU, qwen3_5's mode).
+pub const act_mode: i32 = 1;
+
+pub const Scope = enum { all, main, mtp };
+pub const Part = enum { main, mtp };
+pub const Config = struct {
+    dir: []const u8,
+    scope: Scope,
+
+    pub fn covers(c: Config, part: Part) bool {
+        return c.scope == .all or (c.scope == .main and part == .main) or (c.scope == .mtp and part == .mtp);
+    }
+};
+
+/// The switch from the two variables' values: null (off) when `dir` is unset or empty.
+pub fn parse(dir: ?[]const u8, scope: ?[]const u8) !?Config {
+    const d = dir orelse return null;
+    if (d.len == 0) return null;
+    const s = scope orelse "all";
+    const sc: Scope = if (s.len == 0 or std.mem.eql(u8, s, "all")) .all else if (std.mem.eql(u8, s, "main")) .main else if (std.mem.eql(u8, s, "mtp")) .mtp else return error.BadExl3Scope;
+    return .{ .dir = d, .scope = sc };
+}
+
+pub fn config() !?Config {
+    const span = struct {
+        fn f(name: [*:0]const u8) ?[]const u8 {
+            return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+        }
+    }.f;
+    return parse(span("TF_FLASHNEXT_EXPERTS_EXL3"), span("TF_FLASHNEXT_EXPERTS_EXL3_LAYERS"));
+}
+
+/// The part a loader prefix names: the MTP head's layer ("language_model.mtp." or "mtp."), else a decoder layer.
+pub fn partOf(prefix: []const u8) Part {
+    return if (std.mem.startsWith(u8, prefix, "language_model.mtp.") or std.mem.startsWith(u8, prefix, "mtp.")) .mtp else .main;
+}
+
+/// Opens the EXL3 folder beside `store` when the switch is on and covers `part`; the store frees it with its own deinit.
+pub fn attach(gpa: std.mem.Allocator, io: std.Io, store: *wt.Store, part: Part) !void {
+    const c = (try config()) orelse return;
+    try attachTo(gpa, io, store, c, part);
+}
+
+pub fn attachTo(gpa: std.mem.Allocator, io: std.Io, store: *wt.Store, c: Config, part: Part) !void {
+    if (!c.covers(part) or store.experts_exl3 != null) return;
+    const x = try gpa.create(wt.Store);
+    errdefer gpa.destroy(x);
+    x.* = try wt.Store.open(gpa, io, c.dir);
+    store.experts_exl3 = x;
+    std.log.info("flashnext: {s} routed experts from EXL3 folder {s}", .{ @tagName(part), c.dir });
+}
+
+const projs = [3][]const u8{ "gate_proj", "up_proj", "down_proj" };
+
+/// One projection's tensors, checked as qwen3_5's admit.group checks them: trellis [k/16][n/16][8 * halves] i16, the
+/// mul1 marker, fp16 suh [k] and svh [n].
+pub fn group(store: anytype, base: []const u8, k: usize, n: usize) !layout.Source {
+    var buf: [256]u8 = undefined;
+    const t = try store.hold(try std.fmt.bufPrint(&buf, "{s}.trellis", .{base}));
+    if (t.dtype != .i16 or t.rank != 3 or t.dim(0) != k / 16 or t.dim(1) != n / 16 or t.dim(2) % 8 != 0) return error.UnexpectedTensor;
+    const halves = t.dim(2) / 8;
+    if (halves < 2 or halves > 16) return error.UnsupportedQuantization;
+    const marker = try store.hold(try std.fmt.bufPrint(&buf, "{s}.mul1", .{base}));
+    if ((marker.dtype != .i32 and marker.dtype != .u32) or marker.bytes.len != 4 or std.mem.readInt(u32, marker.bytes[0..4], .little) != mul1_magic) return error.UnsupportedQuantization;
+    const suh = try store.hold(try std.fmt.bufPrint(&buf, "{s}.suh", .{base}));
+    const svh = try store.hold(try std.fmt.bufPrint(&buf, "{s}.svh", .{base}));
+    if (!suh.is(.f16, &.{k}) or !svh.is(.f16, &.{n})) return error.UnexpectedTensor;
+    return .{ .trellis = t.bytes, .suh = suh.bytes, .svh = svh.bytes, .halves = @intCast(halves) };
+}
+
+fn expertBase(buf: []u8, prefix: []const u8, e: usize, p: usize) ![]const u8 {
+    return std.fmt.bufPrint(buf, "{s}.experts.{d}.{s}", .{ prefix, e, projs[p] });
+}
+
+/// The rank's experts of the layer at `prefix` (the loader's names; the store's aliases reach the EXL3 names): the
+/// global ids [own.first, own.first + own.count) at local slots 0.., each projection's half-bit width as stored.
+pub fn plan(a: std.mem.Allocator, store: anytype, prefix: []const u8, own: routed.Experts, dims: usize, width: usize) !layout.Layout {
+    var halves: [3][]u32 = undefined;
+    var made: usize = 0;
+    defer for (halves[0..made]) |h| a.free(h);
+    var buf: [256]u8 = undefined;
+    for (0..3) |p| {
+        halves[p] = try a.alloc(u32, own.count);
+        made += 1;
+        const s = layout.kn(@fromBackingInt(@intCast(p)), dims, width);
+        for (halves[p], 0..) |*h, i| h.* = (try group(store, try expertBase(&buf, prefix, own.first + i, p), s[0], s[1])).halves;
+    }
+    return layout.Layout.init(a, dims, width, .{ halves[0], halves[1], halves[2] });
+}
+
+/// Fills `img` (the plan's total bytes, its device address `base`) with the rank's experts; the store's borrows stay held.
+pub fn fill(store: anytype, prefix: []const u8, own: routed.Experts, l: layout.Layout, img: []u8, base: u64) !void {
+    @memset(img, 0);
+    var buf: [256]u8 = undefined;
+    for (0..3) |p| {
+        const proj: Proj = @fromBackingInt(@intCast(p));
+        const s = layout.kn(proj, l.dims, l.width);
+        for (0..own.count) |i| {
+            const src = try group(store, try expertBase(&buf, prefix, own.first + i, p), s[0], s[1]);
+            try l.put(img, base, proj, i, src, src.halves);
+        }
+    }
+}
+
+/// The layer's routed experts for `world` ranks as rank `rank` holds them, on the device as one image.
+pub fn load(a: std.mem.Allocator, d: *const cuda.Driver, store: *wt.Store, prefix: []const u8, world: usize, rank: usize) !routed.Owned {
+    return loadShape(a, d, store, prefix, world, rank, wt.dims, wt.moe_w, wt.experts_n);
+}
+
+pub fn loadShape(a: std.mem.Allocator, d: *const cuda.Driver, store: *wt.Store, prefix: []const u8, world: usize, rank: usize, dims: usize, width: usize, count: usize) !routed.Owned {
+    defer store.release();
+    const own = try routed.Experts.init(count, world, rank);
+    var l = try plan(a, store, prefix, own, dims, width);
+    defer l.deinit(a);
+    var image = try cuda.DeviceBuffer.alloc(d, l.total);
+    errdefer image.free();
+    const img = try store.pinned(d, l.total);
+    try fill(store, prefix, own, l, img, image.ptr);
+    try image.upload(0, img);
+    const empty: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+    return .{ .up = empty, .down = empty, .up_scale = empty, .down_scale = empty, .width = width, .dims = dims, .count = own.count, .first = own.first, .format = .exl3, .image = image, .exl3 = l.layer(image.ptr, act_mode), .exl3_prompt = l.prompt_ok };
+}
+
+/// The EXL3 grouped kernels and their scratch, loaded beside the engine's when the switch is on; passes of
+/// `prompt_rows` rows or more take the prompt kernels (cuda_exl3_prompt.zig, 0 never) in the grouped scratch.
+pub const Kit = struct {
+    experts: ex.Experts,
+    grouped: cuda.exl3_grouped.Grouped,
+    prompt_rows: usize = prompt.default_rows,
+    prompt_dn: prompt.Down = .v3,
+
+    pub fn load(d: *const cuda.Driver) !*Kit {
+        const k = try std.heap.page_allocator.create(Kit);
+        errdefer std.heap.page_allocator.destroy(k);
+        k.experts = try ex.Experts.load(d);
+        const pf = try depth(std.c.getenv("TF_EXL3_GROUPED_PF"));
+        const xa = try xAhead(std.c.getenv("TF_EXL3_GROUPED_XA"));
+        k.grouped = .{ .d = d, .kernels = &k.experts, .tile = 16, .depth = pf, .x_ahead = xa, .fit = try fitFor(std.c.getenv("TF_EXL3_GROUPED_FIT"), xa, pf) };
+        k.prompt_rows = try prompt.rowsFrom(std.c.getenv("TF_EXL3_PROMPT_ROWS"));
+        k.prompt_dn = try prompt.downFrom(std.c.getenv("TF_EXL3_PROMPT_DN"));
+        return k;
+    }
+
+    /// Scratch for passes of up to `rows` rows (every slot routed), allocated before any graph captures a call.
+    pub fn reserve(k: *Kit, rows: usize) !void {
+        try k.grouped.reservePairs(wt.dims, wt.moe_w, rows * wt.slots);
+    }
+
+    pub fn unload(k: *Kit) void {
+        k.grouped.deinit();
+        k.experts.unload();
+        std.heap.page_allocator.destroy(k);
+    }
+};
+
+/// TF_EXL3_GROUPED_PF: k tiles of words a warp of the grouped kernels keeps in flight, 1 (unset) or 2; same bits.
+pub fn depth(value: ?[*:0]const u8) !u8 {
+    const v = std.mem.span(value orelse return 1);
+    if (std.mem.eql(u8, v, "1")) return 1;
+    if (std.mem.eql(u8, v, "2")) return 2;
+    return error.BadExl3GroupedDepth;
+}
+
+/// TF_EXL3_GROUPED_XA: 1 (unset) loads each k tile's A fragment with its words, ahead of its mma; 0 in the iteration.
+pub fn xAhead(value: ?[*:0]const u8) !bool {
+    const v = std.mem.span(value orelse return true);
+    if (std.mem.eql(u8, v, "1")) return true;
+    if (std.mem.eql(u8, v, "0")) return false;
+    return error.BadExl3GroupedXa;
+}
+
+/// TF_EXL3_GROUPED_FIT: cp4 (unset: the 4-stage cp.async ring, 0.69x NVFP4's time at 84 rows), base, lean,
+/// narrow or cp3 grouped programs (exl3_grouped.Fit), all the same bits; all but base need TF_EXL3_GROUPED_XA=1 and
+/// TF_EXL3_GROUPED_PF=1. The bench's roofline probes are refused.
+pub fn fit(value: ?[*:0]const u8) !cuda.exl3_grouped.Fit {
+    const v = std.mem.span(value orelse return .cp4);
+    const f = std.meta.stringToEnum(cuda.exl3_grouped.Fit, v) orelse return error.BadExl3GroupedFit;
+    return switch (f) {
+        .roof_v4, .roof_lane => error.BadExl3GroupedFit,
+        else => f,
+    };
+}
+
+/// fit's choice for the loaded depth and A-ahead switch: unset at PF=2 or XA=0 keeps base (cp4 needs XA=1, PF=1).
+pub fn fitFor(value: ?[*:0]const u8, x_ahead: bool, pf: u8) !cuda.exl3_grouped.Fit {
+    if (value == null and (!x_ahead or pf != 1)) return .base;
+    return fit(value);
+}
+
+test "TF_EXL3_GROUPED_FIT unset is cp4 at the default depth and A-ahead, base beside PF=2 or XA=0" {
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.cp4, try fitFor(null, true, 1));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.base, try fitFor(null, true, 2));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.base, try fitFor(null, false, 1));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.lean, try fitFor("lean", true, 1));
+}
+
+test "TF_EXL3_GROUPED_FIT takes cp4 (the default), base, lean, narrow or cp3 and refuses anything else" {
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.cp4, try fit(null));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.base, try fit("base"));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.lean, try fit("lean"));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.narrow, try fit("narrow"));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.cp3, try fit("cp3"));
+    try std.testing.expectEqual(cuda.exl3_grouped.Fit.cp4, try fit("cp4"));
+    try std.testing.expectError(error.BadExl3GroupedFit, fit("roof_v4"));
+    try std.testing.expectError(error.BadExl3GroupedFit, fit("roof_lane"));
+    try std.testing.expectError(error.BadExl3GroupedFit, fit("4"));
+    try std.testing.expectError(error.BadExl3GroupedFit, fit(""));
+}
+
+test "TF_EXL3_GROUPED_XA takes 1 (the default) or 0 and refuses anything else" {
+    try std.testing.expect(try xAhead(null));
+    try std.testing.expect(try xAhead("1"));
+    try std.testing.expect(!try xAhead("0"));
+    try std.testing.expectError(error.BadExl3GroupedXa, xAhead("2"));
+}
+
+test "TF_EXL3_GROUPED_PF takes 1 (the default) or 2 and refuses anything else" {
+    try std.testing.expectEqual(@as(u8, 1), try depth(null));
+    try std.testing.expectEqual(@as(u8, 1), try depth("1"));
+    try std.testing.expectEqual(@as(u8, 2), try depth("2"));
+    try std.testing.expectError(error.BadExl3GroupedDepth, depth("3"));
+    try std.testing.expectError(error.BadExl3GroupedDepth, depth(""));
+}
+
+/// Kit.reserve's device bytes for `rows` rows.
+pub fn scratchBytes(rows: usize) !usize {
+    const pairs = rows * wt.slots;
+    const g = cuda.exl3_grouped.Grouped;
+    const up = try g.pairBytes(wt.dims, wt.moe_w, pairs, try ex.plan(wt.dims, wt.moe_w, true), 2);
+    const down = try g.pairBytes(wt.moe_w, wt.dims, pairs, try ex.plan(wt.moe_w, wt.dims, false), 1);
+    return @max(up, down);
+}
+
+/// An EXL3 routed-expert trellis name: the MTP head's or a decoder layer's, its expert and projection.
+pub const Name = struct { part: Part, layer: usize, expert: usize, proj: Proj };
+
+pub fn parseName(name: []const u8) ?Name {
+    const heads = [_]struct { []const u8, Part }{ .{ "model.language_model.layers.", .main }, .{ "mtp.layers.", .mtp } };
+    for (heads) |h| {
+        if (!std.mem.startsWith(u8, name, h[0])) continue;
+        var it = std.mem.splitScalar(u8, name[h[0].len..], '.');
+        const layer = std.fmt.parseInt(usize, it.next() orelse return null, 10) catch return null;
+        if (!std.mem.eql(u8, it.next() orelse return null, "mlp")) return null;
+        if (!std.mem.eql(u8, it.next() orelse return null, "experts")) return null;
+        const expert = std.fmt.parseInt(usize, it.next() orelse return null, 10) catch return null;
+        const p = it.next() orelse return null;
+        if (!std.mem.eql(u8, it.next() orelse return null, "trellis") or it.next() != null) return null;
+        for (projs, 0..) |want, i| if (std.mem.eql(u8, p, want)) return .{ .part = h[1], .layer = layer, .expert = expert, .proj = @fromBackingInt(@intCast(i)) };
+        return null;
+    }
+    return null;
+}
+
+/// The memory ledger's EXL3 terms for one rank: its decoder layers' images, the MTP head's (rank 0 drafting), the scratch.
+pub const Ledger = struct { main: u64 = 0, mtp: u64 = 0, scratch: u64 = 0 };
+
+/// Device bytes from the folder's headers alone (no tensor byte read), each layer's image as `plan` lays it out.
+pub fn ledger(gpa: std.mem.Allocator, io: std.Io, c: Config, world: usize, rank: usize, drafts: bool, rows: usize) !Ledger {
+    return ledgerShape(gpa, io, c, world, rank, drafts, rows, wt.layers_n, wt.dims, wt.moe_w, wt.experts_n);
+}
+
+pub fn ledgerShape(gpa: std.mem.Allocator, io: std.Io, c: Config, world: usize, rank: usize, drafts: bool, rows: usize, layers: usize, dims: usize, width: usize, count: usize) !Ledger {
+    const own = try routed.Experts.init(count, world, rank);
+    const want_main = c.covers(.main);
+    const want_mtp = c.covers(.mtp) and drafts and rank == 0;
+    var out: Ledger = .{ .scratch = if (want_main or want_mtp) try scratchBytes(rows) else 0 };
+    if (!want_main and !want_mtp) return out;
+    const main = try gpa.alloc(u32, layers * 3 * own.count);
+    defer gpa.free(main);
+    @memset(main, 0);
+    const mtp = try gpa.alloc(u32, 3 * count);
+    defer gpa.free(mtp);
+    @memset(mtp, 0);
+    var store = try wt.Store.open(gpa, io, c.dir);
+    defer store.deinit();
+    const wm = store.parsed.value.object.get("weight_map") orelse return error.MissingTensor;
+    var files: std.StringArrayHashMapUnmanaged(void) = .empty;
+    defer files.deinit(gpa);
+    var wi = wm.object.iterator();
+    while (wi.next()) |item| if (item.value_ptr.* == .string) try files.put(gpa, item.value_ptr.string, {});
+    for (files.keys()) |file| {
+        const path = try std.fs.path.join(gpa, &.{ c.dir, file });
+        defer gpa.free(path);
+        // a rank's folder may hold only its own files (and the MTP's on rank 0); what this rank needs is checked below
+        var meta = core.safetensors.Metadata.read(gpa, io, path) catch |err| switch (err) {
+            error.FileNotFound => continue,
+            else => return err,
+        };
+        defer meta.deinit();
+        var names = meta.names.iterator();
+        while (names.next()) |entry| {
+            const n = parseName(entry.key_ptr.*) orelse continue;
+            const e = entry.value_ptr.*;
+            if (e.dtype != .i16 or e.rank != 3 or e.dim(2) % 8 != 0) return error.UnexpectedTensor;
+            const halves: u32 = @intCast(e.dim(2) / 8);
+            switch (n.part) {
+                .main => {
+                    if (n.layer >= layers or n.expert >= count) return error.UnexpectedTensor;
+                    if (n.expert < own.first or n.expert >= own.first + own.count) continue;
+                    main[(n.layer * 3 + @backingInt(n.proj)) * own.count + n.expert - own.first] = halves;
+                },
+                .mtp => {
+                    if (n.layer != 0 or n.expert >= count) return error.UnexpectedTensor;
+                    mtp[@as(usize, @backingInt(n.proj)) * count + n.expert] = halves;
+                },
+            }
+        }
+    }
+    if (want_main) for (0..layers) |layer| {
+        const at = layer * 3 * own.count;
+        out.main += try imageBytes(gpa, dims, width, main[at..][0 .. 3 * own.count], own.count);
+    };
+    if (want_mtp) out.mtp = try imageBytes(gpa, dims, width, mtp, count);
+    return out;
+}
+
+fn imageBytes(gpa: std.mem.Allocator, dims: usize, width: usize, halves: []const u32, count: usize) !u64 {
+    for (halves) |h| if (h == 0) return error.MissingTensor;
+    var l = try layout.Layout.init(gpa, dims, width, .{ halves[0..count], halves[count..][0..count], halves[2 * count ..][0..count] });
+    defer l.deinit(gpa);
+    return l.total;
+}
+
+test {
+    _ = @import("cuda_exl3_experts_test.zig");
+}
