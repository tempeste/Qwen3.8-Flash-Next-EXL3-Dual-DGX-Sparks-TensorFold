+//! TF_FLASHNEXT_EXPERTS_EXL3 on the host: the switch, the EXL3 names, a rank's experts in its image, the ledger.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const x = @import("cuda_exl3_experts.zig");
+const layout = @import("cuda_exl3_routed.zig");
+const Fake = @import("cuda_modelopt_threads_test.zig").Fake;
+const ta = std.testing.allocator;
+const io = std.testing.io;
+
+const count = 4;
+const dims = 256;
+const width = 128;
+const projs = [_][]const u8{ "gate_proj", "up_proj", "down_proj" };
