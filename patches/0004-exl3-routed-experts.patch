+        std.debug.print("BENCH {d} rows ({d} pairs, tile {d}, {d} experts touched): nvfp4 {d:.1} us {d:.0} GB/s\n", .{ rows, pairs, pt, used.count(), nv_us, nv_gbs });
+        for (arms.items) |arm| {
+            var pass: Pass = .{ .s = .{ .mixed = x, .moe_act = act, .y = y }, .k = &k, .stream = r.s };
+            var bytes: f64 = 0;
+            for (used.keys()) |e| bytes += @floatFromInt(arm.per_expert[@intCast(e)]);
+            const bpw = bytes / touched / (3 * D * NI) * 8;
+            const prompt_served = X.prompt.takes(loaded_rows, rows, arm.owned.exl3_prompt);
+            for (variants, 0..) |v, vi| {
+                if (v.prompt != null and !arm.owned.exl3_prompt) continue;
+                k.exl3.?.grouped.tile = v.tile;
+                k.exl3.?.grouped.depth = v.depth;
+                k.exl3.?.grouped.x_ahead = v.x_ahead;
+                k.exl3.?.grouped.fit = v.fit;
+                k.exl3.?.prompt_rows = if (v.prompt != null) 1 else 0;
+                k.exl3.?.prompt_dn = v.prompt orelse loaded.prompt.?;
+                var us: f64 = 0;
+                for (0..2) |phase| {
+                    const t0 = check.now(gpu.io);
+                    for (0..if (phase == 0) 3 else reps) |_| try flash.moe_native.exl3(&pass, picks, &arm.owned, p, pairs, rows, count + 1, @intCast(count));
+                    try r.s.synchronize();
+                    if (phase == 1) us = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e3 / reps;
+                }
+                try act_b.download(0, std.mem.sliceAsBytes(cur_act[0 .. pairs * NI]));
+                try y_b.download(0, std.mem.sliceAsBytes(cur_y[0 .. pairs * D]));
+                var dist: ?[2]f64 = null;
+                if (vi == 0) {
+                    @memcpy(ref_act[0 .. pairs * NI], cur_act[0 .. pairs * NI]);
+                    @memcpy(ref_y[0 .. pairs * D], cur_y[0 .. pairs * D]);
+                } else if (vi == first_prompt) {
+                    @memcpy(ref2_act[0 .. pairs * NI], cur_act[0 .. pairs * NI]);
+                    @memcpy(ref2_y[0 .. pairs * D], cur_y[0 .. pairs * D]);
+                    dist = relL2(picks_h, count, ref_act, ref_y, cur_act, cur_y);
+                } else if (v.exact) {
+                    const ra = if (v.prompt != null) ref2_act else ref_act;
+                    const ry = if (v.prompt != null) ref2_y else ref_y;
+                    const same = std.mem.eql(u16, ra[0 .. pairs * NI], cur_act[0 .. pairs * NI]) and
+                        std.mem.eql(u32, ry[0 .. pairs * D], cur_y[0 .. pairs * D]);
+                    try check.expect(same, "{d} rows, {s}: {s}'s act and y bytes equal {s}'s", .{ rows, arm.label, v.label, variants[if (v.prompt != null) first_prompt else 0].label });
+                }
+                const gbs = bytes / us / 1e3;
+                const ratio = gbs / nv_gbs;
+                const served = if (prompt_served) v.prompt == loaded.prompt else v.prompt == null and v.tile == loaded.tile and v.depth == loaded.depth and v.x_ahead == loaded.x_ahead and v.fit == loaded.fit;
+                const below = served and !prompt_served and ratio < 0.6;
+                stop = stop or below;
+                std.debug.print("BENCH {d} rows: exl3 {s} ({d:.2} bpw) [{s}{s}] {d:.1} us {d:.0} GB/s = {d:.2}x nvfp4's GB/s, time {d:.2}x nvfp4's{s}\n", .{ rows, arm.label, bpw, v.label, if (served) ", served" else "", us, gbs, ratio, us / nv_us, if (below) " STOP (below 0.6x)" else "" });
+                if (dist) |dd| std.debug.print("BENCH {d} rows: exl3 {s}: prompt kernels vs grouped rel L2 act {e:.2}, y {e:.2}\n", .{ rows, arm.label, dd[0], dd[1] });
+                if (served and prompt_served) std.debug.print("BENCH prompt {d} rows: exl3 {s} served prompt kernels time {d:.3}x nvfp4's ({d:.1} vs {d:.1} us)\n", .{ rows, arm.label, us / nv_us, us, nv_us });
+            }
+            k.exl3.?.grouped.tile = loaded.tile;
+            k.exl3.?.grouped.depth = loaded.depth;
+            k.exl3.?.grouped.x_ahead = loaded.x_ahead;
+            k.exl3.?.grouped.fit = loaded.fit;
+            k.exl3.?.prompt_rows = loaded_rows;
+            k.exl3.?.prompt_dn = loaded.prompt.?;
+        }
+        clock.step("{d} rows timed ({d} variants a layer, bytes equal across them)", .{ rows, variants.len });
+    }
+    if (stop) {
+        std.debug.print("BENCH verdict: STOP, EXL3 below 0.6x NVFP4's GB/s\n", .{});
+        std.process.exit(3);
+    }
+    check.pass("{s}: EXL3 (synthetic and pack {s} rank {d}) at or above 0.6x NVFP4's GB/s at every row count", .{ cmd, in.pack, in.rank });
+}
