+    try std.testing.expectEqual(@as(usize, width), l.width);
+    try std.testing.expectEqual(x.act_mode, l.act_mode);
+    try std.testing.expectEqual(cuda.exl3_experts.Codebook.mul1, l.codebook);
+    try std.testing.expectEqual(@as(f32, 0), l.limit);
+    const img = o.image.?;
+    const ptrs = [3]u64{ l.gate, l.up, l.down };
+    const k2s = [3]u64{ l.gate_k2, l.up_k2, l.down_k2 };
+    const suh = [3]u64{ l.suh_g, l.suh_u, l.suh_d };
+    const svh = [3]u64{ l.svh_g, l.svh_u, l.svh_d };
+    for (0..3) |p| {
+        const s = layout.kn(@fromBackingInt(@intCast(p)), dims, width);
+        for (0..n) |i| {
+            const e = first + i;
+            const at = std.mem.readInt(u64, deviceBytes(ptrs[p] + i * 8, 8)[0..8], .little);
+            try std.testing.expect(at >= img.ptr and at < img.ptr + img.len and (at - img.ptr) % layout.align_bytes == 0);
+            try std.testing.expectEqualSlices(u8, pk.trellis[part][e][p], deviceBytes(at, pk.trellis[part][e][p].len));
+            try std.testing.expectEqual(@as(i32, @intCast(Pack.halvesOf(e, p))), std.mem.readInt(i32, deviceBytes(k2s[p] + i * 4, 4)[0..4], .little));
+            try std.testing.expectEqualSlices(u8, pk.suh[part][e][p], deviceBytes(suh[p] + i * s[0] * 2, s[0] * 2));
+            try std.testing.expectEqualSlices(u8, pk.svh[part][e][p], deviceBytes(svh[p] + i * s[1] * 2, s[1] * 2));
+        }
+    }
+}
+
