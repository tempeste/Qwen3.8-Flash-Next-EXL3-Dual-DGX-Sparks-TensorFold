+/// placementWeightBytes under TF_FLASHNEXT_EXPERTS_EXL3: the covered parts' NVFP4 / FP8 routed experts out, their EXL3
+/// images (from the folder's headers) and the grouped kernels' scratch for the widest pass in.
+pub fn exl3Bytes(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, c: @import("cuda_exl3_experts.zig").Config, world: usize, rank: usize, drafts: bool) !u64 {
+    const chunk = @import("cuda_chunk.zig");
+    const parts = try @import("cuda_rank_memory.zig").estimateParts(gpa, io, dir, world, rank);
+    const busy = try chunk.chunkRowsAt(world);
+    const rows = @max(busy, try chunk.soloRows(busy));
+    const x = try @import("cuda_exl3_experts.zig").ledger(gpa, io, c, world, rank, drafts, rows);
+    var total = parts.total + x.scratch;
+    if (c.covers(.main)) total = total - parts.routed + x.main;
+    if (drafts and rank == 0) {
+        const fp8 = try headFp8(gpa, io, dir);
+        const head = mtp.headBytes(fp8) + (1 << 30);
+        total += if (c.covers(.mtp)) head - mtp.headRoutedBytes(fp8) + x.mtp else head;
+    }
+    return total;
+}
