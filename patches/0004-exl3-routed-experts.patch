+
+/// A tensor of the fixture shard: name, dtype, shape (any rank) and bytes.
+const Entry = struct { name: []const u8, dtype: []const u8, shape: []const usize, data: []const u8 };
+
+fn fixture(dir: std.Io.Dir, entries: []const Entry) !void {
+    var header: std.Io.Writer.Allocating = .init(ta);
+    defer header.deinit();
+    var index: std.Io.Writer.Allocating = .init(ta);
+    defer index.deinit();
+    var data: std.ArrayList(u8) = .empty;
+    defer data.deinit(ta);
+    try header.writer.writeByte('{');
+    try index.writer.writeAll("{\"weight_map\":{");
+    for (entries, 0..) |e, i| {
+        if (i > 0) {
+            try header.writer.writeByte(',');
+            try index.writer.writeByte(',');
+        }
+        const at = data.items.len;
+        try data.appendSlice(ta, e.data);
+        try header.writer.print("\"{s}\":{{\"dtype\":\"{s}\",\"shape\":[", .{ e.name, e.dtype });
+        for (e.shape, 0..) |d, j| try header.writer.print("{s}{d}", .{ if (j > 0) "," else "", d });
+        try header.writer.print("],\"data_offsets\":[{d},{d}]}}", .{ at, data.items.len });
+        try index.writer.print("\"{s}\":\"experts-r0-00001-of-00001.safetensors\"", .{e.name});
+    }
+    try header.writer.writeByte('}');
+    try index.writer.writeAll("}}");
+    while (header.written().len % 8 != 0) try header.writer.writeByte(' ');
+    var image: std.Io.Writer.Allocating = .init(ta);
+    defer image.deinit();
+    try image.writer.writeAll(&std.mem.toBytes(std.mem.nativeToLittle(u64, header.written().len)));
+    try image.writer.writeAll(header.written());
+    try image.writer.writeAll(data.items);
+    try dir.writeFile(io, .{ .sub_path = "experts-r0-00001-of-00001.safetensors", .data = image.written() });
+    try dir.writeFile(io, .{ .sub_path = "model.safetensors.index.json", .data = index.written() });
+}
+
+/// Every expert's projections under EXL3 names: bytes that name their expert and projection, and a width per expert.
+const Pack = struct {
+    arena: std.heap.ArenaAllocator,
+    entries: std.ArrayList(Entry) = .empty,
+    trellis: [2][count][3][]u8 = undefined,
+    suh: [2][count][3][]u8 = undefined,
+    svh: [2][count][3][]u8 = undefined,
+
+    fn halvesOf(e: usize, p: usize) u32 {
+        return @intCast(4 + (e + p) % 3); // 2, 2.5 and 3 bits
+    }
+
+    fn init(marker: u32, layer: usize) !*Pack {
+        const pk = try ta.create(Pack);
+        pk.* = .{ .arena = .init(ta) };
+        const a = pk.arena.allocator();
+        const mul1 = try a.dupe(u8, &std.mem.toBytes(std.mem.nativeToLittle(u32, marker)));
+        for (0..2) |part| for (0..count) |e| for (projs, 0..) |proj, p| {
+            const s = layout.kn(@fromBackingInt(@intCast(p)), dims, width);
+            const h = halvesOf(e, p);
+            const tb = try layout.trellisBytes(s[0], s[1], h);
+            const t = try a.alloc(u8, tb);
+            for (t, 0..) |*b, i| b.* = @truncate(i * 7 + e * 31 + p * 101 + part * 13);
+            const su = try a.alloc(u8, s[0] * 2);
+            @memset(su, @intCast(0x10 + e * 4 + p + part * 64));
+            const sv = try a.alloc(u8, s[1] * 2);
+            @memset(sv, @intCast(0x80 + e * 4 + p + part * 32));
+            pk.trellis[part][e][p] = t;
+            pk.suh[part][e][p] = su;
+            pk.svh[part][e][p] = sv;
+            const base = if (part == 0) try std.fmt.allocPrint(a, "model.language_model.layers.{d}.mlp.experts.{d}.{s}", .{ layer, e, proj }) else try std.fmt.allocPrint(a, "mtp.layers.0.mlp.experts.{d}.{s}", .{ e, proj });
+            const shape_t = try a.dupe(usize, &.{ s[0] / 16, s[1] / 16, h * 8 });
+            try pk.entries.append(a, .{ .name = try std.fmt.allocPrint(a, "{s}.trellis", .{base}), .dtype = "I16", .shape = shape_t, .data = t });
+            try pk.entries.append(a, .{ .name = try std.fmt.allocPrint(a, "{s}.suh", .{base}), .dtype = "F16", .shape = try a.dupe(usize, &.{s[0]}), .data = su });
+            try pk.entries.append(a, .{ .name = try std.fmt.allocPrint(a, "{s}.svh", .{base}), .dtype = "F16", .shape = try a.dupe(usize, &.{s[1]}), .data = sv });
+            try pk.entries.append(a, .{ .name = try std.fmt.allocPrint(a, "{s}.mul1", .{base}), .dtype = "I32", .shape = &.{}, .data = mul1 });
+        };
+        return pk;
+    }
+
+    fn deinit(pk: *Pack) void {
+        pk.arena.deinit();
+        ta.destroy(pk);
+    }
+};
+
+fn deviceBytes(addr: u64, n: usize) []const u8 {
+    return @as([*]const u8, @ptrFromInt(addr))[0..n];
+}
+
+/// The loaded image holds global experts first.. at slots 0.., with their own trellis, width and scales.
+fn expectRank(pk: *const Pack, part: usize, o: anytype, first: usize, n: usize) !void {
+    try std.testing.expectEqual(cuda.experts.Format.exl3, o.format);
+    try std.testing.expectEqual(first, o.first);
+    try std.testing.expectEqual(n, o.count);
+    const v = o.view();
