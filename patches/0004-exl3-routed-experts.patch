index 0000000000000000000000000000000000000000..d4885009a4bd2c2c9d61aa3d11c9567566edca0d
--- /dev/null
+++ b/zig/kernels/cuda/exl3_fnx_prompt.cuh
@@ -0,0 +1,265 @@
+// Flash Next's EXL3 prompt experts (TF_EXL3_PROMPT_ROWS, cuda_exl3_prompt.zig): x3gm v2's items (DeepSeek-V4.1's
+// prefill experts, exl3_block/x3gm.cu) on the Grouped plan's 64-member items, every width of an item in one launch.
+// Each item decodes its expert's 128-column block once for up to 64 pairs and keeps one fp32 mma chain an output over
+// ascending k (no split-K partials); the epilogues are fused:
+//   rotate: x0 / x1 [P, D] = plan_rotate's gate and up inputs of every routed pair (fp16), one warp a 128-value block;
+//   gate/up: act [P, I] = plan_finish's bf16 silu(gate) * up (act_mode 1, no clamp), and xd [P, I] = plan_rotate's down
+//            input from those bf16 values (bf16 act * suh_d, Hadamard, fp16), so the down call needs no rotation;
+//   down: y [P, D] fp32 = x3gm's down epilogue (Hadamard, * svh_d), plan_finish's arithmetic.
+// Pairs routed to `skip` (another rank's, the shared slot) are neither read nor written.
+#pragma once
+
+#define DSV41_X3GM_NO_INSTANCES
+#include "exl3_block/x3gm.cu"
+#undef DSV41_X3GM_NO_INSTANCES
+
+namespace tf_exl3_fnx {
+
+using dsv41_x3gm::Args;
+using dsv41_x3gm::Cfg;
+using dsv41_x3gm::NB;
+using dsv41_x3gm::cp_async16;
+using dsv41_x3gm::swz;
+using dsv41_x3gm::kloop2;
+using dsv41_x3gm::Ring2;
+using dsv41_x3gm::Smem2;
+using tf_common::cp_commit;
+using tf_common::cp_wait;
+
+// The tiles (x3gm's MTL, NG, KS, NSA, NGR): gate/up GM_GU1 (two inputs; v3's default for them), down v3's default
+// (1, 8, 4, 4, 8: 8-warp CTAs) and GM_DN0. Each has 64 members a pass (NG 8), the Grouped plan's prompt tile.
+#define TF_FNX_GU 2, 8, 2, 4, 4
+#define TF_FNX_DN 1, 8, 4, 4, 8
+#define TF_FNX_DN0 2, 8, 4, 4, 8
+constexpr int MEMBERS = 64;
+// The dynamic shared memory every instance is launched with (Smem2's for each tile: the 4-bit ring's 4 stages); the
+// host passes it (exl3_experts.zig fnx_smem) and each block checks it got at least its own.
+constexpr unsigned SMEM = 49152;
+
+struct FnxArgs {
+    Args g;                      // x0 / x1, tp0 / tp1 (pointer tables), k2e (widths), sv0 / sv1 / sd, xd, y, K, N, limit
+    const int* items;            // the Grouped plan's (expert, first, count) an item, at most MEMBERS members
+    const int* counts;           // [0]: items
+    const int* members;          // pair indices
+    const int* k2u;              // gate/up: up's widths (each equal to gate's in k2e)
+    __nv_bfloat16* act;          // gate/up: bf16 silu(gate) * up [P, N]
+    int skip;                    // the plan entry of pairs this rank does not hold
+};
+static_assert(sizeof(Args) == 160 && sizeof(FnxArgs) == 208 && offsetof(FnxArgs, items) == 160 &&
+                  offsetof(FnxArgs, skip) == 200,
+              "cuda_exl3_prompt.zig's FnxArgs");
+
+__device__ __forceinline__ unsigned dynamic_smem() {
+    unsigned v;
+    asm("mov.u32 %0, %%dynamic_smem_size;" : "=r"(v));
+    return v;
+}
+
+// gm2_item with Flash Next's gate/up epilogue (MATS 2, XM 2): x3gm's loads and K loop, then act and xd as above.
+template <int K2, int MTL, int NG, int KS, int NSA, int NGR>
+__device__ __forceinline__ void gu_item(const FnxArgs& f, unsigned char* smem, const int* rows_sh, int e, int cnt,
+                                        int nb) {
+    constexpr int MATS = 2, XM = 2;
+    using C = Cfg<MATS, XM, K2, MTL, NG, KS, NSA, NGR>;
+    constexpr int THREADS = C::THREADS, BM = C::BM, LDE = C::LDE, ER = C::ER, CPR = C::CPR, TW = C::TW, W = C::W;
+    constexpr int ACH = XM * BM * CPR, WCH = MATS * KS * NB * K2;
+    constexpr int APT = (ACH + THREADS - 1) / THREADS, WPT = (WCH + THREADS - 1) / THREADS;
+    const Args& a = f.g;
+    float* ep = reinterpret_cast<float*>(smem);
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int mat = warp / C::WPM, slice = warp % C::WPM;
+    const int K = a.K, N = a.N, KT = K >> 4, NTILES = N >> 4, S = KT / KS;
+    const int lr = (lane & 7) + ((lane >> 4) << 3), lc = (lane >> 3) & 1;
+    const tf_exl3x::LaneMap<K2> map(lane);
+    const uint32_t* te0 = reinterpret_cast<const uint32_t*>(a.tp0[e]);
+    const uint32_t* te1 = reinterpret_cast<const uint32_t*>(a.tp1[e]);
+    const int cnt16 = (cnt + 15) & ~15;
+
+    int a_src[APT], w_src[WPT];
+#pragma unroll
+    for (int j = 0; j < APT; ++j) {
+        const int i = threadIdx.x + j * THREADS, r = (i / CPR) % BM, c = i % CPR;
+        int v = -1;
+        if (i < ACH && r < cnt16) v = rows_sh[r] < 0 ? -2 : rows_sh[r] * K + c * 8;
+        a_src[j] = v;
+    }
+#pragma unroll
+    for (int j = 0; j < WPT; ++j) {
+        const int i = threadIdx.x + j * THREADS, q = i % K2, n = (i / K2) % NB, kk = (i / (K2 * NB)) % KS;
+        w_src[j] = (kk * NTILES + nb * NB + n) * TW + q * 4;
+    }
+    auto load_stage = [&](int s) {
+        unsigned char* st = smem + (size_t)(s % NSA) * C::STAGE;
+        half* ra = reinterpret_cast<half*>(st);
+        uint32_t* rw = reinterpret_cast<uint32_t*>(st + C::A_BYTES);
+        const int k0 = s * KS * 16;
+#pragma unroll
+        for (int j = 0; j < APT; ++j) {
+            const int i = threadIdx.x + j * THREADS, v = a_src[j];
+            if (v != -1) {
+                const int m = i / (BM * CPR), r = (i / CPR) % BM, c = i % CPR;
+                cp_async16(ra + ((size_t)m * BM + r) * C::LDA + swz<CPR>(r, c) * 8,
+                           (m ? a.x1 : a.x0) + (v < 0 ? 0 : v + k0), v >= 0);
+            }
+        }
+        const size_t ws = (size_t)s * KS * NTILES * TW;
+#pragma unroll
+        for (int j = 0; j < WPT; ++j) {
+            const int i = threadIdx.x + j * THREADS;
+            if (WCH % THREADS == 0 || i < WCH) {
+                const int q = i % K2, n = (i / K2) % NB, kk = (i / (K2 * NB)) % KS, m = i / (K2 * NB * KS);
+                cp_async16(rw + ((m * KS + kk) * NB + n) * TW + q * 4, (m ? te1 : te0) + ws + w_src[j], true);
+            }
+        }
+    };
+
+    float acc[MTL][NG][4];
+#pragma unroll
+    for (int l = 0; l < MTL; ++l)
+#pragma unroll
+        for (int n = 0; n < NG; ++n)
+#pragma unroll
+            for (int c = 0; c < 4; ++c) acc[l][n][c] = 0.f;
+
+    static_assert(NG == 8, "64-member passes");
+    const int n8 = (cnt + 7) >> 3;
+#define FNX_K(G) kloop2<G, MATS, XM, K2, MTL, NG, KS, NSA, NGR>(acc, smem, S, mat, mat, slice, lr, lc, map, load_stage)
+    switch (n8) {
+        case 1: FNX_K(1); break;
+        case 2: FNX_K(2); break;
+        case 3: FNX_K(3); break;
+        case 4: FNX_K(4); break;
+        case 5: FNX_K(5); break;
+        case 6: FNX_K(6); break;
+        case 7: FNX_K(7); break;
+        default: FNX_K(8); break;
+    }
+#undef FNX_K
+
+    const int g = lane >> 2, t = lane & 3;
+#pragma unroll
+    for (int rd = 0; rd < C::ROUNDS; ++rd) {
+        if (rd) __syncthreads();
+        if (ER * rd < cnt) {
+#pragma unroll
+            for (int n = 0; n < NGR; ++n) {
+                const int ng = rd * NGR + n;
+                float* E = ep + ((size_t)mat * ER + 8 * n + 2 * t) * LDE + slice * 16 * MTL + g;
+#pragma unroll
+                for (int l = 0; l < MTL; ++l) {
+                    E[l * 16] = acc[l][ng][0];
+                    E[LDE + l * 16] = acc[l][ng][1];
+                    E[l * 16 + 8] = acc[l][ng][2];
+                    E[LDE + l * 16 + 8] = acc[l][ng][3];
+                }
+            }
+        }
+        __syncthreads();
+        for (int r = warp; r < ER && ER * rd + r < cnt; r += W) {
+            const int row = rows_sh[ER * rd + r];
+            const int c0 = 4 * lane;
+            const size_t col = (size_t)e * N + nb * 128 + c0;
+            float v[4], u[4];
+            *reinterpret_cast<float4*>(v) = *reinterpret_cast<const float4*>(ep + (size_t)r * LDE + c0);
+            *reinterpret_cast<float4*>(u) = *reinterpret_cast<const float4*>(ep + ((size_t)ER + r) * LDE + c0);
+            tf_exl3::fwht128(v, lane);
+            tf_exl3::fwht128(u, lane);
+            float xv[4];
+            __nv_bfloat16* ao = f.act + (size_t)row * N + nb * 128 + c0;
+#pragma unroll
