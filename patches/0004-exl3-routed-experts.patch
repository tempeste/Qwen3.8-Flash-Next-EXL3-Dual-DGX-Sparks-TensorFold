+    if (rows_list.items.len == 0) try rows_list.appendSlice(a, &.{ 84, 48, 1536 });
+    watchdog(cmd);
+    const clock = Clock.start(gpu.io, cmd);
+    var rng = std.Random.DefaultPrng.init(0xbe7c);
