+/// TF_FLASHNEXT_EXPERTS_EXL3's experts (cuda_exl3_experts.zig): 16-pair items at every row count when the kit's grouped
+/// tile is 16 (Kit.load's; the batch scratch holds that many items), else NVFP4's tiles (16-pair decode, 64-pair prompt
+/// items from factRows() rows); SwiGLU's bf16 activations into moe_act, each pair's fp32 row into y as NVFP4 writes them.
+/// Passes of TF_EXL3_PROMPT_ROWS rows or more take the prompt kernels' 64-pair items instead (cuda_exl3_prompt.zig), the
+/// same act and y rows.
+pub fn exl3(self: anytype, picks: u64, owned: anytype, plan: cuda.grouped.Plan, pairs: usize, n: usize, e: usize, skip: i32) !void {
+    const s = self.s;
+    const kit = self.k.exl3 orelse return error.FormatNotLoaded;
+    if (pairs > kit.grouped.pair_cap) return error.Exl3ScratchShort; // Engine.reserve sizes it with the batch scratch
+    const xp = @import("cuda_exl3_prompt.zig");
+    if (xp.takes(kit.prompt_rows, n, owned.exl3_prompt)) {
+        const store = kit.grouped.storage orelse return error.Exl3ScratchShort;
+        try self.k.router.route(self.stream, picks, pairs, e, xp.members, plan);
+        const items = cuda.grouped.maxItems(pairs, e, xp.members);
+        return xp.run(&kit.experts, self.stream, owned.exl3.?, store.ptr, store.len, kit.grouped.pair_cap, s.mixed, dims, slots, picks, plan, s.moe_act, s.y, pairs, items, skip, kit.prompt_dn);
+    }
+    const pt = if (kit.grouped.tile == 16) 16 else nvfp4_tile.size(n);
+    try self.k.router.route(self.stream, picks, pairs, e, pt, plan);
+    const items = cuda.grouped.maxItems(pairs, e, pt);
+    const g: cuda.experts.Grouped = .{ .exl3 = &kit.grouped };
+    const call = if (pt == 16) &cuda.experts.Grouped.decode else &cuda.experts.Grouped.prompt;
+    try call(g, self.stream, .up, .{ .x = s.mixed, .stride = dims, .slots = slots }, owned.view(), plan, s.moe_act, items, skip);
+    try call(g, self.stream, .down_f32, .{ .x = s.moe_act, .stride = owned.width }, owned.view(), plan, s.y, items, skip);
+}
