From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shuuul <6903405+shuuul@users.noreply.github.com>
Date: Wed, 4 Nov 2026 12:43:00 +0000
Subject: [PATCH 08/34] cuda: stage synchronous downloads through a thread's
 pinned buffer

Upstream TensorFold commit by shuuul, ported onto this series (upstream main a3962b45fc57).

On GB10 (driver 580.178.04, ATS) a synchronous cuMemcpyDtoH_v2 straight into
pageable host memory can return success while some pages keep their old
contents and the bytes land elsewhere; zspark's rank-round test met it 10
times in 60 runs, corrupting its allocator's metadata. Pin a bounce buffer
per thread (at most 4 MiB a piece) and copy on from it with the CPU.

The cost on an idle GB10 (2,000 copies, direct against staged): 4 B 5.90 vs
6.51 us, 32 KiB 5.33 vs 6.91, a 303,104 B logits row 10.59 vs 20.97, 4 MiB
84.74 vs 212.36, 64 MiB 1,354.59 vs 4,095.36.

The smoke test now downloads 6 MiB through two pieces.

(cherry picked from commit a3962b45fc57be0241ba5c7b022ee9ae2bdc81d1)
---
 zig/src/cuda/download_stage.zig  | 39 ++++++++++++++++++++++++++++++++
 zig/src/cuda/memory.zig          | 12 +++++++++-
 zig/tests/cuda/runtime_tests.zig | 10 ++++++++
 3 files changed, 60 insertions(+), 1 deletion(-)
 create mode 100644 zig/src/cuda/download_stage.zig

diff --git a/zig/src/cuda/download_stage.zig b/zig/src/cuda/download_stage.zig
new file mode 100644
index 0000000000000000000000000000000000000000..77a8f9efd87e80c5b0e82d9b8b3b2128cc54c389
--- /dev/null
+++ b/zig/src/cuda/download_stage.zig
@@ -0,0 +1,39 @@
+//! What every synchronous download lands in first: this thread's page-locked memory, at most `most`
+//! bytes, copied on into the caller's by the CPU. On GB10 a `cuMemcpyDtoH` straight into pageable
+//! memory (the host allocator's, freshly mapped) can miss pages with no CUDA error: some keep what
+//! they held, the bytes land on other pages of the process. Calls to `DeviceBuffer.download` stage
+//! through here; `downloadAsync` still needs pinned memory, as documented.
+const std = @import("std");
+const abi = @import("abi.zig");
+const Driver = @import("driver.zig").Driver;
+const Error = @import("driver.zig").Error;
+
+/// The largest piece one copy takes; larger downloads go through in pieces.
+pub const most: usize = 4 << 20;
+
+const Held = struct { d: *const Driver, bytes: []align(16) u8 };
+threadlocal var held: ?Held = null;
+
+/// This thread's page-locked buffer of at least `len` bytes, reallocated when a larger piece is asked
+/// for. The driver allocates it directly, so it is not counted in `memory.usage`: it is one per
+/// thread, bounded by `most`, and kept for that thread's next download.
+pub fn take(d: *const Driver, len: usize) Error![]align(16) u8 {
+    if (held) |h| {
+        if (h.d == d and h.bytes.len >= len) return h.bytes[0..len];
+        drop();
+    }
+    const size = @min(most, std.math.ceilPowerOfTwoAssert(usize, @max(len, 64 << 10)));
+    var p: ?*anyopaque = null;
+    try d.check(d.api.cuMemHostAlloc(&p, size, abi.host_alloc_portable), "cuMemHostAlloc");
+    const base: [*]align(16) u8 = @ptrCast(@alignCast(p.?));
+    held = .{ .d = d, .bytes = base[0..size] };
+    return held.?.bytes[0..len];
+}
+
+/// Frees this thread's buffer, if one is held.
+pub fn drop() void {
+    if (held) |h| {
+        _ = h.d.api.cuMemFreeHost(h.bytes.ptr);
+        held = null;
+    }
+}
diff --git a/zig/src/cuda/memory.zig b/zig/src/cuda/memory.zig
index 5c0022dfce302f0d40fa7da19dfdf56a166a27f9..6e77c8dd88e7e4c60a7d6e6339af5657b65b30d1 100644
--- a/zig/src/cuda/memory.zig
+++ b/zig/src/cuda/memory.zig
@@ -190,10 +190,20 @@ pub const DeviceBuffer = struct {
         try @import("copy_source.zig").synchronousCopy(self.d, dst, bytes, std.heap.page_allocator);
     }
 
+    /// Returns once the bytes have landed; the copy stages through this thread's page-locked buffer, a
+    /// piece of at most `download_stage.most` bytes at a time (see that module for why).
     pub fn download(self: DeviceBuffer, offset: usize, out: []u8) Error!void {
         const src = try self.span(offset, out.len);
         if (out.len == 0) return;
-        try self.d.check(self.d.api.cuMemcpyDtoH_v2(out.ptr, src, out.len), "cuMemcpyDtoH");
+        const stage = @import("download_stage.zig");
+        var done: usize = 0;
+        while (done < out.len) {
+            const n = @min(out.len - done, stage.most);
+            const bounce = try stage.take(self.d, n);
+            try self.d.check(self.d.api.cuMemcpyDtoH_v2(bounce.ptr, src + done, n), "cuMemcpyDtoH");
+            @memcpy(out[done..][0..n], bounce[0..n]);
+            done += n;
+        }
     }
 
     /// Owns a pinned source copy until completion. Captured uploads must use copy_source.Stage or Buffer.
diff --git a/zig/tests/cuda/runtime_tests.zig b/zig/tests/cuda/runtime_tests.zig
index 53a843c8126d5b1dab729d3746aa3789aad579de..e3189c27dd896a260dc2dda9b5190ec32b1dcfe7 100644
--- a/zig/tests/cuda/runtime_tests.zig
+++ b/zig/tests/cuda/runtime_tests.zig
@@ -25,6 +25,16 @@ pub fn smoke(gpu: Gpu) !void {
     try check.sameBytes("H2D, D2D, D2H round trip (1 MiB)", back, pattern);
     check.pass("blocking copies: 1 MiB host -> device -> device -> host equal", .{});
 
+    // Larger than one staged piece: the copy goes through in pieces and still lands whole.
+    const big_n: usize = 6 << 20;
+    var big = try cuda.DeviceBuffer.alloc(d, big_n);
+    defer big.free();
+    try big.fill8(0x3c, null);
+    const big_back = try check.download(gpu, big);
+    defer gpu.gpa.free(big_back);
+    try expect(std.mem.allEqual(u8, big_back, 0x3c), "6 MiB download", .{});
+    check.pass("blocking copies: a 6 MiB download through staged pieces equal", .{});
+
     var stream = try cuda.Stream.init(d, true);
     defer stream.deinit();
     var pinned = try cuda.HostBuffer.alloc(d, n);
