diff --git a/zig/tests/cuda/prompt_tile2_bench.zig b/zig/tests/cuda/prompt_tile2_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..80a51ebf3902bb4eb45b6e79fbdd6ea3212aaf60
--- /dev/null
+++ b/zig/tests/cuda/prompt_tile2_bench.zig
@@ -0,0 +1,123 @@
+//! A Qwen3.8 Flash Next rank's MXFP8 prompt projections at 1536 rows a chunk: each DeltaNet in-projection (36 a pass)
+//! and attention qkv (12) on the prompt tile, the two-stage tile, the bf16-once tiles (TF_FLASHNEXT_PROMPT_TILE2) and
+//! the FP8 mma (TF_FLASHNEXT_PROMPT_FP8MMA), and the split shared expert's gate and up (48) as two lane matmuls and
+//! SwiGLU or one fused launch (TF_FLASHNEXT_PROMPT_SHARED_FUSED); ms a launch and a chunk.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const t = @import("prompt_tile2_tests.zig");
+
+const qmmf = cuda.qmmf;
+const qmmf8 = cuda.qmmf8;
+
+const rows = 1536;
+const k = 2560;
+const reps = 20;
+const Proj = struct { name: []const u8, n: usize, per_chunk: usize };
+const projections = [_]Proj{ .{ .name = "DeltaNet in", .n = 8240, .per_chunk = 36 }, .{ .name = "attention qkv", .n = 7296, .per_chunk = 12 } };
+const Variant = enum { prompt_mx, prompt_mx2, t2_128, t2_256, fp8_128, fp8_256 };
+
+pub fn run(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const major = (try gpu.ctx.capability()) / 10;
+    const fp8 = major >= 12;
+    const saved = .{ qmmf.prompt_mx_min_n, qmmf.mx2_tile, qmmf.tile2, qmmf.fp8mma };
+    defer {
+        qmmf.prompt_mx_min_n = saved[0];
+        qmmf.mx2_tile = saved[1];
+        qmmf.tile2 = saved[2];
+        qmmf.fp8mma = saved[3];
+    }
+    qmmf.prompt_mx_min_n = 1;
+    qmmf.fp8mma = fp8;
+    var lane = try qmmf.Lane.load(gpu.d, major);
+    defer lane.unload();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var t0 = try cuda.Event.init(gpu.d, true);
+    defer t0.deinit();
+    var t1 = try cuda.Event.init(gpu.d, true);
+    defer t1.deinit();
+    var prng = std.Random.DefaultPrng.init(0xbe4c_5eed);
+    const rng = prng.random();
+    const x = try t.activations(gpu, rng, rows, k, k);
+    defer a.free(x);
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+    defer dx.free();
+    var dy = try cuda.DeviceBuffer.alloc(gpu.d, rows * 8240 * 2);
+    defer dy.free();
+    var part = try cuda.DeviceBuffer.alloc(gpu.d, 8 * rows * k * 4);
+    defer part.free();
+    const variants = comptime std.enums.values(Variant);
+    var chunk: [variants.len]f64 = @splat(0);
+    std.debug.print("{d} rows, K {d}, ms a launch (TFLOPS):\n", .{ rows, k });
+    for (projections) |p| {
+        var h = try t.Host.init(gpu, rng, p.n, k);
+        defer h.deinit(a);
+        std.debug.print("  {s} n {d}:", .{ p.name, p.n });
+        for (variants, 0..) |v, vi| {
+            const skip = !fp8 and (v == .fp8_128 or v == .fp8_256);
+            var ms: f64 = 0;
+            if (!skip) {
+                for (0..2) |round| {
+                    try t0.record(s);
+                    for (0..reps) |_| try launch(lane, s, v, dx.ptr, h.w, dy.ptr, part.ptr);
+                    try t1.record(s);
+                    try t1.synchronize();
+                    if (round == 1) ms = @as(f64, try cuda.Event.elapsedMs(t0, t1)) / reps;
+                }
+                chunk[vi] += ms * @as(f64, @floatFromInt(p.per_chunk));
+                std.debug.print(" {s} {d:.3} ({d:.0})", .{ @tagName(v), ms, 2.0 * rows * @as(f64, @floatFromInt(p.n)) * k / (ms * 1e9) });
+            }
+        }
+        std.debug.print("\n", .{});
+    }
+    std.debug.print("  a chunk's in-projections and qkv (36 + 12):", .{});
+    for (variants, chunk) |v, c| std.debug.print(" {s} {d:.2} ms", .{ @tagName(v), c });
+    std.debug.print("\n", .{});
+
+    var hc = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_hc);
+    defer hc.unload();
+    const swiglu = try hc.function("fn_shared_swiglu");
+    var gate = try cuda.DeviceBuffer.alloc(gpu.d, rows * 640 * 2);
+    defer gate.free();
+    var up = try cuda.DeviceBuffer.alloc(gpu.d, rows * 640 * 2);
+    defer up.free();
+    for ([_]usize{ 320, 640 }) |width| {
+        var hg = try t.Host.init(gpu, rng, width, k);
+        defer hg.deinit(a);
+        var hu = try t.Host.init(gpu, rng, width, k);
+        defer hu.deinit(a);
+        var ms: [2]f64 = undefined;
+        for (0..2) |which| for (0..2) |round| {
+            try t0.record(s);
+            for (0..reps) |_| {
+                if (which == 0) {
+                    try lane.matmul(s, dx.ptr, k, rows, hg.w, gate.ptr, part.ptr);
+                    try lane.matmul(s, dx.ptr, k, rows, hu.w, up.ptr, part.ptr);
+                    try t.swigluLaunch(swiglu, s, gate.ptr, up.ptr, dy.ptr, rows, width);
+                } else try lane.sharedGateUp(s, dx.ptr, k, rows, hg.w, hu.w, dy.ptr);
+            }
+            try t1.record(s);
+            try t1.synchronize();
+            if (round == 1) ms[which] = @as(f64, try cuda.Event.elapsedMs(t0, t1)) / reps;
+        };
+        std.debug.print("  shared gate+up width {d}: lane x2 + SwiGLU {d:.3} ms, fused {d:.3} ms; a chunk (48) {d:.2} -> {d:.2} ms\n", .{ width, ms[0], ms[1], ms[0] * 48, ms[1] * 48 });
+    }
+}
+
+fn launch(lane: qmmf.Lane, s: cuda.Stream, v: Variant, x: u64, w: qmmf.Weight, y: u64, part: u64) !void {
+    switch (v) {
+        .prompt_mx, .prompt_mx2 => {
+            qmmf.tile2 = false;
+            qmmf.fp8mma = false;
+            qmmf.mx2_tile = v == .prompt_mx2;
+            try lane.matmulPrompt(s, x, k, rows, w, y, .bf16, part);
+        },
+        .t2_128, .t2_256 => try lane.promptTile2(s, x, k, rows, w, y, .bf16, v == .t2_256),
+        .fp8_128, .fp8_256 => {
+            try lane.fp8.quantise(s, x, k, rows, k, part);
+            try lane.fp8.product(s, rows, w.codes, w.scales, w.scale, w.n, k, w.npad, y, false, part, v == .fp8_256);
+        },
+    }
+}
diff --git a/zig/tests/cuda/prompt_tile2_tests.zig b/zig/tests/cuda/prompt_tile2_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9bfb8c990977bbb06c0027a81377235e42bf5cd3
--- /dev/null
+++ b/zig/tests/cuda/prompt_tile2_tests.zig
@@ -0,0 +1,383 @@
+//! TF_FLASHNEXT_PROMPT_TILE2, _SHARED_FUSED and _FP8MMA kernels at the Qwen3.8 Flash Next rank's shapes: the bf16-once
+//! prompt tile and the fused shared gate+up byte for byte against the kernels they replace, and the FP8 mma's codes,
+//! scales and products against FP64, with its error against the bf16 tile's.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+
+const qmmf = cuda.qmmf;
+const qmmf8 = cuda.qmmf8;
+
+fn bf(v: u16) f64 {
+    return @as(f32, @bitCast(@as(u32, v) << 16));
+}
+
+fn tobf(v: f32) u16 {
+    const u: u32 = @bitCast(v);
+    return @truncate((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+pub const Host = struct {
+    codes: []u8,
+    scales: []u8,
+    dw: cuda.DeviceBuffer,
+    ds: cuda.DeviceBuffer,
+    w: qmmf.Weight,
+
+    /// e4m3 codes with exponents 2^-3 to 2^2 and UE8M0 scales 2^-6 to 2^-3 a 32: an MXFP8 projection's spread.
+    pub fn init(gpu: check.Gpu, rng: std.Random, n: usize, k: usize) !Host {
+        const a = gpu.gpa;
+        const codes = try a.alloc(u8, n * k);
+        errdefer a.free(codes);
+        for (codes) |*v| v.* = (rng.int(u8) & 0x87) | (@as(u8, 4 + rng.uintLessThan(u8, 6)) << 3);
+        const scales = try a.alloc(u8, n * (k / 32));
+        errdefer a.free(scales);
+        for (scales) |*v| v.* = 121 + rng.uintLessThan(u8, 4);
+        const npad = cuda.mxfp8.padded(n);
+        const pc = try a.alloc(u8, npad * k);
+        defer a.free(pc);
+        cuda.mxfp8.packCodes(pc, codes, n, k);
+        const ps = try a.alloc(u8, npad * (k / 32));
+        defer a.free(ps);
+        cuda.mxfp8.packScales(ps, scales, n, k);
+        var dw = try cuda.DeviceBuffer.fromHost(gpu.d, pc);
+        errdefer dw.free();
+        var ds = try cuda.DeviceBuffer.fromHost(gpu.d, ps);
+        errdefer ds.free();
+        return .{ .codes = codes, .scales = scales, .dw = dw, .ds = ds, .w = cuda.mxfp8.weight(dw.ptr, ds.ptr, n, k) };
+    }
+
+    pub fn deinit(h: *Host, a: std.mem.Allocator) void {
+        h.dw.free();
+        h.ds.free();
+        a.free(h.codes);
+        a.free(h.scales);
+    }
+
+    fn at(h: Host, col: usize, i: usize) f64 {
+        const k: usize = h.w.k;
+        return core.quant.fp8.e4m3(h.codes[col * k + i]) * std.math.ldexp(@as(f64, 1), @as(i32, h.scales[col * (k / 32) + i / 32]) - 127);
+    }
+};
+
+/// Rows of k bf16 activations at stride ldx (padding poison): unit normals with every 97th channel 16 times larger.
+pub fn activations(gpu: check.Gpu, rng: std.Random, m: usize, k: usize, ldx: usize) ![]u16 {
+    const x = try gpu.gpa.alloc(u16, m * ldx);
+    @memset(x, 0x7fc0);
+    for (0..m) |row| for (x[row * ldx ..][0..k], 0..) |*v, i| {
+        const g: f32 = @floatCast(rng.floatNorm(f64));
+        v.* = tobf(if (i % 97 == 5) g * 16 else g);
+    };
+    return x;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    const major = (try gpu.ctx.capability()) / 10;
+    try tile2(gpu, major);
+    try sharedFused(gpu, major);
+    if (major < 12) {
+        std.debug.print("SKIP FP8 mma: sm_{d}x has no block-scaled FP8 mma\n", .{major});
+        return;
+    }
+    try fp8mma(gpu, major);
+}
+
+fn tile2(gpu: check.Gpu, major: u32) !void {
+    const a = gpu.gpa;
+    const k = 2560;
+    const ldx = k + 64;
+    const max_m = 1536;
+    var prng = std.Random.DefaultPrng.init(0x7112_5eed);
+    const rng = prng.random();
+    const x = try activations(gpu, rng, max_m, k, ldx);
+    defer a.free(x);
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+    defer dx.free();
+    var dy = try cuda.DeviceBuffer.alloc(gpu.d, max_m * 8240 * 4);
+    defer dy.free();
+    var part = try cuda.DeviceBuffer.alloc(gpu.d, 16);
+    defer part.free();
+    var lane = try qmmf.Lane.load(gpu.d, major);
+    defer lane.unload();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    const saved = .{ qmmf.prompt_mx_min_n, qmmf.mx2_tile, qmmf.tile2 };
+    defer {
+        qmmf.prompt_mx_min_n = saved[0];
+        qmmf.mx2_tile = saved[1];
+        qmmf.tile2 = saved[2];
+    }
+    qmmf.prompt_mx_min_n = 1;
+    const shapes = [_][2]usize{ .{ 8240, 1536 }, .{ 7296, 1536 }, .{ 8240, 300 }, .{ 1000, 255 }, .{ 320, 77 }, .{ 70, 2 } };
+    for (shapes) |sh| {
+        const n = sh[0];
+        const m = sh[1];
+        var h = try Host.init(gpu, rng, n, k);
+        defer h.deinit(a);
+        for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+            const bytes = m * n * @as(usize, if (out == .f32) 4 else 2);
+            const want = try a.alloc(u8, bytes);
+            defer a.free(want);
+            const got = try a.alloc(u8, bytes);
+            defer a.free(got);
+            qmmf.tile2 = false;
+            qmmf.mx2_tile = false;
+            try dy.fill8(0xff, s.handle);
+            try lane.matmulPrompt(s, dx.ptr, ldx, m, h.w, dy.ptr, out, part.ptr);
+            try s.synchronize();
+            try dy.download(0, want);
+            qmmf.mx2_tile = true;
+            try dy.fill8(0xff, s.handle);
+            try lane.matmulPrompt(s, dx.ptr, ldx, m, h.w, dy.ptr, out, part.ptr);
+            try s.synchronize();
+            try dy.download(0, got);
+            try check.sameBytes("two-stage prompt tile against the prompt tile", got, want);
+            qmmf.mx2_tile = false;
+            for ([_]bool{ false, true }) |wide| {
+                try dy.fill8(0xff, s.handle);
+                try lane.promptTile2(s, dx.ptr, ldx, m, h.w, dy.ptr, out, wide);
+                try s.synchronize();
+                try dy.download(0, got);
+                try check.sameBytes(if (wide) "256-row bf16-once tile against the prompt tile" else "128-row bf16-once tile against the prompt tile", got, want);
+            }
+            qmmf.tile2 = true;
+            try dy.fill8(0xff, s.handle);
+            try lane.matmulPrompt(s, dx.ptr, ldx, m, h.w, dy.ptr, out, part.ptr);
+            try s.synchronize();
+            try dy.download(0, got);
+            try check.sameBytes("matmulPrompt with tile2 against the prompt tile", got, want);
+            if (out == .bf16 and m <= 4) for (0..m) |row| for (0..n) |col| {
+                var ref: f64 = 0;
+                var magnitude: f64 = 0;
+                for (0..k) |i| {
+                    const v = bf(x[row * ldx + i]) * h.at(col, i);
+                    ref += v;
+                    magnitude += @abs(v);
+                }
+                const actual = bf(std.mem.readInt(u16, got[(row * n + col) * 2 ..][0..2], .little));
+                try check.expect(@abs(actual - ref) <= @abs(ref) / 128 + magnitude / 4096, "bf16-once tile FP64 row {d} column {d}: {e} versus {e}", .{ row, col, actual, ref });
+            };
+        }
+    }
+    check.pass("TF_FLASHNEXT_PROMPT_TILE2: 128- and 256-row bf16-once tiles equal the prompt tile byte for byte, bf16 and fp32, n 70 to 8240, rows 2 to 1536 (and the two-stage tile)", .{});
+}
+
+fn sharedFused(gpu: check.Gpu, major: u32) !void {
+    const a = gpu.gpa;
+    const k = 2560;
+    const ldx = k;
+    const max_m = 4096;
+    var prng = std.Random.DefaultPrng.init(0x5aed_5eed);
+    const rng = prng.random();
+    const x = try activations(gpu, rng, max_m, k, ldx);
+    defer a.free(x);
+    for (x) |*v| v.* = tobf(@floatCast(bf(v.*) * 0.25));
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+    defer dx.free();
+    var gate = try cuda.DeviceBuffer.alloc(gpu.d, max_m * 640 * 2);
+    defer gate.free();
+    var up = try cuda.DeviceBuffer.alloc(gpu.d, max_m * 640 * 2);
+    defer up.free();
+    var act = try cuda.DeviceBuffer.alloc(gpu.d, max_m * 640 * 2);
+    defer act.free();
+    var part = try cuda.DeviceBuffer.alloc(gpu.d, 8 * max_m * 640 * 4);
+    defer part.free();
+    var lane = try qmmf.Lane.load(gpu.d, major);
+    defer lane.unload();
+    var hc = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_hc);
+    defer hc.unload();
+    const swiglu = try hc.function("fn_shared_swiglu");
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    for ([_]usize{ 320, 640 }) |width| {
+        var hg = try Host.init(gpu, rng, width, k);
+        defer hg.deinit(a);
+        var hu = try Host.init(gpu, rng, width, k);
+        defer hu.deinit(a);
+        for ([_]usize{ 256, 300, 1536, 4096 }) |m| {
+            const want = try a.alloc(u8, m * width * 2);
+            defer a.free(want);
+            const got = try a.alloc(u8, m * width * 2);
+            defer a.free(got);
+            try act.fill8(0xff, s.handle);
+            try lane.matmul(s, dx.ptr, ldx, m, hg.w, gate.ptr, part.ptr);
+            try lane.matmul(s, dx.ptr, ldx, m, hu.w, up.ptr, part.ptr);
+            try swigluLaunch(swiglu, s, gate.ptr, up.ptr, act.ptr, m, width);
+            try s.synchronize();
+            try act.download(0, want);
+            try act.fill8(0xff, s.handle);
+            try lane.sharedGateUp(s, dx.ptr, ldx, m, hg.w, hu.w, act.ptr);
+            try s.synchronize();
+            try act.download(0, got);
+            try check.sameBytes("fused shared gate+up+SwiGLU against two lane matmuls and fn_shared_swiglu", got, want);
+        }
+    }
+    check.pass("TF_FLASHNEXT_PROMPT_SHARED_FUSED: gate, up and SwiGLU in one launch equal the lane matmuls and fn_shared_swiglu byte for byte, widths 320 and 640, rows 256 to 4096", .{});
+}
+
+pub fn swigluLaunch(f: cuda.Function, s: cuda.Stream, gate: u64, up: u64, act: u64, m: usize, width: usize) !void {
+    var args: cuda.Args = .{};
+    args.add(gate);
+    args.add(up);
+    args.add(act);
+    args.add(@as(c_int, @intCast(width)));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(m), .y = @intCast((width + 255) / 256), .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &args);
+}
+
+/// The quantiser's UE8M0 exponent: the least s with amax at most 448 x 2^s (qmmf_fp8.cu quant_exp).
+fn quantExp(amax: f64) i32 {
+    if (amax == 0) return -127;
+    var s: i32 = @as(i32, @intFromFloat(std.math.floor(std.math.log2(amax)))) - 8;
+    while (amax > std.math.ldexp(@as(f64, 448), s)) s += 1;
+    while (s > -127 and amax <= std.math.ldexp(@as(f64, 448), s - 1)) s -= 1;
+    return @max(-127, @min(127, s));
+}
+
+/// The byte of k-step position p (0 to 31) holds input 16 (p / 16) + 2 ((p % 16) / 4) + p % 2 + 8 ((p % 4) / 2) of the 32.
+fn kOf(p: usize) usize {
+    return 16 * (p / 16) + 2 * ((p % 16) / 4) + p % 2 + 8 * ((p % 4) / 2);
+}
+
+const Stats = struct {
+    err2: f64 = 0,
+    ref2: f64 = 0,
+    worst: f64 = 0,
+
+    fn add(st: *Stats, got: f64, ref: f64) void {
+        st.err2 += (got - ref) * (got - ref);
+        st.ref2 += ref * ref;
+        st.worst = @max(st.worst, @abs(got - ref));
+    }
+
+    fn rel(st: Stats) f64 {
+        return @sqrt(st.err2 / st.ref2);
+    }
+
+    fn worstRel(st: Stats, count: usize) f64 {
+        return st.worst / @sqrt(st.ref2 / @as(f64, @floatFromInt(count)));
+    }
+};
+
+fn fp8mma(gpu: check.Gpu, major: u32) !void {
+    const a = gpu.gpa;
+    const k = 2560;
+    const ldx = k + 64;
+    const max_m = 1536;
+    var prng = std.Random.DefaultPrng.init(0xf8f8_5eed);
+    const rng = prng.random();
+    const x = try activations(gpu, rng, max_m, k, ldx);
+    defer a.free(x);
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+    defer dx.free();
+    var dy = try cuda.DeviceBuffer.alloc(gpu.d, max_m * 8240 * 4);
+    defer dy.free();
+    var part = try cuda.DeviceBuffer.alloc(gpu.d, qmmf8.scratchBytes(max_m, k));
+    defer part.free();
+    const saved = .{ qmmf.prompt_mx_min_n, qmmf.tile2, qmmf.fp8mma };
+    defer {
+        qmmf.prompt_mx_min_n = saved[0];
+        qmmf.tile2 = saved[1];
+        qmmf.fp8mma = saved[2];
+    }
+    qmmf.prompt_mx_min_n = 1;
+    qmmf.tile2 = false;
+    qmmf.fp8mma = true;
+    var lane = try qmmf.Lane.load(gpu.d, major);
+    defer lane.unload();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    const shapes = [_][2]usize{ .{ 8240, 1536 }, .{ 7296, 1536 }, .{ 1100, 300 }, .{ 320, 77 } };
+    var total_fp8: Stats = .{};
+    var total_bf16: Stats = .{};
+    for (shapes) |sh| {
+        const n = sh[0];
+        const m = sh[1];
+        var h = try Host.init(gpu, rng, n, k);
+        defer h.deinit(a);
+        var st_fp8: Stats = .{};
+        var st_bf16: Stats = .{};
+        var count: usize = 0;
+        const sample = [_]usize{ 0, 1, 63, 64, 127, m / 2, m - 2, m - 1 };
+        for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+            const size: usize = if (out == .f32) 4 else 2;
+            const bf16_y = try a.alloc(u8, m * n * size);
+            defer a.free(bf16_y);
+            const fp8_y = try a.alloc(u8, m * n * size);
+            defer a.free(fp8_y);
+            qmmf.fp8mma = false;
+            try lane.matmulPrompt(s, dx.ptr, ldx, m, h.w, dy.ptr, out, part.ptr);
+            try s.synchronize();
+            try dy.download(0, bf16_y);
+            qmmf.fp8mma = true;
+            for ([_]bool{ false, true }) |wide| {
+                try dy.fill8(0xff, s.handle);
+                try part.fill8(0xa5, s.handle);
+                try lane.fp8.quantise(s, dx.ptr, ldx, m, k, part.ptr);
+                try lane.fp8.product(s, m, h.w.codes, h.w.scales, h.w.scale, n, k, h.w.npad, dy.ptr, out == .f32, part.ptr, wide);
+                try s.synchronize();
+                try dy.download(0, fp8_y);
+                const scratch = try a.alloc(u8, qmmf8.scratchBytes(m, k));
+                defer a.free(scratch);
+                try part.download(0, scratch);
+                if (wide == (n >= qmmf8.wide_min_n)) {
+                    const again = try a.alloc(u8, m * n * size);
+                    defer a.free(again);
+                    try dy.fill8(0xff, s.handle);
+                    try lane.matmulPrompt(s, dx.ptr, ldx, m, h.w, dy.ptr, out, part.ptr);
+                    try s.synchronize();
+                    try dy.download(0, again);
+                    try check.sameBytes("matmulPrompt with fp8mma against its FP8 tile", again, fp8_y);
+                }
+                const q = try a.alloc(f64, k);
+                defer a.free(q);
+                const mp = qmmf8.paddedRows(m);
+                for (sample) |row| {
+                    for (0..k / 32) |b| {
+                        var amax: f64 = 0;
+                        for (0..32) |i| amax = @max(amax, @abs(bf(x[row * ldx + b * 32 + i])));
+                        const e = quantExp(amax);
+                        const sbyte = scratch[m * k + ((b / 2) * mp + row) * 2 + (b & 1)];
+                        try check.expect(sbyte == e + 127, "FP8 scale row {d} block {d}: byte {d} versus {d}", .{ row, b, sbyte, e + 127 });
+                        for (0..32) |p| {
+                            const i = b * 32 + kOf(p);
+                            const want = core.quant.fp8.toE4m3(std.math.ldexp(bf(x[row * ldx + i]), -e));
+                            const code = scratch[row * k + b * 32 + p];
+                            try check.expect(core.quant.fp8.e4m3(code) == want, "FP8 code row {d} input {d}: {x} ({e}) versus {e}", .{ row, i, code, core.quant.fp8.e4m3(code), want });
+                            q[i] = want * std.math.ldexp(@as(f64, 1), e);
+                        }
+                    }
+                    for (0..n) |col| {
+                        var ref_q: f64 = 0;
+                        var mag_q: f64 = 0;
+                        var ref: f64 = 0;
+                        for (0..k) |i| {
+                            const w = h.at(col, i);
+                            ref_q += q[i] * w;
+                            mag_q += @abs(q[i] * w);
+                            ref += bf(x[row * ldx + i]) * w;
+                        }
+                        const at = row * n + col;
+                        const got = if (out == .f32) @as(f64, @as(f32, @bitCast(std.mem.readInt(u32, fp8_y[at * 4 ..][0..4], .little)))) else bf(std.mem.readInt(u16, fp8_y[at * 2 ..][0..2], .little));
+                        const base = if (out == .f32) @as(f64, @as(f32, @bitCast(std.mem.readInt(u32, bf16_y[at * 4 ..][0..4], .little)))) else bf(std.mem.readInt(u16, bf16_y[at * 2 ..][0..2], .little));
+                        const tol = (if (out == .f32) @abs(ref_q) / 4096 else @abs(ref_q) / 128) + mag_q / 1024 + 0x1p-120;
+                        try check.expect(@abs(got - ref_q) <= tol, "FP8 mma {s} row {d} column {d}: {e} versus FP64 of the quantised rows {e}", .{ @tagName(out), row, col, got, ref_q });
+                        if (out == .f32 and !wide) {
+                            st_fp8.add(got, ref);
+                            st_bf16.add(base, ref);
+                            count += 1;
+                        }
+                    }
+                }
+            }
+        }
+        std.debug.print("  FP8 mma n {d} rows {d}: rms error {e:.3} of the rms output (bf16 tile {e:.3}), worst {e:.3} (bf16 tile {e:.3})\n", .{ n, m, st_fp8.rel(), st_bf16.rel(), st_fp8.worstRel(count), st_bf16.worstRel(count) });
+        for ([_]*Stats{ &total_fp8, &total_bf16 }, [_]Stats{ st_fp8, st_bf16 }) |t, x_| {
+            t.err2 += x_.err2;
+            t.ref2 += x_.ref2;
+            t.worst = @max(t.worst, x_.worst);
+        }
+    }
+    try check.expect(total_fp8.rel() < 0.05, "FP8 mma rms error {e} of the rms output", .{total_fp8.rel()});
+    check.pass("TF_FLASHNEXT_PROMPT_FP8MMA: codes and UE8M0 scales as quantised in FP64, products within fp32 of FP64 on the quantised rows; rms error {e:.3} of the output against the bf16 tile's {e:.3}", .{ total_fp8.rel(), total_bf16.rel() });
+}
