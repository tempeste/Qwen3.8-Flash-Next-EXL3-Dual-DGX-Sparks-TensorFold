+/// A decoded frame's windows on rank 1: sequence, window state and rows, each window's draft made before any is borrowed.
+pub const Bound = struct {
+    seqs: [max_windows]*prompt.Seq = undefined,
+    ds: [max_windows]*mtp.Draft = undefined,
+    tokens: [max_windows][mtp.max_rows]u32 = undefined,
+    idss: [max_windows][]const u32 = undefined,
+    count: usize = 0,
+
+    /// Every check before any state moves; `skip` (0: none) is a sequence no window may name (a mixed round's piece).
+    pub fn bind(b: *Bound, s: *Session, f: *const Frame, skip: u64) !void {
+        for (f.ids[0..f.count], f.rows[0..f.count], 0..) |id, rows, w| {
+            if (id == skip) return error.DuplicateRankSequence;
+            b.seqs[w] = s.seqs.get(id) orelse return error.UnknownRankSequence;
+            if (b.seqs[w].fed + rows > b.seqs[w].cap) return error.PromptTooLong;
+        }
+        const Make = struct {
+            s: *Session,
+            fn make(ctx: @This(), i: usize) !mtp.Draft {
+                _ = i;
+                return makeWindow(ctx.s);
+            }
+        };
+        try ensure(&s.windows, s.gpa, f.ids[0..f.count], Make{ .s = s }, Make.make);
+        for (0..f.count) |w| {
+            b.ds[w] = s.windows.getPtr(f.ids[w]).?;
+            b.idss[w] = f.window(w, &b.tokens[w]);
+        }
+        b.count = f.count;
+    }
