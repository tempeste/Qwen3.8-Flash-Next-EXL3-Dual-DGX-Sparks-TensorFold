new file mode 100644
index 0000000000000000000000000000000000000000..d0bf73904e315417a5cf048f9c02f3eb68772a15
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_split_sum.zig
@@ -0,0 +1,112 @@
+//! TF_FLASHNEXT_TP_SPLIT_SUM: a --tp 2 prompt pass's fp32 rank sums in two row halves on a stream of their own.
+const std = @import("std");
+const cuda = @import("cuda");
+const knobs = @import("cuda_knobs.zig");
+
+pub const Rows = struct { r0: usize, n: usize };
+
+/// `n` rows as two halves, the first a whole number of 128-row tiles (the prompt tile's).
+pub fn halves(n: usize) [2]Rows {
+    const a = n / 2 / 128 * 128;
+    return .{ .{ .r0 = 0, .n = a }, .{ .r0 = a, .n = n - a } };
+}
+
+/// The fewest rows a half takes: the fused projection tile's (qmmf.fused_rows), the fused read-out's
+/// (TF_FLASHNEXT_HC2_MIN) and the read-out tiles' (TF_FLASHNEXT_READOUT_ROWS), so a half runs the kernels its pass would.
+pub fn minHalf() usize {
+    return @max(cuda.qmmf.fused_rows, @max(knobs.hc2MinRows(), @import("cuda_batch_state.zig").readoutTileRows()));
+}
+
+/// Whether a pass halves its sums: the knob's stream exists, the pass is not a mixed round's piece (`whole`: another
+/// pass's collectives run between its layers' sums), the ranks sum (--tp), prompt rows of one sequence with nothing
+/// kept or added, split_sum_min_rows rows or more, and each half `min_half` rows or more.
+pub fn takes(have: bool, whole: bool, ranks: bool, prompt: bool, lanes: usize, keeps: bool, n: usize, min_half: usize) bool {
+    return have and !whole and ranks and prompt and lanes == 0 and !keeps and n >= knobs.split_sum_min_rows and halves(n)[0].n >= min_half;
+}
+
+/// The sums' stream (the highest priority, so the link's few blocks start as soon as an SM frees) and, a half, the
+/// point the pass's stream has written its rows and the point their sum has landed.
+pub const Sums = struct {
+    stream: cuda.Stream,
+    ready: [2]cuda.Event,
+    done: [2]cuda.Event,
+    /// Halves whose sums the pass's stream has not waited for.
+    open: [2]bool = .{ false, false },
+
+    pub fn init(d: *const cuda.Driver) !Sums {
+        var st = try cuda.Stream.initPriority(d, .highest);
+        errdefer st.deinit();
+        var ev: [4]cuda.Event = undefined;
+        var made: usize = 0;
+        errdefer for (ev[0..made]) |*e| e.deinit();
+        for (&ev) |*e| {
+            e.* = try cuda.Event.init(d, false);
+            made += 1;
+        }
+        return .{ .stream = st, .ready = .{ ev[0], ev[1] }, .done = .{ ev[2], ev[3] } };
+    }
+
+    pub fn deinit(x: *Sums) void {
+        for (&x.done) |*e| e.deinit();
+        for (&x.ready) |*e| e.deinit();
+        x.stream.deinit();
+    }
+
+    /// Half `i`'s `count` fp32 values at `values`, written on `main`, summed across the ranks on the sums' stream.
+    pub fn sum(x: *Sums, c: anytype, site: anytype, main: cuda.Stream, i: usize, values: u64, count: usize) !void {
+        try x.ready[i].record(main);
+        try x.stream.wait(x.ready[i]);
+        try c.at(site).sum(x.stream, values, count);
+        try x.done[i].record(x.stream);
+        x.open[i] = true;
+    }
+
+    /// Slot `i`'s exchange (TF_FLASHNEXT_TP_SEQPAR) of rows written on `main`, on the sums' stream.
+    pub fn exchange(x: *Sums, c: anytype, site: anytype, main: cuda.Stream, i: usize, pieces: anytype) !void {
+        try x.ready[i].record(main);
+        try x.stream.wait(x.ready[i]);
+        try c.at(site).exchange(x.stream, pieces);
+        try x.done[i].record(x.stream);
+        x.open[i] = true;
+    }
+
+    /// `main` waits for half `i`'s sum, if it has not.
+    pub fn join(x: *Sums, main: cuda.Stream, i: usize) !void {
+        if (!x.open[i]) return;
+        try main.wait(x.done[i]);
+        x.open[i] = false;
+    }
+
+    pub fn joinAll(x: *Sums, main: cuda.Stream) !void {
+        for (0..2) |i| try x.join(main, i);
+    }
+
+    pub fn pending(x: *const Sums) bool {
+        return x.open[0] or x.open[1];
+    }
+};
+
+test "a pass's halves cover its rows, the first in 64-row tiles, and only whole --tp prompt chunks outside a mixed round halve their sums" {
+    for ([_]usize{ 1536, 1537, 1600, 2048, 3072, 4095 }) |n| {
+        const h = halves(n);
+        try std.testing.expectEqual(@as(usize, 0), h[0].r0);
+        try std.testing.expectEqual(h[0].n, h[1].r0);
+        try std.testing.expectEqual(n, h[0].n + h[1].n);
+        try std.testing.expectEqual(@as(usize, 0), h[0].n % 128);
+        try std.testing.expect(h[0].n <= h[1].n and h[1].n - h[0].n < 256);
+        try std.testing.expect(h[0].n >= cuda.qmmf.fused_rows and h[0].n >= 768);
+    }
+    try std.testing.expectEqual(@as(usize, 768), halves(1536)[0].n);
+    try std.testing.expectEqual(@as(usize, 1536), halves(3072)[0].n);
+    try std.testing.expect(takes(true, false, true, true, 0, false, 1536, 768));
+    try std.testing.expect(!takes(false, false, true, true, 0, false, 1536, 768));
+    try std.testing.expect(!takes(true, false, false, true, 0, false, 1536, 768));
+    try std.testing.expect(!takes(true, false, true, false, 0, false, 1536, 768));
+    try std.testing.expect(!takes(true, false, true, true, 3, false, 1536, 768));
+    try std.testing.expect(!takes(true, false, true, true, 0, true, 1536, 768));
+    try std.testing.expect(!takes(true, false, true, true, 0, false, 1535, 768));
+    try std.testing.expect(!takes(true, false, true, true, 0, false, 1536, 1024));
+    try std.testing.expect(takes(true, false, true, true, 0, false, 2048, 1024));
+    try std.testing.expect(!takes(true, true, true, true, 0, false, 1536, 768));
+    try std.testing.expect(!takes(true, true, true, true, 0, false, 3008, 768));
+}
