+__device__ __forceinline__ int reserve(int n, int* counter) {
+    const int sub = threadIdx.x & 3;
+    int incl = n;
+#pragma unroll
+    for (int o = 1; o < 4; o <<= 1) {
+        const int v = __shfl_up_sync(0xffffffffu, incl, o, 4);
+        if (sub >= o) incl += v;
+    }
+    const int total = __shfl_sync(0xffffffffu, incl, 3, 4);
+    int base = 0;
+    if (sub == 3 && total > 0) base = atomicAdd(counter, total);
+    base = __shfl_sync(0xffffffffu, base, 3, 4);
+    return base + incl - n;
+}
