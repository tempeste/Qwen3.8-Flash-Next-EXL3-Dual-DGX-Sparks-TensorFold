+template <int BM, int BN, int WM, int WN, int STAGES>
+struct Tile2 {
+    static constexpr int THREADS = WM * WN * 32;
+    static constexpr int MT = BM / WM / 16;
+    static constexpr int NT = BN / WN / 8;
+    static constexpr int ROW = GS * 2;
+    static constexpr int CHUNKS = ROW / 16;
+    static constexpr int X = BM * ROW;
+    static constexpr int B = BN * GS * 2;
+    static constexpr int WORDS = BN * 4;
+    static constexpr int PER = WORDS / THREADS;
+    static constexpr int SMEM = STAGES * X + 2 * B;
+    static_assert(WORDS % THREADS == 0 && BN % 64 == 0, "each thread converts whole 16-byte words of 64-column tiles");
+};
+
+template <int BM, int BN, int WM, int WN, int STAGES, bool F32>
+__device__ __forceinline__ void prompt_t2_body(
+        const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ w, const uint8_t* __restrict__ bs,
+        float scale, void* __restrict__ out, int M, int N, int K, int npad, int ldx, int group) {
+    using T = Tile2<BM, BN, WM, WN, STAGES>;
+    extern __shared__ __align__(128) unsigned char buf[];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int wm = warp / WN, wn = warp % WN;
+    const int KG = K / GS;
+    const int2 at = tile_of(blockIdx.x, M, N, BM, BN, group);
+    const int m0 = at.x, n0 = at.y;
+    unsigned char* bsm = buf + STAGES * T::X;
+
+    auto stage = [&](int s) { return buf + s * T::X; };
+    auto load = [&](int s, int g) {
+        unsigned char* p = stage(s);
+        for (int c = tid; c < BM * T::CHUNKS; c += T::THREADS) {
+            const int r = c / T::CHUNKS, ch = c % T::CHUNKS;
+            const int row = min(m0 + r, M - 1);
+            cp16z(p + r * T::ROW + swz<T::CHUNKS>(r, ch) * 16, x + static_cast<size_t>(row) * ldx + g * GS + ch * 8,
+                  m0 + r < M);
+        }
+    };
+    uint4 q[T::PER];
+    uint32_t e[T::PER];
+    auto fetch = [&](int g) {
+#pragma unroll
+        for (int u = 0; u < T::PER; ++u) {
+            const int c = tid + u * T::THREADS, t = c >> 8;
+            if (n0 + t * 64 < npad) {
+                const size_t tile = static_cast<size_t>(n0 / 64 + t) * KG + g;
+                q[u] = ld_nc(reinterpret_cast<const uint4*>(w + tile * (64 * GS)) + (c & 255));
+                e[u] = *reinterpret_cast<const uint16_t*>(bs + tile * 128 + (((c >> 5) & 7) * 8 + ((c & 31) >> 2)) * 2);
+            } else {
+                q[u] = make_uint4(0u, 0u, 0u, 0u);
+                e[u] = 0u;
+            }
+        }
+    };
+    auto convert = [&](int half) {
+        uint4* dst = reinterpret_cast<uint4*>(bsm + half * T::B);
+#pragma unroll
+        for (int u = 0; u < T::PER; ++u) {
+            const int c = tid + u * T::THREADS;
+            uint32_t sv[2];
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const uint32_t v = (((e[u] >> (8 * h)) & 0xFFu) + 120u) << 7;
+                sv[h] = v | (v << 16);
+            }
+            uint32_t r[8];
+#pragma unroll
+            for (int kt = 0; kt < GS / 16; ++kt) {
+                const uint32_t word = comp(q[u], kt);
+                r[2 * kt] = fp8pair_unit(word & 0xFFFFu, sv[kt >> 1]);
+                r[2 * kt + 1] = fp8pair_unit(word >> 16, sv[kt >> 1]);
+            }
+            dst[((c >> 5) * 2) * 32 + (c & 31)] = make_uint4(r[0], r[1], r[2], r[3]);
+            dst[((c >> 5) * 2 + 1) * 32 + (c & 31)] = make_uint4(r[4], r[5], r[6], r[7]);
+        }
+    };
+
+    float acc[T::MT][T::NT][4];
+#pragma unroll
+    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+            for (int v = 0; v < 4; ++v) acc[i][j][v] = 0.0f;
+#pragma unroll
+    for (int s = 0; s < STAGES - 1; ++s) {
+        if (s < KG) load(s, s);
+        commit();
+    }
+    if (KG > 0) {
+        fetch(0);
+        convert(0);
+    }
+    if (KG > 1) fetch(1);
+    for (int g = 0; g < KG; ++g) {
+        wait<STAGES - 2>();
+        __syncthreads();
+        if (g + STAGES - 1 < KG) load((g + STAGES - 1) % STAGES, g + STAGES - 1);
+        commit();
+        if (g + 1 < KG) {
+            convert((g + 1) & 1);
+            if (g + 2 < KG) fetch(g + 2);
+        }
+        const unsigned char* p = stage(g % STAGES);
+        const uint4* pb = reinterpret_cast<const uint4*>(bsm + (g & 1) * T::B);
+#pragma unroll
+        for (int kh = 0; kh < 2; ++kh) {
+            uint4 bv[T::NT];
+#pragma unroll
+            for (int j = 0; j < T::NT; ++j) bv[j] = pb[((wn * T::NT + j) * 2 + kh) * 32 + lane];
+#pragma unroll
+            for (int k2 = 0; k2 < 2; ++k2) {
+                const int kt = kh * 2 + k2;
+                uint32_t a[T::MT][4];
+#pragma unroll
+                for (int i = 0; i < T::MT; ++i) {
+                    const int r = wm * (BM / WM) + i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
+                    const int ch = kt * 2 + (lane >> 4);
+                    ldmatrix4(a[i], p + r * T::ROW + swz<T::CHUNKS>(r, ch) * 16);
+                }
+#pragma unroll
+                for (int j = 0; j < T::NT; ++j) {
+                    const uint32_t b0 = k2 ? bv[j].z : bv[j].x;
+                    const uint32_t b1 = k2 ? bv[j].w : bv[j].y;
+#pragma unroll
+                    for (int i = 0; i < T::MT; ++i) mma(acc[i][j], a[i], b0, b1);
+                }
+            }
+        }
+    }
+    wait<0>();
+#pragma unroll
+    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j) {
+            const int col = n0 + wn * (BN / WN) + j * 8 + (lane & 3) * 2;
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int row = m0 + wm * (BM / WM) + i * 16 + (lane >> 2) + h * 8;
+                if (row >= M) continue;
+                const float v0 = acc[i][j][2 * h] * scale, v1 = acc[i][j][2 * h + 1] * scale;
+                if (F32) {
+                    float* dst = reinterpret_cast<float*>(out) + static_cast<size_t>(row) * N + col;
+                    if (col < N) dst[0] = v0;
+                    if (col + 1 < N) dst[1] = v1;
+                } else {
+                    __nv_bfloat16* dst = reinterpret_cast<__nv_bfloat16*>(out) + static_cast<size_t>(row) * N + col;
+                    if (col + 1 < N && (N & 1) == 0)
+                        *reinterpret_cast<__nv_bfloat162*>(dst) = __floats2bfloat162_rn(v0, v1);
+                    else {
+                        if (col < N) dst[0] = __float2bfloat16_rn(v0);
+                        if (col + 1 < N) dst[1] = __float2bfloat16_rn(v1);
+                    }
+                }
+            }
+        }
+}
+
+template <int BM, int STAGES>
+struct SharedTile {
+    static constexpr int THREADS = 256;
+    static constexpr int MT = BM / 16;
+    static constexpr int NT = 2;
+    static constexpr int ROW = GS * 2;
+    static constexpr int CHUNKS = ROW / 16;
+    static constexpr int X = BM * ROW;
+    static constexpr int W = 64 * GS;
+    static constexpr int S = 64 * 2;
+    static constexpr int STAGE = (X + 2 * W + 2 * S + 127) / 128 * 128;
+    static constexpr int SMEM = STAGES * STAGE;
+    static_assert(4 * MT * NT * 4 * 32 * 2 <= SMEM, "the up halves park in the stage buffers");
+};
+
+template <int BM, int STAGES>
+__device__ __forceinline__ void shared_gu_body(
+        const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ wg, const uint8_t* __restrict__ sg,
+        const unsigned char* __restrict__ wu, const uint8_t* __restrict__ su, float scale_g, float scale_u,
+        __nv_bfloat16* __restrict__ act, int M, int N, int K, int SK, int ldx, int group) {
+    using T = SharedTile<BM, STAGES>;
+    extern __shared__ __align__(128) unsigned char buf[];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int up = warp >> 2, wn = warp & 3;
+    const int KG = K / GS, slice_groups = KG / SK;
+    const int2 at = tile_of(blockIdx.x, M, N, BM, 64, group);
+    const int m0 = at.x, n0 = at.y;
+
+    auto stage = [&](int s) { return buf + s * T::STAGE; };
+    auto load = [&](int s, int g) {
+        unsigned char* p = stage(s);
+        for (int c = tid; c < BM * T::CHUNKS; c += T::THREADS) {
+            const int r = c / T::CHUNKS, ch = c % T::CHUNKS;
+            const int row = min(m0 + r, M - 1);
+            cp16z(p + r * T::ROW + swz<T::CHUNKS>(r, ch) * 16, x + static_cast<size_t>(row) * ldx + g * GS + ch * 8,
+                  m0 + r < M);
+        }
+        const size_t tile = static_cast<size_t>(n0 / 64) * KG + g;
+        unsigned char* pw = p + T::X;
+        for (int c = tid; c < 2 * T::W / 16; c += T::THREADS) {
+            const int off = c % (T::W / 16);
+            cp16(pw + c * 16, (c < T::W / 16 ? wg : wu) + tile * T::W + off * 16);
+        }
+        unsigned char* ps = pw + 2 * T::W;
+        for (int c = tid; c < 2 * T::S / 16; c += T::THREADS) {
+            const int off = c % (T::S / 16);
+            cp16(ps + c * 16, (c < T::S / 16 ? sg : su) + tile * T::S + off * 16);
+        }
+    };
+
+    float acc[T::MT][T::NT][4];
+    float tot[T::MT][T::NT][4];
+#pragma unroll
+    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+            for (int e = 0; e < 4; ++e) acc[i][j][e] = 0.0f;
+#pragma unroll
+    for (int s = 0; s < STAGES - 1; ++s) {
+        if (s < KG) load(s, s);
+        commit();
+    }
+    for (int it = 0; it < KG; ++it) {
+        if (it > 0 && it % slice_groups == 0) {
+#pragma unroll
+            for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+                for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                    for (int e = 0; e < 4; ++e) {
+                        tot[i][j][e] = it == slice_groups ? acc[i][j][e] : tot[i][j][e] + acc[i][j][e];
+                        acc[i][j][e] = 0.0f;
+                    }
+        }
+        wait<STAGES - 2>();
+        __syncthreads();
+        const int next = it + STAGES - 1;
+        if (next < KG) load(next % STAGES, next);
+        commit();
+        const unsigned char* p = stage(it % STAGES);
+        const unsigned char* pw = p + T::X + up * T::W;
+        const uint8_t* ps = p + T::X + 2 * T::W + up * T::S;
+        float d[T::MT][T::NT][4];
+        uint4 wq[T::NT];
+        uint32_t sq[T::NT][2];
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j) {
+            const int jj = wn * T::NT + j;
+            const int col = wn * 16 + j * 8 + (lane & 3) * 2;
+            const uint32_t v = *reinterpret_cast<const uint32_t*>(ps + col * 2);
+            sq[j][0] = v & 0xFFFFu;
+            sq[j][1] = v >> 16;
+            wq[j] = reinterpret_cast<const uint4*>(pw)[jj * 32 + lane];
+        }
+#pragma unroll
+        for (int kt = 0; kt < GS / 16; ++kt) {
+            uint32_t a[T::MT][4];
+#pragma unroll
+            for (int i = 0; i < T::MT; ++i) {
+                const int r = i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
+                const int ch = kt * 2 + (lane >> 4);
+                ldmatrix4(a[i], p + r * T::ROW + swz<T::CHUNKS>(r, ch) * 16);
+            }
+#pragma unroll
+            for (int j = 0; j < T::NT; ++j) {
+                const uint32_t word = comp(wq[j], kt);
+                const uint32_t b0 = fp8pair(word & 0xFFFFu);
+                const uint32_t b1 = fp8pair(word >> 16);
+#pragma unroll
+                for (int i = 0; i < T::MT; ++i) {
+                    if ((kt & 1) == 0) mma0(d[i][j], a[i], b0, b1);
+                    else mma(d[i][j], a[i], b0, b1);
+                }
+            }
+            if (kt & 1) {
+                const int blk = kt / 2;
+#pragma unroll
+                for (int j = 0; j < T::NT; ++j) {
+                    const float s0 = e8m0f(static_cast<uint8_t>(sq[j][0] >> (8 * blk)));
+                    const float s1 = e8m0f(static_cast<uint8_t>(sq[j][1] >> (8 * blk)));
+#pragma unroll
+                    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+                        for (int e = 0; e < 4; ++e) acc[i][j][e] = __fmaf_rn(d[i][j][e], (e & 1) ? s1 : s0, acc[i][j][e]);
+                }
+            }
+        }
+    }
+    wait<0>();
+    __syncthreads();
+    if (SK > 1) {
+#pragma unroll
+        for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+            for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) acc[i][j][e] = tot[i][j][e] + acc[i][j][e];
+    }
+    __nv_bfloat16* park = reinterpret_cast<__nv_bfloat16*>(buf);
+    if (up) {
+#pragma unroll
+        for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+            for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e)
+                    park[(((wn * T::MT + i) * T::NT + j) * 4 + e) * 32 + lane] = __float2bfloat16_rn(acc[i][j][e] * scale_u);
+    }
+    __syncthreads();
+    if (up) return;
+#pragma unroll
+    for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+        for (int j = 0; j < T::NT; ++j) {
+            const int col = n0 + wn * 16 + j * 8 + (lane & 3) * 2;
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int row = m0 + i * 16 + (lane >> 2) + h * 8;
+                if (row >= M) continue;
+                float v[2];
+#pragma unroll
+                for (int c = 0; c < 2; ++c) {
+                    const int e = 2 * h + c;
+                    const float gate = tf_glue::bf(__float2bfloat16_rn(acc[i][j][e] * scale_g));
+                    const float upv = tf_glue::bf(park[(((wn * T::MT + i) * T::NT + j) * 4 + e) * 32 + lane]);
+                    v[c] = __fmul_rn(tf_glue::rbf(tf_glue::tf_silu(gate)), upv);
+                }
+                __nv_bfloat16* dst = act + static_cast<size_t>(row) * N + col;
+                if (col + 1 < N && (N & 1) == 0)
+                    *reinterpret_cast<__nv_bfloat162*>(dst) = __floats2bfloat162_rn(v[0], v[1]);
+                else {
+                    if (col < N) dst[0] = __float2bfloat16_rn(v[0]);
+                    if (col + 1 < N) dst[1] = __float2bfloat16_rn(v[1]);
+                }
+            }
+        }
+}
