@@ -0,0 +1,61 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const gdn = @import("cuda_gdn.zig");
+const Heads = @import("cuda_heads.zig").Heads;
+
+pub const chunk_rows: usize = 64;
+pub const block_floats: usize = chunk_rows * gdn.dk + chunk_rows * chunk_rows + chunk_rows;
+pub const slice: usize = 16;
+pub const prep_threads: u32 = 256;
+
+pub const Fns = struct {
+    prep: cuda.Function,
+    state: cuda.Function,
+
+    pub fn symbol(comptime field: []const u8, comptime suffix: [:0]const u8) [:0]const u8 {
+        const names = .{ .prep = "fn_gdn_chunk_prep", .state = "fn_gdn_chunk_state" };
+        return @field(names, field) ++ suffix;
+    }
+
+    pub fn load(m: cuda.Module, comptime suffix: [:0]const u8) !Fns {
+        var f: Fns = undefined;
+        inline for (@typeInfo(Fns).@"struct".field_names) |name| @field(f, name) = try m.function(symbol(name, suffix));
+        return f;
+    }
+};
+
+pub fn chunks(rows: usize) usize {
+    return (rows + chunk_rows - 1) / chunk_rows;
+}
+
+pub fn scratchBytes(cap: usize) usize {
+    return chunks(cap) * gdn.nv * block_floats * 4;
+}
+
+pub fn launch(f: *const Fns, stream: cuda.Stream, h: Heads, rows: usize, qn: u64, kn: u64, v: u64, gb: u64, state_in: u64, state_out: u64, wy: u64, ys: u64) !void {
+    if (wy == 0) return error.GdnChunkScratch;
+    const n: c_int = @intCast(rows);
+    if (rows > 0) {
+        var a: cuda.Args = .{};
+        for ([_]u64{ qn, kn, v, gb }) |x| a.add(x);
+        a.add(n);
+        a.add(wy);
+        a.add(ys);
+        try cuda.launch.launch(f.prep, .{ .grid = .{ .x = h.nv, .y = @intCast(chunks(rows)) }, .block = .{ .x = prep_threads } }, stream, &a);
+    }
+    var b: cuda.Args = .{};
+    for ([_]u64{ qn, kn, wy, state_in, state_out }) |x| b.add(x);
+    b.add(n);
+    b.add(ys);
+    try cuda.launch.launch(f.state, .{ .grid = .{ .x = h.nv, .y = @intCast(gdn.dv / slice) }, .block = .{ .x = @intCast(gdn.dk) } }, stream, &b);
+}
+
+test "the chunked DeltaNet entry points, their _h8 twins and the scratch a pass of cap rows takes" {
+    try std.testing.expectEqualStrings("fn_gdn_chunk_prep_h8", Fns.symbol("prep", "_h8"));
+    try std.testing.expectEqualStrings("fn_gdn_chunk_state", Fns.symbol("state", ""));
+    try std.testing.expectEqual(@as(usize, 24), chunks(1536));
+    try std.testing.expectEqual(@as(usize, 12), chunks(768));
+    try std.testing.expectEqual(@as(usize, 16), chunks(1001));
+    try std.testing.expectEqual(@as(usize, 24 * 48 * (64 * 128 + 64 * 64 + 64) * 4), scratchBytes(1536));
+    try std.testing.expectEqual(@as(usize, 0), scratchBytes(0));
+}
