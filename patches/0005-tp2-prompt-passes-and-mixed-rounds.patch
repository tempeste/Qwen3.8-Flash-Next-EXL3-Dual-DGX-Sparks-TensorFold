diff --git a/zig/src/families/flashnext/cuda_seq_par.zig b/zig/src/families/flashnext/cuda_seq_par.zig
new file mode 100644
index 0000000000000000000000000000000000000000..db477c5c6142175c2e2380bac66b7cada32888e4
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_seq_par.zig
@@ -0,0 +1,198 @@
+//! TF_FLASHNEXT_TP_SEQPAR: a --tp 2 prompt pass's rank sums past the PLE layer as row exchanges (cuda_knobs.tpSeqPar).
+//! Each rank owns one row half: the out projection's and the experts' fp32 partials of the peer's half go to the peer
+//! and the peer's of its own half come back into the second slice of part (a reduce-scatter, added by the write-back);
+//! the write-back, read-out and router run on the own half; the read-out rows, scales, picks and weights the next split
+//! op reads over every row then cross (an all-gather).
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const split_sum = @import("cuda_split_sum.zig");
+const coll = @import("cuda_collective.zig");
+const Layer = @import("cuda_prompt_load.zig").Layer;
+
+const dims = wt.dims;
+const wide = wt.wide;
+const slots = wt.slots;
+const Piece = coll.Piece;
+const Rows = split_sum.Rows;
+const DataType = cuda.nccl.DataType;
+
+/// A rank's own row half (split_sum.halves' rank-th) and its peer's.
+pub const Halves = struct { own: Rows, peer: Rows };
+
+pub fn halves(n: usize, rank: usize) Halves {
+    const h = split_sum.halves(n);
+    return .{ .own = h[rank], .peer = h[1 - rank] };
+}
+
+/// Whether a pass exchanges rows: the knob, split_sum.takes' passes whatever the sums' stream, and `layers_sum`. A
+/// mixed round's piece (`whole`) never does: the round's windows issue collectives between its layers' sums, so both
+/// ranks keep one collective order only with every sum one all-reduce on the pass's stream.
+pub fn takes(on: bool, whole: bool, ranks: bool, prompt: bool, lanes: usize, keeps: bool, n: usize, min_half: usize, layers_sum: bool) bool {
+    return on and layers_sum and split_sum.takes(true, whole, ranks, prompt, lanes, keeps, n, min_half);
+}
+
+/// Every layer's out projection and experts leave partial fp32 outputs the two ranks add (`partial`: the MoE partial
+/// sum with nothing added to the MoE output).
+pub fn layersSum(layers: []const Layer, partial: bool) bool {
+    if (!partial or layers.len == 0) return false;
+    for (layers) |*lw| {
+        const e = lw.native_experts orelse return false;
+        if (!lw.dense_sum or lw.dense_cut == null or e.world != 2) return false;
+    }
+    return true;
+}
+
+/// Rows of `width` values at `base`: the own half's to the peer, the peer's half into place.
+pub fn rows(base: u64, width: usize, h: Halves, dtype: DataType) Piece {
+    const row = width * coll.elemBytes(dtype);
+    return .{ .send = base + h.own.r0 * row, .send_n = h.own.n * width, .recv = base + h.peer.r0 * row, .recv_n = h.peer.n * width, .dtype = dtype };
+}
+
+/// The fp32 partials of `n` rows at `base`: this rank's of the peer's half to the peer, the peer's of the own half into
+/// the second n-row slice, where the write-back's mode 4 reads it as slice 1.
+pub fn partials(base: u64, n: usize, h: Halves) Piece {
+    return .{ .send = base + h.peer.r0 * dims * 4, .send_n = h.peer.n * dims, .recv = base + (n + h.own.r0) * dims * 4, .recv_n = h.own.n * dims, .dtype = .f32 };
+}
+
+/// The rows a sum site computes before its exchange and after it: with TF_FLASHNEXT_TP_SPLIT_SUM's stream the peer's
+/// half, then the own half while the peer's crosses; else every row, then none.
+pub const Order = struct { first: Rows, then: ?Rows };
+
+pub fn order(split: bool, n: usize, rank: usize) Order {
+    const h = halves(n, rank);
+    return if (split) .{ .first = h.peer, .then = h.own } else .{ .first = .{ .r0 = 0, .n = n }, .then = null };
+}
+
+pub fn passOrder(self: anytype) !Order {
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    return order(self.split and self.s.sums != null, self.rows, c.rank);
+}
+
+/// The partials at `base` exchanged once the pass's stream has written the peer's half: on the sums' stream when
+/// passOrder splits (the pass's stream computes the own half meanwhile), else on the pass's stream.
+pub fn scatter(self: anytype, site: coll.Site, base: u64) !void {
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    const p = [_]Piece{partials(base, self.rows, halves(self.rows, c.rank))};
+    self.s.part_zero = false;
+    if (self.split) if (self.s.sums) |*x| return x.exchange(c, site, self.stream, 0, &p);
+    try c.at(site).exchange(self.stream, &p);
+}
+
+/// The own half's read-out rows to the peer and the peer's into place: mixed, with `xs` its scales, with `routed` the
+/// picks and weights.
+pub fn gather(self: anytype, xs: bool, routed: bool) !void {
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    const s = self.s;
+    var p: [4]Piece = undefined;
+    const k = gatherPieces(&p, s.mixed, s.xsm, s.picks, s.wts, halves(self.rows, c.rank), xs, routed);
+    try c.at(.row_gather).exchange(self.stream, p[0..k]);
+}
+
+fn gatherPieces(p: *[4]Piece, mixed: u64, xsm: u64, picks: u64, wts: u64, h: Halves, xs: bool, routed: bool) usize {
+    var k: usize = 0;
+    p[k] = rows(mixed, dims, h, .bf16);
+    k += 1;
+    if (xs) {
+        p[k] = rows(xsm, dims / 32, h, .f32);
+        k += 1;
+    }
+    if (routed) {
+        p[k] = rows(picks, slots, h, .i32);
+        p[k + 1] = rows(wts, slots, h, .f32);
+        k += 2;
+    }
+    return k;
+}
+
+/// The pass's last write-back on the own rows, then the peer's rows of the streams: the head and the MTP hook read
+/// every row, and rank 1 cannot tell whether rank 0's hook does, so every pass ends with it. Each head path writes the
+/// streams back with nothing pending first, which sums them again, so the sums stay put.
+pub fn finish(self: anytype) !void {
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    const h = halves(self.rows, c.rank);
+    try self.writeback(h.own.r0, h.own.n);
+    self.scattered = false;
+    try c.at(.row_gather).exchange(self.stream, &.{rows(self.s.h, wide, h, .bf16)});
+}
+
+/// The bytes a rank sends in one layer of `n` rows: two all-reduces of n fp32 rows (a two-rank ring sends each rank's
+/// half twice), or two partial exchanges and the two gathers (`xs`: the mixer's projection reads the scales).
+pub const LayerBytes = struct { all_reduce: usize, seqpar: usize };
+
+pub fn layerBytes(n: usize, rank: usize, xs: bool) LayerBytes {
+    const h = halves(n, rank);
+    var dense: [4]Piece = undefined;
+    var moe: [4]Piece = undefined;
+    var sent: usize = 2 * coll.pieceBytes(partials(0, n, h));
+    for (dense[0..gatherPieces(&dense, 0, 0, 0, 0, h, xs, false)]) |p| sent += coll.pieceBytes(p);
+    for (moe[0..gatherPieces(&moe, 0, 0, 0, 0, h, false, true)]) |p| sent += coll.pieceBytes(p);
+    return .{ .all_reduce = 2 * n * dims * 4, .seqpar = sent };
+}
+
+test "seqpar: the halves are split_sum's, rank 0 owning the first, and the pieces address part's two slices" {
+    for ([_]usize{ 1536, 1600, 3072 }) |n| for (0..2) |rank| {
+        const h = halves(n, rank);
+        const all = split_sum.halves(n);
+        try std.testing.expectEqual(all[rank], h.own);
+        try std.testing.expectEqual(all[1 - rank], h.peer);
+        const base: u64 = 0x1000_0000;
+        const p = partials(base, n, h);
+        try std.testing.expectEqual(base + h.peer.r0 * dims * 4, p.send);
+        try std.testing.expectEqual(h.peer.n * dims, p.send_n);
+        try std.testing.expectEqual(base + h.own.r0 * dims * 4 + n * dims * 4, p.recv);
+        try std.testing.expectEqual(h.own.n * dims, p.recv_n);
+        try std.testing.expectEqual(DataType.f32, p.dtype);
+        const m = rows(base, dims, h, .bf16);
+        try std.testing.expectEqual(base + h.own.r0 * dims * 2, m.send);
+        try std.testing.expectEqual(base + h.peer.r0 * dims * 2, m.recv);
+        try std.testing.expectEqual(n * dims, m.send_n + m.recv_n);
+    };
+    const r0 = halves(1536, 0);
+    const r1 = halves(1536, 1);
+    try std.testing.expectEqual(partials(0, 1536, r0).send_n, partials(0, 1536, r1).recv_n);
+    try std.testing.expectEqual(rows(0, slots, r0, .i32).send, rows(0, slots, r1, .i32).recv);
+    try std.testing.expectEqual(Order{ .first = .{ .r0 = 0, .n = 1536 }, .then = null }, order(false, 1536, 1));
+    try std.testing.expectEqual(Order{ .first = r0.peer, .then = r0.own }, order(true, 1536, 0));
+    try std.testing.expectEqual(Rows{ .r0 = 768, .n = 768 }, order(true, 1536, 0).first);
+    try std.testing.expectEqual(Rows{ .r0 = 0, .n = 768 }, order(true, 1536, 1).first);
+}
+
+test "seqpar: a layer sends a quarter fewer bytes than its two all-reduces" {
+    const b = layerBytes(1536, 0, false);
+    try std.testing.expectEqual(@as(usize, 31_457_280), b.all_reduce);
+    try std.testing.expectEqual(@as(usize, 2 * 7_864_320 + 2 * 3_932_160 + 2 * 33_792), b.seqpar);
+    try std.testing.expect(layerBytes(1536, 1, true).seqpar < b.all_reduce * 4 / 5);
+    for ([_]usize{ 1536, 3072, 4096 }) |n| for (0..2) |rank| try std.testing.expect(layerBytes(n, rank, true).seqpar <= layerBytes(n, rank, true).all_reduce);
+}
+
+test "seqpar: only whole --tp prompt chunks whose every layer sums partials exchange rows" {
+    try std.testing.expect(takes(true, false, true, true, 0, false, 1536, 768, true));
+    try std.testing.expect(!takes(false, false, true, true, 0, false, 1536, 768, true));
+    try std.testing.expect(!takes(true, false, true, true, 0, false, 1536, 768, false));
+    try std.testing.expect(!takes(true, false, false, true, 0, false, 1536, 768, true));
+    try std.testing.expect(!takes(true, false, true, false, 0, false, 1536, 768, true));
+    try std.testing.expect(!takes(true, false, true, true, 4, false, 1536, 768, true));
+    try std.testing.expect(!takes(true, false, true, true, 0, true, 1536, 768, true));
+    try std.testing.expect(!takes(true, false, true, true, 0, false, 512, 768, true));
+    try std.testing.expect(!takes(true, false, true, true, 0, false, 1535, 768, true));
+    for ([_]usize{ 1536, 3072, 4096 }) |n| try std.testing.expect(!takes(true, true, true, true, 0, false, n, 768, true));
+    var e: @import("cuda_mixed_experts.zig").Owned = undefined;
+    e.world = 2;
+    var layers: [2]Layer = undefined;
+    for (&layers) |*lw| {
+        lw.dense_sum = true;
+        lw.dense_cut = try @import("cuda_modelopt_experts.zig").Cut.init(dims, 2, 0);
+        lw.native_experts = e;
+    }
+    try std.testing.expect(layersSum(&layers, true));
+    try std.testing.expect(!layersSum(&layers, false));
+    try std.testing.expect(!layersSum(layers[0..0], true));
+    layers[1].dense_sum = false;
+    try std.testing.expect(!layersSum(&layers, true));
+    layers[1].dense_sum = true;
+    layers[1].native_experts.?.world = 1;
+    try std.testing.expect(!layersSum(&layers, true));
+    layers[1].native_experts = null;
+    try std.testing.expect(!layersSum(&layers, true));
+}
