diff --git a/zig/src/families/flashnext/cuda_mixed_plan.zig b/zig/src/families/flashnext/cuda_mixed_plan.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2ad435af42b31f415973999a6e47b66e2561f325
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_mixed_plan.zig
@@ -0,0 +1,283 @@
+//! TF_FLASHNEXT_MIXED_ROUNDS's plan (cuda_lanes.zig): which prompt piece waits for the next decode round to ride in it,
+//! how many rows it takes, and the one piece that may wait. Pure: no device, no lanes.
+const std = @import("std");
+
+/// The rows a mixed round's MoE runs over must fit the engine's scratch (its chunk), and neither group is empty.
+pub fn fits(np: usize, nd: usize, chunk: usize) bool {
+    return np > 0 and nd > 0 and np + nd <= chunk;
+}
+
+/// The prompt-tile row multiple a piece takes.
+pub const row_step = 64;
+
+/// TF_FLASHNEXT_MIXED_ROWS: a mixed round's prompt rows at most (multiples of 64 from 64 to 8192; unset 256). Fewer
+/// rows a round: decoders keep more of their speed; more: the prompt fills faster.
+pub fn rowsSetting(v: ?[]const u8) !usize {
+    const s = v orelse return 256;
+    const n = std.fmt.parseInt(usize, s, 10) catch return error.BadMixedRows;
+    if (n == 0 or n % row_step != 0 or n > 8192) return error.BadMixedRows;
+    return n;
+}
+
+pub fn rows() !usize {
+    return rowsSetting(if (std.c.getenv("TF_FLASHNEXT_MIXED_ROWS")) |v| std.mem.span(v) else null);
+}
+
+/// A piece's rows: `want` within the chunk's room beside a round's widest windows (`round_cap`), in whole row_steps; 0
+/// when no piece fits.
+pub fn pieceRows(want: usize, chunk: usize, round_cap: usize) usize {
+    const room = chunk -| round_cap;
+    return @min(want, room) / row_step * row_step;
+}
+
+/// TF_FLASHNEXT_MIXED_MS=X (1 to 10000; unset or 0: off): a mixed round's forward (the piece's and windows' rows, the
+/// piece's head rows) should take at most X ms; the piece's rows follow its measured time (Budget). Off: every piece
+/// takes TF_FLASHNEXT_MIXED_ROWS. Rank 0's choice only: rank 1 runs the rows each frame names.
+pub fn budgetSetting(v: ?[]const u8) !u64 {
+    const s = v orelse return 0;
+    const ms = std.fmt.parseInt(u64, s, 10) catch return error.BadMixedBudget;
+    if (ms > 10000) return error.BadMixedBudget;
+    return ms * std.time.ns_per_ms;
+}
+
+pub fn budget() !u64 {
+    return budgetSetting(if (std.c.getenv("TF_FLASHNEXT_MIXED_MS")) |v| std.mem.span(v) else null);
+}
+
+/// The piece's rows under a round-time limit, from the measured time a row (two rounds of different rows): a round
+/// over the limit drops the rows it overran by, a full piece's round grows a step while the next step should fit (or
+/// before any time a row is known); always whole steps from one step to `max`.
+pub const Budget = struct {
+    limit_ns: u64,
+    max: usize,
+    rows: usize,
+    last_n: usize = 0,
+    last_ns: u64 = 0,
+    row_ns: u64 = 0,
+
+    pub fn init(limit_ns: u64, start: usize, max: usize) Budget {
+        const top = @max(row_step, max / row_step * row_step);
+        return .{ .limit_ns = limit_ns, .max = top, .rows = std.math.clamp(start / row_step * row_step, row_step, top) };
+    }
+
+    /// A mixed round of `n` piece rows took `ns`.
+    pub fn observe(b: *Budget, n: usize, ns: u64) void {
+        if (n == 0 or ns == 0) return;
+        if (b.last_n != 0 and n != b.last_n and (n > b.last_n) == (ns > b.last_ns)) {
+            const dn: u64 = if (n > b.last_n) n - b.last_n else b.last_n - n;
+            const dt: u64 = if (ns > b.last_ns) ns - b.last_ns else b.last_ns - ns;
+            const seen = @max(1, dt / dn);
+            b.row_ns = if (b.row_ns == 0) seen else (b.row_ns + seen) / 2;
+        }
+        b.last_n = n;
+        b.last_ns = ns;
+        if (ns > b.limit_ns) {
+            const over = ns - b.limit_ns;
+            const cut: usize = if (b.row_ns == 0) n - @as(usize, @intCast(@as(u128, n) * b.limit_ns / ns)) else @intCast(std.math.divCeil(u64, over, b.row_ns) catch unreachable);
+            b.rows = @max(row_step, @min(b.rows -| row_step, (n -| cut) / row_step * row_step));
+        } else if (n >= b.rows and (b.row_ns == 0 or ns + b.row_ns * row_step <= b.limit_ns)) b.rows = @min(b.max, b.rows + row_step);
+    }
+};
+
+/// What a lane's prompt step looks like to the plan.
+pub const Step = struct {
+    /// TF_FLASHNEXT_MIXED_ROUNDS on and the engine able (cuda_prompt_mixed.supported).
+    on: bool,
+    /// The lane drafts (its rows' hidden streams feed the head) and another stream decodes.
+    drafting: bool,
+    decoders: bool,
+    /// The piece ends the prompt (scores wanted), at a cache mark (the hook reads its state), or holds image rows.
+    last: bool,
+    mark: bool,
+    media: bool,
+    /// The piece's rows.
+    rows: usize,
+};
+
+/// Whether this step's piece waits for the next round instead of running now.
+pub fn defers(s: Step) bool {
+    return s.on and s.drafting and s.decoders and !s.last and !s.mark and !s.media and s.rows > 0;
+}
+
+/// The one piece waiting: its lane (by key), its rows [at, stop). A second piece never waits: the first runs before it.
+pub fn Waiting(comptime Key: type) type {
+    return struct {
+        const Self = @This();
+        pub const Piece = struct { key: Key, at: usize, stop: usize };
+
+        piece: ?Piece = null,
+
+        /// The waiting piece, taken: whoever takes it runs it (in a round or alone) before anything else of its lane.
+        pub fn take(w: *Self) ?Piece {
+            defer w.piece = null;
+            return w.piece;
+        }
+
+        pub fn put(w: *Self, p: Piece) !void {
+            if (w.piece != null or p.stop <= p.at) return error.UnexpectedTensor;
+            w.piece = p;
+        }
+
+        /// The piece forgotten if it is `key`'s (a cancelled or released lane: none of it ran).
+        pub fn drop(w: *Self, key: Key) bool {
+            const p = w.piece orelse return false;
+            if (p.key != key) return false;
+            w.piece = null;
+            return true;
+        }
+    };
+}
+
