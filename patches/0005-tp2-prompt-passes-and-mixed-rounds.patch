@@ -0,0 +1,68 @@
+//! Rank 0's unread acks of queued prompt chunks (TF_FLASHNEXT_TP_PROMPT_ASYNC): rank 1 acks every command in its
+//! order, so the next ack rank 0 reads is the oldest unread one's; each is read and checked before any later one.
+const std = @import("std");
+const wire = @import("cuda_rank_wire.zig");
+
+/// A chunk's ack waits here until rank 0 reads its next one; at most `cap`, the oldest read first when full.
+pub const Pending = struct {
+    items: [cap]wire.Header = undefined,
+    n: usize = 0,
+
+    pub const cap = 8;
+
+    pub fn full(p: *const Pending) bool {
+        return p.n == cap;
+    }
+
+    pub fn oldest(p: *const Pending) ?wire.Header {
+        return if (p.n == 0) null else p.items[0];
+    }
+
+    pub fn push(p: *Pending, h: wire.Header) !void {
+        if (p.full()) return error.BadRankFrame;
+        p.items[p.n] = h;
+        p.n += 1;
+    }
+
+    /// The oldest is read: the rest move up, in order.
+    pub fn pop(p: *Pending) void {
+        if (p.n == 0) return;
+        std.mem.copyForwards(wire.Header, p.items[0 .. p.n - 1], p.items[1..p.n]);
+        p.n -= 1;
+    }
+
+    pub fn clear(p: *Pending) void {
+        p.n = 0;
+    }
+};
+
+/// Rank 1's ack `h` of `sent`: its flags, or BadRankFrame when it is not that command's ack.
+pub fn flags(h: wire.Header, sent: wire.Header) !u32 {
+    if (h.kind != .ack or h.sequence != sent.sequence or h.object != sent.object or h.bytes != 0 or h.arg != 0) return error.BadRankFrame;
+    return h.flags;
+}
+
+test "deferred acks: read oldest first, bounded, and an ack must name its own command" {
+    var p: Pending = .{};
+    try std.testing.expectEqual(@as(?wire.Header, null), p.oldest());
+    for (1..Pending.cap + 1) |i| try p.push(.{ .kind = .forward, .sequence = i, .object = 7 });
+    try std.testing.expect(p.full());
+    try std.testing.expectError(error.BadRankFrame, p.push(.{ .kind = .forward, .sequence = 99 }));
+    for (1..Pending.cap + 1) |i| {
+        const h = p.oldest().?;
+        try std.testing.expectEqual(@as(u64, i), h.sequence);
+        try std.testing.expectEqual(@as(u32, 0), try flags(.{ .kind = .ack, .sequence = h.sequence, .object = h.object }, h));
+        p.pop();
+    }
+    try std.testing.expectEqual(@as(?wire.Header, null), p.oldest());
+    p.pop();
+    try std.testing.expectEqual(@as(usize, 0), p.n);
+    const sent: wire.Header = .{ .kind = .forward, .sequence = 4, .object = 2 };
+    try std.testing.expectError(error.BadRankFrame, flags(.{ .kind = .ack, .sequence = 5, .object = 2 }, sent));
+    try std.testing.expectError(error.BadRankFrame, flags(.{ .kind = .ack, .sequence = 4, .object = 3 }, sent));
+    try std.testing.expectError(error.BadRankFrame, flags(.{ .kind = .ready, .sequence = 4, .object = 2 }, sent));
+    try std.testing.expectEqual(@as(u32, 3), try flags(.{ .kind = .ack, .sequence = 4, .object = 2, .flags = 3 }, sent));
+    try p.push(sent);
+    p.clear();
+    try std.testing.expectEqual(@as(?wire.Header, null), p.oldest());
+}
