+/// TF_FLASHNEXT_PROMPT_LOOKUP=1: the copies drafted from a stream's own context (lanes.SuffixLookup; on today at 15 rows
+/// a shared round) widen in shared rounds as a lone stream's do, up to the 31 a window holds; are priced by the stream's
+/// own copies that landed; take a stream's round only when they expect more tokens than its held MTP drafts; and
+/// continue a head chain whose drafts the context follows. TF_FLASHNEXT_PROMPT_LOOKUP_MIN=<n> (4 to 64, default 8) is
+/// the matched context a copy needs. Drafts only choose which rows a round verifies, and the target picks every
+/// token, so replies do not change; rank 0 alone plans the windows, so the ranks need not agree. Unset or 0: today's
+/// copies. Other values refuse to start (BadPromptLookup).
+pub const PromptLookup = struct { on: bool = false, min_match: i64 = 8 };
+
+pub fn promptLookup() !PromptLookup {
+    const get = std.c.getenv;
+    return promptLookupSetting(if (get("TF_FLASHNEXT_PROMPT_LOOKUP")) |v| std.mem.span(v) else null, if (get("TF_FLASHNEXT_PROMPT_LOOKUP_MIN")) |v| std.mem.span(v) else null);
+}
+
+pub fn promptLookupSetting(value: ?[]const u8, min: ?[]const u8) !PromptLookup {
+    const v = value orelse "0";
+    if (!std.mem.eql(u8, v, "0") and !std.mem.eql(u8, v, "1")) return error.BadPromptLookup;
+    const n: i64 = if (min) |m| std.fmt.parseInt(i64, m, 10) catch return error.BadPromptLookup else 8;
+    if (n < 4 or n > 64) return error.BadPromptLookup;
+    if (v[0] == '0') return .{};
+    return .{ .on = true, .min_match = n };
+}
+
+test "prompt lookup is off unset or 0, on at 1 with a minimum match of 4 to 64 (8 unset), and refuses anything else" {
