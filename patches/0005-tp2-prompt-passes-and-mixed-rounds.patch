diff --git a/zig/kernels/cuda/exl3_fnx_prompt.cuh b/zig/kernels/cuda/exl3_fnx_prompt.cuh
index d4885009a4bd2c2c9d61aa3d11c9567566edca0d..c749194a8cba6cf9145d50db487261a1258d9952 100644
--- a/zig/kernels/cuda/exl3_fnx_prompt.cuh
+++ b/zig/kernels/cuda/exl3_fnx_prompt.cuh
@@ -220,6 +220,268 @@ __device__ __forceinline__ void body(const FnxArgs& f) {
     }
 }
 
+struct RotArgs {
+    const __nv_bfloat16* x;
+    const half* suh_g;
+    const half* suh_u;
+    int stride;
+    int slots;
+};
+static_assert(sizeof(RotArgs) == 32, "cuda_exl3_prompt.zig's RotArgs");
+
+template <int K2, int MTL, int NG, int KS, int NSA, int NGR>
+struct RotCfg {
+    using C = Cfg<2, 2, K2, MTL, NG, KS, NSA, NGR>;
+    static constexpr int SPB = 128 / (KS * 16);
+    static constexpr size_t RING = (size_t)NSA * C::W_BYTES;
+    static constexpr size_t A = (size_t)SPB * C::A_BYTES;
+    static constexpr size_t SMEM = RING + A > C::EPI ? RING + A : C::EPI;
+    static_assert(SPB * KS * 16 == 128, "whole Hadamard blocks a group of stages");
+};
+
+template <int N8, int K2, int MTL, int NG, int KS, int NSA, int NGR, typename LoadFn, typename RotFn>
+__device__ __forceinline__ void kloop_rot(float (&acc)[MTL][NG][4], const unsigned char* smem, int S, int mat, int slice,
+                                          int lr, int lc, const tf_exl3x::LaneMap<K2>& map, LoadFn&& load_stage,
+                                          RotFn&& rotate) {
+    using R = RotCfg<K2, MTL, NG, KS, NSA, NGR>;
+    using C = typename R::C;
+    constexpr int BM = C::BM, LDA = C::LDA, CPR = C::CPR, TW = C::TW, PAIRS = N8 / 2, SPB = R::SPB;
+    const half* abuf = reinterpret_cast<const half*>(smem + R::RING);
+#pragma unroll
+    for (int s = 0; s < NSA - 1; ++s) {
+        if (s < S) load_stage(s);
+        cp_commit();
+    }
+    cp_wait<NSA - 2>();
+    for (int s = 0; s < S; ++s) {
+        if (s + NSA - 1 < S) load_stage(s + NSA - 1);
+        cp_commit();
+        if (s % SPB == 0) {
+            rotate(s / SPB);
+            __syncthreads();
+        }
+        const half* A = abuf + (size_t)((s % SPB) * 2 + mat) * BM * LDA;
+        const uint32_t* Wd = reinterpret_cast<const uint32_t*>(smem + (size_t)(s % NSA) * C::W_BYTES) +
+                             (size_t)mat * KS * NB * TW + slice * MTL * TW;
+#pragma unroll
+        for (int kk = 0; kk < KS; ++kk) {
+            uint32_t af[MTL][4];
+#pragma unroll
+            for (int l = 0; l < MTL; ++l) dsv41_x3gm::decode_a<K2>(Wd + (kk * NB + l) * TW, map, af[l]);
+            const int chunk = swz<CPR>(lr, kk * 2 + lc);
+#pragma unroll
+            for (int np = 0; np < PAIRS; ++np) {
+                uint32_t b[4];
+                qmm_frag::ldmatrix4(b, A + (16 * np + lr) * LDA + chunk * 8);
+                const uint32_t b01[2] = {b[0], b[1]}, b23[2] = {b[2], b[3]};
+#pragma unroll
+                for (int l = 0; l < MTL; ++l) {
+                    tf_exl3x::mma16816(acc[l][2 * np], af[l], b01);
+                    tf_exl3x::mma16816(acc[l][2 * np + 1], af[l], b23);
+                }
+            }
+            if constexpr ((N8 & 1) != 0) {
+                uint32_t b[2];
+                qmm_frag::ldmatrix2(b, A + (16 * PAIRS + lr) * LDA + chunk * 8);
+#pragma unroll
+                for (int l = 0; l < MTL; ++l) tf_exl3x::mma16816(acc[l][2 * PAIRS], af[l], b);
+            }
+        }
+        cp_wait<NSA - 2>();
+        __syncthreads();
+    }
+}
+
+template <int K2, int MTL, int NG, int KS, int NSA, int NGR>
+__device__ __forceinline__ void gur_item(const FnxArgs& f, const RotArgs& ra, unsigned char* smem, const int* rows_sh,
+                                         int e, int cnt, int nb) {
+    constexpr int MATS = 2;
+    using R = RotCfg<K2, MTL, NG, KS, NSA, NGR>;
+    using C = typename R::C;
+    static_assert(R::SMEM <= SMEM, "the launch's dynamic shared memory");
+    constexpr int THREADS = C::THREADS, BM = C::BM, LDE = C::LDE, ER = C::ER, CPR = C::CPR, TW = C::TW, W = C::W,
+                  LDA = C::LDA, KSUB = KS * 16;
+    constexpr int WCH = MATS * KS * NB * K2, WPT = (WCH + THREADS - 1) / THREADS;
+    const Args& a = f.g;
+    float* ep = reinterpret_cast<float*>(smem);
+    half* abuf = reinterpret_cast<half*>(smem + R::RING);
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int mat = warp / C::WPM, slice = warp % C::WPM;
+    const int K = a.K, N = a.N, KT = K >> 4, NTILES = N >> 4, S = KT / KS;
+    const int lr = (lane & 7) + ((lane >> 4) << 3), lc = (lane >> 3) & 1;
+    const tf_exl3x::LaneMap<K2> map(lane);
+    const uint32_t* te0 = reinterpret_cast<const uint32_t*>(a.tp0[e]);
+    const uint32_t* te1 = reinterpret_cast<const uint32_t*>(a.tp1[e]);
+    const int cnt16 = (cnt + 15) & ~15;
+
+    int w_src[WPT];
+#pragma unroll
+    for (int j = 0; j < WPT; ++j) {
+        const int i = threadIdx.x + j * THREADS, q = i % K2, n = (i / K2) % NB, kk = (i / (K2 * NB)) % KS;
+        w_src[j] = (kk * NTILES + nb * NB + n) * TW + q * 4;
+    }
+    auto load_stage = [&](int s) {
+        uint32_t* rw = reinterpret_cast<uint32_t*>(smem + (size_t)(s % NSA) * C::W_BYTES);
+        const size_t ws = (size_t)s * KS * NTILES * TW;
+#pragma unroll
+        for (int j = 0; j < WPT; ++j) {
+            const int i = threadIdx.x + j * THREADS;
+            if (WCH % THREADS == 0 || i < WCH) {
+                const int q = i % K2, n = (i / K2) % NB, kk = (i / (K2 * NB)) % KS, m = i / (K2 * NB * KS);
+                cp_async16(rw + ((m * KS + kk) * NB + n) * TW + q * 4, (m ? te1 : te0) + ws + w_src[j], true);
+            }
+        }
+    };
+    const int sj = (4 * lane) / KSUB, kc = (4 * lane) % KSUB, KB = K >> 7;
+    auto fetch = [&](int blk) {
+        if (blk >= KB) return;
+        for (int r = warp; r < cnt; r += W) {
+            const int p = rows_sh[r];
+            if (p >= 0 && (lane & 15) == 0)
+                asm volatile("prefetch.global.L1 [%0];" ::"l"(ra.x + (size_t)(p / ra.slots) * ra.stride + blk * 128 + 4 * lane));
+        }
+    };
+    auto rotate = [&](int blk) {
+        const half* sg = ra.suh_g + (size_t)e * K + blk * 128 + 4 * lane;
+        const half* su = ra.suh_u + (size_t)e * K + blk * 128 + 4 * lane;
+        float s0[4], s1[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            s0[j] = __half2float(sg[j]);
+            s1[j] = __half2float(su[j]);
+        }
+#pragma unroll 2
+        for (int r = warp; r < cnt16; r += W) {
+            const int p = rows_sh[r];
+            half2* o0 = reinterpret_cast<half2*>(abuf + ((size_t)(sj * 2) * BM + r) * LDA + swz<CPR>(r, kc >> 3) * 8 + (kc & 7));
+            half2* o1 = o0 + BM * LDA / 2;
+            if (p < 0) {
+                o0[0] = o0[1] = o1[0] = o1[1] = __float2half2_rn(0.f);
+                continue;
+            }
+            const uint2 xq = *reinterpret_cast<const uint2*>(ra.x + (size_t)(p / ra.slots) * ra.stride + blk * 128 + 4 * lane);
+            const __nv_bfloat16* xr = reinterpret_cast<const __nv_bfloat16*>(&xq);
+            float xv[4], v[4], u[4];
+#pragma unroll
+            for (int j = 0; j < 4; ++j) xv[j] = __bfloat162float(xr[j]);
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                v[j] = xv[j] * s0[j];
+                u[j] = xv[j] * s1[j];
+            }
+            tf_exl3::fwht128(v, lane);
+            tf_exl3::fwht128(u, lane);
+            o0[0] = __halves2half2(__float2half_rn(v[0] * tf_exl3::HAD_SCALE), __float2half_rn(v[1] * tf_exl3::HAD_SCALE));
+            o0[1] = __halves2half2(__float2half_rn(v[2] * tf_exl3::HAD_SCALE), __float2half_rn(v[3] * tf_exl3::HAD_SCALE));
+            o1[0] = __halves2half2(__float2half_rn(u[0] * tf_exl3::HAD_SCALE), __float2half_rn(u[1] * tf_exl3::HAD_SCALE));
+            o1[1] = __halves2half2(__float2half_rn(u[2] * tf_exl3::HAD_SCALE), __float2half_rn(u[3] * tf_exl3::HAD_SCALE));
+        }
+        fetch(blk + 1);
+    };
+    fetch(0);
+
+    float acc[MTL][NG][4];
+#pragma unroll
+    for (int l = 0; l < MTL; ++l)
+#pragma unroll
+        for (int n = 0; n < NG; ++n)
+#pragma unroll
+            for (int c = 0; c < 4; ++c) acc[l][n][c] = 0.f;
+
+    static_assert(NG == 8, "64-member passes");
+    const int n8 = (cnt + 7) >> 3;
+#define FNX_K(G) \
+    kloop_rot<G, K2, MTL, NG, KS, NSA, NGR>(acc, smem, S, mat, slice, lr, lc, map, load_stage, rotate)
+    switch (n8) {
+        case 1: FNX_K(1); break;
+        case 2: FNX_K(2); break;
+        case 3: FNX_K(3); break;
+        case 4: FNX_K(4); break;
+        case 5: FNX_K(5); break;
+        case 6: FNX_K(6); break;
+        case 7: FNX_K(7); break;
+        default: FNX_K(8); break;
+    }
+#undef FNX_K
+
+    const int g = lane >> 2, t = lane & 3;
+#pragma unroll
+    for (int rd = 0; rd < C::ROUNDS; ++rd) {
+        if (rd) __syncthreads();
+        if (ER * rd < cnt) {
+#pragma unroll
+            for (int n = 0; n < NGR; ++n) {
+                const int ng = rd * NGR + n;
+                float* E = ep + ((size_t)mat * ER + 8 * n + 2 * t) * LDE + slice * 16 * MTL + g;
+#pragma unroll
+                for (int l = 0; l < MTL; ++l) {
+                    E[l * 16] = acc[l][ng][0];
+                    E[LDE + l * 16] = acc[l][ng][1];
+                    E[l * 16 + 8] = acc[l][ng][2];
+                    E[LDE + l * 16 + 8] = acc[l][ng][3];
+                }
+            }
+        }
+        __syncthreads();
+        for (int r = warp; r < ER && ER * rd + r < cnt; r += W) {
+            const int row = rows_sh[ER * rd + r];
+            const int c0 = 4 * lane;
+            const size_t col = (size_t)e * N + nb * 128 + c0;
+            float v[4], u[4];
+            *reinterpret_cast<float4*>(v) = *reinterpret_cast<const float4*>(ep + (size_t)r * LDE + c0);
+            *reinterpret_cast<float4*>(u) = *reinterpret_cast<const float4*>(ep + ((size_t)ER + r) * LDE + c0);
+            tf_exl3::fwht128(v, lane);
+            tf_exl3::fwht128(u, lane);
+            float xv[4];
+            __nv_bfloat16* ao = f.act + (size_t)row * N + nb * 128 + c0;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                float gv = v[j] * tf_exl3::HAD_SCALE * __half2float(a.sv0[col + j]);
+                const float up = u[j] * tf_exl3::HAD_SCALE * __half2float(a.sv1[col + j]);
+                gv = gv / (1.f + expf(-gv));
+                gv *= up;
+                const __nv_bfloat16 b = __float2bfloat16_rn(gv);
+                ao[j] = b;
+                xv[j] = __bfloat162float(b) * __half2float(a.sd[col + j]);
+            }
+            tf_exl3::fwht128(xv, lane);
+            half2* o = reinterpret_cast<half2*>(a.xd + (size_t)row * N + nb * 128 + c0);
+            o[0] = __halves2half2(__float2half_rn(xv[0] * tf_exl3::HAD_SCALE), __float2half_rn(xv[1] * tf_exl3::HAD_SCALE));
+            o[1] = __halves2half2(__float2half_rn(xv[2] * tf_exl3::HAD_SCALE), __float2half_rn(xv[3] * tf_exl3::HAD_SCALE));
+        }
+    }
+}
+
+template <int MTL, int NG, int KS, int NSA, int NGR>
+__device__ __forceinline__ void body_rot(const FnxArgs& f, const RotArgs& ra) {
+    constexpr int BM = NG * 8;
+    static_assert(BM == MEMBERS, "the plan's prompt tile");
+    extern __shared__ __align__(16) unsigned char smem[];
+    __shared__ int rows_sh[BM];
+    const int NBLK = f.g.N >> 7;
+    const int tt = blockIdx.x / NBLK, nb = blockIdx.x % NBLK;
+    if (tt >= f.counts[0]) return;
+    const int e = f.items[3 * tt], first = f.items[3 * tt + 1], cnt = f.items[3 * tt + 2];
+    if (e == f.skip || cnt <= 0) return;
+    if (cnt > BM || dynamic_smem() < SMEM) __trap();
+    for (int i = threadIdx.x; i < BM; i += blockDim.x) rows_sh[i] = i < cnt ? f.members[first + i] : -1;
+    __syncthreads();
+    const int k2 = f.g.k2e[e];
+    if (f.k2u[e] != k2) __trap();
+    switch (k2) {
+#define FNX_CASE(K)                                                                                                \
+    case K:                                                                                                        \
+        gur_item<K, MTL, NG, KS, Ring2<2, 2, K, MTL, NG, KS, NSA, NGR>::value, NGR>(f, ra, smem, rows_sh, e, cnt, nb); \
+        break;
+        FNX_CASE(4)
+        FNX_CASE(5)
+        FNX_CASE(6)
+        FNX_CASE(8)
+#undef FNX_CASE
+        default: __trap();
+    }
+}
