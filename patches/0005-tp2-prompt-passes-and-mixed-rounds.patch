+
+template <bool EMIT, bool PAGED>
+__device__ __forceinline__ void pass_body(const __nv_bfloat16* __restrict__ IQ, const __nv_bfloat16* __restrict__ POOLED,
+                                          const int* __restrict__ POS0, int* __restrict__ HM, int* __restrict__ AB,
+                                          uint2* __restrict__ CD, int NB, int RATIO, int TOP, int rows, const Pg& pg) {
+    __shared__ uint32_t sm[RT * NBIN / 2];
+    __shared__ int cut_s[RT];
+    const int r0 = blockIdx.x * RT;
+    const int pos0 = POS0[0];
+    const int last = min(r0 + RT, rows) - 1;
+    const int cmax = (pos0 + last + 1) / RATIO;
+    const int seg0 = blockIdx.y * SEG;
+    if (cmax <= TOP || seg0 >= cmax) return;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5, g = lane >> 2, j = lane & 3;
+    uint4* qs = reinterpret_cast<uint4*>(sm);
+    for (int e = threadIdx.x; e < HI * RT * DI / 8; e += blockDim.x) {
+        const int h = e / (RT * DI / 8), ri = (e / (DI / 8)) % RT, c = e % (DI / 8);
+        const int r = min(r0 + ri, rows - 1);
+        qs[e] = *reinterpret_cast<const uint4*>(IQ + (static_cast<long long>(r) * HI + h) * DI + c * 8);
+    }
+    if (EMIT && threadIdx.x < RT) cut_s[threadIdx.x] = r0 + static_cast<int>(threadIdx.x) < rows ? HM[(r0 + threadIdx.x) * HW + NBIN + 2] : NBIN;
+    __syncthreads();
+    uint4 qa[HI][4], qb[HI][4];
+#pragma unroll
+    for (int h = 0; h < HI; ++h)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            qa[h][i] = qs[(h * RT + g) * (DI / 8) + 4 * i + j];
+            qb[h][i] = qs[(h * RT + g + 8) * (DI / 8) + 4 * i + j];
+        }
+    __syncthreads();
+    if (!EMIT) {
+        for (int e = threadIdx.x; e < RT * NBIN / 2; e += blockDim.x) sm[e] = 0u;
+        __syncthreads();
+    }
+    const int ra = r0 + g, rb = r0 + g + 8;
+    int ca = ra < rows ? (pos0 + ra + 1) / RATIO : 0;
+    int cb = rb < rows ? (pos0 + rb + 1) / RATIO : 0;
+    if (ca <= TOP) ca = 0;
+    if (cb <= TOP) cb = 0;
+    const int cut_a = EMIT ? cut_s[g] : 0, cut_b = EMIT ? cut_s[g + 8] : 0;
+    const float scale = __fsqrt_rn(static_cast<float>(DI));
+    const int tiles = min(SEG, cmax - seg0 + 7) / 8;
+    uint4 bv[4];
+    int t = warp;
+    if (t < tiles) load_keys<PAGED>(bv, POOLED, seg0 + 8 * t + g, cmax, j, RATIO, pg);
+    for (; t < tiles; t += WARPS) {
+        const int n0 = seg0 + 8 * t;
+        float acc[HI][4];
+#pragma unroll
+        for (int h = 0; h < HI; ++h)
+#pragma unroll
+            for (int e = 0; e < 4; ++e) acc[h][e] = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i)
+#pragma unroll
+            for (int tt = 0; tt < 2; ++tt) {
+                const uint32_t b0 = tt ? bv[i].z : bv[i].x, b1 = tt ? bv[i].w : bv[i].y;
+#pragma unroll
+                for (int h = 0; h < HI; ++h) {
+                    const uint32_t af[4] = {tt ? qa[h][i].z : qa[h][i].x, tt ? qb[h][i].z : qb[h][i].x,
+                                            tt ? qa[h][i].w : qa[h][i].y, tt ? qb[h][i].w : qb[h][i].y};
+                    qmm_frag::mma(acc[h], af, b0, b1);
+                }
+            }
+        if (t + WARPS < tiles) load_keys<PAGED>(bv, POOLED, n0 + 8 * WARPS + g, cmax, j, RATIO, pg);
+        uint32_t k[4];
+        bool ok[4];
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            float total = 0.0f;
+#pragma unroll
+            for (int h = 0; h < HI; ++h) total = __fadd_rn(total, fmaxf(acc[h][e], 0.0f));
+            k[e] = key(__fdiv_rn(total, scale));
+            ok[e] = n0 + 2 * j + (e & 1) < (e < 2 ? ca : cb);
+        }
+        if (!EMIT) {
+#pragma unroll
+            for (int e = 0; e < 4; ++e)
+                if (ok[e]) {
+                    const int bn = bin(k[e]);
+                    atomicAdd(&sm[(g + (e >> 1) * 8) * (NBIN / 2) + (bn >> 1)], 1u << ((bn & 1) * 16));
+                }
+            continue;
+        }
+        int up[4];
+        bool hit = false;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            const int bn = bin(k[e]), c = e < 2 ? cut_a : cut_b;
+            up[e] = !ok[e] ? 0 : bn > c ? 1 : bn == c ? 2 : 0;
+            hit = hit || up[e] != 0;
+        }
+        if (!__any_sync(0xffffffffu, hit)) continue;
+#pragma unroll
+        for (int half = 0; half < 2; ++half) {
+            const int r = half ? rb : ra;
+            int* meta = HM + static_cast<long long>(r) * HW + NBIN;
+            const int e0 = 2 * half;
+            const int na = (up[e0] == 1) + (up[e0 + 1] == 1), nc = (up[e0] == 2) + (up[e0 + 1] == 2);
+            int sa = reserve(na, meta), sc = reserve(nc, meta + 1);
+#pragma unroll
+            for (int e = e0; e < e0 + 2; ++e) {
+                const int b = n0 + 2 * j + (e & 1);
+                if (up[e] == 1) {
+                    if (sa < TOP) AB[static_cast<long long>(r) * TOP + sa] = b;
+                    ++sa;
+                } else if (up[e] == 2) {
+                    if (sc < NB) CD[static_cast<long long>(r) * NB + sc] = make_uint2(k[e], static_cast<uint32_t>(b));
+                    ++sc;
+                }
+            }
+        }
+    }
+    if (EMIT) return;
+    __syncthreads();
+    for (int e = threadIdx.x; e < RT * NBIN / 2; e += blockDim.x) {
+        const uint32_t w = sm[e];
+        if (w == 0u) continue;
+        int* h = HM + static_cast<long long>(r0 + e / (NBIN / 2)) * HW + (e % (NBIN / 2)) * 2;
+        if (w & 0xFFFFu) atomicAdd(h, static_cast<int>(w & 0xFFFFu));
+        if (w >> 16) atomicAdd(h + 1, static_cast<int>(w >> 16));
+    }
+}
+
+__device__ __forceinline__ int block_scan(int v, int* warp_sums, int* total) {
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5, warps = blockDim.x >> 5;
+    for (int o = 1; o < 32; o <<= 1) {
+        const int n = __shfl_up_sync(0xffffffffu, v, o);
+        if (lane >= o) v += n;
+    }
+    if (lane == 31) warp_sums[warp] = v;
+    __syncthreads();
+    if (warp == 0) {
+        int w = lane < warps ? warp_sums[lane] : 0;
+        for (int o = 1; o < 32; o <<= 1) {
+            const int n = __shfl_up_sync(0xffffffffu, w, o);
+            if (lane >= o) w += n;
+        }
+        if (lane < warps) warp_sums[lane] = w;
+    }
+    __syncthreads();
+    if (warp > 0) v += warp_sums[warp - 1];
+    *total = warp_sums[warps - 1];
+    __syncthreads();
+    return v;
+}
+
+__device__ __forceinline__ void cut_body(int* __restrict__ HM, const int* __restrict__ POS0, int RATIO, int TOP) {
+    __shared__ int warp_sums[32];
+    const int r = blockIdx.x;
+    if ((POS0[0] + r + 1) / RATIO <= TOP) return;
+    int* h = HM + static_cast<long long>(r) * HW;
+    const int d = NBIN - 1 - threadIdx.x;
+    const int v = h[d];
+    int total = 0;
+    const int s = block_scan(v, warp_sums, &total);
+    if (s >= TOP && s - v < TOP) {
+        h[NBIN + 2] = d;
+        h[NBIN + 3] = TOP - (s - v);
+    }
+}
+
+__device__ __forceinline__ void pick_body(const int* __restrict__ POS0, const int* __restrict__ HM,
+                                          const int* __restrict__ AB, const uint2* __restrict__ CD, int* __restrict__ ids,
+                                          int* __restrict__ nkr, int* __restrict__ spr, int NB, int idw, int TOP,
+                                          int RATIO) {
+    __shared__ int list[TOPMAX];
+    __shared__ int hist[256];
+    __shared__ unsigned long long cut_s;
+    __shared__ int need_s;
+    __shared__ int placed_s;
+    const int r = blockIdx.x;
+    const int end = POS0[0] + r + 1;
+    const int complete = end / RATIO;
+    if (complete <= TOP) {
+        if (threadIdx.x == 0) {
+            nkr[r] = end;
+            spr[r] = 0;
+        }
+        return;
+    }
+    const int* meta = HM + static_cast<long long>(r) * HW + NBIN;
+    const int above = min(meta[0], TOP);
+    const int cands = min(meta[1], NB);
+    const uint2* cd = CD + static_cast<long long>(r) * NB;
+    const int* ab = AB + static_cast<long long>(r) * TOP;
+    for (int i = threadIdx.x; i < TOPMAX; i += blockDim.x) list[i] = i < above ? ab[i] : 0x7fffffff;
+    int need = min(TOP - above, cands);
+    unsigned long long cut = 0ull;
+    if (need > 0 && need < cands) {
+        for (int p = 0; p < 8; ++p) {
+            const int shift = 56 - 8 * p;
+            for (int i = threadIdx.x; i < 256; i += blockDim.x) hist[i] = 0;
+            __syncthreads();
+            for (int c = threadIdx.x; c < cands; c += blockDim.x) {
+                const unsigned long long k = rank_of(cd[c]);
+                if (p == 0 || (k >> (shift + 8)) == (cut >> (shift + 8))) atomicAdd(&hist[(k >> shift) & 0xFF], 1);
+            }
+            __syncthreads();
+            if (threadIdx.x == 0) {
+                int more = 0;
+                int d = 255;
+                for (; d > 0; --d) {
+                    if (more + hist[d] >= need) break;
+                    more += hist[d];
+                }
+                need_s = need - more;
+                cut_s = cut | (static_cast<unsigned long long>(d) << shift);
+            }
+            __syncthreads();
+            cut = cut_s;
+            need = need_s;
+            __syncthreads();
+        }
+    }
+    if (threadIdx.x == 0) placed_s = above;
+    __syncthreads();
+    if (need > 0)
+        for (int c = threadIdx.x; c < cands; c += blockDim.x) {
+            const uint2 e = cd[c];
+            if (rank_of(e) >= cut) {
+                const int at = atomicAdd(&placed_s, 1);
+                if (at < TOP) list[at] = static_cast<int>(e.y);
+            }
+        }
+    __syncthreads();
+    for (int k = 2; k <= TOPMAX; k <<= 1)
+        for (int jj = k >> 1; jj > 0; jj >>= 1) {
+            for (int i = threadIdx.x; i < TOPMAX; i += blockDim.x) {
+                const int ixj = i ^ jj;
+                if (ixj > i) {
+                    const int a = list[i], b = list[ixj];
+                    if ((a > b) == ((i & k) == 0)) {
+                        list[i] = b;
+                        list[ixj] = a;
+                    }
+                }
+            }
+            __syncthreads();
+        }
+    const int count = min(placed_s, TOP);
+    int* out = ids + static_cast<long long>(r) * idw;
+    for (int i = threadIdx.x; i < count * RATIO; i += blockDim.x) out[i] = list[i / RATIO] * RATIO + i % RATIO;
+    if (threadIdx.x < RATIO) {
+        const int tail = RATIO * complete + threadIdx.x;
+        if (tail < end) out[count * RATIO + threadIdx.x] = tail;
+    }
+    if (threadIdx.x == 0) {
+        nkr[r] = count * RATIO + end - RATIO * complete;
+        spr[r] = 1;
+    }
+}
+}  // namespace qsa_mma
+
+extern "C" __global__ void __launch_bounds__(256)
+    fn_qsa_mma_hist(const __nv_bfloat16* __restrict__ IQ, const __nv_bfloat16* __restrict__ POOLED,
+                    const int* __restrict__ POS0, int* __restrict__ HM, int RATIO, int TOP, int rows) {
+    qsa_mma::pass_body<false, false>(IQ, POOLED, POS0, HM, nullptr, nullptr, 0, RATIO, TOP, rows, Pg{});
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    fn_qsa_mma_hist_paged(const __nv_bfloat16* __restrict__ IQ, const __nv_bfloat16* __restrict__ POOLED,
+                          const int* __restrict__ POS0, int* __restrict__ HM, int RATIO, int TOP, int rows, Pg pg) {
+    qsa_mma::pass_body<false, true>(IQ, POOLED, POS0, HM, nullptr, nullptr, 0, RATIO, TOP, rows, pg);
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    fn_qsa_mma_emit(const __nv_bfloat16* __restrict__ IQ, const __nv_bfloat16* __restrict__ POOLED,
+                    const int* __restrict__ POS0, int* __restrict__ HM, int* __restrict__ AB, uint2* __restrict__ CD,
+                    int NB, int RATIO, int TOP, int rows) {
+    qsa_mma::pass_body<true, false>(IQ, POOLED, POS0, HM, AB, CD, NB, RATIO, TOP, rows, Pg{});
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    fn_qsa_mma_emit_paged(const __nv_bfloat16* __restrict__ IQ, const __nv_bfloat16* __restrict__ POOLED,
+                          const int* __restrict__ POS0, int* __restrict__ HM, int* __restrict__ AB,
+                          uint2* __restrict__ CD, int NB, int RATIO, int TOP, int rows, Pg pg) {
+    qsa_mma::pass_body<true, true>(IQ, POOLED, POS0, HM, AB, CD, NB, RATIO, TOP, rows, pg);
+}
+
+extern "C" __global__ void __launch_bounds__(1024)
+    fn_qsa_mma_cut(int* __restrict__ HM, const int* __restrict__ POS0, int RATIO, int TOP) {
+    qsa_mma::cut_body(HM, POS0, RATIO, TOP);
+}
+
+extern "C" __global__ void __launch_bounds__(512)
+    fn_qsa_mma_pick(const int* __restrict__ POS0, const int* __restrict__ HM, const int* __restrict__ AB,
+                    const uint2* __restrict__ CD, int* __restrict__ ids, int* __restrict__ nkr, int* __restrict__ spr,
+                    int NB, int idw, int TOP, int RATIO) {
+    qsa_mma::pick_body(POS0, HM, AB, CD, ids, nkr, spr, NB, idw, TOP, RATIO);
+}
