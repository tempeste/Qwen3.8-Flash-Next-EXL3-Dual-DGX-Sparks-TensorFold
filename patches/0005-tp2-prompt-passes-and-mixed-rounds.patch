diff --git a/zig/src/families/flashnext/cuda_prompt_mixed.zig b/zig/src/families/flashnext/cuda_prompt_mixed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1940bb96a523b9d7d7ce1ddafe3e3afb33bc0cd5
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_prompt_mixed.zig
@@ -0,0 +1,144 @@
+//! A mixed round (TF_FLASHNEXT_MIXED_ROUNDS): one stream's prompt piece and several streams' drafted windows in one
+//! forward. Each group keeps its own pass, scratch and kernels for everything but the MoE block: the prompt rows on the
+//! engine's scratch with its prompt tiles, the windows on the round scratch with a round's kernels. Each layer's MoE runs
+//! once over both groups' rows (prompt rows first) on the engine's scratch: the expert weights are read once a round,
+//! not once for the piece and again for the round.
+//!
+//! Same bits as the piece alone and the windows alone: the router, top-k, shared expert (native_lane rows), the NVFP4
+//! expert tiles (same bits at every tile, cuda_nvfp4_tile.zig), the own/slot sums and the two ranks' fp32 add are each a
+//! row's own arithmetic, whatever the other rows. The windows' MoE input and fp32 output rows lie in the engine
+//! scratch's rows past the piece's, where the round scratch's `mixed` and `moe_f32` point for the round.
+//!
+//! TF_FLASHNEXT_EXPERTS_EXL3's experts pick their kernels by the pass's rows (TF_EXL3_PROMPT_ROWS, R): a group keeps its
+//! alone bits when its alone pass and the round take one path, both at least R rows or both under. At R=256 (unset)
+//! and 84-row windows: a piece of 128 rows keeps every row's bits (the round is under R); a piece of 256 or more keeps
+//! its own, and the windows' rows take the 64-pair prompt kernels where their alone pass takes the grouped ones. R=1:
+//! every pass takes the prompt kernels, and every row keeps its bits.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const batch = prompt.batch;
+const knobs = @import("cuda_knobs.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const plan = @import("cuda_mixed_plan.zig");
+const Engine = prompt.Engine;
+const Seq = prompt.Seq;
+const Window = prompt.Engine.Window;
+
+const dims = wt.dims;
+const vocab = wt.vocab;
+
+/// A mixed round's prompt piece: `ids` from `seq.fed`, never the prompt's last (no scores), hidden rows to `streams`.
+pub const Piece = struct { seq: *Seq, ids: []const u32, streams: u64 = 0, streams_free: ?cuda.Event = null };
+
+/// Whether this engine's weights and flags take mixed rounds: partial MoE sums (--tp 2) over native experts, no pockets.
+pub fn supported(e: *Engine) bool {
+    if (!knobs.tpMoePartial() or e.pockets.mask() != 0) return false;
+    for (e.layers[0..e.n_layers]) |*l| if (l.native_experts == null) return false;
+    return true;
+}
+
+/// The round scratch for windows of up to `rows` rows, reallocated only to grow.
+pub fn reserveRound(e: *Engine, rows: usize) !*batch.Scratch {
+    if (e.round_s) |*rs| {
+        if (rs.cap >= rows) return rs;
+        try e.complete();
+        e.round_graph.clear();
+        rs.free(e.gpa);
+        e.round_s = null;
+    }
+    e.round_s = try batch.Scratch.alloc(e.gpa, e.driver, e.stream.*, rows);
+    return &e.round_s.?;
+}
+
+/// The piece and the windows in one forward; the windows' rows' scores to `out` and each stream's last row to its host
+/// scores, as Engine.windows leaves them; the piece's sequence moves on by its rows.
+pub fn mixed(e: *Engine, comptime Tri: type, tri: Tri, piece: Piece, wins: []const Window, out: u64) !void {
+    if (wins.len == 0 or e.collective == null or !supported(e)) return error.UnexpectedTensor;
+    const np = piece.ids.len;
+    if (np == 0 or piece.seq.fed + np > piece.seq.cap) return error.UnexpectedTensor;
+    var nd: usize = 0;
+    var cap: usize = piece.seq.cap;
+    for (wins) |w| {
+        if (w.ids.len == 0 or w.seq.fed + w.ids.len > w.seq.cap or w.seq == piece.seq) return error.UnexpectedTensor;
+        nd += w.ids.len;
+        cap = @max(cap, w.seq.cap);
+    }
+    if (nd > e.chunk or !plan.fits(np, nd, e.chunk)) return error.UnexpectedTensor;
+    const ps = try e.reserve(np + nd);
+    const rs = try reserveRound(e, nd);
+    const scores = try e.reserveScores(cap, ps.cap);
+    const lanes = try e.gpa.alloc(batch.Lane, wins.len);
+    defer e.gpa.free(lanes);
+    const ids = try e.gpa.alloc(u32, nd);
+    defer e.gpa.free(ids);
+    var at: usize = 0;
+    for (wins, lanes) |w, *l| {
+        l.* = .{ .seq = w.seq.view(scores), .pos = w.seq.fed, .rows = w.ids.len, .keep = w.keep, .streams = w.streams, .logits = w.logits };
+        @memcpy(ids[at..][0..w.ids.len], w.ids);
+        at += w.ids.len;
+    }
+    const m = e.shipped();
+    var p: batch.Pass(Tri) = .{
+        .gpa = e.gpa,
+        .io = e.io,
+        .stream = e.stream.*,
+        .tri = tri,
+        .k = &e.batch_k,
+        .s = ps,
+        .m = m,
+        .seq = piece.seq.view(scores),
+        .hooks = .{ .logits = .none, .streams = piece.streams, .streams_free = piece.streams_free, .prompt = true },
+        .prompt = knobs.tpPromptRelaxed(),
+        .whole_sums = true,
+    };
+    var d: batch.Pass(Tri) = .{
+        .gpa = e.gpa,
+        .io = e.io,
+        .stream = e.stream.*,
+        .tri = tri,
+        .k = &e.batch_k,
+        .s = rs,
+        .m = m,
+        .seq = lanes[0].seq,
+        .lanes = lanes,
+        .hooks = .{ .logits = .all, .logits_out = out },
+    };
+    const own_mixed = rs.mixed;
+    const own_f32 = rs.moe_f32;
+    rs.mixed = ps.mixed + np * dims * 2;
+    rs.moe_f32 = ps.moe_f32 + np * dims * 4;
+    defer {
+        rs.mixed = own_mixed;
+        rs.moe_f32 = own_f32;
+    }
+    try p.begin(piece.ids, piece.seq.fed);
+    defer p.joinGather();
+    try d.begin(ids, 0);
+    defer d.joinGather();
+    for (m.layers, 0..) |*lw, layer| {
+        try p.front(lw, layer);
+        try d.front(lw, layer);
+        p.rows = np + nd;
+        defer p.rows = np;
+        try p.moeOf(lw, layer);
+        if (!p.pending_f32 or !p.moe_partial) return error.UnexpectedTensor;
+        d.pending = layer;
+        d.pending_f32 = true;
+    }
+    try p.head(null);
+    try d.head(null);
+    try e.complete();
+    const dv = e.stream.d;
+    at = 0;
+    for (wins) |w| {
+        at += w.ids.len;
+        try dv.check(dv.api.cuMemcpyDtoH_v2(w.seq.logits.ptr, out + (at - 1) * vocab * 2, vocab * 2), "cuMemcpyDtoH");
+        w.seq.fed += w.ids.len;
+    }
+    piece.seq.fed += np;
+}
+
+test {
+    _ = plan;
+}
