+    try std.testing.expectEqual(PromptLookup{}, try promptLookupSetting("0", "5"));
+    try std.testing.expectEqual(PromptLookup{ .on = true, .min_match = 8 }, try promptLookupSetting("1", null));
+    try std.testing.expectEqual(PromptLookup{ .on = true, .min_match = 4 }, try promptLookupSetting("1", "4"));
+    try std.testing.expectEqual(PromptLookup{ .on = true, .min_match = 64 }, try promptLookupSetting("1", "64"));
+    for ([_][]const u8{ "", "2", "on", "true", " 1", "10" }) |bad| try std.testing.expectError(error.BadPromptLookup, promptLookupSetting(bad, null));
+    for ([_][]const u8{ "", "3", "65", "x", "-8", " 8" }) |bad| {
