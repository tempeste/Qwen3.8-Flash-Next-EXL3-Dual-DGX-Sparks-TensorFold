diff --git a/zig/src/families/flashnext/cuda_index_rows.zig b/zig/src/families/flashnext/cuda_index_rows.zig
new file mode 100644
index 0000000000000000000000000000000000000000..96d7b5d23bca1754727551d2f823eee4daf64f0b
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_index_rows.zig
@@ -0,0 +1,88 @@
+//! TF_FLASHNEXT_TP_INDEX_ROWS: a --tp 2 prompt pass's indexer split by rows (cuda_knobs.tpIndexRows). In each fused
+//! attention group a rank scores its pooled blocks and selects for its half of the group's att_rows blocks; the two
+//! halves' selections (block ids, counts and sparse flags) then cross before the fused attention reads every row's.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+const coll = @import("cuda_collective.zig");
+const seq_par = @import("cuda_seq_par.zig");
+const split_sum = @import("cuda_split_sum.zig");
+const att_rows = @import("cuda_batch_state.zig").att_rows;
+
+const idw = wt.index_idw;
+const Piece = coll.Piece;
+const Halves = seq_par.Halves;
+
+/// Whether a pass splits its indexer: the knob, two ranks, a prompt pass without lanes that is not a mixed round's piece
+/// (`whole`: the round's windows issue collectives between its layers, so the piece issues none but its whole sums).
+pub fn takes(on: bool, whole: bool, ranks: bool, prompt: bool, lanes: usize) bool {
+    return on and !whole and ranks and prompt and lanes == 0;
+}
+
+/// A fused group of `gm` rows: rank 0 selects for the first half of its blocks (rounded up), rank 1 for the rest; rows
+/// count from the group's first.
+pub fn halves(gm: usize, rank: usize) Halves {
+    const blocks = (gm + att_rows - 1) / att_rows;
+    const first = @min(gm, (blocks + 1) / 2 * att_rows);
+    const h: [2]split_sum.Rows = .{ .{ .r0 = 0, .n = first }, .{ .r0 = first, .n = gm - first } };
+    return .{ .own = h[rank], .peer = h[1 - rank] };
+}
+
+/// Whether `rank` selects for the block `r` rows into a group of `gm`.
+pub fn owns(gm: usize, rank: usize, r: usize) bool {
+    const o = halves(gm, rank).own;
+    return r >= o.r0 and r < o.r0 + o.n;
+}
+
+/// The selections at qids (idw a row), qnk and qspr (one a row): the own half's to the peer, the peer's into place.
+pub fn pieces(qids: u64, qnk: u64, qspr: u64, h: Halves) [3]Piece {
+    return .{ seq_par.rows(qids, idw, h, .i32), seq_par.rows(qnk, 1, h, .i32), seq_par.rows(qspr, 1, h, .i32) };
+}
+
+/// A group's selections, once this rank's half is selected: one exchange on the pass's stream.
+pub fn exchange(self: anytype, gm: usize) !void {
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    const s = self.s;
+    const p = pieces(s.qids, s.qnk, s.qspr, halves(gm, c.rank));
+    try c.at(.index_rows).exchange(self.stream, &p);
+}
+
+/// The bytes a rank sends in one attention layer of a prompt pass of `n` rows, groups of `group` rows.
+pub fn layerBytes(n: usize, group: usize, rank: usize) usize {
+    var sent: usize = 0;
+    var g0: usize = 0;
+    while (g0 < n) : (g0 += group) {
+        const gm = @min(group, n - g0);
+        for (pieces(0, 0, 0, halves(gm, rank))) |p| sent += coll.pieceBytes(p);
+    }
+    return sent;
+}
+
+test "index rows: a group's blocks split in halves, rank 0 taking the odd one, and the selections cross in place" {
+    const Case = struct { gm: usize, first: usize };
+    for ([_]Case{ .{ .gm = 1024, .first = 512 }, .{ .gm = 512, .first = 256 }, .{ .gm = 768, .first = 512 }, .{ .gm = 1000, .first = 512 }, .{ .gm = 256, .first = 256 }, .{ .gm = 100, .first = 100 } }) |k| {
+        const a = halves(k.gm, 0);
+        const b = halves(k.gm, 1);
+        try std.testing.expectEqual(split_sum.Rows{ .r0 = 0, .n = k.first }, a.own);
+        try std.testing.expectEqual(a.own, b.peer);
+        try std.testing.expectEqual(a.peer, b.own);
+        try std.testing.expectEqual(k.gm, a.own.n + a.peer.n);
+        if (a.peer.n != 0) try std.testing.expectEqual(@as(usize, 0), a.own.n % att_rows);
+        var r: usize = 0;
+        while (r < k.gm) : (r += att_rows) try std.testing.expect(owns(k.gm, 0, r) != owns(k.gm, 1, r));
+        for ([_]Halves{ a, b }) |h| {
+            const p = pieces(0x1000, 0x10_0000, 0x20_0000, h);
+            try std.testing.expectEqual(Piece{ .send = 0x1000 + h.own.r0 * idw * 4, .send_n = h.own.n * idw, .recv = 0x1000 + h.peer.r0 * idw * 4, .recv_n = h.peer.n * idw, .dtype = .i32 }, p[0]);
+            try std.testing.expectEqual(Piece{ .send = 0x10_0000 + h.own.r0 * 4, .send_n = h.own.n, .recv = 0x10_0000 + h.peer.r0 * 4, .recv_n = h.peer.n, .dtype = .i32 }, p[1]);
+            try std.testing.expectEqual(Piece{ .send = 0x20_0000 + h.own.r0 * 4, .send_n = h.own.n, .recv = 0x20_0000 + h.peer.r0 * 4, .recv_n = h.peer.n, .dtype = .i32 }, p[2]);
+        }
+    }
+    try std.testing.expect(takes(true, false, true, true, 0));
+    try std.testing.expect(!takes(false, false, true, true, 0) and !takes(true, false, false, true, 0) and !takes(true, false, true, false, 0) and !takes(true, false, true, true, 2));
+    try std.testing.expect(!takes(true, true, true, true, 0));
+}
+
+test "index rows: a 1536-row pass sends each rank's 768 rows' selections a layer, 6.3 MB" {
+    const fused_rows = @import("cuda_batch_state.zig").fused_rows;
+    for (0..2) |rank| try std.testing.expectEqual(@as(usize, 768 * (idw + 2) * 4), layerBytes(1536, fused_rows, rank));
+    try std.testing.expectEqual(@as(usize, 6_309_888), layerBytes(1536, fused_rows, 0));
+}
