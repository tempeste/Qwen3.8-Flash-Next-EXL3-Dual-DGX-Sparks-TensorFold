@@ -0,0 +1,292 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig_ = @import("flashnext_rig.zig");
+const lay = @import("flashnext_gdn_heads.zig");
+
+const Rig = rig_.Rig;
+const Heads = lay.Heads;
+const chunk = flash.gdn_chunk;
+
+const counts = [_]usize{ 1536, 768, 1000, 129, 65, 64, 63, 1 };
+const layers = 36;
+
+const Decay = enum { fast, slow };
+
+const Front = struct { qn: u64, kn: u64, v: u64, gb: u64, st: u64 };
+
+const Err = struct {
+    max: f64 = 0,
+    num: f64 = 0,
+    den: f64 = 0,
+    bad: usize = 0,
+
+    fn add(e: *Err, got: f32, want: f64) void {
+        if (!std.math.isFinite(got)) e.bad += 1;
+        const d = @abs(@as(f64, got) - want);
+        e.max = @max(e.max, d);
+        e.num += d * d;
+        e.den += want * want;
+    }
+
+    fn rel(e: Err) f64 {
+        return @sqrt(e.num / @max(e.den, 1e-300));
+    }
+};
+
+const Bound = struct { ys_rel: f64, ys_max: f64, st_rel: f64, st_max: f64 };
+const bound: Bound = .{ .ys_rel = 4e-3, .ys_max = 3e-2, .st_rel = 1e-4, .st_max = 2e-3 };
+
+fn inputs(r: *Rig, h: Heads, m: usize, decay: Decay) ![7]u64 {
+    const a_log = r.f32s(h.nv, -1, 1);
+    if (decay == .slow) for (a_log) |*x| {
+        x.* -= 6;
+    };
+    return .{
+        try r.dev(std.mem.sliceAsBytes(r.bfs(m * h.projWidth(), 1))),
+        try r.dev(std.mem.sliceAsBytes(r.bfs((lay.taps - 1) * h.convDim(), 1))),
+        try r.dev(std.mem.sliceAsBytes(r.bfs(h.convDim() * lay.taps, 0.5))),
+        try r.dev(std.mem.sliceAsBytes(a_log)),
+        try r.dev(std.mem.sliceAsBytes(r.f32s(h.nv, -1, 1))),
+        try r.dev(std.mem.sliceAsBytes(r.bfs(lay.dv, 1.5))),
+        try r.dev(std.mem.sliceAsBytes(r.f32s(h.nv * lay.dv * lay.dk, -0.5, 0.5))),
+    };
+}
+
+fn front(r: *Rig, f: *const lay.Fns, h: Heads, m: usize, in: [7]u64) !Front {
+    const o: Front = .{ .qn = try r.out(lay.bytes(.keys, 4, m, h)), .kn = try r.out(lay.bytes(.keys, 4, m, h)), .v = try r.out(lay.bytes(.values, 4, m, h)), .gb = try r.out(lay.bytes(.gb, 4, m, h)), .st = in[6] };
+    try lay.front(f.of(.front, h), r.s, h, m, in[0], in[1], in[2], in[3], in[4], o.qn, o.kn, o.v, o.gb);
+    return o;
+}
+
+fn reference(r: *Rig, h: Heads, m: usize, x: Front, ys: []f64, st: []f64) !void {
+    const q = try r.back(f32, x.qn, m * h.nk * lay.dk);
+    const k = try r.back(f32, x.kn, m * h.nk * lay.dk);
+    const v = try r.back(f32, x.v, m * h.nv * lay.dv);
+    const gb = try r.back(f32, x.gb, m * h.nv * 2);
+    const s0 = try r.back(f32, x.st, h.nv * lay.dv * lay.dk);
+    for (st, s0) |*d, w| d.* = w;
+    const ratio = h.nv / h.nk;
+    for (0..h.nv) |hv| {
+        const hk = hv / ratio;
+        const s = st[hv * lay.dv * lay.dk ..][0 .. lay.dv * lay.dk];
+        for (0..m) |t| {
+            const g: f64 = gb[(t * h.nv + hv) * 2];
+            const beta: f64 = gb[(t * h.nv + hv) * 2 + 1];
+            const kt = k[(t * h.nk + hk) * lay.dk ..][0..lay.dk];
+            const qt = q[(t * h.nk + hk) * lay.dk ..][0..lay.dk];
+            for (0..lay.dv) |row| {
+                const sr = s[row * lay.dk ..][0..lay.dk];
+                var kv: f64 = 0;
+                for (sr, kt) |*e, kk| {
+                    e.* *= g;
+                    kv += e.* * kk;
+                }
+                const delta = (@as(f64, v[t * h.nv * lay.dv + hv * lay.dv + row]) - kv) * beta;
+                var o: f64 = 0;
+                for (sr, kt, qt) |*e, kk, qq| {
+                    e.* += kk * delta;
+                    o += e.* * qq;
+                }
+                ys[(t * h.nv + hv) * lay.dv + row] = o;
+            }
+        }
+    }
+}
+
+fn measure(r: *Rig, ys_ptr: u64, st_ptr: u64, ys: []const f64, st: []const f64) !struct { Err, Err } {
+    var ey: Err = .{};
+    var es: Err = .{};
+    for (try r.back(f32, ys_ptr, ys.len), ys) |g, w| ey.add(g, w);
+    for (try r.back(f32, st_ptr, st.len), st) |g, w| es.add(g, w);
+    return .{ ey, es };
+}
+
+fn gate(what: []const u8, h: Heads, m: usize, decay: Decay, ey: Err, es: Err) !void {
+    std.debug.print("RESULT flashnext-gdn-chunk {s}, {s} heads, {d} rows, {s} decay: readouts max {e:.3} rel-L2 {e:.3}; state max {e:.3} rel-L2 {e:.3}\n", .{ what, if (h.eql(.full)) "full" else "_h8", m, @tagName(decay), ey.max, ey.rel(), es.max, es.rel() });
+    try check.expect(ey.bad == 0 and es.bad == 0, "flashnext-gdn-chunk {s}, {d} rows: {d} non-finite readouts, {d} non-finite state values", .{ what, m, ey.bad, es.bad });
+    try check.expect(ey.rel() <= bound.ys_rel and ey.max <= bound.ys_max, "flashnext-gdn-chunk {s}, {d} rows: readouts max {e} rel-L2 {e} past {e} / {e}", .{ what, m, ey.max, ey.rel(), bound.ys_max, bound.ys_rel });
+    try check.expect(es.rel() <= bound.st_rel and es.max <= bound.st_max, "flashnext-gdn-chunk {s}, {d} rows: state max {e} rel-L2 {e} past {e} / {e}", .{ what, m, es.max, es.rel(), bound.st_max, bound.st_rel });
+}
+
+fn compareTo(r: *Rig, what: []const u8, h: Heads, m: usize, decay: Decay, a_ys: u64, a_st: u64, b_ys: u64, b_st: u64) !void {
+    const ys = try r.back(f32, b_ys, m * h.valueDim());
+    const st = try r.back(f32, b_st, h.nv * lay.dv * lay.dk);
+    const ys64 = try r.a.alloc(f64, ys.len);
+    const st64 = try r.a.alloc(f64, st.len);
+    for (ys64, ys) |*d, x| d.* = x;
+    for (st64, st) |*d, x| d.* = x;
+    const e = try measure(r, a_ys, a_st, ys64, st64);
+    std.debug.print("RESULT flashnext-gdn-chunk {s}, {s} heads, {d} rows, {s} decay: readouts max {e:.3} rel-L2 {e:.3}; state max {e:.3} rel-L2 {e:.3}\n", .{ what, if (h.eql(.full)) "full" else "_h8", m, @tagName(decay), e[0].max, e[0].rel(), e[1].max, e[1].rel() });
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var prng = std.Random.DefaultPrng.init(3970);
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const f = try lay.Fns.load(batch);
+    const sets = [2]chunk.Fns{ try chunk.Fns.load(batch, ""), try chunk.Fns.load(batch, "_h8") };
+    var checks: usize = 0;
+    for ([_]Heads{ .full, .half }, &sets) |h, *c| {
+        for ([_]Decay{ .fast, .slow }) |decay| {
+            for (counts) |m| {
+                var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+                defer arena.deinit();
+                const a = arena.allocator();
+                var r = try Rig.init(gpu, a, prng.random());
+                defer r.deinit();
+                const x = try front(&r, &f, h, m, try inputs(&r, h, m, decay));
+                const ys = try a.alloc(f64, m * h.valueDim());
+                const st = try a.alloc(f64, h.nv * lay.dv * lay.dk);
+                try reference(&r, h, m, x, ys, st);
+                const vb = lay.bytes(.values, 4, m, h);
+                const sb = lay.bytes(.state, 4, m, h);
+                const t_ys = try r.out(vb);
+                const t_st = try r.out(sb);
+                try lay.chain(f.of(.tpr, h), r.s, .tpr, h, m, x.qn, x.kn, x.v, x.gb, x.st, t_st, t_ys);
+                const c_ys = try r.out(vb);
+                const c_st = try r.out(sb);
+                const wy = try r.out(@max(chunk.scratchBytes(m), 16));
+                try chunk.launch(c, r.s, h, m, x.qn, x.kn, x.v, x.gb, x.st, c_st, wy, c_ys);
+                const scan = try measure(&r, t_ys, t_st, ys, st);
+                std.debug.print("RESULT flashnext-gdn-chunk scan vs float64, {s} heads, {d} rows, {s} decay: readouts max {e:.3} rel-L2 {e:.3}; state max {e:.3} rel-L2 {e:.3}\n", .{ if (h.eql(.full)) "full" else "_h8", m, @tagName(decay), scan[0].max, scan[0].rel(), scan[1].max, scan[1].rel() });
+                const got = try measure(&r, c_ys, c_st, ys, st);
+                try gate("chunked vs float64", h, m, decay, got[0], got[1]);
+                try compareTo(&r, "chunked vs scan", h, m, decay, c_ys, c_st, t_ys, t_st);
+                checks += 1;
+                if (m < 2) continue;
+                const half_m = m / 2;
+                const s_ys = try r.out(vb);
+                const s_st = try r.dev(std.mem.sliceAsBytes(try r.back(f32, x.st, h.nv * lay.dv * lay.dk)));
+                const qk = half_m * h.nk * lay.dk * 4;
+                const vo = half_m * h.valueDim() * 4;
+                const go = half_m * h.nv * 2 * 4;
+                try chunk.launch(c, r.s, h, half_m, x.qn, x.kn, x.v, x.gb, s_st, s_st, wy, s_ys);
+                try chunk.launch(c, r.s, h, m - half_m, x.qn + qk, x.kn + qk, x.v + vo, x.gb + go, s_st, s_st, wy, s_ys + vo);
+                const split = try measure(&r, s_ys, s_st, ys, st);
+                try gate("chunked in two passes, state carried in place", h, m, decay, split[0], split[1]);
+                checks += 1;
+            }
+        }
+    }
+    check.pass("flashnext-gdn-chunk: {d} chunked chains (full and _h8 heads, fast and slow decay, 1 to 1,536 rows, odd tails, state carried in " ++
+        "and across passes) within readouts rel-L2 {e} max {e} and state rel-L2 {e} max {e} of a float64 scan", .{ checks, bound.ys_rel, bound.ys_max, bound.st_rel, bound.st_max });
+}
