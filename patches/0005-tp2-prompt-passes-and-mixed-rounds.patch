diff --git a/zig/src/core/prompt_cache_shared.zig b/zig/src/core/prompt_cache_shared.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6298a3cb3f142a9e16f9ab54e2b47f06a56e625e
--- /dev/null
+++ b/zig/src/core/prompt_cache_shared.zig
@@ -0,0 +1,22 @@
+//! Rules.shared_min: a new conversation sharing a long prefix with a kept prompt (an agent harness's instructions)
+//! keeps a state where they part, so every later conversation of its kind resumes there instead of at token 0.
+//! A hybrid family resumes only at a kept position, and the history, rewind and system-block marks all fall past
+//! the part when the prompts differ inside the system block, so without this mark nothing inside the prefix is kept.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const forks = @import("prompt_cache_fork.zig");
+
+/// Where `prompt`, resuming at `from`, keeps its shared-prefix state (0: none): the token before it parts from the
+/// kept prompt sharing the most, when they share at least shared_min, snapped to a chunk start for planned families,
+/// and min_gap past the resume point (a state there already serves it: one state a prefix, not one a prompt).
+pub fn mark(s: *const pc.Store, prompt: []const u32, from: u32, starts: []const u32) u32 {
+    const min = s.rules.shared_min;
+    if (min == 0 or prompt.len <= min) return 0;
+    const kept = forks.longestShared(pc.Entry, s.entries.items, prompt);
+    const part = std.mem.indexOfDiff(u32, kept, prompt) orelse @min(kept.len, prompt.len);
+    if (part < min) return 0;
+    const raw: u32 = @intCast(part -| s.rules.lookahead); // a state at `at` is keyed with the token at `at`
+    const at = if (s.rules.planned) s.startAt(starts, raw) else raw;
+    if (at <= from or at - from < s.rules.min_gap or at >= prompt.len or at + s.rules.lookahead > prompt.len or !s.usable(at, starts)) return 0;
+    return at;
+}
diff --git a/zig/src/core/prompt_cache_shared_test.zig b/zig/src/core/prompt_cache_shared_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..22efa7f6eccc49e211147f73b51d2acb70fc3c82
--- /dev/null
+++ b/zig/src/core/prompt_cache_shared_test.zig
@@ -0,0 +1,112 @@
+//! Rules.shared_min: new conversations sharing an agent harness's long instructions resume where they part.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const fake = @import("prompt_cache_test.zig");
+const Fake = fake.Fake;
+const fresh = fake.fresh;
+const Store = pc.Store;
+
+const harness = 10_000; // the instructions every conversation shares, its own text after them
+const system_len = 13_000; // the system block ends past the part: its shared cuts serve no other conversation
+const rewind_len = 13_010; // the first user message starts past it too
+const len = 25_000;
+const history = len - 3; // the user message's end, then the generation prompt
+
+/// Conversation `k`'s first turn: the harness, then `same` tokens of `like`'s own text, then its own.
+fn flight(a: std.mem.Allocator, k: u32, like: u32, same: u32) ![]u32 {
+    const p = try a.alloc(u32, len);
+    for (p, 0..) |*t, i| t.* = if (i < harness) @intCast(i + 1) else if (i < harness + same) like * 100_000 + @as(u32, @intCast(i)) else k * 100_000 + @as(u32, @intCast(i));
+    return p;
+}
+
+/// The cuts chat.zig names for the system block.
+const shared_cuts = [_]u32{ system_len - 2048, system_len - 512, system_len };
+
+/// The served Flash Next rules (cuda_snaps.passRules): any row, lookahead 1, no fork rule.
+fn rules(shared_min: u32) pc.Rules {
+    return .{ .lookahead = 1, .min_prompt = 0, .chunk = 2048, .chunk_starts = false, .repeat_min = 16, .shared_min = shared_min };
+}
+
+fn run(s: *Store, f: *Fake, a: std.mem.Allocator, prompt: []const u32) !pc.Plan {
+    const p = try s.beginRewind(a, prompt, history, rewind_len, &shared_cuts, &.{}, null, &.{});
+    try std.testing.expectEqual(fresh(prompt), f.pass(s, prompt, p));
+    return p;
+}
+
+fn statesBefore(s: *const Store, at: u32) usize {
+    var n: usize = 0;
+    for (s.entries.items) |e| n += @intFromBool(!e.expired and e.at < at);
+    return n;
+}
+
+test "prompt cache shared: the second conversation keeps a state where it parts, every later one resumes it, one state over many" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), rules(4096), 1 << 30);
+    defer s.deinit();
+
+    var p = try run(&s, &f, a, try flight(a, 1, 1, 0));
+    try std.testing.expectEqual(@as(u32, 0), p.from);
+    try std.testing.expectEqual(@as(usize, 0), statesBefore(&s, harness)); // nothing kept shares a prefix yet
+
+    // A miss: it parts from the first at the harness's end, half the history away, and keeps the token before it.
+    p = try run(&s, &f, a, try flight(a, 2, 2, 0));
+    try std.testing.expectEqual(@as(u32, 0), p.from);
+    try std.testing.expect(std.mem.indexOfScalar(u32, p.marks, harness - 1) != null);
+    try std.testing.expectEqual(@as(usize, 1), statesBefore(&s, harness));
+    const kept = for (s.entries.items) |e| {
+        if (e.at == harness - 1) break e;
+    } else unreachable;
+    try std.testing.expect(kept.shared); // other conversations resume it: never superseded by its own
+
+    // Every later conversation resumes it; one sharing 100 tokens more with the last keeps none under min_gap past it.
+    const hits = s.counts.hits;
+    for (3..11) |k| {
+        const like: u32 = if (k == 6) @intCast(k - 1) else @intCast(k);
+        p = try run(&s, &f, a, try flight(a, @intCast(k), like, if (k == 6) 100 else 0));
+        try std.testing.expectEqual(@as(u32, harness - 1), p.from);
+        try std.testing.expectEqual(@as(usize, 1), statesBefore(&s, harness + 256));
+    }
+    try std.testing.expectEqual(hits + 8, s.counts.hits);
+}
+
+test "prompt cache shared: off, or a shared prefix under the threshold, keeps what it kept before" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]u32{ 0, harness + 1 }) |min| {
+        var f: Fake = .{ .gpa = gpa };
+        var s = Store.init(gpa, f.snapshots(), rules(min), 1 << 30);
+        defer s.deinit();
+        var old_f: Fake = .{ .gpa = gpa };
+        var old = Store.init(gpa, old_f.snapshots(), rules(0), 1 << 30);
+        defer old.deinit();
+        for (1..6) |k| {
+            const prompt = try flight(a, @intCast(k), @intCast(k), 0);
+            const p = try run(&s, &f, a, prompt);
+            try std.testing.expectEqual(@as(u32, 0), p.from);
+            try std.testing.expectEqualSlices(u32, (try run(&old, &old_f, a, prompt)).marks, p.marks);
+        }
+        try std.testing.expectEqual(@as(usize, 0), statesBefore(&s, harness));
+        try std.testing.expectEqual(@as(u64, 0), s.counts.hits);
+    }
+}
+
+test "prompt cache shared: a planned family keeps it at the chunk start before the part" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .lookahead = 1, .planned = true, .grid = 2048, .min_prompt = 0, .shared_min = 4096 }, 1 << 30);
+    defer s.deinit();
+    _ = try run(&s, &f, a, try flight(a, 1, 1, 0));
+    var p = try run(&s, &f, a, try flight(a, 2, 2, 0));
+    try std.testing.expect(std.mem.indexOfScalar(u32, p.marks, 8192) != null); // 9,999 floored to the grid
+    p = try run(&s, &f, a, try flight(a, 3, 3, 0));
+    try std.testing.expectEqual(@as(u32, 8192), p.from);
+}
