         std.debug.print("RESULT hc-fuse rows {d}: chain base {d:.1} us, new best {d:.1} us\n", .{ m, nm + bd + ra + bu + bm, best_d + ra + best_u });
     }
     for ([_]usize{ 48, 96, 144 }) |ctas| {
-        const us = try timeOf(&c, start, end, Chain.peak, ctas);
+        const us = try timeOf(c, start, end, Chain.peak, ctas);
         const flops = @as(f64, @floatFromInt(ctas)) * 8 * 4000 * 12 * 4096;
         std.debug.print("RESULT hc-fuse mma ceiling: {d} CTAs x 8 warps: {d:.1} us = {d:.1} TF\n", .{ ctas, us, flops / us / 1e6 });
     }
     r.report("hc-fuse");
 }
+
+fn wideTiles(gpu: check.Gpu, c: *Chain) !void {
+    const r = c.r;
+    const most = c.rows;
+    const Case = struct { r0: usize, m: usize };
+    const cases = [_]Case{ .{ .r0 = 0, .m = 1536 }, .{ .r0 = 0, .m = 768 }, .{ .r0 = 768, .m = 768 }, .{ .r0 = 0, .m = 3072 }, .{ .r0 = 0, .m = 65 }, .{ .r0 = 0, .m = 1000 }, .{ .r0 = 1019, .m = 2053 } };
+    for (cases) |k| {
+        var s = c.shifted(k.r0, k.m);
+        const want = try chainOuts(&s);
+        for (0..tk.hcn_down_mt.len) |di| for (0..tk.hcn_up_mt.len) |ui| try (try hcnOuts(&s, di, ui)).same(want);
+        for (0..tk.hcn_dw_mt.len) |di| for (0..tk.hcn_uw_mt.len) |ui| {
+            try (try wideOuts(&s, di, ui, null)).same(want);
+            try (try wideOuts(&s, di, ui, 7)).same(want);
+        };
+        check.pass("hc-wide: rows [{d}, {d}): wide down tiles {d} x wide up tiles {d} (engine grid and 7 CTAs) = hcn tiles = the five-launch chain, every output byte", .{ k.r0, k.r0 + k.m, tk.hcn_dw_mt.len, tk.hcn_uw_mt.len });
+    }
+
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(gpu.d, true);
+    defer end.deinit();
+    for ([_]usize{ most, 1536, 768 }) |m| {
+        c.rows = m;
+        const h_bytes = @as(f64, @floatFromInt(m * wide * 2));
+        var old_d: f64 = 1e18;
+        var old_u: f64 = 1e18;
+        var new_d: f64 = 1e18;
+        var new_u: f64 = 1e18;
+        for (0..tk.hcn_down_mt.len) |di| {
+            const us = try timeOf(c, start, end, Chain.newDown, di);
+            old_d = @min(old_d, us);
+            std.debug.print("RESULT hc-wide rows {d}: {s}: {d:.1} us ({d:.0} GB/s of streams)\n", .{ m, tk.hcn_down_names[di], us, h_bytes / us / 1e3 });
+        }
+        for (0..tk.hcn_dw_mt.len) |di| {
+            const us = try timeOf(c, start, end, Chain.wideDown, di);
+            new_d = @min(new_d, us);
+            std.debug.print("RESULT hc-wide rows {d}: {s}: {d:.1} us ({d:.0} GB/s of streams)\n", .{ m, tk.hcn_dw_names[di], us, h_bytes / us / 1e3 });
+        }
+        for (0..tk.hcn_up_mt.len) |ui| {
+            const us = try timeOf(c, start, end, Chain.newUp, ui);
+            old_u = @min(old_u, us);
+            std.debug.print("RESULT hc-wide rows {d}: {s}: {d:.1} us ({d:.0} GB/s of streams)\n", .{ m, tk.hcn_up_names[ui], us, h_bytes / us / 1e3 });
+        }
+        for (0..tk.hcn_uw_mt.len) |ui| {
+            const us = try timeOf(c, start, end, Chain.wideUp, ui);
+            new_u = @min(new_u, us);
+            std.debug.print("RESULT hc-wide rows {d}: {s} ({d} CTAs): {d:.1} us ({d:.0} GB/s of streams)\n", .{ m, tk.hcn_uw_names[ui], c.t.hcn_uw_blocks[ui], us, h_bytes / us / 1e3 });
+        }
+        std.debug.print("RESULT hc-wide rows {d}: best down {d:.1} -> {d:.1} us, best up+mix {d:.1} -> {d:.1} us, saved {d:.1} us a read-out\n", .{ m, old_d, new_d, old_u, new_u, old_d + old_u - new_d - new_u });
+    }
+    r.report("hc-wide");
+}
diff --git a/zig/tests/cuda/flashnext_index_mma_tests.zig b/zig/tests/cuda/flashnext_index_mma_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f7c55e8d455b12492aef5f05f525e60875d38ab9
--- /dev/null
+++ b/zig/tests/cuda/flashnext_index_mma_tests.zig
@@ -0,0 +1,360 @@
+//! TF_FLASHNEXT_INDEX_MMA's selection (fn_qsa_mma_*) against fn_qsa_scores and fn_qsa_select on prompt shapes: each
+//! row's block overlap, near ties only where they differ, and the fused attention over either selection.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const Rig = rig.Rig;
+const bf = rig.bf;
+const bs = flash.batch_state;
+
+const q_heads = 24;
+const kv_heads = 2;
+const head_dim = 256;
+const index_heads = 4;
+const index_dim = 128;
+const ratio = 4;
+const top = 512;
+const idw = 2052;
+const att_rows = bs.att_rows;
+const fused_rows = bs.fused_rows;
+const attn_layers = 12;
+
+fn cdiv(a: usize, b: usize) usize {
+    return (a + b - 1) / b;
+}
+
+const Fill = enum { random, relu_ties };
+
+const Case = struct {
+    rows: usize,
+    ctx: usize,
+    fill: Fill = .random,
+};
+
+const Shape = struct {
+    rows: usize,
+    cap: usize,
+    pos0: usize,
+    nb: usize,
+    pooled: []u16,
+    iq: []u16,
+    dpooled: u64,
+    diq: u64,
+    dpos: u64,
+
+    fn init(r: *Rig, c: Case) !Shape {
+        const cap = c.ctx;
+        const pos0 = c.ctx - c.rows;
+        const nblk = cap / ratio;
+        var sh: Shape = .{ .rows = c.rows, .cap = cap, .pos0 = pos0, .nb = bs.scoreStride(cap), .pooled = undefined, .iq = undefined, .dpooled = 0, .diq = 0, .dpos = 0 };
+        switch (c.fill) {
+            .random => {
+                sh.pooled = r.bfs(nblk * index_dim, 1);
+                sh.iq = r.bfs(c.rows * index_heads * index_dim, 1);
+            },
+            .relu_ties => {
+                sh.pooled = r.a.alloc(u16, nblk * index_dim) catch unreachable;
+                for (0..nblk) |b| {
+                    const lifted = b % 53 == 7;
+                    for (0..index_dim) |d| {
+                        const v = 0.125 + r.rng.float(f32) * 0.875;
+                        sh.pooled[b * index_dim + d] = rig.bf16(if (lifted) -v else v);
+                    }
+                }
+                sh.iq = r.a.alloc(u16, c.rows * index_heads * index_dim) catch unreachable;
+                for (sh.iq) |*x| x.* = rig.bf16(-(0.125 + r.rng.float(f32) * 0.875));
+            },
+        }
+        sh.dpooled = try r.dev(std.mem.sliceAsBytes(sh.pooled));
+        sh.diq = try r.dev(std.mem.sliceAsBytes(sh.iq));
+        const pos = try r.a.alloc(i32, 4 * cdiv(c.rows, att_rows));
+        @memset(pos, 0);
+        for (0..pos.len / 4) |i| pos[4 * i] = @intCast(pos0 + i * att_rows);
+        sh.dpos = try r.dev(std.mem.sliceAsBytes(pos));
+        return sh;
+    }
+
+    fn blocks(sh: Shape, r0: usize, m: usize) usize {
+        const ends = sh.pos0 + r0 + m;
+        return if (ends / ratio > top) @min(sh.nb, cdiv(ends, ratio)) else 0;
+    }
+};
+
+const Sel = struct { ids: u64, nk: u64, spr: u64 };
+
+fn selection(r: *Rig, rows: usize) !Sel {
+    return .{ .ids = try r.out(rows * idw * 4), .nk = try r.out(rows * 4), .spr = try r.out(rows * 4) };
+}
+
+fn reference(r: *Rig, g: *const flash.Glue, select: cuda.Function, sh: Shape, sc: u64, o: Sel) !void {
+    var r0: usize = 0;
+    while (r0 < sh.rows) : (r0 += att_rows) {
+        const m = @min(att_rows, sh.rows - r0);
+        const pos = sh.dpos + (r0 / att_rows) * 16;
+        const at = sc + r0 * sh.nb * 4;
+        const blocks = sh.blocks(r0, m);
+        if (blocks > 0) try g.qsaScores(r.s, sh.diq + r0 * index_heads * index_dim * 2, sh.dpooled, pos, at, sh.nb, m, blocks, .{});
+        var a: cuda.Args = .{};
+        a.add(at);
+        a.add(pos);
+        a.add(o.ids + r0 * idw * 4);
+        a.add(o.nk + r0 * 4);
+        a.add(o.spr + r0 * 4);
+        inline for (.{ sh.nb, idw, top, ratio }) |v| a.add(@as(c_int, @intCast(v)));
+        try cuda.launch.launch(select, .{ .grid = .{ .x = @intCast(m) }, .block = .{ .x = 1024 } }, r.s, &a);
+    }
+}
+
+fn mma(r: *Rig, g: *const flash.Glue, sh: Shape, work: u64, o: Sel) !void {
+    var r0: usize = 0;
+    while (r0 < sh.rows) : (r0 += att_rows) {
+        const m = @min(att_rows, sh.rows - r0);
+        try g.qsaSelectMma(r.s, sh.diq + r0 * index_heads * index_dim * 2, sh.dpooled, sh.dpos + (r0 / att_rows) * 16, work, o.ids + r0 * idw * 4, o.nk + r0 * 4, o.spr + r0 * 4, sh.nb, m, sh.blocks(r0, m), .{});
+    }
+}
+
+fn attend(r: *Rig, g: *const flash.Glue, sh: Shape, q: u64, kc: u64, vc: u64, o: Sel, out: u64) !void {
+    var g0: usize = 0;
+    while (g0 < sh.rows) : (g0 += fused_rows) {
+        const gm = @min(fused_rows, sh.rows - g0);
+        try g.attnFused(r.s, q + g0 * q_heads * head_dim * 2, kc, vc, sh.dpos + (g0 / att_rows) * 16, out + g0 * q_heads * head_dim * 2, o.ids + g0 * idw * 4, o.nk + g0 * 4, o.spr + g0 * 4, gm, .full, .{});
+    }
+}
+
+/// Row `row`'s block `b` score as fn_qsa_scores defines it, in float64, and the sum of its terms' magnitudes.
+fn score(sh: Shape, row: usize, b: usize) [2]f64 {
+    var total: f64 = 0;
+    var abs: f64 = 0;
+    for (0..index_heads) |h| {
+        var dot: f64 = 0;
+        for (0..index_dim) |d| {
+            const t = bf(sh.iq[(row * index_heads + h) * index_dim + d]) * bf(sh.pooled[b * index_dim + d]);
+            dot += t;
+            abs += @abs(t);
+        }
+        total += @max(dot, 0);
+    }
+    const s = @sqrt(@as(f64, index_dim));
+    return .{ total / s, abs / s };
+}
+
+fn greater(_: void, a: f32, b: f32) bool {
+    return a > b;
+}
+
+const Overlap = struct { min: f64 = 1, sum: f64 = 0, sparse: usize = 0, differ: usize = 0, swapped: usize = 0, worst_gap: f64 = 0 };
+
+/// Each sparse row's chosen blocks under both selections: Jaccard overlap, and every block one has and the other lacks
+/// within the sums' error of the reference's cut score.
+fn compare(r: *Rig, sh: Shape, ref_sel: Sel, got_sel: Sel, sc: u64) !Overlap {
+    const rows = sh.rows;
+    const want_ids = try r.back(i32, ref_sel.ids, rows * idw);
+    const got_ids = try r.back(i32, got_sel.ids, rows * idw);
+    const want_nk = try r.back(i32, ref_sel.nk, rows);
+    const got_nk = try r.back(i32, got_sel.nk, rows);
+    const want_spr = try r.back(i32, ref_sel.spr, rows);
+    const got_spr = try r.back(i32, got_sel.spr, rows);
+    var ov: Overlap = .{};
+    var sorted: []f32 = &.{};
+    for (0..rows) |row| {
+        try check.expect(want_nk[row] == got_nk[row] and want_spr[row] == got_spr[row], "index mma: row {d} counts {d}/{d}, sparse {d}/{d}", .{ row, got_nk[row], want_nk[row], got_spr[row], want_spr[row] });
+        if (want_spr[row] == 0) continue;
+        const end = sh.pos0 + row + 1;
+        const complete = end / ratio;
+        const w = want_ids[row * idw ..][0..idw];
+        const o = got_ids[row * idw ..][0..idw];
+        for (top * ratio..@as(usize, @intCast(want_nk[row]))) |i| try check.expect(w[i] == o[i], "index mma: row {d} tail key {d}", .{ row, i });
+        var prev: i32 = -1;
+        for (0..top) |i| {
+            const b = @divFloor(o[i * ratio], ratio);
+            try check.expect(b > prev and b < @as(i32, @intCast(complete)), "index mma: row {d} block {d} ({d}) out of order or past {d}", .{ row, i, b, complete });
+            for (0..ratio) |j| try check.expect(o[i * ratio + j] == b * ratio + @as(i32, @intCast(j)), "index mma: row {d} block {d} keys", .{ row, i });
+            prev = b;
+        }
+        var i: usize = 0;
+        var k: usize = 0;
+        var both: usize = 0;
+        while (i < top and k < top) {
+            const a = w[i * ratio];
+            const b = o[k * ratio];
+            if (a == b) {
+                both += 1;
+                i += 1;
+                k += 1;
+            } else if (a < b) i += 1 else k += 1;
+        }
+        const jac = @as(f64, @floatFromInt(both)) / @as(f64, @floatFromInt(2 * top - both));
+        ov.sparse += 1;
+        ov.sum += jac;
+        ov.min = @min(ov.min, jac);
+        if (both == top) continue;
+        ov.differ += 1;
+        ov.swapped += top - both;
+        if (sorted.len < complete) sorted = try r.a.alloc(f32, complete);
+        const row_sc = try r.back(f32, sc + row * sh.nb * 4, complete);
+        @memcpy(sorted[0..complete], row_sc);
+        std.mem.sortUnstable(f32, sorted[0..complete], {}, greater);
+        const cut: f64 = sorted[top - 1];
+        var cut_abs: f64 = 0;
+        for (0..complete) |b| if (row_sc[b] == sorted[top - 1]) {
+            cut_abs = score(sh, row, b)[1];
+            break;
+        };
+        for ([_][]const i32{ w, o }) |list| for (0..top) |n| {
+            const b: usize = @intCast(@divFloor(list[n * ratio], ratio));
+            if (inList(w, b) and inList(o, b)) continue;
+            const s = score(sh, row, b);
+            const gap = @abs(s[0] - cut);
+            const tol = (s[1] + cut_abs) * 0x1p-14;
+            ov.worst_gap = @max(ov.worst_gap, gap / tol);
+            try check.expect(gap <= tol, "index mma: row {d} block {d} chosen by one side only, score {d} vs cut {d} (tolerance {d})", .{ row, b, s[0], cut, tol });
+        };
+    }
+    return ov;
+}
+
+fn inList(list: []const i32, b: usize) bool {
+    var lo: usize = 0;
+    var hi: usize = top;
+    const want: i32 = @intCast(b * ratio);
+    while (lo < hi) {
+        const mid = (lo + hi) / 2;
+        if (list[mid * ratio] < want) lo = mid + 1 else hi = mid;
+    }
+    return lo < top and list[lo * ratio] == want;
+}
+
+const Error = struct { max_abs: f64 = 0, max_ref: f64 = 0, sum_abs: f64 = 0, n: usize = 0, rows_differ: usize = 0 };
+
+fn outputError(r: *Rig, rows: usize, want: u64, got: u64) !Error {
+    const per = q_heads * head_dim;
+    const w = try r.back(u16, want, rows * per);
+    const o = try r.back(u16, got, rows * per);
+    var e: Error = .{};
+    for (0..rows) |row| {
+        var differs = false;
+        for (0..per) |i| {
+            const a = bf(w[row * per + i]);
+            const b = bf(o[row * per + i]);
+            try check.expect(!std.math.isNan(b), "index mma attention: row {d} element {d} is NaN", .{ row, i });
+            const d = @abs(a - b);
+            differs = differs or d != 0;
+            e.max_abs = @max(e.max_abs, d);
+            e.max_ref = @max(e.max_ref, @abs(a));
+            e.sum_abs += d;
+            e.n += 1;
+        }
+        if (differs) e.rows_differ += 1;
+    }
+    return e;
+}
+
+fn one(gpu: check.Gpu, g: *const flash.Glue, select: cuda.Function, c: Case, seed: u64) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(seed);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    const sh = try Shape.init(&r, c);
+    const sc = try r.out(sh.rows * sh.nb * 4);
+    const work = try r.out(bs.mmaBytes(sh.cap, att_rows));
+    const want = try selection(&r, sh.rows);
+    const got = try selection(&r, sh.rows);
+    const again = try selection(&r, sh.rows);
+    try reference(&r, g, select, sh, sc, want);
+    try mma(&r, g, sh, work, got);
+    try mma(&r, g, sh, work, again);
+    try r.sameRows("index mma: a second run", i32, again.ids, try r.back(i32, got.ids, sh.rows * idw));
+    const ov = try compare(&r, sh, want, got, sc);
+    if (c.fill == .relu_ties) try check.expect(ov.differ == 0, "index mma relu ties: {d} rows differ, ties must break to the lowest block", .{ov.differ});
+    const mean = if (ov.sparse == 0) 1 else ov.sum / @as(f64, @floatFromInt(ov.sparse));
+    try check.expect(ov.min >= 0.95 and mean >= 0.995, "index mma: Jaccard min {d:.4} mean {d:.5}", .{ ov.min, mean });
+    const q = try r.dev(std.mem.sliceAsBytes(r.bfs(sh.rows * q_heads * head_dim, 1)));
+    const kc = try r.dev(std.mem.sliceAsBytes(r.bfs(sh.cap * kv_heads * head_dim, 1)));
+    const vc = try r.dev(std.mem.sliceAsBytes(r.bfs(sh.cap * kv_heads * head_dim, 1)));
+    const ow = try r.out(sh.rows * q_heads * head_dim * 2);
+    const og = try r.out(sh.rows * q_heads * head_dim * 2);
+    try attend(&r, g, sh, q, kc, vc, want, ow);
+    try attend(&r, g, sh, q, kc, vc, got, og);
+    const e = try outputError(&r, sh.rows, ow, og);
+    try check.expect(e.rows_differ <= ov.differ, "index mma attention: {d} rows' outputs differ, only {d} rows' selections do", .{ e.rows_differ, ov.differ });
+    std.debug.print("RESULT index-mma {s} rows={d} ctx={d}: sparse rows {d}, Jaccard min {d:.4} mean {d:.6}, rows differing {d} ({d} blocks swapped, worst gap {d:.3} tolerances); attention max |d| {d:.5} (max |ref| {d:.3}, rel {e:.3}), mean |d| {e:.3}, rows differing {d}\n", .{ @tagName(c.fill), c.rows, c.ctx, ov.sparse, ov.min, mean, ov.differ, ov.swapped, ov.worst_gap, e.max_abs, e.max_ref, e.max_abs / @max(e.max_ref, 1e-30), e.sum_abs / @as(f64, @floatFromInt(@max(e.n, 1))), e.rows_differ });
+}
+
+const cases = [_]Case{
+    .{ .rows = 1536, .ctx = 8192 },
+    .{ .rows = 768, .ctx = 8192 },
+    .{ .rows = 1536, .ctx = 61440 },
+    .{ .rows = 768, .ctx = 61440 },
+    .{ .rows = 1536, .ctx = 102400 },
+    .{ .rows = 768, .ctx = 102400 },
+    .{ .rows = 1536, .ctx = 8192, .fill = .relu_ties },
+    .{ .rows = 768, .ctx = 4096, .fill = .relu_ties },
+};
+
+/// Every case, or `rows ctx` alone.
+pub fn run(gpu: check.Gpu, args: []const [:0]const u8) !void {
+    var g = try flash.Glue.load(gpu.d);
+    defer g.deinit();
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const select = try batch.function("fn_qsa_select");
+    if (args.len >= 2) {
+        const c: Case = .{ .rows = try std.fmt.parseInt(usize, args[0], 10), .ctx = try std.fmt.parseInt(usize, args[1], 10) };
+        try valid(c);
+        try one(gpu, &g, select, c, 61);
+    } else for (cases, 0..) |c, i| try one(gpu, &g, select, c, 61 + i);
+    check.pass("flashnext-index-mma: counts, sparse flags and tails equal, blocks one side only near the cut, attention differs only where selection does", .{});
+}
+
+fn valid(c: Case) !void {
+    if (c.rows == 0 or c.ctx % 16 != 0 or c.ctx < c.rows) return error.BadShape;
+}
+
+/// Median ms of `rows` rows' selection at context `ctx`, fn_qsa_scores and fn_qsa_select against fn_qsa_mma_*: a layer,
+/// and a chunk's 12 attention layers.
+pub fn bench(gpu: check.Gpu, args: []const [:0]const u8) !void {
+    const c: Case = .{ .rows = try std.fmt.parseInt(usize, if (args.len > 0) args[0] else "1536", 10), .ctx = try std.fmt.parseInt(usize, if (args.len > 1) args[1] else "61440", 10) };
+    try valid(c);
+    const reps = try std.fmt.parseInt(usize, if (args.len > 2) args[2] else "20", 10);
+    var g = try flash.Glue.load(gpu.d);
+    defer g.deinit();
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const select = try batch.function("fn_qsa_select");
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(67);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    const sh = try Shape.init(&r, c);
+    const sc = try r.out(@min(sh.rows, att_rows) * sh.nb * 4);
+    const work = try r.out(bs.mmaBytes(sh.cap, att_rows));
+    const o = try selection(&r, sh.rows);
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(gpu.d, true);
+    defer end.deinit();
+    const t = try r.a.alloc(f64, reps);
+    var ms: [2]f64 = undefined;
+    for (0..2) |path| {
+        for (0..reps + 2) |rep| {
+            try start.record(r.s);
+            var r0: usize = 0;
+            while (r0 < sh.rows) : (r0 += att_rows) {
+                const m = @min(att_rows, sh.rows - r0);
+                const part: Shape = .{ .rows = m, .cap = sh.cap, .pos0 = sh.pos0 + r0, .nb = sh.nb, .pooled = sh.pooled, .iq = sh.iq, .dpooled = sh.dpooled, .diq = sh.diq + r0 * index_heads * index_dim * 2, .dpos = sh.dpos + (r0 / att_rows) * 16 };
+                const sel: Sel = .{ .ids = o.ids + r0 * idw * 4, .nk = o.nk + r0 * 4, .spr = o.spr + r0 * 4 };
+                if (path == 0) try reference(&r, &g, select, part, sc, sel) else try mma(&r, &g, part, work, sel);
+            }
+            try end.record(r.s);
+            try r.s.synchronize();
+            if (rep >= 2) t[rep - 2] = try start.elapsedMs(end);
+        }
+        ms[path] = check.median(t);
+    }
+    std.debug.print("RESULT index-mma-bench rows={d} ctx={d} reps={d}: scores+select {d:.3} ms/layer ({d:.2} ms/chunk), mma {d:.3} ms/layer ({d:.2} ms/chunk), saves {d:.2} ms/chunk\n", .{ c.rows, c.ctx, reps, ms[0], ms[0] * attn_layers, ms[1], ms[1] * attn_layers, (ms[0] - ms[1]) * attn_layers });
+}
diff --git a/zig/tests/cuda/flashnext_mixed_rank_tests.zig b/zig/tests/cuda/flashnext_mixed_rank_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ba0a13b02c5c5d96c7cab3db58f7d79c3ae351c8
--- /dev/null
+++ b/zig/tests/cuda/flashnext_mixed_rank_tests.zig
@@ -0,0 +1,181 @@
+//! TF_FLASHNEXT_MIXED_ROUNDS at --tp 2: a prompt piece and drafted windows in one mixed round leave the same bytes as
+//! the piece's own pass then the windows' shared verify: every window row's scores, the piece's hidden streams, the
+//! prompt's last row after its rest, and each window's next row after a partial keep (its rollback from the round
+//! scratch). Two shapes: few windows (a round under the prompt tiles' rows alone) and many (over them).
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const env = @import("sys").env;
+
+const context = 4096;
+const window_rows = 3;
+const max_windows = 24;
+
+const Record = struct {
+    rows: []u8,
+    streams: []u8,
+    last: []u8,
+    next: []u8,
+
+    fn init(a: std.mem.Allocator, nd: usize, np: usize, windows: usize) !Record {
+        const row = prompt.vocabulary * 2;
+        return .{ .rows = try a.alloc(u8, nd * row), .streams = try a.alloc(u8, np * prompt.hidden_wide * 2), .last = try a.alloc(u8, row), .next = try a.alloc(u8, windows * row) };
+    }
+
+    fn deinit(r: Record, a: std.mem.Allocator) void {
+        a.free(r.rows);
+        a.free(r.streams);
+        a.free(r.last);
+        a.free(r.next);
+    }
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    const chunk_env = std.c.getenv("TF_FLASHNEXT_CHUNK") orelse return error.RankIdentity;
+    const chunk = try std.fmt.parseInt(usize, std.mem.span(chunk_env), 10);
+    if (chunk < 512) return error.RankIdentity;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    // TF_FLASHNEXT_TP_ROCE=1 (as a served pair runs): the fitting sums and gathers by RoCE, as a served engine opens it at load
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, max_windows * window_rows * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed mixed and separate rounds", .{});
+        return;
+    }
+    const prompt_len = chunk + 300;
+    const ids = try gpu.gpa.alloc(u32, prompt_len);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    const want = if (std.c.getenv("TF_FLASHNEXT_MIXED_ROWS")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else chunk;
+    if (want < 64) return error.BadPrompt;
+    for ([_]usize{ 4, max_windows }) |windows| {
+        const nd = windows * window_rows;
+        const np = @min(want, (chunk - nd) / 64 * 64);
+        const solo = try Record.init(gpu.gpa, nd, np, windows);
+        defer solo.deinit(gpu.gpa);
+        const joint = try Record.init(gpu.gpa, nd, np, windows);
+        defer joint.deinit(gpu.gpa);
+        try arm(gpu, session, tri, e, &stream, seed.items, ids, np, windows, logits.ptr, false, solo);
+        try arm(gpu, session, tri, e, &stream, seed.items, ids, np, windows, logits.ptr, true, joint);
+        if (!std.mem.eql(u8, joint.rows, solo.rows)) distance(joint.rows, solo.rows);
+        try check.sameBytes("each window row's scores in a mixed round equal the shared verify's", joint.rows, solo.rows);
+        try check.sameBytes("the piece's hidden streams in a mixed round equal its own pass's", joint.streams, solo.streams);
+        try check.sameBytes("the prompt's last row after a mixed piece equals it after the piece alone", joint.last, solo.last);
+        try check.sameBytes("each window's next row after a partial keep equals the separate round's", joint.next, solo.next);
+        check.pass("two-rank mixed round: {d} prompt rows beside {d} windows of {d} rows, every compared byte equal", .{ np, windows, window_rows });
+    }
+}
+
+/// How far the window rows' bf16 scores moved: rows whose argmax holds, and the largest score change.
+fn distance(got: []const u8, want: []const u8) void {
+    const row = prompt.vocabulary;
+    const g = std.mem.bytesAsSlice(u16, got);
+    const w = std.mem.bytesAsSlice(u16, want);
+    var same: usize = 0;
+    var worst: f32 = 0;
+    for (0..g.len / row) |r| {
+        var bg: usize = 0;
+        var bw: usize = 0;
+        for (0..row) |i| {
+            const x = bf16(g[r * row + i]);
+            const y = bf16(w[r * row + i]);
+            worst = @max(worst, @abs(x - y));
+            if (x > bf16(g[r * row + bg])) bg = i;
+            if (y > bf16(w[r * row + bw])) bw = i;
+        }
+        same += @intFromBool(bg == bw);
+    }
+    std.debug.print("mixed window rows: argmax held on {d}/{d} rows, max |score change| {d:.5}\n", .{ same, g.len / row, worst });
+}
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+/// One arm: `windows` prefilled streams draft a window each; the prompt's first `np` rows run in the round (`mixed`) or
+/// alone before it; then the prompt's rest, and each window kept to 2 rows and stepped once.
+fn arm(gpu: check.Gpu, session: *flash.rank_engine.Session, tri: flash.Tri, e: *prompt.Engine, stream: *cuda.Stream, seed: []const u32, ids: []const u32, np: usize, windows: usize, out: u64, mixed: bool, rec: Record) !void {
+    var seqs: [max_windows]prompt.Seq = undefined;
+    var drafts: [max_windows]mtp.Draft = undefined;
+    var made: usize = 0;
+    defer for (seqs[0..made], drafts[0..made]) |*q, *d| {
+        d.deinit();
+        session.drop(q);
+    };
+    var tokens: [max_windows][window_rows]u32 = undefined;
+    for (0..windows) |w| {
+        seqs[w] = try session.create(context);
+        drafts[w] = mtp.Draft.init(gpu.gpa, e.driver, stream.*, context, 1, 32, e.heads) catch |err| {
+            session.drop(&seqs[w]);
+            return err;
+        };
+        made += 1;
+        var base: [40]u32 = undefined;
+        for (&base, 0..) |*v, i| v.* = seed[(w * 31 + i * 7) % seed.len];
+        try session.forward(flash.Tri, tri, &seqs[w], base[0 .. 24 + w % 16], .{});
+        for (&tokens[w], 0..) |*v, i| v.* = seed[(w * 3 + i * 17 + 1) % seed.len];
+    }
+    var p = try session.create(context);
+    defer session.drop(&p);
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, np * prompt.hidden_wide * 2);
+    defer streams.free();
+    var qs: [max_windows]*prompt.Seq = undefined;
+    var ds: [max_windows]*mtp.Draft = undefined;
+    var idss: [max_windows][]const u32 = undefined;
+    for (0..windows) |w| {
+        qs[w] = &seqs[w];
+        ds[w] = &drafts[w];
+        idss[w] = &tokens[w];
+    }
+    if (mixed) {
+        try session.mixed(flash.Tri, tri, .{ .seq = &p, .ids = ids[0..np], .streams = streams.ptr }, qs[0..windows], ds[0..windows], idss[0..windows], out);
+    } else {
+        try session.forward(flash.Tri, tri, &p, ids[0..np], .{ .logits = .none, .streams = streams.ptr });
+        try session.verifyMany(flash.Tri, tri, qs[0..windows], ds[0..windows], idss[0..windows], out);
+    }
+    try stream.synchronize();
+    const d = e.driver;
+    try d.check(d.api.cuMemcpyDtoH_v2(rec.rows.ptr, out, rec.rows.len), "cuMemcpyDtoH");
+    try d.check(d.api.cuMemcpyDtoH_v2(rec.streams.ptr, streams.ptr, rec.streams.len), "cuMemcpyDtoH");
+    try session.forward(flash.Tri, tri, &p, ids[np..], .{});
+    @memcpy(rec.last, p.logits);
+    const row = prompt.vocabulary * 2;
+    for (0..windows) |w| {
+        try session.keep(flash.Tri, tri, &seqs[w], &drafts[w], 2);
+        try session.forward(flash.Tri, tri, &seqs[w], &.{13}, .{});
+        @memcpy(rec.next[w * row ..][0..row], seqs[w].logits);
+    }
+}
diff --git a/zig/tests/cuda/flashnext_mtp_side_tests.zig b/zig/tests/cuda/flashnext_mtp_side_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..977420785a2576ea5b4e7696cd05d61444b6e4fc
--- /dev/null
+++ b/zig/tests/cuda/flashnext_mtp_side_tests.zig
@@ -0,0 +1,105 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const Side = flash.mtp_side.Side;
+
+const Arm = struct {
+    seqs: [2]prompt.Seq = undefined,
+    drafts: [2]mtp.Draft = undefined,
+    made: usize = 0,
+    chains: [2][2]mtp.Chain = undefined,
+    logits: [2][2][]u8 = undefined,
+    sided: usize = 0,
+
+    fn deinit(a: *Arm, gpa: std.mem.Allocator) void {
+        for (a.seqs[0..a.made], a.drafts[0..a.made]) |*q, *d| {
+            d.deinit();
+            q.deinit(gpa);
+        }
+    }
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, ids_path: []const u8) !void {
+    const gpa = gpu.gpa;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpa, .limited(1 << 20));
+    defer gpa.free(source);
+    var base: std.ArrayList(u32) = .empty;
+    defer base.deinit(gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try base.append(gpa, try std.fmt.parseInt(u32, word, 10));
+    if (base.items.len < 16) return error.BadPrompt;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const e = try prompt.Engine.init(gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+    defer e.deinit();
+    const h = try mtp.Head.init(gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+    defer h.deinit();
+    const ops: mtp.Ops(flash.Tri) = .{ .e = e, .tri = tri, .h = h };
+    const n = 2 * e.chunk + e.chunk / 2 + 7;
+    var ids: [2][]u32 = undefined;
+    for (&ids, 0..) |*p, j| {
+        p.* = try gpa.alloc(u32, n - 5 * j);
+        for (p.*, 0..) |*t, i| t.* = base.items[(i * (1 + 6 * j) + 3 * j) % base.items.len];
+    }
+    defer for (ids) |p| gpa.free(p);
+    var main_arm: Arm = .{};
+    defer main_arm.deinit(gpa);
+    try arm(gpu, ops, &stream, ids, &main_arm);
+    defer for (main_arm.logits) |l| for (l) |b| gpa.free(b);
+    const rows = Side.rowsFor(e.chunk, flash.knobs.headPiece(), e.chunk);
+    h.side = try Side.init(gpa, gpu.d, &e.batch_k, rows);
+    var side_arm: Arm = .{};
+    defer side_arm.deinit(gpa);
+    try arm(gpu, ops, &stream, ids, &side_arm);
+    defer for (side_arm.logits) |l| for (l) |b| gpa.free(b);
+    try check.expect(side_arm.sided == 2 * 2, "every prompt's two non-final chunks left their head rows on the side stream ({d})", .{side_arm.sided});
+    try check.expect(main_arm.sided == 0, "without a side stream no chunk queued side work", .{});
+    for (0..2) |j| for (0..2) |k| {
+        const a = main_arm.chains[j][k];
+        const b = side_arm.chains[j][k];
+        try check.expect(a.n == b.n and std.mem.eql(u32, a.slice(), b.slice()), "prompt {d} draft {d}: the side stream's chain equals the main stream's", .{ j, k });
+        try check.expect(std.mem.eql(f64, a.probs[0..a.n], b.probs[0..b.n]), "prompt {d} draft {d}: its probabilities equal the main stream's", .{ j, k });
+        try check.sameBytes("the head's scores after a side-stream prompt equal the main stream's", side_arm.logits[j][k], main_arm.logits[j][k]);
+    };
+    check.pass("side-stream MTP head: {d}-row chunks, two interleaved prompts, chains and scores byte-exact", .{e.chunk});
+}
+
+fn arm(gpu: check.Gpu, ops: mtp.Ops(flash.Tri), stream: *cuda.Stream, ids: [2][]u32, a: *Arm) !void {
+    const gpa = gpu.gpa;
+    const e = ops.e;
+    for (0..2) |j| {
+        a.seqs[j] = try e.newSeq(ids[j].len + 64);
+        a.drafts[j] = mtp.Draft.init(gpa, e.driver, stream.*, ids[j].len + 64, ops.h.ids.len, e.chunk, e.heads) catch |err| {
+            a.seqs[j].deinit(gpa);
+            return err;
+        };
+        a.made += 1;
+        a.drafts[j].reset();
+    }
+    var at = [2]usize{ 0, 0 };
+    while (at[0] < ids[0].len or at[1] < ids[1].len) {
+        for (0..2) |j| if (at[j] < ids[j].len) {
+            const d = &a.drafts[j];
+            const stop = @min(ids[j].len, at[j] + @min(e.chunk, d.rows_cap));
+            try ops.prefillChunk(&a.seqs[j], d, ids[j], at[j], stop);
+            if (d.side_done != null) a.sided += 1;
+            at[j] = stop;
+        };
+    }
+    for (0..2) |j| {
+        const d = &a.drafts[j];
+        const next = [_]u32{@intCast((41 + 97 * j) % 50_000)};
+        const sm: ?mtp.Sampling = .{ .seed = 23 + @as(u64, j), .temperature = 1.0, .top_k = 20, .top_p = 0.95 };
+        for (0..2) |k| {
+            try ops.draft(d, &next, d.prompt_last, 0, 4, if (k == 0) null else sm, 0, &a.chains[j][k]);
+            try stream.synchronize();
+            a.logits[j][k] = try check.download(gpu, d.dlogits);
+        }
+    }
+}
