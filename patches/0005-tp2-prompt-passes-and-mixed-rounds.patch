diff --git a/zig/src/families/flashnext/cuda_rank_keep.zig b/zig/src/families/flashnext/cuda_rank_keep.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2b1ae7ce30b4b1e0dfabcf2b4605b40cf6aa0ee7
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rank_keep.zig
@@ -0,0 +1,127 @@
+//! TF_FLASHNEXT_TP_KEEP_BATCH: rank 0's rollbacks run at once on its own GPU and reach rank 1 in one keep_many frame
+//! ahead of rank 0's next command; rank 1 runs them in the same order before that command, with no stream wait.
+const std = @import("std");
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const wire = @import("cuda_rank_wire.zig");
+const Session = @import("cuda_rank_engine.zig").Session;
+
+/// Rollbacks one frame carries at most: two rounds of 32 streams; a fuller batch is sent before the next is taken.
+pub const max_keeps = 64;
+/// A keep: the sequence's rank id (u64) and the rows it keeps (u32).
+pub const entry_bytes = 12;
+pub const max_bytes = entry_bytes * max_keeps;
+
+/// The rollbacks rank 0 ran since its last frame, in the order it ran them.
+pub const Batch = struct {
+    ids: [max_keeps]u64 = undefined,
+    counts: [max_keeps]u32 = undefined,
+    n: usize = 0,
+
+    pub fn full(b: *const Batch) bool {
+        return b.n == max_keeps;
+    }
+
+    pub fn push(b: *Batch, id: u64, count: usize) !void {
+        if (b.full() or id == 0 or count == 0 or count > mtp.max_rows) return error.BadRankFrame;
+        b.ids[b.n] = id;
+        b.counts[b.n] = @intCast(count);
+        b.n += 1;
+    }
+
+    pub fn encode(b: *const Batch, out: *[max_bytes]u8) []const u8 {
+        for (b.ids[0..b.n], b.counts[0..b.n], 0..) |id, count, i| {
+            std.mem.writeInt(u64, out[i * entry_bytes ..][0..8], id, .little);
+            std.mem.writeInt(u32, out[i * entry_bytes + 8 ..][0..4], count, .little);
+        }
+        return out[0 .. b.n * entry_bytes];
+    }
+
+    /// Rank 1: a frame of `n` keeps, every one checked before any is run.
+    pub fn decode(payload: []const u8, n: usize) !Batch {
+        if (n == 0 or n > max_keeps or payload.len != n * entry_bytes) return error.BadRankFrame;
+        var b: Batch = .{};
+        for (0..n) |i| try b.push(std.mem.readInt(u64, payload[i * entry_bytes ..][0..8], .little), std.mem.readInt(u32, payload[i * entry_bytes + 8 ..][0..4], .little));
+        return b;
+    }
+};
+
+/// Rank 0: `count` rows of `d` kept here now; rank 1 hears of it in the next keep_many frame. A keep that moves nothing
+/// on either rank (every row kept, the window already settled) is not sent: both ranks' windows stand alike after the
+/// same frames, so rank 1's is settled too.
+pub fn later(s: *Session, comptime Tri: type, tri: Tri, q: *prompt.Seq, d: *mtp.Draft, count: usize) !void {
+    if (s.rank != 0 or s.stopped or s.collective.failed) return error.RankDisconnected;
+    if (q.rank_id == 0) return error.CannotRewind;
+    if (count == d.rows and !d.open) return;
+    if (s.keeps.full()) try flush(s);
+    errdefer s.poison();
+    const ops: mtp.Ops(Tri) = .{ .e = s.engine, .tri = tri, .h = undefined };
+    try ops.rollback(q, d, count);
+    try s.keeps.push(q.rank_id, count);
+}
+
+/// Rank 0, before any other frame: the batch in one keep_many frame; its ack is read with the next command's.
+pub fn flush(s: *Session) !void {
+    if (s.keeps.n == 0) return;
+    errdefer s.poison();
+    if (s.keep_sent) |old| {
+        try s.settle();
+        s.keep_sent = null;
+        if (try s.ackFlags(old) != 0) return error.RemoteRank;
+    }
+    var raw: [max_bytes]u8 = undefined;
+    const bytes = s.keeps.encode(&raw);
+    const h: wire.Header = .{ .kind = .keep_many, .sequence = s.next, .arg = s.keeps.n, .bytes = @intCast(bytes.len) };
+    s.next = std.math.add(u64, s.next, 1) catch return error.BadRankFrame;
+    const until = wire.deadline(30_000);
+    try s.link.sendHeader(h, until);
+    try s.link.send(bytes, until);
+    s.keep_sent = h;
+    s.keeps.n = 0;
+}
+
+/// Rank 1: every keep's sequence and window found before any rolls back, then each in rank 0's order.
+pub fn receive(s: *Session, comptime Tri: type, tri: Tri, h: wire.Header, payload: []const u8) !void {
+    if (!s.drafting) return error.UnsupportedRankOperation;
+    const b = try Batch.decode(payload, @intCast(h.arg));
+    var qs: [max_keeps]*prompt.Seq = undefined;
+    var ds: [max_keeps]*mtp.Draft = undefined;
+    for (b.ids[0..b.n], 0..) |id, i| {
+        qs[i] = s.seqs.get(id) orelse return error.UnknownRankSequence;
+        ds[i] = s.windows.getPtr(id) orelse return error.CannotRewind;
+    }
+    const ops: mtp.Ops(Tri) = .{ .e = s.engine, .tri = tri, .h = undefined };
+    for (qs[0..b.n], ds[0..b.n], b.counts[0..b.n]) |q, d, count| try ops.rollback(q, d, count);
+}
+
+test "keep batch frames round trip in order and refuse bad keeps before any runs" {
+    var b: Batch = .{};
+    try b.push(7, 1);
+    try b.push(9, mtp.max_rows);
+    try b.push(7, 3);
+    var raw: [max_bytes]u8 = undefined;
+    const bytes = b.encode(&raw);
+    try std.testing.expectEqual(@as(usize, 3 * entry_bytes), bytes.len);
+    const back = try Batch.decode(bytes, 3);
+    try std.testing.expectEqualSlices(u64, &.{ 7, 9, 7 }, back.ids[0..back.n]);
+    try std.testing.expectEqualSlices(u32, &.{ 1, mtp.max_rows, 3 }, back.counts[0..back.n]);
+    try std.testing.expectError(error.BadRankFrame, Batch.decode(bytes, 2));
+    try std.testing.expectError(error.BadRankFrame, Batch.decode(bytes, 0));
+    try std.testing.expectError(error.BadRankFrame, Batch.decode(bytes[0 .. bytes.len - 1], 3));
+    try std.testing.expectError(error.BadRankFrame, b.push(0, 1));
+    try std.testing.expectError(error.BadRankFrame, b.push(5, 0));
+    try std.testing.expectError(error.BadRankFrame, b.push(5, mtp.max_rows + 1));
+    std.mem.writeInt(u32, raw[8..12], 0, .little);
+    try std.testing.expectError(error.BadRankFrame, Batch.decode(bytes, 3));
+    var all: Batch = .{};
+    for (0..max_keeps) |i| try all.push(i + 1, 1);
+    try std.testing.expect(all.full());
+    try std.testing.expectError(error.BadRankFrame, all.push(99, 1));
+    var big: [max_bytes]u8 = undefined;
+    try std.testing.expectEqual(@as(usize, max_bytes), all.encode(&big).len);
+    try std.testing.expectEqual(max_keeps, (try Batch.decode(&big, max_keeps)).n);
+}
+
+test {
+    if (@import("builtin").os.tag != .windows) _ = @import("cuda_rank_keep_test.zig"); // over a Unix socket pair
+}
