new file mode 100644
index 0000000000000000000000000000000000000000..1bda46809078d0eab80fa08f02d4136f7a11f39a
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_mtp_side.zig
@@ -0,0 +1,98 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const batch = @import("cuda_batch.zig");
+const exl3x = @import("cuda_exl3_experts.zig");
+const piece_rows = @import("cuda_mtp.zig").piece_rows;
+
+pub const Side = struct {
+    gpa: std.mem.Allocator,
+    driver: *const cuda.Driver,
+    stream: cuda.Stream,
+    ready: cuda.Event,
+    done: cuda.Event,
+    s: batch.Scratch,
+    scores: ?cuda.DeviceBuffer = null,
+    k: batch.Kernels,
+    kit: ?*exl3x.Kit = null,
+
+    pub fn rowsFor(chunk: usize, piece_req: usize, rows: usize) usize {
+        return @max(@as(usize, 32), 2 * @min(rows, @min(piece_req, @max(piece_rows, chunk / 2))));
+    }
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, k: *const batch.Kernels, rows: usize) !*Side {
+        const x = try gpa.create(Side);
+        errdefer gpa.destroy(x);
+        var st = try cuda.Stream.init(d, true);
+        errdefer st.deinit();
+        var ready = try cuda.Event.init(d, false);
+        errdefer ready.deinit();
+        var done = try cuda.Event.init(d, false);
+        errdefer done.deinit();
+        var kit: ?*exl3x.Kit = null;
+        if (k.exl3) |main_kit| {
+            const own = try std.heap.page_allocator.create(exl3x.Kit);
+            own.* = main_kit.*;
+            own.grouped.storage = null;
+            own.grouped.pair_cap = 0;
+            kit = own;
+        }
+        errdefer if (kit) |own| freeKit(own);
+        if (kit) |own| try own.reserve(rows);
+        var s = try batch.Scratch.alloc(gpa, d, st, rows);
+        errdefer s.free(gpa);
+        var own_k = k.*;
+        own_k.exl3 = kit;
+        x.* = .{ .gpa = gpa, .driver = d, .stream = st, .ready = ready, .done = done, .s = s, .k = own_k, .kit = kit };
+        return x;
+    }
+
+    fn freeKit(kit: *exl3x.Kit) void {
+        kit.grouped.deinit();
+        std.heap.page_allocator.destroy(kit);
+    }
+
+    pub fn deinit(x: *Side) void {
+        cuda.completion.drain(x.driver, x.stream, "flashnext: the MTP head's side stream did not drain");
+        if (x.scores) |*b| b.free();
+        x.s.free(x.gpa);
+        if (x.kit) |kit| freeKit(kit);
+        x.done.deinit();
+        x.ready.deinit();
+        x.stream.deinit();
+        x.gpa.destroy(x);
+    }
+
+    pub fn reserveScores(x: *Side, cap: usize, rows: usize) !u64 {
+        const need = batch.scoreBytes(cap, rows);
+        if (x.scores) |*b| {
+            if (b.len >= need) return b.ptr;
+            try x.stream.synchronize();
+            b.free();
+            x.scores = null;
+        }
+        x.scores = try cuda.DeviceBuffer.alloc(x.driver, need);
+        return x.scores.?.ptr;
+    }
+
+    pub fn after(x: *Side, main: cuda.Stream) !void {
+        try x.ready.record(main);
+        try x.stream.wait(x.ready);
+    }
+
+    pub fn queued(x: *Side) !cuda.Event {
+        try x.done.record(x.stream);
+        return x.done;
+    }
+};
+
+test "the side scratch holds two of the pieces forwardHeadPieces cuts at every chunk" {
+    try std.testing.expectEqual(@as(usize, 512), Side.rowsFor(1536, 256, 1536));
+    try std.testing.expectEqual(@as(usize, 512), Side.rowsFor(3072, 256, 3072));
+    try std.testing.expectEqual(@as(usize, 64), Side.rowsFor(32, 256, 32));
+    try std.testing.expectEqual(@as(usize, 1536), Side.rowsFor(1536, 1024, 1536));
+    try std.testing.expectEqual(@as(usize, 32), Side.rowsFor(1536, 1, 1536));
+    try std.testing.expectEqual(@as(usize, 200), Side.rowsFor(1536, 256, 100));
+    for ([_]usize{ 32, 300, 1536, 3072 }) |chunk| for ([_]usize{ 1, 8, 256, 1024 }) |req| for (1..chunk + 1) |rows| {
+        try std.testing.expect(Side.rowsFor(chunk, req, rows) <= Side.rowsFor(chunk, req, chunk));
+    };
+}
