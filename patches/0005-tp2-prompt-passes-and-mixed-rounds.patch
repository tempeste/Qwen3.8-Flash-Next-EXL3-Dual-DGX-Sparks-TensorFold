diff --git a/zig/kernels/cuda/flashnext_gdn_chunk.cuh b/zig/kernels/cuda/flashnext_gdn_chunk.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..6555afbfce8e882127f12a670fb58c61b8123318
--- /dev/null
+++ b/zig/kernels/cuda/flashnext_gdn_chunk.cuh
@@ -0,0 +1,223 @@
+namespace gdn_chunk {
+constexpr int DK = 128, DV = 128, C = 64, SLICE = 16, KT = 32;
+constexpr int BLK = C * DK + C * C + C;
+__device__ __forceinline__ float bf(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }
+
+template <int NK, int NV>
+__device__ __forceinline__ void prep(const float* __restrict__ qn, const float* __restrict__ kn, const float* __restrict__ v,
+                                     const float* __restrict__ gb, int rows, float* __restrict__ wy,
+                                     float* __restrict__ u_out) {
+    __shared__ float la[C], bt[C], bg[C];
+    __shared__ float kt[C][KT + 1], qt[C][KT + 1];
+    __shared__ __align__(16) float a[C][C + 4];
+    const int hv = blockIdx.x, c = blockIdx.y, hk = hv / (NV / NK), tid = threadIdx.x;
+    const int r0 = c * C, L = min(C, rows - r0);
+    float* blk = wy + ((size_t)c * NV + hv) * BLK;
+    if (tid < C) {
+        float lg = 0.0f, b = 0.0f;
+        if (tid < L) {
+            const float2 g2 = *reinterpret_cast<const float2*>(gb + ((size_t)(r0 + tid) * NV + hv) * 2);
+            lg = logf(g2.x);
+            if (lg < -87.0f) lg = -87.0f;
+            b = g2.y;
+        }
+        la[tid] = lg;
+        bt[tid] = b;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 0.0f;
+        for (int t = 0; t < C; ++t) {
+            acc = acc + la[t];
+            la[t] = acc;
+        }
+    }
+    __syncthreads();
+    if (tid < C) {
+        bg[tid] = bt[tid] * expf(la[tid]);
+        blk[C * DK + C * C + tid] = la[tid];
+    }
+    const int ty = tid >> 4, tx = tid & 15;
+    float kk[4][4], qk[4][4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i)
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            kk[i][j] = 0.0f;
+            qk[i][j] = 0.0f;
+        }
+    for (int d0 = 0; d0 < DK; d0 += KT) {
+        for (int e = tid; e < C * KT; e += blockDim.x) {
+            const int t = e / KT, d = e % KT;
+            const size_t at = ((size_t)(r0 + t) * NK + hk) * DK + d0 + d;
+            kt[t][d] = t < L ? kn[at] : 0.0f;
+            qt[t][d] = t < L ? qn[at] : 0.0f;
+        }
+        __syncthreads();
+#pragma unroll 4
+        for (int d = 0; d < KT; ++d) {
+            float ki[4], qi[4], kj[4];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                ki[i] = kt[ty + 16 * i][d];
+                qi[i] = qt[ty + 16 * i][d];
+                kj[i] = kt[tx + 16 * i][d];
+            }
+#pragma unroll
+            for (int i = 0; i < 4; ++i)
+#pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    kk[i][j] = kk[i][j] + ki[i] * kj[j];
+                    qk[i][j] = qk[i][j] + qi[i] * kj[j];
+                }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int i = 0; i < 4; ++i)
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const int t = ty + 16 * i, s = tx + 16 * j;
+            const float dec = t >= s ? expf(la[t] - la[s]) : 0.0f;
+            a[t][s] = t > s ? bt[t] * dec * kk[i][j] : 0.0f;
+            blk[C * DK + t * C + s] = dec * qk[i][j];
+        }
+    __syncthreads();
+    const bool key = tid < DK;
+    const int col = key ? tid : tid - DK;
+    float w[C];
+#pragma unroll
+    for (int t = 0; t < C; ++t) {
+        float x = 0.0f;
+        if (t < L) x = key ? kn[((size_t)(r0 + t) * NK + hk) * DK + col] : v[(size_t)(r0 + t) * NV * DV + hv * DV + col];
+        w[t] = x * (key ? bg[t] : bt[t]);
+    }
+#pragma unroll
+    for (int t = 1; t < C; ++t) {
+        float acc = w[t];
+#pragma unroll
+        for (int i = 0; i < t; ++i) acc = acc - a[t][i] * w[i];
+        w[t] = acc;
+    }
+    if (key) {
+#pragma unroll
+        for (int t = 0; t < C; ++t) blk[t * DK + col] = w[t];
+    } else {
+#pragma unroll
+        for (int t = 0; t < C; ++t)
+            if (t < L) u_out[((size_t)(r0 + t) * NV + hv) * DV + col] = w[t];
+    }
+}
+
+template <int NK, int NV>
+__device__ __forceinline__ void state(const float* __restrict__ qn, const float* __restrict__ kn, const float* __restrict__ wy,
+                                      const float* state_in, float* state_out, int rows, float* __restrict__ ys) {
+    __shared__ float ss[SLICE][DK + 1];
+    __shared__ __align__(16) float xs[2 * C * (KT + 1)];
+    __shared__ __align__(16) float dl[C][SLICE + 4];
+    __shared__ float gam[C], ex[C];
+    const int hv = blockIdx.x, v0 = blockIdx.y * SLICE, hk = hv / (NV / NK), tid = threadIdx.x;
+    const int tr = tid >> 3, cv = tid & 7;
+    float (*xw)[KT + 1] = reinterpret_cast<float (*)[KT + 1]>(xs);
+    float (*xq)[KT + 1] = reinterpret_cast<float (*)[KT + 1]>(xs + C * (KT + 1));
+    float (*aq)[C + 1] = reinterpret_cast<float (*)[C + 1]>(xs);
+    const size_t sb = (size_t)hv * DV * DK + (size_t)v0 * DK + tid;
+    float s[SLICE];
+#pragma unroll
+    for (int v = 0; v < SLICE; ++v) {
+        s[v] = state_in[sb + (size_t)v * DK];
+        ss[v][tid] = s[v];
+    }
+    const int chunks = (rows + C - 1) / C;
+    for (int c = 0; c < chunks; ++c) {
+        const int r0 = c * C, L = min(C, rows - r0);
+        const float* blk = wy + ((size_t)c * NV + hv) * BLK;
+        const float* lab = blk + C * DK + C * C;
+        if (tid < C) {
+            const float l = lab[tid];
+            gam[tid] = expf(l);
+            ex[tid] = expf(lab[C - 1] - l);
+        }
+        float pw[4][2], pq[4][2];
+#pragma unroll
+        for (int i = 0; i < 4; ++i)
+#pragma unroll
+            for (int b = 0; b < 2; ++b) {
+                pw[i][b] = 0.0f;
+                pq[i][b] = 0.0f;
+            }
+        for (int d0 = 0; d0 < DK; d0 += KT) {
+            __syncthreads();
+            for (int e = tid; e < C * KT; e += blockDim.x) {
+                const int t = e / KT, d = e % KT;
+                xw[t][d] = blk[t * DK + d0 + d];
+                xq[t][d] = t < L ? qn[((size_t)(r0 + t) * NK + hk) * DK + d0 + d] : 0.0f;
+            }
+            __syncthreads();
+#pragma unroll 4
+            for (int d = 0; d < KT; ++d) {
+                const float s0 = ss[cv][d0 + d], s1 = ss[cv + 8][d0 + d];
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    const float w_ = xw[tr + 16 * i][d], q_ = xq[tr + 16 * i][d];
+                    pw[i][0] = pw[i][0] + w_ * s0;
+                    pw[i][1] = pw[i][1] + w_ * s1;
+                    pq[i][0] = pq[i][0] + q_ * s0;
+                    pq[i][1] = pq[i][1] + q_ * s1;
+                }
+            }
+        }
+        __syncthreads();
+        float po[4][2];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int t = tr + 16 * i;
+#pragma unroll
+            for (int b = 0; b < 2; ++b) {
+                const int vv = cv + 8 * b;
+                const float u = t < L ? ys[((size_t)(r0 + t) * NV + hv) * DV + v0 + vv] : 0.0f;
+                dl[t][vv] = u - pw[i][b];
+                po[i][b] = gam[t] * pq[i][b];
+            }
+        }
+        for (int e = tid; e < C * C; e += blockDim.x) aq[e / C][e % C] = blk[C * DK + e];
