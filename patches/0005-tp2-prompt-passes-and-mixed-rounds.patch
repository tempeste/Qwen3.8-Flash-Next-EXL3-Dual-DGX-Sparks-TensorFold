index 0000000000000000000000000000000000000000..95ab447776f171c924a1b456f8ed16df771d956f
--- /dev/null
+++ b/zig/tests/cuda/flashnext_async_rank_tests.zig
@@ -0,0 +1,97 @@
+//! TF_FLASHNEXT_TP_PROMPT_ASYNC at --tp 2: queued, undrained prompt chunks of two interleaved prompts (more than the
+//! deferred-ack bound, so rank 0 settles mid-prompt) leave each prompt's last row byte-equal to drained chunks'.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+
+const knob = "TF_FLASHNEXT_TP_PROMPT_ASYNC";
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const context = 256;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    var ids: [200]u32 = undefined;
+    var other: [200]u32 = undefined;
+    for (&ids, &other, 0..) |*a, *b, i| {
+        a.* = seed.items[i % seed.items.len];
+        b.* = seed.items[(i * 7 + 3) % seed.items.len];
+    }
+    if (rank == 1) _ = env.setenv(knob, "1", 1);
+    defer _ = env.unsetenv(knob);
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, 32);
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    // TF_FLASHNEXT_TP_ROCE=1 (as a served pair runs): the fitting sums and gathers by RoCE, as a served engine opens it at load
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != 32) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed queued prompt chunks without draining them", .{});
+        return;
+    }
+    const row = prompt.vocabulary * 2;
+    const want_a = try gpu.gpa.alloc(u8, row);
+    defer gpu.gpa.free(want_a);
+    const want_b = try gpu.gpa.alloc(u8, row);
+    defer gpu.gpa.free(want_b);
+    const want_next = try gpu.gpa.alloc(u8, row);
+    defer gpu.gpa.free(want_next);
+    _ = env.unsetenv(knob);
+    for ([_]*const [200]u32{ &ids, &other }, [_][]u8{ want_a, want_b }) |p, want| {
+        var q = try session.create(context);
+        defer session.drop(&q);
+        var at: usize = 0;
+        while (at < p.len) : (at += 32) {
+            const end = @min(at + 32, p.len);
