+__device__ __forceinline__ uint32_t key(float v) {
+    const uint32_t bits = __float_as_uint(v);
+    return (bits & 0x80000000u) ? ~bits : (bits | 0x80000000u);
+}
+
+__device__ __forceinline__ int bin(uint32_t k) { return min(max(static_cast<int>(k >> 18) - EBASE, 0), NBIN - 1); }
+
+__device__ __forceinline__ unsigned long long rank_of(uint2 c) {
+    return (static_cast<unsigned long long>(c.x) << 32) | static_cast<unsigned long long>(~c.y);
+}
