+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const ranks = @import("cuda_rank_engine.zig");
+const wire = @import("cuda_rank_wire.zig");
+const rank_keep = @import("cuda_rank_keep.zig");
+const rank_snap = @import("cuda_rank_snap.zig");
+const Tri = @import("cuda_launch.zig").Tri;
+const t = std.testing;
+
+// Virtual device addresses; the callbacks never open CUDA or touch device memory.
+const Device = struct {
+    var next: u64 = 0x100000;
+
+    fn alloc(out: *u64, n: usize) callconv(.c) c_int {
+        out.* = next;
+        next += n + 256;
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) c_int {
+        return 0;
+    }
+    fn fill(_: u64, _: u8, _: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn copy(_: u64, _: u64, _: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn context() callconv(.c) c_int {
+        return 0;
+    }
+    fn driver() cuda.Driver {
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemsetD8Async = fill;
+        d.api.cuMemcpyDtoDAsync_v2 = copy;
+        d.api.cuStreamSynchronize = sync;
+        d.api.cuCtxSynchronize = context;
+        return d;
+    }
+};
+
+/// One rank's session over one end of a socket pair, with the batched keep on; `peer` plays the other rank.
+const Pair = struct {
+    driver: cuda.Driver,
+    stream: cuda.Stream,
+    engine: prompt.Engine,
+    fds: [2]std.posix.socket_t,
+    s: ranks.Session,
+    peer: wire.Link,
+
+    fn init(p: *Pair, rank: usize) !void {
+        p.driver = Device.driver();
+        p.stream = .{ .d = &p.driver, .handle = null };
+        p.engine = undefined;
+        p.engine.gpa = t.allocator;
+        p.engine.driver = &p.driver;
+        p.engine.stream = &p.stream;
+        p.engine.eos = 7;
+        p.engine.chunk = 16;
+        p.engine.round_graph = .{};
+        p.engine.heads = .half;
+        p.engine.kv = .bf16;
+        p.engine.index_window = 0;
+        if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &p.fds) != 0) return error.SocketPair;
+        const nonblock: c_int = @bitCast(@as(u32, @bitCast(std.c.O{ .NONBLOCK = true })));
+        for (p.fds) |fd| {
+            const flags = std.c.fcntl(fd, std.c.F.GETFL);
+            if (flags < 0 or std.c.fcntl(fd, std.c.F.SETFL, flags | nonblock) < 0) return error.Nonblocking;
+        }
+        p.peer = .{ .fd = p.fds[1] };
+        p.s = .{ .gpa = t.allocator, .rank = rank, .link = .{ .fd = p.fds[0] }, .collective = undefined, .engine = &p.engine, .drafting = true, .keep_batch = true };
+        p.s.collective.failed = false;
+        p.s.collective.site = .other;
+        p.s.collective.profile = null;
+        p.s.collective.roce = null;
+        p.s.collective.roce_stage = null;
+        p.s.collective.guard = null;
+        p.s.collective.comm = null;
+    }
+
+    fn deinit(p: *Pair) void {
+        var wi = p.s.windows.valueIterator();
+        while (wi.next()) |d| d.deinit();
+        p.s.windows.deinit(t.allocator);
+        var qi = p.s.seqs.valueIterator();
+        while (qi.next()) |q| {
+            q.*.deinit(t.allocator);
+            t.allocator.destroy(q.*);
+        }
+        p.s.seqs.deinit(t.allocator);
+        p.s.saved.deinit(t.allocator);
+        _ = std.c.close(p.fds[0]);
+        _ = std.c.close(p.fds[1]);
+    }
+
+    fn quiet(p: *const Pair) bool {
+        var byte: u8 = 0;
+        return std.c.recv(p.fds[1], &byte, 1, std.posix.MSG.PEEK | std.posix.MSG.DONTWAIT) < 0;
+    }
+
+    fn seq(p: *Pair, id: u64, fed: usize) !prompt.Seq {
+        var q = try p.engine.newSeq(16);
+        q.rank_id = id;
+        q.fed = fed;
+        q.history = .{ 3, @intCast(fed) };
+        return q;
+    }
+
+    /// A window as a verify of `rows` rows leaves it: open (its end states in the spares) past one row.
+    fn window(p: *Pair, rows: usize) !mtp.Draft {
+        var d = try mtp.Draft.init(t.allocator, &p.driver, p.stream, 16, 1, p.engine.chunk, p.engine.heads);
+        d.rows = rows;
+        d.open = rows > 1;
+        return d;
+    }
+
+    fn ack(p: *Pair, sequence: u64, object: u64, flags: u32) !void {
+        try p.peer.sendHeader(.{ .kind = .ack, .sequence = sequence, .object = object, .flags = flags }, wire.deadline(1000));
+    }
+
+    fn frame(p: *Pair, h: wire.Header, payload: []const u8) !void {
+        try p.peer.sendHeader(h, wire.deadline(1000));
+        try p.peer.send(payload, wire.deadline(1000));
+    }
+
+    fn keeps(p: *Pair, entries: []const [2]u64) !rank_keep.Batch {
+        const h = try p.peer.receiveHeader(wire.deadline(1000));
+        try t.expectEqual(wire.Kind.keep_many, h.kind);
+        try ranks.shape(h);
+        var raw: [rank_keep.max_bytes]u8 = undefined;
+        try p.peer.receive(raw[0..h.bytes], wire.deadline(1000));
+        const b = try rank_keep.Batch.decode(raw[0..h.bytes], @intCast(h.arg));
+        try t.expectEqual(entries.len, b.n);
+        for (entries, 0..) |e, i| {
+            try t.expectEqual(e[0], b.ids[i]);
+            try t.expectEqual(@as(u32, @intCast(e[1])), b.counts[i]);
+        }
+        return b;
+    }
+};
+
+test "rank 0 keeps at once, sends nothing for a keep that moves nothing, and batches the rest ahead of its next command" {
+    var p: Pair = undefined;
+    try p.init(0);
+    defer p.deinit();
+    var a = try p.seq(7, 5);
+    defer a.deinit(t.allocator);
+    var b = try p.seq(8, 9);
+    defer b.deinit(t.allocator);
+    var da = try p.window(3);
+    defer da.deinit();
+    var db = try p.window(1);
+    defer db.deinit();
+    const before = a.state[0].ptr;
+    try p.s.keep(Tri, undefined, &a, &da, 3);
+    try t.expect(!da.open and da.rows == 3 and a.state[0].ptr != before);
+    try p.s.keep(Tri, undefined, &a, &da, 3);
+    try p.s.keep(Tri, undefined, &b, &db, 1);
+    try t.expect(p.quiet() and p.s.keeps.n == 1 and p.s.next == 1);
+    try t.expectError(error.CannotRewind, p.s.keep(Tri, undefined, &a, &da, 4));
+    // the next command carries the batch first; both acks are read with the command's
+    try p.ack(1, 0, 0);
+    try p.ack(2, 1, 0);
+    var q = try p.s.create(16);
+    _ = try p.keeps(&.{.{ 7, 3 }});
+    const h = try p.peer.receiveHeader(wire.deadline(1000));
+    try t.expect(h.kind == .create and h.sequence == 2 and q.rank_id == 1);
+    try t.expect(p.s.keeps.n == 0 and p.s.keep_sent == null and !p.s.stopped);
+    // no keeps: the next command goes alone
+    try p.ack(3, 1, 0);
+    p.s.drop(&q);
+    const alone = try p.peer.receiveHeader(wire.deadline(1000));
+    try t.expect(alone.kind == .drop_seq and alone.sequence == 3 and !p.s.stopped);
+}
+
+test "rank 0 stops both ranks when rank 1 fails a batch of keeps" {
+    var p: Pair = undefined;
+    try p.init(0);
+    defer p.deinit();
+    var a = try p.seq(7, 5);
+    defer a.deinit(t.allocator);
+    var da = try p.window(2);
+    defer da.deinit();
+    try p.s.keep(Tri, undefined, &a, &da, 2);
+    try p.ack(1, 0, rank_snap.failed);
+    try p.ack(2, 1, 0);
+    try t.expectError(error.RemoteRank, p.s.create(16));
+    try t.expect(p.s.stopped and !p.s.available.load(.acquire));
+    try t.expectError(error.RankDisconnected, p.s.keep(Tri, undefined, &a, &da, 2));
+}
+
+test "rank 0 sends a full batch before it takes the next keep, and reads its ack before the next batch's" {
+    var p: Pair = undefined;
+    try p.init(0);
+    defer p.deinit();
+    var q = try p.seq(1, 4);
+    defer q.deinit(t.allocator);
+    var d = try p.window(2);
+    defer d.deinit();
+    // one window verified again before each keep, under a new sequence id each time
+    for (0..rank_keep.max_keeps + 1) |i| {
+        q.rank_id = i + 1;
+        d.rows = 2;
+        d.open = true;
+        try p.s.keep(Tri, undefined, &q, &d, 2);
+    }
+    try t.expect(p.s.keeps.n == 1 and p.s.keep_sent != null and p.s.keep_sent.?.sequence == 1);
+    var first: [rank_keep.max_keeps][2]u64 = undefined;
+    for (&first, 1..) |*e, i| e.* = .{ i, 2 };
+    _ = try p.keeps(&first);
+    try p.ack(1, 0, 0);
+    try p.ack(2, 0, 0);
+    try p.ack(3, 0, 0);
+    try p.s.ack(try p.s.command(.{ .kind = .stop }, &.{}));
+    _ = try p.keeps(&.{.{ rank_keep.max_keeps + 1, 2 }});
+    const stop = try p.peer.receiveHeader(wire.deadline(1000));
+    try t.expect(stop.kind == .stop and stop.sequence == 3 and p.s.keep_sent == null);
+}
+
+test "rank 1 runs a batch of keeps in order with no stream wait, and refuses one naming a window it lacks before any runs" {
+    for (0..2) |case| {
+        var p: Pair = undefined;
+        try p.init(1);
+        defer p.deinit();
+        for ([_][2]u64{ .{ 7, 5 }, .{ 8, 9 } }) |x| {
+            const q = try t.allocator.create(prompt.Seq);
+            q.* = p.seq(x[0], x[1]) catch |err| {
+                t.allocator.destroy(q);
+                return err;
+            };
+            try p.s.seqs.put(t.allocator, x[0], q);
+        }
+        try p.s.windows.put(t.allocator, 7, try p.window(3));
+        try p.s.windows.put(t.allocator, 8, try p.window(2));
+        const before = p.s.seqs.get(7).?.state[0].ptr;
+        var b: rank_keep.Batch = .{};
+        try b.push(7, 3);
+        try b.push(if (case == 0) 8 else 9, 2);
+        var raw: [rank_keep.max_bytes]u8 = undefined;
+        const bytes = b.encode(&raw);
+        try p.frame(.{ .kind = .keep_many, .sequence = 1, .arg = b.n, .bytes = @intCast(bytes.len) }, bytes);
+        if (case == 0) {
+            try p.frame(.{ .kind = .stop, .sequence = 2 }, &.{});
+            try p.s.follow(Tri, undefined, 0);
+            for (1..3) |sequence| {
+                const h = try p.peer.receiveHeader(wire.deadline(1000));
+                try t.expect(h.kind == .ack and h.sequence == sequence and h.flags == 0);
+            }
+            try t.expect(!p.s.windows.getPtr(7).?.open and !p.s.windows.getPtr(8).?.open);
+            try t.expect(p.s.seqs.get(7).?.state[0].ptr != before);
+        } else {
+            try t.expectError(error.UnknownRankSequence, p.s.follow(Tri, undefined, 0));
+            const h = try p.peer.receiveHeader(wire.deadline(1000));
+            try t.expectEqual(rank_snap.failed, h.flags);
+            try t.expect(p.s.windows.getPtr(7).?.open and p.s.seqs.get(7).?.state[0].ptr == before);
+        }
+    }
+}
diff --git a/zig/src/families/flashnext/cuda_rank_mixed.zig b/zig/src/families/flashnext/cuda_rank_mixed.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8d59a75a174edf8d85ba23091e63ccb1d9e599dd
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rank_mixed.zig
@@ -0,0 +1,109 @@
+//! Control carries a mixed round (TF_FLASHNEXT_MIXED_ROUNDS): the windows' frame (cuda_rank_verify.zig's), then the
+//! prompt piece's ids; the header names the piece's sequence (object), the windows (arg) and the piece's rows (flags).
+const std = @import("std");
+const prompt = @import("cuda_prompt.zig");
+const wire = @import("cuda_rank_wire.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const mtp = @import("cuda_mtp.zig");
+const knobs = @import("cuda_knobs.zig");
+const verify_rows = @import("cuda_rank_verify.zig");
+const Session = @import("cuda_rank_engine.zig").Session;
+
+/// A piece's rows at most (the widest pass a frame may ask for).
+pub const max_piece = prompt.batch.max_chunk;
+pub const max_bytes = verify_rows.max_bytes + 4 * max_piece;
+
+/// The header's own checks (Session's shape()).
+pub fn shapeOk(h: wire.Header) bool {
+    return h.object != 0 and h.arg != 0 and h.arg <= verify_rows.max_windows and h.flags != 0 and h.flags <= max_piece and h.bytes >= 16 * h.arg + 4 * h.flags and h.bytes <= verify_rows.max_bytes + 4 * h.flags;
+}
+
+/// A decoded mixed frame: the windows, then the piece's ids.
+pub const Frame = struct { windows: verify_rows.Frame, piece: []const u8 };
+
+/// The windows' frame and `piece` rows' ids from `payload`: exact lengths, every id a token.
+pub fn decode(payload: []const u8, count: usize, piece: usize, limit: usize) !Frame {
+    if (piece == 0 or piece > max_piece or payload.len < 4 * piece) return error.BadRankFrame;
+    const split = payload.len - 4 * piece;
+    const ids = payload[split..];
+    for (0..piece) |i| if (std.mem.readInt(u32, ids[i * 4 ..][0..4], .little) >= wt.vocab) return error.InvalidToken;
+    return .{ .windows = try verify_rows.decode(payload[0..split], count, limit), .piece = ids };
+}
+
+/// The frame for windows `ids`/`idss` and the piece `piece` into `out`; refuses what `decode` refuses.
+pub fn encode(ids: []const u64, idss: []const []const u32, piece: []const u32, limit: usize, out: []u8) ![]const u8 {
+    const win = try verify_rows.encode(ids, idss, limit, out);
+    const n = win.len + 4 * piece.len;
+    if (n > out.len) return error.BadRankFrame;
+    for (piece, 0..) |token, i| std.mem.writeInt(u32, out[win.len + i * 4 ..][0..4], token, .little);
+    _ = try decode(out[0..n], ids.len, piece.len, limit);
+    return out[0..n];
+}
+
+/// Rank 0: the frame to rank 1, the same round here, then rank 1's ack; a failure after the send poisons the session.
+/// The piece's hidden streams go to `streams`; its head rows are the caller's.
+pub fn send(s: *Session, comptime Tri: type, tri: Tri, piece: prompt.Engine.MixedPiece, seqs: []const *prompt.Seq, ds: []const *mtp.Draft, idss: []const []const u32, out: u64) !void {
+    if (!s.drafting or !knobs.mixedRounds() or seqs.len == 0 or seqs.len > verify_rows.max_windows or seqs.len != ds.len or seqs.len != idss.len) return error.UnsupportedRankOperation;
+    if (piece.seq.rank_id == 0 or piece.ids.len == 0 or piece.ids.len > max_piece or piece.seq.fed + piece.ids.len > piece.seq.cap) return error.UnsupportedRankOperation;
+    var ids: [verify_rows.max_windows]u64 = undefined;
+    for (seqs, idss, 0..) |q, w, i| {
+        if (q.rank_id == 0 or q.rank_id == piece.seq.rank_id or q.fed + w.len > q.cap) return error.UnsupportedRankOperation;
+        ids[i] = q.rank_id;
+    }
+    const raw = try s.gpa.alloc(u8, verify_rows.max_bytes + 4 * piece.ids.len);
+    defer s.gpa.free(raw);
+    const bytes = try encode(ids[0..seqs.len], idss, piece.ids, verify_rows.limitOf(s), raw);
+    const h = try s.command(.{ .kind = .mixed, .object = piece.seq.rank_id, .arg = seqs.len, .flags = @intCast(piece.ids.len), .bytes = @intCast(bytes.len) }, bytes);
+    errdefer s.poison();
+    const ops: mtp.Ops(Tri) = .{ .e = s.engine, .tri = tri, .h = undefined };
+    try ops.mixedTarget(piece, seqs, ds, idss, out);
+    try s.ack(h);
+}
+
+/// Rank 1: every check before any state moves, then the same round (the piece keeps no hidden streams here).
+pub fn receive(s: *Session, comptime Tri: type, tri: Tri, h: wire.Header, payload: []const u8, logits: u64) !void {
+    if (!s.drafting or !knobs.mixedRounds()) return error.UnsupportedRankOperation;
+    const f = try decode(payload, @intCast(h.arg), @intCast(h.flags), verify_rows.limitOf(s));
+    const q = s.seqs.get(h.object) orelse return error.UnknownRankSequence;
+    if (q.fed + f.piece.len / 4 > q.cap) return error.PromptTooLong;
+    const ids = try s.gpa.alloc(u32, f.piece.len / 4);
+    defer s.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = std.mem.readInt(u32, f.piece[i * 4 ..][0..4], .little);
+    var b: verify_rows.Bound = .{};
+    try b.bind(s, &f.windows, h.object);
+    const ops: mtp.Ops(Tri) = .{ .e = s.engine, .tri = tri, .h = undefined };
+    try ops.mixedTarget(.{ .seq = q, .ids = ids }, b.seqs[0..b.count], b.ds[0..b.count], b.idss[0..b.count], logits);
+}
+
+test "a mixed frame round-trips and refuses a short piece, a bad token, a bad split and an oversized piece" {
+    var raw: [verify_rows.max_bytes + 4 * 512]u8 = undefined;
+    const ids = [_]u64{ 3, 9 };
+    const w0 = [_]u32{ 5, 6, 7 };
+    const w1 = [_]u32{8};
+    const idss = [_][]const u32{ &w0, &w1 };
+    var piece: [256]u32 = undefined;
+    for (&piece, 0..) |*t, i| t.* = @intCast(i * 11 % wt.vocab);
+    const bytes = try encode(&ids, &idss, &piece, 128, &raw);
+    try std.testing.expectEqual(@as(usize, 12 * 2 + 4 * 4 + 4 * 256), bytes.len);
+    const f = try decode(bytes, 2, 256, 128);
+    try std.testing.expectEqual(@as(usize, 2), f.windows.count);
+    try std.testing.expectEqual(@as(u64, 9), f.windows.ids[1]);
+    try std.testing.expectEqual(@as(u32, 3), f.windows.rows[0]);
+    try std.testing.expectEqual(@as(usize, 4 * 256), f.piece.len);
+    try std.testing.expectEqual(piece[255], std.mem.readInt(u32, f.piece[255 * 4 ..][0..4], .little));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes, 2, 255, 128));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes, 2, 0, 128));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes, 2, max_piece + 1, 128));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes[0..16], 2, 256, 128));
+    var bad: [verify_rows.max_bytes + 4 * 512]u8 = undefined;
+    @memcpy(bad[0..bytes.len], bytes);
+    std.mem.writeInt(u32, bad[bytes.len - 4 ..][0..4], wt.vocab, .little);
+    try std.testing.expectError(error.InvalidToken, decode(bad[0..bytes.len], 2, 256, 128));
+    try std.testing.expect(shapeOk(.{ .kind = .mixed, .object = 4, .arg = 2, .flags = 256, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .mixed, .object = 0, .arg = 2, .flags = 256, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .mixed, .object = 4, .arg = 0, .flags = 256, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .mixed, .object = 4, .arg = 2, .flags = 0, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .mixed, .object = 4, .arg = verify_rows.max_windows + 1, .flags = 256, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .mixed, .object = 4, .arg = 2, .flags = max_piece + 1, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .mixed, .object = 4, .arg = 2, .flags = 256, .bytes = 16 * 2 + 4 * 256 - 1 }));
+}
