diff --git a/zig/src/cuda/qmmf8.zig b/zig/src/cuda/qmmf8.zig
new file mode 100644
index 0000000000000000000000000000000000000000..65659e2173c66c9c27a78a3a9365398fd7638a58
--- /dev/null
+++ b/zig/src/cuda/qmmf8.zig
@@ -0,0 +1,102 @@
+//! MXFP8 weights times MXFP8-quantised prompt rows on the block-scaled FP8 mma (qmmf_fp8.cu, sm_120a and sm_121a).
+const std = @import("std");
+const driver = @import("driver.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const kernels = @import("kernels.zig");
+
+const Driver = driver.Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+pub const rows = 128;
+pub const group = 64;
+pub const wide_min_n: usize = 4096;
+const stage_narrow: u32 = (rows * group + 128 * group + 128 * 2 + rows * 2 + 127) / 128 * 128;
+const stage_wide: u32 = (rows * group + 256 * group + 256 * 2 + rows * 2 + 127) / 128 * 128;
+pub const shared_narrow: u32 = 4 * stage_narrow;
+pub const shared_wide: u32 = 3 * stage_wide;
+
+pub fn paddedRows(m: usize) usize {
+    return (m + rows - 1) / rows * rows;
+}
+
+/// Scratch bytes a call quantises its rows into: e4m3 codes [m][k], then one UE8M0 byte a 32 [k/64][Mp][2].
+pub fn scratchBytes(m: usize, k: usize) usize {
+    return m * k + (k / group) * paddedRows(m) * 2;
+}
+
+pub const Fp8 = struct {
+    mod: Module,
+    quant: Function,
+    mm: [2][2]Function,
+
+    pub fn load(d: *const Driver) !Fp8 {
+        if (!kernels.available or kernels.qmmf_fp8.len == 0) return error.BuiltWithoutKernels;
+        var mod = try Module.load(d, kernels.qmmf_fp8);
+        errdefer mod.unload();
+        var f: Fp8 = .{ .mod = mod, .quant = try mod.function("tf_qmmf8_quant"), .mm = undefined };
+        const names = [2][2][:0]const u8{ .{ "tf_qmmf8_mm_bf16", "tf_qmmf8_mm_f32" }, .{ "tf_qmmf8_mmw_bf16", "tf_qmmf8_mmw_f32" } };
+        for (&f.mm, names, [_]u32{ shared_narrow, shared_wide }) |*set, row, bytes| for (set, row) |*fn_, name| {
+            fn_.* = try mod.function(name);
+            try fn_.allowDynamicShared(bytes);
+        };
+        return f;
+    }
+
+    pub fn unload(f: *Fp8) void {
+        f.mod.unload();
+    }
+
+    /// The rows of x quantised to e4m3 a 32 with a UE8M0 scale into `scratch` (scratchBytes).
+    pub fn quantise(f: Fp8, s: Stream, x: u64, ldx: usize, m: usize, k: usize, scratch: u64) !void {
+        if (scratch == 0) return error.MissingLanePart;
+        const total = m * (k / 32);
+        var args: launch_.Args = .{};
+        args.add(x);
+        args.add(@as(i32, @intCast(ldx)));
+        args.add(@as(i32, @intCast(m)));
+        args.add(@as(i32, @intCast(k)));
+        args.add(scratch);
+        args.add(scratch + m * k);
+        args.add(@as(i32, @intCast(paddedRows(m))));
+        try launch_.launch(f.quant, .{
+            .grid = .{ .x = @intCast((total + 255) / 256), .y = 1, .z = 1 },
+            .block = .{ .x = 256, .y = 1, .z = 1 },
+        }, s, &args);
+    }
+
+    /// y [m, n] = quantised rows in `scratch` times the weight (codes, scales, tensor scale, n, k, npad).
+    pub fn product(f: Fp8, s: Stream, m: usize, codes: u64, scales: u64, scale: f32, n: usize, k: usize, npad: usize, y: u64, f32_out: bool, scratch: u64, wide: bool) !void {
+        const bn: usize = if (wide) 256 else 128;
+        const rows_t = (m + rows - 1) / rows;
+        const band = @max(1, @min(rows_t, (12 << 20) / (rows * k)));
+        var args: launch_.Args = .{};
+        args.add(scratch);
+        args.add(scratch + m * k);
+        args.add(@as(i32, @intCast(paddedRows(m))));
+        args.add(codes);
+        args.add(scales);
+        args.add(scale);
+        args.add(y);
+        args.add(@as(i32, @intCast(m)));
+        args.add(@as(i32, @intCast(n)));
+        args.add(@as(i32, @intCast(k)));
+        args.add(@as(i32, @intCast(npad)));
+        args.add(@as(i32, @intCast(band)));
+        try launch_.launch(f.mm[@intFromBool(wide)][@intFromBool(f32_out)], .{
+            .grid = .{ .x = @intCast(rows_t * ((n + bn - 1) / bn)), .y = 1, .z = 1 },
+            .block = .{ .x = if (wide) 512 else 256, .y = 1, .z = 1 },
+            .shared = if (wide) shared_wide else shared_narrow,
+        }, s, &args);
+    }
+};
+
+test "the FP8 tiles fit every target's opt-in shared memory and their scratch holds codes and scales" {
+    try std.testing.expectEqual(@as(u32, 67584), shared_narrow);
+    try std.testing.expectEqual(@as(u32, 76032), shared_wide);
+    try std.testing.expectEqual(@as(usize, 1536 * 2560 + 40 * 1536 * 2), scratchBytes(1536, 2560));
+    try std.testing.expectEqual(@as(usize, 77 * 3072 + 48 * 128 * 2), scratchBytes(77, 3072));
+}
