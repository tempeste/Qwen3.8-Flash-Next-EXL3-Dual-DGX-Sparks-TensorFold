diff --git a/zig/src/core/lanes/prompt_lookup_test.zig b/zig/src/core/lanes/prompt_lookup_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1a12cdfdf56353b7b00575db4f7d67640ce98fe6
--- /dev/null
+++ b/zig/src/core/lanes/prompt_lookup_test.zig
@@ -0,0 +1,211 @@
+//! Model.copy_growth, weigh_copies and chain_copies: which continuation a stream's context proposes, and when.
+const std = @import("std");
+const lanes = @import("lanes.zig");
+const win = @import("windows.zig");
+
+const a = std.testing.allocator;
+
+const Chances = struct {
+    value: f64 = 0.95,
+    fn chances(ptr: *anyopaque, _: *lanes.Stream, out: []f64) !bool {
+        const c: *Chances = @ptrCast(@alignCast(ptr));
+        @memset(out, c.value);
+        return true;
+    }
+};
+
+fn span(comptime from: u32, comptime n: usize) [n]u32 {
+    var out: [n]u32 = undefined;
+    for (&out, 0..) |*t, i| t.* = from + @as(u32, @intCast(i));
+    return out;
+}
+
+const copied_span = span(100, 60);
+const filler = span(500, 70);
+const prompt = copied_span ++ filler;
+
+const Rig = struct {
+    cfg: lanes.Config,
+    target: lanes.fake.Fake,
+    chances: Chances = .{},
+    vtable: lanes.backend.Backend.VTable = undefined,
+    clock: lanes.fake.FixedClock = .{},
+    e: lanes.Engine = undefined,
+    look: lanes.SuffixLookup,
+    s: lanes.Stream = undefined,
+
+    fn init(r: *Rig, on: bool, reply: []const u32) !void {
+        r.* = .{ .cfg = try lanes.Config.init(a, .{ .exact_width = 32, .first_copy_rows = 16, .batch_rows = 64, .drafts = 6, .mtp = true, .speculate = true, .speculate_early = false, .draft_probabilities = true, .hidden_rows = true, .max_streams = 28, .own_copy_rates = on, .copy_growth = on, .weigh_copies = on, .chain_copies = on }, 32, 31), .target = .{ .gpa = a }, .look = try lanes.SuffixLookup.init(a, .{ .min_match = 4 }) };
+        r.vtable = r.target.backend().vtable.*;
+        r.vtable.probabilities = Chances.chances;
+        r.e = lanes.Engine.init(a, &r.cfg, .{ .ptr = &r.chances, .vtable = &r.vtable }, r.clock.clock());
+        r.e.alone = false;
+        r.s = try lanes.Stream.init(a, .{ .id = "lookup", .prompt = &prompt, .max_new = 4096, .proposer = r.look.proposer() });
+        try r.s.context.appendSlice(a, &span(700, 64));
+        try r.s.context.appendSlice(a, reply);
+    }
+
+    fn deinit(r: *Rig) void {
+        r.s.deinit(a);
+        r.look.deinit();
+        r.e.deinit();
+        r.target.deinit();
+        r.cfg.deinit(a);
+    }
+
+    fn hold(r: *Rig, drafts: []const u32) !void {
+        r.s.next = .{ .count = @intCast(drafts.len), .tokens = try a.dupe(u32, drafts) };
+    }
+};
+
+test "prompt lookup: the newest longest match of the history's suffix proposes what followed it, a drafted tail only as query" {
+    var look = try lanes.SuffixLookup.init(a, .{ .min_match = 4 });
+    defer look.deinit();
+    const history = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8, 40, 41 } ++ [_]u32{ 9, 3, 4, 5, 6, 7, 8, 50, 51 } ++ [_]u32{ 0, 2, 3, 4, 5, 6, 7, 8 };
+    try std.testing.expectEqualSlices(u32, &.{ 40, 41, 9 }, try look.proposeAfter(&history, &.{}, 3));
+    try std.testing.expectEqual(@as(i64, 7), look.last_match);
+    const shorter = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8, 40, 41 } ++ [_]u32{ 9, 3, 4, 5, 6, 7, 8, 50, 51 } ++ [_]u32{ 0, 4, 5, 6, 7, 8 };
+    try std.testing.expectEqualSlices(u32, &.{ 50, 51 }, try look.proposeAfter(&shorter, &.{}, 2));
+    try std.testing.expectEqual(@as(i64, 5), look.last_match);
+    const asked = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8, 40, 41, 9, 20, 1, 2, 3, 4, 5 };
+    try std.testing.expectEqualSlices(u32, &.{ 40, 41, 9 }, try look.proposeAfter(&asked, &.{ 6, 7, 8 }, 3));
+    try std.testing.expectEqual(@as(i64, 8), look.last_match);
+    try std.testing.expectEqual(@as(usize, 0), (try look.proposeAfter(&asked, &.{ 77, 78, 79, 80, 77, 78, 79 }, 3)).len);
+}
+
+test "prompt lookup: a shared round's copy widens to the window once its stream's copies land whole, only with copy_growth" {
+    for ([_]bool{ false, true }) |on| {
+        var r: Rig = undefined;
+        try r.init(on, copied_span[0..10]);
+        defer r.deinit();
+        r.s.copy_width = 31;
+        const copy = try win.copyProposal(&r.e, &r.s);
+        try std.testing.expectEqual(@as(usize, if (on) 31 else 15), copy.tokens.len);
+        try std.testing.expectEqualSlices(u32, copied_span[10..][0..copy.tokens.len], copy.tokens);
+    }
+}
+
+test "prompt lookup: a short match in the reply loses to a head chain that expects more, then continues it from the context" {
+    for ([_]bool{ false, true }) |on| {
+        var r: Rig = undefined;
+        try r.init(on, copied_span[0..10]);
+        defer r.deinit();
+        for (0..8) |_| win.observeCopied(&r.e, &r.s, false, 1, 15);
+        try r.hold(&.{ 110, 111, 112 });
+        const p = try win.plan(&r.e, &r.s, null);
+        if (!on) {
+            try std.testing.expectEqual(win.Kind.copy, p.kind);
+            try std.testing.expectEqualSlices(u32, copied_span[10..25], p.tokens);
+            continue;
+        }
+        try std.testing.expectEqual(win.Kind.head, p.kind);
+        try std.testing.expectEqualSlices(u32, copied_span[10..41], p.tokens);
+        try std.testing.expect(p.context_copy and p.parents == null);
+        try std.testing.expectEqual(@as(u32, 4), p.branch_from);
+    }
+}
+
+test "prompt lookup: a long match keeps its copy window, and a head chain the context does not follow stays the head's" {
+    {
+        var r: Rig = undefined;
+        try r.init(true, copied_span[0..24]);
+        defer r.deinit();
+        for (0..8) |_| win.observeCopied(&r.e, &r.s, false, 1, 15);
+        try r.hold(&.{ 124, 125, 126 });
+        const p = try win.plan(&r.e, &r.s, null);
+        try std.testing.expectEqual(win.Kind.copy, p.kind);
+        try std.testing.expectEqualSlices(u32, copied_span[24..39], p.tokens);
+    }
+    {
+        var r: Rig = undefined;
+        try r.init(true, copied_span[0..10]);
+        defer r.deinit();
+        for (0..8) |_| win.observeCopied(&r.e, &r.s, false, 1, 15);
+        try r.hold(&.{ 900, 901, 902 });
+        const p = try win.plan(&r.e, &r.s, null);
+        try std.testing.expectEqual(win.Kind.head, p.kind);
+        try std.testing.expectEqualSlices(u32, &.{ 900, 901, 902 }, p.tokens);
+        try std.testing.expect(!p.context_copy and p.branch_from == 0);
+    }
+}
+
+test "prompt lookup: an untrusted copy whose stream's copies land takes the round from a weaker head chain" {
+    var r: Rig = undefined;
+    try r.init(true, copied_span[0..10]);
+    defer r.deinit();
+    r.chances.value = 0.3;
+    try r.hold(&.{ 110, 111, 112 });
+    const p = try win.plan(&r.e, &r.s, null);
+    try std.testing.expectEqual(win.Kind.copy, p.kind);
+    try std.testing.expectEqualSlices(u32, copied_span[10..25], p.tokens);
+}
+
+test "prompt lookup: expected tokens are the head chain's summed chances and a copy's compounding landing rate" {
+    try std.testing.expectApproxEqAbs(@as(f64, 2.4), win.expectedHead(&.{ 0.9, 0.8, 0.7 }), 1e-12);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5 + 0.25 + 0.125), win.expectedCopy(0.5, 3), 1e-12);
+    try std.testing.expectEqual(@as(f64, 0), win.expectedCopy(0.9, 0));
+}
+
+fn noise(comptime n: usize, seed: u32) [n]u32 {
+    var out: [n]u32 = undefined;
+    var x: u32 = seed;
+    for (&out) |*t| {
+        x = x *% 1103515245 +% 12345;
+        t.* = (x >> 16) % 90;
+    }
+    return out;
+}
+
+const Served = struct { emitted: [4][]u32, copied: u64 = 0, copies_kept: u64 = 0, rounds: u64 = 0 };
+
+fn serve(lookup: ?bool) !Served {
+    var costs: [96]lanes.config.Cost = undefined;
+    for (&costs, 1..) |*c, w| c.* = .{ .width = @intCast(w), .ms = 5.0 + 0.2 * @as(f64, @floatFromInt(w)) };
+    const on = lookup orelse false;
+    var cfg = try lanes.Config.init(a, .{ .exact_width = 32, .first_copy_rows = 8, .gpu_tokens = true, .mtp = true, .speculate = true, .speculate_early = false, .drafts = 4, .window_costs = costs[0..32], .shared_costs = &costs, .mtp_step_ms = 0.5, .hidden_rows = true, .batch_rows = 96, .max_streams = 8, .draft_streams = true, .own_copy_rates = on, .copy_growth = on, .weigh_copies = on, .chain_copies = on }, 32, 31);
+    defer cfg.deinit(a);
+    const spans = [_][24]u32{ noise(24, 3), noise(24, 5), noise(24, 7), noise(24, 11) };
+    var target: lanes.fake.Fake = .{ .gpa = a, .cycle_after = 0, .probe_prompt = 96, .pattern = &spans[0] };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var e = lanes.Engine.init(a, &cfg, target.backend(), clock.clock());
+    defer e.deinit();
+    var prompts: [4][96]u32 = undefined;
+    for (&prompts, 0..) |*p, i| p.* = noise(40, @intCast(13 + i)) ++ spans[0] ++ noise(32, @intCast(17 + i));
+    var looks: [4]lanes.SuffixLookup = undefined;
+    var streams: [4]lanes.Stream = undefined;
+    for (&looks, &streams, &prompts) |*l, *s, *p| {
+        l.* = try lanes.SuffixLookup.init(a, .{ .min_match = 4 });
+        s.* = try lanes.Stream.init(a, .{ .id = "served", .prompt = p, .max_new = 120, .eos = &.{96}, .drafts = lookup != null, .proposer = l.proposer() });
+    }
+    defer for (&looks, &streams) |*l, *s| {
+        s.deinit(a);
+        l.deinit();
+    };
+    for (&streams) |*s| try e.addStream(s);
+    while (e.activeCount() > 0) try e.step();
+    var out: Served = .{ .emitted = undefined };
+    for (&out.emitted, &streams) |*o, *s| {
+        o.* = try a.dupe(u32, s.emitted());
+        out.copied += s.copied;
+        out.copies_kept += s.copies_kept;
+        out.rounds += s.rounds;
+    }
+    return out;
+}
+
+test "prompt lookup: shared streams replying a span of their prompts emit the undrafted tokens, with fewer rounds" {
+    const plain = try serve(null);
+    defer for (plain.emitted) |o| a.free(o);
+    const before = try serve(false);
+    defer for (before.emitted) |o| a.free(o);
+    const with = try serve(true);
+    defer for (with.emitted) |o| a.free(o);
+    for (plain.emitted, before.emitted, with.emitted) |p, b, w| {
+        try std.testing.expectEqual(@as(usize, 120), p.len);
+        try std.testing.expectEqualSlices(u32, p, b);
