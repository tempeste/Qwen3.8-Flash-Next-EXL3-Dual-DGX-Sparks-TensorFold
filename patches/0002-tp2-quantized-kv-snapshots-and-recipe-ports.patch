+    float acc[MT][2][4];
+#pragma unroll
+    for (int i = 0; i < MT; ++i)
+#pragma unroll
+        for (int j = 0; j < 2; ++j)
+#pragma unroll
+            for (int e = 0; e < 4; ++e) acc[i][j][e] = 0.0f;
+    if constexpr (DBG != 2) {
+#pragma unroll
+        for (int g = 0; g < KG; ++g)
+#pragma unroll
+            for (int kt = 0; kt < 4; ++kt) {
+                uint32_t a[MT][4];
+#pragma unroll
+                for (int i = 0; i < MT; ++i) {
+                    const int r = i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
