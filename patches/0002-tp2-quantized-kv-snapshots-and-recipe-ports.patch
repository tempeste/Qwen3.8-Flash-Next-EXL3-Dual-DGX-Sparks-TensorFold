+    }
+    for (int c = tid; c < BM * SS * 4; c += 256) {
+        const int r = c / (SS * 4), s = (c >> 2) % SS, q = c & 3, row = min(m0 + r, M - 1);
+        cp16z(reinterpret_cast<unsigned char*>(Hs) + ((r * SS + s) * 32 + q * 8) * 2,
