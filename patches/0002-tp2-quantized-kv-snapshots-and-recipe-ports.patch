+//! MXFP8 cuts under the head split: rows keep their codes with their own scale bytes, column cuts keep whole 64-input
+//! stages, the stitched head cut keeps each part's ranged rows, and a cut weight packs and plans as the whole one.
+const std = @import("std");
+const cuda = @import("cuda");
+const source = @import("cuda_projection_load.zig");
+const heads_cut = @import("heads_cut.zig");
+const dense_split = @import("cuda_dense_split.zig");
+const Cut = @import("cuda_modelopt_experts.zig").Cut;
+const Heads = @import("cuda_heads.zig").Heads;
+const Micro = source.Micro;
+const mx = cuda.mxfp8;
+const qmmf = cuda.qmmf;
+
+/// A synthetic [n, k] MXFP8 weight: distinct codes (no e4m3 NaN) and scale bytes that differ from their neighbours.
+fn synthetic(a: std.mem.Allocator, n: usize, k: usize) !Micro {
+    const codes = try a.alloc(u8, n * k);
+    errdefer a.free(codes);
+    for (codes, 0..) |*c, i| {
+        const v: u8 = @truncate(i *% 29 +% i / 251);
+        c.* = if (v & 0x7f == 0x7f) v ^ 1 else v;
+    }
+    const scales = try a.alloc(u8, n * k / 32);
+    for (scales, 0..) |*s, i| s.* = @truncate(100 + (i * 7) % 51);
+    return .{ .n = n, .k = k, .codes = codes, .scales = scales };
+}
+
+test "MXFP8 row and column cuts keep each code with its own scale byte, and two ranks cover every code once" {
+    const a = std.testing.allocator;
+    var whole = try synthetic(a, 6, 256);
+    defer whole.deinit(a);
+    var seen_rows: [6 * 256]u8 = @splat(0);
+    var seen_cols: [6 * 256]u8 = @splat(0);
+    for (0..2) |r| {
+        var rows = try source.cutMicro(a, whole, .{ .from = 3 * r, .to = 3 * r + 3 }, .rows);
+        defer rows.deinit(a);
+        try std.testing.expectEqual(@as(usize, 3), rows.n);
+        try std.testing.expectEqual(@as(usize, 256), rows.k);
+        for (0..3) |row| for (0..256) |c| {
+            const src = (3 * r + row) * 256 + c;
+            try std.testing.expectEqual(whole.codes[src], rows.codes[row * 256 + c]);
+            // a code's scale is its own row's byte for its 32 inputs, in the cut as in the whole
+            try std.testing.expectEqual(whole.scales[(3 * r + row) * 8 + c / 32], rows.scales[row * 8 + c / 32]);
+            seen_rows[src] += 1;
+        };
+        const half = try Cut.init(256, 2, r);
+        var cols = try source.cutMicro(a, whole, half, .cols);
+        defer cols.deinit(a);
+        try std.testing.expectEqual(@as(usize, 6), cols.n);
+        try std.testing.expectEqual(@as(usize, 128), cols.k);
+        for (0..6) |row| for (0..128) |c| {
+            const src = row * 256 + half.from + c;
+            try std.testing.expectEqual(whole.codes[src], cols.codes[row * 128 + c]);
+            try std.testing.expectEqual(whole.scales[row * 8 + (half.from + c) / 32], cols.scales[row * 4 + c / 32]);
+            seen_cols[src] += 1;
+        };
+    }
+    for (seen_rows, seen_cols) |r, c| {
+        try std.testing.expectEqual(@as(u8, 1), r);
+        try std.testing.expectEqual(@as(u8, 1), c);
+    }
+}
+
+test "an MXFP8 column cut that splits a scale byte's 32 inputs or a 64-input stage is refused, as are bad cuts and planes" {
+    const a = std.testing.allocator;
+    var whole = try synthetic(a, 4, 256);
+    defer whole.deinit(a);
+    // inside a scale byte (from 16), on a scale byte but inside a stage (from 32, width 96), a stage but not its end
+    for ([_]Cut{ .{ .from = 16, .to = 144 }, .{ .from = 32, .to = 160 }, .{ .from = 64, .to = 160 }, .{ .from = 0, .to = 96 } }) |c|
+        try std.testing.expectError(error.UnexpectedTensor, source.cutMicro(a, whole, c, .cols));
+    for ([_]Cut{ .{ .from = 2, .to = 2 }, .{ .from = 3, .to = 5 } }) |c| try std.testing.expectError(error.UnexpectedTensor, source.cutMicro(a, whole, c, .rows));
+    try std.testing.expectError(error.UnexpectedTensor, source.cutMicro(a, whole, .{ .from = 192, .to = 320 }, .cols));
+    var short = whole;
+    short.scales = whole.scales[1..];
+    try std.testing.expectError(error.UnexpectedTensor, source.cutMicro(a, short, .{ .from = 0, .to = 2 }, .rows));
+    var odd = whole;
+    odd.k = 224;
+    odd.codes = whole.codes[0 .. 4 * 224];
+    odd.scales = whole.scales[0 .. 4 * 7];
+    try std.testing.expectError(error.UnexpectedTensor, source.cutMicro(a, odd, .{ .from = 0, .to = 2 }, .rows));
+}
+
+fn cutTrial(a: std.mem.Allocator) !void {
+    var whole = try synthetic(a, 6, 256);
+    defer whole.deinit(a);
+    var rows = try source.cutMicro(a, whole, .{ .from = 1, .to = 4 }, .rows);
+    rows.deinit(a);
+    var cols = try source.cutMicro(a, whole, .{ .from = 64, .to = 192 }, .cols);
+    cols.deinit(a);
+}
+
+test "MXFP8 cuts free every allocation on failure" {
+    try std.testing.checkAllAllocationFailures(std.testing.allocator, cutTrial, .{});
+}
+
+/// One weight's stored parts at 64 inputs, as `Whole` in cuda_projection_load_test.zig: each read overwrites the last.
+const Parts = struct {
+    const names = [_][]const u8{ "in_proj_qkv", "in_proj_z", "in_proj_b", "in_proj_a", "q_proj", "k_proj", "v_proj", "indexer.index_qk_proj" };
+    const counts = [_]usize{ 10240, 6144, 48, 48, 12288, 512, 512, 640 };
+    const k = 64;
+
+    fn find(name: []const u8) !struct { p: usize, scale: bool } {
+        const scale = std.mem.endsWith(u8, name, ".weight_scale");
+        const suffix: []const u8 = if (scale) ".weight_scale" else ".weight";
+        if (!std.mem.startsWith(u8, name, "root.") or !std.mem.endsWith(u8, name, suffix)) return error.MissingTensor;
+        const stem = name["root.".len .. name.len - suffix.len];
+        for (names, 0..) |n, i| if (std.mem.eql(u8, n, stem)) return .{ .p = i, .scale = scale };
+        return error.MissingTensor;
+    }
+
+    /// Code `i` of part `p` (or its scale byte): a value of the part and position, never an e4m3 NaN.
+    fn byte(p: usize, i: usize, scale: bool) u8 {
+        const x: u32 = @truncate((i + p * 0x1000003 + @as(usize, @intFromBool(scale)) * 0x77) *% 0x9E3779B1);
+        const v: u8 = @truncate(x >> 24);
+        return if (!scale and v & 0x7f == 0x7f) v ^ 1 else v;
+    }
+
+};
+
+const Store = struct {
+    scratch: []u8,
+
+    pub fn tensor(self: *Store, name: []const u8) !@import("core").safetensors.Tensor {
+        const f = try Parts.find(name);
+        const n = Parts.counts[f.p];
+        const cols: usize = if (f.scale) Parts.k / 32 else Parts.k;
+        @memset(self.scratch, 0xee);
+        for (self.scratch[0 .. n * cols], 0..) |*v, i| v.* = Parts.byte(f.p, i, f.scale);
+        return .{ .dtype = if (f.scale) .u8 else .f8_e4m3, .rank = 2, .shape = .{ n, cols, 1, 1, 1 }, .bytes = self.scratch[0 .. n * cols] };
+    }
+};
+
+test "the head split's MXFP8 stitched cut keeps each part's ranged code rows with their scale rows, every row once" {
+    const a = std.testing.allocator;
+    var store: Store = .{ .scratch = try a.alloc(u8, 12288 * Parts.k) };
+    defer a.free(store.scratch);
+    const k = Parts.k;
+    for ([_]bool{ true, false }) |linear| {
+        const parts = if (linear) heads_cut.delta_parts else heads_cut.attention_parts;
+        const first: usize = if (linear) 0 else 4;
+        var seen: [4][12288]u8 = @splat(@splat(0));
+        for (0..2) |r| {
+            const s = if (linear) try heads_cut.delta(.half, r) else try heads_cut.attention(.half, r);
+            var cut = try source.stitchCutMicro(a, &store, "root", &parts, &s.ranges, s.n, k);
+            defer cut.deinit(a);
+            try std.testing.expectEqual(s.n, cut.n);
+            try std.testing.expectEqual(s.n * k, cut.codes.len);
+            try std.testing.expectEqual(s.n * k / 32, cut.scales.len);
+            var row: usize = 0;
+            for (s.ranges, 0..) |kept, i| for (kept.items()) |c| for (c.from..c.to) |src| {
+                for (0..k) |j| try std.testing.expectEqual(Parts.byte(first + i, src * k + j, false), cut.codes[row * k + j]);
+                for (0..k / 32) |j| try std.testing.expectEqual(Parts.byte(first + i, src * (k / 32) + j, true), cut.scales[row * (k / 32) + j]);
+                seen[i][src] += 1;
+                row += 1;
+            };
+            try std.testing.expectEqual(s.n, row);
+        }
+        for (0..4) |i| for (seen[i][0..Parts.counts[first + i]]) |count| {
+            // the indexer is whole on both ranks; every other row is one rank's
+            try std.testing.expectEqual(@as(u8, if (!linear and i == 3) 2 else 1), count);
+        };
+    }
+}
+
+fn stitchTrial(a: std.mem.Allocator) !void {
+    var store: Store = .{ .scratch = try a.alloc(u8, 12288 * Parts.k) };
+    defer a.free(store.scratch);
+    const s = try heads_cut.attention(.half, 1);
+    var cut = try source.stitchCutMicro(a, &store, "root", &heads_cut.attention_parts, &s.ranges, s.n, Parts.k);
+    cut.deinit(a);
+}
+
+test "the MXFP8 stitched cut frees every allocation on failure, and refuses a wrong row count or width" {
+    const a = std.testing.allocator;
+    try std.testing.checkAllAllocationFailures(a, stitchTrial, .{});
+    var store: Store = .{ .scratch = try a.alloc(u8, 12288 * Parts.k) };
+    defer a.free(store.scratch);
+    const s = try heads_cut.delta(.half, 0);
+    try std.testing.expectError(error.UnexpectedTensor, source.stitchCutMicro(a, &store, "root", &heads_cut.delta_parts, &s.ranges, s.n + 1, Parts.k));
+    try std.testing.expectError(error.UnexpectedTensor, source.stitchCutMicro(a, &store, "root", &heads_cut.delta_parts, &s.ranges, s.n, 128));
+    try std.testing.expectError(error.UnexpectedTensor, source.stitchCutMicro(a, &store, "root", heads_cut.delta_parts[0..3], &s.ranges, s.n, Parts.k));
+}
+
+/// A split projection of the model: its stored [n, k] and the rows each of two ranks keeps.
+const Shape = struct { name: []const u8, n: usize, k: usize };
+
+/// Every projection the split cuts by output rows (cuda_prompt_load.zig, cuda_mixed_experts.zig), stored [n, k].
+const split_shapes = [_]Shape{
+    .{ .name = "linear_attn.in_proj_qkv", .n = 10240, .k = 2560 },
+    .{ .name = "linear_attn.in_proj_z", .n = 6144, .k = 2560 },
+    .{ .name = "linear_attn.in_proj_b", .n = 48, .k = 2560 },
+    .{ .name = "linear_attn.in_proj_a", .n = 48, .k = 2560 },
+    .{ .name = "self_attn.q_proj", .n = 12288, .k = 2560 },
+    .{ .name = "self_attn.k_proj", .n = 512, .k = 2560 },
+    .{ .name = "self_attn.v_proj", .n = 512, .k = 2560 },
+    .{ .name = "self_attn.indexer.index_qk_proj", .n = 640, .k = 2560 },
+    .{ .name = "linear_attn.out_proj", .n = 2560, .k = 6144 },
+    .{ .name = "self_attn.o_proj", .n = 2560, .k = 6144 },
+    .{ .name = "mlp.shared_expert.gate_proj", .n = 640, .k = 2560 },
+    .{ .name = "mlp.shared_expert.up_proj", .n = 640, .k = 2560 },
+    .{ .name = "mlp.shared_expert.down_proj", .n = 2560, .k = 640 },
+};
+
+test "no head boundary of the split falls inside an MXFP8 scale block: every cut keeps whole rows of the whole K" {
+    for (split_shapes) |s| {
+        // a row's scale bytes cover its K in blocks of 32, and the lane reads K in stages of 64: both whole
+        try std.testing.expect(s.k % qmmf.group == 0 and s.k % mx.group == 0);
+        var buf: [96]u8 = undefined;
+        if (dense_split.axisOf(try std.fmt.bufPrint(&buf, "{s}.weight", .{s.name}))) |axis| try std.testing.expectEqual(source.Axis.rows, axis);
+    }
+    // the stitched cuts keep rows of the parts at the input width, 2,560: 80 whole scale bytes a row
+    for (0..2) |r| for ([_]heads_cut.Stitch{ try heads_cut.delta(.half, r), try heads_cut.attention(.half, r) }) |st| {
+        var rows: usize = 0;
