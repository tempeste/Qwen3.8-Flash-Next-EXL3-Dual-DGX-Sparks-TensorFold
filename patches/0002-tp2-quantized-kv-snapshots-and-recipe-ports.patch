diff --git a/zig/src/families/flashnext/cuda_index_split.zig b/zig/src/families/flashnext/cuda_index_split.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0d01fbcf63f1c955c2d902e9b084b6af03241420
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_index_split.zig
@@ -0,0 +1,213 @@
+//! Design A of docs/flashnext-tp2-indexer-split.md, on the host only: the pooled indexer blocks split by position across two
+//! ranks, each rank's local top-k, and the merge that gives one GPU's selection. No kernel launches this yet; it is the
+//! reference the device work would be held to.
+//!
+//! Blocks alternate between the ranks in groups of 64 (the scores kernel's tile): block b is rank (b / 64) % 2's, at
+//! local row (b / 128) * 64 + b % 64, so local order follows global order.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+
+pub const group: usize = 64;
+const ratio = wt.index_ratio;
+const top = wt.index_top;
+
+pub fn owner(b: usize) usize {
+    return (b / group) % 2;
+}
+
+pub fn local(b: usize) usize {
+    return (b / (2 * group)) * group + b % group;
+}
+
+/// The global block of rank `rank`'s local row `l`.
+pub fn global(rank: usize, l: usize) usize {
+    return (l / group) * 2 * group + rank * group + l % group;
+}
+
+/// Rank `rank`'s share of blocks 0 .. blocks - 1.
+pub fn localCount(blocks: usize, rank: usize) usize {
+    const pairs = blocks / (2 * group);
+    const rest = blocks % (2 * group);
+    const extra = if (rank == 0) @min(rest, group) else rest -| group;
+    return pairs * group + extra;
+}
+
+/// One attention layer's pooled rows a rank holds for a `cap`-token stream.
+pub fn pooledBytes(cap: usize, rank: usize) usize {
+    return localCount((cap + ratio - 1) / ratio, rank) * wt.index_dim * 2;
+}
+
+/// fn_qsa_key: a score's u32 whose unsigned order is the float order (negative values reversed).
+pub fn key(v: f32) u32 {
+    const bits: u32 = @bitCast(v);
+    return if (bits & 0x8000_0000 != 0) ~bits else bits | 0x8000_0000;
+}
+
+/// One candidate: a block's key and its global index.
+pub const Cand = struct { key: u32, block: u32 };
+
+/// fn_qsa_select_body's choice over `cands` (ascending block): the radix cut for the `want`-th largest key, every key
+/// above it, then the first keys equal to it in list order; written to `out` in list order. Returns how many.
+pub fn radixSelect(cands: []const Cand, want: usize, out: []Cand) usize {
+    if (cands.len <= want) {
+        @memcpy(out[0..cands.len], cands);
+        return cands.len;
+    }
+    var cut: u32 = 0;
+    var need = want;
+    for (0..4) |p| {
+        const shift: u5 = @intCast(24 - 8 * p);
+        var hist: [256]usize = @splat(0);
+        for (cands) |c| {
+            const prefix_ok = p == 0 or (c.key >> (shift + 8)) == (cut >> (shift + 8));
+            if (prefix_ok) hist[(c.key >> shift) & 0xFF] += 1;
+        }
+        var above: usize = 0;
+        var d: usize = 255;
+        while (d > 0) : (d -= 1) {
+            if (above + hist[d] >= need) break;
+            above += hist[d];
+        }
+        need -= above;
+        cut |= @as(u32, @intCast(d)) << shift;
+    }
+    var placed: usize = 0;
+    var seen: usize = 0;
+    for (cands) |c| {
+        const chosen = c.key > cut or (c.key == cut and seen < need);
+        if (c.key == cut) seen += 1;
+        if (!chosen) continue;
+        out[placed] = c;
+        placed += 1;
+    }
+    return placed;
+}
+
+/// Rank `rank`'s candidates for a row of `blocks` complete blocks whose score for global block b is scores[b]:
+/// its own blocks' local top `top` (all of them when fewer), ascending block.
+pub fn candidates(scores: []const f32, blocks: usize, rank: usize, want: usize, scratch: []Cand, out: []Cand) usize {
+    const n = localCount(blocks, rank);
+    for (0..n) |l| {
+        const b = global(rank, l);
+        scratch[l] = .{ .key = key(scores[b]), .block = @intCast(b) };
+    }
+    return radixSelect(scratch[0..n], want, out);
+}
+
+/// The two ranks' candidate lists (each ascending block) as one ascending list, then the same select: one GPU's.
+pub fn merge(a: []const Cand, b: []const Cand, want: usize, scratch: []Cand, out: []Cand) usize {
+    var i: usize = 0;
+    var j: usize = 0;
+    var k: usize = 0;
+    while (i < a.len or j < b.len) : (k += 1) {
+        const take_a = j == b.len or (i < a.len and a[i].block < b[j].block);
+        scratch[k] = if (take_a) a[i] else b[j];
+        if (take_a) i += 1 else j += 1;
+    }
+    return radixSelect(scratch[0..k], want, out);
+}
+
+/// One GPU's choice: the select over every block, ascending.
+pub fn whole(scores: []const f32, blocks: usize, want: usize, scratch: []Cand, out: []Cand) usize {
+    for (0..blocks) |b| scratch[b] = .{ .key = key(scores[b]), .block = @intCast(b) };
+    return radixSelect(scratch[0..blocks], want, out);
+}
+
+test "the layout alternates 64-block groups, is a bijection, and keeps local order in global order" {
+    for (0..2000) |b| {
+        try std.testing.expectEqual(b, global(owner(b), local(b)));
+        if (b > 0 and owner(b) == owner(b - 1)) try std.testing.expectEqual(local(b - 1) + 1, local(b));
+    }
+    try std.testing.expectEqual(@as(usize, 0), owner(63));
+    try std.testing.expectEqual(@as(usize, 1), owner(64));
+    try std.testing.expectEqual(@as(usize, 0), owner(128));
+    try std.testing.expectEqual(@as(usize, 64), local(128));
+    for (0..1000) |blocks| {
+        var counts: [2]usize = .{ 0, 0 };
+        for (0..blocks) |b| counts[owner(b)] += 1;
+        try std.testing.expectEqual(counts[0], localCount(blocks, 0));
+        try std.testing.expectEqual(counts[1], localCount(blocks, 1));
+        try std.testing.expect(localCount(blocks, 0) >= localCount(blocks, 1));
+        try std.testing.expect(localCount(blocks, 0) - localCount(blocks, 1) <= group);
+    }
+}
+
+test "each rank holds half the pooled rows, within one group" {
+    // 262,160 tokens: 65,540 blocks, 32,772 and 32,768 rows a layer
+    try std.testing.expectEqual(@as(usize, 32_772 * 256), pooledBytes(262_160, 0));
+    try std.testing.expectEqual(@as(usize, 32_768 * 256), pooledBytes(262_160, 1));
+    for ([_]usize{ 1, 4, 5, 255, 256, 257, 4096, 262_144 }) |cap| {
+        const both = pooledBytes(cap, 0) + pooledBytes(cap, 1);
+        try std.testing.expectEqual((cap + 3) / 4 * 256, both);
+    }
+}
+
+test "the key orders floats as the device does: negatives below +0, -0 below +0, infinities at the ends" {
+    const xs = [_]f32{ -std.math.inf(f32), -2.5, -0.0, 0.0, 1.0e-30, 0.5, 3.0, std.math.inf(f32) };
+    for (xs[0 .. xs.len - 1], xs[1..]) |a, b| try std.testing.expect(key(a) < key(b));
+}
+
+/// Scores drawn so many blocks tie: a few distinct values, sometimes the same value everywhere.
+fn fill(r: std.Random, scores: []f32, distinct: usize) void {
+    const pool = [_]f32{ 0.0, -0.0, 1.0, 1.0, 2.5, 0.125, 7.0, 3.0e-5, std.math.inf(f32), 1.0e30 };
+    for (scores) |*s| s.* = if (distinct == 0) r.float(f32) * 4 else pool[r.uintLessThan(usize, @min(distinct, pool.len))];
+}
+
+test "the merge of the two ranks' local top-k equals one GPU's selection on random scores with ties" {
+    const a = std.testing.allocator;
+    var prng = std.Random.DefaultPrng.init(0x3970_d);
+    const r = prng.random();
+    const max_blocks = 9000;
+    const scores = try a.alloc(f32, max_blocks);
+    defer a.free(scores);
+    const scratch = try a.alloc(Cand, max_blocks);
+    defer a.free(scratch);
+    const one = try a.alloc(Cand, max_blocks);
+    defer a.free(one);
+    var c0: [top]Cand = undefined;
+    var c1: [top]Cand = undefined;
+    var merged: [2 * top]Cand = undefined;
+    var got: [top]Cand = undefined;
+    for (0..300) |trial| {
+        const blocks = top + 1 + r.uintLessThan(usize, max_blocks - top - 1);
+        fill(r, scores[0..blocks], trial % 6);
+        const n_one = whole(scores, blocks, top, scratch, one);
+        const n0 = candidates(scores, blocks, 0, top, scratch, &c0);
+        const n1 = candidates(scores, blocks, 1, top, scratch, &c1);
+        const n = merge(c0[0..n0], c1[0..n1], top, &merged, &got);
+        try std.testing.expectEqual(top, n_one);
+        try std.testing.expectEqual(n_one, n);
+        try std.testing.expectEqualSlices(Cand, one[0..n_one], got[0..n]);
+        // the order is ascending block, as the device writes ids
+        for (got[0 .. n - 1], got[1..n]) |x, y| try std.testing.expect(x.block < y.block);
+    }
+}
+
+test "the select is the top `want` under (key descending, block ascending), checked against a sort" {
+    var prng = std.Random.DefaultPrng.init(42);
+    const r = prng.random();
+    var scores: [700]f32 = undefined;
+    var scratch: [700]Cand = undefined;
+    var out: [700]Cand = undefined;
+    var sorted: [700]Cand = undefined;
+    for (0..200) |trial| {
+        const blocks = 1 + r.uintLessThan(usize, scores.len);
+        const want = 1 + r.uintLessThan(usize, 600);
+        fill(r, scores[0..blocks], trial % 6);
+        const n = whole(&scores, blocks, want, &scratch, &out);
+        for (0..blocks) |b| sorted[b] = .{ .key = key(scores[b]), .block = @intCast(b) };
+        std.mem.sort(Cand, sorted[0..blocks], {}, struct {
+            fn lt(_: void, x: Cand, y: Cand) bool {
+                return x.key > y.key or (x.key == y.key and x.block < y.block);
+            }
+        }.lt);
+        const k = @min(want, blocks);
+        std.mem.sort(Cand, sorted[0..k], {}, struct {
+            fn lt(_: void, x: Cand, y: Cand) bool {
+                return x.block < y.block;
+            }
+        }.lt);
+        try std.testing.expectEqual(k, n);
+        try std.testing.expectEqualSlices(Cand, sorted[0..k], out[0..n]);
+    }
+}
diff --git a/zig/src/families/flashnext/cuda_index_window.zig b/zig/src/families/flashnext/cuda_index_window.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fd9184c83a8f2475af6ff19de2bd61aeaaee0f96
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_index_window.zig
@@ -0,0 +1,241 @@
+//! At --tp 2 a stream keeps a window of each attention layer's raw indexer keys instead of a row a position.
+//! Only pooling reads raw keys, and only those of the blocks a pass completes: once a pass starts at p0, the rows
+//! before 4 * floor(p0 / 4) are never read again. A position's row sits at position - base, base a multiple of 4
+//! that only moves forward; the kernels are handed ikc - base rows, so they address position * 128 as before.
+//! docs/flashnext-tp2-indexer-split.md has the design.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+
+const ratio = wt.index_ratio;
+
+/// One raw indexer key row: 128 bf16.
+pub const row: usize = wt.index_dim * 2;
+/// A stream's rows in one pass beyond the engine's chunk: the MTP head's pass grows the shared scratch to 2 x 256.
+pub const pass_floor: usize = 512;
+/// Free rows a move needs past a pass: the carry's 3 rows and a gap, so the carry's copy never overlaps its source.
+pub const margin: usize = 2 * ratio;
+
+/// The window's rows at an engine's largest pass `chunk`.
+pub fn rows(chunk: usize) usize {
+    return std.mem.alignForward(usize, @max(chunk, pass_floor) + margin, 64);
+}
+
+/// Raw-key rows a `cap`-token stream allocates a layer: a row a position when `window` is 0, else at most `window`.
+pub fn rowsFor(cap: usize, window: usize) usize {
+    return if (window == 0) cap else @min(cap, window);
+}
+
+/// TF_FLASHNEXT_INDEX_WINDOW: unset or "1" keeps the window at --tp 2, "0" keeps a row a position; anything else refused.
+pub fn parse(v: ?[]const u8) !bool {
+    const s = v orelse return true;
+    if (std.mem.eql(u8, s, "1")) return true;
+    if (std.mem.eql(u8, s, "0")) return false;
+    return error.BadIndexWindow;
+}
+
+pub fn wanted() !bool {
+    return parse(if (std.c.getenv("TF_FLASHNEXT_INDEX_WINDOW")) |v| std.mem.span(v) else null);
+}
+
+/// A stream's windows: `rows` rows a layer (0: a row a position, no window) and each layer's first position.
+pub const Window = struct {
+    rows: usize = 0,
+    base: [wt.attn_n]usize = @splat(0),
+
+    pub fn on(w: *const Window) bool {
+        return w.rows != 0;
+    }
+
+    pub fn reset(w: *Window) void {
+        w.base = @splat(0);
+    }
+};
+
+/// What a layer needs before a pass: its new base, and `count` carry rows to copy from row `from` to row 0.
+pub const Step = struct { base: usize, from: usize = 0, count: usize = 0 };
+
+/// The step for `n` rows from `p0` in a window of `window` rows standing at `base`.
+pub fn step(window: usize, base: usize, p0: usize, n: usize) !Step {
+    if (window == 0 or n == 0) return error.IndexWindowShort;
+    const first = p0 / ratio * ratio;
+    if (first < base) {
+        // only a reset to a block's start goes back: it needs no earlier row
+        if (p0 != first) return error.IndexWindowBehind;
+        if (n > window) return error.IndexWindowShort;
+        return .{ .base = first };
+    }
+    if (p0 + n - base <= window) return .{ .base = base };
+    if (n + margin > window) return error.IndexWindowShort;
+    return .{ .base = first, .from = first - base, .count = p0 - first };
+}
+
+/// The device address the kernels take for a window at `base`: position p's row lands at row p - base.
+pub fn shifted(ptr: u64, base: usize) !u64 {
+    const back = std.math.mul(u64, base, row) catch return error.IndexWindowAddress;
+    if (ptr < back) return error.IndexWindowAddress;
+    return ptr - back;
+}
+
+/// The raw keys a state at `at` tokens needs: rows from position `first`, `count` of them (the incomplete block).
+pub const Carry = struct { first: usize, count: usize };
+
+pub fn carry(at: usize) Carry {
+    const first = at / ratio * ratio;
+    return .{ .first = first, .count = at - first };
+}
+
+/// Where a state's carry sits in a window at `base`: its first row, refused unless the window holds every carry row
+/// (none at a block's start, wherever the window stands).
+pub fn carryRow(window: usize, base: usize, at: usize) !usize {
+    const c = carry(at);
+    if (c.count == 0) return 0; // a block's start: no row to read
+    if (c.first < base or at - base > window) return error.IndexWindowBehind;
+    return c.first - base;
+}
+
+test "the window covers the engine's largest pass, the MTP head's 512 rows and the margin, in 64-row steps" {
+    try std.testing.expectEqual(@as(usize, 1600), rows(1536));
+    try std.testing.expectEqual(@as(usize, 4160), rows(4096));
+    try std.testing.expectEqual(@as(usize, 576), rows(64));
+    try std.testing.expectEqual(@as(usize, 16448), rows(16384));
+    try std.testing.expectEqual(2 * @import("cuda_mtp.zig").piece_rows, pass_floor);
+    for ([_]usize{ 1, 64, 1536, 4096, 16384 }) |chunk| {
+        try std.testing.expect(rows(chunk) >= @max(chunk, pass_floor) + margin);
+        try std.testing.expectEqual(@as(usize, 0), rows(chunk) % 64);
+    }
+    try std.testing.expectEqual(@as(usize, 100), rowsFor(100, 0));
+    try std.testing.expectEqual(@as(usize, 100), rowsFor(100, 1600));
+    try std.testing.expectEqual(@as(usize, 1600), rowsFor(262_160, 1600));
+}
+
+test "TF_FLASHNEXT_INDEX_WINDOW is on unset, takes 0 and 1, and refuses the rest" {
+    try std.testing.expect(try parse(null));
+    try std.testing.expect(try parse("1"));
+    try std.testing.expect(!try parse("0"));
+    for ([_][]const u8{ "", "2", "on", "true", " 1" }) |bad| try std.testing.expectError(error.BadIndexWindow, parse(bad));
+}
+
+test "a step moves only when the pass runs past the window, carrying the incomplete block's rows to the start" {
+    // within the window: nothing moves
+    try std.testing.expectEqual(Step{ .base = 0 }, try step(64, 0, 10, 20));
+    try std.testing.expectEqual(Step{ .base = 0 }, try step(64, 0, 60, 4));
+    // past it: base to the block start, 2 rows (positions 60 and 61) carried from row 60
+    try std.testing.expectEqual(Step{ .base = 60, .from = 60, .count = 2 }, try step(64, 0, 62, 10));
+    // block aligned: nothing to carry
+    try std.testing.expectEqual(Step{ .base = 64, .from = 64, .count = 0 }, try step(64, 0, 64, 1));
+    // a pass that needs the whole window past the carry is refused, never wrapped
+    try std.testing.expectError(error.IndexWindowShort, step(64, 0, 62, 57));
+    try std.testing.expectEqual(Step{ .base = 60, .from = 60, .count = 2 }, try step(64, 0, 62, 56));
+    // a reset to 0 needs no rows; going back into a block is refused
+    try std.testing.expectEqual(Step{ .base = 0 }, try step(64, 120, 0, 8));
+    try std.testing.expectError(error.IndexWindowBehind, step(64, 120, 117, 1));
+    try std.testing.expectError(error.IndexWindowShort, step(64, 0, 0, 0));
+    try std.testing.expectError(error.IndexWindowShort, step(0, 0, 0, 1));
+}
+
+test "a carry copy never overlaps its source" {
+    var window: usize = 16;
+    while (window <= 80) : (window += 4) for (0..window) |base4| {
+        const base = base4 / 4 * 4;
+        for (base..base + window) |p0| for (1..window + 1) |n| {
+            const s = step(window, base, p0, n) catch continue;
+            if (s.count == 0) continue;
+            try std.testing.expect(s.from >= s.count);
+            try std.testing.expect(p0 + n - s.base <= window);
+        };
+    };
+}
+
+test "the shifted address puts position p at row p - base, and refuses an address below the shift" {
+    try std.testing.expectEqual(@as(u64, 0x1000_0000 - 60 * 256), try shifted(0x1000_0000, 60));
+    try std.testing.expectEqual(@as(u64, 0x1000_0000), (try shifted(0x1000_0000, 60)) + 60 * 256);
+    try std.testing.expectError(error.IndexWindowAddress, shifted(255, 1));
+}
+
+/// A stream's raw keys as the kernels see them through a window: each layer's rows on the host, a value a row.
+const Sim = struct {
+    window: usize,
+    base: usize = 0,
+    mem: []u64,
+    /// What position p's key is when written in pass `version` (rewritten rows after a rollback differ).
+    fn key(p: usize, version: usize) u64 {
+        return @as(u64, p) << 20 | version;
+    }
+
+    /// A pass of `n` rows from `p0`: the step's carry, every row's write, then the pool reads of each completed block.
+    fn pass(s: *Sim, truth: []u64, p0: usize, n: usize, version: usize) !void {
+        const st = try step(s.window, s.base, p0, n);
+        if (st.count > 0) std.mem.copyForwards(u64, s.mem[0..st.count], s.mem[st.from..][0..st.count]);
+        s.base = st.base;
+        for (p0..p0 + n) |p| {
+            s.mem[p - s.base] = key(p, version);
+            truth[p] = key(p, version);
+        }
+        var b = p0 / ratio;
+        while ((b + 1) * ratio <= p0 + n) : (b += 1) for (0..ratio) |k| {
+            const p = b * ratio + k;
+            try std.testing.expect(p >= s.base and p - s.base < s.window);
+            try std.testing.expectEqual(truth[p], s.mem[p - s.base]);
+        };
+    }
+};
+
+test "passes, verify rollbacks, resets and restores always pool the keys a whole cache would hold" {
+    const cap = 6000;
+    var prng = std.Random.DefaultPrng.init(0x3970);
+    const r = prng.random();
+    for ([_]usize{ 64, 1536 }) |chunk| for (0..20) |_| {
+        const window = rows(chunk);
+        const mem = try std.testing.allocator.alloc(u64, window);
+        defer std.testing.allocator.free(mem);
+        const truth = try std.testing.allocator.alloc(u64, cap + chunk + pass_floor);
+        defer std.testing.allocator.free(truth);
+        @memset(truth, 0);
+        var s: Sim = .{ .window = window, .mem = mem };
+        var fed: usize = 0;
+        var version: usize = 1;
+        var kept: ?struct { at: usize, rows: [ratio]u64 } = null;
+        while (fed < cap - pass_floor) : (version += 1) {
+            switch (r.uintLessThan(u8, 10)) {
+                // a prompt chunk
+                0, 1 => {
+                    const n = 1 + r.uintLessThan(usize, chunk);
+                    try s.pass(truth, fed, n, version);
+                    fed += n;
+                },
+                // a drafted window, then its rollback to the accepted rows
+                2...6 => {
+                    const n = 1 + r.uintLessThan(usize, @import("cuda_mtp.zig").max_rows);
+                    try s.pass(truth, fed, n, version);
+                    fed += r.uintAtMost(usize, n);
+                },
+                // the MTP head's largest pass
+                7 => {
+                    try s.pass(truth, fed, pass_floor, version);
+                    fed += pass_floor;
+                },
+                // keep a state, or restore the kept one into this stream
+                8 => if (kept) |k| {
+                    const c = carry(k.at);
+                    s.base = c.first;
+                    for (0..c.count) |i| {
+                        s.mem[i] = k.rows[i];
+                        truth[c.first + i] = k.rows[i];
+                    }
+                    fed = k.at;
+                    kept = null;
+                } else {
+                    const c = carry(fed);
+                    var rows_kept: [ratio]u64 = @splat(0);
+                    const at_row = try carryRow(window, s.base, fed);
+                    for (0..c.count) |i| rows_kept[i] = s.mem[at_row + i];
+                    kept = .{ .at = fed, .rows = rows_kept };
+                },
+                // a stream reset to nothing fed
+                else => if (r.uintLessThan(u8, 4) == 0) {
+                    fed = 0;
+                },
+            }
+        }
+    };
+}
diff --git a/zig/src/families/flashnext/cuda_index_window_test.zig b/zig/src/families/flashnext/cuda_index_window_test.zig
