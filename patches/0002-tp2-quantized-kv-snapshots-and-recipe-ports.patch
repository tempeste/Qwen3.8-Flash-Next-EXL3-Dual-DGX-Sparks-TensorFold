index c18084c111672fdee8f048c4b0ef4b92fd8656e4..640656eddebaa4214ad0cac36562aacae15214e7 100644
--- a/zig/kernels/cuda/qmmf.cu
+++ b/zig/kernels/cuda/qmmf.cu
@@ -409,4 +409,151 @@ template __global__ void qmmf_kernel<BF16, 64, 64, 1, 4, 4, true, false, true>(c
