+    try std.testing.expectEqual(@as(usize, 80), 2560 / mx.group);
+    try std.testing.expectEqual(@as(usize, 192), 6144 / mx.group);
+    try std.testing.expectEqual(@as(usize, 20), 640 / mx.group);
+}
+
+test "a 64-row-aligned MXFP8 output cut packs to exactly the whole weight's packed tiles for those rows" {
+    const a = std.testing.allocator;
+    // o_proj, out_proj and the shared down at a reduced K (the cut is of rows; K only sizes each row), gate and up whole
+    for ([_][2]usize{ .{ 2560, 128 }, .{ 640, 2560 }, .{ 2560, 640 } }) |shape| {
+        const n = shape[0];
+        const k = shape[1];
+        var whole = try synthetic(a, n, k);
+        defer whole.deinit(a);
+        const wc = try a.alloc(u8, mx.padded(n) * k);
+        defer a.free(wc);
+        const ws = try a.alloc(u8, wc.len / 32);
+        defer a.free(ws);
+        mx.packCodes(wc, whole.codes, n, k);
+        mx.packScales(ws, whole.scales, n, k);
+        for (0..2) |r| {
+            const cut = try Cut.init(n, 2, r);
+            try std.testing.expect(cut.from % 64 == 0 and cut.width() % 64 == 0);
+            var mine = try source.cutMicro(a, whole, cut, .rows);
+            defer mine.deinit(a);
+            const cc = try a.alloc(u8, mx.padded(mine.n) * k);
+            defer a.free(cc);
+            const cs = try a.alloc(u8, cc.len / 32);
+            defer a.free(cs);
+            mx.packCodes(cc, mine.codes, mine.n, k);
