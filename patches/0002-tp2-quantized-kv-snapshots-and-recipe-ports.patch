new file mode 100644
index 0000000000000000000000000000000000000000..cdf6158ac9bdd1d3aa56e34483117c75a612dbd0
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rank_snap_test.zig
@@ -0,0 +1,381 @@
+//! Prompt-cache copies at two ranks over a Unix socket pair: frames, agreement and failure paths without a GPU.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const snaps = @import("cuda_snap.zig");
+const ranks = @import("cuda_rank_engine.zig");
+const wire = @import("cuda_rank_wire.zig");
+const rank_snap = @import("cuda_rank_snap.zig");
+const Heads = @import("cuda_heads.zig").Heads;
+const Mark = rank_snap.Mark;
+const t = std.testing;
+
+// Virtual device addresses; the callbacks never open CUDA or touch device memory, and count the copies.
+const Device = struct {
+    var next: u64 = 0x100000;
+    var copies: usize = 0;
+
+    fn alloc(out: *u64, n: usize) callconv(.c) c_int {
+        out.* = next;
+        next += n + 256;
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) c_int {
+        return 0;
+    }
+    fn fill(_: u64, _: u8, _: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn copy(_: u64, _: u64, _: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        copies += 1;
+        return 0;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn context() callconv(.c) c_int {
+        return 0;
+    }
+    fn driver() cuda.Driver {
+        copies = 0;
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemsetD8Async = fill;
+        d.api.cuMemcpyDtoDAsync_v2 = copy;
+        d.api.cuStreamSynchronize = sync;
+        d.api.cuCtxSynchronize = context;
+        return d;
+    }
+};
+
+/// One rank's session over one end of a socket pair; `peer` plays the other rank.
+const Pair = struct {
+    driver: cuda.Driver,
+    stream: cuda.Stream,
+    engine: prompt.Engine,
+    fds: [2]std.posix.socket_t,
+    s: ranks.Session,
+    peer: wire.Link,
+
+    fn init(p: *Pair, rank: usize, heads: Heads) !void {
+        p.driver = Device.driver();
+        p.stream = .{ .d = &p.driver, .handle = null };
+        p.engine = undefined;
+        p.engine.gpa = t.allocator;
+        p.engine.driver = &p.driver;
+        p.engine.stream = &p.stream;
+        p.engine.eos = 7;
+        p.engine.chunk = 16;
+        p.engine.round_graph = .{};
+        p.engine.heads = heads;
+        p.engine.kv = .bf16; // read by newSeq: four formats now, so no byte of undefined memory is one
+        p.engine.index_window = 0; // read by newSeq: a window there would size the raw indexer keys
+        if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &p.fds) != 0) return error.SocketPair;
+        const nonblock: c_int = @bitCast(@as(u32, @bitCast(std.c.O{ .NONBLOCK = true })));
+        for (p.fds) |fd| {
+            const flags = std.c.fcntl(fd, std.c.F.GETFL);
+            if (flags < 0 or std.c.fcntl(fd, std.c.F.SETFL, flags | nonblock) < 0) return error.Nonblocking;
+        }
+        p.peer = .{ .fd = p.fds[1] };
+        p.s = .{ .gpa = t.allocator, .rank = rank, .link = .{ .fd = p.fds[0] }, .collective = undefined, .engine = &p.engine };
+        p.s.collective.failed = false;
+        p.s.collective.comm = null;
+    }
+
+    fn deinit(p: *Pair) void {
+        var wi = p.s.windows.valueIterator();
+        while (wi.next()) |d| d.deinit();
+        p.s.windows.deinit(t.allocator);
+        var qi = p.s.seqs.valueIterator();
+        while (qi.next()) |q| {
+            q.*.deinit(t.allocator);
+            t.allocator.destroy(q.*);
+        }
+        p.s.seqs.deinit(t.allocator);
+        var si = p.s.saved.valueIterator();
+        while (si.next()) |kept| snaps.drop(t.allocator, p.stream, kept.*);
+        p.s.saved.deinit(t.allocator);
+        _ = std.c.close(p.fds[0]);
+        _ = std.c.close(p.fds[1]);
+    }
+
+    /// No byte waits on the peer's end: nothing was sent.
+    fn quiet(p: *const Pair) bool {
+        var byte: u8 = 0;
+        return std.c.recv(p.fds[1], &byte, 1, std.posix.MSG.PEEK | std.posix.MSG.DONTWAIT) < 0;
+    }
+
+    fn seq(p: *Pair, id: u64, fed: usize) !prompt.Seq {
+        var q = try p.engine.newSeq(16);
+        q.rank_id = id;
+        q.fed = fed;
+        q.history = .{ 3, @intCast(fed) };
+        return q;
+    }
+
+    fn window(p: *Pair, len: usize) !mtp.Draft {
+        var d = try mtp.Draft.init(t.allocator, &p.driver, p.stream, 16, 1, p.engine.chunk, p.engine.heads);
+        d.len = len;
+        return d;
+    }
+
+    fn ack(p: *Pair, sequence: u64, object: u64, flags: u32) !void {
+        try p.peer.sendHeader(.{ .kind = .ack, .sequence = sequence, .object = object, .flags = flags }, wire.deadline(1000));
+    }
+
+    fn frame(p: *Pair, h: wire.Header, payload: []const u8) !void {
+        try p.peer.sendHeader(h, wire.deadline(1000));
+        try p.peer.send(payload, wire.deadline(1000));
+    }
+
+    /// The next frame rank 0 sent, which must carry a mark.
+    fn marked(p: *Pair, kind: wire.Kind) !struct { wire.Header, Mark } {
+        const h = try p.peer.receiveHeader(wire.deadline(1000));
+        try t.expectEqual(kind, h.kind);
+        try t.expectEqual(@as(u32, Mark.bytes), h.bytes);
+        var raw: [Mark.bytes]u8 = undefined;
+        try p.peer.receive(&raw, wire.deadline(1000));
+        return .{ h, try Mark.decode(&raw) };
+    }
+};
+
+/// The next device allocation refused; the limit it replaced, for `lift`.
+fn denyNext() !?u64 {
+    const u = cuda.usage(false);
+    return cuda.memory.setAllocationLimit(u.device + u.host);
+}
+
+fn lift(limit: ?u64) void {
+    _ = cuda.memory.setAllocationLimit(limit) catch unreachable;
+}
+
+fn device() u64 {
+    return cuda.usage(false).device;
+}
+
+/// The bytes of rank 1's copy of a sequence standing at `at`.
+fn rankOneBytes(at: usize, heads: Heads) u64 {
+    return snaps.bytes(at, false, heads);
+}
+
+test "rank snapshot frames: a mark is 24 bytes within the window and names one position and history" {
+    const m = Mark.of(4097, .{ -1, 151_643 });
+    const raw = m.encode();
+    try t.expectEqualDeep(m, try Mark.decode(&raw));
+    try t.expect(m.names(4097, .{ -1, 151_643 }));
+    try t.expect(!m.names(4096, .{ -1, 151_643 }) and !m.names(4097, .{ 0, 151_643 }) and !m.names(4097, .{ -1, 0 }));
+    try t.expectError(error.BadRankFrame, Mark.decode(raw[0..23]));
+    try t.expectError(error.BadRankFrame, Mark.decode(&(Mark.of(prompt.max_tokens + 1, .{ 0, 0 }).encode())));
+    _ = try Mark.decode(&(Mark.of(prompt.max_tokens, .{ 0, 0 }).encode()));
+    for ([_]wire.Header{
+        .{ .kind = .save, .object = 1, .arg = 2 },
+        .{ .kind = .save, .object = 1, .arg = 2, .bytes = Mark.bytes + 1 },
+        .{ .kind = .restore, .arg = 2, .bytes = Mark.bytes },
+        .{ .kind = .restore, .object = 1, .arg = 2, .bytes = Mark.bytes, .flags = 1 },
+    }) |bad| try t.expectError(error.BadRankFrame, ranks.shape(bad));
+    // only a save's want of memory is a skip; the same error from any other command stops both ranks
+    try t.expect(rank_snap.skips(.save, error.OutOfDeviceMemory) and rank_snap.skips(.save, error.OutOfMemory));
+    try t.expect(!rank_snap.skips(.save, error.RankStateDiffers) and !rank_snap.skips(.restore, error.OutOfDeviceMemory));
+    try t.expect(!rank_snap.skips(.create, error.OutOfDeviceMemory) and !rank_snap.skips(.verify, error.OutOfDeviceMemory));
+}
+
+test "rank snapshot memory: rank 1's copy and window are never more than rank 0 is charged for them" {
+    for ([_]Heads{ .full, .half }) |h| {
+        for ([_]usize{ 0, 1, 3, 4, 5, 2048, 65_536, 262_160 }) |at| try t.expect(rankOneBytes(at, h) <= snaps.bytes(at, true, h));
+        for ([_]usize{ 1, 32_768 }) |draft_n| try t.expect(mtp.Draft.bytes(262_160, 1, 1536, h) <= mtp.Draft.bytes(262_160, draft_n, 1536, h));
+    }
+}
+
+test "rank 0 saves a drafting stream's state with the head's rows, then asks rank 1 for its half" {
+    var p: Pair = undefined;
+    try p.init(0, .half);
+    defer p.deinit();
+    var q = try p.seq(7, 5);
+    defer q.deinit(t.allocator);
+    var d = try p.window(5);
+    defer d.deinit();
+    try p.ack(1, 7, 0);
+    const kept = try p.s.save(&q, &d);
+    defer snaps.drop(t.allocator, p.stream, kept);
+    try t.expect(kept.head and kept.heads.eql(.half) and kept.at == 5);
+    try t.expectEqual(snaps.bytes(5, true, .half), kept.buf.len);
+    const h, const m = try p.marked(.save);
+    try t.expectEqual(@as(u64, 7), h.object);
+    try t.expectEqual(kept.rank_id, h.arg);
+    try t.expect(m.names(5, .{ 3, 5 }));
+    try t.expect(Device.copies > 0 and !p.s.stopped and p.s.available.load(.acquire));
+}
+
+test "rank 1 out of memory on a save: rank 0 drops its copy, skips the keep and both ranks go on" {
+    var p: Pair = undefined;
+    try p.init(0, .half);
+    defer p.deinit();
+    var q = try p.seq(7, 5);
+    defer q.deinit(t.allocator);
+    var d = try p.window(5);
+    defer d.deinit();
+    const before = device();
+    try p.ack(1, 7, rank_snap.skipped);
+    try t.expectError(error.OutOfDeviceMemory, p.s.save(&q, &d));
+    try t.expectEqual(before, device());
+    try t.expect(!p.s.stopped and p.s.available.load(.acquire) and !p.s.collective.failed);
+    _ = try p.marked(.save);
+    // the next command is the next in order on both ranks
+    try p.ack(2, 7, 0);
+    const kept = try p.s.save(&q, &d);
+    defer snaps.drop(t.allocator, p.stream, kept);
+    const h, _ = try p.marked(.save);
+    try t.expectEqual(@as(u64, 2), h.sequence);
+    try t.expectEqual(kept.rank_id, h.arg);
+}
+
+test "rank 1 failing a save any other way stops both ranks and frees rank 0's copy" {
+    var p: Pair = undefined;
+    try p.init(0, .half);
+    defer p.deinit();
+    var q = try p.seq(7, 5);
+    defer q.deinit(t.allocator);
+    const before = device();
+    try p.ack(1, 7, rank_snap.failed);
+    try t.expectError(error.RemoteRank, p.s.save(&q, null));
+    try t.expectEqual(before, device());
+    try t.expect(p.s.stopped and !p.s.available.load(.acquire));
+}
+
+test "rank 0 refuses a save it cannot keep before rank 1 hears of it" {
+    var p: Pair = undefined;
+    try p.init(0, .half);
+    defer p.deinit();
+    var q = try p.seq(7, 5);
+    defer q.deinit(t.allocator);
+    var d = try p.window(5);
+    defer d.deinit();
+    const before = device();
+    for (0..4) |case| {
+        d.len = if (case == 0) 4 else 5;
+        d.drafted = if (case == 1) 1 else 0;
+        d.open = case == 2;
+        const limit = if (case == 3) try denyNext() else null;
+        defer if (case == 3) lift(limit);
+        try t.expectError(if (case == 3) error.OutOfDeviceMemory else error.NotAtMark, p.s.save(&q, &d));
+        try t.expect(p.quiet() and !p.s.stopped);
+        try t.expectEqual(@as(u64, 1), p.s.next);
+        try t.expectEqual(before, device());
+    }
+}
+
+test "rank 0 restores a head snapshot on both ranks, and refuses one it cannot take before sending" {
+    var p: Pair = undefined;
+    try p.init(0, .half);
+    defer p.deinit();
+    var q = try p.seq(7, 0);
+    defer q.deinit(t.allocator);
+    var d = try p.window(0);
+    defer d.deinit();
+    const base: snaps.Snap = .{ .rank_id = 9, .buf = .{ .d = &p.driver, .ptr = 0x100, .len = 1, .borrowed = true }, .at = 5, .history = .{ 3, 5 }, .head = true, .heads = .half };
+    for (0..5) |case| {
+        var kept = base;
+        switch (case) {
+            0 => kept.head = false,
+            1 => kept.heads = .full,
+            2 => kept.at = 17,
+            3 => kept.rank_id = 0,
+            else => d.open = true,
+        }
+        defer d.open = false;
+        const want: anyerror = switch (case) {
+            0 => error.NoHeadState,
+            1 => error.SnapShape,
+            2 => error.SequenceTooShort,
+            3 => error.UnknownRankSnapshot,
+            else => error.NotAtMark,
+        };
+        try t.expectError(want, p.s.restore(&q, &d, &kept));
+        try t.expect(p.quiet() and !p.s.stopped and Device.copies == 0 and q.fed == 0);
+    }
+    try p.ack(1, 7, 0);
+    d.drafted = 2;
+    try p.s.restore(&q, &d, &base);
+    const h, const m = try p.marked(.restore);
+    try t.expectEqual(@as(u64, 9), h.arg);
+    try t.expect(m.names(5, .{ 3, 5 }));
+    try t.expect(q.fed == 5 and q.history[1] == 5 and d.len == 5 and d.drafted == 0 and Device.copies > 0);
+}
+
+test "rank 1 skips a save it has no memory for, keeps the next, restores it and stops in order" {
+    const Tri = @import("cuda_launch.zig").Tri;
+    var p: Pair = undefined;
+    try p.init(1, .half);
+    defer p.deinit();
+    for ([_][2]u64{ .{ 7, 12 }, .{ 8, 1 } }) |x| {
+        const q = try t.allocator.create(prompt.Seq);
+        q.* = p.seq(x[0], x[1]) catch |err| {
+            t.allocator.destroy(q);
+            return err;
+        };
+        try p.s.seqs.put(t.allocator, x[0], q);
+    }
+    var w = try p.window(0);
+    w.rows = 3;
+    try p.s.windows.put(t.allocator, 8, w);
+    // room for sequence 8's copy at 1 token, not sequence 7's at 12
+    const u = cuda.usage(false);
+    const limit = try cuda.memory.setAllocationLimit(u.device + u.host + rankOneBytes(1, .half) + 4096);
+    defer lift(limit);
+    try p.frame(.{ .kind = .save, .sequence = 1, .object = 7, .arg = 100, .bytes = Mark.bytes }, &Mark.of(12, .{ 3, 12 }).encode());
+    try p.frame(.{ .kind = .save, .sequence = 2, .object = 8, .arg = 101, .bytes = Mark.bytes }, &Mark.of(1, .{ 3, 1 }).encode());
+    try p.frame(.{ .kind = .restore, .sequence = 3, .object = 8, .arg = 101, .bytes = Mark.bytes }, &Mark.of(1, .{ 3, 1 }).encode());
+    try p.frame(.{ .kind = .stop, .sequence = 4 }, &.{});
+    const tri: Tri = undefined;
+    try p.s.follow(Tri, tri, 0);
+    for ([_]u32{ rank_snap.skipped, 0, 0, 0 }, 1..) |flags, sequence| {
+        const h = try p.peer.receiveHeader(wire.deadline(1000));
+        try t.expectEqual(wire.Kind.ack, h.kind);
+        try t.expectEqual(@as(u64, sequence), h.sequence);
+        try t.expectEqual(flags, h.flags);
+    }
+    try t.expect(p.s.saved.get(100) == null);
+    const kept = p.s.saved.get(101).?;
+    try t.expect(!kept.head and kept.heads.eql(.half) and kept.at == 1);
+    try t.expectEqual(rankOneBytes(1, .half), kept.buf.len);
+    const restored = p.s.windows.getPtr(8).?;
+    try t.expect(restored.len == 1 and restored.rows == 0 and p.s.seqs.get(8).?.fed == 1);
+}
+
+test "rank 1 stops both ranks when a frame names a state it does not hold" {
+    const Tri = @import("cuda_launch.zig").Tri;
+    for (0..4) |case| {
+        var p: Pair = undefined;
+        try p.init(1, .half);
+        defer p.deinit();
+        const q = try t.allocator.create(prompt.Seq);
+        q.* = p.seq(7, 5) catch |err| {
+            t.allocator.destroy(q);
+            return err;
+        };
+        try p.s.seqs.put(t.allocator, 7, q);
+        var w = try p.window(5);
+        w.open = case == 2;
+        try p.s.windows.put(t.allocator, 7, w);
+        const kept = try snaps.save(t.allocator, &p.driver, p.stream, q, null);
+        try p.s.saved.put(t.allocator, 50, kept);
+        const before = device();
+        const h: wire.Header = .{ .kind = if (case == 3) .restore else .save, .sequence = 1, .object = 7, .arg = if (case == 3) 50 else 51, .bytes = Mark.bytes };
+        const mark = switch (case) {
+            0 => Mark.of(6, .{ 3, 5 }),
+            1 => Mark.of(5, .{ 3, 4 }),
+            2 => Mark.of(5, .{ 3, 5 }),
+            else => Mark.of(5, .{ 2, 5 }),
+        };
+        try p.frame(h, &mark.encode());
+        const tri: Tri = undefined;
+        try t.expectError(if (case == 2) error.NotAtMark else error.RankStateDiffers, p.s.follow(Tri, tri, 0));
+        const answer = try p.peer.receiveHeader(wire.deadline(1000));
+        try t.expectEqual(rank_snap.failed, answer.flags);
+        try t.expect(p.s.stopped or p.s.collective.failed);
+        try t.expectEqual(before, device());
+        try t.expect(p.s.saved.count() == 1 and q.fed == 5);
+    }
+}
