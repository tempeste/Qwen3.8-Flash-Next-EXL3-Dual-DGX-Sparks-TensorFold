diff --git a/zig/src/core/lanes/memory_ledger.zig b/zig/src/core/lanes/memory_ledger.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e7ded9cfd8121c67092efbc5ce8de160bd76e0cc
--- /dev/null
+++ b/zig/src/core/lanes/memory_ledger.zig
@@ -0,0 +1,205 @@
+//! The memory floor's one ledger (Flash Next's TF_FLASHNEXT_SHARED_POOL).
+//!
+//! MemAvailable shows an allocation only once it is made. Every floor decision is therefore taken under one lock
+//! against MemAvailable less the floor, a headroom for small host transients (TENSORFOLD_MEMORY_HEADROOM_MIB) and
+//! the bytes earlier decisions promised but have not allocated yet (`pending`): a stream's caches between admission
+//! and allocation, a kept state's copy while it is made, and the HTTP threads' image preparation (decode, resize,
+//! patches) before the engine sees the request. A decision that fits adds its bytes to `pending`; its caller settles
+//! them once the memory is allocated (MemAvailable shows it from then on) or the attempt is given up.
+//!
+//! Off (no family configured it, or a floor of 0) every check passes and nothing is counted: the plain behaviour.
+const std = @import("std");
+
+pub const mib: u64 = 1 << 20;
+
+/// TENSORFOLD_MEMORY_HEADROOM_MIB's default: room above the floor for host transients no decision prices (a
+/// full-vocabulary draw's 11.4 MiB of scratch, a round's small arrays, request parsing).
+pub const default_headroom: u64 = 256 * mib;
+
+/// At most this many requests prepare images on the HTTP threads at once; the rest wait.
+pub const max_preparing: u32 = 2;
+
+pub const Verdict = enum { fits, short, unreadable, busy };
+
+pub const Ledger = struct {
+    mutex: std.atomic.Mutex = .unlocked,
+    /// Whether a family serves with a floor (Ledger.configure).
+    on: bool = false,
+    floor: u64 = 0,
+    headroom: u64 = 0,
+    available: *const fn () ?u64 = noReading,
+    /// Bytes promised by decisions that fitted and are not allocated yet.
+    pending: u64 = 0,
+    /// Of `pending`: the image preparations' reservations.
+    media: u64 = 0,
+    /// Requests preparing images now.
+    preparing: u32 = 0,
+
+    fn noReading() ?u64 {
+        return null;
+    }
+
+    fn lock(l: *Ledger) void {
+        while (!l.mutex.tryLock()) std.Thread.yield() catch {};
+    }
+
+    /// The family's floor, its headroom and its MemAvailable reading; a floor of 0 leaves the ledger off.
+    pub fn configure(l: *Ledger, floor: u64, headroom: u64, available: *const fn () ?u64) void {
+        l.lock();
+        defer l.mutex.unlock();
+        l.on = floor != 0;
+        l.floor = floor;
+        l.headroom = headroom;
+        l.available = available;
+    }
+
+    /// What a decision of `bytes` must leave, MemAvailable `now` aside: the floor, the headroom and what is pending.
+    fn wants(l: *const Ledger, bytes: u64) u64 {
+        return bytes +| l.floor +| l.headroom +| l.pending;
+    }
+
+    /// Whether `bytes` fit now; `.fits` adds them to pending (settle them after allocating, or on giving up).
+    pub fn claim(l: *Ledger, bytes: u64) Verdict {
+        if (!l.on) return .fits;
+        l.lock();
+        defer l.mutex.unlock();
+        const now = l.available() orelse return .unreadable;
+        if (now < l.wants(bytes)) return .short;
+        l.pending += bytes;
+        return .fits;
+    }
+
+    /// Whether `bytes` would fit now, nothing claimed (a check before a decision's first allocation).
+    pub fn check(l: *Ledger, bytes: u64) Verdict {
+        if (!l.on) return .fits;
+        l.lock();
+        defer l.mutex.unlock();
+        const now = l.available() orelse return .unreadable;
+        return if (now < l.wants(bytes)) .short else .fits;
+    }
+
+    /// How many more bytes MemAvailable would need for `bytes` to fit (0: they fit, or it is unreadable).
+    pub fn shortfall(l: *Ledger, bytes: u64) u64 {
+        if (!l.on) return 0;
+        l.lock();
+        defer l.mutex.unlock();
+        const now = l.available() orelse return 0;
+        return l.wants(bytes) -| now;
+    }
+
+    /// The bytes promised and not allocated yet (log lines).
+    pub fn pendingBytes(l: *Ledger) u64 {
+        l.lock();
+        defer l.mutex.unlock();
+        return l.pending;
+    }
+
+    /// A claim's bytes allocated (MemAvailable shows them now) or given up.
+    pub fn settle(l: *Ledger, bytes: u64) void {
+        if (!l.on or bytes == 0) return;
+        l.lock();
+        defer l.mutex.unlock();
+        l.pending -|= bytes;
+    }
+
+    /// A request's image preparation: a slot among max_preparing and its worst-case `bytes`; `.fits` holds both until
+    /// releaseMedia.
+    pub fn reserveMedia(l: *Ledger, bytes: u64) Verdict {
+        if (!l.on) return .fits;
+        l.lock();
+        defer l.mutex.unlock();
+        if (l.preparing >= max_preparing) return .busy;
+        const now = l.available() orelse return .unreadable;
+        if (now < l.wants(bytes)) return .short;
+        l.preparing += 1;
+        l.pending += bytes;
+        l.media += bytes;
+        return .fits;
+    }
+
+    /// The preparation is over: its buffers are made (MemAvailable shows what it holds) or freed.
+    pub fn releaseMedia(l: *Ledger, bytes: u64) void {
+        if (!l.on) return;
+        l.lock();
+        defer l.mutex.unlock();
+        l.preparing -|= 1;
+        l.pending -|= bytes;
+        l.media -|= bytes;
+    }
+
+    /// The bytes of image preparations reserved now (the pool's log lines).
+    pub fn mediaBytes(l: *Ledger) u64 {
+        l.lock();
+        defer l.mutex.unlock();
+        return l.media;
+    }
+};
+
+var process: Ledger = .{};
+
+/// The process's ledger: the engine's floor decisions and the HTTP threads' image preparation share it.
+pub fn shared() *Ledger {
+    return &process;
+}
+
+/// TENSORFOLD_MEMORY_HEADROOM_MIB in bytes: a whole 0..65536 MiB, else error; the default when unset.
+pub fn headroomFrom(text: ?[]const u8) error{BadMemoryHeadroom}!u64 {
+    const t = std.mem.trim(u8, text orelse return default_headroom, " ");
+    if (t.len == 0) return default_headroom;
+    const v = std.fmt.parseInt(u64, t, 10) catch return error.BadMemoryHeadroom;
+    if (v > 65536) return error.BadMemoryHeadroom;
+    return v * mib;
+}
+
+pub fn headroomFromEnv() error{BadMemoryHeadroom}!u64 {
+    return headroomFrom(if (std.c.getenv("TENSORFOLD_MEMORY_HEADROOM_MIB")) |v| std.mem.span(v) else null);
+}
+
+var reading: u64 = 0;
+fn fixed() ?u64 {
+    return reading;
+}
+
+test "claims count until settled, and every decision leaves floor, headroom and what is pending" {
+    var l: Ledger = .{};
+    try std.testing.expectEqual(Verdict.fits, l.claim(1 << 40)); // off: anything
+    l.configure(3 * mib, 1 * mib, fixed);
+    reading = 10 * mib;
+    try std.testing.expectEqual(Verdict.fits, l.claim(6 * mib)); // 6 + 3 + 1 = 10
+    try std.testing.expectEqual(@as(u64, 6 * mib), l.pending);
+    try std.testing.expectEqual(Verdict.short, l.claim(1)); // the 6 promised are not in MemAvailable yet
+    try std.testing.expectEqual(Verdict.short, l.check(1));
+    l.settle(6 * mib); // allocated: MemAvailable shows them
+    reading = 4 * mib;
+    try std.testing.expectEqual(Verdict.fits, l.check(0));
+    try std.testing.expectEqual(Verdict.short, l.check(1));
+    try std.testing.expectEqual(@as(u64, 0), l.pending);
+}
+
+test "image preparation takes one of two slots and its bytes, and the engine's decisions see them" {
+    var l: Ledger = .{};
+    l.configure(3 * mib, 0, fixed);
+    reading = 100 * mib;
+    try std.testing.expectEqual(Verdict.fits, l.reserveMedia(40 * mib));
+    try std.testing.expectEqual(Verdict.short, l.reserveMedia(58 * mib)); // 40 pending + 3 floor
+    try std.testing.expectEqual(Verdict.fits, l.reserveMedia(50 * mib));
+    try std.testing.expectEqual(Verdict.busy, l.reserveMedia(1)); // two preparing
+    try std.testing.expectEqual(Verdict.short, l.claim(8 * mib)); // a stream: 100 - 90 - 3 < 8
+    try std.testing.expectEqual(@as(u64, 90 * mib), l.mediaBytes());
+    l.releaseMedia(40 * mib);
+    try std.testing.expectEqual(Verdict.fits, l.claim(8 * mib));
+    try std.testing.expectEqual(Verdict.fits, l.reserveMedia(1));
+}
+
+test "an unreadable MemAvailable refuses under a floor, and the headroom parses as whole MiB" {
+    var l: Ledger = .{};
+    l.configure(mib, 0, Ledger.noReading);
+    try std.testing.expectEqual(Verdict.unreadable, l.claim(1));
+    try std.testing.expectEqual(Verdict.unreadable, l.reserveMedia(1));
+    l.configure(0, 0, Ledger.noReading); // floor 0: off
+    try std.testing.expectEqual(Verdict.fits, l.claim(1));
+    try std.testing.expectEqual(default_headroom, try headroomFrom(null));
+    try std.testing.expectEqual(@as(u64, 0), try headroomFrom("0"));
+    try std.testing.expectEqual(512 * mib, try headroomFrom(" 512 "));
+    for ([_][]const u8{ "-1", "1.5", "65537", "x" }) |bad| try std.testing.expectError(error.BadMemoryHeadroom, headroomFrom(bad));
+}
