+    for (int it = 0; it < iters; ++it) {
+#pragma unroll
+        for (int i = 0; i < 12; ++i) mma(acc[i], a, b0, b1);
+    }
+    float s = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 12; ++i) s += acc[i][0] + acc[i][1] + acc[i][2] + acc[i][3];
+    if (s == 123.456f) OUT[threadIdx.x] = s;
