+    const text = try std.Io.Dir.cwd().readFileAlloc(std.testing.io, "zig/tests/fixtures/lfm2/images.json", arena, .limited(1 << 22));
+    const Case = struct { url: []const u8 };
+    const cases = (try std.json.parseFromSliceLeaky(struct { cases: []const Case }, arena, text, .{ .ignore_unknown_fields = true })).cases;
+    var checked: usize = 0;
+    for (cases) |case| {
+        const comma = std.mem.indexOfScalar(u8, case.url, ',') orelse continue;
+        if (!std.mem.startsWith(u8, case.url, "data:") or !std.mem.endsWith(u8, case.url[0..comma], ";base64")) continue;
+        const b64 = std.base64.standard.Decoder;
+        const bytes = try arena.alloc(u8, b64.calcSizeForSlice(case.url[comma + 1 ..]) catch continue);
+        b64.decode(bytes, case.url[comma + 1 ..]) catch continue;
+        const d = picture.dims(bytes) orelse .{ 0, 0 };
+        for ([_]u32{ 64, 1024, 4096 }) |tokens| {
+            // every allocation counted, freed or not: what the request's arena holds once prepare returns
+            var counting = std.testing.FailingAllocator.init(arena, .{});
+            _ = prepare(std.testing.io, counting.allocator(), bytes, c, tokens) catch continue;
+            try std.testing.expect(counting.allocated_bytes <= prepareBytes(c, d[0], d[1], tokens));
+            checked += 1;
+        }
+    }
+    try std.testing.expect(checked >= 30);
+    // a photo near the budget: its patches dominate
+    const photo: picture.Rgb = .{ .width = 2000, .height = 1500, .pixels = try arena.alloc(u8, 2000 * 1500 * 3) };
+    @memset(photo.pixels, 77);
+    var counting = std.testing.FailingAllocator.init(std.heap.page_allocator, .{});
+    const a = counting.allocator();
+    const p = try prepareRgb(a, photo, 7, c, 4096);
+    defer a.free(p.pixels);
+    try std.testing.expect(p.pixels.len * 4 > 64 << 20); // 11,656 patches, 71.6 MB of f32
+    try std.testing.expect(counting.allocated_bytes + 3 * 2000 * 1500 <= prepareBytes(c, 2000, 1500, 4096));
+    // unknown sides: the decoder's largest picture
+    try std.testing.expect(prepareBytes(c, 0, 0, 4096) >= 16 * picture.max_pixels);
+}
+
+test "a PNG flooding compressed text inflates at most png.text_bytes, inside prepareBytes" {
+    var arena_state = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const c = try sampleConfig(arena);
+    const craft = @import("../picture/png_craft.zig");
+    // the review's probe: a 1 x 1 picture with 512 empty-key zTXt chunks of ~1 MiB each (and iTXt ones)
+    const text = try arena.alloc(u8, (1 << 20) - 1);
+    @memset(text, 'a');
+    const z = try craft.zlib(arena, text);
+    var b = try craft.Builder.init(arena);
+    try b.header(arena, 1, 1);
+    const ztxt = try std.mem.concat(arena, u8, &.{ "\x00\x00", z });
+    const itxt = try std.mem.concat(arena, u8, &.{ "k\x00\x01\x00\x00\x00", z });
+    for (0..512) |i| try b.chunk(arena, if (i % 2 == 0) "zTXt" else "iTXt", if (i % 2 == 0) ztxt else itxt);
+    const bytes = try b.black(arena, 1, 1);
+    try std.testing.expect(bytes.len < 1 << 20);
+    for ([_]u32{ 64, 4096 }) |tokens| {
+        var counting = std.testing.FailingAllocator.init(arena, .{});
+        _ = try prepare(std.testing.io, counting.allocator(), bytes, c, tokens);
+        try std.testing.expect(counting.allocated_bytes <= prepareBytes(c, 1, 1, tokens));
+    }
+}
