+/// One rank's MXFP8 [n, k] rows of a stitched projection: each part's ranged code rows and their scale rows, in order.
+pub fn stitchCutMicro(a: std.mem.Allocator, store: anytype, prefix: []const u8, parts: []const []const u8, ranges: []const Ranges, n: usize, k: usize) !Micro {
+    if (parts.len == 0 or parts.len != ranges.len or k == 0 or k % 64 != 0) return error.UnexpectedTensor;
+    const count = try std.math.mul(usize, n, k);
+    const codes = try a.alloc(u8, count);
+    errdefer a.free(codes);
+    const scales = try a.alloc(u8, count / 32);
+    errdefer a.free(scales);
+    var buf: [512]u8 = undefined;
+    var at: usize = 0;
+    var sat: usize = 0;
+    for (parts, ranges) |name, kept| {
+        var part = try readMicro(a, store, try std.fmt.bufPrint(&buf, "{s}{s}", .{ prefix, name }));
+        defer part.deinit(a);
+        if (part.k != k) return error.UnexpectedTensor;
+        at += try copyRanges(codes[at..], part.codes, k, kept);
+        sat += try copyRanges(scales[sat..], part.scales, k / 32, kept);
+    }
+    if (at != codes.len or sat != scales.len) return error.UnexpectedTensor;
+    return .{ .n = n, .k = k, .codes = codes, .scales = scales };
+}
+
+/// `stitchCut` (BF16) or `stitchCutMicro` (MXFP8) packed as `loadStitched` packs, its K slices pinned to `sk` (the whole
+/// stitched shape's) for equal sums.
 pub fn loadStitchedCut(a: std.mem.Allocator, d: *const cuda.Driver, store: anytype, prefix: []const u8, parts: []const []const u8, ranges: []const Ranges, n: usize, k: usize, sk: u32) !wt.Q4 {
     // the pin is checked on the shape before anything is read, so a bad one never reaches the driver
     const view = try cuda.qmmf.pinned(cuda.modelopt.bf16Weight(0, n, k), sk);
-    const bytes = try stitchCut(a, store, prefix, parts, ranges, n, k);
-    defer a.free(bytes);
-    var p = try projection.dense(a, d, .{ .dtype = .bf16, .rank = 2, .shape = .{ n, k, 1, 1, 1 }, .bytes = bytes });
+    if (parts.len == 0) return error.UnexpectedTensor;
+    var buf: [512]u8 = undefined;
+    const first = try store.tensor(try std.fmt.bufPrint(&buf, "{s}{s}.weight", .{ prefix, parts[0] }));
+    var p = switch (first.dtype) {
+        .bf16 => bf16: {
+            const bytes = try stitchCut(a, store, prefix, parts, ranges, n, k);
+            defer a.free(bytes);
+            break :bf16 try projection.dense(a, d, .{ .dtype = .bf16, .rank = 2, .shape = .{ n, k, 1, 1, 1 }, .bytes = bytes });
+        },
+        .f8_e4m3 => mx: {
+            var value = try stitchCutMicro(a, store, prefix, parts, ranges, n, k);
+            defer value.deinit(a);
+            break :mx try uploadMicro(a, d, value);
+        },
+        else => return error.UnsupportedQuantization,
+    };
     p.native.?.sk = view.sk;
     return p;
 }
