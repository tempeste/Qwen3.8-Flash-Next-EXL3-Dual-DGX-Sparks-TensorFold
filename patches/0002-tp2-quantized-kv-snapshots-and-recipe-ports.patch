diff --git a/zig/src/families/flashnext/cuda_rank_snap.zig b/zig/src/families/flashnext/cuda_rank_snap.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4d4aa22eed13149dfd9823595f13a54a76ae03c9
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rank_snap.zig
@@ -0,0 +1,121 @@
+//! Prompt-cache copies at two ranks: each its own half of the caches, rank 0 also the head's; checks before copies.
+const std = @import("std");
+const prompt = @import("cuda_prompt.zig");
+const snaps = @import("cuda_snap.zig");
+const wire = @import("cuda_rank_wire.zig");
+const mtp = @import("cuda_mtp.zig");
+const Session = @import("cuda_rank_engine.zig").Session;
+
+/// An ack's flags: rank 1 found no memory for a save's copy, kept nothing and still follows.
+pub const skipped: u32 = 1;
+/// An ack's flags: rank 1 failed the command and stopped.
+pub const failed: u32 = 2;
+
+/// A save's or a restore's payload: the position and n-gram history both ranks' states stand at.
+pub const Mark = struct {
+    at: u64,
+    history: [2]i64,
+
+    pub const bytes = 24;
+
+    pub fn of(at: usize, history: [2]i64) Mark {
+        return .{ .at = at, .history = history };
+    }
+
+    pub fn encode(m: Mark) [bytes]u8 {
+        var out: [bytes]u8 = undefined;
+        std.mem.writeInt(u64, out[0..8], m.at, .little);
+        std.mem.writeInt(i64, out[8..16], m.history[0], .little);
+        std.mem.writeInt(i64, out[16..24], m.history[1], .little);
+        return out;
+    }
+
+    pub fn decode(payload: []const u8) !Mark {
+        if (payload.len != bytes) return error.BadRankFrame;
+        const m: Mark = .{
+            .at = std.mem.readInt(u64, payload[0..8], .little),
+            .history = .{ std.mem.readInt(i64, payload[8..16], .little), std.mem.readInt(i64, payload[16..24], .little) },
+        };
+        if (m.at > prompt.max_tokens) return error.BadRankFrame;
+        return m;
+    }
+
+    /// Whether a state at `at` after `history` is the one this mark names.
+    pub fn names(m: Mark, at: usize, history: [2]i64) bool {
+        return m.at == at and m.history[0] == history[0] and m.history[1] == history[1];
+    }
+};
+
+/// Whether rank 1 answers `err` from a `kind` command as a skipped keep: a save that found no memory changed nothing.
+pub fn skips(kind: wire.Kind, err: anyerror) bool {
+    return kind == .save and (err == error.OutOfDeviceMemory or err == error.OutOfMemory);
+}
+
+/// A drafting window a copy can be taken from or restored into: settled, nothing pending.
+fn settled(d: ?*const mtp.Draft) !void {
+    if (d) |w| if (w.open or w.pending != 0) return error.NotAtMark;
+}
+
+/// Rank 0: `q`'s state (with `d`, the head's rows) on both ranks; rank 1 out of memory: neither keeps it.
+pub fn save(s: *Session, q: *prompt.Seq, d: ?*mtp.Draft) !*snaps.Snap {
+    try settled(d);
+    const kept = try snaps.take(s.gpa, s.engine.driver, q, d);
+    errdefer snaps.drop(s.gpa, s.engine.stream.*, kept);
+    kept.rank_id = s.next_object;
+    s.next_object = std.math.add(u64, s.next_object, 1) catch return error.BadRankFrame;
+    const mark = Mark.of(kept.at, kept.history).encode();
+    const h = try s.command(.{ .kind = .save, .object = q.rank_id, .arg = kept.rank_id, .bytes = Mark.bytes }, &mark);
+    snaps.fill(s.engine.stream.*, q, d, kept) catch |err| {
+        s.poison();
+        return err;
+    };
+    if (!try s.answer(h)) return error.OutOfDeviceMemory;
+    return kept;
+}
+
+/// Rank 0: every refusal before the frame is sent (a miss on both ranks), then both restore.
+pub fn restore(s: *Session, q: *prompt.Seq, d: ?*mtp.Draft, kept: *const snaps.Snap) !void {
+    try snaps.fits(q, d, kept);
+    try settled(d);
+    if (kept.rank_id == 0) return error.UnknownRankSnapshot;
+    const mark = Mark.of(kept.at, kept.history).encode();
+    const h = try s.command(.{ .kind = .restore, .object = q.rank_id, .arg = kept.rank_id, .bytes = Mark.bytes }, &mark);
+    errdefer s.poison();
+    try snaps.restore(s.engine.stream.*, q, d, kept);
+    try s.ack(h);
+}
+
+/// Rank 1's sequence `h.object` and its window, if it has one, standing where the frame says: else the ranks diverged.
+fn standing(s: *Session, h: wire.Header) !*prompt.Seq {
+    const q = s.seqs.get(h.object) orelse return error.UnknownRankSequence;
+    if (s.windows.getPtr(h.object)) |w| try settled(w);
+    return q;
+}
+
+/// Rank 1: a save frame's copy of its own sequence, kept under rank 0's id.
+pub fn keepHere(s: *Session, h: wire.Header, payload: []const u8) !void {
+    const m = try Mark.decode(payload);
+    if (s.saved.contains(h.arg)) return error.BadRankFrame;
+    const q = try standing(s, h);
+    if (!m.names(q.fed, q.history)) return error.RankStateDiffers;
+    const kept = try snaps.save(s.gpa, s.engine.driver, s.engine.stream.*, q, null);
+    errdefer snaps.drop(s.gpa, s.engine.stream.*, kept);
+    try s.saved.put(s.gpa, h.arg, kept);
+}
+
+/// Rank 1: a restore frame's kept state into its sequence; its window, if any, restarts there as rank 0's does.
+pub fn restoreHere(s: *Session, h: wire.Header, payload: []const u8) !void {
+    const m = try Mark.decode(payload);
+    const q = try standing(s, h);
+    const kept = s.saved.get(h.arg) orelse return error.UnknownRankSnapshot;
+    if (!m.names(kept.at, kept.history)) return error.RankStateDiffers;
+    try snaps.restore(s.engine.stream.*, q, null, kept);
+    if (s.windows.getPtr(h.object)) |w| {
+        w.reset();
+        w.len = kept.at;
+    }
+}
+
+test {
+    if (@import("builtin").os.tag != .windows) _ = @import("cuda_rank_snap_test.zig"); // over a Unix socket pair
+}
