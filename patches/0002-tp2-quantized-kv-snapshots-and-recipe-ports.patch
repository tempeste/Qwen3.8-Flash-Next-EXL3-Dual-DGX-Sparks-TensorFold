--- /dev/null
+++ b/zig/src/families/flashnext/cuda_tp_kv_test.zig
@@ -0,0 +1,116 @@
+//! The attention caches at --tp 2 in every --kv-cache format, without a GPU: each rank's rows are its KV heads' share, the
+//! stream charges are what each rank allocates (rank 1's verify window has no head cache), and the format refusal no
+//! longer names --tp.
+const std = @import("std");
+const cuda = @import("cuda");
+const kv_format = @import("cuda_kv.zig");
+const sizes = @import("cuda_seq_bytes.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const load = @import("cuda_lanes_load.zig");
+const Draft = @import("cuda_mtp_draft.zig").Draft;
+const Heads = @import("cuda_heads.zig").Heads;
+const Kv = kv_format.Kv;
+
+const formats = [_]Kv{ .bf16, .fp8, .nvfp4, .fp8k_nvfp4v };
+/// The serving window (262,144 + the verify rows) and the shapes the MTP head's buffers see.
+const window = 262_160;
+const draft_ids = 79591;
+const chunk = 1536;
+
+/// Virtual device addresses that count the bytes asked for; nothing is dereferenced.
+const Counting = struct {
+    var next: u64 = 0x100000;
+    var bytes: usize = 0;
+
+    fn alloc(out: *u64, n: usize) callconv(.c) c_int {
+        out.* = next;
+        next += n + 256;
+        bytes += n;
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) c_int {
+        return 0;
+    }
+    fn fill(_: u64, _: u8, _: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn driver() cuda.Driver {
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemsetD8Async = fill;
+        d.api.cuStreamSynchronize = sync;
+        return d;
+    }
+};
+
+test "a rank's key and value rows are its KV heads' share in every format, and two ranks hold one GPU's" {
+    for (formats) |f| for ([_]usize{ 1, 4096, window }) |cap| {
+        const half_k = sizes.keyBytesFor(f, cap, .half);
+        const half_v = sizes.valueBytesFor(f, cap, .half);
+        try std.testing.expectEqual(sizes.keyBytesFor(f, cap, .full), 2 * half_k);
+        try std.testing.expectEqual(sizes.valueBytesFor(f, cap, .full), 2 * half_v);
+        // a rank's row is the kernels' slot (key * HK + hk): one KV head's bytes of the format's row
+        try std.testing.expectEqual(cap * f.keyRow() / wt.kv_heads, half_k);
+        try std.testing.expectEqual(cap * f.valueRow() / wt.kv_heads, half_v);
+    };
+    // the format's rows split evenly by head: no trailer or scale is shared between the two KV heads
+    for (formats) |f| {
+        try std.testing.expectEqual(@as(usize, 0), f.keyRow() % wt.kv_heads);
+        try std.testing.expectEqual(@as(usize, 0), f.valueRow() % wt.kv_heads);
+    }
+    // the indexer's keys are whole on both ranks, so a rank's sequence is more than half of one GPU's
+    for (formats) |f| {
+        const one = sizes.seqBytesFor(f, window, .full);
+        const rank = sizes.seqBytesFor(f, window, .half);
+        const kv_half = wt.attn_n * (sizes.keyBytesFor(f, window, .half) + sizes.valueBytesFor(f, window, .half));
+        const linear_half = wt.linear_n * (sizes.convBytes(.full) - sizes.convBytes(.half) + sizes.stateBytes(.full) - sizes.stateBytes(.half));
+        try std.testing.expectEqual(one - kv_half - linear_half, rank);
+    }
+}
+
+test "rank 1's verify window allocates what it is charged and holds no head cache, in any format" {
+    var d = Counting.driver();
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    for ([_]Heads{ .half, .full }) |h| {
+        Counting.bytes = 0;
+        var w = try Draft.initWindow(std.testing.allocator, &d, stream, chunk, h);
+        defer w.deinit();
+        try std.testing.expectEqual(Draft.windowBytes(chunk, h), Counting.bytes);
+        try std.testing.expectEqual(@as(usize, 0), w.cap);
+        for ([_]cuda.DeviceBuffer{ w.kc, w.vc, w.ikc, w.pooled }) |b| try std.testing.expectEqual(@as(usize, 0), b.len);
+    }
+    for (formats) |f| try std.testing.expectEqual(Draft.windowBytes(chunk, .half), load.headStreamBytes(f, window, null, chunk, true, .half));
+    // the window it replaces kept a full-window bf16 head cache: charged in the main format, it was undercounted
+    const old_alloc = Draft.bytes(window, 1, chunk, .half);
+    try std.testing.expect(Draft.bytesFor(.nvfp4, window, 1, chunk, .half) < old_alloc);
+    try std.testing.expect(old_alloc - Draft.windowBytes(chunk, .half) > window * Kv.bf16.position());
+}
+
+test "each rank's stream charge at --tp 2: rank 0 the head's whole cache in its format, rank 1 the head-less window" {
+    for (formats) |f| {
+        const own = sizes.seqBytesFor(f, window, .half);
+        try std.testing.expectEqual(own + Draft.bytesFor(f, window, draft_ids, chunk, .half), load.streamBytes(f, window, draft_ids, chunk, false, .half));
+        try std.testing.expectEqual(own + Draft.windowBytes(chunk, .half), load.streamBytes(f, window, null, chunk, true, .half));
+        // the head's layer is whole on rank 0 in any format: its cache is one GPU's
+        try std.testing.expectEqual(Draft.bytesFor(f, window, draft_ids, chunk, .full) - Draft.bytesFor(f, window, draft_ids, chunk, .half), Draft.bytes(0, draft_ids, chunk, .full) - Draft.bytes(0, draft_ids, chunk, .half));
+    }
+    // one GPU is unchanged: no window charge without the second rank
+    for (formats) |f| {
+        try std.testing.expectEqual(@as(usize, 0), load.headStreamBytes(f, window, null, chunk, false, .full));
