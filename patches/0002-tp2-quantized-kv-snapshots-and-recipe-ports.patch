+test "a position's NVFP4 rows: 608 bytes a layer (nvfp4), 832 (fp8k_nvfp4v); 160-, 272- and 144-byte rows" {
+    try std.testing.expectEqual(@as(usize, 144), fp4_row);
+    try std.testing.expectEqual(@as(usize, 160), fp4_key_stride);
+    try std.testing.expectEqual(@as(usize, 0), fp4_row % 16);
+    try std.testing.expectEqual(@as(usize, 0), fp4_key_stride % 16);
+    try std.testing.expectEqual(@as(usize, 608), Kv.nvfp4.kvRow());
+    try std.testing.expectEqual(@as(usize, 832), Kv.fp8k_nvfp4v.kvRow());
+    try std.testing.expectEqual(@as(usize, 2 * 160), Kv.nvfp4.keyRow());
+    try std.testing.expectEqual(@as(usize, 2 * 272), Kv.fp8k_nvfp4v.keyRow());
+    try std.testing.expectEqual(@as(usize, 2 * 144), Kv.nvfp4.valueRow());
+    try std.testing.expectEqual(@as(usize, 2 * 144), Kv.fp8k_nvfp4v.valueRow());
+    // 13 layers (12 and the head) with the indexer's raw and pooled keys: 12,064 and 14,976 bytes a token
+    const pooled = wt.index_dim * 2 / wt.index_ratio;
+    try std.testing.expectEqual(@as(usize, 12064), 13 * (Kv.nvfp4.position() + pooled));
+    try std.testing.expectEqual(@as(usize, 14976), 13 * (Kv.fp8k_nvfp4v.position() + pooled));
+    for (Kv.quantized, 0..) |kv, i| try std.testing.expectEqual(i, kv.quantIndex().?);
+    try std.testing.expect(Kv.bf16.quantIndex() == null and Kv.bf16.kernelSuffix() == null);
+    try std.testing.expectEqualStrings("kv84", Kv.fp8k_nvfp4v.kernelSuffix().?);
+}
+
+test "the E2M1 index is round to nearest with ties to the even index, saturating at 6" {
+    // every grid value maps to itself, every midpoint to its even-index neighbour, and a brute-force nearest elsewhere
+    for (e2m1_values, 0..) |v, i| try std.testing.expectEqual(@as(u4, @intCast(i)), e2m1Index(v));
+    for (0..7) |i| {
+        const mid = (e2m1_values[i] + e2m1_values[i + 1]) / 2;
+        try std.testing.expectEqual(@as(u4, @intCast(if (i & 1 == 0) i else i + 1)), e2m1Index(mid));
+    }
+    var a: f32 = 0;
+    while (a < 8) : (a += 0.0078125 * 0.99) {
+        var best: usize = 0;
+        for (e2m1_values, 0..) |v, i| if (@abs(v - a) < @abs(e2m1_values[best] - a)) {
+            best = i;
+        };
+        try std.testing.expectEqual(@as(u4, @intCast(best)), e2m1Index(a));
+    }
+    try std.testing.expectEqual(@as(u4, 7), e2m1Index(1.0e30));
+}
+
+test "a row survives NVFP4 to within half an E2M1 step of its block's scale, and zero rows stay zero" {
+    var prng = std.Random.DefaultPrng.init(0x4b5639);
+    const r = prng.random();
+    var x: [wt.head_dim]f32 = undefined;
+    var row: [fp4_row]u8 = undefined;
+    var back: [wt.head_dim]f32 = undefined;
+    for (0..64) |trial| {
+        const spread: f32 = std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(trial % 12)) - 6);
+        for (&x) |*v| v.* = roundBf16((r.float(f32) * 2 - 1) * spread * (if (r.boolean()) @as(f32, 1.0) else 0.01));
+        const s = quantizeRow4(&x, &row);
+        dequantizeRow4(&row, s, &back);
+        var amax: f32 = 0;
+        for (x) |v| amax = @max(amax, @abs(v));
+        // the row's largest scaled value lies in (1024, 2048]
+        try std.testing.expect(amax / s > 1024 and amax / s <= 2048);
+        for (0..fp4_blocks) |b| {
+            const bs = decode(row[fp4_codes + b]) * s;
+            var bam: f32 = 0;
+            for (x[b * 16 ..][0..16]) |v| bam = @max(bam, @abs(v));
+            for (x[b * 16 ..][0..16], back[b * 16 ..][0..16]) |a, q| {
+                // the block's largest value is within e4m3's rounding of 6 x its scale; between grid points, half a step
+                // (at most 1 x the block scale, between 4 and 6) plus that rounding
+                try std.testing.expect(@abs(a - q) <= bs * 1.0 + bam * 0x1p-3);
+            }
+        }
+    }
+    @memset(&x, 0);
+    const s0 = quantizeRow4(&x, &row);
+    for (row) |b| try std.testing.expectEqual(@as(u8, 0), b);
+    dequantizeRow4(&row, s0, &back);
+    for (back) |v| try std.testing.expectEqual(@as(f32, 0), v);
+}
+
+test "the kernel's NVFP4 widening is the dequantized element, bit for bit, for every code and block scale" {
+    // row scales over the range a model row takes (2^-100 to 2^100): the products stay normal bf16 values
+    var e: u32 = 27;
+    while (e <= 227) : (e += 8) {
+        const s: f32 = @bitCast(e << 23);
+        var block: u8 = 0;
+        while (block < 0x7F) : (block += 1) {
+            for (0..16) |n| {
+                const nibble: u4 = @intCast(n);
+                const want = e2m1Value(nibble) * decode(block) * s;
+                try std.testing.expectEqual(want, roundBf16(want)); // the element is a bf16 value
+                try std.testing.expectEqual(want, widen4(nibble, block, s));
+            }
+        }
+    }
+    // the nibble's bf16 bits are its value times 2^-126 (index 1, 0.5, as the subnormal 2^-127)
+    for (0..16) |n| {
+        const nibble: u4 = @intCast(n);
+        const bits: u32 = ((@as(u32, nibble) & 8) << 12) | ((@as(u32, nibble) & 7) << 6);
+        const v: f32 = @bitCast(bits << 16);
+        try std.testing.expectEqual(e2m1Value(nibble) * 0x1p-126, v);
+    }
+}
+
+test "packed NVFP4 positions: nibbles j and j + 128 share byte j, block scales after them, both scales in the key trailer" {
+    var k: [wt.head_dim]f32 = undefined;
+    var v: [wt.head_dim]f32 = undefined;
+    for (&k, &v, 0..) |*a, *b, i| {
+        a.* = roundBf16(@as(f32, @floatFromInt(i)) - 100); // -100 .. 155
+        b.* = roundBf16(0.01 * @as(f32, @floatFromInt(i))); // 0 .. 2.55
+    }
+    var key_row: [fp4_key_stride]u8 = @splat(0xAA);
+    var value_row: [fp4_row]u8 = undefined;
+    packRows4(false, &k, &v, &key_row, &value_row);
+    const sk: f32 = @bitCast(std.mem.readInt(u32, key_row[fp4_row..][0..4], .little));
+    const sv: f32 = @bitCast(std.mem.readInt(u32, key_row[fp4_row + 4 ..][0..4], .little));
+    try std.testing.expectEqual(@as(f32, 0x1p-3), sk); // amax 155: ceil(log2) is 8, 2^(8 - 11)
+    try std.testing.expectEqual(@as(f32, 0x1p-9), sv); // amax 2.55: ceil(log2) is 2
+    for (key_row[fp4_key_stride - 8 ..]) |b| try std.testing.expectEqual(@as(u8, 0), b);
+    // element 255 (155) is the high nibble of byte 127, in block 15: 155 / 2^-3 = 1240; block amax 1240 / 6 -> e4m3 208
+    try std.testing.expectEqual(@as(f32, 208), decode(key_row[fp4_codes + 15]));
+    try std.testing.expectEqual(@as(u8, 7), key_row[127] >> 4); // 1240 / 208 = 5.96, over 5: index 7 (6)
+    try std.testing.expectEqual(@as(u8, 0), key_row[100] & 15); // element 100 is 0
+    var back: [wt.head_dim]f32 = undefined;
+    dequantizeRow4(key_row[0..fp4_row], sk, &back);
+    for (k, back) |a, q| try std.testing.expect(@abs(a - q) <= 0.2 * @abs(a) + 4);
+    // the fp8k_nvfp4v key row is the FP8 one, the value row the same NVFP4 bytes
+    var key8: [key_stride]u8 = undefined;
+    var value2: [fp4_row]u8 = undefined;
+    packRows4(true, &k, &v, &key8, &value2);
+    var want8: [key_stride]u8 = undefined;
+    var unused: [wt.head_dim]u8 = undefined;
+    packRows(&k, &v, &want8, &unused);
+    try std.testing.expectEqualSlices(u8, want8[0..value_scale_at], key8[0..value_scale_at]);
+    try std.testing.expectEqual(@as(f32, 0x1p-9), @as(f32, @bitCast(std.mem.readInt(u32, key8[value_scale_at..][0..4], .little))));
+    try std.testing.expectEqualSlices(u8, &value_row, &value2);
+}
+
+test "every quantized format packs and unpacks through the one interface, and fp8 is packRows" {
+    var k: [wt.head_dim]f32 = undefined;
+    var v: [wt.head_dim]f32 = undefined;
+    for (&k, &v, 0..) |*a, *b, i| {
+        a.* = roundBf16(@as(f32, @floatFromInt(i % 37)) - 18);
+        b.* = roundBf16(0.03 * @as(f32, @floatFromInt(i % 23)));
+    }
+    var back: [wt.head_dim]f32 = undefined;
+    var want: [wt.head_dim]f32 = undefined;
+    for (Kv.quantized) |kv| {
+        var key_row: [key_stride]u8 = undefined;
+        var value_row: [wt.head_dim]u8 = undefined;
+        const kr = key_row[0..keyStride(kv)];
+        const vr = value_row[0..valueStride(kv)];
+        pack(kv, &k, &v, kr, vr);
+        unpack(kv, kr, vr, true, &back);
+        for (v, back) |a, q| try std.testing.expect(@abs(a - q) <= 0.2 * @abs(a) + 0.1);
+        unpack(kv, kr, vr, false, &back);
+        for (k, back) |a, q| try std.testing.expect(@abs(a - q) <= 0.2 * @abs(a) + 2);
+        if (kv == .fp8) {
+            dequantizeRow(kr[0..wt.head_dim], @bitCast(std.mem.readInt(u32, kr[key_scale_at..][0..4], .little)), &want);
+            try std.testing.expectEqualSlices(f32, &want, &back);
+        }
+    }
+    try std.testing.expectEqual(@as(usize, 256), trailerAt(.fp8));
+    try std.testing.expectEqual(@as(usize, 144), trailerAt(.nvfp4));
+    try std.testing.expectEqual(@as(usize, 256), trailerAt(.fp8k_nvfp4v));
+}
