+//! Crafted PNG bytes for tests: chunks with their checksums, zlib bodies.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const png = @import("png.zig");
+
+/// `data` as a zlib stream.
+pub fn zlib(a: Allocator, data: []const u8) ![]u8 {
+    var out: std.Io.Writer.Allocating = try .initCapacity(a, 4096); // the compressor writes through a buffer
+    defer out.deinit();
+    const window = try a.alloc(u8, std.compress.flate.max_window_len);
+    defer a.free(window);
+    var z = try std.compress.flate.Compress.init(&out.writer, window, .zlib, .level_1);
+    try z.writer.writeAll(data);
+    try z.finish();
+    return out.toOwnedSlice();
+}
+
+/// A PNG under construction: the signature, then each chunk with its length and checksum.
+pub const Builder = struct {
+    bytes: std.ArrayList(u8) = .empty,
+
+    pub fn init(a: Allocator) !Builder {
+        var b: Builder = .{};
+        try b.bytes.appendSlice(a, png.signature);
+        return b;
+    }
+
+    pub fn chunk(b: *Builder, a: Allocator, kind: *const [4]u8, body: []const u8) !void {
+        var len: [4]u8 = undefined;
+        std.mem.writeInt(u32, &len, @intCast(body.len), .big);
+        try b.bytes.appendSlice(a, &len);
+        const start = b.bytes.items.len;
+        try b.bytes.appendSlice(a, kind);
+        try b.bytes.appendSlice(a, body);
+        var crc: [4]u8 = undefined;
+        std.mem.writeInt(u32, &crc, std.hash.Crc32.hash(b.bytes.items[start..]), .big);
+        try b.bytes.appendSlice(a, &crc);
+    }
+
+    /// An 8-bit RGB header of `w` x `h`.
+    pub fn header(b: *Builder, a: Allocator, w: u32, h: u32) !void {
+        var body: [13]u8 = .{ 0, 0, 0, 0, 0, 0, 0, 0, 8, 2, 0, 0, 0 };
+        std.mem.writeInt(u32, body[0..4], w, .big);
+        std.mem.writeInt(u32, body[4..8], h, .big);
+        try b.chunk(a, "IHDR", &body);
+    }
+
+    /// Black 8-bit RGB rows of `w` x `h` (filter byte 0 each) as one IDAT, then IEND.
+    pub fn black(b: *Builder, a: Allocator, w: u32, h: u32) ![]u8 {
+        const raw = try a.alloc(u8, @as(usize, h) * (1 + 3 * @as(usize, w)));
+        defer a.free(raw);
+        @memset(raw, 0);
+        const z = try zlib(a, raw);
+        defer a.free(z);
+        try b.chunk(a, "IDAT", z);
+        try b.chunk(a, "IEND", "");
+        return b.bytes.toOwnedSlice(a);
+    }
+};
