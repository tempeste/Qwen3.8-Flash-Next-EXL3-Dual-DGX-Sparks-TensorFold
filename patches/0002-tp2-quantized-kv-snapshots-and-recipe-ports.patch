index 0000000000000000000000000000000000000000..e41fbbfe5f926cfc1a8cce87af87703145b64212
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_index_window_test.zig
@@ -0,0 +1,206 @@
+//! The raw indexer-key window at --tp 2 without a GPU: a sequence allocates what it is charged, a kept state holds the
+//! incomplete block's raw keys read at the window's row and restores them to row 0, and each rank's stream charge.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const snap = @import("cuda_snap.zig");
+const sizes = @import("cuda_seq_bytes.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const load = @import("cuda_lanes_load.zig");
+const window = @import("cuda_index_window.zig");
+const Heads = @import("cuda_heads.zig").Heads;
+const Kv = @import("cuda_kv.zig").Kv;
+
+const serving = 262_160;
+const draft_ids = 79591;
+const chunk = 1536;
+
+/// Virtual device addresses that count the bytes asked for and record each device copy; nothing is dereferenced.
+const Device = struct {
+    const handle: cuda.abi.Stream = @ptrFromInt(17);
+    var next: u64 = 0x1000_0000;
+    var bytes: usize = 0;
+    var copies: std.ArrayList(Copy) = .empty;
+    const Copy = struct { dst: u64, src: u64, n: usize };
+
+    fn alloc(out: *u64, n: usize) callconv(.c) c_int {
+        out.* = next;
+        next += n + 256;
+        bytes += n;
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) c_int {
+        return 0;
+    }
+    fn fill(_: u64, _: u8, _: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) c_int {
+        return 0;
+    }
+    fn context() callconv(.c) c_int {
+        return 0;
+    }
+    fn copy(dst: u64, src: u64, n: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        copies.append(std.testing.allocator, .{ .dst = dst, .src = src, .n = n }) catch return 1;
+        return 0;
+    }
+    /// The copy log back to empty (deinit leaves it undefined).
+    fn release() void {
+        copies.deinit(std.testing.allocator);
+        copies = .empty;
+    }
+    fn driver() cuda.Driver {
+        next = 0x1000_0000;
+        bytes = 0;
+        var d: cuda.Driver = .{ .lib = undefined, .api = undefined };
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemsetD8Async = fill;
+        d.api.cuStreamSynchronize = sync;
+        d.api.cuCtxSynchronize = context;
+        d.api.cuMemcpyDtoDAsync_v2 = copy;
+        return d;
+    }
+};
+
+var queue: cuda.Stream = undefined;
+
+fn engine(d: *cuda.Driver, h: Heads, kv: Kv, index_window: usize) prompt.Engine {
+    var e: prompt.Engine = undefined;
+    e.gpa = std.testing.allocator;
+    e.driver = d;
+    queue = .{ .d = d, .handle = Device.handle };
+    e.stream = &queue;
+    e.eos = 0;
+    e.heads = h;
+    e.kv = kv;
+    e.index_window = index_window;
+    e.round_graph = .{};
+    return e;
+}
+
+test "a sequence with a raw-key window allocates its charge: the window's rows a layer, every other cache as before" {
+    for ([_]Kv{ .bf16, .nvfp4 }) |kv| for ([_]Heads{ .full, .half }) |h| for ([_]usize{ 0, window.rows(chunk) }) |w| {
+        for ([_]usize{ 64, 1601, prompt.max_tokens }) |cap| {
+            var d = Device.driver();
+            var e = engine(&d, h, kv, w);
+            var seq = try e.newSeqOn(cap, null);
+            defer seq.deinit(std.testing.allocator);
+            try std.testing.expectEqual(sizes.seqBytesIn(kv, cap, h, w), Device.bytes);
+            try std.testing.expectEqual(if (w == 0) @as(usize, 0) else @min(cap, w), seq.window.rows);
+            for (seq.ikc) |b| try std.testing.expectEqual(sizes.indexBytesIn(cap, w), b.len);
+            for (seq.pooled) |b| try std.testing.expectEqual(sizes.pooledBytes(cap), b.len);
+            const v = seq.view(0);
+            try std.testing.expectEqual(w != 0, v.window != null);
+        }
+    };
+}
+
+test "a pool lane's sequence comes back to an unmoved window" {
+    var d = Device.driver();
+    var e = engine(&d, .half, .nvfp4, window.rows(chunk));
+    var seq = try e.newSeqOn(prompt.max_tokens, null);
+    defer seq.deinit(std.testing.allocator);
+    seq.window.base = @splat(4000);
+    try e.clearSeq(&seq, prompt.max_tokens);
+    for (seq.window.base) |b| try std.testing.expectEqual(@as(usize, 0), b);
+}
+
+test "a window's kept state holds the incomplete block's raw keys and moves exactly its bytes" {
+    for ([_]Kv{ .bf16, .nvfp4 }) |kv| for ([_]?Kv{ null, .bf16 }) |head| for ([_]Heads{ .full, .half }) |h| {
+        for ([_]usize{ 0, 3, 4, 7, 1000, 262_143 }) |at| {
+            const o = snap.orderIn(kv, head, at, h, true);
+            var n: usize = 0;
+            for (o.p[0..o.len]) |p| n += p.layers * p.n;
+            try std.testing.expectEqual(snap.bytesIn(kv, head, at, h, true), n);
+            try std.testing.expectEqual(at % 4 * 256, o.p[4].n);
+            // the head's raw keys keep a row a position
+            if (head != null) try std.testing.expectEqual(at * 256, o.p[9].n);
+            try std.testing.expectEqual(wt.attn_n * (at - at % 4) * 256, snap.bytesWith(kv, head, at, h) - snap.bytesIn(kv, head, at, h, true));
+            try std.testing.expectEqual(snap.bytesWith(kv, head, at, h), snap.bytesIn(kv, head, at, h, false));
+        }
+    };
+    // at the serving window a state is 768 MiB smaller
+    try std.testing.expectEqual(@as(usize, 805_294_080), snap.bytesWith(.nvfp4, null, 262_143, .half) - snap.bytesIn(.nvfp4, null, 262_143, .half, true));
+}
+
+test "a window's state restores into no sequence without one, and the reverse, before any copy" {
+    var d = Device.driver();
+    defer Device.release();
+    const stream: cuda.Stream = .{ .d = &d, .handle = Device.handle };
+    for ([_]bool{ true, false }) |kept_window| {
+        const kept: snap.Snap = .{ .buf = .{ .d = &d, .ptr = 0x100, .len = 1, .borrowed = true }, .at = 1, .history = .{ 0, 0 }, .head = false, .heads = .half, .window = kept_window };
+        var seq: prompt.Seq = .{ .heads = .half, .conv = &.{}, .state = &.{}, .kc = &.{}, .vc = &.{}, .ikc = &.{}, .pooled = &.{}, .tail = .{ .d = &d, .ptr = 0, .len = 0 }, .history = .{ 0, 0 }, .fed = 0, .logits = &.{}, .cap = 8, .window = .{ .rows = if (kept_window) 0 else 8 } };
+        try std.testing.expectError(error.SnapShape, snap.restore(stream, &seq, null, &kept));
+        try std.testing.expectEqual(@as(usize, 0), seq.fed);
+        try std.testing.expectEqual(@as(usize, 0), Device.copies.items.len);
+    }
+}
+
+test "save reads each layer's carry at its window row; restore writes it to row 0 and moves the window to the block" {
+    var d = Device.driver();
+    defer Device.release();
+    const stream: cuda.Stream = .{ .d = &d, .handle = Device.handle };
+    var e = engine(&d, .half, .nvfp4, window.rows(chunk));
+    var seq = try e.newSeqOn(prompt.max_tokens, null);
+    defer seq.deinit(std.testing.allocator);
+    const at: usize = 10_002; // block 2,500's first two positions
+    seq.fed = at;
+    for (&seq.window.base, 0..) |*b, i| b.* = 9_000 + 4 * i;
+    Device.copies.clearRetainingCapacity();
+    const kept = try snap.save(std.testing.allocator, &d, stream, &seq, null);
+    defer snap.drop(std.testing.allocator, stream, kept);
+    try std.testing.expect(kept.window);
+    try std.testing.expectEqual(snap.bytesIn(.nvfp4, null, at, .half, true), kept.buf.len);
+    var raw: usize = 0;
+    for (Device.copies.items) |c| for (seq.ikc, 0..) |b, layer| {
+        if (c.src < b.ptr or c.src >= b.ptr + b.len) continue;
+        try std.testing.expectEqual(b.ptr + (10_000 - (9_000 + 4 * layer)) * 256, c.src);
+        try std.testing.expectEqual(@as(usize, 2 * 256), c.n);
+        raw += 1;
+    };
+    try std.testing.expectEqual(wt.attn_n, raw);
+    // a state the window no longer holds is refused before any copy
+    seq.window.base = @splat(10_004);
+    Device.copies.clearRetainingCapacity();
+    try std.testing.expectError(error.IndexWindowBehind, snap.save(std.testing.allocator, &d, stream, &seq, null));
+    // restore: every layer's carry to row 0, the window at the block's first position
+    Device.copies.clearRetainingCapacity();
+    seq.fed = 0;
+    try snap.restore(stream, &seq, null, kept);
+    try std.testing.expectEqual(at, seq.fed);
+    for (seq.window.base) |b| try std.testing.expectEqual(@as(usize, 10_000), b);
+    raw = 0;
+    for (Device.copies.items) |c| for (seq.ikc) |b| {
+        if (c.dst < b.ptr or c.dst >= b.ptr + b.len) continue;
+        try std.testing.expectEqual(b.ptr, c.dst);
+        raw += 1;
+    };
+    try std.testing.expectEqual(wt.attn_n, raw);
+}
+
+/// Each rank's per-stream charge at the serving window, NVFP4 KV: rank 0 with the MTP head's cache, rank 1 its window.
+fn charges(h: Heads, index_window: usize) [2]usize {
+    return .{
+        load.streamBytesIn(.nvfp4, serving, draft_ids, chunk, false, h, index_window),
+        load.streamBytesIn(.nvfp4, serving, null, chunk, true, h, index_window),
+    };
+}
+
+test "each rank's stream charge at --tp 2 with the window: 0.745 GiB less on both ranks than whole raw keys" {
+    const w = window.rows(chunk);
+    const whole = charges(.half, 0);
+    const kept = charges(.half, w);
+    // the whole-key layout's charges: 2.225 and 1.999 GiB
+    try std.testing.expectEqual(@as(usize, 2_389_335_502), whole[0]);
+    try std.testing.expectEqual(@as(usize, 2_145_891_842), whole[1]);
+    // with the window: 1.480 and 1.253 GiB
+    try std.testing.expectEqual(@as(usize, 1_588_895_182), kept[0]);
+    try std.testing.expectEqual(@as(usize, 1_345_451_522), kept[1]);
+    for (whole, kept) |a, b| try std.testing.expectEqual(wt.attn_n * (serving - w) * 256, a - b);
+    try std.testing.expectEqual(@as(usize, 800_440_320), whole[0] - kept[0]);
+    try std.testing.expectEqual(whole, .{ load.streamBytes(.nvfp4, serving, draft_ids, chunk, false, .half), load.streamBytes(.nvfp4, serving, null, chunk, true, .half) });
+    // rank 1 never takes more than rank 0 is charged
+    try std.testing.expect(kept[1] <= kept[0]);
+}
diff --git a/zig/src/families/flashnext/cuda_knobs.zig b/zig/src/families/flashnext/cuda_knobs.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c927060fe9a6c6acf8fa3762c8819fd109a53837
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_knobs.zig
@@ -0,0 +1,70 @@
+//! Prompt-path switches (environment, read once per process); the defaults are the fast paths.
+const std = @import("std");
+
+/// TF_FLASHNEXT_PROMPT_SYNC=1: drain the stream after every non-final prompt chunk, as v1.1.4 did. The drain leaves the
+/// GPU idle while the host rebuilds the next chunk's launches and its n-gram gather (about 40 ms a 1,536-row chunk).
+pub fn chunkSync() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_PROMPT_SYNC") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_PROMPT_MX128=N: MXFP8 projections of N columns or more take the relaxed 128 x 128 prompt tile in prompt
+/// passes (default 1024); 0 keeps the exact kernels everywhere.
+pub fn mx128MinN() usize {
+    const v = std.c.getenv("TF_FLASHNEXT_PROMPT_MX128") orelse return 1024;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch 1024;
+}
+
+/// TF_FLASHNEXT_GATHER_EARLY=1: a shared pass gathers every stream's n-gram rows in one pool call (not one call a stream).
+pub fn gatherEarly() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_GATHER_EARLY") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_GATHER_LOG=1: the gather's and the PLE layer's join wait of shared passes, averaged over 100 passes.
+pub fn gatherLog() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_GATHER_LOG") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_PROMPT_HC2=1: the native hyper-connection read-out of prompt passes (TF_FLASHNEXT_HC2_MIN rows or more) runs on two fused
+/// kernels (flashnext_hcf.cu hcn: the norm formed in the down tile and in the up epilogue, the up rows mixed in place)
+/// instead of five launches; every byte of its outputs is the five-launch chain's.
+pub fn promptHc2() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_PROMPT_HC2") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_HC2_DN / TF_FLASHNEXT_HC2_UP: the CTA row tile (16 * N rows) of those two kernels; 0: the default.
+pub fn hc2Tile(name: [:0]const u8) usize {
+    const v = std.c.getenv(name) orelse return 0;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch 0;
+}
+
+/// TF_FLASHNEXT_HC2_MIN: the fewest rows of a prompt pass that take the fused read-out (default 768; its CTAs need rows to fill the GPU).
+pub fn hc2MinRows() usize {
+    const v = std.c.getenv("TF_FLASHNEXT_HC2_MIN") orelse return 768;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch 768;
+}
+
+/// TF_FLASHNEXT_HEAD_PIECE: the rows a prompt chunk's MTP head pass takes at most (default 256, the decode rounds' piece).
+/// From TF_FLASHNEXT_FACT_ROWS rows the head's NVFP4 experts take the prompt tiles (the decode form's bits) and read each weight once.
+pub fn headPiece() usize {
+    const v = std.c.getenv("TF_FLASHNEXT_HEAD_PIECE") orelse return 256;
+    const n = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return 256;
+    return if (n == 0) 256 else n;
+}
+
+/// TF_FLASHNEXT_PROMPT_SHARED_DIRECT=1: a prompt pass's MoE write-back reads the shared expert's fp32 output in place instead of
+/// a copy of it in y's last slot (the same value in the same fused-multiply-add order; one launch and 62 MB per layer less).
+pub fn sharedDirect() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_PROMPT_SHARED_DIRECT") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_PROMPT_GEMM2=1: the MX128 prompt tile (GDN in-projection, attention qkv, out projections) runs with two pipeline
+/// stages and two blocks an SM: one block output stores and pipeline fill overlap the other K loop. Same arithmetic, same bits.
+pub fn promptGemm2() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_PROMPT_GEMM2") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
diff --git a/zig/src/families/flashnext/cuda_kv.zig b/zig/src/families/flashnext/cuda_kv.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2a79327575f537b30f05f18b13794dc60e8065bd
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_kv.zig
@@ -0,0 +1,748 @@
+//! Flash Next's attention caches on the device (--kv-cache): bf16 rows, or FP8 e4m3 rows with a power-of-two scale a
+//! (position, KV head) row. The indexer's raw keys and pooled blocks stay bf16 in both; so do the DeltaNet states.
+//!
+//! FP8 layout, position t and KV head h (slot = t * kv_heads + h):
+//!   keys   [cap, kv_heads, head_dim + 16] bytes: head_dim e4m3 codes, then s_k and s_v (fp32), then 8 zero bytes;
+//!   values [cap, kv_heads, head_dim] bytes: head_dim e4m3 codes (their scale s_v is in the key row's trailer).
+//! A row's scale is 2^(ceil(log2 amax) - 8): its largest value lands in (128, 256], under e4m3's 448, so nothing
+//! saturates. A code times a power of two is a bf16 value, so reading a row (dequantize) is exact and the attention
+//! sums are those of the bf16 kernels on the dequantized rows. The kernels are flashnext_attn.cu's fn_attn_prep_kv8
+//! (quantize on write) and fn_attn_chunks_kv8 and fn_attn_fused_kv8 (dequantize on read). This file holds the sizes and
+//! a CPU model of the arithmetic that the tests hold the CUDA formulas to.
+//!
+//! NVFP4 (--kv-cache nvfp4, and the values of fp8k_nvfp4v), the same position and head slots:
+//!   a row of head_dim values is head_dim/2 code bytes (byte j: element j in the low nibble, element j + head_dim/2 in the
+//!   high one; a nibble is sign << 3 | the E2M1 index of 0, .5, 1, 1.5, 2, 3, 4, 6) and head_dim/16 E4M3 block scales;
+//!   keys   [cap, kv_heads, 160] bytes: the 144-byte row, then s_k and s_v (fp32) and 8 zero bytes (nvfp4), or the FP8 key
+//!          row above (fp8k_nvfp4v, s_v in its trailer);
+//!   values [cap, kv_heads, 144] bytes.
+//! A row's scale is 2^(ceil(log2 amax) - 11); a block's scale is e4m3(amax of the scaled block / 6) and its codes the scaled
+//! values over it, round to nearest even (ties to the even index), division IEEE, no contraction. An element's value,
+//! e2m1 x block scale x s, is a bf16 value for every row that is not near bf16's underflow: reading is exact as with fp8.
+//! The kernels are fn_attn_prep_kv4 and _kv84 (write) and fn_attn_chunks_kv4/_kv84 and fn_attn_fused_kv4/_kv84 (read);
+//! the format is that of an earlier NVFP4 KV patch for the Python engine (kv4.py), byte for byte.
+
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+
+/// The attention caches' format of an engine; every sequence, draft cache and kept state of it uses the same one.
+pub const Kv = enum {
+    bf16,
+    fp8,
+    nvfp4,
+    fp8k_nvfp4v,
+
+    /// Bytes one position's keys take in one attention layer (all KV heads).
+    pub fn keyRow(kv: Kv) usize {
+        return switch (kv) {
+            .bf16 => wt.kv_heads * wt.head_dim * 2,
+            .fp8, .fp8k_nvfp4v => wt.kv_heads * key_stride,
+            .nvfp4 => wt.kv_heads * fp4_key_stride,
+        };
+    }
+
+    /// Bytes one position's values take in one attention layer.
+    pub fn valueRow(kv: Kv) usize {
+        return switch (kv) {
+            .bf16 => wt.kv_heads * wt.head_dim * 2,
+            .fp8 => wt.kv_heads * wt.head_dim,
+            .nvfp4, .fp8k_nvfp4v => wt.kv_heads * fp4_row,
+        };
+    }
+
+    /// Bytes one position's keys and values take in one attention layer: 2,048 bf16, 1,056 fp8, 608 nvfp4, 832
+    /// fp8k_nvfp4v.
+    pub fn kvRow(kv: Kv) usize {
+        return kv.keyRow() + kv.valueRow();
+    }
+
+    /// Bytes one position takes in one attention layer, the indexer's raw key included (the pooled blocks not).
+    pub fn position(kv: Kv) usize {
+        return kv.kvRow() + index_row;
+    }
+
+    /// The --kv-cache name.
+    pub fn name(kv: Kv) []const u8 {
+        return @tagName(kv);
+    }
+
+    /// The kernels' suffix (flashnext_attn.cu): fn_attn_prep_kv8, _kv4, _kv84; null for bf16 (no suffix).
+    pub fn kernelSuffix(kv: Kv) ?[]const u8 {
+        return switch (kv) {
+            .bf16 => null,
+            .fp8 => "kv8",
+            .nvfp4 => "kv4",
+            .fp8k_nvfp4v => "kv84",
+        };
+    }
+
+    /// The quantized formats in Glue's table order (cuda_glue.zig `quant`).
+    pub const quantized = [_]Kv{ .fp8, .nvfp4, .fp8k_nvfp4v };
+
+    /// Its index in `quantized`; null for bf16.
+    pub fn quantIndex(kv: Kv) ?usize {
+        return switch (kv) {
+            .bf16 => null,
+            .fp8 => 0,
+            .nvfp4 => 1,
+            .fp8k_nvfp4v => 2,
+        };
+    }
+};
+
+/// Bytes after an FP8 key row's codes: s_k and s_v (fp32) and 8 zero bytes, so rows stay 16-byte aligned.
+pub const key_trailer = 16;
+/// An FP8 key row: head_dim codes and the trailer.
+pub const key_stride = wt.head_dim + key_trailer;
+/// Where the scales sit in an FP8 key row: s_k, then s_v.
+pub const key_scale_at = wt.head_dim;
+pub const value_scale_at = wt.head_dim + 4;
+/// One position's raw indexer key, bf16 in both formats.
+pub const index_row = wt.index_dim * 2;
+/// A row's scale is 2^(ceil(log2 amax) - scale_shift).
+pub const scale_shift = 8;
+/// The largest e4m3 magnitude (code 0x7E); 0x7F is NaN.
+pub const e4m3_max = 448.0;
+
+/// An NVFP4 row: head_dim/2 code bytes and head_dim/16 block scales (a value row; a key row adds the trailer).
+pub const fp4_codes = wt.head_dim / 2;
+pub const fp4_blocks = wt.head_dim / 16;
+pub const fp4_row = fp4_codes + fp4_blocks;
+pub const fp4_key_stride = fp4_row + key_trailer;
+/// An NVFP4 row's scale is 2^(ceil(log2 amax) - fp4_scale_shift).
+pub const fp4_scale_shift = 11;
+/// The E2M1 magnitudes by index.
+pub const e2m1_values = [8]f32{ 0, 0.5, 1, 1.5, 2, 3, 4, 6 };
+
+/// Byte offset of slot `slot`'s FP8 key row in a layer's key buffer, and of its value row in the value buffer.
+pub fn keyRowAt(slot: usize) usize {
+    return slot * key_stride;
+}
+
+pub fn valueRowAt(slot: usize) usize {
+    return slot * wt.head_dim;
+}
+
+/// The slot of position `pos`, KV head `head`.
+pub fn slotOf(pos: usize, head: usize) usize {
+    return pos * wt.kv_heads + head;
+}
+
+// ---- the arithmetic on the CPU ---------------------------------------------------------------------------------
+
+/// The scale's biased exponent for a row whose largest magnitude is `amax`: ceil(log2 amax) + 127 - 8, held in 1..254
+/// (a zero row gets 2^-126 and zero codes). The CUDA kernels compute it on the float's bits just so.
+pub fn scaleExponent(amax: f32) u32 {
+    const bits: u32 = @bitCast(amax);
+    const e: i32 = @intCast(((bits >> 23) & 0xFF) + @intFromBool(bits & 0x7FFFFF != 0));
+    return @intCast(std.math.clamp(e - scale_shift, 1, 254));
+}
+
+/// 2^(ceil(log2 amax) - 8) and its reciprocal, both exact powers of two.
+pub fn scaleOf(amax: f32) f32 {
+    return @bitCast(scaleExponent(amax) << 23);
+}
+
+pub fn scaleInverse(amax: f32) f32 {
+    return @bitCast((254 - scaleExponent(amax)) << 23);
+}
+
+/// The e4m3 code of `x`: round to nearest, ties to the even code, saturating at +-448 (infinities too); NaN is 0x7F.
+/// cvt.rn.satfinite.e4m3x2.f32's result, which cuda_fp8.h's __nv_cvt_float_to_fp8(x, __NV_SATFINITE, __NV_E4M3) is.
+pub fn encode(x: f32) u8 {
+    if (std.math.isNan(x)) return 0x7F;
+    const sign: u8 = if (std.math.signbit(x)) 0x80 else 0;
+    const a = @abs(x);
+    if (a >= e4m3_max) return sign | 0x7E;
+    const bits: u32 = @bitCast(a);
+    const e32: i32 = @intCast(bits >> 23);
+    if (e32 >= 121) { // a normal e4m3 value: 2^-6 and up
+        var e: u32 = @intCast(e32 - 120);
+        var m: u32 = (bits >> 20) & 7;
+        const rest = bits & 0xFFFFF;
+        if (rest > 0x80000 or (rest == 0x80000 and m & 1 == 1)) m += 1;
+        if (m == 8) {
+            m = 0;
+            e += 1;
+        }
+        return sign | @as(u8, @intCast(@min(e << 3 | m, 0x7E)));
+    }
+    // below 2^-6: multiples of 2^-9 (a code of 8 is the first normal value, 2^-6)
+    const t = a * 512.0;
+    const fl = @floor(t);
+    var m: u32 = @intFromFloat(fl);
+    const d = t - fl;
+    if (d > 0.5 or (d == 0.5 and m & 1 == 1)) m += 1;
+    return sign | @as(u8, @intCast(m));
+}
+
+/// The value of an e4m3 code (exact in fp32); 0x7F and 0xFF are NaN.
+pub fn decode(code: u8) f32 {
+    const e: i32 = (code >> 3) & 15;
+    const m: u32 = code & 7;
+    const mag: f32 = if (e == 15 and m == 7)
+        std.math.nan(f32)
+    else if (e == 0)
+        @as(f32, @floatFromInt(m)) * 0x1p-9
+    else
+        (1.0 + @as(f32, @floatFromInt(m)) / 8.0) * std.math.ldexp(@as(f32, 1.0), e - 7);
+    return if (code & 0x80 != 0) -mag else mag;
+}
+
+/// A bf16 value rounded to nearest even, as fp32 (what __float2bfloat16_rn then bf() give).
+pub fn roundBf16(x: f32) f32 {
+    var bits: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return x;
+    bits += 0x7FFF + ((bits >> 16) & 1);
+    bits &= 0xFFFF0000;
+    return @bitCast(bits);
+}
+
+/// A row of bf16 values (as fp32) to codes and its scale: the kernel's `quantize`, one (position, head) row.
+pub fn quantizeRow(x: []const f32, codes: []u8) f32 {
+    std.debug.assert(codes.len == x.len);
+    var amax: f32 = 0;
+    for (x) |v| amax = @max(amax, @abs(v)); // fmaxf drops a NaN, so does @max
+    const inv = scaleInverse(amax);
+    for (x, codes) |v, *c| c.* = encode(v * inv);
+    return scaleOf(amax);
+}
+
+/// A row's codes and scale to the bf16 values the attention tiles hold: exact, e4m3 times a power of two.
+pub fn dequantizeRow(codes: []const u8, scale: f32, out: []f32) void {
+    for (codes, out) |c, *o| o.* = roundBf16(decode(c) * scale);
+}
+
+/// One position's FP8 key row for KV head values `k` and `v` (fp32 holding bf16 values): the codes, both scales and
+/// the zero bytes, and the value row's codes.
+pub fn packRows(k: []const f32, v: []const f32, key_row: []u8, value_row: []u8) void {
+    std.debug.assert(key_row.len == key_stride and value_row.len == wt.head_dim);
+    const sk = quantizeRow(k, key_row[0..wt.head_dim]);
+    const sv = quantizeRow(v, value_row);
+    std.mem.writeInt(u32, key_row[key_scale_at..][0..4], @bitCast(sk), .little);
+    std.mem.writeInt(u32, key_row[value_scale_at..][0..4], @bitCast(sv), .little);
+    @memset(key_row[value_scale_at + 4 ..], 0);
+}
+
+// ---- NVFP4 on the CPU ------------------------------------------------------------------------------------------
+
+/// The NVFP4 row scale's biased exponent: scaleExponent's, 11 below the amax's instead of 8.
+pub fn scaleExponent4(amax: f32) u32 {
+    const bits: u32 = @bitCast(amax);
+    const e: i32 = @intCast(((bits >> 23) & 0xFF) + @intFromBool(bits & 0x7FFFFF != 0));
+    return @intCast(std.math.clamp(e - fp4_scale_shift, 1, 254));
+}
+
+/// |y| to its E2M1 index: round to nearest, ties to the even index, saturating at 6 (kv4_nibble's comparisons).
+pub fn e2m1Index(a: f32) u4 {
+    return @as(u4, @intFromBool(a > 0.25)) + @intFromBool(a >= 0.75) + @intFromBool(a > 1.25) + @intFromBool(a >= 1.75) +
+        @intFromBool(a > 2.5) + @intFromBool(a >= 3.5) + @intFromBool(a > 5.0);
+}
+
+/// A nibble's value: sign << 3 | index.
+pub fn e2m1Value(nibble: u4) f32 {
+    const mag = e2m1_values[nibble & 7];
+    return if (nibble & 8 != 0) -mag else mag;
+}
+
+/// The block scale of a block whose largest scaled magnitude is `bam`: e4m3(bam x fp32(1/6)).
+pub fn blockScale(bam: f32) u8 {
+    return encode(bam * @as(f32, @bitCast(@as(u32, 0x3E2AAAAB))));
+}
+
+/// A row of bf16 values (as fp32) to NVFP4: `row` [fp4_row] gets the code bytes and block scales; returns the row scale.
+pub fn quantizeRow4(x: []const f32, row: []u8) f32 {
+    std.debug.assert(x.len == wt.head_dim and row.len == fp4_row);
+    var amax: f32 = 0;
+    for (x) |v| amax = @max(amax, @abs(v));
+    const e = scaleExponent4(amax);
+    const inv: f32 = @bitCast((254 - e) << 23);
+    var nib: [wt.head_dim]u4 = undefined;
+    for (0..fp4_blocks) |b| {
+        var bam: f32 = 0;
+        for (x[b * 16 ..][0..16]) |v| bam = @max(bam, @abs(v * inv));
+        const b8 = blockScale(bam);
+        row[fp4_codes + b] = b8;
+        const bs = decode(b8);
+        for (b * 16..b * 16 + 16) |i| {
+            const y = (x[i] * inv) / (if (bs == 0) @as(f32, 1.0) else bs);
+            const k = e2m1Index(@abs(y));
+            nib[i] = k | (if (y < 0 and k > 0) @as(u4, 8) else 0);
+        }
+    }
+    for (0..fp4_codes) |j| row[j] = @as(u8, nib[j]) | (@as(u8, nib[j + fp4_codes]) << 4);
+    return @bitCast(e << 23);
+}
+
+/// An NVFP4 row's element `i` (the dequantized value, exact in fp32): e2m1 x block scale x s.
+pub fn element4(row: []const u8, s: f32, i: usize) f32 {
+    const byte = row[i % fp4_codes];
+    const nibble: u4 = @intCast(if (i < fp4_codes) byte & 15 else byte >> 4);
+    return e2m1Value(nibble) * decode(row[fp4_codes + i / 16]) * s;
+}
+
+/// An NVFP4 row and scale to the bf16 values the attention tiles hold.
+pub fn dequantizeRow4(row: []const u8, s: f32, out: []f32) void {
+    for (out, 0..) |*o, i| o.* = roundBf16(element4(row, s, i));
+}
+
+/// The kernel's widening (kv4_widen16) of one element on the CPU: the nibble's bf16 bits (e2m1 x 2^-126), times the block
+/// scale as bf16 times 2^119, times s as bf16 times 2^7, each product rounded to bf16 (as mul.bf16x2 rounds it).
+pub fn widen4(nibble: u4, block: u8, s: f32) f32 {
+    const n: u32 = nibble;
+    const bits: u32 = ((n & 8) << 12) | ((n & 7) << 6);
+    const v: f32 = @bitCast(bits << 16);
+    const bs = roundBf16(decode(block) * 0x1p119);
+    const s7 = roundBf16(s * 128.0);
+    return roundBf16(roundBf16(v * bs) * s7);
+}
+
+/// One position's NVFP4 rows for KV head values `k` and `v`: nvfp4 keys (`k8` false, key_row fp4_key_stride bytes) or
+/// FP8 keys (fp8k_nvfp4v, key_row key_stride bytes, packRows' key row), the NVFP4 value row, both scales in the key row's
+/// trailer.
+pub fn packRows4(k8: bool, k: []const f32, v: []const f32, key_row: []u8, value_row: []u8) void {
+    std.debug.assert(key_row.len == (if (k8) key_stride else fp4_key_stride) and value_row.len == fp4_row);
+    const sk = if (k8) quantizeRow(k, key_row[0..wt.head_dim]) else quantizeRow4(k, key_row[0..fp4_row]);
+    const sv = quantizeRow4(v, value_row);
+    const at = key_row.len - key_trailer;
+    std.mem.writeInt(u32, key_row[at..][0..4], @bitCast(sk), .little);
+    std.mem.writeInt(u32, key_row[at + 4 ..][0..4], @bitCast(sv), .little);
+    @memset(key_row[at + 8 ..], 0);
+}
+
+// ---- any quantized format --------------------------------------------------------------------------------------
+
+/// One KV head's key row in format `kv` (bytes; bf16: head_dim * 2).
+pub fn keyStride(kv: Kv) usize {
+    return kv.keyRow() / wt.kv_heads;
+}
+
+/// One KV head's value row in format `kv`.
+pub fn valueStride(kv: Kv) usize {
+    return kv.valueRow() / wt.kv_heads;
+}
+
+/// Where a quantized key row's trailer (s_k, s_v) starts.
+pub fn trailerAt(kv: Kv) usize {
+    return keyStride(kv) - key_trailer;
+}
+
+/// One position's rows for KV head values `k` and `v` in quantized format `kv` (what fn_attn_prep_<suffix> writes).
+pub fn pack(kv: Kv, k: []const f32, v: []const f32, key_row: []u8, value_row: []u8) void {
+    switch (kv) {
+        .bf16 => unreachable,
+        .fp8 => packRows(k, v, key_row, value_row),
+        .nvfp4 => packRows4(false, k, v, key_row, value_row),
+        .fp8k_nvfp4v => packRows4(true, k, v, key_row, value_row),
+    }
+}
+
+/// A quantized position's key (`value` false) or value row as the bf16 values the attention tiles hold.
+pub fn unpack(kv: Kv, key_row: []const u8, value_row: []const u8, value: bool, out: []f32) void {
+    const s: f32 = @bitCast(std.mem.readInt(u32, key_row[trailerAt(kv) + 4 * @as(usize, @intFromBool(value)) ..][0..4], .little));
+    const fp8 = if (value) kv == .fp8 else kv != .nvfp4;
+    const row = if (value) value_row else key_row;
+    if (fp8) dequantizeRow(row[0..wt.head_dim], s, out) else dequantizeRow4(row[0..fp4_row], s, out);
+}
+
+// ---- tests -----------------------------------------------------------------------------------------------------
+
+/// The code of the e4m3 value nearest `a` (a >= 0, below 448), the even code on a tie, by looking at every code.
+fn nearest(a: f32) u8 {
+    var best: u8 = 0;
+    var best_gap: f64 = std.math.inf(f64);
+    var code: u8 = 0;
+    while (code < 0x7F) : (code += 1) {
+        const gap = @abs(@as(f64, decode(code)) - @as(f64, a));
+        if (gap < best_gap or (gap == best_gap and code & 1 == 0)) {
+            best_gap = gap;
+            best = code;
+        }
+    }
+    return best;
+}
+
+test "a position's FP8 rows: 1,056 bytes a layer, 272-byte key rows and 256-byte value rows" {
+    try std.testing.expectEqual(@as(usize, 2048), Kv.bf16.kvRow());
+    try std.testing.expectEqual(@as(usize, 1056), Kv.fp8.kvRow());
+    try std.testing.expectEqual(@as(usize, 272), key_stride);
+    try std.testing.expectEqual(@as(usize, 0), key_stride % 16);
+    try std.testing.expectEqual(@as(usize, 2 * 272), Kv.fp8.keyRow());
+    try std.testing.expectEqual(@as(usize, 2 * 256), Kv.fp8.valueRow());
+    try std.testing.expectEqual(@as(usize, 2048 + 256), Kv.bf16.position());
+    try std.testing.expectEqual(@as(usize, 1056 + 256), Kv.fp8.position());
+    // the trailer holds both scales and 8 zero bytes
+    try std.testing.expectEqual(@as(usize, key_stride), value_scale_at + 4 + 8);
+    // slots are position-major, head-minor: the rows of one position are adjacent
+    try std.testing.expectEqual(@as(usize, 2 * 272), keyRowAt(slotOf(1, 0)));
+    try std.testing.expectEqual(@as(usize, 2 * 272 + 272), keyRowAt(slotOf(1, 1)));
+    try std.testing.expectEqual(@as(usize, 3 * 256), valueRowAt(slotOf(1, 1)));
+}
+
+test "the README's per-token figures: 13 layers of 1,376 bytes, 17,888 fp8 against 30,784 bf16" {
+    const pooled = wt.index_dim * 2 / wt.index_ratio; // a block of 4 positions pools to one 256-byte row
+    try std.testing.expectEqual(@as(usize, 64), pooled);
+    try std.testing.expectEqual(@as(usize, 1376), Kv.fp8.position() + pooled);
+    try std.testing.expectEqual(@as(usize, 17888), 13 * (Kv.fp8.position() + pooled));
+    try std.testing.expectEqual(@as(usize, 30784), 13 * (Kv.bf16.position() + pooled));
+}
+
+test "the e4m3 table: 126 finite magnitudes, 448 at the top, 2^-9 at the bottom, NaN at 0x7F" {
+    try std.testing.expectEqual(@as(f32, 448.0), decode(0x7E));
+    try std.testing.expectEqual(@as(f32, 0x1p-9), decode(1));
+    try std.testing.expectEqual(@as(f32, 0x1p-6), decode(8));
+    try std.testing.expectEqual(@as(f32, 1.0), decode(0x38));
+    try std.testing.expectEqual(@as(f32, -2.0), decode(0xC0));
+    try std.testing.expect(std.math.isNan(decode(0x7F)) and std.math.isNan(decode(0xFF)));
+    var prev: f32 = -1;
+    var code: u8 = 0;
+    while (code < 0x7F) : (code += 1) { // strictly increasing: every code a distinct value
+        try std.testing.expect(decode(code) > prev);
+        prev = decode(code);
+    }
+}
+
+test "encode is round to nearest even over every code, saturating, and decode inverts it" {
+    var code: u8 = 0;
+    while (code < 0x7F) : (code += 1) {
+        try std.testing.expectEqual(code, encode(decode(code)));
+        try std.testing.expectEqual(code | 0x80, encode(-decode(code))); // -0.0 is 0x80
+    }
+    // a grid of magnitudes over the whole range, ties included, against the brute-force nearest code
+    var checked: usize = 0;
+    var bits: u32 = 0x3A800000; // 2^-10
+    while (bits < 0x43E00000) : (bits += 0x4801) { // to 448
+        const a: f32 = @bitCast(bits);
+        if (a >= e4m3_max) break;
+        try std.testing.expectEqual(nearest(a), encode(a));
+        checked += 1;
+    }
+    try std.testing.expect(checked > 2000);
+    // midpoints between neighbours go to the even code
+    code = 0;
+    while (code < 0x7E) : (code += 1) {
+        const mid = (decode(code) + decode(code + 1)) / 2;
+        try std.testing.expectEqual(if (code & 1 == 0) code else code + 1, encode(mid));
+    }
+    // saturation and the special values
+    try std.testing.expectEqual(@as(u8, 0x7E), encode(448.0));
+    try std.testing.expectEqual(@as(u8, 0x7E), encode(470.0));
+    try std.testing.expectEqual(@as(u8, 0x7E), encode(1.0e30));
+    try std.testing.expectEqual(@as(u8, 0xFE), encode(-std.math.inf(f32)));
+    try std.testing.expectEqual(@as(u8, 0x7F), encode(std.math.nan(f32)));
+    try std.testing.expectEqual(@as(u8, 0), encode(0.0));
+    try std.testing.expectEqual(@as(u8, 0x80), encode(-0.0));
+    try std.testing.expectEqual(@as(u8, 0), encode(0x1p-11)); // under half of the smallest subnormal
+    try std.testing.expectEqual(@as(u8, 1), encode(0x1p-10 * 1.0001));
+    try std.testing.expectEqual(@as(u8, 0), encode(0x1p-10)); // the tie goes to the even code, zero
+}
+
+test "the scale is 2^(ceil(log2 amax) - 8) by the float's bits" {
+    // the definition in floating point, for every amax the cache can see (a bf16 magnitude from 2^-100 to 2^100)
+    var k: i32 = -100;
+    while (k <= 100) : (k += 1) {
+        const p = std.math.pow(f64, 2.0, @floatFromInt(k));
+        for ([_]f64{ 1.0, 1.0078125, 1.5, 1.9921875 }) |frac| {
+            const amax: f32 = @floatCast(p * frac);
+            const want: f64 = std.math.pow(f64, 2.0, std.math.ceil(std.math.log2(@as(f64, amax))) - 8);
+            try std.testing.expectEqual(@as(f32, @floatCast(want)), scaleOf(amax));
+            try std.testing.expectEqual(@as(f32, @floatCast(1.0 / want)), scaleInverse(amax));
+            // the row's largest value quantizes into (128, 256]
+            const top = amax * scaleInverse(amax);
+            try std.testing.expect(top > 128.0 and top <= 256.0);
+        }
+    }
+    // a zero row: scale 2^-126, inverse 2^126, zero codes
+    try std.testing.expectEqual(@as(f32, 0x1p-126), scaleOf(0));
+    try std.testing.expectEqual(@as(f32, 0x1p126), scaleInverse(0));
+    // an exact power of two keeps its exponent: 1.0 / 2^-8 = 256 is the top of the range
+    try std.testing.expectEqual(@as(f32, 0x1p-8), scaleOf(1.0));
+    try std.testing.expectEqual(@as(f32, 0x1p-7), scaleOf(1.0000001));
+}
