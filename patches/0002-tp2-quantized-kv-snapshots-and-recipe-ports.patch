@@ -0,0 +1,384 @@
+//! TF_FLASHNEXT_SHARED_POOL=1: live streams and the prompt cache share one pool.
+//!
+//! v1.1.4 charges every admitted stream a full window at startup (8 x 393,232 tokens of nvfp4 caches and the MTP
+//! head's: ~38 GiB) and gives the prompt cache only what that leaves; a stream's sequence is then made at open for
+//! its own prompt + max_tokens. With the pool on, startup charges each stream only its fixed part (DeltaNet states,
+//! the n-gram tail, the head's buffers, the image rows), the prompt cache takes its asked budget beside them, and a
+//! stream's real caches are admitted when it opens: live streams + kept states + the new one must fit the startup
+//! room, kept prompt states giving theirs back first (never the one the stream restores, never a borrowed one), else
+//! error.LaneMemory (the lane host requeues the request until a stream ends). A memory floor
+//! (TENSORFOLD_MEMORY_FLOOR_GIB, default the reserve up to 10 GiB) frees kept states while the new stream's
+//! bytes would leave MemAvailable under it: none when freeing every kept state would not reach it. The prompt
+//! cache's budget follows the room the live streams leave (its own asked budget at most), so a keep never takes
+//! memory a live stream holds. Every floor decision goes through the process's memory ledger (lanes/memory_ledger.zig):
+//! MemAvailable must also cover TENSORFOLD_MEMORY_HEADROOM_MIB (default 256) and the bytes other decisions promised but
+//! have not allocated yet, the HTTP threads' image preparation among them.
+const std = @import("std");
+const ml = @import("lanes").memory_ledger;
+
+const gib: f64 = 1 << 30;
+
+/// The prompt cache as the pool sees it (native/cuda.zig makes it from its Store).
+pub const Store = struct {
+    ctx: *anyopaque,
+    /// Bytes its kept states hold now.
+    held: *const fn (ctx: *anyopaque) u64,
+    /// Evict kept states (never `restoring`, never a borrowed one) until `want` more bytes are free; false if it cannot.
+    give: *const fn (ctx: *anyopaque, restoring: ?*anyopaque, prompt: []const u32, want: u64) bool,
+    /// The most bytes its kept states may take from now on.
+    limit: *const fn (ctx: *anyopaque, bytes: u64) void,
+};
+
+pub const Error = error{ BadMemoryFloor, PoolOneRank };
+
+/// TF_FLASHNEXT_SHARED_POOL: 1/on turns the pool on; unset, 0 or off leave v1.1.4's full-window charge.
+pub fn enabled() bool {
+    const v = std.mem.span(std.c.getenv("TF_FLASHNEXT_SHARED_POOL") orelse return false);
+    return !(v.len == 0 or std.mem.eql(u8, v, "0") or std.mem.eql(u8, v, "off"));
+}
+
+/// TENSORFOLD_MEMORY_FLOOR_GIB in bytes: a finite 0..4096 (0: no floor), else error; null when unset.
+pub fn floorFromEnv() Error!?u64 {
+    return floorFrom(if (std.c.getenv("TENSORFOLD_MEMORY_FLOOR_GIB")) |v| std.mem.span(v) else null);
+}
+
+pub fn floorFrom(text: ?[]const u8) Error!?u64 {
+    const t = std.mem.trim(u8, text orelse return null, " ");
+    if (t.len == 0) return null;
+    const g = std.fmt.parseFloat(f64, t) catch return error.BadMemoryFloor;
+    if (!std.math.isFinite(g) or g < 0 or g > 4096) return error.BadMemoryFloor;
+    return @intFromFloat(g * gib);
+}
+
+/// /proc/meminfo's MemAvailable in bytes, or null.
+pub fn memAvailable() ?u64 {
+    var buf: [8192]u8 = undefined;
+    const fd = std.c.open("/proc/meminfo", .{ .ACCMODE = .RDONLY });
+    if (fd < 0) return null;
+    defer _ = std.c.close(fd);
+    const n = std.c.read(fd, &buf, buf.len);
+    if (n <= 0) return null;
+    return parseAvailable(buf[0..@intCast(n)]);
+}
+
+pub fn parseAvailable(text: []const u8) ?u64 {
+    var rows = std.mem.tokenizeScalar(u8, text, '\n');
+    while (rows.next()) |row| {
+        var words = std.mem.tokenizeAny(u8, row, ": \t");
+        if (!std.mem.eql(u8, words.next() orelse continue, "MemAvailable")) continue;
+        const kib = std.fmt.parseInt(u64, words.next() orelse return null, 10) catch return null;
+        return std.math.mul(u64, kib, 1024) catch null;
+    }
+    return null;
+}
+
+pub const Pool = struct {
+    on: bool = false,
+    /// The startup room every live stream's caches and the kept states share.
+    room: u64 = 0,
+    /// The prompt cache's asked budget (the most its states take with no stream live).
+    cache: u64 = 0,
+    /// MemAvailable a new stream leaves at least, freeing kept states for it (0: no floor).
+    floor: u64 = 0,
+    /// Bytes the live streams' caches hold.
+    live: u64 = 0,
+    store: ?Store = null,
+    /// MemAvailable now (a test's reading in tests).
+    available: *const fn () ?u64 = memAvailable,
+    /// Room above the floor for small host transients (TENSORFOLD_MEMORY_HEADROOM_MIB).
+    headroom: u64 = 0,
+    /// The process's ledger once attached (poolAttach); a test's pool keeps its own, from the fields above.
+    ledger: ?*ml.Ledger = null,
+    own: ml.Ledger = .{},
+    log: bool = !@import("builtin").is_test,
+
+    fn led(p: *Pool) *ml.Ledger {
+        if (p.ledger) |l| return l;
+        p.own.configure(p.floor, p.headroom, p.available);
+        return &p.own;
+    }
+
+    /// Bytes a floor decision that fitted promised, now allocated (MemAvailable shows them) or given up: the caller of
+    /// a true takeWith settles need + transient, of a true claimKeep its bytes.
+    pub fn settle(p: *Pool, bytes: u64) void {
+        if (!p.on or p.floor == 0) return;
+        p.led().settle(bytes);
+    }
+
+    fn held(p: *const Pool) u64 {
+        return if (p.store) |s| s.held(s.ctx) else 0;
+    }
+
+    /// The prompt cache's budget: what the live streams leave of the room, its asked budget at most.
+    fn limitCache(p: *const Pool) void {
+        if (p.store) |s| s.limit(s.ctx, @min(p.cache, p.room -| p.live));
+    }
+
+    /// Admit a new stream's `need` bytes, kept states giving theirs back (never `restoring`'s); false: it waits.
+    pub fn take(p: *Pool, need: u64, restoring: ?*anyopaque, prompt: []const u32) bool {
+        return p.takeWith(need, 0, restoring, prompt);
+    }
+
+    /// take, with `transient` more bytes (host buffers made and freed while the stream opens: an image's encode) that
+    /// must fit above the floor too but are not charged to the stream. True: need + transient stay pending in the
+    /// ledger until the caller settles them, once the stream's buffers are made (or its open failed).
+    pub fn takeWith(p: *Pool, need: u64, transient: u64, restoring: ?*anyopaque, prompt: []const u32) bool {
+        if (!p.on) return true;
+        if (p.live + need > p.room) {
+            if (p.log) std.log.info("pool: a stream needs {d:.2} GiB, the live streams hold {d:.2} of {d:.2} GiB: it waits for a stream to end", .{ toGib(need), toGib(p.live), toGib(p.room) });
+            return false;
+        }
+        const before = p.held();
+        if (p.live + before + need > p.room) {
+            const s = p.store.?;
+            if (!s.give(s.ctx, restoring, prompt, p.live + before + need - p.room)) {
+                if (p.log) std.log.info("pool: a stream needs {d:.2} GiB; live {d:.2} GiB and kept states {d:.2} GiB (the one it restores or a borrowed one) leave too little of {d:.2} GiB: it waits", .{ toGib(need), toGib(p.live), toGib(p.held()), toGib(p.room) });
+                return false;
+            }
+        }
+        if (!p.floorAdmit(need + transient, restoring, prompt)) return false;
+        const freed = before -| p.held();
+        if (p.log and freed > 0) std.log.info("pool: kept prompt states gave {d:.2} GiB back for a stream's {d:.2} GiB", .{ toGib(freed), toGib(need) });
+        p.live += need;
+        p.limitCache();
+        return true;
+    }
+
+    /// Whether `need` leaves MemAvailable at the floor, the headroom and every pending promise or above (the ledger's
+    /// claim, which keeps it pending), kept states going first while it would not (none when all of them could not
+    /// make it up); false: the stream waits (LaneMemory). MemAvailable is read again after the states go. Unreadable
+    /// MemAvailable refuses (the floor cannot be checked).
+    fn floorAdmit(p: *Pool, need: u64, restoring: ?*anyopaque, prompt: []const u32) bool {
+        if (p.floor == 0) return true;
+        const l = p.led();
+        switch (l.claim(need)) {
+            .fits => return true,
+            .unreadable => return p.unreadable("a stream waits"),
+            .short, .busy => {},
+        }
+        const short = l.shortfall(need);
+        if (p.store) |s| if (s.held(s.ctx) >= short) {
+            _ = s.give(s.ctx, restoring, prompt, short);
+            switch (l.claim(need)) {
+                .fits => return true,
+                .unreadable => return p.unreadable("a stream waits"),
+                .short, .busy => {},
+            }
+            if (p.log) std.log.info("pool: a {d:.2} GiB stream would leave MemAvailable under the {d:.1} GiB floor + {d:.0} MiB headroom ({d:.2} GiB pending, {d:.2} GiB of it image preparation) after kept states went: it waits", .{ toGib(need), toGib(p.floor), toMib(p.headroom), toGib(l.pendingBytes()), toGib(l.mediaBytes()) });
+            return false;
+        };
+        if (p.log) std.log.info("pool: a {d:.2} GiB stream would leave MemAvailable under the {d:.1} GiB floor + {d:.0} MiB headroom ({d:.2} GiB pending, {d:.2} GiB of it image preparation) and the kept states could not make that up (none freed): it waits", .{ toGib(need), toGib(p.floor), toMib(p.headroom), toGib(l.pendingBytes()), toGib(l.mediaBytes()) });
+        return false;
+    }
+
+    fn unreadable(p: *const Pool, what: []const u8) bool {
+        if (p.log) std.log.err("pool: MemAvailable is unreadable (/proc/meminfo) and the memory floor is {d:.1} GiB: {s} (TENSORFOLD_MEMORY_FLOOR_GIB=0 turns the floor off)", .{ toGib(p.floor), what });
+        return false;
+    }
+
+    /// Whether a kept prompt state's `bytes` (its copy, and the store's own entry) would leave MemAvailable at the floor,
+    /// the headroom and every pending promise or above, nothing claimed: checked before the keep's first allocation.
+    pub fn keepFits(p: *Pool, bytes: u64) bool {
+        if (!p.on or p.floor == 0) return true;
+        return switch (p.led().check(bytes)) {
+            .fits => true,
+            .unreadable => p.unreadable("a prompt state is not kept"),
+            .short, .busy => blk: {
+                if (p.log) std.log.info("pool: a {d:.2} GiB prompt state would leave MemAvailable under the {d:.1} GiB floor + {d:.0} MiB headroom: not kept", .{ toGib(bytes), toGib(p.floor), toMib(p.headroom) });
+                break :blk false;
+            },
+        };
+    }
+
+    /// keepFits for the copy itself, claimed (pending until the caller settles it after the copy is made); false: the
+    /// caller skips it (a keep is optional: a later turn prefills those rows).
+    pub fn claimKeep(p: *Pool, bytes: u64) bool {
+        if (!p.on or p.floor == 0) return true;
+        return switch (p.led().claim(bytes)) {
+            .fits => true,
+            .unreadable => p.unreadable("a prompt state is not kept"),
+            .short, .busy => blk: {
+                if (p.log) std.log.info("pool: a {d:.2} GiB prompt state would leave MemAvailable under the {d:.1} GiB floor + {d:.0} MiB headroom: not kept", .{ toGib(bytes), toGib(p.floor), toMib(p.headroom) });
+                break :blk false;
+            },
+        };
+    }
+
+    /// A stream's caches went.
+    pub fn give(p: *Pool, bytes: u64) void {
+        if (!p.on) return;
+        p.live -|= bytes;
+        p.limitCache();
+    }
+
+    /// The startup line's words.
+    pub fn report(p: *const Pool) void {
+        if (!p.log or !p.on) return;
+        std.log.info("TF_FLASHNEXT_SHARED_POOL=1: streams take their caches as they open; streams and a {d:.1} GiB prompt cache share {d:.2} GiB; memory floor: admission, keeps and image preparation leave {d:.1} GiB MemAvailable + {d:.0} MiB headroom", .{ toGib(p.cache), toGib(p.room), toGib(p.floor), toMib(p.headroom) });
+    }
+};
+
+fn toGib(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / gib;
+}
+
+fn toMib(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / (1 << 20);
+}
+
+/// A store of states by size, oldest given back first, one of them pinned (the restored one).
+const Fake = struct {
+    states: [8]u64 = @splat(0),
+    n: usize = 0,
+    budget: u64 = 0,
+    gave: u64 = 0,
+    fn of(ctx: *anyopaque) *Fake {
+        return @ptrCast(@alignCast(ctx));
+    }
+    fn held(ctx: *anyopaque) u64 {
+        var t: u64 = 0;
+        for (of(ctx).states[0..of(ctx).n]) |b| t += b;
+        return t;
+    }
+    fn give(ctx: *anyopaque, restoring: ?*anyopaque, _: []const u32, want: u64) bool {
+        const f = of(ctx);
+        const pin: usize = if (restoring) |r| @intFromPtr(r) - 1 else std.math.maxInt(usize);
+        var freed: u64 = 0;
+        for (f.states[0..f.n], 0..) |*b, i| {
+            if (freed >= want) break;
+            if (i == pin) continue;
+            freed += b.*;
+            f.gave += b.*;
+            if (test_available) |*a| a.* += b.*; // its memory comes back to MemAvailable
+            b.* = 0;
+        }
+        return freed >= want;
+    }
+    fn limit(ctx: *anyopaque, bytes: u64) void {
+        of(ctx).budget = bytes;
+    }
+    fn store(f: *Fake) Store {
+        return .{ .ctx = f, .held = held, .give = give, .limit = limit };
+    }
+};
+
+var test_available: ?u64 = null;
+fn testAvailable() ?u64 {
+    return test_available;
+}
+
+test "the shared pool: kept states give back for a stream, never the restored one, else it waits" {
+    const g: u64 = 1 << 30;
+    var f: Fake = .{ .states = .{ 6 * g, 9 * g, 12 * g, 0, 0, 0, 0, 0 }, .n = 3 };
+    var p: Pool = .{ .on = true, .room = 33 * g, .cache = 28 * g, .store = f.store(), .available = testAvailable };
+    test_available = null;
+    try std.testing.expect(p.take(4 * g, null, &.{})); // 27 kept + 4 fits 33
+    try std.testing.expectEqual(@as(u64, 4 * g), p.live);
+    try std.testing.expectEqual(@as(u64, 28 * g), f.budget);
+    try std.testing.expect(p.take(5 * g, @ptrFromInt(3), &.{})); // 36 > 33: the 6 GiB state goes, the 12 GiB one stays
+    try std.testing.expectEqual(@as(u64, 6 * g), f.gave);
+    try std.testing.expectEqual(@as(u64, 24 * g), f.budget); // the cache's budget follows the room the streams leave
+    try std.testing.expect(!p.take(13 * g, @ptrFromInt(3), &.{})); // 9 live + 12 pinned + 13 > 33: waits (the 9 GiB state
+    // went trying, as v1.1.4's Store.giveBack does)
+    p.give(5 * g);
+    try std.testing.expectEqual(@as(u64, 4 * g), p.live);
+    try std.testing.expect(!p.take(30 * g, null, &.{})); // past the room with no state kept: waits, nothing freed first
+    try std.testing.expectEqual(@as(u64, 15 * g), f.gave);
+    var off: Pool = .{};
+    try std.testing.expect(off.take(1 << 50, null, &.{})); // off: v1.1.4's admission, nothing counted
+    try std.testing.expectEqual(@as(u64, 0), off.live);
+}
+
+test "the memory floor frees kept states for a stream, none when they cannot make it up" {
+    const g: u64 = 1 << 30;
+    var f: Fake = .{ .states = .{ 2 * g, 2 * g, 0, 0, 0, 0, 0, 0 }, .n = 2 };
+    var p: Pool = .{ .on = true, .room = 100 * g, .cache = 28 * g, .floor = 3 * g, .store = f.store(), .available = testAvailable };
+    test_available = 6 * g;
+    try std.testing.expect(p.take(4 * g, null, &.{})); // 6 - 4 < 3: one 2 GiB state goes, MemAvailable 8 - 4 >= 3
+    try std.testing.expectEqual(@as(u64, 2 * g), f.gave);
+    try std.testing.expectEqual(@as(u64, 4 * g), p.live);
+    test_available = 1 * g;
+    try std.testing.expect(!p.take(4 * g, null, &.{})); // 6 short, 2 kept: none freed, the stream waits
+    try std.testing.expectEqual(@as(u64, 2 * g), f.gave);
+    try std.testing.expectEqual(@as(u64, 4 * g), p.live); // nothing charged for it
+    var bare: Pool = .{ .on = true, .room = 100 * g, .floor = 3 * g, .available = testAvailable };
+    test_available = 5 * g;
+    try std.testing.expect(!bare.take(4 * g, null, &.{})); // no prompt cache: the floor still holds
+    try std.testing.expect(bare.take(2 * g, null, &.{}));
+}
+
+test "the memory floor waits when the freed states do not show up in MemAvailable" {
+    const g: u64 = 1 << 30;
+    var f: Fake = .{ .states = .{ 4 * g, 0, 0, 0, 0, 0, 0, 0 }, .n = 1 };
+    var p: Pool = .{ .on = true, .room = 100 * g, .cache = 28 * g, .floor = 3 * g, .store = f.store(), .available = stuckAvailable };
+    try std.testing.expect(!p.take(4 * g, null, &.{})); // 2 short: the state goes, MemAvailable reads 5 again: waits
+    try std.testing.expectEqual(@as(u64, 4 * g), f.gave);
+    try std.testing.expectEqual(@as(u64, 0), p.live);
+}
+
+fn stuckAvailable() ?u64 {
+    return 5 << 30;
+}
+
+fn noAvailable() ?u64 {
+    return null;
+}
+
+test "an unreadable MemAvailable refuses streams and keeps under a floor, and admits with the floor off" {
+    const g: u64 = 1 << 30;
+    var p: Pool = .{ .on = true, .room = 100 * g, .floor = 3 * g, .available = noAvailable };
+    try std.testing.expect(!p.take(g, null, &.{}));
+    try std.testing.expect(!p.claimKeep(g));
+    try std.testing.expect(!p.keepFits(g));
+    try std.testing.expectEqual(@as(u64, 0), p.live);
+    p.floor = 0;
+    try std.testing.expect(p.take(g, null, &.{}));
+    try std.testing.expect(p.claimKeep(g));
+    try std.testing.expect(p.keepFits(g));
+}
+
+test "a keep and a stream's transient bytes must fit above the floor" {
+    const g: u64 = 1 << 30;
+    var p: Pool = .{ .on = true, .room = 100 * g, .floor = 3 * g, .available = stuckAvailable }; // 5 GiB available
+    try std.testing.expect(p.keepFits(2 * g));
+    try std.testing.expect(!p.keepFits(2 * g + 1)); // 3.2 GiB left, a 1 GiB keep: refused
+    try std.testing.expect(!p.claimKeep(2 * g + 1));
+    try std.testing.expect(!p.takeWith(g, g + 1, null, &.{})); // 1 GiB charged + 1 GiB transient: past the floor
+    try std.testing.expect(p.takeWith(g, g, null, &.{}));
+    try std.testing.expectEqual(@as(u64, g), p.live); // only the charge counts
+    p.settle(2 * g);
+    try std.testing.expect(p.claimKeep(2 * g));
+    p.settle(2 * g);
+}
+
+test "promises not yet allocated, the headroom and image preparation count in every floor decision" {
+    const g: u64 = 1 << 30;
+    const m: u64 = 1 << 20;
+    var p: Pool = .{ .on = true, .room = 100 * g, .floor = 3 * g, .headroom = 256 * m, .available = stuckAvailable }; // 5 GiB
+    try std.testing.expect(!p.keepFits(2 * g)); // 2 + 3 + 0.25 > 5
+    try std.testing.expect(p.take(g, null, &.{})); // 1 GiB promised, not in MemAvailable yet
+    try std.testing.expect(!p.keepFits(g)); // 1 pending + 1 + 3.25 > 5
+    try std.testing.expect(!p.claimKeep(g));
+    p.settle(g); // the stream's buffers made: MemAvailable (stuck here at 5) is now the truth
+    try std.testing.expect(p.claimKeep(g));
+    try std.testing.expect(!p.take(g, null, &.{})); // the keep's copy is still being made
+    p.settle(g);
+    const l = p.led();
+    try std.testing.expectEqual(ml.Verdict.fits, l.reserveMedia(512 * m)); // an HTTP thread prepares an image
+    try std.testing.expect(!p.take(g + 512 * m, null, &.{})); // 1.5 + 0.5 + 3.25 > 5
+    try std.testing.expect(p.take(g, null, &.{}));
+    p.settle(g);
+    l.releaseMedia(512 * m);
+    try std.testing.expectEqual(@as(u64, 0), l.pendingBytes());
+}
+
+test "TENSORFOLD_MEMORY_FLOOR_GIB and MemAvailable parse" {
+    try std.testing.expectEqual(@as(?u64, null), try floorFrom(null));
+    try std.testing.expectEqual(@as(?u64, 3 << 30), try floorFrom("3"));
+    try std.testing.expectEqual(@as(?u64, 0), try floorFrom("0"));
+    try std.testing.expectError(error.BadMemoryFloor, floorFrom("-1"));
+    try std.testing.expectError(error.BadMemoryFloor, floorFrom("nan"));
+    try std.testing.expectError(error.BadMemoryFloor, floorFrom("5000"));
+    try std.testing.expectEqual(@as(?u64, 3 * 1024), parseAvailable("MemTotal: 10 kB\nMemAvailable:       3 kB\n"));
+    try std.testing.expectEqual(@as(?u64, null), parseAvailable("MemTotal: 10 kB\n"));
+}
