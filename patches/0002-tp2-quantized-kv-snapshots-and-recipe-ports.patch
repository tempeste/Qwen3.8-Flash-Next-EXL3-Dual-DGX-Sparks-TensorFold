+/// A picture's width and height from its header alone (PNG's IHDR, JPEG's frames before the scan, WebP's VP8, VP8L or
+/// VP8X chunk), the fields the decoders size their pixels by; null when the header does not say (callers then assume
+/// max_pixels). Nothing is decoded or allocated.
+pub fn dims(bytes: []const u8) ?[2]u64 {
+    return switch (sniff(bytes)) {
+        .png => pngDims(bytes),
+        .jpeg => jpegDims(bytes),
+        .webp => webpDims(bytes),
+        .unknown => null,
+    };
+}
+
+/// IHDR among the chunks before the image data (a chunk may come first, as Pillow allowed).
+fn pngDims(data: []const u8) ?[2]u64 {
+    var at: usize = png.signature.len;
+    while (data.len - at >= 8) {
+        const n = std.mem.readInt(u32, data[at..][0..4], .big);
+        const kind = data[at + 4 ..][0..4];
+        if (std.mem.eql(u8, kind, "IDAT")) return null;
