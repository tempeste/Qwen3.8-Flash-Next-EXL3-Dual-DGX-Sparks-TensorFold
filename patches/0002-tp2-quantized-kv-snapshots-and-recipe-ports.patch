diff --git a/zig/src/native/cuda_pool_store.zig b/zig/src/native/cuda_pool_store.zig
new file mode 100644
index 0000000000000000000000000000000000000000..80959247c84d00754ebfd240b422686ebbd08ef2
--- /dev/null
+++ b/zig/src/native/cuda_pool_store.zig
@@ -0,0 +1,70 @@
+//! A family's shared pool (Flash Next's TF_FLASHNEXT_SHARED_POOL, cuda_pool.zig) over the host's prompt cache.
+const std = @import("std");
+const pc = @import("engine_api").prompt_cache;
+
+/// `store` as F's pool sees it: its held bytes, its states given back, its budget moved.
+pub fn of(comptime F: type, store: ?*pc.Store) ?F.PoolStore {
+    const s = store orelse return null;
+    return .{ .ctx = s, .held = held, .give = give, .limit = limit };
+}
+
+fn st(ctx: *anyopaque) *pc.Store {
+    return @ptrCast(@alignCast(ctx));
+}
+
+fn held(ctx: *anyopaque) u64 {
+    return st(ctx).held;
+}
+
+/// Kept states go (Store.giveBack: never `restoring`, never a borrowed one) until `want` bytes are free.
+fn give(ctx: *anyopaque, restoring: ?*anyopaque, prompt: []const u32, want: u64) bool {
+    const s = st(ctx);
+    return s.giveBack(restoring, prompt, Freed{ .store = s, .before = s.held, .want = want });
+}
+
+const Freed = struct {
+    store: *const pc.Store,
+    before: u64,
+    want: u64,
+    pub fn fits(f: Freed) bool {
+        return f.before -| f.store.held >= f.want;
+    }
+};
+
+fn limit(ctx: *anyopaque, bytes: u64) void {
+    st(ctx).budget = bytes;
+}
+
+test "a pool's store gives back kept states until enough is free, never the restored one" {
+    const gpa = std.testing.allocator;
+    const Fake = struct {
+        fn bytes(_: *anyopaque, at: u32) u64 {
+            return at;
+        }
+        fn save(_: *anyopaque, _: ?*anyopaque, at: u32) anyerror!pc.Saved {
+            return @ptrFromInt(@as(usize, at) << 4);
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {}
+        fn drop(_: *anyopaque, _: pc.Saved) void {}
+    };
+    var dummy: u8 = 0;
+    var store = pc.Store.init(gpa, .{ .ptr = &dummy, .vtable = &.{ .bytes = Fake.bytes, .save = Fake.save, .restore = Fake.restore, .drop = Fake.drop } }, .{}, 1 << 20);
+    defer store.deinit();
+    var tokens: [400]u32 = undefined;
+    for ([_]u32{ 100, 200, 300 }, 0..) |at, k| {
+        for (&tokens, 0..) |*t, i| t.* = @intCast(k * 1000 + i);
+        try std.testing.expect(store.keep(tokens[0 .. at + 1], at, null, &.{}, &.{}));
+    }
+    const Ps = struct { ctx: *anyopaque, held: *const fn (*anyopaque) u64, give: *const fn (*anyopaque, ?*anyopaque, []const u32, u64) bool, limit: *const fn (*anyopaque, u64) void };
+    const F = struct {
+        pub const PoolStore = Ps;
+    };
+    const p = of(F, &store).?;
+    try std.testing.expectEqual(@as(u64, 600), p.held(p.ctx));
+    const restoring = store.entries.items[2].saved;
+    try std.testing.expect(p.give(p.ctx, restoring, &tokens, 250)); // 100 and 200 go, 300 stays
+    try std.testing.expectEqual(@as(u64, 300), p.held(p.ctx));
+    try std.testing.expect(!p.give(p.ctx, restoring, &tokens, 1)); // only the restored state is left
+    p.limit(p.ctx, 123);
+    try std.testing.expectEqual(@as(u64, 123), store.budget);
+}
