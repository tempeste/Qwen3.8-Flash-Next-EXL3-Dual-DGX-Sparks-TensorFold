+    try testing.expectError(error.InvalidRope, foldGamma(&g, 4, 1.1));
+}
+
+fn ropeObject(gpa: std.mem.Allocator, json: []const u8) !std.json.Parsed(std.json.Value) {
+    return std.json.parseFromSlice(std.json.Value, gpa, json, .{});
+}
