+    try testing.expectError(error.InvalidYarn, fromConfig(stock.value.object, native_window, "0.5", null));
+    try testing.expectError(error.InvalidYarn, fromConfig(stock.value.object, native_window, "four", null));
+    const given = try ropeObject(gpa,
+        \\{"rope_type": "yarn", "factor": 4, "original_max_position_embeddings": 262144, "beta_fast": 16,
+        \\ "beta_slow": 2, "mscale": 1, "mscale_all_dim": 0.5, "truncate": false}
+    );
+    defer given.deinit();
+    const g = (try fromConfig(given.value.object, native_window, null, null)).?;
+    try testing.expectEqual(@as(f64, 16), g.beta_fast);
+    try testing.expectEqual(@as(f64, 2), g.beta_slow);
+    try testing.expect(!g.truncate);
+    try testing.expectApproxEqRel((0.1 * @log(4.0) + 1) / (0.05 * @log(4.0) + 1), g.attention(), 1e-15);
+}
+
+test "v1.1.4's frequencies are the default rope's bits, and the engine reads TF_FLASHNEXT_YARN" {
+    var v114: [32]f32 = undefined;
+    for (&v114, 0..) |*o, i| o.* = @floatCast(std.math.pow(f64, 10_000_000.0, -@as(f64, @floatFromInt(i)) / 32.0));
+    try expectBitsOf(v114, py_default);
+    const env = struct {
+        extern "c" fn setenv(name: [*:0]const u8, value: [*:0]const u8, overwrite: c_int) c_int;
+        extern "c" fn unsetenv(name: [*:0]const u8) c_int;
+    };
+    _ = env.unsetenv(env_factor);
+    try testing.expect((try fromEnv()) == null);
+    try testing.expectEqual(@as(usize, 262144), maxTokens());
+    _ = env.setenv(env_factor, "4", 1);
+    defer _ = env.unsetenv(env_factor);
+    try testing.expectEqual(@as(usize, 1048576), maxTokens());
+    var inv: [32]f32 = undefined;
+    engineInv(&inv);
+    var got: [32]u32 = undefined;
+    bitsOf(&inv, &got);
+    try testing.expectEqualSlices(u32, &py_yarn4, &got);
+    try testing.expectEqual(@as(f32, 1.13862943649292), engine().scale());
+    _ = env.setenv(env_factor, "off", 1);
+    try testing.expectEqual(@as(usize, 262144), maxTokens());
+    _ = env.setenv(env_factor, "x", 1);
+    try testing.expectError(error.InvalidYarn, fromEnv());
+}
+
+fn expectBitsOf(v: [32]f32, want: [32]u32) !void {
+    var got: [32]u32 = undefined;
+    bitsOf(&v, &got);
+    try testing.expectEqualSlices(u32, &want, &got);
+}
