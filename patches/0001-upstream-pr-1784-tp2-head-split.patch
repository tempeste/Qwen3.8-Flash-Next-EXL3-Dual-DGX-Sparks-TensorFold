diff --git a/zig/tests/cuda/flashnext_fp8_experts_tests.zig b/zig/tests/cuda/flashnext_fp8_experts_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8ec27578b41c4dc133749ca0952a675d07792099
--- /dev/null
+++ b/zig/tests/cuda/flashnext_fp8_experts_tests.zig
@@ -0,0 +1,217 @@
+//! Flash Next's block-FP8 MTP experts at the head's shapes: loader and moe_native.fp8, decode and prompt, vs FP64.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const experts = 512; // routed FP8 experts
+const entries = experts + 1; // routing entries: the shared slot last, which the FP8 call skips
+const NI = 640; // width
+const D = 2560; // dims
+const slots = 11; // ten routed picks a row, then the shared slot
+const blk = 128;
+const most = 200;
+const projs = [_][]const u8{ "gate_proj", "up_proj", "down_proj" };
+
+/// 512 experts' E4M3 codes [expert][gate, up, down][n][k] and BF16 block scales [expert][proj][n/128][k/128].
+const Source = struct {
+    codes: []u8,
+    scales: []u16,
+
+    const per = NI * D; // codes a projection (gate / up [NI, D], down [D, NI])
+    const blocks = (NI / blk) * (D / blk);
+
+    fn init(a: std.mem.Allocator, r: std.Random) !Source {
+        const s: Source = .{ .codes = try a.alloc(u8, experts * 3 * per), .scales = try a.alloc(u16, experts * 3 * blocks) };
+        r.bytes(s.codes);
+        for (s.codes) |*c| if (c.* & 0x7f == 0x7f) {
+            c.* ^= 1; // E4M3's NaN codes: the checkpoint holds none
+        };
+        for (s.scales) |*v| v.* = rig.bf16(0.001 + r.float(f32) * 0.01);
+        return s;
+    }
+
+    fn dims(p: usize) [2]usize {
+        return if (p == 2) .{ D, NI } else .{ NI, D };
+    }
+
+    /// The f64 value of projection `p` of expert `e` at (row, col).
+    fn value(s: *const Source, lut: *const [256]f64, e: usize, p: usize, row: usize, col: usize) f64 {
+        const nk = dims(p);
+        return lut[s.codes[(e * 3 + p) * per + row * nk[1] + col]] * rig.bf(s.scales[(e * 3 + p) * blocks + (row / blk) * (nk[1] / blk) + col / blk]);
+    }
+
+    pub fn has(_: *Source, name: []const u8) bool {
+        return std.mem.indexOf(u8, name, ".experts.") != null;
+    }
+
+    pub fn get(s: *Source, name: []const u8) !core.safetensors.Tensor {
+        const marker = std.mem.indexOf(u8, name, ".experts.") orelse return error.MissingTensor;
+        const tail = name[marker + ".experts.".len ..];
+        const dot = std.mem.indexOfScalar(u8, tail, '.') orelse return error.MissingTensor;
+        const e = try std.fmt.parseInt(usize, tail[0..dot], 10);
+        if (e >= experts) return error.MissingTensor;
+        for (projs, 0..) |proj, p| {
+            const rest = tail[dot + 1 ..];
+            if (!std.mem.startsWith(u8, rest, proj)) continue;
+            const nk = dims(p);
+            if (std.mem.eql(u8, rest[proj.len..], ".weight")) return tensor(.f8_e4m3, nk, s.codes[(e * 3 + p) * per ..][0..per]);
+            if (std.mem.eql(u8, rest[proj.len..], ".weight_scale_inv")) return tensor(.bf16, .{ nk[0] / blk, nk[1] / blk }, std.mem.sliceAsBytes(s.scales[(e * 3 + p) * blocks ..][0..blocks]));
+        }
+        return error.MissingTensor;
+    }
+
+    pub fn release(_: *Source) void {}
+};
+
+fn tensor(dtype: core.safetensors.DType, shape: [2]usize, bytes: []const u8) core.safetensors.Tensor {
+    var t: core.safetensors.Tensor = .{ .dtype = dtype, .rank = 2, .shape = @splat(1), .bytes = bytes };
+    t.shape[0] = shape[0];
+    t.shape[1] = shape[1];
+    return t;
+}
+
+/// SwiGLU as the kernels round it: gate and up to bf16, silu to bf16, the product (no clamp).
+fn swiglu(g: f64, u: f64) f64 {
+    const gv = rig.rbf(g);
+    const uv = rig.rbf(u);
+    return rig.rbf(gv / (1 + @exp(-gv))) * uv;
+}
+
+/// One thread's pairs vs FP64: gate-up from x, down from the kernel's bf16 activations (quant_ref_experts' bounds).
+const Ref = struct {
+    s: *const Source,
+    lut: *const [256]f64,
+    x: []const u16,
+    picks: []const i32,
+    act: []const u16,
+    y: []const f32,
+    lo: usize,
+    hi: usize,
+    worst: [2]f64 = .{ 0, 0 },
+    bad: [2]usize = .{ 0, 0 },
+
+    fn note(f: *Ref, which: usize, got: f64, want: f64, tol: f64) void {
+        const q = @abs(got - want) / tol;
+        if (!(q <= 1)) f.bad[which] += 1;
+        if (q > f.worst[which] or std.math.isNan(q)) f.worst[which] = if (std.math.isNan(q)) std.math.inf(f64) else q;
+    }
+
+    fn run(f: *Ref) void {
+        for (f.lo..f.hi) |p| {
+            const e: usize = @intCast(f.picks[p]);
+            if (e == experts) continue;
+            const xr = f.x[(p / slots) * D ..][0..D];
+            for (0..NI) |j| {
+                var gs: f64 = 0;
+                var us: f64 = 0;
+                var abs: f64 = 0;
+                for (0..D) |i| {
+                    const xv = rig.bf(xr[i]);
+                    const g = xv * f.s.value(f.lut, e, 0, j, i);
+                    const u = xv * f.s.value(f.lut, e, 1, j, i);
+                    gs += g;
+                    us += u;
+                    abs += @abs(g) + @abs(u);
+                }
+                const a = swiglu(gs, us);
+                // a bf16 step either side of each of the three roundings, and fp32 sums
+                f.note(0, rig.bf(f.act[p * NI + j]), a, @abs(a) * std.math.pow(f64, 2, -6) + abs * std.math.pow(f64, 2, -12) + 1e-30);
+            }
+            for (0..D) |j| {
+                var sum: f64 = 0;
+                var abs: f64 = 0;
+                for (0..NI) |i| {
+                    const t = rig.bf(f.act[p * NI + i]) * f.s.value(f.lut, e, 2, j, i);
+                    sum += t;
+                    abs += @abs(t);
+                }
+                f.note(1, f.y[p * D + j], sum, abs * std.math.pow(f64, 2, -12) + 1e-30);
+            }
+        }
+    }
+};
+
+/// Every row's ten distinct routed experts, then the shared slot.
+fn picksOf(a: std.mem.Allocator, r: std.Random, rows: usize) ![]i32 {
+    const out = try a.alloc(i32, rows * slots);
+    for (0..rows) |row| {
+        for (0..slots - 1) |j| {
+            var e: i32 = @intCast(r.uintLessThan(usize, experts));
+            while (std.mem.indexOfScalar(i32, out[row * slots ..][0..j], e) != null) e = @intCast(r.uintLessThan(usize, experts));
+            out[row * slots + j] = e;
+        }
+        out[row * slots + slots - 1] = experts;
+    }
+    return out;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    // decode rows take tile 16 and prompt rows tile 64 at the default fact rows (64)
+    if (std.c.getenv("TF_FLASHNEXT_FACT_ROWS") != null) return check.expect(false, "flashnext-fp8-experts runs with TF_FLASHNEXT_FACT_ROWS unset", .{});
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rng = std.Random.DefaultPrng.init(0xf8e4);
+    var r = try rig.Rig.init(gpu, a, rng.random());
+    defer r.deinit();
+    var source = try Source.init(a, rng.random());
+    var lut: [256]f64 = undefined;
+    for (&lut, 0..) |*v, c| v.* = core.quant.fp8.e4m3(@intCast(c));
+    // the production loader (block-FP8 branch) and dispatch: the batch pass's kernels, the layer's view
+    var owned = try flash.modelopt_experts.loadShape(gpu.gpa, gpu.d, &source, "language_model.mtp.layers.0.mlp", 1, 0, D, NI, experts);
+    defer owned.free();
+    const layer = owned.view();
+    try check.expect(layer.format == .fp8g and layer.width == NI and layer.dims == D and layer.experts == experts, "the head's experts load as block FP8, {d} x {d}, {d} experts", .{ NI, D, experts });
+    var k = try flash.batch_state.Kernels.load(gpu.d);
+    defer k.deinit();
+    const x = r.bfs(most * D, 1.0);
+    const dx = try r.dev(std.mem.sliceAsBytes(x));
+    var worst: [2]f64 = .{ 0, 0 };
+    var checked: usize = 0;
+    for ([_]usize{ 1, 3, 16, 64, most }) |rows| {
+        const pairs = rows * slots;
+        const picks = try picksOf(a, r.rng, rows);
+        const plan: cuda.grouped.Plan = .{
+            .members = try r.out(pairs * 4),
+            .items = try r.out(((pairs + 15) / 16 + entries) * 12),
+            .counts = try r.out(8),
+            .rank = try r.out(pairs * 4),
+            .hist = try r.out(((pairs + cuda.grouped.small - 1) / cuda.grouped.small) * entries * 4),
+        };
+        // every byte 0xff: a pair the call writes changes, the shared slot's must not
+        const act = try r.out(pairs * NI * 2);
+        const y = try r.out(pairs * D * 4);
+        try flash.moe_native.fp8(&k, r.s, try r.dev(std.mem.sliceAsBytes(picks)), dx, layer, plan, pairs, rows, y, act);
+        const got_act = try r.back(u16, act, pairs * NI);
+        const got_y = try r.back(f32, y, pairs * D);
+        for (picks, 0..) |e, p| if (e == experts) {
+            for (got_act[p * NI ..][0..NI]) |v| try check.expect(v == 0xffff, "{d} rows: the shared slot's activations untouched", .{rows});
+            for (std.mem.sliceAsBytes(got_y[p * D ..][0..D])) |v| try check.expect(v == 0xff, "{d} rows: the shared slot's down rows untouched", .{rows});
+        };
+        const threads = @min(32, @max(1, std.Thread.getCpuCount() catch 1));
+        var refs: [32]Ref = undefined;
+        var handles: [32]?std.Thread = @splat(null);
+        const share = (pairs + threads - 1) / threads;
+        for (0..threads) |t| {
+            refs[t] = .{ .s = &source, .lut = &lut, .x = x, .picks = picks, .act = got_act, .y = got_y, .lo = @min(pairs, t * share), .hi = @min(pairs, (t + 1) * share) };
+            handles[t] = std.Thread.spawn(.{}, Ref.run, .{&refs[t]}) catch blk: {
+                refs[t].run();
+                break :blk null;
+            };
+        }
+        for (handles[0..threads]) |h| if (h) |th| th.join();
+        var bad: [2]usize = .{ 0, 0 };
+        for (refs[0..threads]) |f| for (0..2) |i| {
+            bad[i] += f.bad[i];
+            worst[i] = @max(worst[i], f.worst[i]);
+        };
+        const path = if (rows >= 64) "prompt (tile 64)" else "decode (tile 16)";
+        try check.expect(bad[0] == 0, "fp8 head experts {s}, {d} rows: gate-up within FP64 tolerance ({d} outside, worst {d:.3})", .{ path, rows, bad[0], worst[0] });
+        try check.expect(bad[1] == 0, "fp8 head experts {s}, {d} rows: fp32 down within FP64 tolerance ({d} outside, worst {d:.3})", .{ path, rows, bad[1], worst[1] });
+        checked += rows * (slots - 1);
+    }
+    check.pass("flashnext-fp8-experts: 512 block-FP8 experts at {d} x {d} through moe_native.fp8, decode rows 1/3/16 and prompt rows 64/200; {d} routed pairs within FP64 (worst gate-up {d:.3}, down {d:.3} tolerances), the shared slot untouched", .{ NI, D, checked, worst[0], worst[1] });
+}
diff --git a/zig/tests/cuda/flashnext_gdn_heads.zig b/zig/tests/cuda/flashnext_gdn_heads.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0d08e9e9cf455d18255e8d8e9d0f80717c7b7fe7
--- /dev/null
+++ b/zig/tests/cuda/flashnext_gdn_heads.zig
@@ -0,0 +1,272 @@
+//! One rank's DeltaNet heads inside the full layout: the ranges each buffer keeps, their gather, the kernels' launches.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+
+pub const Heads = flash.Heads;
+const parts = flash.batch_state;
+const full = Heads.full;
+
+pub const dk = 128;
+pub const dv = 128;
+pub const taps = 4;
+pub const eps: f32 = 1e-6;
+
+/// A DeltaNet block buffer, by what one of its rows holds.
+pub const Part = enum {
+    /// A projection row: q, k and v channels, then z, b and a.
+    proj,
+    /// A conv window row: the q, k and v channels.
+    conv,
+    /// The conv taps, channel-major: one row of channels x taps.
+    taps,
+    /// a_log or dt_bias: one value a value head.
+    gates,
+    /// Normed q or k: dk values a key head.
+    keys,
+    /// v, the readouts or the gated-norm rows: dv values a value head.
+    values,
+    /// Decay and beta: two values a value head.
+    gb,
+    /// The recurrent state, one row: dv x dk values a value head.
+    state,
+    /// The gated norm's 32-wide sums: dv / 32 values a value head.
+    sums,
+};
+
+/// Elements of one row of `part` for the heads h.
+pub fn width(part: Part, h: Heads) usize {
+    return switch (part) {
+        .proj => h.projWidth(),
+        .conv => h.convDim(),
+        .taps => h.convDim() * taps,
+        .gates => h.nv,
+        .keys => h.nk * dk,
+        .values => h.nv * dv,
+        .gb => h.nv * 2,
+        .state => h.nv * dv * dk,
+        .sums => h.nv * dv / 32,
+    };
+}
+
+/// Rows of `part` in a pass over m token rows: the conv window's taps - 1, one for the taps, gates and state.
+pub fn rowsIn(part: Part, m: usize) usize {
+    return switch (part) {
+        .conv => taps - 1,
+        .taps, .gates, .state => 1,
+        else => m,
+    };
+}
+
+/// Bytes of a whole buffer of `part` (elements `elem` bytes each) over m token rows, for the heads h.
+pub fn bytes(part: Part, elem: usize, m: usize, h: Heads) usize {
+    return rowsIn(part, m) * width(part, h) * elem;
+}
+
+pub const Cut = struct { from: usize, len: usize };
+
+pub const Cuts = struct {
+    buf: [6]Cut = undefined,
+    len: usize = 0,
+
+    fn add(c: *Cuts, from: usize, len: usize) void {
+        c.buf[c.len] = .{ .from = from, .len = len };
+        c.len += 1;
+    }
+
+    pub fn slice(c: *const Cuts) []const Cut {
+        return c.buf[0..c.len];
+    }
+};
+
+/// Rank r's ranges of a full-layout row of `part`, in the order its local row (heads h) holds them.
+pub fn cuts(part: Part, h: Heads, r: usize) Cuts {
+    var c: Cuts = .{};
+    switch (part) {
+        .proj, .conv, .taps => {
+            const t: usize = if (part == .taps) taps else 1;
+            const qk = h.nk * dk;
+            const vw = h.nv * dv;
+            c.add(r * qk * t, qk * t);
+            c.add((full.nk * dk + r * qk) * t, qk * t);
+            c.add((2 * full.nk * dk + r * vw) * t, vw * t);
+            if (part == .proj) {
+                const z = full.convDim();
+                c.add(z + r * vw, vw);
+                c.add(z + full.nv * dv + r * h.nv, h.nv);
+                c.add(z + full.nv * dv + full.nv + r * h.nv, h.nv);
+            }
+        },
+        else => {
+            const w = width(part, h);
+            c.add(r * w, w);
+        },
+    }
+    return c;
+}
+
+/// The full-layout row index of element i of rank r's local row of `part`.
+pub fn fullIndex(part: Part, h: Heads, r: usize, i: usize) usize {
+    var left = i;
+    const cs = cuts(part, h, r);
+    for (cs.slice()) |c| {
+        if (left < c.len) return c.from + left;
+        left -= c.len;
+    }
+    unreachable;
+}
+
+/// Rank r's elements (`elem` bytes each) of a full-layout buffer of `part`, in the local layout of heads h.
+pub fn gather(a: std.mem.Allocator, src: []const u8, elem: usize, part: Part, h: Heads, r: usize) ![]u8 {
+    const fw = width(part, full) * elem;
+    const lw = width(part, h) * elem;
+    if (src.len % fw != 0) return error.LayoutLength;
+    const n = src.len / fw;
+    const out = try a.alloc(u8, n * lw);
+    const cs = cuts(part, h, r);
+    for (0..n) |row| {
+        var at = row * lw;
+        for (cs.slice()) |c| {
+            @memcpy(out[at..][0 .. c.len * elem], src[row * fw + c.from * elem ..][0 .. c.len * elem]);
+            at += c.len * elem;
+        }
+    }
+    return out;
+}
+
+pub const Kind = enum { front, norm, rows, rows_to, tpr, fused };
+
+/// The kernel of `kind`: the full layer's, or (half) its twin on one rank's 8 key and 24 value heads.
+pub fn symbol(kind: Kind, half: bool) [:0]const u8 {
+    return switch (kind) {
+        .front => if (half) "fn_gdn_front_h8" else "fn_gdn_front",
+        .norm => if (half) "fn_gdn_norm_h8" else "fn_gdn_norm",
+        .rows => if (half) "fn_gdn_rows_h8" else "fn_gdn_rows",
+        .rows_to => if (half) "fn_gdn_rows_to_h8" else "fn_gdn_rows_to",
+        .tpr => if (half) "fn_gdn_chain_tpr_h8" else "fn_gdn_chain_tpr",
+        .fused => if (half) "fn_gdn_fused_h8" else "fn_gdn_fused",
+    };
+}
+
+/// A full kernel and its twin, by kind, from the flashnext_batch image (dynamic shared bytes allowed).
+pub const Fns = struct {
+    full: [6]cuda.Function,
+    half: [6]cuda.Function,
+
+    pub fn load(batch: cuda.Module) !Fns {
+        var f: Fns = undefined;
+        for (std.enums.values(Kind)) |k| {
+            const i = @backingInt(k);
+            f.full[i] = try batch.function(symbol(k, false));
+            f.half[i] = try batch.function(symbol(k, true));
+            const smem: u32 = switch (k) {
+                .tpr => parts.chain_tpr_smem,
+                .fused => parts.gdn_fused_smem,
+                else => continue,
+            };
+            try f.full[i].allowDynamicShared(smem);
+            try f.half[i].allowDynamicShared(smem);
+        }
+        return f;
+    }
+
+    /// Replace only the full-head oracle; candidate half handles stay initialized and owned by their original module.
+    pub fn withFull(f: Fns, batch: cuda.Module) !Fns {
+        var out = f;
+        for (std.enums.values(Kind)) |k| {
+            const i = @backingInt(k);
+            out.full[i] = try batch.function(symbol(k, false));
+            const smem: u32 = switch (k) {
+                .tpr => parts.chain_tpr_smem,
+                .fused => parts.gdn_fused_smem,
+                else => continue,
+            };
+            try out.full[i].allowDynamicShared(smem);
+        }
+        return out;
+    }
+
+    /// The kernel of `kind` built for heads h.
+    pub fn of(f: *const Fns, kind: Kind, h: Heads) cuda.Function {
+        return if (h.eql(.full)) f.full[@backingInt(kind)] else f.half[@backingInt(kind)];
+    }
+};
+
+test "a frozen full-head oracle replaces no candidate half handle" {
+    const Fake = struct {
+        var shared: usize = 0;
+        fn get(out: *cuda.abi.Function, _: cuda.abi.Module, name: [*:0]const u8) callconv(.c) c_int {
+            for (std.enums.values(Kind)) |k| if (std.mem.eql(u8, std.mem.span(name), symbol(k, false))) {
+                out.* = @ptrFromInt(0x300 + @as(usize, @backingInt(k)));
+                return 0;
+            };
+            return 1;
+        }
+        fn attribute(_: cuda.abi.Function, _: cuda.abi.FunctionAttribute, _: c_int) callconv(.c) c_int {
+            shared += 1;
+            return 0;
+        }
+    };
+    var driver: cuda.Driver = undefined;
+    driver.api.cuModuleGetFunction = Fake.get;
+    driver.api.cuFuncSetAttribute = Fake.attribute;
+    var candidate: Fns = undefined;
+    for (&candidate.full, &candidate.half, 0..) |*f, *h, i| {
+        f.* = .{ .d = &driver, .handle = @ptrFromInt(0x100 + i) };
+        h.* = .{ .d = &driver, .handle = @ptrFromInt(0x200 + i) };
+    }
+    Fake.shared = 0;
+    const oracle = try candidate.withFull(.{ .d = &driver, .handle = @ptrFromInt(0x10) });
+    for (candidate.full, candidate.half, oracle.full, oracle.half, 0..) |f, h, of, oh, i| {
+        try std.testing.expectEqual(@as(usize, 0x100 + i), @intFromPtr(f.handle));
+        try std.testing.expectEqual(@as(usize, 0x300 + i), @intFromPtr(of.handle));
+        try std.testing.expectEqual(h.handle, oh.handle);
+    }
+    try std.testing.expectEqual(@as(usize, 2), Fake.shared);
+}
+
+fn cint(n: usize) c_int {
+    return @intCast(n);
+}
+
+/// fn_gdn_front: projection rows p after the conv window cs into normed q and k, v, decay and beta.
+pub fn front(f: cuda.Function, s: cuda.Stream, h: Heads, rows: usize, p: u64, cs: u64, cw: u64, a_log: u64, dt: u64, qn: u64, kn: u64, v: u64, gb: u64) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ p, cs, cw, a_log, dt, qn, kn, v, gb }) |x| a.add(x);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows), .y = h.nk + h.nv }, .block = .{ .x = 256 } }, s, &a);
+}
+
+/// The chain over `rows` rows: in place (rows, st_out unused), to st_out (rows_to), or two threads a state row (tpr).
+pub fn chain(f: cuda.Function, s: cuda.Stream, kind: Kind, h: Heads, rows: usize, qn: u64, kn: u64, v: u64, gb: u64, st_in: u64, st_out: u64, ys: u64) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ qn, kn, v, gb, st_in }) |x| a.add(x);
+    if (kind != .rows) a.add(st_out);
+    a.add(cint(rows));
+    a.add(ys);
+    const cfg: cuda.launch.Config = switch (kind) {
+        .tpr => .{ .grid = .{ .x = h.nv }, .block = .{ .x = 256 }, .shared = parts.chain_tpr_smem },
+        .rows, .rows_to => .{ .grid = .{ .x = h.nv, .y = dv / 16 }, .block = .{ .x = 128 } },
+        else => return error.NotAChain,
+    };
+    try cuda.launch.launch(f, cfg, s, &a);
+}
+
+/// fn_gdn_norm: the readouts ys gated by z of the projection rows p, into out (bf16) and its sums xs.
+pub fn norm(f: cuda.Function, s: cuda.Stream, h: Heads, rows: usize, ys: u64, p: u64, nw: u64, out: u64, xs: u64) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ ys, p, nw }) |x| a.add(x);
+    a.add(eps);
+    for ([_]u64{ out, xs }) |x| a.add(x);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows), .y = h.nv }, .block = .{ .x = dv } }, s, &a);
+}
+
+/// fn_gdn_fused: front, chain and gated norm in one launch a value head; ys 0 keeps no fp32 readouts.
+pub fn fused(f: cuda.Function, s: cuda.Stream, h: Heads, rows: usize, p: u64, cs: u64, cw: u64, a_log: u64, dt: u64, st_in: u64, st_out: u64, nw: u64, out: u64, xs: u64, ys: u64) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ p, cs, cw, a_log, dt, st_in, st_out }) |x| a.add(x);
+    a.add(cint(rows));
+    a.add(nw);
+    a.add(eps);
+    for ([_]u64{ out, xs, ys }) |x| a.add(x);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = h.nv }, .block = .{ .x = parts.gdn_fused_threads }, .shared = parts.gdn_fused_smem }, s, &a);
+}
diff --git a/zig/tests/cuda/flashnext_gdn_heads_tests.zig b/zig/tests/cuda/flashnext_gdn_heads_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d84d4c53ad470e66c17183786988fc0c8fd4ece5
--- /dev/null
+++ b/zig/tests/cuda/flashnext_gdn_heads_tests.zig
@@ -0,0 +1,187 @@
+//! tf-cuda-test flashnext-gdn-heads: each DeltaNet twin on a rank's heads gives the full kernel's bytes for them.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const rig_ = @import("flashnext_rig.zig");
+const lay = @import("flashnext_gdn_heads.zig");
+
+const Rig = rig_.Rig;
+const Heads = lay.Heads;
+const Part = lay.Part;
+
+/// Token rows: one, a few, a stage of 16, the TPR seam's either side, and the default chunk.
+const counts = [_]usize{ 1, 4, 16, 63, 64, 1536 };
+
+/// A pass's inputs, host bytes in one layout: projection rows, conv window and taps, gates, norm weight, state.
+const In = struct { p: []const u8, cs: []const u8, cw: []const u8, a_log: []const u8, dt: []const u8, nw: []const u8, st: []const u8 };
+
+const Out = struct { what: []const u8, part: Part, elem: usize = 4 };
+
+/// Front's rows, then each form's readouts, state, gated-norm rows and their sums (plain, _to, TPR, fused).
+const outs = blk: {
+    var o: [4 + 4 * 4]Out = undefined;
+    o[0..4].* = .{ .{ .what = "front q", .part = .keys }, .{ .what = "front k", .part = .keys }, .{ .what = "front v", .part = .values }, .{ .what = "front decay and beta", .part = .gb } };
+    for ([_][]const u8{ "plain", "_to", "TPR", "fused" }, 0..) |form, i| {
+        o[4 + 4 * i] = .{ .what = form ++ " readouts", .part = .values };
+        o[5 + 4 * i] = .{ .what = form ++ " state", .part = .state };
+        o[6 + 4 * i] = .{ .what = form ++ " gated-norm rows", .part = .values, .elem = 2 };
+        o[7 + 4 * i] = .{ .what = form ++ " sums", .part = .sums };
+    }
+    break :blk o;
+};
+
+fn upload(r: *Rig, ptr: u64, bytes: []const u8) !void {
+    const b: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = ptr, .len = bytes.len };
+    try b.upload(0, bytes);
+}
+
+/// Every form's launches for the heads h over m rows, as the pass makes them; the outputs in `outs`' order.
+fn pass(r: *Rig, f: *const lay.Fns, h: Heads, m: usize, in: In) ![outs.len]u64 {
+    const s = r.s;
+    var o: [outs.len]u64 = undefined;
+    for (outs, &o) |x, *p| p.* = try r.out(lay.bytes(x.part, x.elem, m, h));
+    const p = try r.dev(in.p);
+    const cs = try r.dev(in.cs);
+    const cw = try r.dev(in.cw);
+    const a_log = try r.dev(in.a_log);
+    const dt = try r.dev(in.dt);
+    const nw = try r.dev(in.nw);
+    const st = try r.dev(in.st);
+    try lay.front(f.of(.front, h), s, h, m, p, cs, cw, a_log, dt, o[0], o[1], o[2], o[3]);
+    for ([_]lay.Kind{ .rows, .rows_to, .tpr }, 0..) |kind, i| {
+        const b = 4 + 4 * i;
+        if (kind == .rows) try upload(r, o[b + 1], in.st); // in place: the state starts where it lies
+        const from = if (kind == .rows) o[b + 1] else st;
+        try lay.chain(f.of(kind, h), s, kind, h, m, o[0], o[1], o[2], o[3], from, o[b + 1], o[b]);
+        try lay.norm(f.of(.norm, h), s, h, m, o[b], p, nw, o[b + 2], o[b + 3]);
+    }
+    try upload(r, o[17], in.st);
+    try lay.fused(f.of(.fused, h), s, h, m, p, cs, cw, a_log, dt, o[17], o[17], nw, o[18], o[19], o[16]);
+    try s.synchronize();
+    return o;
+}
+
+/// Rank r's inputs gathered from the full layout (the norm weight is whole on both ranks).
+fn gathered(a: std.mem.Allocator, in: In, r: usize) !In {
+    return .{
+        .p = try lay.gather(a, in.p, 2, .proj, .half, r),
+        .cs = try lay.gather(a, in.cs, 2, .conv, .half, r),
+        .cw = try lay.gather(a, in.cw, 2, .taps, .half, r),
+        .a_log = try lay.gather(a, in.a_log, 4, .gates, .half, r),
+        .dt = try lay.gather(a, in.dt, 4, .gates, .half, r),
+        .nw = in.nw,
+        .st = try lay.gather(a, in.st, 4, .state, .half, r),
+    };
+}
+
+/// Directed non-finites affect separate heads of both ranks; other heads retain the finite random inputs.
+fn mixed(a: std.mem.Allocator, in: In, m: usize) !In {
+    const p = try a.dupe(u8, in.p);
+    const st = try a.dupe(u8, in.st);
+    const h = Heads.half;
+    for (0..2) |rank| {
+        const q = lay.fullIndex(.proj, h, rank, 3);
+        const v = (m / 2) * Heads.full.projWidth() + lay.fullIndex(.proj, h, rank, 2 * h.nk * lay.dk + 4 * lay.dv + 7);
+        const z = (m - 1) * Heads.full.projWidth() + lay.fullIndex(.proj, h, rank, h.convDim() + 7 * lay.dv + 5);
+        std.mem.writeInt(u16, p[q * 2 ..][0..2], 0x7fc1, .little);
+        std.mem.writeInt(u16, p[v * 2 ..][0..2], 0x7f80, .little);
+        std.mem.writeInt(u16, p[z * 2 ..][0..2], 0xff80, .little);
+        const state = lay.fullIndex(.state, h, rank, 15 * lay.dv * lay.dk + 7);
+        std.mem.writeInt(u32, st[state * 4 ..][0..4], 0xff800000, .little);
+    }
+    var out = in;
+    out.p = p;
+    out.st = st;
+    return out;
+}
+
+/// Each rank must retain finite witnesses as well as observe the planted non-finites.
+fn expectMixed(bytes: []const u8, elem: usize) !void {
+    var finite: usize = 0;
+    var nonfinite: usize = 0;
+    var at: usize = 0;
+    while (at < bytes.len) : (at += elem) {
+        const bad = if (elem == 2)
+            std.mem.readInt(u16, bytes[at..][0..2], .little) & 0x7f80 == 0x7f80
+        else
+            std.mem.readInt(u32, bytes[at..][0..4], .little) & 0x7f800000 == 0x7f800000;
+        if (bad) nonfinite += 1 else finite += 1;
+    }
+    try check.expect(finite > 0 and nonfinite > 0, "mixed GDN fixture needs finite and non-finite outputs on each rank", .{});
+}
+
+fn compare(r: *Rig, f: *const lay.Fns, oracle: *const lay.Fns, m: usize, in: In, frozen: bool, bad: bool) !usize {
+    const a = r.a;
+    const want = try pass(r, oracle, .full, m, in);
+    var checks: usize = 0;
+    if (frozen) {
+        const got = try pass(r, f, .full, m, in);
+        for (outs, want, got) |x, w, mine| {
+            const len = lay.bytes(x.part, x.elem, m, .full);
+            const what = try std.fmt.allocPrint(a, "flashnext-gdn-heads frozen {s} {s}, full, {d} rows", .{ if (bad) "mixed" else "finite", x.what, m });
+            try check.sameBytes(what, try r.back(u8, mine, len), try r.back(u8, w, len));
+            checks += 1;
+        }
+    }
+    for (0..2) |rank| {
+        const got = try pass(r, f, .half, m, try gathered(a, in, rank));
+        for (outs, want, got, 0..) |x, w, mine, i| {
+            const whole = try r.back(u8, w, lay.bytes(x.part, x.elem, m, .full));
+            const theirs = try lay.gather(a, whole, x.elem, x.part, .half, rank);
+            if (bad and (i == 0 or i == 6)) try expectMixed(theirs, x.elem);
+            const what = try std.fmt.allocPrint(a, "flashnext-gdn-heads {s}{s}, rank {d}, {d} rows", .{ if (bad) "mixed " else "", x.what, rank, m });
+            try check.sameBytes(what, try r.back(u8, mine, theirs.len), theirs);
+            checks += 1;
+        }
+    }
+    return checks;
+}
+
+/// The existing embedded full-versus-half check; its finite inputs and 240 comparisons are unchanged.
+pub fn run(gpu: check.Gpu) !void {
+    return runWith(gpu, null);
+}
+
+/// Freeze the full-head oracle to a separate image while retaining the embedded candidate handles.
+pub fn runBaseline(gpu: check.Gpu, path: []const u8) !void {
+    const raw = try std.Io.Dir.cwd().readFileAlloc(gpu.io, path, gpu.gpa, .limited(64 << 20));
+    defer gpu.gpa.free(raw);
+    const image = try gpu.gpa.alignedAlloc(u8, .@"8", raw.len);
+    defer gpu.gpa.free(image);
+    @memcpy(image, raw);
+    var baseline = try cuda.Module.load(gpu.d, image);
+    defer baseline.unload();
+    try runWith(gpu, baseline);
+}
+
+fn runWith(gpu: check.Gpu, baseline: ?cuda.Module) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(61);
+    var r = try Rig.init(gpu, a, prng.random());
+    defer r.deinit();
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const f = try lay.Fns.load(batch);
+    const oracle = if (baseline) |b| try f.withFull(b) else f;
+    const full = Heads.full;
+    var checks: usize = 0;
+    for (counts) |m| {
+        const in: In = .{
+            .p = std.mem.sliceAsBytes(r.bfs(m * full.projWidth(), 1)),
+            .cs = std.mem.sliceAsBytes(r.bfs((lay.taps - 1) * full.convDim(), 1)),
+            .cw = std.mem.sliceAsBytes(r.bfs(full.convDim() * lay.taps, 0.5)),
+            .a_log = std.mem.sliceAsBytes(r.f32s(full.nv, -1, 1)),
+            .dt = std.mem.sliceAsBytes(r.f32s(full.nv, -1, 1)),
+            .nw = std.mem.sliceAsBytes(r.bfs(lay.dv, 1.5)),
+            .st = std.mem.sliceAsBytes(r.f32s(full.nv * lay.dv * lay.dk, -0.5, 0.5)),
+        };
+        checks += try compare(&r, &f, &oracle, m, in, baseline != null, false);
+        if (baseline != null) checks += try compare(&r, &f, &oracle, m, try mixed(a, in, m), true, true);
+    }
+    if (baseline != null) return check.pass("flashnext-gdn-heads frozen baseline: {d} finite and directed mixed outputs " ++
+        "of the candidate full kernels and both half-head layouts equal the external image's full kernels at 1 to 1,536 rows", .{checks});
+    check.pass("flashnext-gdn-heads: {d} outputs of the _h8 front, rows, _to, TPR, norm and fused kernels on each rank's heads " ++
+        "equal the full kernels' bytes for those heads at 1 to 1,536 rows", .{checks});
+}
