+test "the gather copies each kept element from where fullIndex says it lies" {
+    const a = std.testing.allocator;
+    const rows = 3;
+    const n = rows * lay.width(.proj, .full);
+    const src = try a.alloc(u32, n);
+    defer a.free(src);
+    for (src, 0..) |*v, i| v.* = @intCast(i);
+    for (0..2) |r| {
+        const got = try lay.gather(a, std.mem.sliceAsBytes(src), 4, .proj, .half, r);
+        defer a.free(got);
+        const vals = std.mem.bytesAsSlice(u32, got);
+        const lw = lay.width(.proj, .half);
+        try std.testing.expectEqual(rows * lw, vals.len);
+        for (0..rows) |row| for (0..lw) |i| {
+            try std.testing.expectEqual(row * lay.width(.proj, .full) + lay.fullIndex(.proj, .half, r, i), vals[row * lw + i]);
+        };
+    }
+    const same = try lay.gather(a, std.mem.sliceAsBytes(src), 4, .proj, .full, 0);
+    defer a.free(same);
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(src), same);
+}
+
+test "each DeltaNet twin is a candidate on both ranks, replacing its full original, at the served rows and seams" {
+    for (std.enums.values(heads.Kind)) |kind| for (0..2) |r| {
+        const s = heads.spec(kind, r);
+        try std.testing.expect(std.mem.indexOf(u8, s.name, lay.symbol(kind, true)) != null);
+        try std.testing.expect(std.mem.startsWith(u8, s.replaces.?, lay.symbol(kind, false)));
+        try std.testing.expectEqual(kind == .rows or kind == .fused, s.in_place);
+        var served: [3]bool = @splat(false);
+        for (s.served) |x| for ([_]usize{ 64, parts.default_chunk, parts.max_chunk }, 0..) |want, i| {
+            if (x.rows == want and x.n == lay.Heads.half.valueDim()) served[i] = true;
+        };
+        for (served) |yes| try std.testing.expect(yes);
+        const list = try c.shapes(std.testing.allocator, s);
+        defer std.testing.allocator.free(list);
+        var seams: [4]bool = @splat(false);
+        for (list) |x| for ([_]usize{ 1, 15, 16, 17 }, 0..) |want, i| {
+            if (x.rows == want) seams[i] = true;
+        };
+        for (seams) |yes| try std.testing.expect(yes);
+    };
+    try std.testing.expect(!std.mem.eql(u8, heads.spec(.front, 0).name, heads.spec(.front, 1).name));
+}
diff --git a/zig/tests/cuda/contract_flashnext_groups.zig b/zig/tests/cuda/contract_flashnext_groups.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8b8dbe34dcedb103cc76c27f82fdd1d2a1a14334
--- /dev/null
+++ b/zig/tests/cuda/contract_flashnext_groups.zig
@@ -0,0 +1,70 @@
+//! The runner's Flash Next prompt groups as one set: the full layer's glue and the DeltaNet twins on each rank's heads.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const glue_k = @import("contract_flashnext_glue.zig");
+const heads_k = @import("contract_flashnext_heads.zig");
+const Columns = @import("contract_flashnext_columns.zig").Columns;
+const lay = @import("flashnext_gdn_heads.zig");
+
+const g = core.contract.gates;
+const parts = flash.batch_state;
+const tk = flash.tile_kernels;
+
+pub const Set = struct {
+    glue: ?flash.Glue = null,
+    fns: glue_k.Fns = undefined,
+    glues: [std.enums.values(glue_k.Kind).len]glue_k.Glue = undefined,
+    n_glues: usize = 0,
+    twins: lay.Fns = undefined,
+    ranks: [std.enums.values(heads_k.Kind).len * 2]heads_k.Rank = undefined,
+    n_ranks: usize = 0,
+    columns: [4]Columns = undefined,
+    n_columns: usize = 0,
+
+    /// Every registration onto `kernels`, from the flashnext_batch, flashnext_attn and flashnext_hcf images.
+    pub fn add(self: *Set, gpu: check.Gpu, s: cuda.Stream, batch: cuda.Module, attn: cuda.Module, hcf: cuda.Module, kernels: *std.ArrayList(g.Kernel)) !void {
+        const a = gpu.gpa;
+        self.glue = try flash.Glue.load(gpu.d);
+        self.fns = .{
+            .tpr = try batch.function("fn_gdn_chain_tpr"),
+            .rows_to = try batch.function("fn_gdn_rows_to"),
+            .tile = try attn.function("_ZN8qsa_tile6scoresILi8ELi4EEEvPK13__nv_bfloat16S3_PKiPfiiii"),
+            .scores = try attn.function("fn_qsa_scores"),
+            .hcf_down = try hcf.function(tk.cubin_hcf_down),
+            .hcf_up = try hcf.function(tk.cubin_hcf_up),
+            .front = try batch.function("fn_gdn_front"),
+            .norm = try batch.function("fn_gdn_norm"),
+            .fused = try batch.function("fn_gdn_fused"),
+        };
+        try self.fns.fused.allowDynamicShared(parts.gdn_fused_smem);
+        try self.fns.tpr.allowDynamicShared(parts.chain_tpr_smem);
+        try self.fns.hcf_down.allowDynamicShared(tk.hcf_down_smem);
+        try self.fns.hcf_up.allowDynamicShared(tk.hcf_up_smem);
+        for (std.enums.values(glue_k.Kind), &self.glues) |kind, *m| {
+            m.* = .{ .rig = .{ .gpu = gpu, .s = s }, .kind = kind, .f = &self.fns, .glue = &self.glue.? };
+            self.n_glues += 1;
+        }
+        for (&self.glues) |*m| try kernels.append(a, m.kernel());
+        self.twins = try lay.Fns.load(batch);
+        for (std.enums.values(heads_k.Kind), 0..) |kind, i| for (0..2) |rank| {
+            self.ranks[i * 2 + rank] = .{ .rig = .{ .gpu = gpu, .s = s }, .kind = kind, .rank = rank, .f = &self.twins };
+            self.n_ranks += 1;
+        };
+        for (&self.ranks) |*m| try kernels.append(a, m.kernel());
+        for (&self.columns, 0..) |*m, i| {
+            m.* = .{ .rig = .{ .gpu = gpu, .s = s }, .f = try batch.function("fn_copy_cols"), .slot = i % 2 == 1, .control = i >= 2 };
+            self.n_columns += 1;
+            try kernels.append(a, m.kernel());
+        }
+    }
+
+    pub fn deinit(self: *Set) void {
+        for (self.columns[0..self.n_columns]) |*m| m.deinit();
+        for (self.ranks[0..self.n_ranks]) |*m| m.deinit();
+        for (self.glues[0..self.n_glues]) |*m| m.deinit();
+        if (self.glue) |*x| x.deinit();
+    }
+};
diff --git a/zig/tests/cuda/contract_flashnext_heads.zig b/zig/tests/cuda/contract_flashnext_heads.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b4dcd0a889f702e1b45fd284d07b4936cd84def2
--- /dev/null
+++ b/zig/tests/cuda/contract_flashnext_heads.zig
@@ -0,0 +1,282 @@
+//! Flash Next's DeltaNet twins on one rank's heads: each kernel's bytes equal its full original's on those heads.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const flash = @import("flashnext");
+const rig_ = @import("contract_rig.zig");
+const lay = @import("flashnext_gdn_heads.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const parts = flash.batch_state;
+const Heads = lay.Heads;
+const Part = lay.Part;
+pub const Kind = lay.Kind;
+const dk = lay.dk;
+const dv = lay.dv;
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+/// The prompt pass's rows on one rank's heads (n: its value heads x dv): the fused seam, the default and the most.
+const half_served = [_]c.Shape{
+    .{ .rows = 64, .n = Heads.half.nv * dv, .k = dk },
+    .{ .rows = parts.default_chunk, .n = Heads.half.nv * dv, .k = dk },
+    .{ .rows = parts.max_chunk, .n = Heads.half.nv * dv, .k = dk },
+};
+
+const ranks = 2;
+
+const names = blk: {
+    var n: [std.enums.values(Kind).len][ranks][]const u8 = undefined;
+    for (std.enums.values(Kind)) |k| for (0..ranks) |r| {
+        n[@backingInt(k)][r] = std.fmt.comptimePrint("cuda flashnext DeltaNet {s} on rank {d}'s 8 key and 24 value heads", .{ lay.symbol(k, true), r });
+    };
+    break :blk n;
+};
+
+const originals = blk: {
+    var n: [std.enums.values(Kind).len][]const u8 = undefined;
+    for (std.enums.values(Kind)) |k| n[@backingInt(k)] = std.fmt.comptimePrint("{s} on the same heads of the full layout", .{lay.symbol(k, false)});
+    break :blk n;
+};
+
+/// rows = token rows; n = the candidate's value heads x dv; k = dk.
+pub fn spec(kind: Kind, rank: usize) c.Spec {
+    return .{ .name = names[@backingInt(kind)][rank], .accum = .none, .depth = noSums, .out = .raw, .nan = .{ .stated = "every output byte, the state's included, equal to the full kernel's on these heads, non-finite inputs included" }, .replaces = originals[@backingInt(kind)], .tiles = .{ .{ .size = 16 }, .{}, .{} }, .in_place = kind == .rows or kind == .fused, .served = &half_served };
+}
+
+/// A buffer the kernel reads: what its rows hold (null: not cut, the norm weight), its element bytes and its values.
+const In = struct { part: ?Part, elem: usize = 4, lo: f32, hi: f32, decay: bool = false };
+/// A buffer the kernel writes: what its rows hold, its element bytes, and whether it is the state read in place.
+const Out = struct { part: Part, elem: usize = 4, state: bool = false };
+
+const proj: In = .{ .part = .proj, .elem = 2, .lo = -1, .hi = 1 };
+const conv: In = .{ .part = .conv, .elem = 2, .lo = -1, .hi = 1 };
+const cw: In = .{ .part = .taps, .elem = 2, .lo = -0.5, .hi = 0.5 };
+const gates: In = .{ .part = .gates, .lo = -1, .hi = 1 };
+const norm_w: In = .{ .part = null, .elem = 2, .lo = 0.5, .hi = 1.5 };
+const keys: In = .{ .part = .keys, .lo = -0.1, .hi = 0.1 };
+const chain_in = [_]In{ keys, keys, .{ .part = .values, .lo = -1, .hi = 1 }, .{ .part = .gb, .lo = 0, .hi = 1, .decay = true } };
+const state: In = .{ .part = .state, .lo = -0.5, .hi = 0.5 };
+
+fn inputs(kind: Kind) []const In {
+    return switch (kind) {
+        .front => &.{ proj, conv, cw, gates, gates },
+        .norm => &.{ .{ .part = .values, .lo = -1, .hi = 1 }, proj, norm_w },
+        .rows => &chain_in,
+        .rows_to, .tpr => &(chain_in ++ [_]In{state}),
+        .fused => &.{ proj, conv, cw, gates, gates, norm_w },
+    };
+}
+
+fn outputs(kind: Kind) []const Out {
+    return switch (kind) {
+        .front => &.{ .{ .part = .keys }, .{ .part = .keys }, .{ .part = .values }, .{ .part = .gb } },
+        .norm => &.{ .{ .part = .values, .elem = 2 }, .{ .part = .sums } },
+        .rows => &.{ .{ .part = .values }, .{ .part = .state, .state = true } },
+        .rows_to, .tpr => &.{ .{ .part = .values }, .{ .part = .state } },
+        .fused => &.{ .{ .part = .values, .elem = 2 }, .{ .part = .sums }, .{ .part = .state, .state = true }, .{ .part = .values } },
+    };
+}
+
+/// Bytes of a buffer in the layout of heads h: the norm weight (no part) is dv values whatever the heads.
+fn bytesOf(part: ?Part, elem: usize, m: usize, h: Heads) usize {
+    const p = part orelse return dv * elem;
+    return lay.bytes(p, elem, m, h);
+}
+
+fn put(host: []u8, in: In, at: usize, v: f32) void {
+    if (in.elem == 2) std.mem.bytesAsSlice(u16, host)[at] = c.toBf16(v) else std.mem.bytesAsSlice(f32, host)[at] = v;
+}
+
+pub const Rank = struct {
+    rig: rig_.Rig,
+    kind: Kind,
+    /// The candidate's heads: one rank's (its twins), cut from the full layout.
+    heads: Heads = .half,
+    rank: usize,
+    f: *const lay.Fns,
+    rows: usize = 0,
+    /// The full-layout inputs and, by the same slot, the candidate's: rank r's heads gathered from them.
+    wide: [6]u64 = @splat(0),
+    ins: [6]u64 = @splat(0),
+    outs: [4]u64 = @splat(0),
+    nout: usize = 0,
+    /// The full outputs the original writes, back to back, poisoned before each baseline.
+    base: u64 = 0,
+    /// The candidate's state read and written in place (0: none), and the starting bytes of it and of its full twin.
+    state: u64 = 0,
+    fresh: ?[]u8 = null,
+    wide_fresh: ?[]u8 = null,
+    want: std.ArrayList(u8) = .empty,
+    seen: std.ArrayList(u8) = .empty,
+    msg: [160]u8 = undefined,
+
+    pub fn deinit(self: *Rank) void {
+        self.drop();
+        self.want.deinit(self.rig.gpu.gpa);
+        self.seen.deinit(self.rig.gpu.gpa);
+        self.rig.deinit();
+    }
+
+    fn drop(self: *Rank) void {
+        if (self.fresh) |f| self.rig.gpu.gpa.free(f);
+        if (self.wide_fresh) |f| self.rig.gpu.gpa.free(f);
+        self.fresh = null;
+        self.wide_fresh = null;
+    }
+
+    pub fn kernel(self: *Rank) g.Kernel {
+        return .{ .spec = spec(self.kind, self.rank), .ctx = self, .vt = &vt };
+    }
+
+    const vt = g.hooks(Rank);
+
+    /// Full-layout values of a buffer, with gate 1's plants at known places of rank r's heads.
+    fn values(self: *Rank, in: In, r: std.Random, bad: bool) ![]u8 {
+        const m = self.rows;
+        const host = try self.rig.gpu.gpa.alloc(u8, bytesOf(in.part, in.elem, m, .full));
+        const n = host.len / in.elem;
+        for (0..n) |i| {
+            var v = in.lo + r.float(f32) * (in.hi - in.lo);
+            if (in.decay and i % 2 == 0) v = -v; // as the full fixture: a log decay, then beta in (0, 1)
+            put(host, in, i, v);
+        }
+        const part = in.part orelse return host;
+        if (!bad) return host;
+        const h = self.heads;
+        switch (part) {
+            .proj => {
+                self.plant(host, in, 0, 3, std.math.nan(f32)); // q of the rank's first key head
+                self.plant(host, in, m / 2, 2 * h.nk * dk + 7, std.math.inf(f32)); // v
+                self.plant(host, in, m - 1, h.convDim() + 5, -std.math.inf(f32)); // z
+            },
+            .keys => self.plant(host, in, 0, 3, std.math.nan(f32)),
+            .values => self.plant(host, in, m / 2, 5, std.math.inf(f32)),
+            .state => self.plant(host, in, 0, dv * dk + 7, -std.math.inf(f32)),
+            else => {},
+        }
+        return host;
+    }
+
+    /// Element i of row `row` of the rank's local layout, placed in the full-layout buffer.
+    fn plant(self: *Rank, host: []u8, in: In, row: usize, i: usize, v: f32) void {
+        const part = in.part.?;
+        put(host, in, row * lay.width(part, .full) + lay.fullIndex(part, self.heads, self.rank, i), v);
+    }
+
+    fn local(self: *Rank, host: []const u8, part: ?Part, elem: usize) ![]u8 {
+        const a = self.rig.gpu.gpa;
+        const p = part orelse return a.dupe(u8, host);
+        return lay.gather(a, host, elem, p, self.heads, self.rank);
+    }
+
+    pub fn prepare(self: *Rank, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        self.rig.reset();
+        self.drop();
+        self.state = 0;
+        self.nout = 0;
+        self.rows = shape.rows;
+        if (shape.rows == 0 or shape.n != self.heads.valueDim() or shape.k != dk) return false;
+        var prng = std.Random.DefaultPrng.init(seed ^ 0x6865616473);
+        const r = prng.random();
+        const a = self.rig.gpu.gpa;
+        const bad = fill == .nonfinite;
+        for (inputs(self.kind), 0..) |in, i| {
+            const host = try self.values(in, r, bad);
+            defer a.free(host);
+            self.wide[i] = try self.rig.input(host);
+            const mine = try self.local(host, in.part, in.elem);
+            defer a.free(mine);
+            self.ins[i] = try self.rig.input(mine);
+        }
+        var total: usize = 0;
+        for (outputs(self.kind), 0..) |o, i| {
+            self.outs[i] = try self.rig.output(bytesOf(o.part, o.elem, self.rows, self.heads));
+            self.nout += 1;
+            total += bytesOf(o.part, o.elem, self.rows, .full);
+            if (!o.state) continue;
+            // the state read and written where it lies: every launch of either kernel starts from these bytes
+            self.state = self.outs[i];
+            self.wide_fresh = try self.values(state, r, bad);
+            self.fresh = try self.local(self.wide_fresh.?, .state, 4);
+        }
+        self.base = try self.rig.scratch(total);
+        return true;
+    }
+
+    /// The kernel of this kind built for heads h, on inputs `in` into outputs `o`, as the pass binds it.
+    fn launch(self: *Rank, h: Heads, in: []const u64, o: []const u64) !void {
+        const f = self.f.of(self.kind, h);
+        const s = self.rig.s;
+        const m = self.rows;
+        switch (self.kind) {
+            .front => try lay.front(f, s, h, m, in[0], in[1], in[2], in[3], in[4], o[0], o[1], o[2], o[3]),
+            .norm => try lay.norm(f, s, h, m, in[0], in[1], in[2], o[0], o[1]),
+            .rows => try lay.chain(f, s, .rows, h, m, in[0], in[1], in[2], in[3], o[1], o[1], o[0]),
+            .rows_to, .tpr => try lay.chain(f, s, self.kind, h, m, in[0], in[1], in[2], in[3], in[4], o[1], o[0]),
+            .fused => try lay.fused(f, s, h, m, in[0], in[1], in[2], in[3], in[4], o[2], o[2], in[5], o[0], o[1], o[3]),
+        }
+    }
+
+    fn upload(self: *Rank, ptr: u64, bytes: []const u8) !void {
+        const b: cuda.DeviceBuffer = .{ .d = self.rig.gpu.d, .ptr = ptr, .len = bytes.len };
+        try b.upload(0, bytes);
+    }
+
+    pub fn run(self: *Rank) !void {
+        if (self.fresh) |f| try self.upload(self.state, f);
+        try self.launch(self.heads, &self.ins, self.outs[0..self.nout]);
+        try self.rig.s.synchronize();
+    }
+
+    /// The full original on the full inputs into its own outputs, rank r's heads gathered in the candidate's order.
+    pub fn replaced(self: *Rank) ![]const u8 {
+        const a = self.rig.gpu.gpa;
+        if (self.fresh) |f| try self.upload(self.state, f);
+        const list = outputs(self.kind);
+        var o: [4]u64 = undefined;
+        var at = self.base;
+        for (list, 0..) |x, i| {
+            o[i] = at;
+            at += bytesOf(x.part, x.elem, self.rows, .full);
+        }
+        const ff = try a.alloc(u8, at - self.base);
+        defer a.free(ff);
+        @memset(ff, 0xff);
+        try self.upload(self.base, ff);
+        for (list, 0..) |x, i| if (x.state) try self.upload(o[i], self.wide_fresh.?);
+        try self.launch(.full, &self.wide, o[0..list.len]);
+        try self.rig.s.synchronize();
+        self.want.clearRetainingCapacity();
+        for (list, 0..) |x, i| {
+            const got = try self.rig.bytes(o[i], bytesOf(x.part, x.elem, self.rows, .full));
+            const mine = try lay.gather(a, got, x.elem, x.part, self.heads, self.rank);
+            defer a.free(mine);
+            try self.want.appendSlice(a, mine);
+        }
+        return self.want.items;
+    }
+
+    /// Gate 1's stated rule: the outputs on the planted inputs equal the original's on the same heads.
+    pub fn check(self: *Rank, gate: g.Gate) !?[]const u8 {
+        _ = gate;
+        self.seen.clearRetainingCapacity();
+        try self.seen.appendSlice(self.rig.gpu.gpa, try self.rig.outputBytes());
+        const want = try self.replaced();
+        if (std.mem.eql(u8, self.seen.items, want)) return null;
+        return try std.fmt.bufPrint(&self.msg, "bytes differ from the full kernel's from byte {d}", .{std.mem.indexOfDiff(u8, self.seen.items, want).?});
+    }
+
+    pub fn count(self: *Rank) usize {
+        var total: usize = 0;
+        for (outputs(self.kind)) |x| total += bytesOf(x.part, x.elem, self.rows, self.heads);
+        return total;
+    }
+
+    pub fn reference(_: *Rank, _: []f64, _: []f64) !void {
+        return error.NoFloat64Reference;
+    }
+};
diff --git a/zig/tests/cuda/contract_flashnext_modelopt.zig b/zig/tests/cuda/contract_flashnext_modelopt.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a8c1abc1f26d4e49ee0ab4e358cfcf0e201adb3d
--- /dev/null
+++ b/zig/tests/cuda/contract_flashnext_modelopt.zig
@@ -0,0 +1,410 @@
+//! NVIDIA's NVFP4 Flash Next checkpoint: BF16 dense and shared projections, FP8 MTP-head expert downs, --tp picks.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const Rig = @import("contract_rig.zig").Rig;
+const c = core.contract.spec;
+const g = core.contract.gates;
+const Dense = core.contract.dense.Dense;
+const q = cuda.qmmf;
+const ex = cuda.experts;
+const grouped = cuda.grouped;
+
+fn depth(s: c.Shape) usize {
+    return s.k / 16 + s.k / 128 + 24;
+}
+
+/// Stress weights: integers 1 to 7 over the first half of each row and their negatives over the second.
+fn stress(rng: std.Random, n: usize, k: usize, out: []f32) void {
+    for (0..n) |j| for (0..k / 2) |i| {
+        const v: f32 = @floatFromInt(1 + rng.uintLessThan(u32, 7));
+        out[j * k + i] = v;
+        out[j * k + k / 2 + i] = -v;
+    };
+}
+
+// The dense and shared layers at decode rows: DeltaNet qkvz+ab, attention qkv+indexer, both outs, shared gate+up, down.
+const bf16_served = [_]c.Shape{
+    .{ .rows = 1, .n = 8240, .k = 2560 },  .{ .rows = 64, .n = 7296, .k = 2560 },
+    .{ .rows = 1, .n = 1280, .k = 6144 },  .{ .rows = 64, .n = 1280, .k = 6144 },
+    .{ .rows = 1, .n = 320, .k = 2560 },   .{ .rows = 64, .n = 1280, .k = 640 },
+    .{ .rows = 1, .n = 16480, .k = 2560 }, .{ .rows = 16, .n = 16480, .k = 2560 },
+    .{ .rows = 1, .n = 13952, .k = 2560 }, .{ .rows = 64, .n = 13952, .k = 2560 },
+    .{ .rows = 1, .n = 2560, .k = 6144 },  .{ .rows = 16, .n = 2560, .k = 6144 },
+    .{ .rows = 4, .n = 1280, .k = 2560 },  .{ .rows = 64, .n = 1280, .k = 2560 },
+    .{ .rows = 1, .n = 2560, .k = 640 },   .{ .rows = 64, .n = 2560, .k = 640 },
+};
+
+/// Flash Next's qmmf BF16-weight product: 16-, 32- and 64-row tiles, with the lane's K-slice plan.
+pub const Bf16 = struct {
+    rig: Rig,
+    lane: *const q.Lane,
+    format: q.Out,
+    control: bool = false,
+    d: ?Dense = null,
+    w: q.Weight = undefined,
+    x: u64 = 0,
+    out: u64 = 0,
+    part: u64 = 0,
+
+    const vt = g.hooks(Bf16);
+
+    pub fn deinit(self: *Bf16) void {
+        if (self.d) |d| d.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Bf16) g.Kernel {
+        const name = if (self.control) "control: Flash Next qmmf BF16 weights scaled 1.5x" else switch (self.format) {
+            .bf16 => "cuda qmmf BF16 weights, bf16 out (Flash Next dense and shared layers)",
+            .f32 => "cuda qmmf BF16 weights, fp32 out (Flash Next dense and shared layers)",
+        };
+        return .{ .ctx = self, .vt = &vt, .control = if (self.control) .shapes else null, .spec = .{
+            .name = name,
+            .accum = .f32,
+            .depth = depth,
+            .ops = 1,
+            .out = if (self.format == .f32) .f32 else .bf16,
+            .tiles = .{ .{ .size = 16 }, .{ .size = 64 }, .{ .size = 64, .step = 64, .min = 64 } },
+            .served = &bf16_served,
+        } };
+    }
+
+    pub fn prepare(self: *Bf16, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (self.d) |d| d.deinit();
+        self.d = null;
+        self.rig.reset();
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0 or shape.k % 64 != 0) return false;
+        const a = self.rig.gpu.gpa;
+        const d = try Dense.init(a, shape, 1);
+        self.d = d;
+        d.fillX(fill, seed, 256);
+        const vals = try a.alloc(f32, shape.n * shape.k);
+        defer a.free(vals);
+        var prng = std.Random.DefaultPrng.init(seed ^ 0xb16d);
+        const rng = prng.random();
+        if (fill == .stress) stress(rng, shape.n, shape.k, vals) else for (vals) |*v| {
+            v.* = rng.float(f32) * 4 - 2;
+        }
+        const bits = try a.alloc(u16, vals.len);
+        defer a.free(bits);
+        for (bits, vals, d.w) |*b, v, *w| {
+            b.* = c.toBf16(v);
+            w.* = c.fromBf16(b.*);
+        }
+        const npad = (shape.n + 127) / 128 * 128;
+        const tiled = try a.alloc(u16, npad * shape.k);
+        defer a.free(tiled);
+        q.packBf16(tiled, bits, shape.n, shape.k);
+        self.w = cuda.modelopt.bf16Weight(try self.rig.input(std.mem.sliceAsBytes(tiled)), shape.n, shape.k);
+        self.x = try self.rig.input(std.mem.sliceAsBytes(d.x));
+        self.out = try self.rig.output(d.outputs() * @as(usize, if (self.format == .f32) 4 else 2));
+        const parts = self.lane.partBytes(shape.rows, self.w);
+        self.part = if (parts == 0) 0 else try self.rig.scratch(parts);
+        return true;
+    }
+
+    pub fn run(self: *Bf16) !void {
+        const s = self.d.?.shape;
+        var w = self.w;
+        if (self.control) w.scale = 1.5;
+        try self.lane.matmulOut(self.rig.s, self.x, s.k, s.rows, w, self.out, self.format, self.part);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Bf16) usize {
+        return self.d.?.outputs();
+    }
+    pub fn reference(self: *Bf16, want: []f64, mag: []f64) !void {
+        try self.d.?.reference(want, mag);
+    }
+    pub fn simulate(self: *Bf16, acc: c.Accum, order: g.Order, out: []f64) !void {
+        try self.d.?.simulate(acc, order, out);
+    }
+};
+
+const experts = 4; // routed experts in the fixture; every pair picks `target`, the rest hold NaN codes
+const target = 2;
+
+// The MTP head's routed down (2,560 x 640): pairs are tokens times ten picks, at decode and prompt row counts.
+const decode_served = [_]c.Shape{ .{ .rows = 10, .n = 2560, .k = 640 }, .{ .rows = 40, .n = 2560, .k = 640 }, .{ .rows = 160, .n = 2560, .k = 640 } };
+const prompt_served = [_]c.Shape{ .{ .rows = 160, .n = 2560, .k = 640 }, .{ .rows = 1280, .n = 2560, .k = 640 } };
+
+/// The MTP head's fp8_experts down_f32: decode or prompt over one expert's grouped pairs.
+pub const Fp8Down = struct {
+    rig: Rig,
+    set: *const Set,
+    prompt: bool,
+    control: bool = false,
+    d: ?Dense = null,
+    layer: ex.Layer = undefined,
+    plan: grouped.Plan = undefined,
+    picks: u64 = 0,
+    x: u64 = 0,
+    out: u64 = 0,
+
+    const vt = g.hooks(Fp8Down);
+
+    pub fn deinit(self: *Fp8Down) void {
+        if (self.d) |d| d.deinit();
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *Fp8Down) g.Kernel {
+        const name = if (self.control) "control: Flash Next FP8 expert down at 1.5x block scales" else if (self.prompt)
+            "cuda fp8_experts prompt down fp32 (Flash Next MTP head)"
+        else
+            "cuda fp8_experts decode down fp32 (Flash Next MTP head)";
+        const rows: usize = if (self.prompt) ex.promptTile(.fp8g) else 16;
+        return .{ .ctx = self, .vt = &vt, .control = if (self.control) .shapes else null, .spec = .{
+            .name = name,
+            .accum = .f32,
+            .depth = depth,
+            .ops = 1,
+            .out = .f32,
+            .tiles = .{ .{ .size = rows }, .{ .size = ex.Fp8Experts.cols, .step = 128, .min = 128 }, .{ .size = 128, .step = 128, .min = 128 } },
+            .served = if (self.prompt) &prompt_served else &decode_served,
+        } };
+    }
+
+    pub fn prepare(self: *Fp8Down, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (self.d) |d| d.deinit();
+        self.d = null;
+        self.rig.reset();
+        const n = shape.n;
+        const k = shape.k;
+        if (shape.rows == 0 or n == 0 or k == 0 or n % 128 != 0 or k % 128 != 0) return false;
+        const a = self.rig.gpu.gpa;
+        const d = try Dense.init(a, shape, 1);
+        self.d = d;
+        d.fillX(fill, seed, 256);
+        var prng = std.Random.DefaultPrng.init(seed ^ 0xf8d0);
+        const rng = prng.random();
+        // E4M3 codes [experts][n][k]: the target's values, every other expert's codes NaN so a misread goes red
+        const codes = try a.alloc(u8, experts * n * k);
+        defer a.free(codes);
+        @memset(codes, 0x7f);
+        const mine = codes[target * n * k ..][0 .. n * k];
+        if (fill == .stress) {
+            const vals = try a.alloc(f32, n * k);
+            defer a.free(vals);
+            stress(rng, n, k, vals);
+            for (mine, vals) |*code, v| code.* = try codeOf(v);
+        } else for (mine) |*code| {
+            code.* = rng.int(u8);
+            if (code.* & 0x7f == 0x7f) code.* ^= 1;
+        }
+        // f32 block scales [experts][1][n/128][k/128]: 1 for sums the stress inputs keep exact, else 2^-8 to 2^-5
+        const blocks = (n / 128) * (k / 128);
+        const scales = try a.alloc(f32, experts * blocks);
+        defer a.free(scales);
+        for (scales) |*s| s.* = if (fill == .stress) 1 else std.math.ldexp(@as(f32, 1), -5 - @as(i32, @intCast(rng.uintLessThan(u32, 4))));
+        for (d.w, 0..) |*w, i| w.* = core.quant.fp8.e4m3(mine[i]) * scales[target * blocks + (i / k / 128) * (k / 128) + (i % k) / 128];
+        if (self.control) for (scales) |*s| {
+            s.* *= 1.5;
+        };
+        const packed_codes = try a.alloc(u32, experts * n * k / 4);
+        defer a.free(packed_codes);
+        for (0..experts) |e| ex.Fp8Experts.packOne(packed_codes[e * n * k / 4 ..][0 .. n * k / 4], codes[e * n * k ..][0 .. n * k], n, k);
+        const picks = try a.alloc(i32, shape.rows);
+        defer a.free(picks);
+        @memset(picks, target);
+        self.layer = .{
+            .format = .fp8g,
+            .up = 0,
+            .down = try self.rig.input(std.mem.sliceAsBytes(packed_codes)),
+            .down_scale = try self.rig.input(std.mem.sliceAsBytes(scales)),
+            .width = k,
+            .dims = n,
+            .experts = experts,
+        };
+        self.picks = try self.rig.input(std.mem.sliceAsBytes(picks));
+        self.x = try self.rig.input(std.mem.sliceAsBytes(d.x));
+        const pairs = shape.rows;
+        const wide = pairs > grouped.small;
+        const sizes = [5]usize{ pairs * 4, grouped.maxItems(pairs, experts, 16) * 12, 8, (if (wide) pairs else 1) * 4, (if (wide) (pairs + 1023) / 1024 * experts else 1) * 4 };
+        var bufs: [5]u64 = undefined;
+        for (sizes, &bufs) |len, *b| b.* = try self.rig.scratch(len);
+        self.plan = .{ .members = bufs[0], .items = bufs[1], .counts = bufs[2], .rank = bufs[3], .hist = bufs[4] };
+        self.out = try self.rig.output(d.outputs() * 4);
+        return true;
+    }
+
+    /// The router's plan, then the down call: each pair's fp32 row of `n` outputs at its own row.
+    pub fn run(self: *Fp8Down) !void {
+        const pairs = self.d.?.shape.rows;
+        const tile: usize = if (self.prompt) ex.promptTile(.fp8g) else 16;
+        try self.set.router.route(self.rig.s, self.picks, pairs, experts, tile, self.plan);
+        const in: ex.Rows = .{ .x = self.x, .stride = self.layer.width };
+        try self.set.fp8.run(self.rig.s, .down_f32, in, self.layer, self.plan, self.prompt, self.out, grouped.maxItems(pairs, experts, tile), -1);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Fp8Down) usize {
+        return self.d.?.outputs();
+    }
+    pub fn reference(self: *Fp8Down, want: []f64, mag: []f64) !void {
+        try self.d.?.reference(want, mag);
+    }
+    pub fn simulate(self: *Fp8Down, acc: c.Accum, order: g.Order, out: []f64) !void {
+        try self.d.?.simulate(acc, order, out);
+    }
+};
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+// Pairs a pass routes (tokens times eleven slots) at decode, a verify round and a 4,608-row prompt pass.
+const picks_served = [_]c.Shape{ .{ .rows = 11, .n = 512, .k = 1 }, .{ .rows = 176, .n = 512, .k = 1 }, .{ .rows = 50688, .n = 512, .k = 1 } };
+
+/// fn_ep_picks at --tp 2's second rank (first 256): its experts' picks to 0..255, every other id to 256.
+pub const EpPicks = struct {
+    rig: Rig,
+    set: *const Set,
+    control: bool = false,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    picks: std.ArrayList(i32) = .empty,
+    dev: [2]u64 = @splat(0),
+    msg: [160]u8 = undefined,
+
+    const vt = g.hooks(EpPicks);
+    const first = 256;
+    const local = 256;
+
+    pub fn deinit(self: *EpPicks) void {
+        self.picks.deinit(self.rig.gpu.gpa);
+        self.rig.deinit();
+    }
+
+    pub fn kernel(self: *EpPicks) g.Kernel {
+        return .{ .ctx = self, .vt = &vt, .control = if (self.control) .shapes else null, .spec = .{
+            .name = if (self.control) "control: fn_ep_picks one expert off" else "cuda flashnext fn_ep_picks (a rank's expert ids at --tp)",
+            .accum = .none,
+            .depth = noSums,
+            .out = .raw,
+            .nan = .{ .stated = "integer expert ids: an owned id less the rank's first, any other id the rank's count" },
+            .tiles = .{ .{ .size = 256 }, .{}, .{} },
+            .served = &picks_served,
+        } };
+    }
+
+    pub fn prepare(self: *EpPicks, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        _ = fill;
+        self.rig.reset();
+        if (shape.rows == 0 or shape.n != 512) return false;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.shape = shape;
+        try self.picks.resize(self.rig.gpu.gpa, shape.rows);
+        for (self.picks.items, 0..) |*p, i| p.* = if (i % 11 == 10) 512 else @intCast(rng.uintLessThan(u32, 512)); // slot 10: shared
+        for ([_]i32{ 0, first - 1, first, first + local - 1 }, 0..) |edge, i| if (i < shape.rows) {
+            self.picks.items[i] = edge;
+        };
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(self.picks.items));
+        self.dev[1] = try self.rig.output(shape.rows * 4);
+        return true;
+    }
+
+    pub fn run(self: *EpPicks) !void {
+        var a: cuda.Args = .{};
+        a.add(self.dev[0]);
+        a.add(self.dev[1]);
+        const start: usize = if (self.control) first + 1 else first;
+        for ([_]usize{ self.shape.rows, start, local }) |v| a.add(@as(i32, @intCast(v)));
+        try cuda.launch.launch(self.set.ep_picks, .{ .grid = .{ .x = @intCast((self.shape.rows + 255) / 256) }, .block = .{ .x = 256 } }, self.rig.s, &a);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *EpPicks) usize {
+        return self.shape.rows * 4;
+    }
+
+    pub fn reference(_: *EpPicks, want: []f64, mag: []f64) !void {
+        @memset(want, 0);
+        @memset(mag, 0);
+    }
+
+    /// Every pick by the rule exactly.
+    pub fn check(self: *EpPicks, _: g.Gate) !?[]const u8 {
+        const got = std.mem.bytesAsSlice(i32, @as([]align(1) const u8, try self.rig.outputBytes()));
+        for (self.picks.items, 0..) |p, i| {
+            const want: i32 = if (p >= first and p < first + local) p - first else local;
+            if (got[i] != want) return try std.fmt.bufPrint(&self.msg, "pick {d} ({d}) mapped to {d}, not {d}", .{ i, p, got[i], want });
+        }
+        return null;
+    }
+};
+
+/// The E4M3 code of an integer the stress weights use (1 to 7 and their negatives).
+fn codeOf(v: f32) !u8 {
+    for (0..256) |i| if (core.quant.fp8.e4m3(@intCast(i)) == v) return @intCast(i);
+    return error.NotE4m3;
+}
+
+/// The checkpoint's two kernel families, their kernels and controls appended to `list`.
+pub const Set = struct {
+    gpa: std.mem.Allocator,
+    lane: q.Lane,
+    fp8: ex.Fp8Experts,
+    mod: cuda.Module,
+    batch: cuda.Module,
+    ep_picks: cuda.Function = undefined,
+    router: grouped.Router = undefined,
+    bf16: [3]Bf16 = undefined,
+    down: [3]Fp8Down = undefined,
+    picks: [2]EpPicks = undefined,
+
+    pub fn init(gpu: check.Gpu, s: cuda.Stream, a: std.mem.Allocator, list: *std.ArrayList(g.Kernel)) !*Set {
+        const set = try gpu.gpa.create(Set);
+        errdefer gpu.gpa.destroy(set);
+        const cap = try gpu.ctx.capability();
+        const sms: usize = @intCast(try gpu.ctx.attribute(.multiprocessor_count));
+        var lane = try q.Lane.load(gpu.d, cap / 10);
+        errdefer lane.unload();
+        var fp8 = try ex.Fp8Experts.load(gpu.d, sms);
+        errdefer fp8.unload();
+        var mod = try cuda.Module.load(gpu.d, cuda.kernels.experts);
+        errdefer mod.unload();
+        var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+        errdefer batch.unload();
+        set.* = .{ .gpa = gpu.gpa, .lane = lane, .fp8 = fp8, .mod = mod, .batch = batch };
+        set.ep_picks = try set.batch.function("fn_ep_picks");
+        set.router = try grouped.Router.resolve(set.mod);
+        const r: Rig = .{ .gpu = gpu, .s = s };
+        set.bf16 = .{ .{ .rig = r, .lane = &set.lane, .format = .bf16 }, .{ .rig = r, .lane = &set.lane, .format = .f32 }, .{ .rig = r, .lane = &set.lane, .format = .bf16, .control = true } };
+        set.down = .{ .{ .rig = r, .set = set, .prompt = false }, .{ .rig = r, .set = set, .prompt = true }, .{ .rig = r, .set = set, .prompt = false, .control = true } };
+        for (&set.bf16) |*x| try list.append(a, x.kernel());
+        for (&set.down) |*x| try list.append(a, x.kernel());
+        set.picks = .{ .{ .rig = r, .set = set }, .{ .rig = r, .set = set, .control = true } };
+        for (&set.picks) |*x| try list.append(a, x.kernel());
+        return set;
+    }
+
+    pub fn deinit(set: *Set) void {
+        for (&set.picks) |*x| x.deinit();
+        for (&set.down) |*x| x.deinit();
+        for (&set.bf16) |*x| x.deinit();
+        set.batch.unload();
+        set.mod.unload();
+        set.fp8.unload();
+        set.lane.unload();
+        set.gpa.destroy(set);
+    }
+};
+
+/// These kernels' gates 1-4 and their controls alone (tf-cuda-test flashnext-modelopt-contract).
+pub fn run(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var list: std.ArrayList(g.Kernel) = .empty;
+    defer list.deinit(a);
+    const set = try Set.init(gpu, s, a, &list);
+    defer set.deinit();
+    var t: g.Tally = .{};
+    try g.runAll(a, list.items, 0x6b63, &t);
+    std.debug.print("SUMMARY {d} kernels: {d} pass gates 1-4, {d} fail; {d} controls: {d} red as planted, {d} missed\n", .{ t.kernels, t.passed, t.failed, t.controls, t.caught, t.missed });
+    try check.expect(t.problems() == 0, "flashnext-modelopt-contract: {d} gate failures, {d} controls missed", .{ t.failed, t.missed });
+}
