+
+/// Every attention layer's contiguous caches for `cap` positions: keys, values, indexer keys and pooled blocks.
+fn attnBytes(cap: usize, h: Heads) usize {
+    return attn_n * (2 * kvBytes(cap, h) + indexBytes(cap) + pooledBytes(cap));
