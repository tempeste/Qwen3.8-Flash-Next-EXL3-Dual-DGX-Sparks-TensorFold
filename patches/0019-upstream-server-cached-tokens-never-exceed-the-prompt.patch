From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ashhart <71890694+ashhart@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:43:51 +0000
Subject: [PATCH] server: cached tokens never exceed the prompt (#1899)

Upstream TensorFold commit by ashhart, ported onto this series (upstream main 48e60da98f2f).

Upstream 48e60da98, applied by hand to our chat.zig. A backend may report more restored prompt tokens than
the prompt holds (upstream names the --tp 2 doubling). The engine's count is clamped once where it is read,
so the reply's cached_tokens, its done line and prompt_tokens_cached_total agree. The test's counter check
is left out: our test server seeds its metrics differently.

(cherry picked from commit 48e60da98f2ffa6e499f4b1832ae908f954d89a1)
---
 zig/src/server/cached_tokens.zig   | 5 +++++
 zig/src/server/chat.zig            | 5 +++--
 zig/src/server/done_times_test.zig | 8 ++++++--
 3 files changed, 14 insertions(+), 4 deletions(-)
 create mode 100644 zig/src/server/cached_tokens.zig

diff --git a/zig/src/server/cached_tokens.zig b/zig/src/server/cached_tokens.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f35b9f4da4a790a71c48ecfb1b2ba35d4e87553d
--- /dev/null
+++ b/zig/src/server/cached_tokens.zig
@@ -0,0 +1,5 @@
+//! No reply or counter claims more cached tokens than its prompt holds (issue #1899).
+/// The engine's count clamped to the prompt: the reply, its done line and the counter use one value.
+pub fn within(cached: ?u32, prompt_len: usize) usize {
+    return @min(@as(usize, cached orelse 0), prompt_len);
+}
diff --git a/zig/src/server/chat.zig b/zig/src/server/chat.zig
index 366753fc4bd973a77f983758c77cfc60f428e8a6..af0a3f7f8701c7a59f784a58fd638e336c3541cb 100644
--- a/zig/src/server/chat.zig
+++ b/zig/src/server/chat.zig
@@ -10,6 +10,7 @@ const tool_parse = @import("tool_parse.zig");
 const tool_lfm2 = @import("tool_lfm2.zig");
 const prompt_mod = @import("prompt.zig");
 const log = @import("log.zig");
+const cached_tokens = @import("cached_tokens.zig");
 const ids = @import("ids.zig");
 const clock = @import("clock.zig");
 const Server = @import("server.zig").Server;
@@ -259,7 +260,7 @@ pub fn generate(srv: *Server, cx: *Cx, prepared: Prepared, sink: ?Sink, gone: an
     srv.release(preparing, null); // a background request waits only while a foreground one prepares
     preparing = false;
     var gen: Generation = .{ .srv = srv, .a = a, .box = &box, .id = id, .reply_id = input.id, .seed = if (request.sampling) |v| v.seed else null, .sink = sink, .thinking = prepared.reasoning or (srv.info.reasoning and reply_text.isChannel(srv.markers)), .stops = .{ .strings = stops_opt.strings }, .ignore_eos = stops_opt.ignore_eos, .max_tokens = request.max_tokens, .tools = input.tools, .token_ids = prepared.token_ids, .lp = if (request.logprobs != null) .{} else null, .loop_stop = request.loop_stop };
-    defer srv.noteRequest(prepared.prompt_len, box.cached orelse 0, gen.collected.items.len, box.stats.drafted, box.stats.accepted, box.stats.rounds, received, gen.first_ns, gen.last_ns, box.stats.prefill_seconds);
+    defer srv.noteRequest(prepared.prompt_len, cached_tokens.within(box.cached, prepared.prompt_len), gen.collected.items.len, box.stats.drafted, box.stats.accepted, box.stats.rounds, received, gen.first_ns, gen.last_ns, box.stats.prefill_seconds);
     errdefer if (!gen.engine_done) gen.cancel(); // the engine writes to the mailbox until it says finished
     const result: Failure!Reply = blk: {
         if (sink) |s| if (s.begin) |begin| begin(s.ctx, prepared.prompt_len) catch break :blk error.Cancelled;
@@ -582,7 +583,7 @@ const Generation = struct {
             .tool_calls_streamed = g.calls != null and g.calls.?.streamed,
             .finish_reason = reason,
             .prompt_tokens = prompt_len,
-            .cached_tokens = m.cached orelse 0,
+            .cached_tokens = cached_tokens.within(m.cached, prompt_len),
             .completion_tokens = g.collected.items.len,
             .reasoning_tokens = reply_text.reasoningCount(g.collected.items, think_end),
             .runtime = .{ .object = runtime },
diff --git a/zig/src/server/done_times_test.zig b/zig/src/server/done_times_test.zig
index 545762cc31d43da629ab2cbe6d182cf6feecd7f6..839c1af20c30338998496b3e16fd4e63d013254b 100644
