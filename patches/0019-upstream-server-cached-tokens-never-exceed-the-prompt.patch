         const sha = @import("tokens.zig").tokenSha(&.{ 'h', 'i' });
-        const expected = try std.fmt.allocPrint(arena.allocator(), "[tensorfold] done chatcmpl-test prompt=6 cached={d} thinking=False effort=none tokens=2 sha={s} finish=length loop=period:3 rounds=19 accepted=70/94{s}{s}\n", .{ cached, sha, if (cached > 0) " ttft=0.123 decode=0.333 elapsed=0.456 queued=0.000 tok/s=3.0" else " ttft=0.384 decode=7.206 elapsed=7.590 queued=0.000 tok/s=0.1", copied });
+        const expected = try std.fmt.allocPrint(arena.allocator(), "[tensorfold] done chatcmpl-test prompt=6 cached={d} thinking=False effort=none tokens=2 sha={s} finish=length loop=period:3 rounds=19 accepted=70/94{s}{s}\n", .{ shown, sha, if (cached > 0) " ttft=0.123 decode=0.333 elapsed=0.456 queued=0.000 tok/s=3.0" else " ttft=0.384 decode=7.206 elapsed=7.590 queued=0.000 tok/s=0.1", copied });
         try std.testing.expectEqualStrings(expected, capture.bytes.items);
     }
     try std.testing.expect(!capture.failed);
@@ -172,6 +173,9 @@ test "done times: a resumed prompt logs its own cache count and times rather tha
 test "done times: a client-left request logs only its existing ended line" {
     try scripted(0, true);
 }
+test "done times: cached tokens above the prompt are clamped in the reply and its done line" {
+    try scripted(11, false);
+}
 test "done times: rows copied from the context end the line, kept over verified" {
     try scriptedCopies(0, false, .{ 24, 31 }, " copied=24/31");
 }
