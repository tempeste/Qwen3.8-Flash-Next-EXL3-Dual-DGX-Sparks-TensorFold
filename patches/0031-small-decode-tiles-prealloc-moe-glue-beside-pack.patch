+__device__ __forceinline__ void warp_topk(const FrontArgs& a, int r) {
+    const int lane = threadIdx.x & 31;
+    const float* row = a.logits + static_cast<long long>(r) * (a.experts + 1);
+    float v[FRONT_MOST];
+#pragma unroll
+    for (int j = 0; j < FRONT_MOST; ++j) {
+        const int i = lane + 32 * j;
+        v[j] = i < a.experts ? __ldcg(row + i) : -INFINITY;
+    }
+    float top = 0.0f, total = 0.0f, mine = 0.0f;
+    int pick = 0;
+    for (int k = 0; k < a.top_k; ++k) {
+        float bv = -INFINITY;
+        int bi = 0x7fffffff;
+#pragma unroll
+        for (int j = 0; j < FRONT_MOST; ++j) {
+            const int i = lane + 32 * j;
+            if (v[j] > bv || (v[j] == bv && i < bi)) {
+                bv = v[j];
+                bi = i;
+            }
+        }
+        for (int off = 16; off > 0; off >>= 1) {
+            const float ov = __shfl_xor_sync(0xffffffffu, bv, off);
+            const int oi = __shfl_xor_sync(0xffffffffu, bi, off);
+            if (ov > bv || (ov == bv && oi < bi)) {
+                bv = ov;
+                bi = oi;
+            }
+        }
+        if (k == 0) top = bv;
+#pragma unroll
+        for (int j = 0; j < FRONT_MOST; ++j)
+            if (lane + 32 * j == bi) v[j] = -INFINITY;
+        const float ex = tf_exp(__fsub_rn(bv, top));
+        total = __fadd_rn(total, ex);
+        if (lane == k) {
+            mine = ex;
+            pick = bi;
+        }
+    }
