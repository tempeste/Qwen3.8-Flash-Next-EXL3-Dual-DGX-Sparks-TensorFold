+++ b/zig/tests/cuda/flashnext_prompt_pool_tests.zig
@@ -0,0 +1,76 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const pool = flash.prompt_pool;
+
+const sizes = [_]usize{ 3 << 20, 49 << 20, 185 << 20, 280 << 20, 1 << 30 };
+const reps = 6;
+
+fn timed(gpu: check.Gpu, n: usize) ![2]f64 {
+    var alloc_ns: i96 = 0;
+    var free_ns: i96 = 0;
+    for (0..reps) |_| {
+        const t0 = check.now(gpu.io);
+        var b = try cuda.DeviceBuffer.alloc(gpu.d, n);
+        const t1 = check.now(gpu.io);
+        try b.fill8(0, null);
+        const t2 = check.now(gpu.io);
+        b.free();
+        const t3 = check.now(gpu.io);
+        alloc_ns += t1 - t0;
+        free_ns += t3 - t2;
+    }
+    return .{ @as(f64, @floatFromInt(alloc_ns)) / reps / 1e6, @as(f64, @floatFromInt(free_ns)) / reps / 1e6 };
+}
+
+pub fn run(gpu: check.Gpu, gib: usize) !void {
+    try check.expect(pool.current() == null and cuda.memory.currentHook() == null, "flashnext-prompt-pool: a pool or hook is already installed", .{});
+    var plain: [sizes.len][2]f64 = undefined;
+    for (sizes, &plain) |n, *p| p.* = try timed(gpu, n);
+    const r = try pool.install(gpu.gpa, gpu.d, @as(u64, gib) << 30);
+    defer {
+        pool.uninstallForTest(r);
+        for (r.chunks.items) |c| _ = gpu.d.api.cuMemFree_v2(c.base);
+        r.deinitHost();
+        gpu.gpa.destroy(r);
+    }
+    const hits0 = r.stats.hits;
+    for (sizes, plain) |n, p| {
+        const q = try timed(gpu, n);
+        std.debug.print("{d:>5} MiB: cuMemAlloc {d:.3} ms, cuMemFree {d:.3} ms; pool alloc {d:.3} ms, pool free {d:.3} ms\n", .{ n >> 20, p[0], p[1], q[0], q[1] });
+    }
+    try check.expect(r.stats.misses == 0 and r.stats.hits - hits0 == sizes.len * reps, "flashnext-prompt-pool: {d} hits and {d} misses, expected {d} hits", .{ r.stats.hits - hits0, r.stats.misses, sizes.len * reps });
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    const n: usize = 256 << 20;
+    var filler: std.ArrayList(cuda.DeviceBuffer) = .empty;
+    defer {
+        for (filler.items) |*b| b.free();
+        filler.deinit(gpu.gpa);
+    }
+    var a = try cuda.DeviceBuffer.alloc(gpu.d, n);
+    while (true) {
+        const b = try cuda.DeviceBuffer.alloc(gpu.d, n);
+        if (b.owner == null) {
+            var x = b;
+            x.free();
+            break;
+        }
+        try filler.append(gpu.gpa, b);
+    }
+    for (0..64) |_| try a.fill8(0x11, stream.handle);
+    const syncs = r.stats.syncs;
+    const a_ptr = a.ptr;
+    a.free();
+    var b = try cuda.DeviceBuffer.alloc(gpu.d, n);
+    defer b.free();
+    try check.expect(b.ptr == a_ptr and r.stats.syncs == syncs + 1, "flashnext-prompt-pool: the freed range came back at {x} (freed {x}) after {d} synchronizes", .{ b.ptr, a_ptr, r.stats.syncs - syncs });
+    try b.fill8(0x5a, stream.handle);
+    try stream.synchronize();
+    const host = try gpu.gpa.alloc(u8, n);
+    defer gpu.gpa.free(host);
+    try b.download(0, host);
+    for (host, 0..) |v, i| try check.expect(v == 0x5a, "flashnext-prompt-pool: byte {d} of the reused range is {x}: a write queued before its free landed after", .{ i, v });
+    check.pass("flashnext-prompt-pool: {d} GiB in {d} chunks; every buffer from the pool; a freed range reused only after a synchronize, its earlier writes all landed before", .{ gib, r.chunks.items.len });
+}
