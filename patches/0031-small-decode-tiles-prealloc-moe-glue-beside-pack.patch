+pub fn besideWaits(on: bool, busy: bool, whole: bool, piece: usize, least: usize) bool {
+    return on and busy and !whole and piece >= least;
+}
+
+test "TF_FLASHNEXT_MIXED_BESIDE holds a second read's piece that would go beside while one is beside, instead of riding a round" {
+    try std.testing.expect(besideWaits(true, true, false, 2944, 512));
+    try std.testing.expect(besideWaits(true, true, false, 512, 512));
+    try std.testing.expect(!besideWaits(true, true, false, 511, 512));
+    try std.testing.expect(!besideWaits(true, false, false, 2944, 512));
+    try std.testing.expect(!besideWaits(false, true, false, 2944, 512));
+    try std.testing.expect(!besideWaits(true, true, true, 2944, 512));
+    for ([_]bool{ false, true }) |busy| for ([_]usize{ 0, 511, 512, 2944, 16384 }) |piece| {
+        try std.testing.expect(!(besideWaits(true, busy, false, piece, 512) and besideTakes(true, busy, false, piece, 512)));
+        try std.testing.expectEqual(piece >= 512, besideWaits(true, busy, false, piece, 512) or besideTakes(true, busy, false, piece, 512));
+        try std.testing.expect(!besideWaits(false, busy, false, piece, 512) and !besideTakes(false, busy, false, piece, 512));
+    };
+}
+
+pub fn besideJoinsFirst(busy: bool, holds: bool, room: usize) bool {
+    return busy and (holds or room == 0);
+}
+
+test "a lane opened while a piece is beside never moves or drops the piece's sequence: the beside joins first when the lanes' map would grow or the stream is the piece's" {
+    const Lane = struct { fed: usize, window: [4]usize };
+    const a = std.testing.allocator;
+    var map: std.AutoHashMapUnmanaged(*const u8, Lane) = .empty;
+    defer map.deinit(a);
+    var streams: [40]u8 = undefined;
+    const Held = struct { key: *const u8, lane: *Lane, window: *[4]usize };
+    var held: ?Held = null;
+    var joins: usize = 0;
+    var moves: usize = 0;
+    const first = try map.getOrPut(a, &streams[0]);
+    first.value_ptr.* = .{ .fed = 0, .window = @splat(0) };
+    for (1..streams.len) |i| {
+        if (held == null) {
+            const k: *const u8 = &streams[i - 1];
+            const l = map.getPtr(k).?;
+            held = .{ .key = k, .lane = l, .window = &l.window };
+        }
+        const probe = map.getPtr(&streams[0]).?;
+        const room = map.available;
+        if (besideJoinsFirst(held != null, held.?.key == &streams[i], room)) {
+            try std.testing.expectEqual(map.getPtr(held.?.key).?, held.?.lane);
+            held = null;
+            joins += 1;
+        }
+        const gop = try map.getOrPut(a, &streams[i]);
+        try std.testing.expect(!gop.found_existing);
+        gop.value_ptr.* = .{ .fed = i, .window = @splat(i) };
+        if (map.getPtr(&streams[0]).? != probe) {
+            try std.testing.expectEqual(@as(usize, 0), room);
+            moves += 1;
+        }
+        if (held) |h| {
+            try std.testing.expectEqual(map.getPtr(h.key).?, h.lane);
+            try std.testing.expectEqual(&h.lane.window, h.window);
+            h.lane.fed += 1;
+        }
+    }
+    try std.testing.expect(moves >= 3 and joins == moves);
+    for (0..streams.len) |i| _ = map.remove(&streams[i]);
+    const room = map.available;
+    try std.testing.expect(room > 0 and !besideJoinsFirst(true, false, room) and besideJoinsFirst(true, true, room));
+    try std.testing.expect(!besideJoinsFirst(false, true, 0) and !besideJoinsFirst(false, false, 0));
+}
+
+pub fn closeAll(gpa: std.mem.Allocator, map: anytype, ctx: anytype) void {
+    ctx.joinBeside();
+    var it = map.valueIterator();
+    while (it.next()) |v| ctx.drop(v);
+    map.deinit(gpa);
+}
+
+test "closing every lane joins a piece beside before any lane or the lanes' map block is freed" {
+    const Lane = struct { fed: usize };
+    const a = std.testing.allocator;
+    var map: std.AutoHashMapUnmanaged(u32, Lane) = .empty;
+    for (0..13) |i| try map.put(a, @intCast(i), .{ .fed = i });
+    const Ctx = struct {
