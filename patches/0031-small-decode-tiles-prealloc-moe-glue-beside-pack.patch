+    var a: usize = 512;
+    while (a <= 2560) : (a += 64) {
+        var b: usize = 512;
+        while (a + b <= 3072) : (b += 64) {
+            if (!takes(3072, 512, any, a, b)) continue;
+            const bf = seq_par.peerBf16(any.scatter_bf16, any.exact, true, sumRows(a, b));
+            try std.testing.expectEqual(!bitExact(any, a, b), bf);
