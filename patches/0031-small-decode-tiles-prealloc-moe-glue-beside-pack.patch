@@ -0,0 +1,92 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const knobs = @import("cuda_knobs.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const nvfp4_tile = @import("cuda_nvfp4_tile.zig");
+const xp = @import("cuda_exl3_prompt.zig");
+const expert_reroute = @import("expert_reroute.zig");
+const route_dump = @import("route_dump.zig");
+
+const rr = cuda.route_rows;
+const dims = wt.dims;
+const experts_n = wt.experts_n;
+const slots = wt.slots;
+
+pub const Front = struct { own: bool = false, tile: usize = 0 };
+
+pub var fronts: u64 = 0;
+
+pub fn takes(on: bool, rerouting: bool, dumping: bool, sync: u64, rows: usize, world: usize) bool {
+    return on and !rerouting and !dumping and sync != 0 and rows >= 1 and rows <= rr.front_most and world >= 1;
+}
+
+pub fn planTile(format_exl3: bool, world: usize, kit_tile: usize, pair_cap: usize, prompt_takes: bool, n: usize) usize {
+    if (world == 1 or !format_exl3) return 0;
+    if (n * slots > pair_cap) return 0;
+    if (prompt_takes) return xp.members;
+    return if (kit_tile == 16) 16 else nvfp4_tile.size(n);
+}
+
+pub fn route(self: anytype, lw: anytype, n: usize) !bool {
+    if (!@hasField(@TypeOf(self.tri), "own")) return false;
+    const native = if (lw.native_experts) |*x| x else return false;
+    const s = self.s;
+    if (!takes(knobs.moeGlue() catch false, expert_reroute.rule != null, route_dump.state != null, s.glue_sync, n, native.world)) return false;
+    const g = self.tri.own orelse return false;
+    const o = &native.experts;
+    const tile = if (self.k.exl3) |kit| planTile(o.format == .exl3, native.world, kit.grouped.tile, kit.grouped.pair_cap, xp.takes(kit.prompt_rows, n, o.exl3_prompt), n) else 0;
+    const first = if (native.world == 1) 0 else o.first;
+    const local = if (native.world == 1) experts_n else o.count;
+    const stride = if (native.world == 1) 1 else o.stride;
+    if (!rr.frontShape(n, dims, dims, experts_n, slots - 1, slots, first, local, stride)) return false;
+    const i = struct {
+        fn f(v: usize) i32 {
+            return @intCast(v);
+        }
+    }.f;
+    try g.route.front(self.stream, .{
+        .x = s.mixed,
+        .w = lw.router.ptr,
+        .logits = s.router_l,
+        .picks = s.picks,
+        .wts = s.wts,
+        .own = s.picks_ep,
+        .members = s.members,
+        .items = s.items,
+        .counts = s.counts,
+        .sync = s.glue_sync,
+        .x_ld = i(dims),
+        .rows = i(n),
+        .d = i(dims),
+        .experts = i(experts_n),
+        .top_k = i(slots - 1),
+        .slots = i(slots),
+        .first = i(first),
+        .local = i(local),
+        .stride = i(stride),
+        .tile = i(tile),
+    });
+    self.glue_front = .{ .own = native.world != 1, .tile = tile };
+    fronts += 1;
+    return true;
