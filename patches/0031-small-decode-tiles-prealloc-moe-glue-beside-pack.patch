+++ b/zig/src/families/flashnext/cuda_beside_pack.zig
@@ -0,0 +1,221 @@
+const std = @import("std");
+const knobs = @import("cuda_knobs.zig");
+const seq_par = @import("cuda_seq_par.zig");
+const split_sum = @import("cuda_split_sum.zig");
+const state = @import("cuda_batch_state.zig");
+const batch_lanes = @import("cuda_batch_lanes.zig");
+
+pub const Shape = struct { rows: usize, fed: usize, cap: usize };
+
+pub fn check(a: Shape, b: Shape, same_seq: bool, same_prompt: bool, scratch_rows: usize, score_cap: usize) error{UnexpectedTensor}!void {
+    if (same_seq or !same_prompt) return error.UnexpectedTensor;
+    for ([_]Shape{ a, b }) |x| if (x.rows == 0 or x.fed + x.rows > x.cap or x.cap > score_cap) return error.UnexpectedTensor;
+    if (a.rows + b.rows > scratch_rows) return error.UnexpectedTensor;
+}
+
+pub const Sums = struct { scatter_bf16: bool, exact: bool, any: bool = false };
+
+pub fn sumsNow() !Sums {
+    return .{ .scatter_bf16 = try knobs.tpScatterBf16(), .exact = try knobs.tpSeqParExact(), .any = try knobs.mixedBesidePackAny() };
+}
+
+pub fn soloF32(s: Sums, rows: usize) bool {
+    return !seq_par.peerBf16(s.scatter_bf16, s.exact, true, rows);
+}
+
+pub fn takes(cap: usize, least: usize, s: Sums, a: usize, b: usize) bool {
+    return cap > 0 and a >= least and b >= least and a + b <= cap and (s.any or (soloF32(s, a) and soloF32(s, b)));
+}
+
+pub fn bitExact(s: Sums, a: usize, b: usize) bool {
+    return soloF32(s, a) and soloF32(s, b);
+}
+
+pub fn partnerTakes(defers: bool, beside: bool, merged: bool) bool {
+    return defers and beside and !merged;
+}
+
+pub fn sumRows(a: usize, b: usize) usize {
+    return @max(a, b);
+}
+
+pub fn lanes(a: Shape, b: Shape) [2]struct { pos: usize, rows: usize, row0: usize } {
+    return .{ .{ .pos = a.fed, .rows = a.rows, .row0 = 0 }, .{ .pos = b.fed, .rows = b.rows, .row0 = a.rows } };
+}
+
+fn bf16(x: f32) f32 {
+    const u: u32 = @bitCast(x);
+    const r = u +% (0x7fff + ((u >> 16) & 1));
+    return @bitCast(r & 0xffff_0000);
+}
+
+fn owner(n: usize, r: usize) usize {
+    return if (r < split_sum.halves(n)[0].n) 0 else 1;
+}
+
+fn sumAt(p: [2]f32, own: usize, peer_bf16: bool) f32 {
+    const peer = p[1 - own];
+    return p[own] + (if (peer_bf16) bf16(peer) else peer);
+}
+
+test "a packed beside pass takes two pieces of at least the beside minimum within its rows, each summed in fp32 alone" {
+    const prod: Sums = .{ .scatter_bf16 = true, .exact = true };
+    try std.testing.expect(takes(3072, 512, prod, 736, 1003));
+    try std.testing.expect(takes(3072, 512, prod, 1535, 1535));
+    try std.testing.expect(takes(2304, 512, prod, 1040, 1163));
+    try std.testing.expect(!takes(2048, 512, prod, 1040, 1163));
+    try std.testing.expect(!takes(3072, 512, prod, 511, 1003));
+    try std.testing.expect(!takes(3072, 512, prod, 1536, 736));
+    try std.testing.expect(!takes(4096, 512, prod, 1680, 1644));
+    try std.testing.expect(!takes(0, 512, prod, 736, 736));
+    const fp32: Sums = .{ .scatter_bf16 = false, .exact = true };
+    try std.testing.expect(takes(4096, 512, fp32, 1680, 1644));
+    try std.testing.expect(takes(4096, 512, .{ .scatter_bf16 = false, .exact = false }, 2944, 1003));
+    try std.testing.expect(!takes(4096, 512, .{ .scatter_bf16 = true, .exact = false }, 736, 1003));
+    for (512..1536) |a| try std.testing.expect(soloF32(prod, a));
+    for (1536..4097) |a| try std.testing.expect(!soloF32(prod, a));
+}
+
+test "a packed pass sums its rows in fp32 whenever both pieces' solo passes do, whatever its own rows" {
+    const prod: Sums = .{ .scatter_bf16 = true, .exact = true };
+    var a: usize = 512;
+    while (a < 1536) : (a += 61) {
+        var b: usize = 512;
+        while (b < 1536) : (b += 67) {
+            if (!takes(4096, 512, prod, a, b)) continue;
+            try std.testing.expect(!seq_par.peerBf16(prod.scatter_bf16, prod.exact, true, sumRows(a, b)));
+            try std.testing.expect(!seq_par.peerBf16(prod.scatter_bf16, prod.exact, false, sumRows(a, b)));
+            try std.testing.expect(a + b < knobs.split_sum_min_rows or seq_par.peerBf16(prod.scatter_bf16, prod.exact, true, a + b));
+        }
+    }
+}
+
+test "every packed row's two-rank fp32 sum is its solo pass's bits, whichever rank owns it in either pass; a bf16 peer row would not be" {
+    var prng = std.Random.DefaultPrng.init(0x3970);
+    const rnd = prng.random();
+    const shapes = [_][2]usize{ .{ 736, 1003 }, .{ 1040, 1163 }, .{ 1535, 1535 }, .{ 512, 1280 } };
+    var bf_differs: usize = 0;
+    for (shapes) |sh| {
+        const n = sh[0] + sh[1];
+        for (0..n) |r| {
+            const piece: usize = if (r < sh[0]) 0 else 1;
+            const solo_r = if (piece == 0) r else r - sh[0];
+            const p: [2]f32 = .{ (rnd.float(f32) - 0.5) * 64.0, (rnd.float(f32) - 0.5) * 64.0 };
+            const solo = sumAt(p, owner(sh[piece], solo_r), false);
+            const packed_sum = sumAt(p, owner(n, r), false);
+            try std.testing.expectEqual(@as(u32, @bitCast(solo)), @as(u32, @bitCast(packed_sum)));
+            if (@as(u32, @bitCast(sumAt(p, 0, true))) != @as(u32, @bitCast(sumAt(p, 1, true)))) bf_differs += 1;
+        }
+    }
+    try std.testing.expect(bf_differs > 0);
+}
