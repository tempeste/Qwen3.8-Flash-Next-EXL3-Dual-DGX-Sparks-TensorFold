+pub fn packShapeOk(h: wire.Header) bool {
+    return h.object != 0 and h.arg == 2 and h.flags == 0 and h.bytes > frames.entry_bytes * 2 and h.bytes <= frames.max_bytes and (h.bytes - frames.entry_bytes * 2) % 4 == 0;
+}
+
+fn packOn() bool {
+    return (knobs.mixedBesidePack() catch 0) > 0;
+}
+
+pub fn encodePack(a: beside.Piece, b: beside.Piece, out: []u8) ![]const u8 {
+    const pieces = [_]multi.Piece{ .{ .seq = a.seq, .ids = a.ids, .last = a.last }, .{ .seq = b.seq, .ids = b.ids, .last = b.last } };
+    return frames.encode(&.{ a.seq.rank_id, b.seq.rank_id }, &pieces, out);
+}
+
+pub fn startPack(s: *Session, comptime Tri: type, tri: Tri, a: beside.Piece, b: beside.Piece) !void {
+    if (!packOn()) return error.UnsupportedRankOperation;
+    const x = try engineBeside(s);
+    if (x.busy()) return error.BesideBusy;
+    if (a.seq.rank_id == 0 or b.seq.rank_id == 0 or a.seq == b.seq) return error.UnsupportedRankOperation;
+    pack.check(.{ .rows = a.ids.len, .fed = a.seq.fed, .cap = a.seq.cap }, .{ .rows = b.ids.len, .fed = b.seq.fed, .cap = b.seq.cap }, false, a.prompt == b.prompt, x.s.cap, x.score_cap) catch return error.UnsupportedRankOperation;
+    const raw = try s.gpa.alloc(u8, frames.max_bytes);
+    defer s.gpa.free(raw);
+    const bytes = try encodePack(a, b, raw);
+    const h = try s.command(.{ .kind = .beside_pack, .object = a.seq.rank_id, .arg = 2, .bytes = @intCast(bytes.len) }, bytes);
+    errdefer s.poison();
+    try x.open(s.link, s.rank);
+    try x.startPack(s.engine, Tri, tri, a, b);
+    try s.ack(h);
+}
+
+pub fn receivePack(s: *Session, comptime Tri: type, tri: Tri, h: wire.Header, payload: []const u8) !void {
+    if (!packOn()) return error.UnsupportedRankOperation;
+    const x = try engineBeside(s);
+    if (x.busy()) return error.BesideBusy;
+    var entries: [multi.max_pieces]frames.Entry = undefined;
+    const got = try frames.decode(payload, 2, &entries);
+    if (got[0].id != h.object) return error.BadRankFrame;
