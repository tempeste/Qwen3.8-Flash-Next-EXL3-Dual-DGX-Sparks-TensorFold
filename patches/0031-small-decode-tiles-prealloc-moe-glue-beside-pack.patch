+    try std.testing.expectEqual(@as(usize, 1), store.entries.items.len);
+    try std.testing.expectEqual(@as(u64, 1000 + 10 * 3997), host.real());
+    try std.testing.expectEqual(host.real(), p.held(p.ctx));
+    try std.testing.expect(!p.give(p.ctx, e.saved, a[0..4500], 1));
+    l.reset();
+    try store.family.vtable.restore(store.family.ptr, &l, e.saved);
+    store.resumed(e, a[0..4500], true);
+    try std.testing.expectEqual(@as(usize, 3), HostRows.depth(@as(*HostKept, @ptrCast(@alignCast(e.saved))).top, 3997));
+    for (found.marks) |m| {
+        l.feed(&a, m);
+        try std.testing.expect(store.keepBorn(&a, 4500, m, &l, &.{}, &.{}));
+    }
