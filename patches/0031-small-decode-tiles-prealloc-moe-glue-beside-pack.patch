+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const pc = @import("engine_api").prompt_cache;
+const pool_store = @import("pool_store");
+
+pub fn attach(ctx: *const cuda.Context, target: *anyopaque, store: ?*pc.Store, cache: u64) !bool {
+    const cu: *flash.native.Cuda = @ptrCast(@alignCast(target));
+    if (!cu.pool.on) return false;
+    const room: u64 = (try ctx.memInfo()).free;
+    try flash.native.pool_attach(target, pool_store.of(flash.native, store), room, cache, 0, 0);
+    return true;
+}
