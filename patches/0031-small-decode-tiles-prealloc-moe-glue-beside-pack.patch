diff --git a/zig/tests/cuda/decode_small_tests.zig b/zig/tests/cuda/decode_small_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3088905481856fcbc45c24b59fc11b34248595fe
--- /dev/null
+++ b/zig/tests/cuda/decode_small_tests.zig
@@ -0,0 +1,608 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const t = @import("prompt_tile2_tests.zig");
+
+const qmmf = cuda.qmmf;
+const tk = flash.tile_kernels;
+
+const Shape = struct { name: []const u8, n: usize, k: usize, sk: u32, out: qmmf.Out, per: f64 };
+
+const shapes = [_]Shape{
+    .{ .name = "DeltaNet in", .n = 8240, .k = 2560, .sk = 0, .out = .bf16, .per = 36 },
+    .{ .name = "attention qkv", .n = 7296, .k = 2560, .sk = 0, .out = .bf16, .per = 12 },
+    .{ .name = "DeltaNet and attention out", .n = 2560, .k = 3072, .sk = 0, .out = .f32, .per = 48 },
+    .{ .name = "shared down", .n = 2560, .k = 320, .sk = 0, .out = .f32, .per = 48 },
+};
+
+const edges = [_]Shape{
+    .{ .name = "shared gate alone", .n = 320, .k = 2560, .sk = 0, .out = .bf16, .per = 0 },
+    .{ .name = "wide columns", .n = 124160, .k = 2560, .sk = 0, .out = .bf16, .per = 0 },
+    .{ .name = "draft-width out", .n = 2560, .k = 6144, .sk = 0, .out = .bf16, .per = 0 },
+    .{ .name = "odd columns", .n = 70, .k = 512, .sk = 0, .out = .bf16, .per = 0 },
+    .{ .name = "odd columns fp32", .n = 1001, .k = 2560, .sk = 4, .out = .f32, .per = 0 },
+    .{ .name = "two slices", .n = 640, .k = 1024, .sk = 2, .out = .bf16, .per = 0 },
+    .{ .name = "eight slices", .n = 136, .k = 4096, .sk = 8, .out = .f32, .per = 0 },
+    .{ .name = "one column tile", .n = 8, .k = 2560, .sk = 0, .out = .bf16, .per = 0 },
+};
+
+const gu_n = 320;
+const gu_k = 2560;
+const gu_per = 48;
+
+const rows_checked = [_]usize{ 1, 2, 3, 4, 5, 7, 8, 11, 14, 15, 16, 17, 23, 28, 31, 32, 33, 47, 48, 49, 56, 63, 64, 65, 72, 74, 79, 80, 81, 84, 95, 96 };
+const bench_rows = [_]usize{ 16, 32, 72, 96 };
+const bench_lanes = [_][]const u8{ "4 lanes", "8 lanes", "24 lanes at 3 rows", "24 lanes at 4 rows" };
+
+const forced = [_]qmmf.SmallTile{ .{ .nt = 2, .nw = 2 }, .{ .nt = 2, .nw = 4 }, .{ .nt = 2, .nw = 8 }, .{ .nt = 4, .nw = 2 }, .{ .nt = 4, .nw = 4 }, .{ .nt = 4, .nw = 8 } };
+
+const dims = 2560;
+const streams = 4;
+const wide = streams * dims;
+const low = 320;
+const n_down = low + streams;
+const nc = dims / 256;
+const eps: f32 = 1e-6;
+const hc_per = 96;
+const hc_rows = [_]usize{ 1, 2, 4, 7, 10, 11, 15, 16, 17, 20, 28, 31, 32 };
+const floor_gbs = 215.0;
+
+const choices = blk: {
+    var c: [forced.len + 1]?qmmf.SmallTile = undefined;
+    c[0] = null;
+    for (forced, 1..) |f, i| c[i] = f;
+    break :blk c;
+};
+
+fn tobf(v: f32) u16 {
+    const b: u32 = @bitCast(v);
+    return @truncate((b + 0x7fff + ((b >> 16) & 1)) >> 16);
+}
+
+const Saved = struct {
+    lane_tile: bool,
+    lane_tile_wide: bool,
+    decode_gemm: bool,
+    dec_small: bool,
+    small_nt: usize,
+    small_warps: usize,
+    hcd_small: usize,
+
+    fn take() Saved {
+        return .{ .lane_tile = qmmf.lane_tile, .lane_tile_wide = qmmf.lane_tile_wide, .decode_gemm = qmmf.decode_gemm, .dec_small = qmmf.dec_small, .small_nt = qmmf.small_nt, .small_warps = qmmf.small_warps, .hcd_small = tk.hcd_small_warps };
+    }
+    fn restore(s: Saved) void {
+        qmmf.lane_tile = s.lane_tile;
+        qmmf.lane_tile_wide = s.lane_tile_wide;
+        qmmf.decode_gemm = s.decode_gemm;
+        qmmf.dec_small = s.dec_small;
+        qmmf.small_nt = s.small_nt;
+        qmmf.small_warps = s.small_warps;
+        tk.hcd_small_warps = s.hcd_small;
+    }
+    fn served() void {
+        qmmf.lane_tile = true;
+        qmmf.lane_tile_wide = false;
+        qmmf.decode_gemm = false;
+        qmmf.dec_small = false;
+        qmmf.small_nt = 0;
+        qmmf.small_warps = 0;
+    }
+};
+
+const Rig = struct {
+    lane: qmmf.Lane,
+    s: cuda.Stream,
+    dx: cuda.DeviceBuffer,
+    dy: cuda.DeviceBuffer,
+    dy2: cuda.DeviceBuffer,
+    part: cuda.DeviceBuffer,
+    x: []u16,
+    ldx: usize,
+
+    fn init(gpu: check.Gpu, rng: std.Random) !Rig {
+        const major = (try gpu.ctx.capability()) / 10;
+        const ldx = 6144 + 64;
+        const x = try t.activations(gpu, rng, qmmf.dec_rows, 6144, ldx);
+        errdefer gpu.gpa.free(x);
+        var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+        errdefer dx.free();
+        var dy = try cuda.DeviceBuffer.alloc(gpu.d, qmmf.dec_rows * 124160 * 4);
+        errdefer dy.free();
+        var dy2 = try cuda.DeviceBuffer.alloc(gpu.d, qmmf.dec_rows * gu_n * 4);
+        errdefer dy2.free();
+        var part = try cuda.DeviceBuffer.alloc(gpu.d, 8 * qmmf.dec_rows * 13952 * 4);
+        errdefer part.free();
+        var lane = try qmmf.Lane.load(gpu.d, major);
+        errdefer lane.unload();
+        const s = try cuda.Stream.init(gpu.d, false);
+        return .{ .lane = lane, .s = s, .dx = dx, .dy = dy, .dy2 = dy2, .part = part, .x = x, .ldx = ldx };
+    }
+
+    fn deinit(r: *Rig, a: std.mem.Allocator) void {
+        r.s.deinit();
+        r.lane.unload();
+        r.part.free();
+        r.dy2.free();
+        r.dy.free();
+        r.dx.free();
+        a.free(r.x);
+    }
+
+    fn call(r: *Rig, m: usize, w: qmmf.Weight, out: qmmf.Out) !void {
+        try r.lane.matmulOut(r.s, r.dx.ptr, r.ldx, m, w, r.dy.ptr, out, r.part.ptr);
+    }
+
+    fn two(r: *Rig, m: usize, g: qmmf.Weight, u: qmmf.Weight) !void {
+        try r.lane.matmulTwo(r.s, r.dx.ptr, r.ldx, m, g, r.dy.ptr, u, r.dy2.ptr, r.part.ptr);
+    }
+
+    fn result(r: *Rig, buf: cuda.DeviceBuffer, dst: []u8) !void {
+        try r.s.synchronize();
+        try buf.download(0, dst);
+    }
+};
+
+fn weightFor(h: t.Host, sh: Shape) !qmmf.Weight {
+    return if (sh.sk == 0) h.w else try qmmf.pinned(h.w, sh.sk);
+}
+
+fn outBytes(m: usize, n: usize, out: qmmf.Out) usize {
+    return m * n * @as(usize, if (out == .f32) 4 else 2);
+}
+
+fn forcedFits(m: usize, f: qmmf.SmallTile) bool {
+    return qmmf.smallIndex((m + 15) / 16, f.nt) != null;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    const saved = Saved.take();
+    defer saved.restore();
+    var prng = std.Random.DefaultPrng.init(0x5aa1_dec5);
+    const rng = prng.random();
+    var r = try Rig.init(gpu, rng);
+    defer r.deinit(gpu.gpa);
+    try check.expect(r.lane.clusters, "the small-row tile folds its slices in a cluster: sm_90 or later", .{});
+    const dense = try denseBytes(gpu, &r, rng);
+    const pairs = try pairBytes(gpu, &r, rng);
+    check.pass("TF_FLASHNEXT_DEC_SMALL: the small-row tile equals the served lane kernel (lane tile off and on) byte for byte at {d} launches over {d} shapes, 1-96 rows, bf16 and fp32, the pick and every forced (column tiles, warps); shared gate and up in one launch equal two matmul calls at {d} launches", .{ dense, shapes.len + edges.len, pairs });
+    const hc = try hcBytes(gpu, rng);
+    check.pass("TF_FLASHNEXT_DEC_SMALL: the 3- and 4-warp decode down equals fn_hcd_down (7 warps) byte for byte in every slice partial at {d} launches, {d} row counts from 1 to 32", .{ hc, hc_rows.len });
+}
+
+fn denseBytes(gpu: check.Gpu, r: *Rig, rng: std.Random) !usize {
+    const a = gpu.gpa;
+    var taken: usize = 0;
+    for (shapes ++ edges) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const w = try weightFor(h, sh);
+        const want = try a.alloc(u8, outBytes(qmmf.dec_rows, sh.n, sh.out));
+        defer a.free(want);
+        const got = try a.alloc(u8, outBytes(qmmf.dec_rows, sh.n, sh.out));
+        defer a.free(got);
+        for (rows_checked) |m| {
+            const bytes = outBytes(m, sh.n, sh.out);
+            try check.expect(r.lane.smallTakes(m, w), "{s}: {d} rows not on the small-row tile", .{ sh.name, m });
+            for ([_]bool{ false, true }) |lt| {
+                Saved.served();
+                qmmf.lane_tile = lt;
+                try r.dy.fill8(0xff, r.s.handle);
+                try r.call(m, w, sh.out);
+                try r.result(r.dy, want[0..bytes]);
+                qmmf.dec_small = true;
+                for (choices) |f| {
+                    if (f) |ff| if (!forcedFits(m, ff)) continue;
+                    qmmf.small_nt = if (f) |ff| ff.nt else 0;
+                    qmmf.small_warps = if (f) |ff| ff.nw else 0;
+                    try r.dy.fill8(0xa5, r.s.handle);
+                    try r.call(m, w, sh.out);
+                    try r.result(r.dy, got[0..bytes]);
+                    check.sameBytes("small-row tile against the served lane kernel", got[0..bytes], want[0..bytes]) catch |err| {
+                        std.debug.print("FAIL at {s} n {d} k {d} sk {d} rows {d} lane_tile {any} nt {d} warps {d}\n", .{ sh.name, sh.n, sh.k, qmmf.planFor(m, w, true).sk, m, lt, qmmf.small_nt, qmmf.small_warps });
+                        return err;
+                    };
+                    taken += 1;
+                }
+            }
+        }
+        try check.expect(!r.lane.smallTakes(qmmf.dec_rows + 1, w) or qmmf.planFor(qmmf.dec_rows + 1, w, true).fused, "{s}: 97 rows taken", .{sh.name});
+    }
+    return taken;
+}
+
+fn pairBytes(gpu: check.Gpu, r: *Rig, rng: std.Random) !usize {
+    const a = gpu.gpa;
+    var hg = try t.Host.init(gpu, rng, gu_n, gu_k);
+    defer hg.deinit(a);
+    var hu = try t.Host.init(gpu, rng, gu_n, gu_k);
+    defer hu.deinit(a);
+    hu.w.scale = 0.75;
+    const bytes_max = outBytes(qmmf.dec_rows, gu_n, .bf16);
+    const want = try a.alloc(u8, 2 * bytes_max);
+    defer a.free(want);
+    const got = try a.alloc(u8, 2 * bytes_max);
+    defer a.free(got);
+    var taken: usize = 0;
+    for (rows_checked) |m| {
+        const bytes = outBytes(m, gu_n, .bf16);
+        try check.expect(r.lane.smallPairTakes(m, hg.w, hu.w), "shared gate and up: {d} rows not on the pair launch", .{m});
+        for ([_]bool{ false, true }) |lt| {
+            Saved.served();
+            qmmf.lane_tile = lt;
+            try r.dy.fill8(0xff, r.s.handle);
+            try r.dy2.fill8(0xff, r.s.handle);
+            try r.two(m, hg.w, hu.w);
+            try r.result(r.dy, want[0..bytes]);
+            try r.result(r.dy2, want[bytes_max..][0..bytes]);
+            qmmf.dec_small = true;
+            for (choices) |f| {
+                if (f) |ff| if (!forcedFits(m, ff)) continue;
+                qmmf.small_nt = if (f) |ff| ff.nt else 0;
+                qmmf.small_warps = if (f) |ff| ff.nw else 0;
+                try r.dy.fill8(0xa5, r.s.handle);
+                try r.dy2.fill8(0xa5, r.s.handle);
+                try r.two(m, hg.w, hu.w);
+                try r.result(r.dy, got[0..bytes]);
+                try r.result(r.dy2, got[bytes_max..][0..bytes]);
+                inline for (.{ "gate", "up" }, 0..) |what, i| {
+                    check.sameBytes("pair launch against two matmul calls: " ++ what, got[i * bytes_max ..][0..bytes], want[i * bytes_max ..][0..bytes]) catch |err| {
+                        std.debug.print("FAIL at shared {s} rows {d} lane_tile {any} nt {d} warps {d}\n", .{ what, m, lt, qmmf.small_nt, qmmf.small_warps });
+                        return err;
+                    };
+                }
+                taken += 1;
+            }
+        }
+    }
+    return taken;
+}
+
+const Hc = struct {
+    t: tk.TileKernels,
+    s: cuda.Stream,
+    bufs: [6]cuda.DeviceBuffer,
+    h: u64,
+    pss: u64,
+    scale: u64,
+    down: u64,
+    part: u64,
+    down_bytes: usize,
+    copies: usize,
+
+    fn init(gpu: check.Gpu, rng: std.Random, copies: usize) !Hc {
+        const a = gpu.gpa;
+        var k = try tk.TileKernels.load(gpu.d);
+        errdefer k.unload();
+        const most = qmmf.dec_rows;
+        const hv = try a.alloc(u16, most * wide);
+        defer a.free(hv);
+        for (hv) |*v| v.* = tobf(@floatCast(rng.floatNorm(f64) * 3));
+        const pv = try a.alloc(f32, most * nc * streams);
+        defer a.free(pv);
+        for (pv) |*v| v.* = 1 + rng.float(f32) * 900;
+        const sv = try a.alloc(f32, wide);
+        defer a.free(sv);
+        for (sv) |*v| v.* = 0.5 + rng.float(f32);
+        const wv = try a.alloc(u16, n_down * wide);
+        defer a.free(wv);
+        for (wv) |*v| v.* = tobf(@floatCast(rng.floatNorm(f64) * 0.02));
+        const npad = cuda.nvfp4.padded(n_down);
+        const pd = try a.alloc(u16, npad * wide);
+        defer a.free(pd);
+        qmmf.packBf16(pd, wv, n_down, wide);
+        const down_bytes = npad * wide * 2;
+        var bufs: [6]cuda.DeviceBuffer = undefined;
+        bufs[0] = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(hv));
+        errdefer bufs[0].free();
+        bufs[1] = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(pv));
+        errdefer bufs[1].free();
+        bufs[2] = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(sv));
+        errdefer bufs[2].free();
+        bufs[3] = try cuda.DeviceBuffer.alloc(gpu.d, copies * down_bytes);
+        errdefer bufs[3].free();
+        for (0..copies) |c| try bufs[3].upload(c * down_bytes, std.mem.sliceAsBytes(pd));
+        bufs[4] = try cuda.DeviceBuffer.alloc(gpu.d, 8 * most * n_down * 4);
+        errdefer bufs[4].free();
+        bufs[5] = try cuda.DeviceBuffer.alloc(gpu.d, 16);
+        errdefer bufs[5].free();
+        const s = try cuda.Stream.init(gpu.d, false);
+        return .{ .t = k, .s = s, .bufs = bufs, .h = bufs[0].ptr, .pss = bufs[1].ptr, .scale = bufs[2].ptr, .down = bufs[3].ptr, .part = bufs[4].ptr, .down_bytes = down_bytes, .copies = copies };
+    }
+
+    fn deinit(c: *Hc) void {
+        c.s.deinit();
+        for (&c.bufs) |*b| b.free();
+        c.t.unload();
+    }
+
+    fn sk(m: usize) usize {
+        const w: qmmf.Weight = .{ .mode = .bf16, .codes = 0, .scales = 0, .n = n_down, .k = wide, .npad = 384 };
+        return qmmf.planFor(m, w, true).sk;
+    }
+
+    fn served(c: *Hc, m: usize, copy: usize) !void {
+        var ti: usize = tk.hcd_mt.len - 1;
+        for (tk.hcd_mt, 0..) |mt, i| if (16 * mt >= m) {
+            ti = i;
+            break;
+        };
+        try tk.hcdDown(&c.t, c.s, ti, c.h, c.pss, c.scale, c.down + (copy % c.copies) * c.down_bytes, c.part, m, n_down, wide, sk(m), dims, streams, eps);
+    }
+
+    fn small(c: *Hc, m: usize, warps: usize, copy: usize) !void {
+        const vi = tk.hcdsIndex(m, warps) orelse return error.RowShape;
+        try tk.hcdsDown(&c.t, c.s, vi, c.h, c.pss, c.scale, c.down + (copy % c.copies) * c.down_bytes, c.part, m, n_down, wide, sk(m), dims, streams, eps);
+    }
+
+    fn partBack(c: *Hc, m: usize, dst: []u8) !void {
+        try c.s.synchronize();
+        try c.bufs[4].download(0, dst[0 .. sk(m) * m * n_down * 4]);
+    }
+};
+
+fn hcBytes(gpu: check.Gpu, rng: std.Random) !usize {
+    const a = gpu.gpa;
+    var c = try Hc.init(gpu, rng, 1);
+    defer c.deinit();
+    const max_bytes = 8 * qmmf.dec_rows * n_down * 4;
+    const want = try a.alloc(u8, max_bytes);
+    defer a.free(want);
+    const got = try a.alloc(u8, max_bytes);
+    defer a.free(got);
+    var taken: usize = 0;
+    for (hc_rows) |m| {
+        const bytes = Hc.sk(m) * m * n_down * 4;
+        try c.bufs[4].fill8(0xff, c.s.handle);
+        try c.served(m, 0);
+        try c.partBack(m, want);
+        for ([_]usize{ 3, 4 }) |warps| {
+            try c.bufs[4].fill8(0xa5, c.s.handle);
+            try c.small(m, warps, 0);
+            try c.partBack(m, got);
+            check.sameBytes("small decode down against fn_hcd_down", got[0..bytes], want[0..bytes]) catch |err| {
+                std.debug.print("FAIL at hc down rows {d} warps {d}\n", .{ m, warps });
+                return err;
+            };
+            taken += 1;
+        }
+    }
+    try check.expect(tk.hcdsIndex(33, 3) == null and tk.hcdsIndex(33, 4) == null, "hc small down takes 33 rows", .{});
+    return taken;
+}
+
+const Cold = struct {
+    dw: cuda.DeviceBuffer,
+    ds: cuda.DeviceBuffer,
+    w: qmmf.Weight,
+    copies: usize,
+    code_bytes: usize,
+    scale_bytes: usize,
+
+    fn init(gpu: check.Gpu, r: *Rig, h: t.Host, w: qmmf.Weight) !Cold {
+        const code_bytes: usize = @as(usize, w.npad) * w.k;
+        const scale_bytes: usize = @as(usize, w.npad) * (w.k / 32);
+        const copies = @max(2, (160 << 20) / code_bytes);
+        var dw = try cuda.DeviceBuffer.alloc(gpu.d, copies * code_bytes);
+        errdefer dw.free();
+        var ds = try cuda.DeviceBuffer.alloc(gpu.d, copies * scale_bytes);
+        errdefer ds.free();
+        for (0..copies) |c| {
+            try dw.copyFrom(c * code_bytes, h.dw.ptr, code_bytes, r.s.handle);
+            try ds.copyFrom(c * scale_bytes, h.ds.ptr, scale_bytes, r.s.handle);
+        }
+        try r.s.synchronize();
+        return .{ .dw = dw, .ds = ds, .w = w, .copies = copies, .code_bytes = code_bytes, .scale_bytes = scale_bytes };
+    }
+
+    fn deinit(c: *Cold) void {
+        c.ds.free();
+        c.dw.free();
+    }
+
+    fn at(c: Cold, i: usize) qmmf.Weight {
+        var w = c.w;
+        w.codes = c.dw.ptr + (i % c.copies) * c.code_bytes;
+        w.scales = c.ds.ptr + (i % c.copies) * c.scale_bytes;
+        return w;
+    }
+};
+
+fn mustRead(n: usize, k: usize) f64 {
+    return @floatFromInt(n * k + n * (k / 32));
+}
+
+const Timer = struct {
+    t0: cuda.Event,
+    t1: cuda.Event,
+
+    fn us(tm: *Timer, s: cuda.Stream, reps: usize, ctx: anytype, comptime f: anytype) !f64 {
+        for (0..@min(reps, 8)) |i| try f(ctx, i);
+        try tm.t0.record(s);
+        for (0..reps) |i| try f(ctx, i);
+        try tm.t1.record(s);
+        try tm.t1.synchronize();
+        return @as(f64, try cuda.Event.elapsedMs(tm.t0, tm.t1)) * 1000 / @as(f64, @floatFromInt(reps));
+    }
+};
+
+const Round = struct {
+    served_ms: f64 = 0,
+    small_ms: f64 = 0,
+    best_ms: f64 = 0,
+    gb: f64 = 0,
+};
+
+pub fn bench(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const saved = Saved.take();
+    defer saved.restore();
+    var prng = std.Random.DefaultPrng.init(0xbe4c_5aa1);
+    const rng = prng.random();
+    var r = try Rig.init(gpu, rng);
+    defer r.deinit(a);
+    var tm: Timer = .{ .t0 = try cuda.Event.init(gpu.d, true), .t1 = try cuda.Event.init(gpu.d, true) };
+    defer tm.t0.deinit();
+    defer tm.t1.deinit();
+    var dense: [bench_rows.len]Round = @splat(.{});
+    var hc: [bench_rows.len]Round = @splat(.{});
+    for (shapes) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const w = try weightFor(h, sh);
+        var cold = try Cold.init(gpu, &r, h, w);
+        defer cold.deinit();
+        const bytes = mustRead(sh.n, sh.k);
+        for (bench_rows, 0..) |m, bi| {
+            const reps = @max(3 * cold.copies, 48);
+            const Ctx = struct {
+                r: *Rig,
+                c: *const Cold,
+                m: usize,
+                out: qmmf.Out,
+                fn f(x: @This(), i: usize) !void {
+                    try x.r.call(x.m, x.c.at(i), x.out);
+                }
+            };
+            const ctx: Ctx = .{ .r = &r, .c = &cold, .m = m, .out = sh.out };
+            Saved.served();
+            const served_us = try tm.us(r.s, reps, ctx, Ctx.f);
+            qmmf.dec_small = true;
+            const small_us = try tm.us(r.s, reps, ctx, Ctx.f);
+            const pick = qmmf.smallPick(sh.n, qmmf.planFor(m, w, true).sk, 1, (m + 15) / 16);
+            std.debug.print("RESULT decode-small {s} n {d} k {d} sk {d} rows {d} ({s}, {d:.2} MB): served {d:.1} us ({d:.0} GB/s, {d:.0}% of {d:.0}), small nt{d}w{d} {d:.1} us ({d:.0} GB/s)", .{ sh.name, sh.n, sh.k, qmmf.planFor(m, w, true).sk, m, bench_lanes[bi], bytes / 1e6, served_us, bytes / served_us / 1e3, bytes / served_us / 1e3 / floor_gbs * 100, floor_gbs, pick.nt, pick.nw, small_us, bytes / small_us / 1e3 });
+            var best = small_us;
+            for (forced) |f| {
+                if (!forcedFits(m, f)) continue;
+                qmmf.small_nt = f.nt;
+                qmmf.small_warps = f.nw;
+                const us = try tm.us(r.s, reps, ctx, Ctx.f);
+                best = @min(best, us);
+                std.debug.print(" nt{d}w{d} {d:.1}", .{ f.nt, f.nw, us });
+            }
+            std.debug.print("\n", .{});
+            dense[bi].served_ms += served_us * sh.per / 1000;
+            dense[bi].small_ms += small_us * sh.per / 1000;
+            dense[bi].best_ms += best * sh.per / 1000;
+            dense[bi].gb += bytes * sh.per / 1e9;
+        }
+    }
+    try benchPair(gpu, &r, rng, &tm, &dense);
+    try benchHc(gpu, rng, &tm, &hc);
+    for (bench_rows, 0..) |m, bi| {
+        const d = dense[bi];
+        const c = hc[bi];
+        const served = d.served_ms + c.served_ms;
+        const gb = d.gb + c.gb;
+        const pct = gb / served * 1000 / floor_gbs * 100;
+        std.debug.print("RESULT decode-small round rows {d} ({s}): dense served {d:.2} ms {d:.3} GB ({d:.0}% of {d:.0}), small {d:.2} ms, best forced {d:.2} ms; HC down+up served {d:.2} ms {d:.3} GB ({d:.0}%), small {d:.2} ms\n", .{ m, bench_lanes[bi], d.served_ms, d.gb, d.gb / d.served_ms * 1000 / floor_gbs * 100, floor_gbs, d.small_ms, d.best_ms, c.served_ms, c.gb, c.gb / c.served_ms * 1000 / floor_gbs * 100, c.small_ms });
+        std.debug.print("RESULT small-kill rows {d} ({s}): served dense+HC {d:.2} ms for {d:.3} GB = {d:.0} GB/s = {d:.0}% of {d:.0}: {s}\n", .{ m, bench_lanes[bi], served, gb, gb / served * 1000, pct, floor_gbs, if (pct >= 75) "AT FLOOR (>= 75%)" else "BELOW (< 75%)" });
+        std.debug.print("RESULT small-gain rows {d} ({s}): served {d:.2} ms, TF_FLASHNEXT_DEC_SMALL=1 {d:.2} ms, saved {d:.2} ms a round (best forced tiles {d:.2})\n", .{ m, bench_lanes[bi], served, d.small_ms + c.small_ms, served - d.small_ms - c.small_ms, served - d.best_ms - c.small_ms });
+    }
+}
+
+fn benchPair(gpu: check.Gpu, r: *Rig, rng: std.Random, tm: *Timer, dense: *[bench_rows.len]Round) !void {
+    const a = gpu.gpa;
+    var hg = try t.Host.init(gpu, rng, gu_n, gu_k);
+    defer hg.deinit(a);
+    var hu = try t.Host.init(gpu, rng, gu_n, gu_k);
+    defer hu.deinit(a);
+    var cg = try Cold.init(gpu, r, hg, hg.w);
+    defer cg.deinit();
+    var cu = try Cold.init(gpu, r, hu, hu.w);
+    defer cu.deinit();
+    const bytes = 2 * mustRead(gu_n, gu_k);
+    for (bench_rows, 0..) |m, bi| {
+        const reps = @max(3 * cg.copies, 48);
+        const Ctx = struct {
+            r: *Rig,
+            g: *const Cold,
+            u: *const Cold,
+            m: usize,
+            fn f(x: @This(), i: usize) !void {
+                try x.r.two(x.m, x.g.at(i), x.u.at(i));
+            }
+        };
+        const ctx: Ctx = .{ .r = r, .g = &cg, .u = &cu, .m = m };
+        Saved.served();
+        const served_us = try tm.us(r.s, reps, ctx, Ctx.f);
+        qmmf.dec_small = true;
+        const small_us = try tm.us(r.s, reps, ctx, Ctx.f);
+        const pick = qmmf.smallPick(gu_n, qmmf.planFor(m, hg.w, true).sk, 2, (m + 15) / 16);
+        std.debug.print("RESULT decode-small shared gate and up n {d} k {d} rows {d} ({s}, {d:.2} MB): served two calls {d:.1} us ({d:.0} GB/s), pair nt{d}w{d} {d:.1} us ({d:.0} GB/s)", .{ gu_n, gu_k, m, bench_lanes[bi], bytes / 1e6, served_us, bytes / served_us / 1e3, pick.nt, pick.nw, small_us, bytes / small_us / 1e3 });
+        var best = small_us;
+        for (forced) |f| {
+            if (!forcedFits(m, f)) continue;
+            qmmf.small_nt = f.nt;
+            qmmf.small_warps = f.nw;
+            const us = try tm.us(r.s, reps, ctx, Ctx.f);
+            best = @min(best, us);
+            std.debug.print(" nt{d}w{d} {d:.1}", .{ f.nt, f.nw, us });
+        }
+        std.debug.print("\n", .{});
+        dense[bi].served_ms += served_us * gu_per / 1000;
+        dense[bi].small_ms += small_us * gu_per / 1000;
+        dense[bi].best_ms += best * gu_per / 1000;
+        dense[bi].gb += bytes * gu_per / 1e9;
+    }
+}
+
+fn benchHc(gpu: check.Gpu, rng: std.Random, tm: *Timer, hc: *[bench_rows.len]Round) !void {
+    const copies = 24;
+    var c = try Hc.init(gpu, rng, copies);
+    defer c.deinit();
+    var up_codes = try cuda.DeviceBuffer.alloc(gpu.d, copies * wide * low * 2);
+    defer up_codes.free();
+    var act = try cuda.DeviceBuffer.alloc(gpu.d, qmmf.dec_rows * low * 2);
+    defer act.free();
+    try act.fill8(0x3c, c.s.handle);
+    try up_codes.fill8(0x3c, c.s.handle);
+    var mixed = try cuda.DeviceBuffer.alloc(gpu.d, qmmf.dec_rows * dims * 2);
+    defer mixed.free();
+    var xsm = try cuda.DeviceBuffer.alloc(gpu.d, qmmf.dec_rows * (dims / 32) * 4);
+    defer xsm.free();
+    const reps = 3 * copies;
+    for (bench_rows, 0..) |m, bi| {
+        const down_b: f64 = @floatFromInt(n_down * wide * 2 + m * wide * 2);
+        const up_b: f64 = @floatFromInt(wide * low * 2 + m * wide * 2 + m * low * 2 + m * dims * 2);
+        const Down = struct {
+            c: *Hc,
+            m: usize,
+            warps: usize,
+            fn f(x: @This(), i: usize) !void {
+                if (x.warps == 0) try x.c.served(x.m, i) else try x.c.small(x.m, x.warps, i);
+            }
+        };
+        const Up = struct {
+            c: *Hc,
+            m: usize,
+            codes: u64,
+            act: u64,
+            mixed: u64,
+            xsm: u64,
+            fn f(x: @This(), i: usize) !void {
+                var ui: usize = tk.hcd_mt.len - 1;
+                for (tk.hcd_mt, 0..) |mt, j| if (16 * mt >= x.m) {
+                    ui = j;
+                    break;
+                };
+                try tk.hcdUp(&x.c.t, x.c.s, ui, x.act, x.codes + (i % copies) * wide * low * 2, x.c.h, x.c.pss, x.c.scale, x.mixed, x.xsm, x.m, dims, eps);
+            }
+        };
+        const served_down = try tm.us(c.s, reps, Down{ .c = &c, .m = m, .warps = 0 }, Down.f);
+        const up_us = try tm.us(c.s, reps, Up{ .c = &c, .m = m, .codes = up_codes.ptr, .act = act.ptr, .mixed = mixed.ptr, .xsm = xsm.ptr }, Up.f);
+        var small_down = served_down;
+        std.debug.print("RESULT decode-small HC rows {d} ({s}): down served {d:.1} us ({d:.0} GB/s, {d:.0}%), up served {d:.1} us ({d:.0} GB/s, {d:.0}%)", .{ m, bench_lanes[bi], served_down, down_b / served_down / 1e3, down_b / served_down / 1e3 / floor_gbs * 100, up_us, up_b / up_us / 1e3, up_b / up_us / 1e3 / floor_gbs * 100 });
+        for ([_]usize{ 3, 4 }) |warps| {
+            if (tk.hcdsIndex(m, warps) == null) continue;
+            const us = try tm.us(c.s, reps, Down{ .c = &c, .m = m, .warps = warps }, Down.f);
+            if (warps == tk.hcd_small_warps_pick) small_down = us;
+            std.debug.print(" down {d} warps {d:.1} us ({d:.0} GB/s)", .{ warps, us, down_b / us / 1e3 });
+        }
+        std.debug.print("\n", .{});
+        hc[bi].served_ms += (served_down + up_us) * hc_per / 1000;
+        hc[bi].small_ms += (small_down + up_us) * hc_per / 1000;
+        hc[bi].gb += (down_b + up_b) * hc_per / 1e9;
+    }
+}
