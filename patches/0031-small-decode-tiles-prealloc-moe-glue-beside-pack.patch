+test "a packed row whose owner or peer dtype differs from its solo pass's is off by one bf16 rounding of a partial, never more" {
+    var prng = std.Random.DefaultPrng.init(0x3971);
+    const rnd = prng.random();
+    const any: Sums = .{ .scatter_bf16 = true, .exact = true, .any = true };
+    const shapes = [_][2]usize{ .{ 1600, 1472 }, .{ 1536, 1536 }, .{ 2048, 1024 }, .{ 736, 2304 } };
+    var moved: usize = 0;
+    for (shapes) |sh| {
+        const n = sh[0] + sh[1];
+        const pack_bf = seq_par.peerBf16(any.scatter_bf16, any.exact, true, sumRows(sh[0], sh[1]));
+        try std.testing.expect(pack_bf);
+        for (0..n) |r| {
+            const piece: usize = if (r < sh[0]) 0 else 1;
+            const solo_r = if (piece == 0) r else r - sh[0];
+            const p: [2]f32 = .{ (rnd.float(f32) - 0.5) * 64.0, (rnd.float(f32) - 0.5) * 64.0 };
+            const so = owner(sh[piece], solo_r);
+            const po = owner(n, r);
+            const solo_bf = !soloF32(any, sh[piece]);
+            const solo = sumAt(p, so, solo_bf);
+            const packed_sum = sumAt(p, po, pack_bf);
+            if (so == po and solo_bf == pack_bf) {
+                try std.testing.expectEqual(@as(u32, @bitCast(solo)), @as(u32, @bitCast(packed_sum)));
+                continue;
+            }
+            moved += 1;
+            const exact_sum = @as(f64, p[0]) + @as(f64, p[1]);
+            const bound = (@abs(@as(f64, p[0])) + @abs(@as(f64, p[1]))) * (1.0 / 256.0) + 1e-6;
+            try std.testing.expect(@abs(@as(f64, packed_sum) - exact_sum) <= bound);
+            try std.testing.expect(@abs(@as(f64, solo) - exact_sum) <= bound);
+        }
+    }
+    try std.testing.expect(moved > 0);
+}
