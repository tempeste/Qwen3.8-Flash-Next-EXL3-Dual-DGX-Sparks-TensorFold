--- /dev/null
+++ b/zig/src/families/flashnext/cuda_prompt_pool.zig
@@ -0,0 +1,444 @@
+const std = @import("std");
+const cuda = @import("cuda");
+
+const quiet = @import("builtin").is_test;
+const log = std.log.scoped(.flashnext);
+
+pub const granularity: u64 = 64 << 10;
+pub const chunk_bytes: u64 = 4 << 30;
+
+pub const Error = error{ PromptPoolOverRoom, PromptPoolOverMemory, PromptPoolAlloc, PromptPoolHook, OutOfMemory };
+
+pub fn planBytes(held: u64, cache: u64, most: ?u64) u64 {
+    const plan = held +| cache;
+    const want = if (most) |m| @min(plan, m) else plan;
+    return std.mem.alignForward(u64, want, granularity);
+}
+
+pub fn admit(bytes: u64, room: u64, available: ?u64, reserve: u64) Error!void {
+    if (bytes > room) return error.PromptPoolOverRoom;
+    if (available) |a| if (a < bytes +| reserve) return error.PromptPoolOverMemory;
+}
+
+pub fn chunkLens(bytes: u64, out: []u64) []u64 {
+    var left = std.mem.alignForward(u64, bytes, granularity);
+    var n: usize = 0;
+    while (left > 0 and n < out.len) : (n += 1) {
+        out[n] = @min(left, chunk_bytes);
+        left -= out[n];
+    }
+    return out[0..n];
+}
+
+pub const Ranges = struct {
+    free: std.ArrayList([2]u64) = .empty,
+    pending: std.ArrayList([2]u64) = .empty,
+
+    pub fn init(gpa: std.mem.Allocator, len: u64) !Ranges {
+        var r: Ranges = .{};
+        try r.free.append(gpa, .{ 0, len });
+        return r;
+    }
+
+    pub fn deinit(r: *Ranges, gpa: std.mem.Allocator) void {
+        r.free.deinit(gpa);
+        r.pending.deinit(gpa);
+    }
+
+    pub fn best(r: *const Ranges, n: u64) ?usize {
+        var pick: ?usize = null;
+        for (r.free.items, 0..) |f, i| {
+            if (f[1] < n) continue;
+            if (pick == null or f[1] < r.free.items[pick.?][1]) pick = i;
+        }
+        return pick;
+    }
+
+    pub fn takeAt(r: *Ranges, i: usize, n: u64) u64 {
+        const f = &r.free.items[i];
+        const off = f[0];
+        if (f[1] == n) {
+            _ = r.free.orderedRemove(i);
+        } else {
+            f[0] += n;
+            f[1] -= n;
+        }
+        return off;
+    }
+
+    pub fn take(r: *Ranges, n: u64) ?u64 {
+        const i = r.best(n) orelse return null;
+        return r.takeAt(i, n);
+    }
+
+    pub fn give(r: *Ranges, gpa: std.mem.Allocator, off: u64, n: u64) !void {
+        try r.pending.append(gpa, .{ off, n });
+    }
+
+    pub fn settle(r: *Ranges, gpa: std.mem.Allocator) !void {
+        while (r.pending.items.len > 0) {
+            const p = r.pending.items[r.pending.items.len - 1];
+            try r.insert(gpa, p[0], p[1]);
+            _ = r.pending.pop();
+        }
+    }
+
+    pub fn insert(r: *Ranges, gpa: std.mem.Allocator, off: u64, n: u64) !void {
+        var i: usize = 0;
+        while (i < r.free.items.len and r.free.items[i][0] < off) i += 1;
+        const joins_prev = i > 0 and r.free.items[i - 1][0] + r.free.items[i - 1][1] == off;
+        const joins_next = i < r.free.items.len and off + n == r.free.items[i][0];
+        if (joins_prev and joins_next) {
+            r.free.items[i - 1][1] += n + r.free.items[i][1];
+            _ = r.free.orderedRemove(i);
+        } else if (joins_prev) {
+            r.free.items[i - 1][1] += n;
+        } else if (joins_next) {
+            r.free.items[i][0] = off;
+            r.free.items[i][1] += n;
+        } else try r.free.insert(gpa, i, .{ off, n });
+    }
+
+    pub fn freeBytes(r: *const Ranges) u64 {
+        var t: u64 = 0;
+        for (r.free.items) |f| t += f[1];
+        return t;
+    }
+
+    pub fn pendingBytes(r: *const Ranges) u64 {
+        var t: u64 = 0;
+        for (r.pending.items) |f| t += f[1];
+        return t;
+    }
+};
+
+pub const Stats = struct { hits: u64 = 0, misses: u64 = 0, syncs: u64 = 0, failed_syncs: u64 = 0, live: u64 = 0, peak: u64 = 0 };
+
+pub const Chunk = struct { base: u64, len: u64, ranges: Ranges };
+
+pub const Region = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    chunks: std.ArrayList(Chunk) = .empty,
+    live: std.AutoHashMapUnmanaged(u64, u64) = .empty,
+    mutex: std.atomic.Mutex = .unlocked,
+    stats: Stats = .{},
+    total: u64 = 0,
+
+    fn lock(r: *Region) void {
+        while (!r.mutex.tryLock()) std.Thread.yield() catch {};
+    }
+
+    pub fn adopt(r: *Region, base: u64, len: u64) !void {
+        try r.chunks.ensureUnusedCapacity(r.gpa, 1);
+        r.chunks.appendAssumeCapacity(.{ .base = base, .len = len, .ranges = try Ranges.init(r.gpa, len) });
+        r.total += len;
+    }
+
+    fn takeAny(r: *Region, n: u64) ?u64 {
+        var pick: ?[2]usize = null;
+        for (r.chunks.items, 0..) |*c, ci| {
+            const i = c.ranges.best(n) orelse continue;
+            const len = c.ranges.free.items[i][1];
+            if (pick == null or len < r.chunks.items[pick.?[0]].ranges.free.items[pick.?[1]][1]) pick = .{ ci, i };
+        }
+        const p = pick orelse return null;
+        const c = &r.chunks.items[p[0]];
+        return c.base + c.ranges.takeAt(p[1], n);
+    }
+
+    fn pending(r: *const Region) bool {
+        for (r.chunks.items) |c| if (c.ranges.pending.items.len > 0) return true;
+        return false;
+    }
+
+    fn settleAll(r: *Region) bool {
+        if (r.d.api.cuCtxSynchronize() != cuda.abi.success) {
+            r.stats.failed_syncs += 1;
+            return false;
+        }
+        r.stats.syncs += 1;
+        for (r.chunks.items) |*c| c.ranges.settle(r.gpa) catch return false;
+        return true;
+    }
+
+    fn chunkOf(r: *Region, p: u64) ?*Chunk {
+        for (r.chunks.items) |*c| if (p >= c.base and p < c.base + c.len) return c;
+        return null;
+    }
+
+    pub fn alloc(r: *Region, len: usize) ?u64 {
+        if (len == 0) return null;
+        const n = std.mem.alignForward(u64, len, granularity);
+        r.lock();
+        defer r.mutex.unlock();
+        var p = r.takeAny(n);
+        if (p == null and r.pending() and r.settleAll()) p = r.takeAny(n);
+        const got = p orelse {
+            r.missed(n);
+            return null;
+        };
+        r.live.put(r.gpa, got, n) catch {
+            const c = r.chunkOf(got).?;
+            c.ranges.insert(r.gpa, got - c.base, n) catch {};
+            r.missed(n);
+            return null;
+        };
+        r.stats.hits += 1;
+        r.stats.live += n;
+        r.stats.peak = @max(r.stats.peak, r.stats.live);
+        return got;
+    }
+
+    fn missed(r: *Region, n: u64) void {
+        r.stats.misses += 1;
+        if (quiet or !std.math.isPowerOfTwo(r.stats.misses)) return;
+        var spare: u64 = 0;
+        var parts: usize = 0;
+        for (r.chunks.items) |c| {
+            spare += c.ranges.freeBytes() + c.ranges.pendingBytes();
+            parts += c.ranges.free.items.len;
+        }
+        log.warn("prompt pool: a {d} MiB buffer past its free ranges ({d} MiB free or pending in {d} ranges, {d} MiB live of {d} MiB): cuMemAlloc, miss {d} of {d} buffers", .{ n >> 20, spare >> 20, parts, r.stats.live >> 20, r.total >> 20, r.stats.misses, r.stats.misses + r.stats.hits });
+    }
+
+    pub fn free(r: *Region, p: u64) bool {
+        r.lock();
+        defer r.mutex.unlock();
+        const e = r.live.fetchRemove(p) orelse return false;
+        r.stats.live -= e.value;
+        const c = r.chunkOf(p).?;
+        c.ranges.give(r.gpa, p - c.base, e.value) catch {};
+        return true;
+    }
+
+    fn hookAlloc(ctx: *anyopaque, len: usize) ?u64 {
+        const r: *Region = @ptrCast(@alignCast(ctx));
+        return r.alloc(len);
+    }
+
+    fn hookFree(ctx: *anyopaque, p: u64) bool {
+        const r: *Region = @ptrCast(@alignCast(ctx));
+        return r.free(p);
+    }
+
+    pub fn hook(r: *Region) cuda.memory.Hook {
+        return .{ .ctx = r, .alloc = hookAlloc, .free = hookFree };
+    }
+
+    pub fn deinitHost(r: *Region) void {
+        for (r.chunks.items) |*c| c.ranges.deinit(r.gpa);
+        r.chunks.deinit(r.gpa);
+        r.live.deinit(r.gpa);
+    }
+};
+
+var installed: ?*Region = null;
+
+pub fn current() ?*Region {
+    return installed;
+}
+
+pub fn install(gpa: std.mem.Allocator, d: *const cuda.Driver, bytes: u64) Error!*Region {
+    if (installed) |r| return r;
+    if (cuda.memory.currentHook() != null) return error.PromptPoolHook;
+    const r = try gpa.create(Region);
+    r.* = .{ .gpa = gpa, .d = d };
+    var lens_buf: [1024]u64 = undefined;
+    const lens = chunkLens(bytes, &lens_buf);
+    errdefer {
+        for (r.chunks.items) |c| _ = d.api.cuMemFree_v2(c.base);
+        r.deinitHost();
+        gpa.destroy(r);
+    }
+    for (lens) |len| {
+        var p: cuda.abi.DevicePtr = 0;
+        if (d.api.cuMemAlloc_v2(&p, len) != cuda.abi.success) return error.PromptPoolAlloc;
+        r.adopt(p, len) catch |e| {
+            _ = d.api.cuMemFree_v2(p);
+            return e;
+        };
+        if (d.api.cuMemsetD8_v2(p, 0, len) != cuda.abi.success) return error.PromptPoolAlloc;
+    }
+    if (r.total < bytes) return error.PromptPoolAlloc;
+    cuda.memory.setHook(r.hook());
+    installed = r;
+    return r;
+}
+
+pub fn uninstallForTest(r: *Region) void {
+    if (cuda.memory.currentHook()) |h| if (h.ctx == @as(*anyopaque, @ptrCast(r))) cuda.memory.setHook(null);
+    if (installed == r) installed = null;
+}
+
+test "prompt pool: the plan is the streams' charge and the cache's budget, bounded, on the granularity" {
+    const t = std.testing;
+    try t.expectEqual(@as(u64, 70 << 30), planBytes(40 << 30, 30 << 30, null));
+    try t.expectEqual(@as(u64, 24 << 30), planBytes(40 << 30, 30 << 30, 24 << 30));
+    try t.expectEqual(@as(u64, 128 << 10), planBytes(65 << 10, 1, null));
+    try admit(70 << 30, 74 << 30, 80 << 30, 3 << 30);
+    try t.expectError(error.PromptPoolOverRoom, admit(75 << 30, 74 << 30, null, 3 << 30));
+    try t.expectError(error.PromptPoolOverMemory, admit(70 << 30, 74 << 30, 72 << 30, 3 << 30));
+    var buf: [8]u64 = undefined;
+    const lens = chunkLens((9 << 30) + 1, &buf);
+    try t.expectEqual(@as(usize, 3), lens.len);
+    try t.expectEqual(chunk_bytes, lens[0]);
+    try t.expectEqual(granularity + (1 << 30), lens[2]);
+}
+
+test "prompt pool: best fit, splits, and a freed range waits for a settle before it merges with its neighbours" {
+    const t = std.testing;
+    const gpa = t.allocator;
+    var r = try Ranges.init(gpa, 100);
+    defer r.deinit(gpa);
+    try t.expectEqual(@as(?u64, 0), r.take(30));
+    try t.expectEqual(@as(?u64, 30), r.take(20));
+    try t.expectEqual(@as(?u64, 50), r.take(40));
+    try t.expectEqual(@as(?u64, null), r.take(11));
+    try r.give(gpa, 0, 30);
+    try r.give(gpa, 50, 40);
+    try t.expectEqual(@as(?u64, null), r.take(25));
+    try t.expectEqual(@as(u64, 70), r.pendingBytes());
+    try r.settle(gpa);
+    try t.expectEqual(@as(u64, 0), r.pendingBytes());
+    try t.expectEqual(@as(u64, 80), r.freeBytes());
+    try t.expectEqual(@as(usize, 2), r.free.items.len);
+    try t.expectEqual(@as(?u64, 0), r.take(25));
+    try r.give(gpa, 30, 20);
+    try r.give(gpa, 0, 25);
+    try r.settle(gpa);
+    try t.expectEqual(@as(usize, 1), r.free.items.len);
+    try t.expectEqual([2]u64{ 0, 100 }, r.free.items[0]);
+}
+
+test "prompt pool: a long churn of mixed sizes coalesces back to one range" {
+    const t = std.testing;
+    const gpa = t.allocator;
+    var r = try Ranges.init(gpa, 1 << 20);
+    defer r.deinit(gpa);
+    var prng = std.Random.DefaultPrng.init(7);
+    const rand = prng.random();
+    var held: std.ArrayList([2]u64) = .empty;
+    defer held.deinit(gpa);
+    for (0..4000) |_| {
+        if (held.items.len > 0 and rand.boolean()) {
+            const i = rand.uintLessThan(usize, held.items.len);
+            const h = held.swapRemove(i);
+            try r.give(gpa, h[0], h[1]);
+            if (rand.uintLessThan(u8, 4) == 0) try r.settle(gpa);
+        } else {
+            const n = (rand.uintLessThan(u64, 64) + 1) << 10;
+            if (r.take(n)) |off| try held.append(gpa, .{ off, n });
+        }
+        var sum: u64 = r.freeBytes() + r.pendingBytes();
+        for (held.items) |h| sum += h[1];
+        try t.expectEqual(@as(u64, 1 << 20), sum);
+        for (r.free.items[1..], 0..) |f, i| try t.expect(r.free.items[i][0] + r.free.items[i][1] < f[0]);
+    }
+    for (held.items) |h| try r.give(gpa, h[0], h[1]);
+    try r.settle(gpa);
+    try t.expectEqual(@as(usize, 1), r.free.items.len);
+    try t.expectEqual([2]u64{ 0, 1 << 20 }, r.free.items[0]);
+}
+
+const Fake = struct {
+    var next: cuda.abi.DevicePtr = 0x1_0000_0000;
+    var allocs: u32 = 0;
+    var frees: u32 = 0;
+    var syncs: u32 = 0;
+    var sets: u64 = 0;
+    fn alloc(p: *cuda.abi.DevicePtr, len: usize) callconv(.c) cuda.abi.Result {
+        p.* = next;
+        next += std.mem.alignForward(u64, len, 2 << 20);
+        allocs += 1;
+        return cuda.abi.success;
+    }
+    fn free(_: cuda.abi.DevicePtr) callconv(.c) cuda.abi.Result {
+        frees += 1;
+        return cuda.abi.success;
+    }
+    fn sync() callconv(.c) cuda.abi.Result {
+        syncs += 1;
+        return cuda.abi.success;
+    }
+    fn set(_: cuda.abi.DevicePtr, _: u8, n: usize) callconv(.c) cuda.abi.Result {
+        sets += n;
+        return cuda.abi.success;
+    }
+    fn driver() cuda.Driver {
+        var d: cuda.Driver = .{ .lib = undefined, .api = undefined };
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuCtxSynchronize = sync;
+        d.api.cuMemsetD8_v2 = set;
+        return d;
+    }
+};
+
+test "prompt pool: under DeviceBuffer.alloc a buffer comes from the region, a freed one only after a synchronize, past it cuMemAlloc" {
+    const t = std.testing;
+    var d = Fake.driver();
+    Fake.allocs = 0;
+    Fake.frees = 0;
+    Fake.syncs = 0;
+    Fake.sets = 0;
+    const r = try install(t.allocator, &d, 3 << 20);
+    defer {
+        uninstallForTest(r);
+        r.deinitHost();
+        t.allocator.destroy(r);
+    }
+    try t.expectEqual(@as(u32, 1), Fake.allocs);
+    try t.expectEqual(@as(u64, 3 << 20), Fake.sets);
+    const base = r.chunks.items[0].base;
+    var a = try cuda.DeviceBuffer.alloc(&d, 1 << 20);
+    var b = try cuda.DeviceBuffer.alloc(&d, (2 << 20) - 1);
+    try t.expectEqual(base, a.ptr);
+    try t.expectEqual(base + (1 << 20), b.ptr);
+    try t.expectEqual(@as(u32, 1), Fake.allocs);
+    var c = try cuda.DeviceBuffer.alloc(&d, 1 << 20);
+    try t.expectEqual(@as(u32, 2), Fake.allocs);
+    try t.expectEqual(@as(u64, 1), r.stats.misses);
+    a.free();
+    try t.expectEqual(@as(u32, 0), Fake.frees);
+    try t.expectEqual(@as(u32, 0), Fake.syncs);
+    var e = try cuda.DeviceBuffer.alloc(&d, 512 << 10);
+    try t.expectEqual(@as(u32, 1), Fake.syncs);
+    try t.expectEqual(base, e.ptr);
+    var f = try cuda.DeviceBuffer.alloc(&d, 512 << 10);
+    try t.expectEqual(base + (512 << 10), f.ptr);
+    try t.expectEqual(@as(u32, 1), Fake.syncs);
+    c.free();
+    try t.expectEqual(@as(u32, 1), Fake.frees);
+    b.free();
+    e.free();
+    f.free();
+    try t.expectEqual(@as(u64, 0), r.stats.live);
+    var whole = try cuda.DeviceBuffer.alloc(&d, 3 << 20);
+    try t.expectEqual(base, whole.ptr);
+    try t.expectEqual(@as(u32, 2), Fake.syncs);
+    whole.free();
+    try t.expectEqual(@as(u32, 2), Fake.allocs);
+    try t.expectEqual(r, try install(t.allocator, &d, 3 << 20));
+    try t.expectEqual(@as(u32, 2), Fake.allocs);
+}
+
+test "prompt pool: a failed chunk frees the ones before it and installs nothing" {
+    const t = std.testing;
+    const Bad = struct {
+        var n: u32 = 0;
+        fn alloc(p: *cuda.abi.DevicePtr, _: usize) callconv(.c) cuda.abi.Result {
+            n += 1;
+            if (n > 1) return 2;
+            p.* = 0x2_0000_0000;
+            return cuda.abi.success;
+        }
+    };
+    var d = Fake.driver();
+    d.api.cuMemAlloc_v2 = Bad.alloc;
+    Fake.frees = 0;
+    try t.expectError(error.PromptPoolAlloc, install(t.allocator, &d, chunk_bytes + 1));
+    try t.expectEqual(@as(u32, 1), Fake.frees);
+    try t.expectEqual(@as(?*Region, null), current());
+    try t.expect(cuda.memory.currentHook() == null);
+}
