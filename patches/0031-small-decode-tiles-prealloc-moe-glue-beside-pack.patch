+    try std.testing.expect(ctx.held == null);
+    var idle: Ctx = .{ .held = null };
+    var empty: std.AutoHashMapUnmanaged(u32, Lane) = .empty;
+    closeAll(a, &empty, &idle);
+    try std.testing.expect(idle.joins == 0 and idle.drops == 0);
+}
