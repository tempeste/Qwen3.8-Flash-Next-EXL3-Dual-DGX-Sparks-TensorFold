+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const table_tests = @import("flashnext_mixed_table_tests.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+const Windows = table_tests.Windows;
+
+const window_context = 4096;
+const windows = 16;
+const window_rows = 2;
+const check_rounds = 3;
+const next_rows = 64;
+const pack_knob = "TF_FLASHNEXT_MIXED_BESIDE_PACK";
+
+const Shape = struct { a: usize, b: usize, a_at: usize, b_at: usize, b_last: bool };
+
+const relaxed_shapes = [_]Shape{
+    .{ .a = 1600, .b = 1472, .a_at = 0, .b_at = 2048, .b_last = false },
+    .{ .a = 1536, .b = 1536, .a_at = 4096, .b_at = 0, .b_last = true },
+    .{ .a = 2048, .b = 1024, .a_at = 700, .b_at = 3000, .b_last = true },
+};
+const relaxed_kl_most: f64 = 0.5;
+
+const shapes = [_]Shape{
+    .{ .a = 736, .b = 1003, .a_at = 0, .b_at = 0, .b_last = false },
+    .{ .a = 1040, .b = 1163, .a_at = 4096, .b_at = 1536, .b_last = false },
+    .{ .a = 1472, .b = 1408, .a_at = 2944, .b_at = 0, .b_last = true },
+    .{ .a = 512, .b = 1535, .a_at = 700, .b_at = 3000, .b_last = true },
+};
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+    out: u64,
+    streams: [2]cuda.DeviceBuffer,
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_MIXED_BESIDE", "1", 1);
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    if ((try flash.knobs.mixedBesidePack()) == 0) {
+        var buf: [16]u8 = undefined;
+        const text = try std.fmt.bufPrint(buf[0 .. buf.len - 1], "{d}", .{chunk / 64 * 64});
+        buf[text.len] = 0;
+        _ = env.setenv(pack_knob, buf[0..text.len :0], 1);
+    }
+    const cap = try flash.knobs.mixedBesidePack();
+    const sums = try flash.beside_pack.sumsNow();
+    var stream = try cuda.Stream.initPriority(gpu.d, .highest);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const context = window_context + 8192;
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk or cap > chunk) return error.RankIdentity;
+    e.beside = try flash.beside.Beside.init(e, chunk, context);
+    std.debug.print("flashnext-beside-pack rank {d}: a beside pass of up to {d} rows takes two pieces (cap {d}); split sums from {d} rows, seqpar from {d}, scatter bf16 {s}, seqpar exact {s}\n", .{ rank, chunk, cap, try flash.knobs.splitSumMinRows(), try flash.knobs.tpSeqParMinRows(), onWord(sums.scatter_bf16), onWord(sums.exact) });
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, windows * window_rows * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed solo and packed beside passes", .{});
+        return;
+    }
+    var streams: [2]cuda.DeviceBuffer = undefined;
+    streams[0] = try cuda.DeviceBuffer.alloc(e.driver, chunk * prompt.hidden_wide * 2);
+    defer streams[0].free();
+    streams[1] = try cuda.DeviceBuffer.alloc(e.driver, chunk * prompt.hidden_wide * 2);
+    defer streams[1].free();
+    const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items, .out = logits.ptr, .streams = streams };
+    var ran: usize = 0;
+    for (shapes) |sh| {
+        if (!flash.beside_pack.takes(cap, 1, sums, sh.a, sh.b)) {
+            std.debug.print("beside pack: {d} + {d} rows do not pack under these flags (cap {d}); skipped\n", .{ sh.a, sh.b, cap });
+            continue;
+        }
+        try compare(rig, sh, false);
+        ran += 1;
+        check.pass("beside pack: {d} rows at {d} and {d} rows at {d}{s} in one beside pass beside {d} rounds of {d} windows: each sequence's caches, DeltaNet states and conv windows, hidden streams, first-token scores and next pass equal its solo beside pass, and every round's scores equal", .{ sh.a, sh.a_at, sh.b, sh.b_at, if (sh.b_last) " (the second its prompt's last)" else "", check_rounds, windows });
+    }
+    if (sums.any) for (relaxed_shapes) |sh| {
+        if (!flash.beside_pack.takes(cap, 1, sums, sh.a, sh.b) or sh.a + sh.b > chunk) {
+            std.debug.print("beside pack any: {d} + {d} rows do not pack under these flags (cap {d}); skipped\n", .{ sh.a, sh.b, cap });
+            continue;
+        }
+        try compare(rig, sh, true);
+        ran += 1;
+        check.pass("beside pack any: {d} rows at {d} and {d} rows at {d}{s} in one beside pass beside {d} rounds of {d} windows: every round's scores equal the solo passes', each sequence's next pass and first-token scores within KL {d} of its solo beside pass, all finite", .{ sh.a, sh.a_at, sh.b, sh.b_at, if (sh.b_last) " (the second its prompt's last)" else "", check_rounds, windows, relaxed_kl_most });
+    };
+    if (ran == 0) {
+        std.debug.print("FAIL flashnext-beside-pack ran no shape: the flags pack none of them\n", .{});
+        return error.TestFailed;
+    }
+}
+
+fn onWord(v: bool) []const u8 {
+    return if (v) "on" else "off";
+}
+
+const Way = enum { solo, pack };
+
+const Got = struct {
+    rounds: std.ArrayList(u8) = .empty,
+    seqs: [2]std.ArrayList(u8) = .{ .empty, .empty },
+
+    fn deinit(g: *Got, gpa: std.mem.Allocator) void {
+        g.rounds.deinit(gpa);
+        for (&g.seqs) |*x| x.deinit(gpa);
+    }
+};
+
+fn zeroSeq(r: Rig, q: *prompt.Seq) !void {
+    const d = r.e.driver;
+    for ([_][]cuda.DeviceBuffer{ q.conv, q.state, q.kc, q.vc, q.ikc, q.pooled }) |bufs| for (bufs) |b| {
+        if (b.ptr != 0 and b.len > 0) try d.check(d.api.cuMemsetD8_v2(b.ptr, 0, b.len), "cuMemsetD8");
+    };
+    if (q.tail.ptr != 0 and q.tail.len > 0) try d.check(d.api.cuMemsetD8_v2(q.tail.ptr, 0, q.tail.len), "cuMemsetD8");
+}
+
+fn dumpSeq(r: Rig, q: *prompt.Seq, out: *std.ArrayList(u8)) !void {
+    const d = r.e.driver;
+    try r.stream.synchronize();
+    for ([_][]cuda.DeviceBuffer{ q.conv, q.state, q.kc, q.vc, q.ikc, q.pooled }) |bufs| for (bufs) |b| {
+        if (b.ptr == 0 or b.len == 0) continue;
+        const at = out.items.len;
+        try out.resize(r.gpu.gpa, at + b.len);
+        try d.check(d.api.cuMemcpyDtoH_v2(out.items[at..].ptr, b.ptr, b.len), "cuMemcpyDtoH");
+    };
+    if (q.tail.ptr != 0 and q.tail.len > 0) {
+        const at = out.items.len;
+        try out.resize(r.gpu.gpa, at + q.tail.len);
+        try d.check(d.api.cuMemcpyDtoH_v2(out.items[at..].ptr, q.tail.ptr, q.tail.len), "cuMemcpyDtoH");
+    }
+    try out.appendSlice(r.gpu.gpa, std.mem.asBytes(&q.history));
+    try out.appendSlice(r.gpu.gpa, std.mem.asBytes(&q.fed));
+}
+
+fn rounds(r: Rig, w: *Windows, got: *Got) !void {
+    const nr = windows * window_rows * prompt.vocabulary * 2;
+    for (0..check_rounds) |_| {
+        try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..windows], w.ds[0..windows], w.idss[0..windows], r.out);
+        try r.stream.synchronize();
+        const at = got.rounds.items.len;
+        try got.rounds.resize(r.gpu.gpa, at + nr);
+        try r.e.driver.check(r.e.driver.api.cuMemcpyDtoH_v2(got.rounds.items[at..].ptr, r.out, nr), "cuMemcpyDtoH");
+        try w.keepAll(r.session, r.tri);
+    }
+}
+
+fn idsAt(r: Rig, out: []u32, salt: usize) void {
+    for (out, 0..) |*v, i| v.* = r.seed[(i * 13 + salt * 7 + 5) % r.seed.len];
+}
+
+fn bf16At(bytes: []const u8, i: usize) f64 {
+    const u: u32 = @as(u32, std.mem.readInt(u16, bytes[i * 2 ..][0..2], .little)) << 16;
+    return @as(f32, @bitCast(u));
+}
+
+const RowKl = struct { kl: f64, same_top: bool, finite: bool };
+
+fn rowKl(want: []const u8, got: []const u8) RowKl {
+    const n = want.len / 2;
+    var mw: f64 = -std.math.inf(f64);
+    var mg: f64 = -std.math.inf(f64);
+    var tw: usize = 0;
+    var tg: usize = 0;
+    var finite = true;
+    for (0..n) |i| {
+        const a = bf16At(want, i);
+        const b = bf16At(got, i);
+        if (!std.math.isFinite(a) or !std.math.isFinite(b)) finite = false;
+        if (a > mw) {
+            mw = a;
+            tw = i;
+        }
+        if (b > mg) {
+            mg = b;
+            tg = i;
+        }
+    }
+    if (!finite) return .{ .kl = std.math.inf(f64), .same_top = false, .finite = false };
+    var zw: f64 = 0;
+    var zg: f64 = 0;
+    for (0..n) |i| {
+        zw += @exp(bf16At(want, i) - mw);
+        zg += @exp(bf16At(got, i) - mg);
+    }
+    const lw = @log(zw);
+    const lg = @log(zg);
+    var kl: f64 = 0;
+    for (0..n) |i| {
+        const a = bf16At(want, i) - mw - lw;
+        const b = bf16At(got, i) - mg - lg;
+        kl += @exp(a) * (a - b);
+    }
+    return .{ .kl = @max(kl, 0), .same_top = tw == tg, .finite = true };
+}
+
+fn relaxedRows(what: []const u8, want: []const u8, got: []const u8) !void {
+    if (want.len != got.len) {
+        std.debug.print("FAIL beside pack any: {s}: {d} bytes against {d}\n", .{ what, got.len, want.len });
+        return error.TestFailed;
+    }
+    const k = rowKl(want, got);
+    std.debug.print("beside pack any: {s}: KL(solo||packed) {e:.3} top-1 {s} finite {s}\n", .{ what, k.kl, if (k.same_top) "same" else "differs", if (k.finite) "yes" else "no" });
+    if (!k.finite or k.kl > relaxed_kl_most) {
+        std.debug.print("FAIL beside pack any: {s}: KL {e:.3} above {d} or not finite\n", .{ what, k.kl, relaxed_kl_most });
+        return error.TestFailed;
+    }
+}
+
+fn compare(r: Rig, sh: Shape, relaxed: bool) !void {
+    const gpa = r.gpu.gpa;
+    const row = prompt.vocabulary * 2;
+    var got: [2]Got = .{ .{}, .{} };
+    defer for (&got) |*g| g.deinit(gpa);
+    const ids_a = try gpa.alloc(u32, sh.a_at + sh.a + next_rows);
+    defer gpa.free(ids_a);
+    const ids_b = try gpa.alloc(u32, sh.b_at + sh.b + next_rows);
+    defer gpa.free(ids_b);
+    idsAt(r, ids_a, 1);
+    idsAt(r, ids_b, 2);
+    for (&got, [_]Way{ .solo, .pack }) |*g, way| {
+        var w: Windows = .{ .rows = window_rows };
+        try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, windows);
+        defer w.deinit(r.session);
+        var pa = try r.session.create(sh.a_at + sh.a + next_rows);
+        defer r.session.drop(&pa);
+        var pb = try r.session.create(sh.b_at + sh.b + next_rows);
+        defer r.session.drop(&pb);
+        try zeroSeq(r, &pa);
+        try zeroSeq(r, &pb);
+        if (sh.a_at > 0) try r.session.forward(flash.Tri, r.tri, &pa, ids_a[0..sh.a_at], .{ .prompt = true });
+        if (sh.b_at > 0) try r.session.forward(flash.Tri, r.tri, &pb, ids_b[0..sh.b_at], .{ .prompt = true });
+        try r.stream.synchronize();
+        const a: flash.beside.Piece = .{ .seq = &pa, .ids = ids_a[sh.a_at..][0..sh.a], .streams = r.streams[0].ptr };
+        const b: flash.beside.Piece = .{ .seq = &pb, .ids = ids_b[sh.b_at..][0..sh.b], .streams = r.streams[1].ptr, .last = sh.b_last };
+        switch (way) {
+            .solo => {
+                try r.session.besideStart(flash.Tri, r.tri, a);
+                try rounds(r, &w, g);
+                try r.session.besideJoin();
+                try r.session.besideStart(flash.Tri, r.tri, b);
+                try rounds(r, &w, g);
+                try r.session.besideJoin();
+            },
+            .pack => {
+                try r.session.besideStartPack(flash.Tri, r.tri, a, b);
+                try rounds(r, &w, g);
+                try r.session.besideJoin();
+                try rounds(r, &w, g);
+            },
+        }
+        try r.stream.synchronize();
+        if (pa.fed != sh.a_at + sh.a or pb.fed != sh.b_at + sh.b) return error.TestFailed;
+        for ([_]*prompt.Seq{ &pa, &pb }, r.streams, &g.seqs, [_]usize{ sh.a, sh.b }) |q, st, *out, n| {
+            const at = out.items.len;
+            try out.resize(gpa, at + n * prompt.hidden_wide * 2);
+            try r.e.driver.check(r.e.driver.api.cuMemcpyDtoH_v2(out.items[at..].ptr, st.ptr, n * prompt.hidden_wide * 2), "cuMemcpyDtoH");
+            try dumpSeq(r, q, out);
+        }
+        if (sh.b_last) try g.seqs[1].appendSlice(gpa, pb.logits[0..row]);
+        for ([_]*prompt.Seq{ &pa, &pb }, [_][]const u32{ ids_a[sh.a_at + sh.a ..], ids_b[sh.b_at + sh.b ..] }, &g.seqs) |q, next, *out| {
+            try r.session.forward(flash.Tri, r.tri, q, next[0..next_rows], .{ .logits = .last, .prompt = true });
+            try r.stream.synchronize();
+            try out.appendSlice(gpa, q.logits[0..row]);
+        }
+    }
+    std.debug.print("beside pack against solo: {d} rows at {d} and {d} rows at {d}{s}, {d} windows of {d} rows, {d} rounds a piece\n", .{ sh.a, sh.a_at, sh.b, sh.b_at, if (sh.b_last) ", the second last" else "", windows, window_rows, check_rounds });
+    if (relaxed) {
+        try check.sameBytes("every decode round's scores beside the packed pass equal the rounds beside the solo passes", got[1].rounds.items, got[0].rounds.items);
+        for (got[0].seqs, got[1].seqs, [_][]const u8{ "the first piece's next pass", "the second piece's next pass" }) |want, have, what| {
+            if (want.items.len != have.items.len or want.items.len < row) return error.TestFailed;
+            try relaxedRows(what, want.items[want.items.len - row ..], have.items[have.items.len - row ..]);
+        }
+        if (sh.b_last) {
+            const want = got[0].seqs[1].items;
+            const have = got[1].seqs[1].items;
+            try relaxedRows("the second piece's first token", want[want.len - 2 * row ..][0..row], have[have.len - 2 * row ..][0..row]);
+        }
+        return;
+    }
+    try check.sameBytes("the first piece's hidden streams, caches, DeltaNet states, conv and PLE windows, history and next pass's scores equal its solo beside pass", got[1].seqs[0].items, got[0].seqs[0].items);
+    try check.sameBytes("the second piece's hidden streams, caches, DeltaNet states, conv and PLE windows, history, first-token scores and next pass's scores equal its solo beside pass", got[1].seqs[1].items, got[0].seqs[1].items);
+    try check.sameBytes("every decode round's scores beside the packed pass equal the rounds beside the solo passes", got[1].rounds.items, got[0].rounds.items);
+}
