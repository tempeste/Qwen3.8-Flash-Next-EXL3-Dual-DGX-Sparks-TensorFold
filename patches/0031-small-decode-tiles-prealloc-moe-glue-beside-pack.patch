+__device__ __forceinline__ int own_id(int p, int first, int local, int stride) {
+    if (stride == 1) return p >= first && p < first + local ? p - first : local;
+    const int q = (p - first) / stride;
+    return p >= first && (p - first) % stride == 0 && q < local ? q : local;
