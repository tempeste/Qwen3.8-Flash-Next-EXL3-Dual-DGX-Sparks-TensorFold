index 0000000000000000000000000000000000000000..e093050693b61a2a4ca67ea6c5439f443f80cf42
--- /dev/null
+++ b/zig/tests/cuda/flashnext_pshare_ride_cuts.zig
@@ -0,0 +1,39 @@
+const std = @import("std");
+
+pub const Seen = enum { same, unseen, differ };
+
+const Split = struct { before: []const u32, after: []const u32 };
+
+fn split(cuts: []const u32, from: u32) Split {
+    var i: usize = 0;
+    while (i < cuts.len and cuts[i] <= from) i += 1;
+    return .{ .before = cuts[0..i], .after = cuts[i..] };
+}
+
+pub fn seen(resumed: []const u32, cold: []const u32, from: u32, whole: bool) Seen {
+    if (std.mem.eql(u32, resumed, cold)) return .same;
+    if (!whole) return .differ;
+    const r = split(resumed, from);
+    const c = split(cold, from);
+    if (r.after.len != 1 or c.after.len == 0) return .differ;
+    if (!std.mem.eql(u32, r.before, c.before)) return .differ;
+    if (r.after[0] != c.after[c.after.len - 1]) return .differ;
+    return .unseen;
+}
+
+test "pshare ride cuts: a whole resumed prompt's inner cut is unseen, not a different cut" {
+    try std.testing.expectEqual(Seen.unseen, seen(&.{ 2944, 3002, 5197, 8600 }, &.{ 2944, 3002, 5197, 6909, 8600 }, 5197, true));
+}
+
+test "pshare ride cuts: equal cuts are the same, whole or not" {
+    try std.testing.expectEqual(Seen.same, seen(&.{ 2944, 3002, 5946, 8597, 8600 }, &.{ 2944, 3002, 5946, 8597, 8600 }, 3002, false));
+    try std.testing.expectEqual(Seen.same, seen(&.{ 2944, 3002, 5197, 6900 }, &.{ 2944, 3002, 5197, 6900 }, 5197, true));
+}
+
+test "pshare ride cuts: a fill run in pieces, other cuts before the resume point, two seen pieces or another end differ" {
+    try std.testing.expectEqual(Seen.differ, seen(&.{ 2944, 3002, 5197, 8600 }, &.{ 2944, 3002, 5197, 6909, 8600 }, 5197, false));
+    try std.testing.expectEqual(Seen.differ, seen(&.{ 2944, 3002, 5197, 8600 }, &.{ 2944, 3000, 5197, 6909, 8600 }, 5197, true));
+    try std.testing.expectEqual(Seen.differ, seen(&.{ 2944, 3002, 5197, 6000, 8600 }, &.{ 2944, 3002, 5197, 6909, 8600 }, 5197, true));
+    try std.testing.expectEqual(Seen.differ, seen(&.{ 2944, 3002, 5197, 8600 }, &.{ 2944, 3002, 5197, 6909, 8597 }, 5197, true));
+    try std.testing.expectEqual(Seen.differ, seen(&.{ 2944, 3002, 5197 }, &.{ 2944, 3002, 5197, 8600 }, 5197, true));
+}
