--- /dev/null
+++ b/zig/tests/cuda/flashnext_moe_glue_tests.zig
@@ -0,0 +1,514 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const keep_early = @import("flashnext_keep_early_tests.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const env = @import("sys").env;
+const Session = flash.rank_engine.Session;
+const Record = keep_early.Record;
+const rr = cuda.route_rows;
+
+const knob = "TF_FLASHNEXT_MOE_GLUE";
+const ne = 512;
+const nl = ne + 1;
+const dims = 2560;
+const slots = 11;
+const top = 10;
+const most_rows = rr.front_most;
+const layers = 48;
+
+const rows_checked = [_]usize{ 1, 2, 3, 4, 5, 7, 8, 11, 12, 13, 15, 16, 17, 24, 25, 31, 32, 33, 47, 48, 50, 63, 64, 65, 72, 80, 93, 94, 96, 112, 127, 128 };
+
+const Half = struct { name: []const u8, first: usize, local: usize, stride: usize };
+const halves = [_]Half{
+    .{ .name = "rank 0", .first = 0, .local = 256, .stride = 1 },
+    .{ .name = "rank 1", .first = 256, .local = 256, .stride = 1 },
+    .{ .name = "world 1", .first = 0, .local = 512, .stride = 1 },
+    .{ .name = "rank 0 dealt", .first = 0, .local = 256, .stride = 2 },
+    .{ .name = "rank 1 dealt", .first = 1, .local = 256, .stride = 2 },
+};
+const tiles = [_]usize{ 64, 16, 0 };
+
+fn tobf(v: f32) u16 {
+    const b: u32 = @bitCast(v);
+    return @truncate((b + 0x7fff + ((b >> 16) & 1)) >> 16);
+}
+
+fn i32of(v: usize) i32 {
+    return @intCast(v);
+}
+
+const Bufs = struct {
+    l: cuda.DeviceBuffer,
+    picks: cuda.DeviceBuffer,
+    wts: cuda.DeviceBuffer,
+    own: cuda.DeviceBuffer,
+    members: cuda.DeviceBuffer,
+    items: cuda.DeviceBuffer,
+    counts: cuda.DeviceBuffer,
+    rank: cuda.DeviceBuffer,
+    hist: cuda.DeviceBuffer,
+
+    fn init(d: *const cuda.Driver) !Bufs {
+        const pairs = most_rows * slots;
+        var b: Bufs = undefined;
+        b.l = try cuda.DeviceBuffer.alloc(d, most_rows * nl * 4);
+        b.picks = try cuda.DeviceBuffer.alloc(d, pairs * 4);
+        b.wts = try cuda.DeviceBuffer.alloc(d, pairs * 4);
+        b.own = try cuda.DeviceBuffer.alloc(d, pairs * 4);
+        b.members = try cuda.DeviceBuffer.alloc(d, pairs * 4);
+        b.items = try cuda.DeviceBuffer.alloc(d, (pairs + nl) * 3 * 4);
+        b.counts = try cuda.DeviceBuffer.alloc(d, 256);
+        b.rank = try cuda.DeviceBuffer.alloc(d, pairs * 4);
+        b.hist = try cuda.DeviceBuffer.alloc(d, ((pairs + 1023) / 1024) * (nl + 1) * 4);
+        return b;
+    }
+
+    fn free(b: *Bufs) void {
+        inline for (.{ "l", "picks", "wts", "own", "members", "items", "counts", "rank", "hist" }) |f| @field(b, f).free();
+    }
+
+    fn plan(b: *const Bufs) cuda.grouped.Plan {
+        return .{ .members = b.members.ptr, .items = b.items.ptr, .counts = b.counts.ptr, .rank = b.rank.ptr, .hist = b.hist.ptr };
+    }
+
+    fn dirty(b: *const Bufs, s: cuda.Stream, v: u8) !void {
+        inline for (.{ "l", "picks", "wts", "own", "members", "items", "counts" }) |f| try @field(b, f).fill8(v, s.handle);
+    }
+};
+
+const Chains = struct {
+    rt: rr.RouteRows,
+    batch: cuda.Module,
+    experts: cuda.Module,
+    router: cuda.grouped.Router,
+    ep: cuda.Function,
+    ep_dealt: cuda.Function,
+    sync: cuda.DeviceBuffer,
+
+    fn load(d: *const cuda.Driver, s: cuda.Stream) !Chains {
+        var c: Chains = undefined;
+        c.rt = try rr.RouteRows.load(d);
+        errdefer c.rt.unload();
+        c.batch = try cuda.Module.load(d, cuda.kernels.flashnext_batch);
+        errdefer c.batch.unload();
+        c.experts = try cuda.Module.load(d, cuda.kernels.experts);
+        errdefer c.experts.unload();
+        c.router = try cuda.grouped.Router.resolve(c.experts);
+        c.ep = try c.batch.function("fn_ep_picks");
+        c.ep_dealt = try c.batch.function("fn_ep_picks_strided");
+        c.sync = try cuda.DeviceBuffer.alloc(d, rr.front_sync_bytes);
+        try c.sync.fill8(0, s.handle);
+        return c;
+    }
+
+    fn unload(c: *Chains) void {
+        c.sync.free();
+        c.experts.unload();
+        c.batch.unload();
+        c.rt.unload();
+    }
+
+    fn logits(c: *const Chains, s: cuda.Stream, x: u64, w: u64, b: *const Bufs, rows: usize) !void {
+        const keep = rr.decode_rows;
+        rr.decode_rows = false;
+        defer rr.decode_rows = keep;
+        try c.rt.logits(s, x, dims, w, b.l.ptr, rows, dims, nl);
+    }
+
+    fn served(c: *const Chains, s: cuda.Stream, x: u64, w: u64, b: *const Bufs, rows: usize, h: Half, tile: usize) !void {
+        try c.logits(s, x, w, b, rows);
+        try c.rt.topk(s, b.l.ptr, nl, ne, top, b.picks.ptr, b.wts.ptr, slots, rows, true);
+        const pairs = rows * slots;
+        var a: cuda.Args = .{};
+        a.add(b.picks.ptr);
+        a.add(b.own.ptr);
+        for ([_]usize{ pairs, h.first, h.local }) |v| a.add(i32of(v));
+        if (h.stride != 1) a.add(i32of(h.stride));
+        try cuda.launch.launch(if (h.stride == 1) c.ep else c.ep_dealt, .{ .grid = .{ .x = @intCast((pairs + 255) / 256) }, .block = .{ .x = 256 } }, s, &a);
+        if (tile != 0) try c.router.route(s, b.own.ptr, pairs, h.local + 1, tile, b.plan());
+    }
+
+    fn front(c: *const Chains, s: cuda.Stream, x: u64, w: u64, b: *const Bufs, rows: usize, h: Half, tile: usize) !void {
+        try c.rt.front(s, .{
+            .x = x,
+            .w = w,
+            .logits = b.l.ptr,
+            .picks = b.picks.ptr,
+            .wts = b.wts.ptr,
+            .own = b.own.ptr,
+            .members = b.members.ptr,
+            .items = b.items.ptr,
+            .counts = b.counts.ptr,
+            .sync = c.sync.ptr,
+            .x_ld = i32of(dims),
+            .rows = i32of(rows),
+            .d = i32of(dims),
+            .experts = i32of(ne),
+            .top_k = i32of(top),
+            .slots = i32of(slots),
+            .first = i32of(h.first),
+            .local = i32of(h.local),
+            .stride = i32of(h.stride),
+            .tile = i32of(tile),
+        });
+    }
+};
+
+fn routerWeights(gpa: std.mem.Allocator, rng: std.Random) ![]u16 {
+    const w = try gpa.alloc(u16, nl * dims);
+    for (w) |*v| v.* = tobf(@floatCast(rng.floatNorm(f64) * 0.03));
+    for ([_][2]usize{ .{ 3, 7 }, .{ 300, 301 }, .{ 129, 385 } }) |pair| {
+        const hot = w[pair[0] * dims ..][0..dims];
+        for (hot) |*v| v.* = tobf(@floatCast(rng.floatNorm(f64) * 0.06));
+        @memcpy(w[pair[1] * dims ..][0..dims], hot);
+    }
+    return w;
+}
+
+fn activations(gpa: std.mem.Allocator, rng: std.Random) ![]u16 {
+    const x = try gpa.alloc(u16, most_rows * dims);
+    for (x, 0..) |*v, i| {
+        const g: f32 = @floatCast(rng.floatNorm(f64));
+        v.* = tobf(if (i % 97 == 5) g * 16 else g);
+    }
+    @memcpy(x[5 * dims ..][0..dims], x[2 * dims ..][0..dims]);
+    return x;
+}
+
+const Snap = struct {
+    bytes: [7][]u8,
+
+    fn take(gpu: check.Gpu, b: *const Bufs, rows: usize, tile: usize) !Snap {
+        const pairs = rows * slots;
+        var s: Snap = undefined;
+        var counts: [2]i32 = .{ 0, 0 };
+        if (tile != 0) try b.counts.download(0, std.mem.asBytes(&counts));
+        const lens = [_]usize{ rows * nl * 4, pairs * 4, pairs * 4, pairs * 4, if (tile != 0) pairs * 4 else 0, @as(usize, @intCast(counts[0])) * 3 * 4, if (tile != 0) 8 else 0 };
+        const srcs = [_]cuda.DeviceBuffer{ b.l, b.picks, b.wts, b.own, b.members, b.items, b.counts };
+        for (&s.bytes, lens, srcs) |*o, len, src| {
+            o.* = try gpu.gpa.alloc(u8, len);
+            if (len > 0) try src.download(0, o.*);
+        }
+        return s;
+    }
+
+    fn free(s: *Snap, gpa: std.mem.Allocator) void {
+        for (s.bytes) |x| gpa.free(x);
+    }
+};
+
+const parts = [_][]const u8{ "logits", "picks", "weights", "own picks", "members", "items", "counts" };
+
+pub fn kernel(gpu: check.Gpu) !void {
+    const gpa = gpu.gpa;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var c = try Chains.load(gpu.d, stream);
+    defer c.unload();
+    var b = try Bufs.init(gpu.d);
+    defer b.free();
+    var prng = std.Random.DefaultPrng.init(3970);
+    const rng = prng.random();
+    const w = try routerWeights(gpa, rng);
+    defer gpa.free(w);
+    const x = try activations(gpa, rng);
+    defer gpa.free(x);
+    var dw = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(w));
+    defer dw.free();
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+    defer dx.free();
+    var cases: usize = 0;
+    var ties: usize = 0;
+    for (rows_checked) |rows| for (halves) |h| for (tiles) |tile| {
+        if (!rr.frontShape(rows, dims, dims, ne, top, slots, h.first, h.local, h.stride)) return error.TestFailed;
+        try b.dirty(stream, 0xff);
+        try c.served(stream, dx.ptr, dw.ptr, &b, rows, h, tile);
+        try stream.synchronize();
+        var want = try Snap.take(gpu, &b, rows, tile);
+        defer want.free(gpa);
+        for (0..2) |rep| {
+            try b.dirty(stream, if (rep == 0) 0xa5 else 0x5a);
+            try c.front(stream, dx.ptr, dw.ptr, &b, rows, h, tile);
+            try stream.synchronize();
+            var got = try Snap.take(gpu, &b, rows, tile);
+            defer got.free(gpa);
+            for (got.bytes, want.bytes, parts) |g, wb, name| check.sameBytes(name, g, wb) catch |err| {
+                std.debug.print("FAIL {s}: {d} rows, {s}, tile {d}, run {d}\n", .{ name, rows, h.name, tile, rep + 1 });
+                return err;
+            };
+        }
+        var sync: [rr.front_sync_bytes]u8 = undefined;
+        try c.sync.download(0, &sync);
+        try check.expect(std.mem.allEqual(u8, &sync, 0), "{d} rows, {s}, tile {d}: the front left its tickets set", .{ rows, h.name, tile });
+        const pk: []const u32 = @alignCast(std.mem.bytesAsSlice(u32, want.bytes[1]));
+        for (0..rows) |r| {
+            const p = pk[r * slots ..][0..top];
+            if (std.mem.indexOfScalar(u32, p, 3) != null and std.mem.indexOfScalar(u32, p, 7) != null) ties += 1;
+        }
+        cases += 1;
+    };
+    try check.expect(ties > 0, "no row picked both tied experts", .{});
+    check.pass("TF_FLASHNEXT_MOE_GLUE front: logits, picks, weights, own picks and the expert plan (members, items, counts) byte-equal to tf_route_logits*, tf_route_topk, fn_ep_picks* and plan_kernel/the wide plan at {d} cases ({d} row counts 1-128, rank 0 and 1 halves, world 1, dealt halves, tiles 64/16/none), each run twice; tickets reset; {d} rows picked two tied experts", .{ cases, rows_checked.len, ties });
+}
+
+pub fn bench(gpu: check.Gpu, reps: usize) !void {
+    if (reps == 0 or reps > 1000) return error.BadBench;
+    const gpa = gpu.gpa;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var c = try Chains.load(gpu.d, stream);
+    defer c.unload();
+    var b = try Bufs.init(gpu.d);
+    defer b.free();
+    var prng = std.Random.DefaultPrng.init(4539);
+    const rng = prng.random();
+    const w = try routerWeights(gpa, rng);
+    defer gpa.free(w);
+    const x = try activations(gpa, rng);
+    defer gpa.free(x);
+    var dw = try cuda.DeviceBuffer.alloc(gpu.d, layers * w.len * 2);
+    defer dw.free();
+    for (0..layers) |l| try dw.upload(l * w.len * 2, std.mem.sliceAsBytes(w));
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+    defer dx.free();
+    var t0 = try cuda.Event.init(gpu.d, true);
+    defer t0.deinit();
+    var t1 = try cuda.Event.init(gpu.d, true);
+    defer t1.deinit();
+    const h = halves[0];
+    const tile = flash.moe_glue.planTile(true, 2, 16, most_rows * slots, true, 12);
+    const Arm = enum { logits, served, front };
+    var kill_saved: f64 = 0;
+    for ([_][2]usize{ .{ 1, 4 }, .{ 4, 12 }, .{ 8, 25 }, .{ 16, 50 }, .{ 24, 72 }, .{ 28, 96 } }) |lr| {
+        const rows = lr[1];
+        var ms: [3]f64 = undefined;
+        for (std.enums.values(Arm), 0..) |which, ai| {
+            var t: [64]f64 = undefined;
+            const n = @min(reps, t.len);
+            for (0..n + 1) |rep| {
+                try t0.record(stream);
+                for (0..layers) |l| {
+                    const wl = dw.ptr + l * w.len * 2;
+                    switch (which) {
+                        .logits => try c.logits(stream, dx.ptr, wl, &b, rows),
+                        .served => try c.served(stream, dx.ptr, wl, &b, rows, h, tile),
+                        .front => try c.front(stream, dx.ptr, wl, &b, rows, h, tile),
+                    }
+                }
+                try t1.record(stream);
+                try t1.synchronize();
+                if (rep > 0) t[rep - 1] = @as(f64, try cuda.Event.elapsedMs(t0, t1));
+            }
+            ms[ai] = check.median(t[0..n]);
+        }
+        const saved = ms[1] - ms[2];
+        if (lr[0] == 4) kill_saved = saved;
+        std.debug.print("RESULT moe-glue-bench {d} lanes ({d} rows), 48 layers, cold router weights: logits alone {d:.3} ms ({d:.1} us a layer), served chain (logits, topk, own picks, plan tile {d}) {d:.3} ms ({d:.1} us), fused front {d:.3} ms ({d:.1} us); front saves {d:.3} ms a round ({d:.1} us a layer); median of {d}\n", .{ lr[0], rows, ms[0], ms[0] * 1000 / layers, tile, ms[1], ms[1] * 1000 / layers, ms[2], ms[2] * 1000 / layers, saved, saved * 1000 / layers, @min(reps, 64) });
+    }
+    std.debug.print("RESULT moe-glue-bench kill rule: the fused front saves {d:.3} ms a 4-lane round (12 rows, 48 layers); rule >= 0.400: {s}\n", .{ kill_saved, if (kill_saved >= 0.4) "GO" else "KILL" });
+}
+
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: *Session,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+    out: cuda.DeviceBuffer,
+    host: []u8,
+    identity: flash.rank_engine.Identity,
+    rank: usize,
+    port: u16,
+    opened: u16 = 0,
+    followed: bool = false,
+
+    fn setKnob(on: bool) void {
+        _ = env.setenv(knob, if (on) "1" else "0", 1);
+    }
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, on: bool) !void {
+        _ = env.setenv("TF_FLASHNEXT_TP_KEEP_BATCH", "1", 1);
+        _ = env.setenv("TF_FLASHNEXT_KEEP_LANES", "1", 1);
+        setKnob(on);
+        r.gpu = gpu;
+        r.rank = rank;
+        r.port = port;
+        r.opened = 0;
+        r.followed = false;
+        r.head = null;
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        const kv = try kvCache();
+        const window = try flash.index_window.wanted();
+        r.identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, keep_early.context, chunk);
+        r.identity.mtp = 1;
+        r.identity.kv_cache = @backingInt(kv);
+        r.identity.index_window = @intFromBool(window);
+        r.session = try Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, r.identity, flash.rank_engine.linkWait());
+        r.e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank) catch |err| {
+            r.session.poison();
+            r.session.deinit();
+            return err;
+        };
+        errdefer {
+            r.session.poison();
+            r.session.deinit();
+            r.e.deinit();
+        }
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        r.e.kv = kv;
+        r.e.index_window = if (window) flash.index_window.rows(r.e.chunk) else 0;
+        try r.attach();
+        _ = try r.e.reserve(@min(keep_early.context, r.e.chunk));
+        r.out = try cuda.DeviceBuffer.alloc(gpu.d, keep_early.max_streams * mtp.max_rows * keep_early.row);
+        errdefer r.out.free();
+        r.host = try gpu.gpa.alloc(u8, keep_early.max_streams * mtp.max_rows * keep_early.row);
+        errdefer gpu.gpa.free(r.host);
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    fn attach(r: *Rig) !void {
+        r.session.engine = r.e;
+        r.e.collective = &r.session.collective;
+        if (!r.session.keep_batch) return error.KnobUnread;
+        if (flash.knobs.tpRoce()) try r.session.collective.openRoce(r.gpu.gpa, r.gpu.io, r.gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    }
+
+    fn next(r: *Rig, on: bool) !void {
+        if (r.rank == 1 and !r.followed) try r.session.follow(flash.Tri, r.tri(), r.out.ptr);
+        r.followed = false;
+        try r.stream.synchronize();
+        r.session.deinit();
+        setKnob(on);
+        r.opened += 1;
+        r.session = try Session.init(r.gpu.gpa, r.gpu.io, @import("flashnext_rank_tests.zig").rankHost(), r.port + r.opened, r.rank, r.identity, flash.rank_engine.linkWait());
+        try r.attach();
+    }
+
+    fn deinit(r: *Rig) void {
+        if (r.rank == 1 and !r.followed) r.session.follow(flash.Tri, r.tri(), r.out.ptr) catch {};
+        r.session.deinit();
+        _ = env.unsetenv(knob);
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.gpu.gpa.free(r.host);
+        r.out.free();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    pub fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    pub fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback, .rollback_many = rollbackMany } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+    fn rollbackMany(p: *anyopaque, qs: []const *prompt.Seq, ds: []const *mtp.Draft, keeps: []const usize) anyerror!void {
+        const r = of(p);
+        return r.session.keepMany(flash.Tri, r.tri(), qs, ds, keeps);
+    }
+};
+
+fn kvCache() !flash.kv_format.Kv {
+    const v = std.c.getenv("TF_TEST_KV_CACHE") orelse return .nvfp4;
+    return std.meta.stringToEnum(flash.kv_format.Kv, std.mem.span(v)) orelse error.BadKvCache;
+}
+
+fn arm(r: *Rig, seed: []const u32, n: usize, rounds: usize, rec: *Record) !u64 {
+    const before = flash.moe_glue.fronts;
+    try keep_early.decode(r, seed, n, rounds, rec);
+    return flash.moe_glue.fronts - before;
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, rounds: usize) !void {
+    if (rounds <= keep_early.warm_rounds) return error.BadRounds;
+    var seed = try keep_early.seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    const counts = [_]usize{ 1, 4, 8, 16 };
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, false);
+    defer r.deinit();
+    var offs: [counts.len]Record = @splat(.{});
+    defer for (&offs) |*x| x.deinit(gpu.gpa);
+    var ons: [counts.len]Record = @splat(.{});
+    defer for (&ons) |*x| x.deinit(gpu.gpa);
+    var taken_off: [counts.len]u64 = @splat(0);
+    var taken_on: [counts.len]u64 = @splat(0);
+    if (rank == 0) for (counts, &offs, &taken_off) |n, *rec, *t| {
+        t.* = try arm(&r, seed.items, n, rounds, rec);
+    };
+    try r.next(true);
+    if (rank == 1) {
+        const before = flash.moe_glue.fronts;
+        try r.session.follow(flash.Tri, r.tri(), r.out.ptr);
+        r.followed = true;
+        try check.expect(flash.moe_glue.fronts > before, "rank 1 never took the fused front with {s}=1", .{knob});
+        return check.pass("rank 1 followed the off and on sessions and took the fused front {d} times", .{flash.moe_glue.fronts - before});
+    }
+    for (counts, &ons, &taken_on) |n, *rec, *t| t.* = try arm(&r, seed.items, n, rounds, rec);
+    for (counts, offs, ons, taken_off, taken_on) |n, off, on, t_off, t_on| {
+        for (off.digests.items, on.digests.items, 0..) |a, b, round| {
+            try check.expect(a == b, "{d} streams: round {d}'s window scores differ with {s}", .{ n, round, knob });
+        }
+        for (off.tokens[0..n], on.tokens[0..n], 0..) |a, b, i| {
+            const first = std.mem.indexOfDiff(u32, a.items, b.items);
+            try check.expect(first == null, "{d} streams: stream {d}'s tokens differ from token {?d}", .{ n, i, first });
+        }
+        try check.expect(t_off == 0, "{d} streams: {d} layers took the fused front with {s}=0", .{ n, t_off, knob });
+        try check.expect(t_on >= rounds, "{d} streams: only {d} layers took the fused front in {d} rounds", .{ n, t_on, rounds });
+        const tokens = off.emitted(n);
+        check.pass("{d} streams, {d} rounds with the MTP head: {d} tokens and every round's window scores byte-equal with {s} ({d} fused fronts)", .{ n, rounds, tokens, knob, t_on });
+        std.debug.print("BENCH moe-glue streams={d} rounds={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - keep_early.warm_rounds, off.ms, on.ms, off.ms - on.ms });
+    }
+}
+
+pub fn roundBench(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, n: usize, rounds: usize, reps: usize) !void {
+    if (n < 1 or n > keep_early.max_streams or rounds <= keep_early.warm_rounds or reps == 0 or reps > 32) return error.BadBench;
+    var seed = try keep_early.seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, false);
+    defer r.deinit();
+    var offs: [32]f64 = undefined;
+    var ons: [32]f64 = undefined;
+    for (0..reps) |rep| {
+        inline for (.{ false, true }) |on| {
+            if (rep > 0 or on) try r.next(on);
+            if (rank == 0) {
+                var rec: Record = .{};
+                defer rec.deinit(gpu.gpa);
+                _ = try arm(&r, seed.items, n, rounds, &rec);
+                if (on) ons[rep] = rec.ms else offs[rep] = rec.ms;
+            }
+        }
+        if (rank == 0) std.debug.print("rep {d}: {d:.2} ms a round off, {d:.2} on\n", .{ rep, offs[rep], ons[rep] });
+    }
+    if (rank == 1) return check.pass("rank 1 followed the bench's {d} sessions", .{2 * reps});
+    const off = check.median(offs[0..reps]);
+    const on = check.median(ons[0..reps]);
+    std.debug.print("BENCH moe-glue-round streams={d} rounds={d} reps={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - keep_early.warm_rounds, reps, off, on, off - on });
+}
