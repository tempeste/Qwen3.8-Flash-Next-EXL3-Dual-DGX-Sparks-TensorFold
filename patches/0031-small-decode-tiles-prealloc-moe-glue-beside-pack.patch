+    try std.testing.expectError(error.UnexpectedTensor, check(a, .{ .rows = 1163, .fed = 32000, .cap = 32768 }, false, true, 3072, 409600));
+    try std.testing.expectError(error.UnexpectedTensor, check(a, b, false, true, 3072, 32768));
+    try std.testing.expectError(error.UnexpectedTensor, check(a, .{ .rows = 0, .fed = 0, .cap = 64 }, false, true, 3072, 409600));
+}
+
+test "a packed pass's attention blocks are each piece's solo blocks, back to back, at the same positions" {
+    const shapes = [_][4]usize{ .{ 736, 0, 1003, 70000 }, .{ 1040, 20480, 1163, 4096 }, .{ 1535, 255, 1535, 1 }, .{ 512, 257, 1024, 100 } };
+    var view: state.SeqState = undefined;
