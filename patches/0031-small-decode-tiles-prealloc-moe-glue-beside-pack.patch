+        joins: usize = 0,
+        freed_held: usize = 0,
+        drops: usize = 0,
+        pub fn joinBeside(c: *@This()) void {
+            if (c.held != null) c.joins += 1;
+            c.held = null;
+        }
+        pub fn drop(c: *@This(), l: *Lane) void {
+            if (c.held == l) c.freed_held += 1;
