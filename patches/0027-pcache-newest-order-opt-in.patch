     d.api.cuMemcpyDtoH_v2 = read;
     d.api.cuStreamSynchronize = sync;
+    d.api.cuCtxGetDevice = contextDevice;
+    d.api.cuDeviceGetAttribute = discrete;
     return d;
 }
