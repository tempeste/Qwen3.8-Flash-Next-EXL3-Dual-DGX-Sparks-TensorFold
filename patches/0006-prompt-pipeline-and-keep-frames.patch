+//! TF_FLASHNEXT_TP_FRAME_FIRST over a Unix socket pair without a GPU: rank 0 sends the frames it sent before, in the same
+//! order and with the same bytes, makes the same device calls, and keeps both ranks' objects equal when it fails.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const snaps = @import("cuda_snap.zig");
+const ranks = @import("cuda_rank_engine.zig");
+const wire = @import("cuda_rank_wire.zig");
+const rank_snap = @import("cuda_rank_snap.zig");
+const Heads = @import("cuda_heads.zig").Heads;
+const rank_seqs = @import("cuda_rank_seqs.zig");
+const t = std.testing;
+
+/// Virtual device addresses; every call is logged by kind and size, so two runs' device work can be compared.
+const Device = struct {
+    var next: u64 = 0x100000;
+    var log: [8192]u64 = undefined;
+    var n: usize = 0;
+
+    fn note(kind: u64, size: u64) void {
+        if (n < log.len) log[n] = kind << 56 | size;
+        n += 1;
+    }
+    fn alloc(out: *u64, size: usize) callconv(.c) c_int {
+        out.* = next;
+        next = std.mem.alignForward(u64, next + size, 512) + 512;
+        note(1, size);
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) c_int {
+        note(2, 0);
+        return 0;
+    }
+    fn fill(_: u64, _: u8, size: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        note(3, size);
+        return 0;
+    }
+    fn copy(_: u64, _: u64, size: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+        note(4, size);
+        return 0;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) c_int {
+        note(5, 0);
+        return 0;
+    }
+    fn context() callconv(.c) c_int {
+        return 0;
+    }
+    fn driver() cuda.Driver {
+        n = 0;
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemsetD8Async = fill;
+        d.api.cuMemcpyDtoDAsync_v2 = copy;
+        d.api.cuStreamSynchronize = sync;
+        d.api.cuCtxSynchronize = context;
+        return d;
+    }
+    fn calls() []const u64 {
+        return log[0..@min(n, log.len)];
+    }
+};
+
+const Pair = struct {
+    driver: cuda.Driver,
+    stream: cuda.Stream,
+    engine: prompt.Engine,
+    fds: [2]std.posix.socket_t,
+    s: ranks.Session,
+    peer: wire.Link,
+
+    fn init(p: *Pair, first: bool) !void {
+        return p.initAt(0, first, false);
+    }
+
+    fn initAt(p: *Pair, rank: usize, first: bool, keep: bool) !void {
+        p.driver = Device.driver();
+        p.stream = .{ .d = &p.driver, .handle = null };
+        p.engine = undefined;
+        p.engine.gpa = t.allocator;
+        p.engine.driver = &p.driver;
+        p.engine.stream = &p.stream;
+        p.engine.eos = 7;
+        p.engine.chunk = 16;
+        p.engine.round_graph = .{};
+        p.engine.heads = .half;
+        p.engine.kv = .bf16;
+        p.engine.index_window = 0;
+        if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &p.fds) != 0) return error.SocketPair;
+        const nonblock: c_int = @bitCast(@as(u32, @bitCast(std.c.O{ .NONBLOCK = true })));
+        for (p.fds) |fd| {
+            const flags = std.c.fcntl(fd, std.c.F.GETFL);
+            if (flags < 0 or std.c.fcntl(fd, std.c.F.SETFL, flags | nonblock) < 0) return error.Nonblocking;
+        }
+        p.peer = .{ .fd = p.fds[1] };
+        p.s = .{ .gpa = t.allocator, .rank = rank, .link = .{ .fd = p.fds[0] }, .collective = undefined, .engine = &p.engine, .frame_first = first, .blocks = .{ .on = keep } };
+        p.s.collective.failed = false;
+        p.s.collective.site = .other;
+        p.s.collective.profile = null;
+        p.s.collective.roce = null;
+        p.s.collective.roce_stage = null;
+        p.s.collective.guard = null;
+        p.s.collective.comm = null;
+    }
+
+    fn deinit(p: *Pair) void {
+        p.s.windows.deinit(t.allocator);
+        var qi = p.s.seqs.valueIterator();
+        while (qi.next()) |q| {
+            q.*.deinit(t.allocator);
+            t.allocator.destroy(q.*);
+        }
+        p.s.seqs.deinit(t.allocator);
+        p.s.blocks.deinit(t.allocator);
+        p.s.saved.deinit(t.allocator);
+        _ = std.c.close(p.fds[0]);
+        _ = std.c.close(p.fds[1]);
+    }
+
+    fn quiet(p: *const Pair) bool {
+        var byte: u8 = 0;
+        return std.c.recv(p.fds[1], &byte, 1, std.posix.MSG.PEEK | std.posix.MSG.DONTWAIT) < 0;
+    }
