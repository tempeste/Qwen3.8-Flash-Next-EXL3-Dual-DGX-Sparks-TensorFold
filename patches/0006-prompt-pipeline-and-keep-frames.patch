+/// TF_FLASHNEXT_MIXED_TABLE_ROUND=1 (rank 0, with TF_FLASHNEXT_MIXED_TABLE; unset or 0: off): the table's limits time the
+/// decoders' whole round, from a mixed round's verify start to the next verify's start (the forward, the draws, the
+/// head's drafts and the host between), not the forward alone. Any other value is refused (BadMixedTable).
+pub fn roundSetting(v: ?[]const u8) !bool {
+    const s = v orelse return false;
+    if (std.mem.eql(u8, s, "0")) return false;
+    if (std.mem.eql(u8, s, "1")) return true;
+    return error.BadMixedTable;
+}
+
+/// A mixed round's whole time under TF_FLASHNEXT_MIXED_TABLE_ROUND: opened as the round's verify starts, closed as the
+/// next verify starts. Prompt work on the lanes between the two (a piece alone, a prompt pass, a lane opened) cuts it,
+/// and a span over `spare` times the limit is not a round's.
+pub const Period = struct {
+    pub const spare = 4;
+    pub const Sample = struct { decoders: usize, rows: usize, ns: u64 };
+
+    open: ?struct { t0: u64, decoders: usize, rows: usize } = null,
+
+    pub fn mixed(p: *Period, t0: u64, decoders: usize, n: usize) void {
+        p.open = .{ .t0 = t0, .decoders = decoders, .rows = n };
+    }
+
+    pub fn cut(p: *Period) void {
+        p.open = null;
+    }
+
+    pub fn close(p: *Period, now: u64, table: *const Table) ?Sample {
+        const o = p.open orelse return null;
+        p.open = null;
+        if (now <= o.t0 or now - o.t0 > spare * table.limit(o.decoders)) return null;
+        return .{ .decoders = o.decoders, .rows = o.rows, .ns = now - o.t0 };
+    }
+};
