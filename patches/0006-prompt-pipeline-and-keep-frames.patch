+//! Control carries a shared prompt pass (TF_FLASHNEXT_PROMPT_MULTI): one entry a piece (its sequence, rows and whether
+//! it ends its prompt), then every piece's ids in order; the header names the pieces (arg).
+const std = @import("std");
+const prompt = @import("cuda_prompt.zig");
+const multi = @import("cuda_prompt_multi.zig");
+const wire = @import("cuda_rank_wire.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const knobs = @import("cuda_knobs.zig");
+const Session = @import("cuda_rank_engine.zig").Session;
+
+/// Rows a frame's pieces add up to at most (the widest pass a frame may ask for).
+pub const max_rows = prompt.batch.max_chunk;
+pub const entry_bytes = 16;
+pub const max_bytes = entry_bytes * multi.max_pieces + 4 * max_rows;
+
+comptime {
+    std.debug.assert(max_bytes <= wire.max_payload);
+}
+
+/// The header's own checks (Session's shape()).
+pub fn shapeOk(h: wire.Header) bool {
+    return h.object == 0 and h.flags == 0 and h.arg >= 2 and h.arg <= multi.max_pieces and h.bytes > entry_bytes * h.arg and h.bytes <= max_bytes and (h.bytes - entry_bytes * h.arg) % 4 == 0;
+}
+
+/// One piece of a decoded frame: rank 1's sequence id, its ids (little-endian u32s) and whether it ends its prompt.
+pub const Entry = struct { id: u64, ids: []const u8, last: bool };
+
+/// The frame's `count` pieces from `payload` into `out`: rows adding up to the ids, no empty piece, every id a token.
+pub fn decode(payload: []const u8, count: usize, out: []Entry) ![]const Entry {
+    if (count < 2 or count > multi.max_pieces or count > out.len or payload.len < entry_bytes * count) return error.BadRankFrame;
+    const ids = payload[entry_bytes * count ..];
+    if (ids.len % 4 != 0 or ids.len / 4 > max_rows) return error.BadRankFrame;
+    var at: usize = 0;
+    for (out[0..count], 0..) |*e, i| {
+        const raw = payload[i * entry_bytes ..][0..entry_bytes];
+        const id = std.mem.readInt(u64, raw[0..8], .little);
+        const rows = std.mem.readInt(u32, raw[8..12], .little);
+        const last = std.mem.readInt(u32, raw[12..16], .little);
+        if (id == 0 or rows == 0 or last > 1 or at + rows > ids.len / 4) return error.BadRankFrame;
+        e.* = .{ .id = id, .ids = ids[at * 4 ..][0 .. rows * 4], .last = last == 1 };
+        at += rows;
+    }
+    if (at != ids.len / 4) return error.BadRankFrame;
+    for (0..at) |i| if (std.mem.readInt(u32, ids[i * 4 ..][0..4], .little) >= wt.vocab) return error.InvalidToken;
+    return out[0..count];
+}
+
+/// The frame for `pieces` (rank 1's ids in `ids`) into `out`; refuses what `decode` refuses.
+pub fn encode(ids: []const u64, pieces: []const prompt.Engine.PromptPiece, out: []u8) ![]const u8 {
+    if (ids.len != pieces.len or pieces.len < 2 or pieces.len > multi.max_pieces) return error.BadRankFrame;
+    var n = entry_bytes * pieces.len;
+    for (ids, pieces, 0..) |id, x, i| {
+        if (n + 4 * x.ids.len > out.len) return error.BadRankFrame;
+        const raw = out[i * entry_bytes ..][0..entry_bytes];
+        std.mem.writeInt(u64, raw[0..8], id, .little);
+        std.mem.writeInt(u32, raw[8..12], @intCast(x.ids.len), .little);
+        std.mem.writeInt(u32, raw[12..16], @intFromBool(x.last), .little);
+        for (x.ids, 0..) |token, j| std.mem.writeInt(u32, out[n + j * 4 ..][0..4], token, .little);
+        n += 4 * x.ids.len;
+    }
+    var check: [multi.max_pieces]Entry = undefined;
+    _ = try decode(out[0..n], pieces.len, &check);
+    return out[0..n];
+}
+
+/// Rank 0: the frame to rank 1, the same pass here, then rank 1's ack (queued as a chunk's is when no piece ends its
+/// prompt and TF_FLASHNEXT_TP_PROMPT_ASYNC is on); a failure after the send poisons the session.
+pub fn send(s: *Session, comptime Tri: type, tri: Tri, pieces: []const prompt.Engine.PromptPiece) !void {
+    if (!(try knobs.promptMulti()) or pieces.len < 2 or pieces.len > multi.max_pieces) return error.UnsupportedRankOperation;
+    _ = multi.plan(pieces, s.engine.chunk) catch return error.UnsupportedRankOperation;
+    var ids: [multi.max_pieces]u64 = undefined;
+    var any_last = false;
+    for (pieces, 0..) |x, i| {
+        if (x.seq.rank_id == 0) return error.UnsupportedRankOperation;
+        ids[i] = x.seq.rank_id;
+        any_last = any_last or x.last;
+    }
+    const raw = try s.gpa.alloc(u8, max_bytes);
+    defer s.gpa.free(raw);
+    const bytes = try encode(ids[0..pieces.len], pieces, raw);
+    const h = try s.command(.{ .kind = .prompt_many, .arg = pieces.len, .bytes = @intCast(bytes.len) }, bytes);
+    errdefer s.poison();
+    try s.engine.prompts(Tri, tri, pieces);
+    if (!any_last and knobs.tpPromptAsync()) return s.later(h);
+    try s.ack(h);
+}
+
+/// Rank 1: every check before any state moves, then the same pass (the pieces keep no hidden streams here).
+pub fn receive(s: *Session, comptime Tri: type, tri: Tri, h: wire.Header, payload: []const u8) !void {
+    if (!(try knobs.promptMulti())) return error.UnsupportedRankOperation;
+    var entries: [multi.max_pieces]Entry = undefined;
+    const got = try decode(payload, @intCast(h.arg), &entries);
+    const ids = try s.gpa.alloc(u32, (payload.len - entry_bytes * got.len) / 4);
+    defer s.gpa.free(ids);
+    var pieces: [multi.max_pieces]prompt.Engine.PromptPiece = undefined;
+    var at: usize = 0;
+    for (got, pieces[0..got.len]) |e, *x| {
+        const q = s.seqs.get(e.id) orelse return error.UnknownRankSequence;
+        const rows = e.ids.len / 4;
+        for (ids[at..][0..rows], 0..) |*v, i| v.* = std.mem.readInt(u32, e.ids[i * 4 ..][0..4], .little);
+        x.* = .{ .seq = q, .ids = ids[at..][0..rows], .last = e.last };
+        at += rows;
+    }
+    _ = multi.plan(pieces[0..got.len], s.engine.chunk) catch return error.PromptTooLong;
+    try s.engine.prompts(Tri, tri, pieces[0..got.len]);
+}
+
+test "a shared prompt frame round-trips and refuses bad rows, a bad token, a zero id and a lone piece" {
+    var raw: [max_bytes]u8 = undefined;
+    var seqs: [3]prompt.Seq = undefined;
+    const a = [_]u32{ 5, 6, 7 };
+    const b = [_]u32{8};
+    const c = [_]u32{ 9, 10 };
+    const pieces = [_]prompt.Engine.PromptPiece{ .{ .seq = &seqs[0], .ids = &a }, .{ .seq = &seqs[1], .ids = &b, .last = true }, .{ .seq = &seqs[2], .ids = &c } };
+    const ids = [_]u64{ 3, 9, 4 };
+    const bytes = try encode(&ids, &pieces, &raw);
+    try std.testing.expectEqual(@as(usize, 16 * 3 + 4 * 6), bytes.len);
+    var out: [multi.max_pieces]Entry = undefined;
+    const got = try decode(bytes, 3, &out);
+    try std.testing.expectEqual(@as(u64, 9), got[1].id);
+    try std.testing.expect(got[1].last and !got[0].last and !got[2].last);
+    try std.testing.expectEqual(@as(usize, 12), got[0].ids.len);
+    try std.testing.expectEqual(@as(u32, 10), std.mem.readInt(u32, got[2].ids[4..8], .little));
+    try std.testing.expect(shapeOk(.{ .kind = .prompt_many, .arg = 3, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .prompt_many, .arg = 1, .bytes = 20 }));
+    try std.testing.expect(!shapeOk(.{ .kind = .prompt_many, .object = 1, .arg = 3, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .prompt_many, .arg = 3, .bytes = 16 * 3 }));
+    try std.testing.expect(!shapeOk(.{ .kind = .prompt_many, .arg = 3, .bytes = 16 * 3 + 6 }));
+    try std.testing.expect(!shapeOk(.{ .kind = .prompt_many, .arg = multi.max_pieces + 1, .bytes = max_bytes }));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes[0 .. bytes.len - 4], 3, &out));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes, 1, &out));
+    var bad: [max_bytes]u8 = undefined;
+    @memcpy(bad[0..bytes.len], bytes);
+    std.mem.writeInt(u32, bad[bytes.len - 4 ..][0..4], wt.vocab, .little);
+    try std.testing.expectError(error.InvalidToken, decode(bad[0..bytes.len], 3, &out));
+    @memcpy(bad[0..bytes.len], bytes);
+    std.mem.writeInt(u64, bad[16..24], 0, .little);
+    try std.testing.expectError(error.BadRankFrame, decode(bad[0..bytes.len], 3, &out));
+    @memcpy(bad[0..bytes.len], bytes);
+    std.mem.writeInt(u32, bad[24..28], 0, .little);
+    try std.testing.expectError(error.BadRankFrame, decode(bad[0..bytes.len], 3, &out));
+    @memcpy(bad[0..bytes.len], bytes);
+    std.mem.writeInt(u32, bad[28..32], 2, .little);
+    try std.testing.expectError(error.BadRankFrame, decode(bad[0..bytes.len], 3, &out));
+}
