--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rank_seqs.zig
@@ -0,0 +1,139 @@
+//! TF_FLASHNEXT_TP_SEQ_KEEP=1 (--tp 2): a rank's sequence is one device block of zeroed views (its conv windows, states,
+//! n-gram tail and attention caches), and the block of the last dropped sequence is kept for the next create instead of
+//! freed, so a request's create is one memset where it was 121 allocations and memsets (about 22 ms a rank on a GB10).
+//! Each view holds the bytes newSeq's own buffer held, zeroed on the same stream, so no byte changes and the ranks need
+//! not agree. One block is kept at most; a create that does not fit it frees it first, and a prompt-cache save frees it
+//! before its own allocation, so the kept block never stands beside more than the memory a dropped stream gave back.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const prompt = @import("cuda_prompt.zig");
+const sizes = @import("cuda_seq_bytes.zig");
+const Engine = prompt.Engine;
+const Seq = prompt.Seq;
+
+const linear_n = wt.linear_n;
+const attn_n = wt.attn_n;
+const align_to = 256;
+
+fn up(n: usize) usize {
+    return std.mem.alignForward(usize, n, align_to);
+}
+
+/// The one block a `cap`-token sequence of `e` takes: every buffer newSeq allocates, each 256-byte aligned.
+pub fn blockBytes(e: *const Engine, cap: usize) usize {
+    const h = e.heads;
+    const caches = up(sizes.keyBytesFor(e.kv, cap, h)) + up(sizes.valueBytesFor(e.kv, cap, h)) + up(sizes.indexBytesIn(cap, e.index_window)) + up(sizes.pooledBytes(cap));
+    return linear_n * (up(sizes.convBytes(h)) + up(sizes.stateBytes(h))) + attn_n * caches + up(wt.ple_tail_n * wt.wide * 2);
+}
+
+/// Whether a kept block of `len` bytes serves a sequence of `need`: big enough, and at most a quarter more.
+pub fn fits(len: usize, need: usize) bool {
+    return len >= need and len - need <= need / 4;
+}
+
+fn views(gpa: std.mem.Allocator, d: *const cuda.Driver, at: *u64, n: usize, len: usize) ![]cuda.DeviceBuffer {
+    const bs = try gpa.alloc(cuda.DeviceBuffer, n);
+    for (bs) |*b| b.* = view(d, at, len);
+    return bs;
+}
+
+fn view(d: *const cuda.Driver, at: *u64, len: usize) cuda.DeviceBuffer {
+    const b: cuda.DeviceBuffer = .{ .d = d, .ptr = at.*, .len = len, .borrowed = true };
+    at.* += up(len);
+    return b;
+}
+
+/// newSeq's sequence whose every buffer is a zeroed view of `block` (the caller's, which must outlive it).
+pub fn newSeqAt(e: *Engine, cap: usize, block: cuda.DeviceBuffer) !Seq {
+    if (cap == 0 or cap > prompt.maxTokens()) return error.UnexpectedTensor;
+    _ = try prompt.seqBytesPaged(cap, 0, e.heads);
+    const need = blockBytes(e, cap);
+    if (block.len < need) return error.UnexpectedTensor;
+    e.round_graph.clear();
+    var seq: Seq = .{
+        .stream = e.stream.*,
+        .heads = e.heads,
+        .conv = &.{},
+        .state = &.{},
+        .kc = &.{},
+        .vc = &.{},
+        .ikc = &.{},
+        .pooled = &.{},
+        .tail = .{ .d = e.driver, .ptr = 0, .len = 0 },
+        .history = .{ e.eos, e.eos },
+        .fed = 0,
+        .logits = &.{},
+        .cap = cap,
+        .kv = e.kv,
+        .window = .{ .rows = if (e.index_window != 0) @import("cuda_index_window.zig").rowsFor(cap, e.index_window) else 0 },
+    };
+    errdefer seq.deinit(e.gpa);
+    seq.logits = try e.gpa.alloc(u8, wt.vocab * 2);
+    try e.stream.d.check(e.stream.d.api.cuMemsetD8Async(block.ptr, 0, need, e.stream.handle), "cuMemsetD8Async");
+    const h = e.heads;
+    var at = block.ptr;
+    seq.conv = try views(e.gpa, e.driver, &at, linear_n, sizes.convBytes(h));
+    seq.state = try views(e.gpa, e.driver, &at, linear_n, sizes.stateBytes(h));
+    seq.kc = try views(e.gpa, e.driver, &at, attn_n, sizes.keyBytesFor(e.kv, cap, h));
+    seq.vc = try views(e.gpa, e.driver, &at, attn_n, sizes.valueBytesFor(e.kv, cap, h));
+    seq.ikc = try views(e.gpa, e.driver, &at, attn_n, sizes.indexBytesIn(cap, e.index_window));
+    seq.pooled = try views(e.gpa, e.driver, &at, attn_n, sizes.pooledBytes(cap));
+    seq.tail = view(e.driver, &at, wt.ple_tail_n * wt.wide * 2);
+    std.debug.assert(at - block.ptr == need);
+    return seq;
+}
+
+/// A rank's sequence blocks: those its live sequences stand on, by rank id, and the one kept from the last drop.
+pub const Store = struct {
+    on: bool = false,
+    idle: ?cuda.DeviceBuffer = null,
+    held: std.AutoHashMapUnmanaged(u64, cuda.DeviceBuffer) = .empty,
+
+    /// Sequence `id`'s caches at `cap` tokens: on a block (the kept one when it fits), else newSeq's own buffers.
+    pub fn make(st: *Store, e: *Engine, cap: usize, id: u64) !Seq {
+        const test_pages = try @import("cuda_pages.zig").pageTest();
+        if (!st.on or id == 0 or test_pages > 0) return e.newSeq(cap);
+        if (cap == 0 or cap > prompt.maxTokens()) return error.UnexpectedTensor;
+        if (st.held.contains(id)) return error.BadRankFrame;
+        try st.held.ensureUnusedCapacity(e.gpa, 1);
+        const need = blockBytes(e, cap);
+        const block = if (st.idle) |b| reuse: {
+            st.idle = null;
+            if (fits(b.len, need)) break :reuse b;
+            var x = b;
+            x.free();
+            break :reuse try cuda.DeviceBuffer.alloc(e.driver, need);
+        } else try cuda.DeviceBuffer.alloc(e.driver, need);
+        const q = newSeqAt(e, cap, block) catch |err| {
+            st.keep(block);
+            return err;
+        };
+        st.held.putAssumeCapacity(id, block);
+        return q;
+    }
+
+    /// Sequence `id`'s block kept for the next create, after the sequence's own deinit drained its stream.
+    pub fn give(st: *Store, id: u64) void {
+        if (st.held.fetchRemove(id)) |entry| st.keep(entry.value);
+    }
+
+    fn keep(st: *Store, b: cuda.DeviceBuffer) void {
+        st.release();
+        st.idle = b;
+    }
+
+    /// The kept block freed: before another allocation the memory ledger counts on that room for.
+    pub fn release(st: *Store) void {
+        if (st.idle) |*b| b.free();
+        st.idle = null;
+    }
+
+    /// After every sequence on a block was deinitialized.
+    pub fn deinit(st: *Store, gpa: std.mem.Allocator) void {
+        st.release();
+        var it = st.held.valueIterator();
+        while (it.next()) |b| b.free();
+        st.held.deinit(gpa);
+    }
+};
