+
+pub fn seqParMinRowsSetting(value: ?[]const u8) error{BadSeqParMinRows}!usize {
+    const v = value orelse return split_sum_min_rows;
+    if (v.len == 0 or v[0] < '0' or v[0] > '9') return error.BadSeqParMinRows;
+    const n = std.fmt.parseInt(usize, v, 10) catch return error.BadSeqParMinRows;
+    if (n < 512 or n > split_sum_min_rows or n % 128 != 0) return error.BadSeqParMinRows;
+    return n;
