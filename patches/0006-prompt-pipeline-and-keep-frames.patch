+    unsigned rb[2];
+    float rsc[2];
+    auto fetch = [&](int b, int pass) {
+        const int u = nu[b];
+#pragma unroll
+        for (int x = 0; x < 2; ++x) {
+            const int e = threadIdx.x + x * NT, s = e >> 3, c = e & 7;
+            if (s < u) {
+                const long long cs = static_cast<long long>(pkey[b][s]) * HK + hk;
+                const unsigned char* krow = KC + cs * KB;
+                if (K8 && pass == 0) {
+                    raw[x][0] = *reinterpret_cast<const uint4*>(krow + 32 * c);
+                    raw[x][K8 ? 1 : 0] = *reinterpret_cast<const uint4*>(krow + 32 * c + 16);
+                } else {
+                    const unsigned char* row = pass == 0 ? krow : VC + cs * VB4;
+                    raw[x][0] = *reinterpret_cast<const uint4*>(row + 16 * c);
+                    rb[x] = static_cast<unsigned>(row[HD / 2 + c]) | (static_cast<unsigned>(row[HD / 2 + HD / 32 + c]) << 8);
+                }
+                rsc[x] = *reinterpret_cast<const float*>(krow + KB - 16 + 4 * pass);
+            }
+        }
+    };
+    auto widen = [&](int b, int pass) {
+        const int u = nu[b];
+#pragma unroll
+        for (int x = 0; x < 2; ++x) {
+            const int e = threadIdx.x + x * NT, s = e >> 3, c = e & 7;
+            if (s < u) {
+                if (K8 && pass == 0) {
+                    const uint4 w0 = raw[x][0], w1 = raw[x][K8 ? 1 : 0];
+                    *reinterpret_cast<uint4*>(at(rows_s, s, 4 * c)) = kv8_widen8(w0.x, w0.y, rsc[x]);
+                    *reinterpret_cast<uint4*>(at(rows_s, s, 4 * c + 1)) = kv8_widen8(w0.z, w0.w, rsc[x]);
+                    *reinterpret_cast<uint4*>(at(rows_s, s, 4 * c + 2)) = kv8_widen8(w1.x, w1.y, rsc[x]);
+                    *reinterpret_cast<uint4*>(at(rows_s, s, 4 * c + 3)) = kv8_widen8(w1.z, w1.w, rsc[x]);
+                } else {
+                    uint4 lo0, lo1, hi0, hi1;
+                    kv4_widen16(raw[x][0], rb[x] & 0xFFu, rb[x] >> 8, rsc[x], lo0, lo1, hi0, hi1);
+                    *reinterpret_cast<uint4*>(at(rows_s, s, 2 * c)) = lo0;
+                    *reinterpret_cast<uint4*>(at(rows_s, s, 2 * c + 1)) = lo1;
+                    *reinterpret_cast<uint4*>(at(rows_s, s, HD / 16 + 2 * c)) = hi0;
+                    *reinterpret_cast<uint4*>(at(rows_s, s, HD / 16 + 2 * c + 1)) = hi1;
+                }
+            }
+        }
+    };
+    if (wg == 0 && lane == 0) row_n[i] = n;
+    if (dw) kid[i * TK + lane] = key_at(0);
+    for (int x = threadIdx.x; x < RB / 16; x += NT) *reinterpret_cast<uint4*>(rows_s + Z * RB + 16 * x) = make_uint4(0u, 0u, 0u, 0u);
