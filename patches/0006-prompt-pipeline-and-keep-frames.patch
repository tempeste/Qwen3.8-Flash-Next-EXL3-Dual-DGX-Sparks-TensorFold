+    const clock = Clock.start(gpu.io, cmd);
+    var rng = std.Random.DefaultPrng.init(0x3971);
+    var r = try rig.Rig.init(gpu, a, rng.random());
+    defer r.deinit();
+    var top: usize = 0;
+    for (rows_list.items) |n| top = @max(top, n);
+    const count = global / 2;
+    var k = try flash.batch_state.Kernels.load(gpu.d);
+    defer k.deinit();
+    if (k.exl3 == null) k.exl3 = try X.Kit.load(gpu.d);
+    try k.exl3.?.reserve(top);
+    var owned: [2]flash.modelopt_experts.Owned = undefined;
+    for ([_]u32{ 5, 6 }, &owned) |h, *o| {
+        const hs = try a.alloc(u32, count);
+        @memset(hs, h);
+        o.* = (try Image.init(&r, count, hs, false)).owned(gpu.d, 0, count);
+        try check.expect(o.exl3_prompt, "{s}: the prompt kernels take {d} half-bits", .{ cmd, h });
+    }
+    clock.step("kernels loaded, {d} rows reserved, two arms of {d} experts", .{ top, count });
+    const x = try r.dev(std.mem.sliceAsBytes(r.bfs(top * D, 1.0)));
+    var outs: [2]struct { act: u64, y: u64 } = undefined;
+    for (&outs) |*o| o.* = .{ .act = try r.out(top * slots * NI * 2), .y = try r.out(top * slots * D * 4) };
+    const reps = 20;
+    var compared: usize = 0;
+    for (rows_list.items) |rows| {
+        const pairs = rows * slots;
+        const picks = try r.dev(std.mem.sliceAsBytes(try localPicks(a, r.rng, rows, 0, count, global)));
+        const p = try plan(&r, pairs, count + 1);
+        for (&owned, [_][]const u8{ "2.5 bpw", "3.0 bpw" }) |*o, label| {
+            var pass: [2]Pass = undefined;
+            for (&pass, outs) |*ps, out| ps.* = .{ .s = .{ .mixed = x, .moe_act = out.act, .y = out.y }, .k = &k, .stream = r.s };
+            for (outs) |out| for ([_][2]usize{ .{ out.act, pairs * NI * 2 }, .{ out.y, pairs * D * 4 } }) |b| try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = b[0], .len = b[1] }).fill8(0xff, r.s.handle);
+            const all: flash.split_sum.Rows = .{ .r0 = 0, .n = rows };
+            try flash.moe_native.exl3Rows(&pass[0], picks, o, p, all, count + 1, @intCast(count));
+            const act0 = try r.back(u8, outs[0].act, pairs * NI * 2);
+            const y0 = try r.back(u8, outs[0].y, pairs * D * 4);
+            for (0..2) |rank| {
+                const h = flash.seq_par.halves(rows, rank);
+                for ([_]flash.split_sum.Rows{ h.own, h.peer }) |half| try flash.moe_native.exl3Rows(&pass[1], picks, o, p, half, count + 1, @intCast(count));
+                try check.sameBytes(try std.fmt.allocPrint(a, "{s}, {d} rows, rank {d}'s halves: act", .{ label, rows, rank }), try r.back(u8, outs[1].act, pairs * NI * 2), act0);
+                try check.sameBytes(try std.fmt.allocPrint(a, "{s}, {d} rows, rank {d}'s halves: y", .{ label, rows, rank }), try r.back(u8, outs[1].y, pairs * D * 4), y0);
+                compared += 1;
+            }
+            const h0 = flash.seq_par.halves(rows, 0);
+            var us: [3]f64 = undefined;
+            for ([_]flash.split_sum.Rows{ all, h0.own, h0.peer }, &us) |part, *t| {
+                for (0..2) |phase| {
+                    const t0 = check.now(gpu.io);
+                    for (0..if (phase == 0) 3 else reps) |_| try flash.moe_native.exl3Rows(&pass[1], picks, o, p, part, count + 1, @intCast(count));
+                    try r.s.synchronize();
+                    if (phase == 1) t.* = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e3 / reps;
+                }
+            }
+            const split = us[1] + us[2] - us[0];
+            std.debug.print("BENCH route-ahead {d} rows: {s}: whole {d:.1} us, own half ({d} rows) {d:.1} us, peer half {d:.1} us a layer; the split costs {d:.1} us a layer ({d:.2} ms a pass of {d} layers) against at most the gather's time hidden behind {d:.1} us of own-half experts\n", .{ rows, label, us[0], h0.own.n, us[1], us[2], split, split * chunk_layers / 1e3, chunk_layers, us[1] });
+        }
+        clock.step("{d} rows: both arms byte-equal by halves and timed", .{rows});
+    }
+    check.pass("{s}: {d} row counts x 2 arms x 2 ranks: the prompt kernels by row halves write the one call's act and y bytes", .{ cmd, compared / 4 });
+}
