+    fn ack(p: *Pair, sequence: u64, object: u64, flags: u32) !void {
+        try p.peer.sendHeader(.{ .kind = .ack, .sequence = sequence, .object = object, .flags = flags }, wire.deadline(1000));
+    }
+
+    /// Every frame rank 0 sent so far, header then payload bytes, appended to `out`.
+    fn sent(p: *Pair, out: *std.ArrayList(u8)) !void {
+        while (!p.quiet()) {
+            const h = try p.peer.receiveHeader(wire.deadline(1000));
+            try out.appendSlice(t.allocator, &(try h.encode()));
+            const at = out.items.len;
+            try out.appendNTimes(t.allocator, 0, h.bytes);
+            try p.peer.receive(out.items[at..], wire.deadline(1000));
+        }
+    }
+
+    fn next(p: *Pair) !wire.Header {
+        const h = try p.peer.receiveHeader(wire.deadline(1000));
+        var skip: [64]u8 = undefined;
+        try p.peer.receive(skip[0..h.bytes], wire.deadline(1000));
+        return h;
+    }
+};
