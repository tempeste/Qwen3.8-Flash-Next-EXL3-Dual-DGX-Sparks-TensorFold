+++ b/zig/kernels/cuda/flashnext_attn_kv4_smem.cuh
@@ -0,0 +1,337 @@
+// TF_FLASHNEXT_ATTN_KV4_SMEM: fn_attn_fused_kv4 and _kv84 for R prompt rows a block, the same bytes. A step's tiles (each
+// row's next TK keys) are deduplicated by cache slot over the rows, widened once into shared rows, and every row reads its
+// own through per-lane ldmatrix addresses. RS (or null for POS0's one sequence): a row's {sequence, first slot, slot end,
+// position}.
+#pragma once
+
+namespace fn_kv4s {
+constexpr int R = 3;
+constexpr int NT = R * 128;
+constexpr int SL = R * TK;
+constexpr int Z = SL;
+constexpr int RB = HD * 2;
+constexpr int GMAX = QR;
+__host__ __device__ constexpr int smem_bytes(int g) { return (SL + 1 + R * g) * RB + R * QR * (TK + 8) * 2; }
+static_assert(smem_bytes(GMAX) + 4096 <= 99 * 1024, "the widest group fits the opt-in limit with the static arrays");
+
+template <int N>
+__device__ __forceinline__ void bar(int id) { asm volatile("bar.sync %0, %1;\n" ::"r"(id), "n"(N) : "memory"); }
+
+__device__ __forceinline__ unsigned char* at(unsigned char* base, int row, int chunk) {
+    return base + row * RB + ((chunk ^ (row & 7)) << 4);
+}
+}  // namespace fn_kv4s
+
+template <int KVF>
+__device__ __forceinline__ void attn_kv4s(const __nv_bfloat16* __restrict__ Q, const unsigned char* __restrict__ KC,
+                                          const unsigned char* __restrict__ VC, const int* __restrict__ POS0,
+                                          const int4* __restrict__ RS, __nv_bfloat16* __restrict__ OUT,
+                                          const int* __restrict__ IDS, const int* __restrict__ NKR,
+                                          const int* __restrict__ SPR, int ROWS, int H, int HK, int G, int CH,
+                                          float SCALE, int IDW, int QSA) {
+    using namespace fn_kv4s;
+    static_assert(KVF == 2 || KVF == 3, "NVFP4 values");
+    static_assert(R <= 4, "a row's dedup warp is warp 5i");
+    constexpr int KB = key_row_bytes(KVF);
+    constexpr bool K8 = KVF == 3;
+    extern __shared__ __align__(16) unsigned char smem_raw[];
+    unsigned char* rows_s = smem_raw;
+    __nv_bfloat16 (*ps)[QR][TK + 8] = reinterpret_cast<__nv_bfloat16 (*)[QR][TK + 8]>(smem_raw + (SL + 1 + R * G) * RB);
+    __shared__ float red_m[R][4][QR], red_l[R][4][QR];
+    __shared__ int kid[SL], pkey[2][SL], nu[2], row_n[R];
+    __shared__ unsigned char slots[2][SL];
+    __shared__ unsigned fmask[R], sorted_rows[R];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+    const int i = warp >> 2, wg = warp & 3, hk = blockIdx.y;
+    const int r = blockIdx.x * R + i;
+    const bool dw = warp == 5 * i;
+    int n = 0, lo = 0;
+    bool sparse = false;
+    if (r < ROWS) {
+        int pos, hi = 0x7fffffff;
+        if (RS) {
+            const int4 d = RS[r];
+            lo = d.y;
+            hi = d.z;
+            pos = d.w;
+        } else {
+            pos = POS0[0] + r;
+        }
+        n = min(pos + 1, hi - lo);
+        if (QSA && SPR[r] != 0) {
+            sparse = true;
+            n = NKR[r];
+        }
+    }
+    const int* ids = IDS + static_cast<long long>(min(r, ROWS - 1)) * IDW;
+    auto key_at = [&](int j) {
+        const int ki = j * TK + lane;
+        const int id = ki < n ? (sparse ? ids[ki] : ki) : -1;
+        return id >= 0 ? lo + id : -1;
+    };
+    auto dedup = [&](int b) {
+        const int e = i * TK + lane;
+        const int key = kid[e];
+        const int nx = __shfl_down_sync(0xffffffffu, key, 1);
+        const bool ok = __all_sync(0xffffffffu, lane == 31 || static_cast<unsigned>(key) <= static_cast<unsigned>(nx));
+        if (lane == 0) sorted_rows[i] = ok;
+        bar<R * 32>(5);
+        int src = -1, sp = 0;
+        if (key >= 0) {
+            for (int i2 = 0; i2 < i; ++i2) {
+                if (!sorted_rows[i2]) continue;
+                const int* row = kid + i2 * TK;
+                int p = 0;
+#pragma unroll
+                for (int s = 16; s > 0; s >>= 1)
+                    if (static_cast<unsigned>(row[p + s - 1]) < static_cast<unsigned>(key)) p += s;
+                if (row[p] == key) {
+                    src = i2;
+                    sp = p;
+                    break;
+                }
+            }
+        }
+        const bool first = key >= 0 && src < 0;
+        const unsigned mine = __ballot_sync(0xffffffffu, first);
+        if (lane == 0) fmask[i] = mine;
+        bar<R * 32>(5);
+        int pre = 0, before_src = 0, total = 0;
+#pragma unroll
+        for (int i2 = 0; i2 < R; ++i2) {
+            const int c = __popc(fmask[i2]);
+            pre += i2 < i ? c : 0;
+            before_src += i2 < src ? c : 0;
+            total += c;
+        }
+        const int slot = key < 0 ? Z
+                         : first ? pre + __popc(mine & ((1u << lane) - 1u))
+                                 : before_src + __popc(fmask[src] & ((1u << sp) - 1u));
+        slots[b][e] = static_cast<unsigned char>(slot);
+        if (first) pkey[b][slot] = key;
+        if (e == 0) nu[b] = total;
+    };
