diff --git a/zig/tests/cuda/flashnext_scatter_bf16_tests.zig b/zig/tests/cuda/flashnext_scatter_bf16_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d6a9ca420eec6d5a8137d8680cb82c1d47e928c9
--- /dev/null
+++ b/zig/tests/cuda/flashnext_scatter_bf16_tests.zig
@@ -0,0 +1,254 @@
+//! tf-cuda-test flashnext-scatter-bf16 and flashnext-scatter-bf16-bench: TF_FLASHNEXT_TP_SCATTER_BF16's pieces.
+//! One GPU: fn_moe_sum_slot_bf is fn_moe_sum_slot's sum rounded to bf16 byte for byte, fn_hc_writeback_slices_bf is
+//! fn_hc_writeback_slices with the peer slice widened from those bf16 rows byte for byte, and its streams stay within a
+//! bound of the fp32 peer slice's; each kernel's time at the chunk's half rows. Two ranks: the seqpar partials'
+//! exchange as fp32 and as bf16 rows, ms a 1,536-row chunk-equivalent.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+const rank_tests = @import("flashnext_rank_tests.zig");
+const wire = flash.rank_wire;
+
+const d = 2560;
+const slots = 11;
+const streams = 4;
+const counts = [_]usize{ 1, 64, 768, 1536 };
+/// The scattered layers' scatters in one 3,072-row pass (dense_scatter and moe_scatter, the measured profile's 49 each).
+const scatters_a_pass = 98;
+const reps = 20;
+const sums_a_pass = 96;
+
+fn slotSum(r: *rig.Rig, f: cuda.Function, y: u64, wts: u64, shared: u64, out: u64, n: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(y);
+    a.add(wts);
+    a.add(@as(u64, 0));
+    a.add(@as(i32, 0));
+    a.add(shared);
+    a.add(out);
+    a.add(@as(c_int, d));
+    a.add(@as(c_int, slots));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(n), .y = d / 256 }, .block = .{ .x = 256 } }, r.s, &a);
+}
+
+fn writeback(r: *rig.Rig, f: cuda.Function, bf: bool, h: u64, hout: u64, pss: u64, br: u64, inj: u64, rs: usize, n: usize) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ h, hout, pss, br, inj }) |p| a.add(p);
+    a.add(@as(i64, @intCast(rs)));
+    a.add(@as(c_int, d));
+    a.add(@as(c_int, streams));
+    if (!bf) a.add(@as(c_int, 2));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(n), .y = d / 256 }, .block = .{ .x = 256 } }, r.s, &a);
+}
+
+fn fill(r: *rig.Rig, ptr: u64, bytes: []const u8) !void {
+    const b: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = ptr, .len = bytes.len };
+    try b.upload(0, bytes);
+}
+
+fn timed(r: *rig.Rig, comptime go: anytype, args: anytype) !f64 {
+    try @call(.auto, go, args);
+    try r.s.synchronize();
+    const t0 = check.now(r.gpu.io);
+    for (0..reps) |_| try @call(.auto, go, args);
+    try r.s.synchronize();
+    return @as(f64, @floatFromInt(check.now(r.gpu.io) - t0)) / 1e3 / reps;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rng = std.Random.DefaultPrng.init(0x3970);
+    var r = try rig.Rig.init(gpu, a, rng.random());
+    defer r.deinit();
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    var hc = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_hc);
+    defer hc.unload();
+    const slot = try batch.function("fn_moe_sum_slot");
+    const slot_bf = try batch.function("fn_moe_sum_slot_bf");
+    const wb = try hc.function("fn_hc_writeback_slices");
+    const wb_bf = try hc.function("fn_hc_writeback_slices_bf");
+    const most = counts[counts.len - 1];
+
+    const y_host = r.f32s(most * slots * d, -4, 4);
+    for (0..d) |c| {
+        y_host[(3 * slots + 1) * d + c] = if (c % 2 == 0) -0.0 else 0.0;
+        y_host[(5 * slots + 2) * d + c] = if (c % 3 == 0) 1e-40 else 3e33;
+    }
+    const wts_host = r.f32s(most * slots, 0, 1);
+    for (0..most) |row| wts_host[row * slots + slots - 1] = 1;
+    const y = try r.dev(std.mem.sliceAsBytes(y_host));
+    const wts = try r.dev(std.mem.sliceAsBytes(wts_host));
+    const shared = try r.dev(std.mem.sliceAsBytes(r.f32s(most * d, -8, 8)));
+    const f32_out = try r.out(most * d * 4);
+    const bf_out = try r.out(most * d * 2);
+    for (counts) |n| {
+        try slotSum(&r, slot, y, wts, shared, f32_out, n);
+        try slotSum(&r, slot_bf, y, wts, shared, bf_out, n);
+        const wide = try r.back(f32, f32_out, n * d);
+        const want = try a.alloc(u16, n * d);
+        for (want, wide) |*w, v| w.* = if (std.math.isNan(v)) 0x7fff else rig.bf16(v);
+        try check.sameBytes("fn_moe_sum_slot_bf is fn_moe_sum_slot rounded to bf16", std.mem.sliceAsBytes(try r.back(u16, bf_out, n * d)), std.mem.sliceAsBytes(want));
+    }
+
+    const h_host = r.bfs(most * streams * d, 2);
+    const inj_host = r.bfs(most * streams, 1);
+    const h = try r.dev(std.mem.sliceAsBytes(h_host));
+    const inj = try r.dev(std.mem.sliceAsBytes(inj_host));
+    const own = r.f32s(most * d, -3, 3);
+    const peer = r.f32s(most * d, -3, 3);
+    for (0..d) |c| peer[2 * d + c] = if (c % 2 == 0) -0.0 else 1e-40;
+    const peer_bf = try a.alloc(u16, most * d);
+    const peer_wide = try a.alloc(f32, most * d);
+    for (peer, peer_bf, peer_wide) |v, *b, *w| {
+        b.* = rig.bf16(v);
+        w.* = @floatCast(rig.bf(b.*));
+    }
+    const hout_a = try r.out(most * streams * d * 2);
+    const hout_b = try r.out(most * streams * d * 2);
+    const pss_a = try r.out(most * (d / 256) * streams * 4);
+    const pss_b = try r.out(most * (d / 256) * streams * 4);
+    const br = try r.out(2 * most * d * 4);
+    var worst_rel: f64 = 0;
+    var worst_abs: f64 = 0;
+    for (counts) |n| {
+        const rs = n * d;
+        const fill_br = struct {
+            fn go(rr: *rig.Rig, at: u64, o: []const f32, p: []const u8, rows: usize) !void {
+                try fill(rr, at, std.mem.sliceAsBytes(o[0 .. rows * d]));
+                try fill(rr, at + rows * d * 4, p);
+            }
+        }.go;
+        try fill_br(&r, br, own, std.mem.sliceAsBytes(peer_wide[0 .. n * d]), n);
+        try writeback(&r, wb, false, h, hout_a, pss_a, br, inj, rs, n);
+        try fill_br(&r, br, own, std.mem.sliceAsBytes(peer_bf[0 .. n * d]), n);
+        try writeback(&r, wb_bf, true, h, hout_b, pss_b, br, inj, rs, n);
+        try check.sameBytes("fn_hc_writeback_slices_bf streams are the widened peer slice's", std.mem.sliceAsBytes(try r.back(u16, hout_b, n * streams * d)), std.mem.sliceAsBytes(try r.back(u16, hout_a, n * streams * d)));
+        try check.sameBytes("fn_hc_writeback_slices_bf sums are the widened peer slice's", std.mem.sliceAsBytes(try r.back(f32, pss_b, n * (d / 256) * streams)), std.mem.sliceAsBytes(try r.back(f32, pss_a, n * (d / 256) * streams)));
+        try fill_br(&r, br, own, std.mem.sliceAsBytes(peer[0 .. n * d]), n);
+        try writeback(&r, wb, false, h, hout_a, pss_a, br, inj, rs, n);
+        const exact = try r.back(u16, hout_a, n * streams * d);
+        const got = try r.back(u16, hout_b, n * streams * d);
+        var num: f64 = 0;
+        var den: f64 = 0;
+        for (exact, got) |e, g| {
+            const diff = rig.bf(g) - rig.bf(e);
+            num += diff * diff;
+            den += rig.bf(e) * rig.bf(e);
+            worst_abs = @max(worst_abs, @abs(diff));
+        }
+        worst_rel = @max(worst_rel, @sqrt(num / @max(den, 1e-30)));
+    }
+    try check.expect(worst_rel <= 4e-3 and worst_abs <= 0.25, "bf16 peer slice against fp32: streams rel-L2 {e:.3} (bound 4e-3), max |diff| {e:.3} (bound 0.25)", .{ worst_rel, worst_abs });
+    std.debug.print("RESULT scatter-bf16 streams rel_l2={e:.3} max_abs={e:.3}\n", .{ worst_rel, worst_abs });
+
+    const half = most / 2;
+    const t_slot = try timed(&r, slotSum, .{ &r, slot, y, wts, shared, f32_out, half });
+    const t_slot_bf = try timed(&r, slotSum, .{ &r, slot_bf, y, wts, shared, bf_out, half });
+    try fill(&r, br, std.mem.sliceAsBytes(own[0 .. most * d]));
+    const t_wb = try timed(&r, writeback, .{ &r, wb, false, h, hout_a, pss_a, br, inj, half * d, half });
+    const t_wb_bf = try timed(&r, writeback, .{ &r, wb_bf, true, h, hout_b, pss_b, br, inj, half * d, half });
+    const per_chunk = @as(f64, scatters_a_pass) / 2 / 1e3;
+    std.debug.print("RESULT scatter-bf16 kernels rows={d} moe_sum_slot_us={d:.1} moe_sum_slot_bf_us={d:.1} writeback_us={d:.1} writeback_bf_us={d:.1} ms_per_chunk_equiv f32={d:.3} bf16={d:.3}\n", .{ half, t_slot, t_slot_bf, t_wb, t_wb_bf, (t_slot / 2 + t_wb) * per_chunk, (t_slot_bf / 2 + t_wb_bf) * per_chunk });
+    check.pass("flashnext-scatter-bf16: fn_moe_sum_slot_bf and fn_hc_writeback_slices_bf give the rounded and widened fp32 bytes at 1 to 1,536 rows (signed zeros, subnormals); the bf16 peer slice stays within rel-L2 4e-3 of fp32", .{});
+}
+
+/// Both ranks: `n`-row partial exchanges (seq_par.partialsAs' pieces) as fp32 and bf16, back to back on one stream.
+pub fn bench(gpu: check.Gpu, rank: usize, port: u16) !void {
+    const link = try wire.Link.open(gpu.io, rank_tests.rankHost(), port, rank, 30_000);
+    defer link.close();
+    var c = try flash.collective.Collective.init(link, rank, 30_000);
+    defer c.deinit();
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    if (std.c.getenv("TF_FLASHNEXT_TP_ROCE")) |v| if (std.mem.eql(u8, std.mem.span(v), "1")) {
+        try c.openRoce(gpu.gpa, gpu.io, gpu.d, true, 4096 * 1024);
+    };
+    const most = 3072;
+    var part = try cuda.DeviceBuffer.alloc(gpu.d, 2 * most * d * 4);
+    defer part.free();
+    try part.fill8(0, stream.handle);
+    try stream.synchronize();
+    var seq: usize = 2000;
+    std.debug.print("rank {d}: RESULT scatter-bf16-bench rows dtype bytes_sent us_a_call GBps ms_per_chunk_equiv\n", .{rank});
+    var per: [2]f64 = .{ 0, 0 };
+    for ([_]usize{ 1536, 3072 }) |n| for ([_]cuda.nccl.DataType{ .f32, .bf16 }, 0..) |dt, di| {
+        const h0: usize = n / 2;
+        const own_r0: usize = if (rank == 0) 0 else h0;
+        const peer_r0: usize = if (rank == 0) h0 else 0;
+        const own_n = if (rank == 0) h0 else n - h0;
+        const peer_n = n - own_n;
+        const p = [_]flash.collective.Piece{.{ .send = part.ptr + peer_r0 * d * 4, .send_n = peer_n * d, .recv = part.ptr + (n + own_r0) * d * 4, .recv_n = own_n * d, .dtype = dt }};
+        seq += 1;
+        try meet(link, rank, seq);
+        for (0..3) |_| try c.at(.dense_scatter).exchange(stream, &p);
+        try c.finish(stream);
+        seq += 1;
+        try meet(link, rank, seq);
+        const t0 = wire.now();
+        for (0..reps) |_| try c.at(.dense_scatter).exchange(stream, &p);
+        try c.finish(stream);
+        const us = @as(f64, @floatFromInt(wire.now() - t0)) / 1e3 / reps;
+        const bytes = flash.collective.pieceBytes(p[0]);
+        const chunk = us * scatters_a_pass / 2 / 1e3 * @as(f64, @floatFromInt(n)) / 3072;
+        if (n == 3072) per[di] = chunk;
+        std.debug.print("rank {d}: RESULT scatter-bf16-bench {d} {s} {d} {d:.1} {d:.2} {d:.3}\n", .{ rank, n, @tagName(dt), bytes, us, @as(f64, @floatFromInt(bytes)) / us / 1e3, chunk });
+    };
+    seq += 1;
+    try meet(link, rank, seq);
+    std.debug.print("rank {d}: RESULT scatter-bf16-bench 3072-row pass link ms_per_chunk_equiv f32={d:.3} bf16={d:.3} saved={d:.3}\n", .{ rank, per[0], per[1], per[0] - per[1] });
+    check.pass("rank {d}: seqpar partial exchanges timed as fp32 and bf16", .{rank});
+}
+
+/// Both ranks: a pass's fp32 rank sums below the seqpar rows (one all-reduce a site, 96 a pass), by the path the cap picks:
+/// TF_FLASHNEXT_TP_ROCE=1 opens RoCE at TF_FLASHNEXT_TP_ROCE_MAX_KB (unset: 4096), else NCCL alone.
+pub fn sumBench(gpu: check.Gpu, rank: usize, port: u16) !void {
+    const link = try wire.Link.open(gpu.io, rank_tests.rankHost(), port, rank, 30_000);
+    defer link.close();
+    var c = try flash.collective.Collective.init(link, rank, 30_000);
+    defer c.deinit();
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    if (flash.knobs.tpRoce()) try c.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    const cap: ?usize = if (c.roce) |g| g.max_bytes else null;
+    const rows = [_]usize{ 128, 256, 384, 546, 768, 1024, 1535 };
+    var part = try cuda.DeviceBuffer.alloc(gpu.d, rows[rows.len - 1] * d * 4);
+    defer part.free();
+    try part.fill8(0, stream.handle);
+    try stream.synchronize();
+    var seq: usize = 3000;
+    std.debug.print("rank {d}: RESULT sum-bench rows bytes path us_a_call GBps ms_per_pass\n", .{rank});
+    for (rows) |n| {
+        const bytes = n * d * 4;
+        const path = if (flash.collective.roceTakes(cap, bytes)) "roce" else "nccl";
+        seq += 1;
+        try meet(link, rank, seq);
+        for (0..3) |_| try c.at(.dense_sum).sum(stream, part.ptr, n * d);
+        try c.finish(stream);
+        seq += 1;
+        try meet(link, rank, seq);
+        const t0 = wire.now();
+        for (0..reps) |_| try c.at(.dense_sum).sum(stream, part.ptr, n * d);
+        try c.finish(stream);
+        const us = @as(f64, @floatFromInt(wire.now() - t0)) / 1e3 / reps;
+        std.debug.print("rank {d}: RESULT sum-bench {d} {d} {s} {d:.1} {d:.2} {d:.3}\n", .{ rank, n, bytes, path, us, @as(f64, @floatFromInt(bytes)) / us / 1e3, us * sums_a_pass / 1e3 });
+    }
+    seq += 1;
+    try meet(link, rank, seq);
+    check.pass("rank {d}: a small pass's rank sums timed ({s})", .{ rank, if (cap != null) "RoCE where the cap fits" else "NCCL" });
+}
+
+fn meet(link: wire.Link, rank: usize, seq: usize) !void {
+    const h: wire.Header = .{ .kind = .ready, .sequence = seq };
+    if (rank == 0) {
+        try link.sendHeader(h, wire.deadline(30_000));
+        try std.testing.expectEqualDeep(h, try link.receiveHeader(wire.deadline(30_000)));
+    } else {
+        try std.testing.expectEqualDeep(h, try link.receiveHeader(wire.deadline(30_000)));
+        try link.sendHeader(h, wire.deadline(30_000));
+    }
+}
diff --git a/zig/tests/cuda/flashnext_seq_keep_tests.zig b/zig/tests/cuda/flashnext_seq_keep_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..56565180c227a89dbc0e845622ca87eb5691564c
--- /dev/null
+++ b/zig/tests/cuda/flashnext_seq_keep_tests.zig
@@ -0,0 +1,203 @@
+//! TF_FLASHNEXT_TP_SEQ_KEEP and TF_FLASHNEXT_TP_FRAME_FIRST at --tp 2: two prompts' last rows and a decode row are
+//! byte-equal to a session with both off, on fresh blocks, on a kept block a finished stream left dirty, beside a second
+//! live stream and after a smaller cap; a reused block reads back zero and costs no device memory. Then the time of a
+//! stream's create and drop with both off and both on (the microbench). The test runs its prompts in 32-row passes on
+//! both ranks: it sets TF_FLASHNEXT_CHUNK and TF_FLASHNEXT_CHUNK_SOLO to 32 itself (and puts the caller's back after),
+//! so a served pair's TF_FLASHNEXT_CHUNK_SOLO in its env no longer leaves the engine's chunk off the identity's.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+const Session = flash.rank_engine.Session;
+
+const knobs = [_][:0]const u8{ "TF_FLASHNEXT_TP_SEQ_KEEP", "TF_FLASHNEXT_TP_FRAME_FIRST" };
+const context = 256;
+const chunk = 32;
+const chunk_text = "32";
+const pass_knobs = [_][:0]const u8{ "TF_FLASHNEXT_CHUNK", "TF_FLASHNEXT_CHUNK_SOLO" };
+const bench_cap = 4096;
+const bench_n = 12;
+
+const Rows = struct { a: []u8, b: []u8, next: []u8 };
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    var ids: [200]u32 = undefined;
+    var other: [200]u32 = undefined;
+    for (&ids, &other, 0..) |*a, *b, i| {
+        a.* = seed.items[i % seed.items.len];
+        b.* = seed.items[(i * 7 + 3) % seed.items.len];
+    }
+    for (knobs) |k| _ = env.unsetenv(k);
+    defer for (knobs) |k| {
+        _ = env.unsetenv(k);
+    };
+    var given: [pass_knobs.len]?[:0]const u8 = undefined;
+    for (pass_knobs, &given) |k, *g| {
+        g.* = if (std.c.getenv(k)) |v| std.mem.span(v) else null;
+        _ = env.setenv(k, chunk_text, 1);
+    }
+    defer for (pass_knobs, given) |k, g| {
+        if (g) |v| _ = env.setenv(k, v, 1) else _ = env.unsetenv(k);
+    };
+    if (try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2)) != chunk) return error.EngineChunk;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    const host = @import("flashnext_rank_tests.zig").rankHost();
+    const off = try Session.init(gpu.gpa, gpu.io, host, port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        off.poison();
+        off.deinit();
+        return err;
+    };
+    defer e.deinit();
+    if (e.chunk != chunk) {
+        off.poison();
+        off.deinit();
+        return error.EngineChunk;
+    }
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    const row = prompt.vocabulary * 2;
+    const want = try gpu.gpa.alloc(u8, 3 * row);
+    defer gpu.gpa.free(want);
+    const got = try gpu.gpa.alloc(u8, 3 * row);
+    defer gpu.gpa.free(got);
+    const want_rows: Rows = .{ .a = want[0..row], .b = want[row .. 2 * row], .next = want[2 * row ..] };
+    const got_rows: Rows = .{ .a = got[0..row], .b = got[row .. 2 * row], .next = got[2 * row ..] };
+    var bench_off: f64 = 0;
+    {
+        defer off.deinit();
+        try attach(gpu, off, e);
+        if (rank == 1) {
+            try off.follow(flash.Tri, tri, logits.ptr);
+        } else {
+            if (off.blocks.on or off.frame_first) return error.KnobLeaked;
+            try prompts(off, tri, &ids, &other, want_rows);
+            bench_off = try bench(gpu, off);
+        }
+    }
+    for (knobs) |k| _ = env.setenv(k, "1", 1);
+    const on = try Session.init(gpu.gpa, gpu.io, host, port + 1, rank, identity, flash.rank_engine.linkWait());
+    defer on.deinit();
+    try attach(gpu, on, e);
+    if (!on.blocks.on or on.frame_first != (rank == 0)) return error.KnobUnread;
+    if (rank == 1) {
+        try on.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed both sessions, its sequences on kept blocks in the second", .{});
+        return;
+    }
+    // fresh blocks, then the block the first pair's last stream left dirty
+    for (0..2) |pass| {
+        try prompts(on, tri, &ids, &other, got_rows);
+        try same(pass, got_rows, want_rows);
+    }
+    check.pass("kept blocks: two prompts' last rows and a decode row byte-exact on fresh and reused blocks", .{});
+    // a reused block costs no device memory and reads back zero where the last stream left its state
+    const before = cuda.usage(false).device;
+    var q = try on.create(context);
+    if (cuda.usage(false).device != before or on.blocks.idle != null) {
+        on.drop(&q);
+        return error.BlockNotReused;
+    }
+    zeroed(gpu, &stream, &q) catch |err| {
+        on.drop(&q);
+        return err;
+    };
+    // beside it a second live stream on a fresh block, interleaved chunk by chunk
+    var r = try on.create(context);
+    {
+        defer on.drop(&r);
+        defer on.drop(&q);
+        var at: usize = 0;
+        while (at < ids.len) : (at += chunk) {
+            const end = @min(at + chunk, ids.len);
+            const hooks: prompt.batch.Hooks = .{ .logits = if (end == ids.len) .last else .none };
+            try on.forward(flash.Tri, tri, &q, ids[at..end], hooks);
+            try on.forward(flash.Tri, tri, &r, other[at..end], hooks);
+        }
+        try check.sameBytes("kept block beside a live stream: prompt A's last row", q.logits, want_rows.a);
+        try check.sameBytes("kept block beside a live stream: prompt B's last row", r.logits, want_rows.b);
+    }
+    // a larger cap does not fit the kept block: it is freed and a fresh block made
+    var large = try on.create(bench_cap);
+    {
+        defer on.drop(&large);
+        try feed(on, tri, &large, &ids);
+        try check.sameBytes("a larger cap's fresh block: prompt A's last row", large.logits, want_rows.a);
+    }
+    check.pass("kept blocks: interleaved streams and a larger cap byte-exact", .{});
+    const bench_on = try bench(gpu, on);
+    check.pass("create and drop at {d} tokens, mean of {d}: {d:.2} ms off, {d:.2} ms with TP_SEQ_KEEP and TP_FRAME_FIRST", .{ bench_cap, bench_n, bench_off, bench_on });
+}
+
+fn attach(gpu: check.Gpu, s: *Session, e: *prompt.Engine) !void {
+    s.engine = e;
+    e.collective = &s.collective;
+    if (flash.knobs.tpRoce()) try s.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+}
+
+fn feed(s: *Session, tri: flash.Tri, q: *prompt.Seq, p: []const u32) !void {
+    var at: usize = 0;
+    while (at < p.len) : (at += chunk) {
+        const end = @min(at + chunk, p.len);
+        try s.forward(flash.Tri, tri, q, p[at..end], .{ .logits = if (end == p.len) .last else .none });
+    }
+}
+
+/// Each prompt alone on its own stream, created and dropped: its last row, and prompt A's decode row after it.
+fn prompts(s: *Session, tri: flash.Tri, ids: []const u32, other: []const u32, out: Rows) !void {
+    for ([_][]const u32{ ids, other }, [_][]u8{ out.a, out.b }) |p, dest| {
+        var q = try s.create(context);
+        defer s.drop(&q);
+        try feed(s, tri, &q, p);
+        @memcpy(dest, q.logits);
+        if (p.ptr == ids.ptr) {
+            try s.forward(flash.Tri, tri, &q, &.{13}, .{});
+            @memcpy(out.next, q.logits);
+        }
+    }
+}
+
+fn same(pass: usize, got: Rows, want: Rows) !void {
+    const which = if (pass == 0) "fresh" else "reused";
+    var label: [96]u8 = undefined;
+    try check.sameBytes(try std.fmt.bufPrint(&label, "{s} block: prompt A's last row", .{which}), got.a, want.a);
+    try check.sameBytes(try std.fmt.bufPrint(&label, "{s} block: prompt B's last row", .{which}), got.b, want.b);
+    try check.sameBytes(try std.fmt.bufPrint(&label, "{s} block: the decode row after prompt A", .{which}), got.next, want.next);
+}
+
+/// Every conv window, state, cache, pooled row and the tail of `q` read back zero.
+fn zeroed(gpu: check.Gpu, stream: *cuda.Stream, q: *const prompt.Seq) !void {
+    try stream.synchronize();
+    for ([_][]const cuda.DeviceBuffer{ q.conv, q.state, q.kc, q.vc, q.ikc, q.pooled, &.{q.tail} }) |bufs| for (bufs) |b| {
+        const host = try gpu.gpa.alloc(u8, b.len);
+        defer gpu.gpa.free(host);
+        try gpu.d.check(gpu.d.api.cuMemcpyDtoH_v2(host.ptr, b.ptr, b.len), "cuMemcpyDtoH");
+        if (std.mem.indexOfNone(u8, host, &.{0}) != null) return error.ReusedBlockNotZero;
+    };
+}
+
+/// Rank 0's mean wall time of a stream's create and drop at `bench_cap` tokens (rank 1 does its part meanwhile).
+fn bench(gpu: check.Gpu, s: *Session) !f64 {
+    var total: i96 = 0;
+    for (0..bench_n + 1) |i| {
+        const t0 = check.now(gpu.io);
+        var q = try s.create(bench_cap);
+        s.drop(&q);
+        if (i > 0) total += check.now(gpu.io) - t0;
+    }
+    return @as(f64, @floatFromInt(total)) / 1e6 / bench_n;
+}
diff --git a/zig/tests/cuda/flashnext_tp_small_tests.zig b/zig/tests/cuda/flashnext_tp_small_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d1e60ab893eedd324af703b7549c2a89d4eac57f
--- /dev/null
+++ b/zig/tests/cuda/flashnext_tp_small_tests.zig
@@ -0,0 +1,143 @@
+//! TF_FLASHNEXT_TP_SEQPAR_MIN_ROWS and TF_FLASHNEXT_TP_PLE_PEER at --tp 2: prompt passes of 300, 600, 1000 and 1500 rows
+//! after a cached context (TF_TP_SMALL_TEST_CACHED rows, default 81920 rounded up to whole chunks), each arm in its own
+//! session over the same engine: both knobs off, each knob alone as given, both. Each pass's last row and the next
+//! row match the off arm byte for byte (with TF_FLASHNEXT_TP_SCATTER_BF16 a seqpar pass stays within the prompt frame
+//! test's bound instead), and each pass is timed from a restored copy of the cached context. The cached context goes in
+//! passes of the engine's own chunk (TF_FLASHNEXT_CHUNK_SOLO's rows when set, as cuda_lanes_load.zig names it in the
+//! identity), so a served pair's env loads it as a served engine would.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+const Gap = @import("flashnext_prompt_frame_tests.zig").Gap;
+
+const rows_knob = "TF_FLASHNEXT_TP_SEQPAR_MIN_ROWS";
+const peer_knob = "TF_FLASHNEXT_TP_PLE_PEER";
+const bound: struct { rel: f64, max: f64 } = .{ .rel = 2e-2, .max = 0.5 };
+const passes = [_]usize{ 300, 600, 1000, 1500 };
+const reps = 3;
+
+const Arm = struct { name: []const u8, rows: bool, peer: bool };
+const arms = [_]Arm{ .{ .name = "off", .rows = false, .peer = false }, .{ .name = "seqpar-min-rows", .rows = true, .peer = false }, .{ .name = "ple-peer", .rows = false, .peer = true }, .{ .name = "both", .rows = true, .peer = true } };
+
+fn cachedChunks(chunk: usize) !usize {
+    const want = if (std.c.getenv("TF_TP_SMALL_TEST_CACHED")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else 81920;
+    return std.math.divCeil(usize, @max(want, 1), chunk) catch unreachable;
+}
+
+fn setArm(a: Arm, rows: ?[:0]const u8) void {
+    if (a.rows) _ = env.setenv(rows_knob, rows.?, 1) else _ = env.unsetenv(rows_knob);
+    if (a.peer) _ = env.setenv(peer_knob, "1", 1) else _ = env.unsetenv(peer_knob);
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const knobs = flash.knobs;
+    const rows_given: ?[:0]const u8 = if (std.c.getenv(rows_knob)) |v| std.mem.span(v) else null;
+    const min_rows = try knobs.tpSeqParMinRows();
+    const peer_given = try knobs.tpPlePeer();
+    if (rows_given == null and !peer_given) {
+        std.debug.print("FAIL flashnext-tp-small needs {s}=R or {s}=1 (or both) on both ranks\n", .{ rows_knob, peer_knob });
+        return error.TestFailed;
+    }
+    const bf16 = try knobs.tpScatterBf16();
+    defer {
+        if (rows_given) |v| _ = env.setenv(rows_knob, v, 1) else _ = env.unsetenv(rows_knob);
+        if (peer_given) _ = env.setenv(peer_knob, "1", 1) else _ = env.unsetenv(peer_knob);
+    }
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const cached = chunk * try cachedChunks(chunk);
+    const context = cached + passes[passes.len - 1] + 64;
+    if (context > prompt.max_tokens) return error.BadPrompt;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, cached + passes[passes.len - 1]);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*a, i| a.* = seed.items[i % seed.items.len];
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank);
+    defer e.deinit();
+    if (e.chunk != chunk) return error.EngineChunk;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    const row = prompt.vocabulary * 2;
+    var want: [passes.len][2][]u8 = undefined;
+    for (&want) |*w| for (w) |*r| {
+        r.* = try gpu.gpa.alloc(u8, row);
+    };
+    defer for (want) |w| for (w) |r| gpu.gpa.free(r);
+    const got = try gpu.gpa.alloc(u8, row);
+    defer gpu.gpa.free(got);
+    var ms: [arms.len][passes.len]f64 = @splat(@splat(0));
+    var ran: [arms.len]bool = @splat(false);
+    for (arms, 0..) |a, ai| {
+        if ((a.rows and rows_given == null) or (a.peer and !peer_given)) continue;
+        setArm(a, rows_given);
+        ran[ai] = true;
+        const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port + @as(u16, @intCast(ai)), rank, identity, flash.rank_engine.linkWait());
+        defer {
+            e.collective = null;
+            session.deinit();
+        }
+        session.engine = e;
+        e.collective = &session.collective;
+        if (knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+        if (rank == 1) {
+            try session.follow(flash.Tri, tri, logits.ptr);
+            check.pass("rank 1 followed the {s} arm", .{a.name});
+            continue;
+        }
+        var q = try session.create(context);
+        defer session.drop(&q);
+        var at: usize = 0;
+        while (at < cached) : (at += chunk) try session.forward(flash.Tri, tri, &q, ids[at .. at + chunk], .{ .logits = .none, .prompt = true });
+        const kept = try session.save(&q, null);
+        defer session.dropSaved(kept);
+        for (passes, 0..) |n, pi| {
+            var t: [reps]f64 = undefined;
+            for (0..reps + 1) |r| {
+                try session.restore(&q, null, kept);
+                const t0 = check.now(gpu.io);
+                try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true });
+                if (r > 0) t[r - 1] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+                if (r != 1) continue;
+                const seqpar = a.rows and n >= min_rows and flash.split_sum.takes(true, false, true, true, 0, false, n, flash.split_sum.minHalf());
+                for (0..2) |k| {
+                    if (k == 1) try session.forward(flash.Tri, tri, &q, &.{13}, .{});
+                    if (ai == 0) {
+                        @memcpy(want[pi][k], q.logits);
+                        continue;
+                    }
+                    @memcpy(got, q.logits);
+                    const what = if (k == 0) "last" else "next";
+                    if (std.mem.eql(u8, got, want[pi][k])) {
+                        check.pass("{s} arm, {d} rows (seqpar {s}): {s} row equals the off arm's byte for byte", .{ a.name, n, if (seqpar) "on" else "off", what });
+                        continue;
+                    }
+                    if (!(bf16 and seqpar)) try check.sameBytes(what, got, want[pi][k]);
+                    const g = Gap.of(got, want[pi][k]);
+                    std.debug.print("RESULT flashnext-tp-small {s} {d} rows {s} row vs off: max {e:.3} rel-L2 {e:.3} top {s}\n", .{ a.name, n, what, g.max, g.rel(), if (g.top_same) "same" else "differs" });
+                    try check.expect(g.top_same and g.rel() <= bound.rel and g.max <= bound.max, "{s} arm, {d} rows, {s} row past max {e} rel-L2 {e}", .{ a.name, n, what, bound.max, bound.rel });
+                }
+            }
+            ms[ai][pi] = check.median(&t);
+        }
+    }
+    if (rank == 1) return;
+    const min_text = rows_given orelse "unset";
+    for (arms, 0..) |a, ai| if (ran[ai]) for (passes, 0..) |n, pi| {
+        const per = 1536.0 / @as(f64, @floatFromInt(n));
+        std.debug.print("RESULT flashnext-tp-small-bench cached {d} arm {s} ({s}={s}, scatter_bf16 {d}) rows {d}: median of {d} {d:.2} ms, off {d:.2} ms, saves {d:.2} ms; per 1536-row chunk-equivalent {d:.2} ms\n", .{ cached, a.name, rows_knob, min_text, @intFromBool(bf16), n, reps, ms[ai][pi], ms[0][pi], ms[0][pi] - ms[ai][pi], per * ms[ai][pi] });
+    };
+}
diff --git a/zig/tests/cuda/flashnext_warm_tests.zig b/zig/tests/cuda/flashnext_warm_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cea47e59e2a705e31d9276a75f7f10c6ce0d7f89
--- /dev/null
+++ b/zig/tests/cuda/flashnext_warm_tests.zig
@@ -0,0 +1,63 @@
+//! tf-cuda-test flashnext-warm-bench MODEL IDS_FILE: the lane host's n-gram hints for a prompt chunk (cuda_ple_ahead.zig
+//! warm, TF_FLASHNEXT_WARM_AHEAD) timed a 3072-row chunk at a time, first over rows no chunk hinted yet and again over the
+//! same rows, then the same chunk on a thread (TF_FLASHNEXT_WARM_BESIDE): the host's time before it can queue the pass
+//! against the thread's. Each chunk's tokens are drawn from the file's, so its n-grams are mostly new rows.
+const std = @import("std");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const ahead = flash.ple_ahead;
+
+const chunk = 3072;
+const chunks = 6;
+
+fn ms(t0: i128, t1: i128) f64 {
+    return @as(f64, @floatFromInt(t1 - t0)) / 1e6;
+}
+
+fn now(io: std.Io) i128 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+
+pub fn bench(gpu: check.Gpu, dir: []const u8, ids_path: []const u8) !void {
+    var g = try flash.ple.Ngram.init(gpu.gpa, gpu.io, dir);
+    defer g.deinit();
+    if (g.format != .nvfp4 and g.format != .fp8) {
+        std.debug.print("FAIL flashnext-warm-bench: the n-gram table is {s}; hints apply to NVFP4 or FP8 rows only\n", .{@tagName(g.format)});
+        return error.TestFailed;
+    }
+    g.warm_ahead = true;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len < 2) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, (2 * chunks + 1) * chunk);
+    defer gpu.gpa.free(ids);
+    var prng = std.Random.DefaultPrng.init(@intCast(@mod(now(gpu.io), 1 << 62)));
+    for (ids) |*a| a.* = seed.items[prng.random().uintLessThan(usize, seed.items.len)];
+    std.debug.print("RESULT warm-bench chunk rows first_ms again_ms beside_return_ms beside_join_ms\n", .{});
+    var first: f64 = 0;
+    var beside_host: f64 = 0;
+    for (0..chunks) |c| {
+        const from = (1 + c) * chunk;
+        const t0 = now(gpu.io);
+        ahead.warm(&g, ids, from, from + chunk);
+        const t1 = now(gpu.io);
+        ahead.warm(&g, ids, from, from + chunk);
+        const t2 = now(gpu.io);
+        const other = (1 + chunks + c) * chunk;
+        const t3 = now(gpu.io);
+        var b = ahead.beside(&g, ids, other, other + chunk);
+        const t4 = now(gpu.io);
+        b.join();
+        const t5 = now(gpu.io);
+        first += ms(t0, t1);
+        beside_host += ms(t3, t4);
+        std.debug.print("RESULT warm-bench {d} {d} {d:.2} {d:.2} {d:.3} {d:.2}\n", .{ c, chunk, ms(t0, t1), ms(t1, t2), ms(t3, t4), ms(t3, t5) });
+    }
+    const k: f64 = chunks;
+    std.debug.print("RESULT warm-bench mean: {d:.2} ms on the lane host before a 3072-row chunk is queued, {d:.3} ms with the hints beside it\n", .{ first / k, beside_host / k });
+    check.pass("n-gram hints timed for {d} chunks of {d} rows", .{ chunks, chunk });
+}
diff --git a/zig/tests/cuda/lane_tile_tests.zig b/zig/tests/cuda/lane_tile_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..005880e171314d30d953c896aa692f07d3ccc38f
--- /dev/null
+++ b/zig/tests/cuda/lane_tile_tests.zig
@@ -0,0 +1,295 @@
+//! TF_FLASHNEXT_LANE_TILE at the Qwen3.8 Flash Next rank's lane shapes: the MXFP8 lane tile at 64 and 128 rows byte for
+//! byte against the lane kernel, TF_FLASHNEXT_PROMPT_MX_PERM's prompt tile against mx2 at the prompt projections, and
+//! TF_FLASHNEXT_TP_GATHER_AHEAD's in projection over two row halves against one call; then ms a launch and a 3072-row
+//! chunk's worth of each (lane-tile-bench).
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const t = @import("prompt_tile2_tests.zig");
+
+const qmmf = cuda.qmmf;
+
+const Shape = struct { name: []const u8, n: usize, k: usize, sk: u32, m: usize, out: qmmf.Out, per_chunk: usize };
+
+const chunk_shapes = [_]Shape{
+    .{ .name = "out projection half", .n = 2560, .k = 3072, .sk = 0, .m = 1536, .out = .f32, .per_chunk = 96 },
+    .{ .name = "shared gate/up", .n = 320, .k = 2560, .sk = 0, .m = 3072, .out = .bf16, .per_chunk = 96 },
+    .{ .name = "shared down", .n = 2560, .k = 320, .sk = 0, .m = 3072, .out = .f32, .per_chunk = 48 },
+    .{ .name = "out projection 900 rows", .n = 2560, .k = 3072, .sk = 0, .m = 900, .out = .f32, .per_chunk = 48 },
+};
+
+const edge_shapes = [_]Shape{
+    .{ .name = "out projection 300 rows", .n = 2560, .k = 3072, .sk = 0, .m = 300, .out = .bf16, .per_chunk = 0 },
+    .{ .name = "shared gate 640", .n = 640, .k = 2560, .sk = 0, .m = 1536, .out = .f32, .per_chunk = 0 },
+    .{ .name = "odd columns", .n = 70, .k = 512, .sk = 0, .m = 77, .out = .bf16, .per_chunk = 0 },
+    .{ .name = "odd columns fused", .n = 1000, .k = 2560, .sk = 4, .m = 257, .out = .f32, .per_chunk = 0 },
+};
+
+const prompt_shapes = [_]Shape{
+    .{ .name = "DeltaNet in", .n = 8240, .k = 2560, .sk = 0, .m = 3072, .out = .bf16, .per_chunk = 36 },
+    .{ .name = "attention qkv", .n = 7296, .k = 2560, .sk = 0, .m = 3072, .out = .bf16, .per_chunk = 12 },
+    .{ .name = "DeltaNet in 900 rows", .n = 8240, .k = 2560, .sk = 0, .m = 900, .out = .bf16, .per_chunk = 36 },
+    .{ .name = "attention qkv 900 rows", .n = 7296, .k = 2560, .sk = 0, .m = 900, .out = .bf16, .per_chunk = 12 },
+};
+
+const prompt_edges = [_]Shape{
+    .{ .name = "odd prompt columns", .n = 1100, .k = 2560, .sk = 0, .m = 77, .out = .f32, .per_chunk = 0 },
+    .{ .name = "one prompt row", .n = 1024, .k = 512, .sk = 0, .m = 1, .out = .bf16, .per_chunk = 0 },
+    .{ .name = "prompt fp32 rows", .n = 8240, .k = 2560, .sk = 0, .m = 1536, .out = .f32, .per_chunk = 0 },
+};
+
+const max_n = 8320;
+
+const Rig = struct {
+    lane: qmmf.Lane,
+    s: cuda.Stream,
+    dx: cuda.DeviceBuffer,
+    dy: cuda.DeviceBuffer,
+    part: cuda.DeviceBuffer,
+    x: []u16,
+    ldx: usize,
+
+    fn init(gpu: check.Gpu, rng: std.Random, max_m: usize, max_k: usize, ldx: usize) !Rig {
+        const major = (try gpu.ctx.capability()) / 10;
+        const x = try t.activations(gpu, rng, max_m, max_k, ldx);
+        errdefer gpu.gpa.free(x);
+        var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+        errdefer dx.free();
+        var dy = try cuda.DeviceBuffer.alloc(gpu.d, max_m * max_n * 4);
+        errdefer dy.free();
+        var part = try cuda.DeviceBuffer.alloc(gpu.d, 8 * max_m * 2560 * 4);
+        errdefer part.free();
+        var lane = try qmmf.Lane.load(gpu.d, major);
+        errdefer lane.unload();
+        const s = try cuda.Stream.init(gpu.d, false);
+        return .{ .lane = lane, .s = s, .dx = dx, .dy = dy, .part = part, .x = x, .ldx = ldx };
+    }
+
+    fn deinit(r: *Rig, a: std.mem.Allocator) void {
+        r.s.deinit();
+        r.lane.unload();
+        r.part.free();
+        r.dy.free();
+        r.dx.free();
+        a.free(r.x);
+    }
+};
+
+fn weightFor(h: t.Host, sh: Shape) !qmmf.Weight {
+    return if (sh.sk == 0) h.w else try qmmf.pinned(h.w, sh.sk);
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    var prng = std.Random.DefaultPrng.init(0x1a7e_5eed);
+    const rng = prng.random();
+    var r = try Rig.init(gpu, rng, 3072, 3072, 3072 + 64);
+    defer r.deinit(a);
+    const saved = .{ qmmf.lane_tile, qmmf.lane_tile_wide, qmmf.mx2_tile, qmmf.mx_perm };
+    defer {
+        qmmf.lane_tile = saved[0];
+        qmmf.lane_tile_wide = saved[1];
+        qmmf.mx2_tile = saved[2];
+        qmmf.mx_perm = saved[3];
+    }
+    var checked: usize = 0;
+    for (chunk_shapes ++ edge_shapes) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const w = try weightFor(h, sh);
+        const p = qmmf.planFor(sh.m, w, r.lane.clusters);
+        try check.expect(p.bm == 64 and !p.cluster and !p.reduce, "{s}: plan {any} is not the lane tile's", .{ sh.name, p });
+        const bytes = sh.m * sh.n * @as(usize, if (sh.out == .f32) 4 else 2);
+        const want = try a.alloc(u8, bytes);
+        defer a.free(want);
+        const got = try a.alloc(u8, bytes);
+        defer a.free(got);
+        qmmf.lane_tile = false;
+        try r.dy.fill8(0xff, r.s.handle);
+        try r.lane.matmulOut(r.s, r.dx.ptr, r.ldx, sh.m, w, r.dy.ptr, sh.out, r.part.ptr);
+        try r.s.synchronize();
+        try r.dy.download(0, want);
+        for ([_]bool{ false, true }) |wide| {
+            try r.dy.fill8(0xff, r.s.handle);
+            try r.lane.laneTile(r.s, r.dx.ptr, r.ldx, sh.m, w, r.dy.ptr, sh.out, p.sk, wide);
+            try r.s.synchronize();
+            try r.dy.download(0, got);
+            try check.sameBytes(if (wide) "128-row lane tile against the lane kernel" else "64-row lane tile against the lane kernel", got, want);
+            qmmf.lane_tile = true;
+            qmmf.lane_tile_wide = wide;
+            try r.dy.fill8(0xff, r.s.handle);
+            try r.lane.matmulOut(r.s, r.dx.ptr, r.ldx, sh.m, w, r.dy.ptr, sh.out, r.part.ptr);
+            try r.s.synchronize();
+            try r.dy.download(0, got);
+            try check.sameBytes("matmulOut with lane_tile against the lane kernel", got, want);
+            qmmf.lane_tile = false;
+        }
+        checked += 1;
+    }
+    check.pass("TF_FLASHNEXT_LANE_TILE: the 64- and 128-row MXFP8 lane tiles equal the lane kernel byte for byte on {d} shapes (out projection K 3072 in its 4 slices, shared expert, odd columns; bf16 and fp32; 77 to 3072 rows)", .{checked});
+    qmmf.mx2_tile = true;
+    checked = 0;
+    for (prompt_shapes ++ prompt_edges) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const bytes = sh.m * sh.n * @as(usize, if (sh.out == .f32) 4 else 2);
+        const want = try a.alloc(u8, bytes);
+        defer a.free(want);
+        const got = try a.alloc(u8, bytes);
+        defer a.free(got);
+        for ([_]bool{ false, true }, [_][]u8{ want, got }) |perm, dst| {
+            qmmf.mx_perm = perm;
+            try r.dy.fill8(0xff, r.s.handle);
+            try r.lane.matmulPrompt(r.s, r.dx.ptr, r.ldx, sh.m, h.w, r.dy.ptr, sh.out, r.part.ptr);
+            try r.s.synchronize();
+            try r.dy.download(0, dst);
+        }
+        try check.sameBytes("permuted prompt tile against mx2", got, want);
+        checked += 1;
+    }
+    check.pass("TF_FLASHNEXT_PROMPT_MX_PERM: tf_qmmf_prompt_mx2p equals tf_qmmf_prompt_mx2 byte for byte on {d} shapes (DeltaNet in, attention qkv, odd columns, one row; bf16 and fp32; 1 to 3072 rows)", .{checked});
+    checked = 0;
+    for (prompt_shapes ++ prompt_edges) |sh| {
+        if (sh.m < 2) continue;
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        try check.expect(qmmf.promptRowsApart(h.w), "{s}: not on the prompt tile", .{sh.name});
+        const row = sh.n * @as(usize, if (sh.out == .f32) 4 else 2);
+        const want = try a.alloc(u8, sh.m * row);
+        defer a.free(want);
+        const got = try a.alloc(u8, sh.m * row);
+        defer a.free(got);
+        for ([_]bool{ false, true }) |perm| {
+            qmmf.mx_perm = perm;
+            try r.dy.fill8(0xff, r.s.handle);
+            try r.lane.matmulPrompt(r.s, r.dx.ptr, r.ldx, sh.m, h.w, r.dy.ptr, sh.out, r.part.ptr);
+            try r.s.synchronize();
+            try r.dy.download(0, want);
+            for ([_]usize{ @max(1, sh.m / 2 / 128 * 128), sh.m / 2 + 1 }) |cut| {
+                try r.dy.fill8(0xff, r.s.handle);
+                const peer_first = cut % 2 == 1;
+                const halves = [2][2]usize{ .{ 0, cut }, .{ cut, sh.m - cut } };
+                for (0..2) |j| {
+                    const hv = halves[if (peer_first) 1 - j else j];
+                    try r.lane.matmulPrompt(r.s, r.dx.ptr + hv[0] * r.ldx * 2, r.ldx, hv[1], h.w, r.dy.ptr + hv[0] * row, sh.out, r.part.ptr);
+                }
+                try r.s.synchronize();
+                try r.dy.download(0, got);
+                try check.sameBytes("prompt tile over two row halves against one call", got, want);
+            }
+        }
+        checked += 1;
+    }
+    check.pass("TF_FLASHNEXT_TP_GATHER_AHEAD: the prompt tile over a row split (own half, then peer half; either order) equals one call byte for byte on {d} shapes (DeltaNet in, attention qkv, odd columns; mx2 and mx2p; bf16 and fp32; 77 to 3072 rows)", .{checked});
+}
+
+pub fn bench(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const reps = 20;
+    var prng = std.Random.DefaultPrng.init(0xbe4c_1a7e);
+    const rng = prng.random();
+    var r = try Rig.init(gpu, rng, 3072, 3072, 3072);
+    defer r.deinit(a);
+    const saved = .{ qmmf.lane_tile, qmmf.lane_tile_wide, qmmf.mx2_tile, qmmf.mx_perm };
+    defer {
+        qmmf.lane_tile = saved[0];
+        qmmf.lane_tile_wide = saved[1];
+        qmmf.mx2_tile = saved[2];
+        qmmf.mx_perm = saved[3];
+    }
+    var t0 = try cuda.Event.init(gpu.d, true);
+    defer t0.deinit();
+    var t1 = try cuda.Event.init(gpu.d, true);
+    defer t1.deinit();
+    const names = [_][]const u8{ "lane", "tile64", "tile128" };
+    var chunk: [3]f64 = @splat(0);
+    var small: [3]f64 = @splat(0);
+    for (chunk_shapes) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const w = try weightFor(h, sh);
+        std.debug.print("RESULT lane-tile {s} m {d} n {d} k {d}:", .{ sh.name, sh.m, sh.n, sh.k });
+        for (names, 0..) |name, vi| {
+            qmmf.lane_tile = vi != 0;
+            qmmf.lane_tile_wide = vi == 2;
+            var ms: f64 = 0;
+            for (0..2) |round| {
+                try t0.record(r.s);
+                for (0..reps) |_| try r.lane.matmulOut(r.s, r.dx.ptr, r.ldx, sh.m, w, r.dy.ptr, sh.out, r.part.ptr);
+                try t1.record(r.s);
+                try t1.synchronize();
+                if (round == 1) ms = @as(f64, try cuda.Event.elapsedMs(t0, t1)) / reps;
+            }
+            const per = ms * @as(f64, @floatFromInt(sh.per_chunk));
+            if (sh.m == 900) small[vi] += per else chunk[vi] += per;
+            std.debug.print(" {s} {d:.3} ms ({d:.0} TF)", .{ name, ms, 2.0 * @as(f64, @floatFromInt(sh.m * sh.n * sh.k)) / (ms * 1e9) });
+        }
+        std.debug.print("\n", .{});
+    }
+    qmmf.lane_tile = false;
+    std.debug.print("RESULT lane-tile a 3072-row chunk (96 out halves, 96 shared gate/up, 48 shared down):", .{});
+    for (names, chunk) |name, c| std.debug.print(" {s} {d:.2} ms", .{ name, c });
+    std.debug.print("\nRESULT lane-tile a 900-row pass's out projections (48):", .{});
+    for (names, small) |name, c| std.debug.print(" {s} {d:.2} ms", .{ name, c });
+    std.debug.print("\n", .{});
+    qmmf.mx2_tile = true;
+    const pnames = [_][]const u8{ "mx2", "mx2p" };
+    var pchunk: [2]f64 = @splat(0);
+    var psmall: [2]f64 = @splat(0);
+    for (prompt_shapes) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        std.debug.print("RESULT prompt-perm {s} m {d} n {d} k {d}:", .{ sh.name, sh.m, sh.n, sh.k });
+        for (pnames, 0..) |name, vi| {
+            qmmf.mx_perm = vi == 1;
+            var ms: f64 = 0;
+            for (0..2) |round| {
+                try t0.record(r.s);
+                for (0..reps) |_| try r.lane.matmulPrompt(r.s, r.dx.ptr, r.ldx, sh.m, h.w, r.dy.ptr, sh.out, r.part.ptr);
+                try t1.record(r.s);
+                try t1.synchronize();
+                if (round == 1) ms = @as(f64, try cuda.Event.elapsedMs(t0, t1)) / reps;
+            }
+            const per = ms * @as(f64, @floatFromInt(sh.per_chunk));
+            if (sh.m == 900) psmall[vi] += per else pchunk[vi] += per;
+            std.debug.print(" {s} {d:.3} ms ({d:.0} TF)", .{ name, ms, 2.0 * @as(f64, @floatFromInt(sh.m * sh.n * sh.k)) / (ms * 1e9) });
+        }
+        std.debug.print("\n", .{});
+    }
+    std.debug.print("RESULT prompt-perm a 3072-row chunk (36 DeltaNet in, 12 attention qkv):", .{});
+    for (pnames, pchunk) |name, c| std.debug.print(" {s} {d:.2} ms", .{ name, c });
+    std.debug.print("\nRESULT prompt-perm a 900-row pass (36 DeltaNet in, 12 attention qkv):", .{});
+    for (pnames, psmall) |name, c| std.debug.print(" {s} {d:.2} ms", .{ name, c });
+    std.debug.print("\n", .{});
+    qmmf.mx_perm = false;
+    var whole_ms: f64 = 0;
+    var split_ms: f64 = 0;
+    var own_ms: f64 = 0;
+    for (prompt_shapes[0..2]) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const half = sh.m / 2;
+        const row = sh.n * 2;
+        var ms: [3]f64 = undefined;
+        for (0..3) |vi| for (0..2) |round| {
+            try t0.record(r.s);
+            for (0..reps) |_| switch (vi) {
+                0 => try r.lane.matmulPrompt(r.s, r.dx.ptr, r.ldx, sh.m, h.w, r.dy.ptr, sh.out, r.part.ptr),
+                1 => try r.lane.matmulPrompt(r.s, r.dx.ptr, r.ldx, half, h.w, r.dy.ptr, sh.out, r.part.ptr),
+                else => {
+                    try r.lane.matmulPrompt(r.s, r.dx.ptr, r.ldx, half, h.w, r.dy.ptr, sh.out, r.part.ptr);
+                    try r.lane.matmulPrompt(r.s, r.dx.ptr + half * r.ldx * 2, r.ldx, sh.m - half, h.w, r.dy.ptr + half * row, sh.out, r.part.ptr);
+                },
+            };
+            try t1.record(r.s);
+            try t1.synchronize();
+            if (round == 1) ms[vi] = @as(f64, try cuda.Event.elapsedMs(t0, t1)) / reps;
+        };
+        const per: f64 = @floatFromInt(sh.per_chunk);
+        whole_ms += ms[0] * per;
+        own_ms += ms[1] * per;
+        split_ms += ms[2] * per;
+        std.debug.print("RESULT gather-ahead {s} m {d}: one call {d:.3} ms, own half {d:.3} ms, two halves {d:.3} ms\n", .{ sh.name, sh.m, ms[0], ms[1], ms[2] });
+    }
+    std.debug.print("RESULT gather-ahead a 3072-row chunk (36 DeltaNet in, 12 attention qkv): one call {d:.2} ms, two halves {d:.2} ms (split cost {d:.2} ms), own halves {d:.2} ms (the compute a gather can hide behind)\n", .{ whole_ms, split_ms, split_ms - whole_ms, own_ms });
+}
