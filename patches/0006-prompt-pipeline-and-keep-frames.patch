+                qmm_frag::ldmatrix4(a1, at(rows_s, qrow, 2 * ks + 2 + (lane >> 4)));
+                qmm_frag::ldmatrix4(bk, at(rows_s, ks_slot, 2 * ks + (lane >> 3)));
+                qmm_frag::mma(s, a0, bk[0], bk[1]);
+                qmm_frag::mma(s, a1, bk[2], bk[3]);
+            }
+        }
