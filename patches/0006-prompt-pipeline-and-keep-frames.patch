+fn denyNext() !?u64 {
+    const u = cuda.usage(false);
+    return cuda.memory.setAllocationLimit(u.device + u.host);
+}
+
+fn lift(limit: ?u64) void {
+    _ = cuda.memory.setAllocationLimit(limit) catch unreachable;
+}
+
+/// A stream's life on rank 0 (create, a save with the head's rows, the kept state's drop, the stream's drop): its frames
+/// and its device calls.
+fn life(first: bool, keep: bool, frames: *std.ArrayList(u8), calls: *std.ArrayList(u64)) !void {
+    var p: Pair = undefined;
+    try p.initAt(0, first, keep);
+    defer p.deinit();
+    for (1..5) |sequence| try p.ack(sequence, if (sequence == 3) 2 else 1, 0);
+    var q = try p.s.create(16);
