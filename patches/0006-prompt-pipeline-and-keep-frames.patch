+        const int qr = x / (HD / 8), c = x % (HD / 8), rr = blockIdx.x * R + qr / G;
+        qmm_frag::cp16z(at(rows_s, SL + 1 + qr, c), Q + (static_cast<long long>(min(rr, ROWS - 1)) * H + hk * G + qr % G) * HD + 8 * c, rr < ROWS);
+    }
+    qmm_frag::commit();
+    __syncthreads();
+    int steps = 0;
+#pragma unroll
+    for (int i2 = 0; i2 < R; ++i2) steps = max(steps, (row_n[i2] + TK - 1) / TK);
