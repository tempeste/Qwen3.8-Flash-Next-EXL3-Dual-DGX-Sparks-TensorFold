+const eps: f32 = 1e-6;
+
+const Lane = struct { len: usize, rows: usize };
+const sixteen: [16]Lane = @splat(.{ .len = 3000, .rows = 2 });
+const cases = [_][]const Lane{
+    &.{ .{ .len = 0, .rows = 1 }, .{ .len = 3, .rows = 2 } }, // first keys
+    &.{ .{ .len = 127, .rows = 2 }, .{ .len = 128, .rows = 16 }, .{ .len = 2040, .rows = 7 } }, // pooled blocks at edges
+    &.{ .{ .len = 2040, .rows = 2 }, .{ .len = 2100, .rows = 1 }, .{ .len = 9000, .rows = 2 }, .{ .len = 300, .rows = 40 } }, // dense beside sparse, a lane past the next tile's rows
+    &sixteen, // sixteen streams of an MTP round, all sparse
+};
+
+const Fixture = struct {
+    kv: kvf.Kv,
+    h: Heads,
+    lanes: []const Lane,
+    caches: [][4][]u8, // [lane][k, v, indexer k, pooled]
+    proj: []u16,
+    qw: []f32,
+    kw: []f32,
+    iw: []f32,
+    ikw: []f32,
+    inv: []f32,
+
+    fn rows(f: Fixture) usize {
+        var n: usize = 0;
+        for (f.lanes) |l| n += l.rows;
+        return n;
+    }
+
+    fn cap(f: Fixture) usize {
+        var n: usize = 0;
+        for (f.lanes) |l| n = @max(n, l.len + l.rows);
+        return (n + ratio - 1) / ratio * ratio;
+    }
+
+    fn make(a: std.mem.Allocator, kv: kvf.Kv, h: Heads, lanes: []const Lane, seed: u64) !Fixture {
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        var f: Fixture = .{ .kv = kv, .h = h, .lanes = lanes, .caches = try a.alloc([4][]u8, lanes.len), .proj = undefined, .qw = try weights(a, rng, head_dim), .kw = try weights(a, rng, head_dim), .iw = try weights(a, rng, index_dim), .ikw = try weights(a, rng, index_dim), .inv = try a.alloc(f32, half) };
+        const ks = kvf.keyStride(kv);
+        const vs = kvf.valueStride(kv);
+        for (f.caches) |*cs| {
+            cs[0] = try a.alloc(u8, f.cap() * h.kv * ks);
+            cs[1] = try a.alloc(u8, f.cap() * h.kv * vs);
+            for (cs[0..2]) |x| for (x) |*b| {
+                b.* = rng.int(u8) & 0x5f;
+            };
+            var at: usize = kvf.trailerAt(kv);
+            while (at < cs[0].len) : (at += ks) for (0..2) |t| {
+                const sc: f32 = 0.01 + rng.float(f32) * 0.05;
+                @memcpy(cs[0][at + t * 4 ..][0..4], std.mem.asBytes(&sc));
+            };
+            for (cs[2..4], [_]usize{ f.cap(), f.cap() / ratio }) |*x, n| {
+                const v = try a.alloc(u16, n * index_dim);
+                for (v) |*o| o.* = bf16(rng.float(f32) * 2 - 1);
+                x.* = std.mem.sliceAsBytes(v);
+            }
+        }
+        f.proj = try a.alloc(u16, f.rows() * h.projN());
+        for (f.proj) |*v| v.* = bf16((rng.float(f32) * 2 - 1) * 2);
+        for (f.inv, 0..) |*o, i| o.* = @floatCast(std.math.pow(f64, 10_000_000.0, -@as(f64, @floatFromInt(i)) / half));
+        return f;
+    }
+};
+
+fn bf16(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    return @truncate((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+fn weights(a: std.mem.Allocator, rng: std.Random, n: usize) ![]f32 {
+    const out = try a.alloc(f32, n);
+    for (out) |*x| x.* = 0.5 + rng.float(f32);
+    return out;
+}
+
+fn cdiv(x: usize, y: usize) usize {
+    return (x + y - 1) / y;
+}
+
+fn cint(v: usize) c_int {
+    return @intCast(v);
+}
+
+const Fns = struct { g: *const flash.Glue, select: cuda.Function, select_lanes: cuda.Function };
+const Way = enum { lanes, one_launch, swapped_table };
+
+fn launch(gpu: check.Gpu, s: cuda.Stream, k: Fns, f: Fixture, way: Way, a: std.mem.Allocator) ![]const u8 {
+    var rig = rig_.Rig{ .gpu = gpu, .s = s };
+    defer {
+        cuda.completion.drain(gpu.d, s, "the quantized lane contract did not drain");
+        rig.deinit();
+    }
+    const h = f.h;
+    const n = f.rows();
+    const pn = h.projN();
+    const qr_bytes = h.q * head_dim * 2;
+    const nb = flash.batch_state.scoreStride(f.cap());
+    const kv = try a.alloc([4]u64, f.lanes.len);
+    for (f.caches, kv) |cs, *o| for (cs, o) |x, *p| {
+        p.* = try rig.scratch(x.len);
+        try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = p.*, .len = x.len }).uploadAsync(0, x, s.handle);
+    };
+    const proj = try rig.input(std.mem.sliceAsBytes(f.proj));
+    const qw = try rig.input(std.mem.sliceAsBytes(f.qw));
+    const kw = try rig.input(std.mem.sliceAsBytes(f.kw));
+    const iw = try rig.input(std.mem.sliceAsBytes(f.iw));
+    const ikw = try rig.input(std.mem.sliceAsBytes(f.ikw));
+    const inv = try rig.input(std.mem.sliceAsBytes(f.inv));
+    const q = try rig.output(n * qr_bytes);
+    const iq = try rig.output(n * index_heads * index_dim * 2);
+    const ao = try rig.output(n * qr_bytes);
+    const sc = try rig.output(n * nb * 4);
+    const ids = try rig.output(n * idw * 4);
+    const nk = try rig.output(n * 4);
+    const spr = try rig.output(n * 4);
+    const po = try rig.scratch(n * nch * h.q * head_dim * 4);
+    const pm = try rig.scratch(n * nch * h.q * 4);
+    const pl = try rig.scratch(n * nch * h.q * 4);
+    if (way == .lanes) {
+        var row0: usize = 0;
+        for (f.lanes, kv) |l, cs| {
+            const pos_host: [4]i32 = .{ @intCast(l.len), 0, 0, 0 };
+            const pos = try rig.input(std.mem.sliceAsBytes(&pos_host));
+            const qr = q + row0 * qr_bytes;
+            const iqr = iq + row0 * index_heads * index_dim * 2;
+            const scr = sc + row0 * nb * 4;
+            const ends = l.len + l.rows;
+            try k.g.attnPrepQuant(f.kv, s, proj + row0 * pn * 2, pos, qw, kw, iw, inv, qr, cs[0], cs[1], iqr, cs[2], eps, l.rows, h);
+            try k.g.qsaPool(s, cs[2], cs[3], pos, ikw, inv, eps, l.rows, .{});
+            if (ends / ratio > top) try k.g.qsaScores(s, iqr, cs[3], pos, scr, nb, l.rows, @min(nb, cdiv(ends, ratio)), .{});
+            var args: cuda.Args = .{};
+            inline for (.{ scr, pos, ids + row0 * idw * 4, nk + row0 * 4, spr + row0 * 4, cint(nb), cint(idw), cint(top), cint(ratio) }) |x| args.add(x);
+            try cuda.launch.launch(k.select, .{ .grid = .{ .x = @intCast(l.rows) }, .block = .{ .x = 1024 } }, s, &args);
+            const chunks = cdiv(@min(ends, dense_keys), 512);
+            try k.g.attnChunksQuant(f.kv, s, qr, cs[0], cs[1], pos, po, pm, pl, ids + row0 * idw * 4, nk + row0 * 4, spr + row0 * 4, l.rows, h, chunks, true);
+            try k.g.attnMerge(s, po, pm, pl, pos, ao + row0 * qr_bytes, nk + row0 * 4, spr + row0 * 4, l.rows, h, true);
+            row0 += l.rows;
+        }
+    } else {
+        const tab = try a.alignedAlloc(u8, .@"16", flash.batch_state.lanes_bytes);
+        @memset(tab, 0);
+        var row0: usize = 0;
+        var max_rows: usize = 0;
+        var max_blocks: usize = 0;
+        var chunks: usize = 0;
+        for (f.lanes, 0..) |l, i| {
+            const cs = kv[if (way == .swapped_table) (i + 1) % kv.len else i];
+            table.putCaches(tab, 0, i, cs[0], cs[1], cs[2], cs[3]);
+            table.putLane(tab, i, row0, l.len, l.rows);
+            row0 += l.rows;
+            const ends = l.len + l.rows;
+            max_rows = @max(max_rows, l.rows);
+            if (ends / ratio > top) max_blocks = @max(max_blocks, @min(nb, cdiv(ends, ratio)));
+            chunks = @max(chunks, cdiv(@min(ends, dense_keys), 512));
+        }
+        const lp = try rig.input(tab);
+        const li = lp + flash.batch_state.lanes_ptrs;
+        try k.g.attnPrepLanesAt(f.kv, h, s, proj, lp, li, qw, kw, iw, inv, q, iq, eps, n);
+        try k.g.qsaPoolLanes(s, lp, li, ikw, inv, eps, f.lanes.len, max_rows);
+        if (max_blocks > 0) try k.g.qsaScoresLanes(s, iq, lp, li, sc, nb, f.lanes.len, max_rows, max_blocks);
+        var args: cuda.Args = .{};
+        inline for (.{ sc, li, ids, nk, spr, cint(nb), cint(idw), cint(top), cint(ratio) }) |x| args.add(x);
+        try cuda.launch.launch(k.select_lanes, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 1024 } }, s, &args);
+        try k.g.attnChunksLanesAt(f.kv, h, s, q, lp, li, po, pm, pl, ids, nk, spr, n, chunks);
+        try k.g.attnMergeLanesAt(h, s, po, pm, pl, li, ao, nk, spr, n);
+    }
+    var out: std.ArrayList(u8) = .empty;
+    for ([_][2]u64{ .{ q, n * qr_bytes }, .{ iq, n * index_heads * index_dim * 2 }, .{ ao, n * qr_bytes }, .{ sc, n * nb * 4 }, .{ ids, n * idw * 4 }, .{ nk, n * 4 }, .{ spr, n * 4 } }) |o| try out.appendSlice(a, try rig.bytes(o[0], o[1]));
+    for (f.caches, kv) |xs, ps| for (xs, ps) |x, p| try out.appendSlice(a, try rig.bytes(p, x.len));
+    try check.expect(try rig.intact() and !rig.overlap(), "flashnext quantized attention lanes: a launch broke a guard or overlapped", .{});
+    return out.items;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var g = try flash.Glue.load(gpu.d);
+    defer g.deinit();
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const k: Fns = .{ .g = &g, .select = try batch.function("fn_qsa_select"), .select_lanes = try batch.function("fn_qsa_select_lanes") };
+    var red = false;
+    for (kvf.Kv.quantized) |kv| for ([_]Heads{ .full, .half }) |h| for (cases, 0..) |lanes, ci| {
+        var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+        defer arena.deinit();
+        const a = arena.allocator();
+        const f = try Fixture.make(a, kv, h, lanes, 0xa74 + ci * 7 + @as(usize, @intFromEnum(kv)) * 31 + h.kv);
+        const per_lane = try launch(gpu, s, k, f, .lanes, a);
+        try check.sameBytes("flashnext quantized attention lanes: one launch against per-lane", try launch(gpu, s, k, f, .one_launch, a), per_lane);
+        if (ci == 0) red = red or !std.mem.eql(u8, try launch(gpu, s, k, f, .swapped_table, a), per_lane);
+        std.debug.print("PASS flashnext attention lanes {t}, {d} query heads over {d}: {d} lanes, {d} rows: one launch == per-lane\n", .{ kv, h.q, h.kv, lanes.len, f.rows() });
+    };
+    try check.expect(red, "flashnext quantized attention lanes: a crossed lane table went unseen (control missed)", .{});
+    std.debug.print("PASS flashnext quantized attention lanes: control RED as planted (crossed lane table)\n", .{});
+}
diff --git a/zig/tests/cuda/flashnext_ahead_tests.zig b/zig/tests/cuda/flashnext_ahead_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ece118009c050b8f8d249c0635d35c671b6db8d3
--- /dev/null
+++ b/zig/tests/cuda/flashnext_ahead_tests.zig
@@ -0,0 +1,144 @@
+//! TF_FLASHNEXT_TP_INDEX_AHEAD on the device: a fused attention group of a --tp prompt pass launched as its own row half
+//! then the peer's (cuda_index_rows.parts) writes every row's bytes of the one launch over the group, at every cache
+//! format, both heads splits and both ranks' halves; and the time of the whole launch and of the own half's (the window
+//! the selections' exchange hides behind).
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const kvf = flash.kv_format;
+const Rig = rig.Rig;
+const Heads = flash.Heads;
+const att_rows = flash.batch_state.att_rows;
+const fused_rows = flash.batch_state.fused_rows;
+const head_dim = 256;
+const cap = 3072;
+const pos0 = 1800;
+const idw = 2052;
+/// Group sizes: a whole fused group, a pass's last group off the att_rows grid, and one of two att_rows tiles.
+const groups = [_]usize{ fused_rows, 1000, 512 };
+const formats = [_]kvf.Kv{ .bf16, .fp8, .nvfp4, .fp8k_nvfp4v };
+
+comptime {
+    std.debug.assert(pos0 + fused_rows <= cap);
+}
+
+const Cache = struct { kc: u64, vc: u64 };
+
+fn cache(r: *Rig, kv: kvf.Kv, hs: Heads) !Cache {
+    const slots = cap * hs.kv;
+    if (kv == .bf16) return .{ .kc = try r.dev(std.mem.sliceAsBytes(r.bfs(slots * head_dim, 2))), .vc = try r.dev(std.mem.sliceAsBytes(r.bfs(slots * head_dim, 1))) };
+    const ks = kvf.keyStride(kv);
+    const vs = kvf.valueStride(kv);
+    const kc = try r.a.alloc(u8, slots * ks);
+    const vc = try r.a.alloc(u8, slots * vs);
+    var k: [head_dim]f32 = undefined;
+    var v: [head_dim]f32 = undefined;
+    for (0..slots) |slot| {
+        const size = std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(slot * 7 % 9)) - 4);
+        for (&k, &v) |*a, *b| {
+            a.* = (r.rng.float(f32) * 2 - 1) * size;
+            b.* = (r.rng.float(f32) * 2 - 1) * size * 0.5;
+        }
+        kvf.pack(kv, &k, &v, kc[slot * ks ..][0..ks], vc[slot * vs ..][0..vs]);
+    }
+    return .{ .kc = try r.dev(kc), .vc = try r.dev(vc) };
+}
+
+/// One group's device inputs: queries, the att_rows tiles' first positions, and the selections (every third row dense).
+const Group = struct { q: u64, pos: u64, ids: u64, nk: u64, spr: u64 };
+
+fn group(r: *Rig, hs: Heads) !Group {
+    const rows = fused_rows;
+    const ids = try r.a.alloc(i32, rows * idw);
+    const nk = try r.a.alloc(i32, rows);
+    const spr = try r.a.alloc(i32, rows);
+    for (0..rows) |row| {
+        const sparse = row % 3 != 0;
+        nk[row] = @intCast(if (sparse) idw - 1 - row % 5 else pos0 + row + 1);
+        spr[row] = @intFromBool(sparse);
+        for (0..idw) |i| ids[row * idw + i] = @intCast((i * 1237 + row * 31) % (pos0 + row + 1));
+    }
+    const pos = try r.a.alloc(i32, (rows / att_rows) * 4);
+    @memset(pos, 0);
+    for (0..rows / att_rows) |b| pos[b * 4] = @intCast(pos0 + b * att_rows);
+    return .{
+        .q = try r.dev(std.mem.sliceAsBytes(r.bfs(rows * hs.q * head_dim, 1))),
+        .pos = try r.dev(std.mem.sliceAsBytes(pos)),
+        .ids = try r.dev(std.mem.sliceAsBytes(ids)),
+        .nk = try r.dev(std.mem.sliceAsBytes(nk)),
+        .spr = try r.dev(std.mem.sliceAsBytes(spr)),
+    };
+}
+
+/// cuda_batch's fused launch over rows [r0, r0 + n) of a group (the pass's offsets: queries, outputs and selections at
+/// the rows, positions at their att_rows tile).
+fn launch(r: *Rig, g: *const flash.Glue, kv: kvf.Kv, hs: Heads, c: Cache, gr: Group, out: u64, r0: usize, n: usize) !void {
+    const qr = hs.q * head_dim * 2;
+    const pos = gr.pos + (r0 / att_rows) * 16;
+    const ids = gr.ids + r0 * idw * 4;
+    if (kv == .bf16) return g.attnFused(r.s, gr.q + r0 * qr, c.kc, c.vc, pos, out + r0 * qr, ids, gr.nk + r0 * 4, gr.spr + r0 * 4, n, hs, .{});
+    try g.attnFusedQuant(kv, r.s, gr.q + r0 * qr, c.kc, c.vc, pos, out + r0 * qr, ids, gr.nk + r0 * 4, gr.spr + r0 * 4, n, hs);
+}
+
+fn whole(r: *Rig, g: *const flash.Glue, kv: kvf.Kv, hs: Heads, c: Cache, gr: Group, out: u64, gm: usize) !void {
+    for (flash.index_rows.parts(gm, 0, false)) |p| if (p.n != 0) try launch(r, g, kv, hs, c, gr, out, p.r0, p.n);
+}
+
+fn byHalves(r: *Rig, g: *const flash.Glue, kv: kvf.Kv, hs: Heads, c: Cache, gr: Group, out: u64, gm: usize, rank: usize) !void {
+    for (flash.index_rows.parts(gm, rank, true)) |p| if (p.n != 0) try launch(r, g, kv, hs, c, gr, out, p.r0, p.n);
+}
+
+fn timeUs(r: *Rig, reps: usize, comptime f: anytype, args: anytype) !f64 {
+    try @call(.auto, f, args);
+    try r.s.synchronize();
+    const t0 = check.now(r.gpu.io);
+    for (0..reps) |_| try @call(.auto, f, args);
+    try r.s.synchronize();
+    return @as(f64, @floatFromInt(check.now(r.gpu.io) - t0)) / 1e3 / @as(f64, @floatFromInt(reps));
+}
+
+/// `flashnext-index-ahead [REPS]`: the bytes, then REPS (default 20) launches of a whole group and of rank 0's own half
+/// at --kv-cache nvfp4 and half heads (a --tp 2 rank's).
+pub fn run(gpu: check.Gpu, args: []const [:0]const u8) !void {
+    const reps = if (args.len > 0) std.fmt.parseInt(usize, args[0], 10) catch return check.expect(false, "flashnext-index-ahead: REPS {s} is not a count", .{args[0]}) else 20;
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x1a4e);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var g = try flash.Glue.load(gpu.d);
+    defer g.deinit();
+    var checked: usize = 0;
+    for ([_]Heads{ .half, .full }) |hs| {
+        const gr = try group(&r, hs);
+        const bytes = fused_rows * hs.q * head_dim * 2;
+        for (formats) |kv| {
+            const c = try cache(&r, kv, hs);
+            for (groups) |gm| {
+                const want = try r.out(bytes);
+                try whole(&r, &g, kv, hs, c, gr, want, gm);
+                const w = try r.back(u8, want, bytes);
+                for (0..2) |rank| {
+                    const got = try r.out(bytes);
+                    try byHalves(&r, &g, kv, hs, c, gr, got, gm, rank);
+                    var name_buf: [96]u8 = undefined;
+                    const name = try std.fmt.bufPrint(&name_buf, "{t} q{d}/kv{d}, {d} rows, rank {d}'s halves", .{ kv, hs.q, hs.kv, gm, rank });
+                    try check.sameBytes(name, try r.back(u8, got, bytes), w);
+                    checked += 1;
+                }
+            }
+        }
+    }
+    const hs: Heads = .half;
+    const gr = try group(&r, hs);
+    const c = try cache(&r, .nvfp4, hs);
+    const out = try r.out(fused_rows * hs.q * head_dim * 2);
+    const own = flash.index_rows.parts(fused_rows, 0, true)[0];
+    const t_whole = try timeUs(&r, reps, launch, .{ &r, &g, kvf.Kv.nvfp4, hs, c, gr, out, @as(usize, 0), @as(usize, fused_rows) });
+    const t_own = try timeUs(&r, reps, launch, .{ &r, &g, kvf.Kv.nvfp4, hs, c, gr, out, own.r0, own.n });
+    std.debug.print("BENCH index-ahead kv4 q{d}/kv{d}, {d}-row group: whole {d:.1} us, own half ({d} rows) {d:.1} us, peer half after the join {d:.1} us\n", .{ hs.q, hs.kv, fused_rows, t_whole, own.n, t_own, t_whole - t_own });
+    check.pass("flashnext-index-ahead: {d} groups (bf16, fp8, nvfp4, fp8k_nvfp4v; half and whole heads; {d}, 1000 and 512 rows; both ranks' halves) by halves equal the one launch byte for byte", .{ checked, fused_rows });
+}
