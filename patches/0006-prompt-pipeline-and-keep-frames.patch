+
+/// `flashnext-route-ahead [ROWS...]`: a rank's 256 synthetic experts (2.5 and 3.0 bpw) on the prompt kernels over
+/// ROWS rows (default 3072 1536 900): moe_native.exl3Rows on the own half then the peer's, each rank's halves, writes
+/// the act and y bytes of one call over every row; then 20 calls of the whole and of rank 0's own half timed (the
+/// window the router's gather hides behind).
+pub fn routeAhead(gpu: check.Gpu, args: []const [:0]const u8) !void {
+    const cmd = "flashnext-route-ahead";
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rows_list: std.ArrayList(usize) = .empty;
+    for (args) |s| {
+        const n = std.fmt.parseInt(usize, s, 10) catch return refuse("{s}: ROWS {s} is not a row count", .{ cmd, s });
+        if (n < 2 or n > 4096) return refuse("{s}: ROWS {d} is not in 2..4096", .{ cmd, n });
+        try rows_list.append(a, n);
+    }
