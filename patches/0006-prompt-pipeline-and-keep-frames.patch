+pub fn many(s: *Session, comptime Tri: type, tri: Tri, qs: []const *prompt.Seq, ds: []const *mtp.Draft, counts: []const usize) !void {
+    if (!s.keep_batch or qs.len > max_keeps) {
+        for (qs, ds, counts) |q, d, count| try s.keep(Tri, tri, q, d, count);
+        return;
+    }
