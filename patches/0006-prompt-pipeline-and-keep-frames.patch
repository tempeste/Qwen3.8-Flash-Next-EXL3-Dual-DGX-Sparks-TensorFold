--- /dev/null
+++ b/zig/src/core/lane_host_fill_many_test.zig
@@ -0,0 +1,73 @@
+//! Several waiting prompts' pieces in one prompt pass (`prefill_steps`, lane_host_fill.zig's manyRun).
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const LaneHost = @import("lane_host.zig").LaneHost;
+const Id = api.Id;
+const Event = api.Event;
+const Request = api.Request;
+
+const Count = struct {
+    mutex: std.Io.Mutex = .init,
+    prefilled: usize = 0,
+    done: usize = 0,
+    tokens: [4]usize = .{ 0, 0, 0, 0 },
+    fn event(ctx: *anyopaque, id: Id, e: *const Event) void {
+        const o: *@This() = @ptrCast(@alignCast(ctx));
+        o.mutex.lockUncancelable(std.testing.io);
+        defer o.mutex.unlock(std.testing.io);
+        switch (e.*) {
+            .prefilled => o.prefilled += 1,
+            .tokens => |t| o.tokens[@intCast(id)] += t.len,
+            .finished => o.done += 1,
+            else => {},
+        }
+    }
+    fn wait(o: *@This(), n: usize) void {
+        while (true) {
+            o.mutex.lockUncancelable(std.testing.io);
+            const d = o.done;
+            o.mutex.unlock(std.testing.io);
+            if (d == n) return;
+            std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+    }
+};
+
+fn serve(take: usize) !lanes.fake.Fake {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .prefill_chunks = 2, .steps_take = take };
+    errdefer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.packedSteps(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 3 });
+    var count: Count = .{};
+    const prompts = [3][6]u32{ .{ 2, 7, 1, 8, 2, 8 }, .{ 3, 1, 4, 1, 5, 9 }, .{ 1, 6, 1, 8, 0, 3 } };
+    var requests: [3]Request = undefined;
+    for (&requests, &prompts) |*r, *p| r.* = .{ .prompt = p, .max_tokens = 4 };
+    const e = host.engine();
+    for (&requests, 1..) |*r, id| try e.submit(@intCast(id), r, .{ .ctx = &count, .event = Count.event });
+    try host.start();
+    count.wait(3);
+    host.stop();
+    try std.testing.expectEqual(@as(usize, 3), count.prefilled);
+    for (count.tokens[1..]) |t| try std.testing.expectEqual(@as(usize, 4), t);
+    return target;
+}
+
+test "waiting prompts share prompt passes: every stream's chunks go in, more than one a call" {
+    var target = try serve(16);
+    defer target.deinit();
+    try std.testing.expect(target.steps_passes > 0);
+    try std.testing.expect(target.steps_streams > target.steps_passes);
+}
+
+test "a pass that gives rows to its first stream alone still fills every prompt, none waiting forever" {
+    var target = try serve(1);
+    defer target.deinit();
+    try std.testing.expect(target.steps_passes > 0);
+    try std.testing.expectEqual(target.steps_passes, target.steps_streams);
+}
