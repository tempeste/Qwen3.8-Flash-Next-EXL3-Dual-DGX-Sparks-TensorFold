 }
diff --git a/zig/tests/cuda/flashnext_overlap_tests.zig b/zig/tests/cuda/flashnext_overlap_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d539b9caaac0c78ce1f7183de28bf5787f69d0d9
--- /dev/null
+++ b/zig/tests/cuda/flashnext_overlap_tests.zig
@@ -0,0 +1,332 @@
+//! TF_FLASHNEXT_OVERLAP at --tp 2. At 8, 16 and 28 drafted windows, a long prompt fed as the planner's pieces (its
+//! sizes at no, half and full pressure, within the chunk's room beside the round) in mixed rounds leaves the same bytes
+//! as the same pieces' own passes then the windows' shared verify: every round's window scores, and the hidden streams
+//! of the prompt's next pass after the pieces (EXL3 experts at TF_EXL3_PROMPT_ROWS over 1: the streams, and a RESULT
+//! line counts the rounds whose window scores differ, cuda_prompt_mixed.zig). Then the timing: the windows' verify
+//! alone, each piece mixed and alone, and a short prompt under the threshold as one pass of the engine's chunk against
+//! passes of the busy chunk.
+//!
+//! The alone reference runs twice and must repeat its bytes (window scores, each piece's streams and the next pass's)
+//! before the mixed run is held to it; each piece's own streams are compared, not only the next pass's, and a
+//! difference prints its bf16 values, rows and largest change.
+//!
+//! A mixed round's piece keeps whole fp32 rank sums (Pass.whole_sums); alone, a piece of split_sum_min_rows rows or
+//! more takes TF_FLASHNEXT_TP_SEQPAR's row exchange, byte-equal to whole sums in fp32 but not with
+//! TF_FLASHNEXT_TP_SCATTER_BF16, which rounds the peer's partials to bf16 first. So the test turns
+//! TF_FLASHNEXT_TP_SCATTER_BF16 off on both ranks: only the alone reference ever scatters, the mixed run's bytes are
+//! production's. TF_OVERLAP_TEST_SCATTER_BF16=1 keeps it: the pieces before the first one whose alone pass scatters
+//! must still be byte-equal, and RESULT lines give the rest's difference.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mixed_plan = flash.mixed_plan;
+const Windows = @import("flashnext_mixed_table_tests.zig").Windows;
+const env = @import("sys").env;
+
+const levels = [_]usize{ 8, 16, 28 };
+const max_windows = 28;
+const pressures = [_]f64{ 0, 0.5, 1 };
+const tail_rows = 256;
+const reps = 3;
+const default_whole = 4096;
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+    ids: []const u32,
+    out: u64,
+    streams: cuda.DeviceBuffer,
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    if (std.c.getenv("TF_FLASHNEXT_OVERLAP") == null) _ = env.setenv("TF_FLASHNEXT_OVERLAP", "4096", 1);
+    if (!keepsScatterBf16() and (flash.knobs.tpScatterBf16() catch false)) {
+        _ = env.setenv("TF_FLASHNEXT_TP_SCATTER_BF16", "0", 1);
+        std.debug.print("flashnext-overlap: TF_FLASHNEXT_TP_SCATTER_BF16 off on both ranks (only the alone reference's long pieces scatter; TF_OVERLAP_TEST_SCATTER_BF16=1 keeps it)\n", .{});
+    }
+    const whole = try flash.knobs.overlapChecked();
+    if (whole == 0 or !flash.knobs.mixedRounds()) return error.BadOverlap;
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const plan = flash.overlap_plan.Plan.init(whole);
+    const context = 4 * plan.piece(1) + 2 * chunk + 4096;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, max_windows * 3 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed the overlap's mixed rounds and whole passes", .{});
+        return;
+    }
+    const round_cap = @min(flash.knobs.roundRowsCap(), chunk);
+    const room = mixed_plan.pieceRows(chunk, chunk, round_cap);
+    if (room < flash.overlap_plan.least_piece) return error.BadOverlap;
+    var pieces: [pressures.len]usize = undefined;
+    for (&pieces, pressures) |*n, p| n.* = mixed_plan.overlapPiece(plan.piece(p), 256, room);
+    const ids = try gpu.gpa.alloc(u32, context);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, @max(room, chunk) * prompt.hidden_wide * 2);
+    defer streams.free();
+    const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items, .ids = ids, .out = logits.ptr, .streams = streams };
+    std.debug.print("flashnext-overlap: threshold {d} rows, passes of {d} rows ({d} busy), round rows at most {d}, pieces {any} (room {d})\n", .{ whole, chunk, e.busy_chunk, round_cap, pieces, room });
+    for (levels) |d| {
+        const wr = @max(1, @min(3, round_cap / d));
+        for (pieces) |np| if (!mixed_plan.fits(np, d * wr, chunk)) return error.RankIdentity;
+        try compare(rig, &pieces, d, wr);
+        try bench(rig, &pieces, d, wr);
+    }
+    try benchWhole(rig, whole - 1);
+}
+
+fn digest(r: Rig, bytes: usize, scratch: []u8) !u64 {
+    const dr = r.e.driver;
+    try dr.check(dr.api.cuMemcpyDtoH_v2(scratch.ptr, r.out, bytes), "cuMemcpyDtoH");
+    return std.hash.Wyhash.hash(0, scratch[0..bytes]);
+}
+
+/// The alone reference, its repeat (which must give the same bytes) and the mixed rounds.
+const Run = enum { alone, again, mixed };
+const runs = [_]Run{ .alone, .again, .mixed };
+
+fn compare(r: Rig, pieces: []const usize, d: usize, wr: usize) !void {
+    const gpa = r.gpu.gpa;
+    const row = prompt.vocabulary * 2;
+    const wide_row = prompt.hidden_wide * 2;
+    const scratch = try gpa.alloc(u8, d * wr * row);
+    defer gpa.free(scratch);
+    var all: usize = tail_rows;
+    var most: usize = tail_rows;
+    for (pieces) |np| {
+        all += np;
+        most = @max(most, np);
+    }
+    const want = try gpa.alloc(u8, all * wide_row);
+    defer gpa.free(want);
+    const got = try gpa.alloc(u8, most * wide_row);
+    defer gpa.free(got);
+    const rounded = firstRounded(pieces);
+    if (rounded < pieces.len) std.debug.print("flashnext-overlap: {d} windows: alone, pieces {d}.. of {any} round the peer's scattered partials to bf16 (TF_FLASHNEXT_TP_SCATTER_BF16); mixed, no piece does\n", .{ d, rounded, pieces });
+    var rounds: [runs.len][pressures.len]u64 = undefined;
+    var ok = true;
+    for (runs, &rounds) |arm, *digests| {
+        var w: Windows = .{ .rows = wr };
+        try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+        defer w.deinit(r.session);
+        var p = try r.session.create(r.ids.len);
+        defer r.session.drop(&p);
+        var off: usize = 0;
+        for (pieces, digests, 0..) |np, *g, i| {
+            const at = p.fed;
+            if (arm == .mixed) {
+                try r.session.mixed(flash.Tri, r.tri, .{ .seq = &p, .ids = r.ids[at..][0..np], .streams = r.streams.ptr }, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+            } else {
+                try r.session.forward(flash.Tri, r.tri, &p, r.ids[at..][0..np], .{ .logits = .none, .streams = r.streams.ptr, .prompt = true });
+                try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+            }
+            try r.stream.synchronize();
+            g.* = try digest(r, d * wr * row, scratch);
+            var label: [160]u8 = undefined;
+            const what = try std.fmt.bufPrint(&label, "{d} windows: piece {d} ({d} rows at {d})'s streams", .{ d, i, np, at });
+            ok = try sameStreams(r, arm, what, want[off..][0 .. np * wide_row], got, arm == .mixed and i >= rounded) and ok;
+            off += np * wide_row;
+            try w.keepAll(r.session, r.tri);
+        }
+        const next_at = p.fed;
+        try r.session.forward(flash.Tri, r.tri, &p, r.ids[next_at..][0..tail_rows], .{ .logits = .none, .streams = r.streams.ptr, .prompt = true });
+        try r.stream.synchronize();
+        var next_label: [160]u8 = undefined;
+        const next = try std.fmt.bufPrint(&next_label, "{d} windows: the prompt's next pass ({d} rows at {d})'s streams", .{ d, tail_rows, next_at });
+        ok = try sameStreams(r, arm, next, want[off..][0 .. tail_rows * wide_row], got, arm == .mixed and rounded < pieces.len) and ok;
+    }
+    if (!std.mem.eql(u64, &rounds[1], &rounds[0])) {
+        std.debug.print("FAIL {d} windows: the alone reference's repeat changed {d} of {d} rounds' window scores\n", .{ d, differing(rounds[1], rounds[0]), pressures.len });
+        ok = false;
+    }
+    if (exactWindows()) {
+        if (!std.mem.eql(u64, &rounds[2], &rounds[0])) {
+            std.debug.print("FAIL {d} windows: {d} of {d} overlap rounds' window scores in mixed rounds differ from the shared verify's\n", .{ d, differing(rounds[2], rounds[0]), pressures.len });
+            ok = false;
+        }
+    } else {
+        std.debug.print("RESULT flashnext-overlap EXL3 experts at TF_EXL3_PROMPT_ROWS over 1: {d} of {d} rounds' window scores differ from the shared verify's at {d} windows (the round takes the prompt kernels)\n", .{ differing(rounds[2], rounds[0]), pressures.len, d });
+    }
+    if (!ok) return error.TestFailed;
+    check.pass("overlap: the alone reference repeats every byte at {d} windows", .{d});
+    const windows: []const u8 = if (exactWindows()) "every round's window scores, " else "";
+    if (rounded < pieces.len) {
+        check.pass("overlap: pieces {any} in mixed rounds beside {d} windows of {d} rows keep {s}the streams of the pieces before piece {d} (from it on the alone passes round to bf16: RESULT lines)", .{ pieces, d, wr, windows, rounded });
+    } else check.pass("overlap: pieces {any} in mixed rounds beside {d} windows of {d} rows keep {s}each piece's streams and the prompt's next pass's", .{ pieces, d, wr, windows });
+}
+
+/// The pass's streams: the alone arm keeps them in `want`; another arm's must equal them, or print how they differ (a
+/// FAIL line, or a RESULT line when `rounded`: the alone pass took the bf16 scatter). False on a FAIL.
+fn sameStreams(r: Rig, arm: Run, what: []const u8, want: []u8, got: []u8, rounded: bool) !bool {
+    const dr = r.e.driver;
+    const dst = if (arm == .alone) want else got[0..want.len];
+    try dr.check(dr.api.cuMemcpyDtoH_v2(dst.ptr, r.streams.ptr, dst.len), "cuMemcpyDtoH");
+    if (arm == .alone or std.mem.eql(u8, dst, want)) return true;
+    const who: []const u8 = if (arm == .mixed) "the mixed arm" else "the alone reference's repeat";
+    const lead: []const u8 = if (rounded) "RESULT flashnext-overlap" else "FAIL";
+    const tail: []const u8 = if (rounded) " (its alone pass rounds to bf16)" else "";
+    const x = Diff.of(dst, want);
+    std.debug.print("{s} {s}: {s} differs in {d} of {d} bf16 values, {d} of {d} rows, first at row {d} column {d}; max |difference| {e} (max |value| {e}){s}\n", .{ lead, what, who, x.values, dst.len / 2, x.rows, dst.len / 2 / prompt.hidden_wide, x.first / prompt.hidden_wide, x.first % prompt.hidden_wide, x.max_diff, x.max_value, tail });
+    return rounded;
+}
+
+/// How two passes' bf16 streams differ: the values and rows, the first, the largest change and the largest value.
+const Diff = struct {
+    values: usize = 0,
+    rows: usize = 0,
+    first: usize = 0,
+    max_diff: f32 = 0,
+    max_value: f32 = 0,
+
+    fn of(got: []const u8, want: []const u8) Diff {
+        const g = std.mem.bytesAsSlice(u16, got);
+        const w = std.mem.bytesAsSlice(u16, want);
+        var x: Diff = .{};
+        var row: usize = std.math.maxInt(usize);
+        var shown: usize = 0;
+        for (g, w, 0..) |a, b, i| {
+            const y = bf16(b);
+            if (!std.math.isNan(y)) x.max_value = @max(x.max_value, @abs(y));
+            if (a == b) continue;
+            if (x.values == 0) x.first = i;
+            x.values += 1;
+            if (i / prompt.hidden_wide != row) {
+                row = i / prompt.hidden_wide;
+                x.rows += 1;
+            }
+            const v = bf16(a);
+            const change = @abs(v - y);
+            if (std.math.isNan(change)) x.max_diff = std.math.inf(f32) else x.max_diff = @max(x.max_diff, change);
+            if (shown < 4) {
+                shown += 1;
+                std.debug.print("  row {d} column {d}: {x:0>4} ({e}) for {x:0>4} ({e})\n", .{ i / prompt.hidden_wide, i % prompt.hidden_wide, a, v, b, y });
+            }
+        }
+        return x;
+    }
+};
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+fn differing(a: [pressures.len]u64, b: [pressures.len]u64) usize {
+    var n: usize = 0;
+    for (a, b) |x, y| n += @intFromBool(x != y);
+    return n;
+}
+
+/// The first of `pieces` whose alone pass rounds the peer's scattered partials to bf16 (TF_FLASHNEXT_TP_SCATTER_BF16
+/// with TF_FLASHNEXT_TP_SEQPAR and TF_FLASHNEXT_TP_SPLIT_SUM in a prompt pass, which at two ranks needs
+/// TF_FLASHNEXT_TP_PROMPT_RELAXED: cuda_prompt.zig's forward and cuda_batch.zig's begin), or pieces.len. Every later
+/// piece and the next pass read its bytes.
+fn firstRounded(pieces: []const usize) usize {
+    const k = flash.knobs;
+    const ss = flash.split_sum;
+    const on = (k.tpScatterBf16() catch false) and (k.tpSeqPar() catch false) and (k.tpSplitSum() catch false) and k.tpMoePartial() and k.tpPromptRelaxed();
+    if (!on) return pieces.len;
+    for (pieces, 0..) |np, i| if (ss.takes(true, false, true, true, 0, false, np, ss.minHalf())) return i;
+    return pieces.len;
+}
+
+fn keepsScatterBf16() bool {
+    const v = std.c.getenv("TF_OVERLAP_TEST_SCATTER_BF16") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+fn exactWindows() bool {
+    if (std.c.getenv("TF_FLASHNEXT_EXPERTS_EXL3") == null) return true;
+    const r = std.c.getenv("TF_EXL3_PROMPT_ROWS") orelse return false;
+    const v = std.mem.span(r);
+    return std.mem.eql(u8, v, "0") or std.mem.eql(u8, v, "1");
+}
+
+fn now(io: std.Io) u64 {
+    return @intCast(std.Io.Clock.awake.now(io).toNanoseconds());
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / std.time.ns_per_ms;
+}
+
+fn bench(r: Rig, pieces: []const usize, d: usize, wr: usize) !void {
+    var w: Windows = .{ .rows = wr };
+    try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+    defer w.deinit(r.session);
+    var p = try r.session.create(r.ids.len);
+    defer r.session.drop(&p);
+    var verify: u64 = 0;
+    for (0..reps + 1) |i| {
+        const t0 = now(r.gpu.io);
+        try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+        try r.stream.synchronize();
+        if (i > 0) verify += now(r.gpu.io) - t0;
+        try w.keepAll(r.session, r.tri);
+    }
+    verify /= reps;
+    for (pieces, pressures) |np, pressure| {
+        if (p.fed + 2 * np > p.cap) break;
+        var t0 = now(r.gpu.io);
+        try r.session.mixed(flash.Tri, r.tri, .{ .seq = &p, .ids = r.ids[p.fed..][0..np], .streams = r.streams.ptr }, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+        try r.stream.synchronize();
+        const mixed = now(r.gpu.io) - t0;
+        try w.keepAll(r.session, r.tri);
+        t0 = now(r.gpu.io);
+        try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..][0..np], .{ .logits = .none, .streams = r.streams.ptr, .prompt = true });
+        try r.stream.synchronize();
+        const alone = now(r.gpu.io) - t0;
+        std.debug.print("RESULT flashnext-overlap {d} windows x {d} rows, pressure {d:.1}, {d} piece rows at {d}: verify alone {d:.1} ms, piece alone {d:.1} ms, mixed {d:.1} ms ({d:.1} ms saved); mixed rounds give {d:.0} prompt tok/s at {d:.0}% of verify alone's round rate\n", .{ d, wr, pressure, np, p.fed - np, ms(verify), ms(alone), ms(mixed), ms(alone + verify) - ms(mixed), @as(f64, @floatFromInt(np)) * 1000 / ms(mixed), 100 * ms(verify) / ms(mixed) });
+    }
+}
+
+fn benchWhole(r: Rig, rows: usize) !void {
+    for ([_]usize{ r.e.chunk, r.e.busy_chunk }) |pass| {
+        var best: u64 = std.math.maxInt(u64);
+        for (0..reps) |_| {
+            var p = try r.session.create(rows + 64);
+            defer r.session.drop(&p);
+            const t0 = now(r.gpu.io);
+            while (p.fed < rows) try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..@min(rows, p.fed + pass)], .{ .logits = if (p.fed + pass >= rows) .last else .none, .prompt = true });
+            try r.stream.synchronize();
+            best = @min(best, now(r.gpu.io) - t0);
+        }
+        std.debug.print("RESULT flashnext-overlap whole prompt of {d} rows in passes of {d}: {d:.1} ms, {d:.0} prompt tok/s\n", .{ rows, pass, ms(best), @as(f64, @floatFromInt(rows)) * 1000 / ms(best) });
+    }
+}
diff --git a/zig/tests/cuda/flashnext_prompt_frame_tests.zig b/zig/tests/cuda/flashnext_prompt_frame_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a4b7e1b9877c7cf88d7e85d2327b683066271cd3
--- /dev/null
+++ b/zig/tests/cuda/flashnext_prompt_frame_tests.zig
@@ -0,0 +1,156 @@
+//! TF_FLASHNEXT_TP_PROMPT_FRAME with TF_FLASHNEXT_GDN_CHUNKED at --tp 2: a prompt's chunks run the chunked DeltaNet chain
+//! on both ranks. Rank 0's last row differs from the frame-off run's (rank 1 then keeps the fused chain), repeats byte for
+//! byte, and stays within a bound of the fused chain's on both ranks; the three runs are timed per chunk-equivalent.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+
+const frame_knob = "TF_FLASHNEXT_TP_PROMPT_FRAME";
+const bound: struct { rel: f64, max: f64 } = .{ .rel = 2e-2, .max = 0.5 };
+const reps = 3;
+
+const Arm = enum { fused, mixed, chunked };
+
+pub const Gap = struct {
+    max: f64 = 0,
+    num: f64 = 0,
+    den: f64 = 0,
+    top_same: bool = true,
+
+    pub fn of(got: []const u8, want: []const u8) Gap {
+        var g: Gap = .{};
+        var gi: usize = 0;
+        var wi: usize = 0;
+        var gm: f32 = -std.math.inf(f32);
+        var wm: f32 = -std.math.inf(f32);
+        for (0..got.len / 2) |i| {
+            const a = bf16(got, i);
+            const b = bf16(want, i);
+            if (a > gm) {
+                gm = a;
+                gi = i;
+            }
+            if (b > wm) {
+                wm = b;
+                wi = i;
+            }
+            const d: f64 = @abs(@as(f64, a) - b);
+            g.max = @max(g.max, d);
+            g.num += d * d;
+            g.den += @as(f64, b) * b;
+        }
+        g.top_same = gi == wi;
+        return g;
+    }
+
+    pub fn rel(g: Gap) f64 {
+        return @sqrt(g.num / @max(g.den, 1e-300));
+    }
+};
+
+fn bf16(row: []const u8, i: usize) f32 {
+    return @bitCast(@as(u32, std.mem.readInt(u16, row[i * 2 ..][0..2], .little)) << 16);
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    if (!try flash.knobs.gdnChunked() or !try flash.knobs.tpPromptFrame()) {
+        std.debug.print("FAIL flashnext-prompt-frame needs TF_FLASHNEXT_GDN_CHUNKED=1 and {s}=1 on both ranks\n", .{frame_knob});
+        return error.TestFailed;
+    }
+    const chunk = try flash.chunk_rows.chunkRowsAt(2);
+    const rows = 2 * chunk;
+    const context = rows + 64;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, rows);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*a, i| a.* = seed.items[i % seed.items.len];
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed prompt chunks with and without the prompt frame", .{});
+        return;
+    }
+    const row = prompt.vocabulary * 2;
+    var last: [3][]u8 = undefined;
+    var next: [3][]u8 = undefined;
+    for (&last, &next) |*l, *n| {
+        l.* = try gpu.gpa.alloc(u8, row);
+        n.* = try gpu.gpa.alloc(u8, row);
+    }
+    defer for (last, next) |l, n| {
+        gpu.gpa.free(l);
+        gpu.gpa.free(n);
+    };
+    const again = try gpu.gpa.alloc(u8, row);
+    defer gpu.gpa.free(again);
+    var ms: [3][reps]f64 = undefined;
+    for (0..reps) |r| {
+        for ([_]Arm{ .fused, .mixed, .chunked }) |arm| {
+            if (arm == .mixed) _ = env.unsetenv(frame_knob);
+            defer _ = env.setenv(frame_knob, "1", 1);
+            var q = try session.create(context);
+            defer session.drop(&q);
+            const t0 = check.now(gpu.io);
+            var at: usize = 0;
+            while (at < rows) : (at += chunk) {
+                const end = @min(at + chunk, rows);
+                try session.forward(flash.Tri, tri, &q, ids[at..end], .{ .logits = if (end == rows) .last else .none, .prompt = arm != .fused });
+            }
+            ms[@intFromEnum(arm)][r] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+            const i = @intFromEnum(arm);
+            if (r == 0) {
+                @memcpy(last[i], q.logits);
+                try session.forward(flash.Tri, tri, &q, &.{13}, .{});
+                @memcpy(next[i], q.logits);
+            } else if (arm == .chunked) {
+                @memcpy(again, q.logits);
+                try check.sameBytes("the chunked prompt's last row repeats byte for byte", again, last[i]);
+            }
+        }
+    }
+    const f = @intFromEnum(Arm.fused);
+    const m = @intFromEnum(Arm.mixed);
+    const c = @intFromEnum(Arm.chunked);
+    try check.expect(!std.mem.eql(u8, last[c], last[m]), "the prompt frame changed nothing on rank 1: the chunked run's last row equals the frame-off run's", .{});
+    check.pass("rank 1 took the chunked chain only with {s}=1 (last rows differ)", .{frame_knob});
+    const gc = Gap.of(last[c], last[f]);
+    const gm = Gap.of(last[m], last[f]);
+    const gn = Gap.of(next[c], next[f]);
+    std.debug.print("RESULT flashnext-prompt-frame {d} rows: last row vs fused, chunked both ranks max {e:.3} rel-L2 {e:.3} top {s}; rank 0 only max {e:.3} rel-L2 {e:.3} top {s}; next row max {e:.3} rel-L2 {e:.3} top {s}\n", .{ rows, gc.max, gc.rel(), if (gc.top_same) "same" else "differs", gm.max, gm.rel(), if (gm.top_same) "same" else "differs", gn.max, gn.rel(), if (gn.top_same) "same" else "differs" });
+    for ([_]Gap{ gc, gn }, [_][]const u8{ "last", "next" }) |g, what| {
+        try check.expect(g.top_same and g.rel() <= bound.rel and g.max <= bound.max, "chunked {s} row vs fused: max {e} rel-L2 {e} top {s}, past {e} / {e}", .{ what, g.max, g.rel(), if (g.top_same) "same" else "differs", bound.max, bound.rel });
+    }
+    check.pass("chunked on both ranks within max {e} rel-L2 {e} of the fused chain, same top token", .{ bound.max, bound.rel });
+    const per = 1536.0 / @as(f64, @floatFromInt(rows));
+    std.debug.print("RESULT flashnext-prompt-frame {d} rows, median of {d}: fused {d:.1} ms, rank-0-only chunked {d:.1} ms, chunked both ranks {d:.1} ms; per 1536-row chunk-equivalent {d:.2} / {d:.2} / {d:.2} ms, saves {d:.2} ms\n", .{ rows, reps, check.median(&ms[f]), check.median(&ms[m]), check.median(&ms[c]), per * check.median(&ms[f]), per * check.median(&ms[m]), per * check.median(&ms[c]), per * (check.median(&ms[f]) - check.median(&ms[c])) });
+}
diff --git a/zig/tests/cuda/flashnext_prompt_multi_tests.zig b/zig/tests/cuda/flashnext_prompt_multi_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c41c1472117ec68de224385a66bc9628c5c6851e
--- /dev/null
+++ b/zig/tests/cuda/flashnext_prompt_multi_tests.zig
@@ -0,0 +1,280 @@
+//! TF_FLASHNEXT_PROMPT_MULTI at --tp 2. Two to six prompts' pieces of 200 to 3000 rows (some after a cached prefix,
+//! some ending their prompt) go in one shared prompt pass and, against them, the same pieces one pass each: every
+//! piece's last-row scores, DeltaNet and conv state, attention keys and values and PLE tail, then each prompt's rest
+//! and four greedy tokens. A RESULT line a case says which match byte for byte and, where not, the scores' largest
+//! difference and whether the greedy tokens still agree (TF_PROMPT_MULTI_STRICT=1 fails on any difference). Then the
+//! timing: the shared pass against the sum of the pieces' own passes.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+
+const Piece = struct { prefix: usize, rows: usize, last: bool };
+const cases = [_][]const Piece{
+    &.{ .{ .prefix = 0, .rows = 200, .last = true }, .{ .prefix = 0, .rows = 575, .last = true } },
+    &.{ .{ .prefix = 2048, .rows = 1000, .last = true }, .{ .prefix = 512, .rows = 300, .last = true }, .{ .prefix = 0, .rows = 700, .last = false } },
+    &.{ .{ .prefix = 0, .rows = 2400, .last = true }, .{ .prefix = 1024, .rows = 200, .last = true }, .{ .prefix = 0, .rows = 400, .last = false } },
+    &.{ .{ .prefix = 0, .rows = 256, .last = true }, .{ .prefix = 4096, .rows = 256, .last = true }, .{ .prefix = 0, .rows = 512, .last = false }, .{ .prefix = 768, .rows = 300, .last = true }, .{ .prefix = 0, .rows = 700, .last = true }, .{ .prefix = 0, .rows = 1000, .last = true } },
+    &.{ .{ .prefix = 0, .rows = 1536, .last = true }, .{ .prefix = 3000, .rows = 1536, .last = true } },
+    &.{ .{ .prefix = 0, .rows = 1000, .last = true }, .{ .prefix = 0, .rows = 1000, .last = true }, .{ .prefix = 0, .rows = 1000, .last = true } },
+};
+const max_pieces = 6;
+const rest_rows = 96;
+const decode_tokens = 4;
+const reps = 3;
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+};
+
+/// What a sequence left after its piece and after its rest and greedy tokens.
+const Seen = struct {
+    scores: ?[]u8 = null,
+    caches: [7]u64 = @splat(0),
+    tokens: [decode_tokens]u32 = @splat(0),
+    end: []u8 = &.{},
+
+    fn deinit(x: *Seen, gpa: std.mem.Allocator) void {
+        if (x.scores) |s| gpa.free(s);
+        gpa.free(x.end);
+    }
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    if (std.c.getenv("TF_FLASHNEXT_PROMPT_MULTI") == null) _ = env.setenv("TF_FLASHNEXT_PROMPT_MULTI", "1", 1);
+    if (!try flash.knobs.promptMulti()) return error.BadPromptMulti;
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const context = 4096 + chunk + rest_rows + decode_tokens + 64;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 32 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed the shared prompt passes and their pieces alone", .{});
+        return;
+    }
+    const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items };
+    std.debug.print("flashnext-prompt-multi: passes of {d} rows ({d} busy), {d} cases\n", .{ chunk, e.busy_chunk, cases.len });
+    const strict = if (std.c.getenv("TF_PROMPT_MULTI_STRICT")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+    var exact_all = true;
+    for (cases, 0..) |c, k| {
+        var total: usize = 0;
+        for (c) |x| total += x.rows;
+        if (total > chunk or c.len > max_pieces) return error.RankIdentity;
+        const exact = try compare(rig, c, k);
+        exact_all = exact_all and exact;
+        if (strict and !exact) return error.TestFailed;
+        try bench(rig, c, k);
+    }
+    if (exact_all) {
+        check.pass("every shared prompt pass left each piece's scores, caches, rest and greedy tokens byte for byte its own pass's", .{});
+    } else check.pass("shared prompt passes ran every case (RESULT lines give where the bytes differ from the pieces' own passes)", .{});
+}
+
+fn idsOf(r: Rig, case: usize, i: usize, out: []u32) void {
+    for (out, 0..) |*v, j| v.* = r.seed[(j * 13 + 5 + 7919 * (case * max_pieces + i)) % r.seed.len];
+}
+
+fn capOf(x: Piece) usize {
+    return x.prefix + x.rows + rest_rows + decode_tokens + 16;
+}
+
+fn feed(r: Rig, q: *prompt.Seq, ids: []const u32, last: bool) !void {
+    var at: usize = 0;
+    while (at < ids.len) {
+        const stop = @min(ids.len, at + r.e.chunk);
+        try r.session.forward(flash.Tri, r.tri, q, ids[at..stop], .{ .logits = if (last and stop == ids.len) .last else .none, .prompt = true });
+        at = stop;
+    }
+}
+
+fn argmax(row: []const u8) u32 {
+    var best: u32 = 0;
+    var top: f32 = -std.math.inf(f32);
+    for (0..row.len / 2) |i| {
+        const bits = std.mem.readInt(u16, row[i * 2 ..][0..2], .little);
+        const v: f32 = @bitCast(@as(u32, bits) << 16);
+        if (v > top) {
+            top = v;
+            best = @intCast(i);
+        }
+    }
+    return best;
+}
+
+fn bufferDigest(r: Rig, bufs: []const cuda.DeviceBuffer, rows: ?usize, cap: usize, scratch: *std.ArrayList(u8)) !u64 {
+    var h = std.hash.Wyhash.init(0);
+    const dr = r.e.driver;
+    for (bufs) |b| {
+        const n = if (rows) |k| (if (b.len % cap == 0) k * (b.len / cap) else b.len) else b.len;
+        try scratch.resize(r.gpu.gpa, n);
+        try dr.check(dr.api.cuMemcpyDtoH_v2(scratch.items.ptr, b.ptr, n), "cuMemcpyDtoH");
+        h.update(scratch.items);
+    }
+    return h.final();
+}
+
+/// The pieces of `c` shared (true) or one pass each, then each prompt's rest and greedy tokens.
+fn trial(r: Rig, c: []const Piece, case: usize, shared: bool, seen: []Seen) !void {
+    const gpa = r.gpu.gpa;
+    var seqs: [max_pieces]prompt.Seq = undefined;
+    var made: usize = 0;
+    defer for (seqs[0..made]) |*q| r.session.drop(q);
+    var idss: [max_pieces][]u32 = undefined;
+    var got: usize = 0;
+    defer for (idss[0..got]) |x| gpa.free(x);
+    for (c, 0..) |x, i| {
+        idss[i] = try gpa.alloc(u32, x.prefix + x.rows + @as(usize, if (x.last) 0 else rest_rows));
+        got += 1;
+        idsOf(r, case, i, idss[i]);
+        seqs[i] = try r.session.create(capOf(x));
+        made += 1;
+        if (x.prefix > 0) try feed(r, &seqs[i], idss[i][0..x.prefix], false);
+    }
+    try r.stream.synchronize();
+    if (shared) {
+        var pieces: [max_pieces]prompt.Engine.PromptPiece = undefined;
+        for (c, 0..) |x, i| pieces[i] = .{ .seq = &seqs[i], .ids = idss[i][x.prefix..][0..x.rows], .last = x.last };
+        try r.session.prompts(flash.Tri, r.tri, pieces[0..c.len]);
+    } else for (c, 0..) |x, i| try r.session.forward(flash.Tri, r.tri, &seqs[i], idss[i][x.prefix..][0..x.rows], .{ .logits = if (x.last) .last else .none, .prompt = true });
+    try r.stream.synchronize();
+    var scratch: std.ArrayList(u8) = .empty;
+    defer scratch.deinit(gpa);
+    for (c, 0..) |x, i| {
+        const q = &seqs[i];
+        const s = &seen[i];
+        if (x.last) s.scores = try gpa.dupe(u8, q.logits[0 .. prompt.vocabulary * 2]);
+        s.caches = .{
+            try bufferDigest(r, q.state, null, q.cap, &scratch),
+            try bufferDigest(r, q.conv, null, q.cap, &scratch),
+            try bufferDigest(r, q.kc, q.fed, q.cap, &scratch),
+            try bufferDigest(r, q.vc, q.fed, q.cap, &scratch),
+            try bufferDigest(r, q.ikc, q.fed, q.cap, &scratch),
+            try bufferDigest(r, &.{q.tail}, null, q.cap, &scratch),
+            @as(u64, @bitCast(q.history[0])) ^ @as(u64, @bitCast(q.history[1])) *% 31,
+        };
+        if (!x.last) try feed(r, q, idss[i][x.prefix + x.rows ..], true);
+        for (&s.tokens) |*t| {
+            t.* = argmax(q.logits[0 .. prompt.vocabulary * 2]);
+            try r.session.forward(flash.Tri, r.tri, q, &.{t.*}, .{ .logits = .last });
+        }
+        s.end = try gpa.dupe(u8, q.logits[0 .. prompt.vocabulary * 2]);
+    }
+}
+
+fn maxDiff(a: []const u8, b: []const u8) f32 {
+    var worst: f32 = 0;
+    for (0..a.len / 2) |i| {
+        const x: f32 = @bitCast(@as(u32, std.mem.readInt(u16, a[i * 2 ..][0..2], .little)) << 16);
+        const y: f32 = @bitCast(@as(u32, std.mem.readInt(u16, b[i * 2 ..][0..2], .little)) << 16);
+        worst = @max(worst, @abs(x - y));
+    }
+    return worst;
+}
+
+fn compare(r: Rig, c: []const Piece, case: usize) !bool {
+    const gpa = r.gpu.gpa;
+    var alone: [max_pieces]Seen = @splat(.{});
+    var shared: [max_pieces]Seen = @splat(.{});
+    defer for (alone[0..c.len], shared[0..c.len]) |*a, *p| {
+        a.deinit(gpa);
+        p.deinit(gpa);
+    };
+    try trial(r, c, case, false, alone[0..c.len]);
+    try trial(r, c, case, true, shared[0..c.len]);
+    var exact = true;
+    for (c, alone[0..c.len], shared[0..c.len], 0..) |x, a, p, i| {
+        const same_scores = if (a.scores) |s| std.mem.eql(u8, s, p.scores.?) else true;
+        var caches_differ: usize = 0;
+        for (a.caches, p.caches) |u, v| caches_differ += @intFromBool(u != v);
+        const same_tokens = std.mem.eql(u32, &a.tokens, &p.tokens);
+        const same_end = std.mem.eql(u8, a.end, p.end);
+        const first_same = if (a.scores) |s| argmax(s) == argmax(p.scores.?) else true;
+        const piece_exact = same_scores and caches_differ == 0 and same_tokens and same_end;
+        exact = exact and piece_exact;
+        std.debug.print("RESULT flashnext-prompt-multi case {d} piece {d} ({d} rows after {d}, {s}): {s}; scores {s} (largest difference {d:.4}, first token {s}), {d} of 7 caches differ, greedy tokens {s}, scores after them {s} (largest difference {d:.4})\n", .{
+            case,                                                   i,                                       x.rows,                             x.prefix, if (x.last) "ends its prompt" else "mid-prompt",
+            if (piece_exact) "byte-equal" else "differs",           if (same_scores) "equal" else "differ", if (a.scores) |s| maxDiff(s, p.scores.?) else 0, if (first_same) "agrees" else "differs",
+            caches_differ,                                          if (same_tokens) "agree" else "differ", if (same_end) "equal" else "differ",
+            maxDiff(a.end, p.end),
+        });
+    }
+    return exact;
+}
+
+fn now(io: std.Io) u64 {
+    return @intCast(std.Io.Clock.awake.now(io).toNanoseconds());
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / std.time.ns_per_ms;
+}
+
+fn bench(r: Rig, c: []const Piece, case: usize) !void {
+    const gpa = r.gpu.gpa;
+    var best = [2]u64{ std.math.maxInt(u64), std.math.maxInt(u64) };
+    var rows: usize = 0;
+    for (c) |x| rows += x.rows;
+    for (0..reps + 1) |rep| for ([_]bool{ false, true }, 0..) |shared, m| {
+        var seqs: [max_pieces]prompt.Seq = undefined;
+        var made: usize = 0;
+        defer for (seqs[0..made]) |*q| r.session.drop(q);
+        var idss: [max_pieces][]u32 = undefined;
+        var got: usize = 0;
+        defer for (idss[0..got]) |x| gpa.free(x);
+        for (c, 0..) |x, i| {
+            idss[i] = try gpa.alloc(u32, x.prefix + x.rows);
+            got += 1;
+            idsOf(r, case, i, idss[i]);
+            seqs[i] = try r.session.create(capOf(x));
+            made += 1;
+            if (x.prefix > 0) try feed(r, &seqs[i], idss[i][0..x.prefix], false);
+        }
+        try r.stream.synchronize();
+        const t0 = now(r.gpu.io);
+        if (shared) {
+            var pieces: [max_pieces]prompt.Engine.PromptPiece = undefined;
+            for (c, 0..) |x, i| pieces[i] = .{ .seq = &seqs[i], .ids = idss[i][x.prefix..], .last = x.last };
+            try r.session.prompts(flash.Tri, r.tri, pieces[0..c.len]);
+        } else for (c, 0..) |x, i| {
+            try r.session.forward(flash.Tri, r.tri, &seqs[i], idss[i][x.prefix..], .{ .logits = if (x.last) .last else .none, .prompt = true });
+            try r.stream.synchronize();
+        }
+        try r.stream.synchronize();
+        if (rep > 0) best[m] = @min(best[m], now(r.gpu.io) - t0);
+    };
+    std.debug.print("RESULT flashnext-prompt-multi case {d}: {d} pieces, {d} rows: one pass each {d:.1} ms (synchronized between), shared {d:.1} ms, {d:.1} ms saved ({d:.2}x)\n", .{ case, c.len, rows, ms(best[0]), ms(best[1]), ms(best[0]) - ms(best[1]), ms(best[0]) / ms(best[1]) });
+}
