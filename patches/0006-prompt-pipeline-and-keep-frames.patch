diff --git a/zig/src/families/flashnext/cuda_ple_peer.zig b/zig/src/families/flashnext/cuda_ple_peer.zig
new file mode 100644
index 0000000000000000000000000000000000000000..06d50562f980a42a3f4185673f692afc07453e04
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_ple_peer.zig
@@ -0,0 +1,76 @@
+//! TF_FLASHNEXT_TP_PLE_PEER: a --tp 2 prompt pass's n-gram rows gathered on rank 1's host alone and sent to rank 0 at
+//! the PLE layer (cuda_knobs.tpPlePeer).
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+const coll = @import("cuda_collective.zig");
+
+const dims = wt.dims;
+const Piece = coll.Piece;
+
+/// Whether a pass takes its n-gram rows from rank 1: the knob, two ranks, a prompt pass of one sequence outside a mixed
+/// round, not a captured round.
+pub fn takes(on: bool, ranks: bool, prompt: bool, whole: bool, lanes: usize, prepared: bool) bool {
+    return on and ranks and prompt and !whole and lanes == 0 and !prepared;
+}
+
+/// Whether this rank gathers on its host: every rank unless the pass takes rank 1's rows and this is rank 0.
+pub fn gathers(peer: bool, rank: usize) bool {
+    return !peer or rank == 1;
+}
+
+/// The `n` uploaded n-gram rows at `emb` (bf16) and their 32-group scales at `xs` (fp32): rank 1 sends, rank 0 receives
+/// into the same places.
+pub fn pieces(emb: u64, xs: u64, n: usize, rank: usize) [2]Piece {
+    const out = rank == 1;
+    const e = n * dims;
+    const x = n * (dims / 32);
+    return .{
+        .{ .send = if (out) emb else 0, .send_n = if (out) e else 0, .recv = if (out) 0 else emb, .recv_n = if (out) 0 else e, .dtype = .bf16 },
+        .{ .send = if (out) xs else 0, .send_n = if (out) x else 0, .recv = if (out) 0 else xs, .recv_n = if (out) 0 else x, .dtype = .f32 },
+    };
+}
+
+/// Rank 1's gathered rows onto its device; rank 0 has none.
+pub fn upload(self: anytype) !void {
+    const s = self.s;
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    if (c.rank != 1) return;
+    try self.upload(s.ple_emb, std.mem.sliceAsBytes(self.gather.emb));
+    try self.upload(s.ple_xs, std.mem.sliceAsBytes(self.gather.xs));
+}
+
+/// The uploaded rows from rank 1 into the same places on rank 0, on the pass's stream once it has joined the sums.
+pub fn cross(self: anytype) !void {
+    const s = self.s;
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    const p = pieces(s.ple_emb, s.ple_xs, self.rows, c.rank);
+    try c.at(.ple_rows).exchange(self.stream, &p);
+}
+
+test "PLE peer: only two-rank prompt passes of one sequence outside a mixed round or a captured round take rank 1's rows, and rank 0 alone skips its gather" {
+    try std.testing.expect(takes(true, true, true, false, 0, false));
+    try std.testing.expect(!takes(false, true, true, false, 0, false));
+    try std.testing.expect(!takes(true, false, true, false, 0, false));
+    try std.testing.expect(!takes(true, true, false, false, 0, false));
+    try std.testing.expect(!takes(true, true, true, true, 0, false));
+    try std.testing.expect(!takes(true, true, true, false, 2, false));
+    try std.testing.expect(!takes(true, true, true, false, 0, true));
+    try std.testing.expect(gathers(false, 0) and gathers(false, 1) and gathers(true, 1));
+    try std.testing.expect(!gathers(true, 0));
+}
+
+test "PLE peer: rank 1 sends every row and scale, rank 0 receives them into the same places, and the pieces mirror" {
+    const emb: u64 = 0x1000_0000;
+    const xs: u64 = 0x2000_0000;
+    for ([_]usize{ 1, 300, 993, 3072 }) |n| {
+        const a = pieces(emb, xs, n, 0);
+        const b = pieces(emb, xs, n, 1);
+        try std.testing.expectEqual(Piece{ .send = 0, .send_n = 0, .recv = emb, .recv_n = n * dims, .dtype = .bf16 }, a[0]);
+        try std.testing.expectEqual(Piece{ .send = 0, .send_n = 0, .recv = xs, .recv_n = n * dims / 32, .dtype = .f32 }, a[1]);
+        try std.testing.expectEqual(Piece{ .send = emb, .send_n = n * dims, .recv = 0, .recv_n = 0, .dtype = .bf16 }, b[0]);
+        try std.testing.expectEqual(Piece{ .send = xs, .send_n = n * dims / 32, .recv = 0, .recv_n = 0, .dtype = .f32 }, b[1]);
+        for (a, b) |r, s| try std.testing.expectEqual(s.send_n, r.recv_n);
+        try std.testing.expectEqual(@as(usize, n * (dims * 2 + dims / 32 * 4)), coll.pieceBytes(b[0]) + coll.pieceBytes(b[1]));
+        try std.testing.expectEqual(@as(usize, 0), coll.pieceBytes(a[0]) + coll.pieceBytes(a[1]));
+    }
+}
