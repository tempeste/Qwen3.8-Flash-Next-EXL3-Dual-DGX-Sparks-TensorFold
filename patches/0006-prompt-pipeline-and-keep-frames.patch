+const gap_q = [64]f64{ 0.29, 0.643, 0.84, 0.994, 1.122, 1.252, 1.403, 1.541, 1.672, 1.789, 1.935, 2.086, 2.263, 2.417, 2.573, 2.771, 2.932, 3.123, 3.274, 3.494, 3.668, 3.968, 4.244, 4.473, 4.705, 4.978, 5.303, 5.569, 5.872, 6.222, 6.574, 6.928, 7.273, 7.661, 8.016, 8.361, 8.769, 9.341, 10.05, 10.648, 11.34, 12.149, 13.073, 14.467, 15.738, 17.162, 18.346, 19.473, 21.019, 23.588, 25.308, 28.283, 32.474, 36.082, 40.783, 45.559, 50.526, 58.95, 70.413, 89.703, 128.605, 204.531, 423.584, 4798.503 };
+const start_q = [64]f64{ 2433, 5904, 8178, 13966, 19227, 24984, 29873, 32865, 37161, 41999, 44915, 46156, 49242, 50943, 52761, 54751, 57006, 59059, 60803, 63240, 65209, 67375, 68966, 71539, 73856, 76740, 79956, 82050, 84086, 85694, 87706, 89144, 91010, 92858, 94774, 96521, 97871, 99380, 100739, 102333, 104352, 106336, 108344, 109602, 111599, 113100, 114916, 116636, 119787, 122739, 125193, 127488, 130669, 133762, 136652, 138594, 141283, 144263, 146649, 149978, 153883, 158843, 166770, 183323 };
+const p_cold = 0.0523;
+const shared_rows = 10006;
+
+const solo_rows = 3072;
+const busy_rows = 1536;
+const tail_rows = 512;
+const round_cap = 128;
+const short_rows = 512;
+const warm_ms = 300_000.0;
+const max_convs = 16;
+
+fn rowMs(ctx: f64) f64 {
+    return 0.33 + 0.0007 * ctx / 1000;
+}
+
+fn aloneMs(n: f64, ctx: f64) f64 {
+    return 130 + n * rowMs(ctx + n / 2);
+}
+
+fn roundMs(d: usize) f64 {
+    return 100 + 1.6 * @as(f64, @floatFromInt(d));
+}
+
+fn accepted(d: usize) f64 {
+    return 1.9 + 1.2 * @as(f64, @floatFromInt(28 - @min(d, 28))) / 27;
+}
+
+fn mixedMs(d: usize, n: f64, ctx: f64) f64 {
+    return roundMs(d) + 33 + n * rowMs(ctx + n / 2);
+}
+
+fn planStop(chunk: u64, total: u64, at: u64) u64 {
+    const stop = @min(total, at + chunk);
+    if (stop < total and total - stop < tail_rows) {
+        const half = (total - at + 1) / 2;
+        return at + @min((half + 15) / 16 * 16, chunk);
+    }
+    return stop;
+}
+
+fn draw(r: std.Random, q: *const [64]f64) f64 {
+    const u = r.float(f64) * 63;
+    const i: usize = @intFromFloat(u);
+    const j = @min(i + 1, 63);
+    return q[i] + (q[j] - q[i]) * (u - @as(f64, @floatFromInt(i)));
+}
+
+const Schedule = enum { stock, mixed512, overlap };
+
+const Job = struct {
+    unc: u64 = 0,
+    ctx: f64 = 0,
+    left: f64 = 0,
+    out: f64 = 0,
+    sub: f64 = 0,
+    done: u64 = 0,
+    wait: usize = 0,
+};
+
+const Result = struct {
+    ttft50: f64 = 0,
+    ttft95: f64 = 0,
+    short95: f64 = 0,
+    long50: f64 = 0,
+    long95: f64 = 0,
+    queue_rows: f64 = 0,
+    decode: f64 = 0,
+    prefill: f64 = 0,
+    round_ms: f64 = 0,
+    requests: f64 = 0,
+};
+
+const Sim = struct {
+    gpa: std.mem.Allocator,
+    rng: std.Random,
+    schedule: Schedule,
+    plan: Plan,
+    n: usize,
+    dur_ms: f64,
+    t: f64 = 0,
+    jobs: [max_convs]Job = @splat(.{}),
+    next_at: [max_convs]?f64 = @splat(null),
+    conv_ctx: [max_convs]f64 = @splat(0),
+    filling: [max_convs]usize = undefined,
+    nf: usize = 0,
+    decoding: [max_convs]bool = @splat(false),
+    waiting: ?struct { conv: usize, rows: u64 } = null,
+    debt: f64 = 0,
+    all: std.ArrayList(f64) = .empty,
+    short: std.ArrayList(f64) = .empty,
+    long: std.ArrayList(f64) = .empty,
+    queue_area: f64 = 0,
+    decoded: f64 = 0,
+    filled: f64 = 0,
+    rounds: f64 = 0,
+    round_total: f64 = 0,
+
+    fn deinit(s: *Sim) void {
+        s.all.deinit(s.gpa);
+        s.short.deinit(s.gpa);
+        s.long.deinit(s.gpa);
+    }
+
+    fn decoders(s: *const Sim) usize {
+        var d: usize = 0;
+        for (s.decoding[0..s.n]) |x| d += @intFromBool(x);
+        return d;
+    }
+
+    fn queued(s: *const Sim) u64 {
+        var q: u64 = 0;
+        for (s.filling[0..s.nf]) |c| q += s.jobs[c].unc - s.jobs[c].done;
+        return q;
+    }
+
+    fn advance(s: *Sim, ms: f64) void {
+        s.queue_area += @as(f64, @floatFromInt(s.queued())) * ms;
+        s.t += ms;
+    }
+
+    fn admit(s: *Sim) void {
+        for (0..s.n) |c| {
+            const at = s.next_at[c] orelse continue;
+            if (at > s.t) continue;
+            s.next_at[c] = null;
+            var unc: f64 = undefined;
+            var pre: f64 = undefined;
+            if (s.rng.float(f64) < p_cold) {
+                const ctx = draw(s.rng, &cold_q);
+                unc = @max(256, ctx - shared_rows);
+                s.conv_ctx[c] = ctx;
+                pre = ctx - unc;
+            } else {
+                unc = @max(1, draw(s.rng, &unc_q));
+                pre = s.conv_ctx[c];
+                s.conv_ctx[c] += unc;
+            }
+            const out = @max(1, @floor(draw(s.rng, &out_q)));
+            s.jobs[c] = .{ .unc = @intFromFloat(unc), .ctx = pre, .left = out, .out = out, .sub = s.t };
+            s.filling[s.nf] = c;
+            s.nf += 1;
+        }
+    }
+
+    fn unfill(s: *Sim, c: usize) void {
+        const i = std.mem.indexOfScalar(usize, s.filling[0..s.nf], c).?;
+        std.mem.copyForwards(usize, s.filling[i .. s.nf - 1], s.filling[i + 1 .. s.nf]);
+        s.nf -= 1;
+    }
+
+    fn isFilling(s: *const Sim, c: usize) bool {
+        return std.mem.indexOfScalar(usize, s.filling[0..s.nf], c) != null;
+    }
+
+    fn alone(s: *Sim, c: usize, rows: u64) !void {
+        const j = &s.jobs[c];
+        s.advance(aloneMs(@floatFromInt(rows), j.ctx + @as(f64, @floatFromInt(j.done))));
+        s.filled += @floatFromInt(rows);
+        j.done += rows;
+        if (j.done >= j.unc) try s.prompted(c);
+    }
+
+    fn prompted(s: *Sim, c: usize) !void {
+        s.unfill(c);
+        const j = &s.jobs[c];
+        if (s.t > warm_ms and s.t <= s.dur_ms) {
+            const ttft = (s.t - j.sub) / 1000;
+            try s.all.append(s.gpa, ttft);
+            if (j.unc < s.plan.whole_rows) try s.short.append(s.gpa, ttft) else try s.long.append(s.gpa, ttft);
+        }
+        j.left -= 1;
+        s.decoded += 1;
+        s.decoding[c] = true;
+    }
+
+    fn round(s: *Sim) void {
+        const d = s.decoders();
+        var ms = roundMs(d);
+        if (s.waiting) |w| {
+            if (s.isFilling(w.conv)) {
+                const j = &s.jobs[w.conv];
+                ms = mixedMs(d, @floatFromInt(w.rows), j.ctx + @as(f64, @floatFromInt(j.done)));
+                s.filled += @floatFromInt(w.rows);
+                j.done += w.rows;
+            }
+        }
+        s.waiting = null;
+        s.advance(ms);
+        s.rounds += 1;
+        s.round_total += ms;
+        s.debt = @max(0, s.debt - ms);
+        const a = accepted(d);
+        for (0..s.n) |c| {
+            if (!s.decoding[c]) continue;
+            const j = &s.jobs[c];
+            const k = @min(a, j.left);
+            j.left -= k;
+            s.decoded += k;
+            if (j.left > 1e-9) continue;
+            s.decoding[c] = false;
+            s.conv_ctx[c] = j.ctx + @as(f64, @floatFromInt(j.unc)) + j.out;
+            s.next_at[c] = s.t + @min(draw(s.rng, &gap_q), 600) * 1000;
+        }
+    }
+
+    fn isShort(s: *const Sim, c: usize) bool {
+        const u = s.jobs[c].unc;
+        return if (s.schedule == .overlap) s.plan.whole(u) else u <= short_rows;
+    }
+
+    fn pick(s: *Sim, short: bool) ?usize {
+        var best: ?usize = null;
+        for (s.filling[0..s.nf]) |c| {
+            if (s.isShort(c) != short) continue;
+            const b = best orelse {
+                best = c;
+                continue;
+            };
+            const j = s.jobs[c];
+            const o = s.jobs[b];
+            const aged = j.wait >= 8;
+            const o_aged = o.wait >= 8;
+            if (aged != o_aged) {
+                if (aged) best = c;
+            } else if (aged) {
+                if (j.wait > o.wait) best = c;
+            } else if (j.unc - j.done < o.unc - o.done) best = c;
+        }
+        return best;
+    }
+
+    fn took(s: *Sim, at: usize) usize {
+        for (s.filling[0..s.nf]) |c| s.jobs[c].wait = if (c == at) 0 else s.jobs[c].wait + 1;
+        return at;
+    }
+
+    fn stockStep(s: *Sim, c: usize) !void {
+        const j = s.jobs[c];
+        const decoding = s.decoders() > 0;
+        if (s.schedule == .mixed512 and decoding) {
+            const stop = planStop(512, j.unc, j.done);
+            if (stop < j.unc) {
+                s.waiting = .{ .conv = c, .rows = stop - j.done };
+                return;
+            }
+        }
+        try s.alone(c, planStop(if (decoding) busy_rows else solo_rows, j.unc, j.done) - j.done);
+    }
+
+    fn stockVisit(s: *Sim) !void {
+        while (s.pick(true)) |c| {
+            try s.stockStep(s.took(c));
+            s.admit();
+        }
+        if (s.pick(false)) |c| try s.stockStep(s.took(c));
+    }
+
+    fn overlapVisit(s: *Sim) !void {
+        var oldest: f64 = 0;
+        for (s.filling[0..s.nf]) |c| oldest = @max(oldest, s.t - s.jobs[c].sub);
+        const p = s.plan.pressure(s.queued(), @intFromFloat(oldest * std.time.ns_per_ms));
+        const decoding = s.decoders() > 0;
+        if (!decoding or s.debt <= 0) {
+            const budget = if (decoding) s.plan.burst(p) else std.math.maxInt(u64);
+            var used: u64 = 0;
+            const t0 = s.t;
+            while (s.pick(true)) |c| {
+                const rows = s.jobs[c].unc - s.jobs[c].done;
+                if (used > 0 and used +| rows > budget) break;
+                _ = s.took(c);
+                used += rows;
+                while (s.isFilling(c)) try s.alone(c, planStop(solo_rows, s.jobs[c].unc, s.jobs[c].done) - s.jobs[c].done);
+                s.admit();
+            }
+            if (decoding) s.debt += @as(f64, @floatFromInt(s.plan.owed(p, @intFromFloat((s.t - t0) * std.time.ns_per_ms)))) / std.time.ns_per_ms;
+        }
+        const long = s.pick(false) orelse return;
+        if (s.decoders() > 0 and s.debt > 0) return;
+        const c = s.took(long);
+        const j = s.jobs[c];
+        if (s.decoders() == 0) return s.alone(c, planStop(solo_rows, j.unc, j.done) - j.done);
+        const piece = @min(s.plan.piece(p), solo_rows - round_cap);
+        const stop = planStop(piece, j.unc, j.done);
+        s.debt += @as(f64, @floatFromInt(s.plan.owed(p, s.plan.pieceNs(stop - j.done)))) / std.time.ns_per_ms;
+        if (stop < j.unc) s.waiting = .{ .conv = c, .rows = stop - j.done } else try s.alone(c, stop - j.done);
+    }
+
+    fn run(s: *Sim) !void {
+        for (0..s.n) |c| {
+            s.next_at[c] = s.rng.float(f64) * 60_000;
+            s.conv_ctx[c] = draw(s.rng, &start_q);
+        }
+        while (s.t < s.dur_ms) {
+            s.admit();
+            if (s.nf == 0 and s.decoders() == 0) {
+                var next: f64 = std.math.inf(f64);
+                for (s.next_at[0..s.n]) |x| if (x) |at| {
+                    next = @min(next, at);
+                };
+                s.advance(@max(0, next - s.t));
+                continue;
+            }
+            if (s.nf > 0) switch (s.schedule) {
+                .overlap => try s.overlapVisit(),
+                else => try s.stockVisit(),
+            };
+            if (s.decoders() > 0) s.round();
+        }
+    }
+};
+
+fn quantile(xs: []const f64, p: f64) f64 {
+    if (xs.len == 0) return 0;
+    return xs[@intFromFloat(p * @as(f64, @floatFromInt(xs.len - 1)))];
+}
+
+fn simulate(schedule: Schedule, n: usize, seeds: u64) !Result {
+    const gpa = std.testing.allocator;
+    var all: std.ArrayList(f64) = .empty;
+    defer all.deinit(gpa);
+    var short: std.ArrayList(f64) = .empty;
+    defer short.deinit(gpa);
+    var long: std.ArrayList(f64) = .empty;
+    defer long.deinit(gpa);
+    var r: Result = .{};
+    var t: f64 = 0;
+    var rounds: f64 = 0;
+    var round_total: f64 = 0;
+    var decoded: f64 = 0;
+    var filled: f64 = 0;
+    var queue_area: f64 = 0;
+    for (0..seeds) |seed| {
+        var prng = std.Random.DefaultPrng.init(0x3970 + seed * 7919 + n);
+        var s: Sim = .{ .gpa = gpa, .rng = prng.random(), .schedule = schedule, .plan = .init(4096), .n = n, .dur_ms = 2 * 3600 * 1000 };
+        defer s.deinit();
+        try s.run();
+        try all.appendSlice(gpa, s.all.items);
+        try short.appendSlice(gpa, s.short.items);
+        try long.appendSlice(gpa, s.long.items);
+        t += s.t;
+        rounds += s.rounds;
+        round_total += s.round_total;
+        decoded += s.decoded;
+        filled += s.filled;
+        queue_area += s.queue_area;
+    }
+    for ([_][]f64{ all.items, short.items, long.items }) |xs| std.mem.sort(f64, xs, {}, std.sort.asc(f64));
+    r.ttft50 = quantile(all.items, 0.5);
+    r.ttft95 = quantile(all.items, 0.95);
+    r.short95 = quantile(short.items, 0.95);
+    r.long50 = quantile(long.items, 0.5);
+    r.long95 = quantile(long.items, 0.95);
+    r.queue_rows = queue_area / t;
+    r.decode = decoded * 1000 / t;
+    r.prefill = filled * 1000 / t;
+    r.round_ms = round_total / @max(1, rounds);
+    r.requests = @as(f64, @floatFromInt(all.items.len)) / @as(f64, @floatFromInt(seeds));
+    return r;
+}
+
+test "prefill service: overlap simulated on the fitted served shapes: lower queue and TTFT than stock and the 512-row mixed rounds" {
+    const seeds = 12;
+    for ([_]usize{ 6, 10, 14 }) |n| {
+        var r: [3]Result = undefined;
+        for (std.enums.values(Schedule), 0..) |sch, i| {
+            r[i] = try simulate(sch, n, seeds);
+            std.debug.print("overlap sim n={d:>2} {s:<8} ttft p50 {d:>5.2} p95 {d:>6.2} | <4096 p95 {d:>5.2} | >=4096 p50 {d:>6.2} p95 {d:>6.2} | queue rows {d:>6.0} | decode {d:>6.1} prefill {d:>6.1} tok/s | round {d:>5.1} ms | {d:.0} req\n", .{ n, @tagName(sch), r[i].ttft50, r[i].ttft95, r[i].short95, r[i].long50, r[i].long95, r[i].queue_rows, r[i].decode, r[i].prefill, r[i].round_ms, r[i].requests });
+        }
+        const stock = r[0];
+        const mixed = r[1];
+        const overlap = r[2];
+        try std.testing.expect(overlap.ttft95 < stock.ttft95 and overlap.ttft95 < mixed.ttft95);
+        try std.testing.expect(overlap.long95 < stock.long95 and overlap.long95 < mixed.long95);
+        try std.testing.expect(overlap.short95 < stock.short95 and overlap.short95 < mixed.short95);
+        try std.testing.expect(overlap.queue_rows < stock.queue_rows and overlap.queue_rows < mixed.queue_rows);
+        try std.testing.expect(overlap.decode > 0.95 * stock.decode);
+        try std.testing.expect(mixed.ttft50 > stock.ttft50);
+    }
+}
