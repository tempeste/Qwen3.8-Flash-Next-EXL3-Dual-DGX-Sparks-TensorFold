diff --git a/zig/src/families/flashnext/cuda_prompt_multi.zig b/zig/src/families/flashnext/cuda_prompt_multi.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ed221fd1c4e8385ef93c5eebcc08ed8e3c345ff2
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_prompt_multi.zig
@@ -0,0 +1,96 @@
+//! Several streams' prompt pieces in one batched pass (Engine.prompts, TF_FLASHNEXT_PROMPT_MULTI): each piece its own
+//! sequence, positions, caches and DeltaNet state; the projections and experts run once over every piece's rows.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const batch = prompt.batch;
+const knobs = @import("cuda_knobs.zig");
+const pocket = @import("cuda_pocket.zig");
+const Engine = prompt.Engine;
+const Seq = prompt.Seq;
+
+/// The most pieces one pass takes (the lane host's own bound on streams called together).
+pub const max_pieces: usize = 16;
+
+/// A stream's prompt rows in a shared pass: `ids` from `seq.fed`; their streams (the MTP head's input) into `streams`
+/// once `streams_free` is done (0: none), and with `last` its last row's scores in `seq.logits`, as its own pass leaves them.
+pub const Piece = struct { seq: *Seq, ids: []const u32, streams: u64 = 0, streams_free: ?cuda.Event = null, last: bool = false };
+
+/// Rows and the largest cache of `pieces`, or error.UnexpectedTensor for an empty piece, one past its cache, the same
+/// sequence twice or more rows than one pass takes.
+pub fn plan(pieces: []const Piece, chunk: usize) error{UnexpectedTensor}!struct { rows: usize, cap: usize } {
+    if (pieces.len == 0 or pieces.len > max_pieces) return error.UnexpectedTensor;
+    var rows: usize = 0;
+    var cap: usize = 0;
+    for (pieces, 0..) |x, i| {
+        if (x.ids.len == 0 or x.seq.fed + x.ids.len > x.seq.cap or x.seq.media != null) return error.UnexpectedTensor;
+        for (pieces[0..i]) |y| if (y.seq == x.seq) return error.UnexpectedTensor;
+        rows += x.ids.len;
+        cap = @max(cap, x.seq.cap);
+    }
+    if (rows > chunk) return error.UnexpectedTensor;
+    return .{ .rows = rows, .cap = cap };
+}
+
+/// One batched pass over every piece's rows, each lane's attention, DeltaNet scan and last row its own; every
+/// sequence then stands past its piece.
+pub fn prompts(e: *Engine, comptime Tri: type, tri: Tri, pieces: []const Piece) !void {
+    const at = try plan(pieces, e.chunk);
+    var lanes: [max_pieces]batch.Lane = undefined;
+    const ids = try e.gpa.alloc(u32, at.rows);
+    defer e.gpa.free(ids);
+    const untaught = try e.gpa.alloc(bool, at.rows);
+    defer e.gpa.free(untaught);
+    const scales = try e.gpa.alloc(f32, at.rows);
+    defer e.gpa.free(scales);
+    const s = try e.reserve(at.rows);
+    const scores = try e.reserveScores(at.cap, s.cap);
+    var row0: usize = 0;
+    for (pieces, lanes[0..pieces.len]) |x, *l| {
+        l.* = .{ .seq = x.seq.view(scores), .pos = x.seq.fed, .rows = x.ids.len, .streams = x.streams, .streams_free = x.streams_free, .last = x.last, .logits_host = if (x.last) x.seq.logits else null };
+        @memcpy(ids[row0..][0..x.ids.len], x.ids);
+        @memset(untaught[row0..][0..x.ids.len], x.seq.untaught);
+        row0 += x.ids.len;
+    }
+    const reads = pocket.reads(untaught, scales);
+    defer e.taught_rows = 0;
+    if (reads == .some and e.pockets.mask() != 0) e.taught_rows = try e.pockets.rowScales(e.driver, e.stream, scales);
+    var p: batch.Pass(Tri) = .{
+        .gpa = e.gpa,
+        .io = e.io,
+        .stream = e.stream.*,
+        .tri = tri,
+        .k = &e.batch_k,
+        .s = s,
+        .m = if (reads == .none) e.shipped() else e.model(),
+        .seq = lanes[0].seq,
+        .lanes = lanes[0..pieces.len],
+        .prompt_lanes = true,
+        .hooks = .{ .logits = .none, .prompt = true },
+        .prompt = e.collective == null or knobs.tpPromptRelaxed(),
+    };
+    try p.chunk(ids, 0, null);
+    if (prompt.drainsChunk(e.collective != null, knobs.tpPromptAsync(), knobs.chunkSync())) try e.complete();
+    for (pieces) |x| x.seq.fed += x.ids.len;
+}
+
+test "a shared prompt pass takes distinct sequences' pieces within their caches and one pass's rows" {
+    var a: Seq = undefined;
+    var b: Seq = undefined;
+    a.fed = 10;
+    a.cap = 100;
+    a.media = null;
+    b.fed = 0;
+    b.cap = 50;
+    b.media = null;
+    const ids = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    const ok = try plan(&.{ .{ .seq = &a, .ids = ids[0..5] }, .{ .seq = &b, .ids = ids[0..3] } }, 8);
+    try std.testing.expectEqual(@as(usize, 8), ok.rows);
+    try std.testing.expectEqual(@as(usize, 100), ok.cap);
+    try std.testing.expectError(error.UnexpectedTensor, plan(&.{ .{ .seq = &a, .ids = ids[0..5] }, .{ .seq = &b, .ids = ids[0..4] } }, 8));
+    try std.testing.expectError(error.UnexpectedTensor, plan(&.{ .{ .seq = &a, .ids = ids[0..1] }, .{ .seq = &a, .ids = ids[0..1] } }, 8));
+    try std.testing.expectError(error.UnexpectedTensor, plan(&.{.{ .seq = &a, .ids = ids[0..0] }}, 8));
+    a.fed = 98;
+    try std.testing.expectError(error.UnexpectedTensor, plan(&.{.{ .seq = &a, .ids = ids[0..3] }}, 8));
+    try std.testing.expectError(error.UnexpectedTensor, plan(&.{}, 8));
+}
