+//! TF_FLASHNEXT_TP_FRAME_FIRST=1: rank 0 sends a create, save, drop_seq or drop_snap frame before its own allocation
+//! or free instead of after it, so both ranks allocate (or free) at once and rank 0 reads an ack that is already there.
+//! Rank 1 sees the same frames in the same order and every device call on either rank is the one it made before, so
+//! no byte changes. A refusal rank 0 can check (cap, a window not at its mark) still sends nothing; an allocation rank 0
+//! fails after its frame went out takes rank 1's copy back with a drop frame, so both ranks still hold the same objects.
+const std = @import("std");
+const prompt = @import("cuda_prompt.zig");
+const snaps = @import("cuda_snap.zig");
+const mtp = @import("cuda_mtp.zig");
+const rank_snap = @import("cuda_rank_snap.zig");
+const Session = @import("cuda_rank_engine.zig").Session;
+
+/// Session.create with the frame first: rank 1 makes its sequence while rank 0 makes its own.
+pub fn create(s: *Session, cap: usize) !prompt.Seq {
+    if (cap == 0 or cap > prompt.maxTokens()) return error.UnexpectedTensor;
+    _ = try prompt.seqBytesPaged(cap, 0, s.engine.heads);
+    const id = s.next_object;
+    s.next_object = std.math.add(u64, id, 1) catch return error.BadRankFrame;
+    const h = try s.command(.{ .kind = .create, .object = id, .arg = cap }, &.{});
+    var q = s.blocks.make(s.engine, cap, id) catch |err| {
+        try s.ack(h);
+        const undo = try s.command(.{ .kind = .drop_seq, .object = id }, &.{});
+        try s.ack(undo);
+        return err;
+    };
+    errdefer s.unmake(&q, id);
+    try s.ack(h);
+    q.rank_id = id;
+    return q;
+}
+
+/// Session.drop with the frame first: rank 1 frees its sequence while rank 0 frees its own.
+pub fn drop(s: *Session, q: *prompt.Seq) void {
+    s.engine.round_graph.clear();
+    if (s.stopped) return s.unmake(q, q.rank_id);
+    const h = s.command(.{ .kind = .drop_seq, .object = q.rank_id }, &.{}) catch {
+        s.poison();
+        s.unmake(q, q.rank_id);
+        return;
+    };
+    s.unmake(q, q.rank_id);
+    s.ack(h) catch s.poison();
+}
+
+/// Session.dropSaved with the frame first.
+pub fn dropSaved(s: *Session, kept: *snaps.Snap) void {
+    if (s.stopped) return snaps.drop(s.gpa, s.engine.stream.*, kept);
+    const h = s.command(.{ .kind = .drop_snap, .object = kept.rank_id }, &.{}) catch {
+        s.poison();
+        snaps.drop(s.gpa, s.engine.stream.*, kept);
+        return;
+    };
+    snaps.drop(s.gpa, s.engine.stream.*, kept);
+    s.ack(h) catch s.poison();
+}
+
+/// rank_snap.save with the frame first: rank 1 allocates and fills its copy while rank 0 allocates and fills its own.
+pub fn save(s: *Session, q: *prompt.Seq, d: ?*mtp.Draft) !*snaps.Snap {
+    try rank_snap.settled(d);
+    if (d) |w| if (w.len != q.fed or w.drafted != 0) return error.NotAtMark;
+    const id = s.next_object;
+    s.next_object = std.math.add(u64, id, 1) catch return error.BadRankFrame;
+    const mark = rank_snap.Mark.of(q.fed, q.history).encode();
+    const h = try s.command(.{ .kind = .save, .object = q.rank_id, .arg = id, .bytes = rank_snap.Mark.bytes }, &mark);
+    s.blocks.release();
+    const kept = snaps.take(s.gpa, s.engine.driver, q, d) catch |err| {
+        if (try s.answer(h)) {
+            const undo = try s.command(.{ .kind = .drop_snap, .object = id }, &.{});
+            try s.ack(undo);
+        }
+        return err;
+    };
+    errdefer snaps.drop(s.gpa, s.engine.stream.*, kept);
+    kept.rank_id = id;
+    snaps.fill(s.engine.stream.*, q, d, kept) catch |err| {
+        s.poison();
+        return err;
+    };
+    if (!try s.answer(h)) return error.OutOfDeviceMemory;
+    return kept;
+}
+
+test {
+    if (@import("builtin").os.tag != .windows) _ = @import("cuda_rank_first_test.zig");
+}
