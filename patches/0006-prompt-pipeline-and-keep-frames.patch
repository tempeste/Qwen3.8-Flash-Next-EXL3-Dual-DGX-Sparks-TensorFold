diff --git a/zig/tests/cuda/flashnext_keep_early_tests.zig b/zig/tests/cuda/flashnext_keep_early_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1d22beecfde24aea6e1825de3c059da60fcaa584
--- /dev/null
+++ b/zig/tests/cuda/flashnext_keep_early_tests.zig
@@ -0,0 +1,323 @@
+//! TF_FLASHNEXT_TP_KEEP_EARLY at --tp 2 with the MTP head on rank 0: 8 and 16 streams decode greedily for ROUNDS
+//! rounds (the head's chains in one draftMany pass, one shared verify, the accepted prefix kept in one keep_many
+//! batch) with the early keep frame off, then on; every stream's tokens and every round's window scores are
+//! byte-equal. With TF_FLASHNEXT_TP_KEEP_BATCH=1 and TF_FLASHNEXT_KEEP_LANES=1 on both ranks, as served. `bench`:
+//! rank 0's ms a round with it off and on, alternating, at one stream count (the microbench).
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const env = @import("sys").env;
+const Session = flash.rank_engine.Session;
+
+pub const context = 4096;
+pub const max_streams = 16;
+const depth = mtp.default_depth;
+pub const warm_rounds = 5;
+pub const row = prompt.vocabulary * 2;
+
+/// The two-rank session, its engine and (rank 0) the head, with rank 0's Ops routing main-model work to rank 1.
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: *Session,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+    out: cuda.DeviceBuffer,
+    host: []u8,
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize, port: u16) !void {
+        _ = env.setenv("TF_FLASHNEXT_TP_KEEP_BATCH", "1", 1);
+        _ = env.setenv("TF_FLASHNEXT_KEEP_LANES", "1", 1);
+        _ = env.setenv("TF_FLASHNEXT_TP_KEEP_EARLY", "1", 1);
+        defer _ = env.unsetenv("TF_FLASHNEXT_TP_KEEP_EARLY");
+        r.gpu = gpu;
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        identity.mtp = 1;
+        r.session = try Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+        r.e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank) catch |err| {
+            r.session.poison();
+            r.session.deinit();
+            return err;
+        };
+        r.session.engine = r.e;
+        r.e.collective = &r.session.collective;
+        errdefer {
+            r.session.poison();
+            r.session.deinit();
+            r.e.deinit();
+        }
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        if (r.session.keep_early != (rank == 0) or !r.session.keep_batch) return error.KnobUnread;
+        // TF_FLASHNEXT_TP_ROCE=1 (as a served pair runs): the fitting sums and gathers by RoCE, as a served engine opens it at load
+        if (flash.knobs.tpRoce()) try r.session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+        // the pass's scratch for a full chunk, as the served engine reserves it at load (rollbacks run batched in it)
+        _ = try r.e.reserve(@min(context, r.e.chunk));
+        r.out = try cuda.DeviceBuffer.alloc(gpu.d, max_streams * mtp.max_rows * row);
+        errdefer r.out.free();
+        r.host = try gpu.gpa.alloc(u8, max_streams * mtp.max_rows * row);
+        errdefer gpu.gpa.free(r.host);
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    fn deinit(r: *Rig) void {
+        r.session.deinit();
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.gpu.gpa.free(r.host);
+        r.out.free();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback, .rollback_many = rollbackMany } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+    fn rollbackMany(p: *anyopaque, qs: []const *prompt.Seq, ds: []const *mtp.Draft, keeps: []const usize) anyerror!void {
+        const r = of(p);
+        return r.session.keepMany(flash.Tri, r.tri(), qs, ds, keeps);
+    }
+};
+
+/// A stream: its sequence and head window, the head's last chain, and the tokens the last verify accepted.
+const Lane = struct {
+    q: prompt.Seq,
+    d: mtp.Draft,
+    chain: mtp.Chain = .{},
+    follow: [mtp.max_rows]u32 = undefined,
+    nf: usize = 0,
+    fresh: bool = true,
+    window: [mtp.max_rows]u32 = undefined,
+    nw: usize = 0,
+};
+
+/// One arm's record: each stream's tokens, each round's window-scores digest, rank 0's mean ms a round past warm-up.
+pub const Record = struct {
+    tokens: [max_streams]std.ArrayList(u32) = @splat(.empty),
+    digests: std.ArrayList(u64) = .empty,
+    ms: f64 = 0,
+    windows: usize = 0,
+
+    pub fn deinit(rec: *Record, gpa: std.mem.Allocator) void {
+        for (&rec.tokens) |*t| t.deinit(gpa);
+        rec.digests.deinit(gpa);
+    }
+
+    pub fn emitted(rec: *const Record, n: usize) usize {
+        var total: usize = 0;
+        for (rec.tokens[0..n]) |t| total += t.items.len;
+        return total;
+    }
+};
+
+pub fn seedOf(gpu: check.Gpu, ids_path: []const u8) !std.ArrayList(u32) {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    errdefer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len < 16) return error.BadPrompt;
+    return seed;
+}
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+/// The greedy token of a bf16 score row: its first highest score.
+fn best(bytes: []const u8) u32 {
+    const v = std.mem.bytesAsSlice(u16, bytes);
+    var at: usize = 0;
+    var top = -std.math.inf(f32);
+    for (v, 0..) |x, i| {
+        const f = bf16(x);
+        if (f > top) {
+            top = f;
+            at = i;
+        }
+    }
+    return @intCast(at);
+}
+
+/// `n` streams, each its own prompt, decoded greedily for `rounds` rounds with the early keep frame `early`.
+fn arm(r: *Rig, seed: []const u32, n: usize, rounds: usize, early: bool, rec: *Record) !void {
+    r.session.keep_early = early;
+    defer r.session.keep_early = false;
+    return decode(r, seed, n, rounds, rec);
+}
+
+/// `n` streams, each its own prompt, decoded greedily for `rounds` rounds on `r`'s session as it stands: its tokens,
+/// each round's window-scores digest and rank 0's ms a round into `rec`. `r` holds gpu, stream, session, e, head, out
+/// and host, and its ops() routes main-model work through the session (Rig here, flashnext_lanes_any_tests.zig's).
+pub fn decode(r: anytype, seed: []const u32, n: usize, rounds: usize, rec: *Record) !void {
+    const gpa = r.gpu.gpa;
+    const s = r.session;
+    const ops = r.ops();
+    var lanes: [max_streams]Lane = undefined;
+    var made: usize = 0;
+    defer for (lanes[0..made]) |*l| {
+        l.d.deinit();
+        s.drop(&l.q);
+    };
+    var ids: [96]u32 = undefined;
+    for (0..n) |i| {
+        const l = &lanes[i];
+        l.* = .{ .q = try s.create(context), .d = undefined };
+        l.d = mtp.Draft.init(gpa, r.e.driver, r.stream, context, r.head.?.ids.len, r.e.chunk, r.e.heads) catch |err| {
+            s.drop(&l.q);
+            return err;
+        };
+        made += 1;
+        const len = 40 + (i * 11) % 48;
+        for (ids[0..len], 0..) |*t, j| t.* = seed[(i * 31 + j * 7) % seed.len];
+        try ops.prefill(&l.q, &l.d, ids[0..len]);
+        l.follow[0] = best(l.q.logits[0..row]);
+        l.nf = 1;
+        try rec.tokens[i].append(gpa, l.follow[0]);
+    }
+    var qs: [max_streams]*prompt.Seq = undefined;
+    var ds: [max_streams]*mtp.Draft = undefined;
+    var nexts: [max_streams][]const u32 = undefined;
+    var rows: [max_streams]u64 = undefined;
+    var counts: [max_streams]usize = undefined;
+    var positions: [max_streams]u64 = undefined;
+    var sms: [max_streams]?mtp.Sampling = @splat(null);
+    var outs: [max_streams]*mtp.Chain = undefined;
+    var idss: [max_streams][]const u32 = undefined;
+    var keeps: [max_streams]usize = undefined;
+    var total: i96 = 0;
+    for (0..rounds) |round| {
+        const t0 = check.now(r.gpu.io);
+        for (lanes[0..n], 0..) |*l, i| {
+            qs[i] = &l.q;
+            ds[i] = &l.d;
+            nexts[i] = l.follow[0..l.nf];
+            rows[i] = if (l.fresh) l.d.prompt_last else l.d.streams.ptr;
+            counts[i] = @min(depth, l.q.cap - l.q.fed - 1);
+            positions[i] = l.q.fed + 1;
+            outs[i] = &l.chain;
+        }
+        try ops.draftMany(ds[0..n], nexts[0..n], rows[0..n], counts[0..n], positions[0..n], sms[0..n], mtp.default_confidence, outs[0..n], null);
+        var total_rows: usize = 0;
+        for (lanes[0..n], 0..) |*l, i| {
+            l.window[0] = l.follow[l.nf - 1];
+            @memcpy(l.window[1..][0..l.chain.n], l.chain.slice());
+            l.nw = 1 + l.chain.n;
+            idss[i] = l.window[0..l.nw];
+            total_rows += l.nw;
+        }
+        try s.verifyMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], idss[0..n], r.out.ptr);
+        try r.stream.synchronize();
+        const scores = r.host[0 .. total_rows * row];
+        try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoH_v2(scores.ptr, r.out.ptr, scores.len), "cuMemcpyDtoH");
+        try rec.digests.append(gpa, std.hash.Wyhash.hash(round, scores));
+        var at: usize = 0;
+        for (lanes[0..n], 0..) |*l, i| {
+            var kept: usize = 0;
+            while (true) {
+                const g = best(scores[(at + kept) * row ..][0..row]);
+                l.follow[kept] = g;
+                try rec.tokens[i].append(gpa, g);
+                kept += 1;
+                if (kept == l.nw or l.window[kept] != g) break;
+            }
+            at += l.nw;
+            l.nf = kept;
+            l.fresh = false;
+            keeps[i] = kept;
+        }
+        try s.keepMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], keeps[0..n]);
+        rec.windows += n;
+        if (round >= warm_rounds) total += check.now(r.gpu.io) - t0;
+    }
+    try r.stream.synchronize();
+    rec.ms = @as(f64, @floatFromInt(total)) / 1e6 / @as(f64, @floatFromInt(rounds - warm_rounds));
+}
+
+fn rankFollows(r: *Rig, what: []const u8) !void {
+    try r.session.follow(flash.Tri, r.tri(), r.out.ptr);
+    check.pass("rank 1 followed {s}", .{what});
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, rounds: usize) !void {
+    if (rounds <= warm_rounds) return error.BadRounds;
+    var seed = try seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port);
+    defer r.deinit();
+    if (rank == 1) return rankFollows(&r, "both arms at 8 and 16 streams");
+    for ([_]usize{ 8, 16 }) |n| {
+        var off: Record = .{};
+        defer off.deinit(gpu.gpa);
+        var on: Record = .{};
+        defer on.deinit(gpu.gpa);
+        try arm(&r, seed.items, n, rounds, false, &off);
+        try arm(&r, seed.items, n, rounds, true, &on);
+        for (off.digests.items, on.digests.items, 0..) |a, b, round| {
+            try check.expect(a == b, "{d} streams: round {d}'s window scores differ with TF_FLASHNEXT_TP_KEEP_EARLY", .{ n, round });
+        }
+        for (off.tokens[0..n], on.tokens[0..n], 0..) |a, b, i| {
+            const first = std.mem.indexOfDiff(u32, a.items, b.items);
+            try check.expect(first == null, "{d} streams: stream {d}'s tokens differ from token {?d}", .{ n, i, first });
+        }
+        const tokens = off.emitted(n);
+        check.pass("{d} streams, {d} rounds with the MTP head: {d} tokens ({d:.2} a window) and every round's window scores byte-equal with the early keep frame", .{ n, rounds, tokens, @as(f64, @floatFromInt(tokens - n)) / @as(f64, @floatFromInt(off.windows)) });
+        std.debug.print("BENCH keep-early streams={d} rounds={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - warm_rounds, off.ms, on.ms, off.ms - on.ms });
+    }
+}
+
+/// Rank 0's ms a round at `n` streams, `reps` pairs of `rounds`-round arms alternating off then on.
+pub fn bench(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, n: usize, rounds: usize, reps: usize) !void {
+    if (n < 2 or n > max_streams or rounds <= warm_rounds or reps == 0) return error.BadBench;
+    var seed = try seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port);
+    defer r.deinit();
+    if (rank == 1) return rankFollows(&r, "the bench");
+    var offs: [64]f64 = undefined;
+    var ons: [64]f64 = undefined;
+    const k = @min(reps, offs.len);
+    for (0..k) |rep| {
+        inline for (.{ false, true }) |early| {
+            var rec: Record = .{};
+            defer rec.deinit(gpu.gpa);
+            try arm(&r, seed.items, n, rounds, early, &rec);
+            if (early) ons[rep] = rec.ms else offs[rep] = rec.ms;
+        }
+        std.debug.print("rep {d}: {d:.2} ms a round off, {d:.2} on\n", .{ rep, offs[rep], ons[rep] });
+    }
+    const off = check.median(offs[0..k]);
+    const on = check.median(ons[0..k]);
+    std.debug.print("BENCH keep-early-round streams={d} rounds={d} reps={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - warm_rounds, k, off, on, off - on });
+}
diff --git a/zig/tests/cuda/flashnext_keep_lanes_tests.zig b/zig/tests/cuda/flashnext_keep_lanes_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3d5db456674f41ed85bec62046e3f5faaec2602f
--- /dev/null
+++ b/zig/tests/cuda/flashnext_keep_lanes_tests.zig
@@ -0,0 +1,240 @@
+//! Several streams' drafted windows rolled back together (Ops.rollbackMany, TF_FLASHNEXT_KEEP_LANES) against each alone,
+//! byte for byte, and the bench of both.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+
+const most = 32;
+
+/// Window widths in one shared pass and each window's kept rows (0: all of them, a settle).
+const Case = struct { widths: []const usize, keeps: []const usize };
+const twenty: [20]usize = @splat(3);
+const cases = [_]Case{
+    .{ .widths = &.{ 3, 3, 3, 3 }, .keeps = &.{ 1, 0, 2, 1 } },
+    .{ .widths = &.{ 1, 16, 3, 7 }, .keeps = &.{ 0, 9, 1, 4 } },
+    .{ .widths = &twenty, .keeps = &.{ 1, 2, 0, 1, 1, 2, 1, 0, 2, 1, 1, 1, 2, 2, 1, 0, 1, 2, 1, 1 } },
+};
+
+const Side = struct {
+    seqs: [most]prompt.Seq = undefined,
+    drafts: [most]mtp.Draft = undefined,
+    made: usize = 0,
+
+    fn deinit(s: *Side, gpa: std.mem.Allocator) void {
+        for (s.seqs[0..s.made], s.drafts[0..s.made]) |*q, *d| {
+            d.deinit();
+            q.deinit(gpa);
+        }
+        s.made = 0;
+    }
+
+    fn fill(s: *Side, e: *prompt.Engine, ops: mtp.Ops(flash.Tri), stream: *cuda.Stream, ids: []const u32, n: usize, room: usize) !void {
+        const gpa = e.gpa;
+        for (0..n) |i| {
+            const prompt_len = ids.len - 3 * (i % 8);
+            s.seqs[i] = try e.newSeq(ids.len + room);
+            s.drafts[i] = mtp.Draft.init(gpa, e.driver, stream.*, ids.len + room, 1, e.chunk, e.heads) catch |err| {
+                s.seqs[i].deinit(gpa);
+                return err;
+            };
+            s.made += 1;
+            try e.forward(flash.Tri, ops.tri, &s.seqs[i], ids[0..prompt_len], .{});
+        }
+    }
+
+    fn verify(s: *Side, ops: mtp.Ops(flash.Tri), widths: []const usize, windows: *const [most][16]u32, shared: u64) !void {
+        var seqs: [most]*prompt.Seq = undefined;
+        var ds: [most]*mtp.Draft = undefined;
+        var idss: [most][]const u32 = undefined;
+        for (widths, 0..) |w, i| {
+            seqs[i] = &s.seqs[i];
+            ds[i] = &s.drafts[i];
+            idss[i] = windows[i][0..w];
+        }
+        try ops.verifyMany(seqs[0..widths.len], ds[0..widths.len], idss[0..widths.len], shared);
+    }
+
+    fn rollbackMany(s: *Side, ops: mtp.Ops(flash.Tri), keeps: []const usize) !void {
+        var seqs: [most]*prompt.Seq = undefined;
+        var ds: [most]*mtp.Draft = undefined;
+        for (keeps, 0..) |_, i| {
+            seqs[i] = &s.seqs[i];
+            ds[i] = &s.drafts[i];
+        }
+        try ops.rollbackMany(seqs[0..keeps.len], ds[0..keeps.len], keeps);
+    }
+
+    fn rollbackEach(s: *Side, ops: mtp.Ops(flash.Tri), keeps: []const usize) !void {
+        for (keeps, 0..) |k, i| try ops.rollback(&s.seqs[i], &s.drafts[i], k);
+    }
+};
+
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    e: *prompt.Engine,
+    ids: []u32,
+    shared: cuda.DeviceBuffer,
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, ids_path: []const u8, length: usize) !void {
+        const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+        defer gpu.gpa.free(source);
+        var base: std.ArrayList(u32) = .empty;
+        defer base.deinit(gpu.gpa);
+        var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+        while (words.next()) |word| try base.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+        if (base.items.len < 16) return error.BadPrompt;
+        r.gpu = gpu;
+        r.ids = try gpu.gpa.alloc(u32, length);
+        errdefer gpu.gpa.free(r.ids);
+        for (r.ids, 0..) |*t, i| t.* = base.items[i % base.items.len];
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        r.e = try prompt.Engine.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+        errdefer r.e.deinit();
+        r.shared = try cuda.DeviceBuffer.alloc(gpu.d, 128 * prompt.vocabulary * 2);
+    }
+
+    fn deinit(r: *Rig) void {
+        r.shared.free();
+        r.e.deinit();
+        r.glue.deinit();
+        r.stream.deinit();
+        r.gpu.gpa.free(r.ids);
+    }
+
+    fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = .{ .s = r.stream, .own = &r.glue }, .h = undefined };
+    }
+};
+
+fn windowIds(windows: *[most][16]u32, salt: usize) void {
+    for (windows, 0..) |*w, i| for (w, 0..) |*t, r| {
+        t.* = @intCast((37 + 101 * i + 17 * r + 7 * salt) % 50_000);
+    };
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, ids_path: []const u8) !void {
+    for ([_]usize{ 100, 2600 }) |length| {
+        var r: Rig = undefined;
+        try r.init(gpu, dir, ids_path, length);
+        defer r.deinit();
+        for (cases) |c| {
+            if (length > 100 and c.widths.len > 4) continue;
+            try case(&r, c);
+        }
+    }
+}
+
+fn same(gpu: check.Gpu, what: []const u8, a: cuda.DeviceBuffer, b: cuda.DeviceBuffer) !void {
+    const x = try check.download(gpu, a);
+    defer gpu.gpa.free(x);
+    const y = try check.download(gpu, b);
+    defer gpu.gpa.free(y);
+    try check.sameBytes(what, y, x);
+}
+
+fn case(r: *Rig, c: Case) !void {
+    const gpu = r.gpu;
+    const gpa = gpu.gpa;
+    const ops = r.ops();
+    const n = c.widths.len;
+    var windows: [most][16]u32 = undefined;
+    windowIds(&windows, 0);
+    var alone: Side = .{};
+    defer alone.deinit(gpa);
+    var together: Side = .{};
+    defer together.deinit(gpa);
+    try alone.fill(r.e, ops, &r.stream, r.ids, n, 64);
+    try together.fill(r.e, ops, &r.stream, r.ids, n, 64);
+    try alone.verify(ops, c.widths, &windows, r.shared.ptr);
+    try together.verify(ops, c.widths, &windows, r.shared.ptr);
+    var keeps: [most]usize = undefined;
+    var moved: usize = 0;
+    for (c.widths, c.keeps, keeps[0..n]) |w, k, *x| {
+        x.* = if (k == 0) w else k;
+        if (x.* != w) moved += 1;
+    }
+    for (together.drafts[0..n]) |d| try check.expect(d.log == null, "no pending-row log (unset TF_FLASHNEXT_KEEP_LATE): the windows replay their rows", .{});
+    var seqs: [most]*prompt.Seq = undefined;
+    var ds: [most]*mtp.Draft = undefined;
+    for (0..n) |i| {
+        seqs[i] = &together.seqs[i];
+        ds[i] = &together.drafts[i];
+    }
+    try check.expect(flash.mtp_roll.manyFits(ops, seqs[0..n], ds[0..n], keeps[0..n]), "the windows roll back together, not a window at a time", .{});
+    try alone.rollbackEach(ops, keeps[0..n]);
+    try together.rollbackMany(ops, keeps[0..n]);
+    try r.stream.synchronize();
+    for (0..n) |i| {
+        const a = &alone.seqs[i];
+        const t = &together.seqs[i];
+        try check.expect(a.fed == t.fed, "window {d}: kept positions match ({d}, {d})", .{ i, a.fed, t.fed });
+        try check.expect(std.mem.eql(i64, &a.history, &t.history), "window {d}: kept n-gram histories match", .{i});
+        try check.expect(alone.drafts[i].rows == together.drafts[i].rows and alone.drafts[i].open == together.drafts[i].open, "window {d}: kept rows and open match", .{i});
+        for (a.conv, t.conv) |x, y| try same(gpu, "a DeltaNet conv window rolled back together equals its lone one", x, y);
+        for (a.state, t.state) |x, y| try same(gpu, "a DeltaNet state rolled back together equals its lone one", x, y);
+        try same(gpu, "the n-gram tail rolled back together equals its lone one", a.tail, t.tail);
+    }
+    for (0..n) |i| {
+        try r.e.forward(flash.Tri, ops.tri, &alone.seqs[i], &.{13}, .{});
+        try r.e.forward(flash.Tri, ops.tri, &together.seqs[i], &.{13}, .{});
+        try check.sameBytes("the row after a batched rollback equals the lone one's", together.seqs[i].logits, alone.seqs[i].logits);
+    }
+    check.pass("batched rollback, {d} windows of {any} rows ({d} moved) at {d} prompt tokens: conv windows, states, tail, history and next row byte-exact", .{ n, c.widths, moved, r.ids.len });
+}
+
+const Timespec = extern struct { sec: i64, nsec: i64 };
+extern "c" fn clock_gettime(clk: c_int, ts: *Timespec) c_int;
+
+fn nowNs() u64 {
+    var ts: Timespec = undefined;
+    _ = clock_gettime(1, &ts);
+    return @as(u64, @intCast(ts.sec)) * 1_000_000_000 + @as(u64, @intCast(ts.nsec));
+}
+
+/// ms a round of `lanes` windows of `rows` rows each, each keeping (r % rows) + 1, rolled back alone and together.
+pub fn bench(gpu: check.Gpu, dir: []const u8, ids_path: []const u8, lanes: usize, rows: usize, iters: usize) !void {
+    if (lanes == 0 or lanes > most or rows == 0 or rows > 16 or iters == 0) return error.BadBench;
+    const gpa = gpu.gpa;
+    var r: Rig = undefined;
+    try r.init(gpu, dir, ids_path, 1024);
+    defer r.deinit();
+    const ops = r.ops();
+    const widths: [most]usize = @splat(rows);
+    var keeps: [most]usize = undefined;
+    for (keeps[0..lanes], 0..) |*k, i| k.* = i % rows + 1;
+    var side: Side = .{};
+    defer side.deinit(gpa);
+    try side.fill(r.e, ops, &r.stream, r.ids, lanes, 64 + rows * (2 * iters + 2));
+    var windows: [most][16]u32 = undefined;
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var stop = try cuda.Event.init(gpu.d, true);
+    defer stop.deinit();
+    var ms: [2]f64 = .{ 0, 0 };
+    var host: [2]f64 = .{ 0, 0 };
+    for (0..2 * iters + 2) |it| {
+        const arm = it % 2;
+        windowIds(&windows, it);
+        try side.verify(ops, widths[0..lanes], &windows, r.shared.ptr);
+        try r.stream.synchronize();
+        const t0 = nowNs();
+        try start.record(r.stream);
+        if (arm == 0) try side.rollbackEach(ops, keeps[0..lanes]) else try side.rollbackMany(ops, keeps[0..lanes]);
+        try stop.record(r.stream);
+        const t1 = nowNs();
+        try stop.synchronize();
+        if (it < 2) continue;
+        ms[arm] += try cuda.Event.elapsedMs(start, stop);
+        host[arm] += @as(f64, @floatFromInt(t1 - t0)) / 1e6;
+    }
+    const k: f64 = @floatFromInt(iters);
+    check.pass("rollback of {d} windows of {d} rows: alone {d:.3} ms GPU ({d:.3} ms host), together {d:.3} ms GPU ({d:.3} ms host) a round, {d} rounds each", .{ lanes, rows, ms[0] / k, host[0] / k, ms[1] / k, host[1] / k, iters });
+}
diff --git a/zig/tests/cuda/flashnext_keep_late_tests.zig b/zig/tests/cuda/flashnext_keep_late_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fa4bd2f992e726f61558dd755e00b602a8e8a0e3
--- /dev/null
+++ b/zig/tests/cuda/flashnext_keep_late_tests.zig
@@ -0,0 +1,365 @@
+//! TF_FLASHNEXT_TP_KEEP_LATE at --tp 2 with the MTP head on rank 0: 8 and 16 streams decode greedily for ROUNDS rounds
+//! (the head's chains in one draftMany pass, one shared verify, the accepted prefix kept in one keep_many batch) with
+//! pending DeltaNet rows off on both ranks, then on on both ranks (a session each, ports PORT and PORT+1: rank 1 makes
+//! its windows as its session's flag says); every stream's tokens and every round's window scores are byte-equal.
+//! Halfway through, every stream's state is saved and restored on both ranks, its pending rows flushed first.
+//! TF_FLASHNEXT_TP_KEEP_BATCH, TF_FLASHNEXT_KEEP_LANES and TF_FLASHNEXT_TP_KEEP_EARLY are the caller's, on both ranks.
+//! `bench`: rank 0's ms a round off and on at one stream count, REPS pairs of sessions (ports PORT up to PORT+2*REPS-1).
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const Session = flash.rank_engine.Session;
+
+const context = 4096;
+const max_streams = 16;
+const depth = mtp.default_depth;
+const warm_rounds = 5;
+const row = prompt.vocabulary * 2;
+
+/// The engine, the head (rank 0) and the buffers, kept across the sessions; a session's late flag set before it starts.
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: ?*Session = null,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+    out: cuda.DeviceBuffer,
+    host: []u8,
+    identity: flash.rank_engine.Identity,
+    rank: usize,
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize) !void {
+        r.gpu = gpu;
+        r.rank = rank;
+        r.session = null;
+        r.head = null;
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        r.identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        r.identity.mtp = 1;
+        r.e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank);
+        errdefer r.e.deinit();
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        _ = try r.e.reserve(@min(context, r.e.chunk));
+        r.out = try cuda.DeviceBuffer.alloc(gpu.d, max_streams * mtp.max_rows * row);
+        errdefer r.out.free();
+        r.host = try gpu.gpa.alloc(u8, max_streams * mtp.max_rows * row);
+        errdefer gpu.gpa.free(r.host);
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    /// A session on `port` with pending rows `late` on this rank (Draft.late_on, as cuda_lanes_load.zig sets it).
+    fn open(r: *Rig, port: u16, late: bool) !void {
+        mtp.Draft.late_on = late;
+        const s = try Session.init(r.gpu.gpa, r.gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, r.rank, r.identity, flash.rank_engine.linkWait());
+        errdefer {
+            s.poison();
+            s.deinit();
+        }
+        s.engine = r.e;
+        r.e.collective = &s.collective;
+        if (flash.knobs.tpRoce()) try s.collective.openRoce(r.gpu.gpa, r.gpu.io, r.gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+        r.session = s;
+    }
+
+    fn close(r: *Rig) void {
+        if (r.session) |s| s.deinit();
+        r.session = null;
+        mtp.Draft.late_on = false;
+    }
+
+    /// Rank 1: one session followed to its stop frame.
+    fn follow(r: *Rig, port: u16, late: bool) !void {
+        try r.open(port, late);
+        defer r.close();
+        try r.session.?.follow(flash.Tri, r.tri(), r.out.ptr);
+    }
+
+    fn deinit(r: *Rig) void {
+        r.close();
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.gpu.gpa.free(r.host);
+        r.out.free();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback, .rollback_many = rollbackMany } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.?.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.?.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.?.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+    fn rollbackMany(p: *anyopaque, qs: []const *prompt.Seq, ds: []const *mtp.Draft, keeps: []const usize) anyerror!void {
+        const r = of(p);
+        return r.session.?.keepMany(flash.Tri, r.tri(), qs, ds, keeps);
+    }
+};
+
+/// A stream: its sequence and head window, the head's last chain, and the tokens the last verify accepted.
+const Lane = struct {
+    q: prompt.Seq,
+    d: mtp.Draft,
+    chain: mtp.Chain = .{},
+    follow: [mtp.max_rows]u32 = undefined,
+    nf: usize = 0,
+    fresh: bool = true,
+    window: [mtp.max_rows]u32 = undefined,
+    nw: usize = 0,
+};
+
+/// One arm's record: each stream's tokens, each round's window-scores digest, rank 0's mean ms a round past warm-up,
+/// and the windows that left rows pending on rank 0.
+const Record = struct {
+    tokens: [max_streams]std.ArrayList(u32) = @splat(.empty),
+    digests: std.ArrayList(u64) = .empty,
+    ms: f64 = 0,
+    windows: usize = 0,
+    pending: usize = 0,
+    flushed: usize = 0,
+
+    fn deinit(rec: *Record, gpa: std.mem.Allocator) void {
+        for (&rec.tokens) |*t| t.deinit(gpa);
+        rec.digests.deinit(gpa);
+    }
+
+    fn emitted(rec: *const Record, n: usize) usize {
+        var total: usize = 0;
+        for (rec.tokens[0..n]) |t| total += t.items.len;
+        return total;
+    }
+};
+
+fn seedOf(gpu: check.Gpu, ids_path: []const u8) !std.ArrayList(u32) {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    errdefer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len < 16) return error.BadPrompt;
+    return seed;
+}
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+/// The greedy token of a bf16 score row: its first highest score.
+fn best(bytes: []const u8) u32 {
+    const v = std.mem.bytesAsSlice(u16, bytes);
+    var at: usize = 0;
+    var top = -std.math.inf(f32);
+    for (v, 0..) |x, i| {
+        const f = bf16(x);
+        if (f > top) {
+            top = f;
+            at = i;
+        }
+    }
+    return @intCast(at);
+}
+
+/// Every stream's state saved and restored on both ranks, as the prompt cache's keep and reuse do (cuda_lanes_snap.zig:
+/// rank 0's pending rows flushed first, rank 1's at the save frame).
+fn saveRestore(r: *Rig, lanes: []Lane, rec: *Record) !void {
+    const s = r.session.?;
+    const ops = r.ops();
+    for (lanes) |*l| {
+        if (l.d.pending != 0) {
+            try ops.flushLate(&l.q, &l.d);
+            rec.flushed += 1;
+        }
+        const kept = try s.save(&l.q, null);
+        defer s.dropSaved(kept);
+        try s.restore(&l.q, null, kept);
+    }
+}
+
+/// `n` streams, each its own prompt, decoded greedily for `rounds` rounds in the open session.
+fn arm(r: *Rig, seed: []const u32, n: usize, rounds: usize, rec: *Record) !void {
+    const gpa = r.gpu.gpa;
+    const s = r.session.?;
+    const ops = r.ops();
+    var lanes: [max_streams]Lane = undefined;
+    var made: usize = 0;
+    defer for (lanes[0..made]) |*l| {
+        l.d.deinit();
+        s.drop(&l.q);
+    };
+    var ids: [96]u32 = undefined;
+    for (0..n) |i| {
+        const l = &lanes[i];
+        l.* = .{ .q = try s.create(context), .d = undefined };
+        l.d = mtp.Draft.init(gpa, r.e.driver, r.stream, context, r.head.?.ids.len, r.e.chunk, r.e.heads) catch |err| {
+            s.drop(&l.q);
+            return err;
+        };
+        made += 1;
+        if ((l.d.log != null) != mtp.Draft.late_on) return error.KnobUnread;
+        const len = 40 + (i * 11) % 48;
+        for (ids[0..len], 0..) |*t, j| t.* = seed[(i * 31 + j * 7) % seed.len];
+        try ops.prefill(&l.q, &l.d, ids[0..len]);
+        l.follow[0] = best(l.q.logits[0..row]);
+        l.nf = 1;
+        try rec.tokens[i].append(gpa, l.follow[0]);
+    }
+    var qs: [max_streams]*prompt.Seq = undefined;
+    var ds: [max_streams]*mtp.Draft = undefined;
+    var nexts: [max_streams][]const u32 = undefined;
+    var rows: [max_streams]u64 = undefined;
+    var counts: [max_streams]usize = undefined;
+    var positions: [max_streams]u64 = undefined;
+    var sms: [max_streams]?mtp.Sampling = @splat(null);
+    var outs: [max_streams]*mtp.Chain = undefined;
+    var idss: [max_streams][]const u32 = undefined;
+    var keeps: [max_streams]usize = undefined;
+    var total: i96 = 0;
+    for (0..rounds) |round| {
+        if (round == rounds / 2) try saveRestore(r, lanes[0..n], rec);
+        const t0 = check.now(r.gpu.io);
+        for (lanes[0..n], 0..) |*l, i| {
+            qs[i] = &l.q;
+            ds[i] = &l.d;
+            nexts[i] = l.follow[0..l.nf];
+            rows[i] = if (l.fresh) l.d.prompt_last else l.d.streams.ptr;
+            counts[i] = @min(depth, l.q.cap - l.q.fed - 1);
+            positions[i] = l.q.fed + 1;
+            outs[i] = &l.chain;
+        }
+        try ops.draftMany(ds[0..n], nexts[0..n], rows[0..n], counts[0..n], positions[0..n], sms[0..n], mtp.default_confidence, outs[0..n], null);
+        var total_rows: usize = 0;
+        for (lanes[0..n], 0..) |*l, i| {
+            l.window[0] = l.follow[l.nf - 1];
+            @memcpy(l.window[1..][0..l.chain.n], l.chain.slice());
+            l.nw = 1 + l.chain.n;
+            idss[i] = l.window[0..l.nw];
+            total_rows += l.nw;
+        }
+        try s.verifyMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], idss[0..n], r.out.ptr);
+        try r.stream.synchronize();
+        const scores = r.host[0 .. total_rows * row];
+        try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoH_v2(scores.ptr, r.out.ptr, scores.len), "cuMemcpyDtoH");
+        try rec.digests.append(gpa, std.hash.Wyhash.hash(round, scores));
+        var at: usize = 0;
+        for (lanes[0..n], 0..) |*l, i| {
+            var kept: usize = 0;
+            while (true) {
+                const g = best(scores[(at + kept) * row ..][0..row]);
+                l.follow[kept] = g;
+                try rec.tokens[i].append(gpa, g);
+                kept += 1;
+                if (kept == l.nw or l.window[kept] != g) break;
+            }
+            at += l.nw;
+            l.nf = kept;
+            l.fresh = false;
+            keeps[i] = kept;
+        }
+        try s.keepMany(flash.Tri, r.tri(), qs[0..n], ds[0..n], keeps[0..n]);
+        for (lanes[0..n]) |*l| {
+            if (l.d.pending != 0) rec.pending += 1;
+        }
+        rec.windows += n;
+        if (round >= warm_rounds) total += check.now(r.gpu.io) - t0;
+    }
+    try r.stream.synchronize();
+    rec.ms = @as(f64, @floatFromInt(total)) / 1e6 / @as(f64, @floatFromInt(rounds - warm_rounds));
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, rounds: usize) !void {
+    if (rounds <= warm_rounds) return error.BadRounds;
+    var seed = try seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank);
+    defer r.deinit();
+    if (rank == 1) {
+        try r.follow(port, false);
+        try r.follow(port + 1, true);
+        check.pass("rank 1 followed both sessions, pending rows on in the second", .{});
+        return;
+    }
+    const sizes = [_]usize{ 8, 16 };
+    var off: [sizes.len]Record = @splat(.{});
+    var on: [sizes.len]Record = @splat(.{});
+    defer for (&off, &on) |*a, *b| {
+        a.deinit(gpu.gpa);
+        b.deinit(gpu.gpa);
+    };
+    for ([_]bool{ false, true }, 0..) |late, phase| {
+        try r.open(port + @as(u16, @intCast(phase)), late);
+        defer r.close();
+        for (sizes, 0..) |n, i| try arm(&r, seed.items, n, rounds, if (late) &on[i] else &off[i]);
+    }
+    for (sizes, &off, &on) |n, *a, *b| {
+        try check.expect(a.pending == 0 and a.flushed == 0, "{d} streams: rows pending with TF_FLASHNEXT_TP_KEEP_LATE off", .{n});
+        try check.expect(b.pending > 0, "{d} streams: no window left rows pending with TF_FLASHNEXT_TP_KEEP_LATE on", .{n});
+        for (a.digests.items, b.digests.items, 0..) |x, y, round| {
+            try check.expect(x == y, "{d} streams: round {d}'s window scores differ with TF_FLASHNEXT_TP_KEEP_LATE", .{ n, round });
+        }
+        for (a.tokens[0..n], b.tokens[0..n], 0..) |x, y, i| {
+            const first = std.mem.indexOfDiff(u32, x.items, y.items);
+            try check.expect(first == null, "{d} streams: stream {d}'s tokens differ from token {?d}", .{ n, i, first });
+        }
+        const tokens = a.emitted(n);
+        check.pass("{d} streams, {d} rounds with the MTP head: {d} tokens ({d:.2} a window), {d} of {d} windows left rows pending, {d} flushed for a save, every round's window scores byte-equal with pending rows on both ranks", .{ n, rounds, tokens, @as(f64, @floatFromInt(tokens - n)) / @as(f64, @floatFromInt(a.windows)), b.pending, b.windows, b.flushed });
+        std.debug.print("BENCH keep-late streams={d} rounds={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - warm_rounds, a.ms, b.ms, a.ms - b.ms });
+    }
+}
+
+/// Rank 0's ms a round at `n` streams, `reps` pairs of `rounds`-round arms, a session each, off then on.
+pub fn bench(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, n: usize, rounds: usize, reps: usize) !void {
+    if (n < 2 or n > max_streams or rounds <= warm_rounds or reps == 0 or reps > 32) return error.BadBench;
+    var seed = try seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank);
+    defer r.deinit();
+    if (rank == 1) {
+        for (0..reps) |rep| for ([_]bool{ false, true }, 0..) |late, phase| try r.follow(port + @as(u16, @intCast(2 * rep + phase)), late);
+        check.pass("rank 1 followed the bench", .{});
+        return;
+    }
+    var offs: [32]f64 = undefined;
+    var ons: [32]f64 = undefined;
+    for (0..reps) |rep| {
+        for ([_]bool{ false, true }, 0..) |late, phase| {
+            try r.open(port + @as(u16, @intCast(2 * rep + phase)), late);
+            defer r.close();
+            var rec: Record = .{};
+            defer rec.deinit(gpu.gpa);
+            try arm(&r, seed.items, n, rounds, &rec);
+            if (late) ons[rep] = rec.ms else offs[rep] = rec.ms;
+        }
+        std.debug.print("rep {d}: {d:.2} ms a round off, {d:.2} on\n", .{ rep, offs[rep], ons[rep] });
+    }
+    const off = check.median(offs[0..reps]);
+    const on = check.median(ons[0..reps]);
+    std.debug.print("BENCH keep-late-round streams={d} rounds={d} reps={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - warm_rounds, reps, off, on, off - on });
+}
diff --git a/zig/tests/cuda/flashnext_kv4_lean_tests.zig b/zig/tests/cuda/flashnext_kv4_lean_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..21567231985ca91cf3159b0505a6a96c27038a8e
--- /dev/null
+++ b/zig/tests/cuda/flashnext_kv4_lean_tests.zig
@@ -0,0 +1,179 @@
+//! TF_FLASHNEXT_ATTN_KV4_LEAN on the device: fn_attn_fused_kv4_lean writes fn_attn_fused_kv4's bytes for a fused group
+//! of prompt rows over an NVFP4 cache (dense rows from the first position, dense and sparse rows deep in a context,
+//! a cache whose rows grow along it so the running maxima keep moving), at both heads splits; and both kernels' times
+//! on a --tp 2 rank's heads.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+const env = @import("sys").env;
+
+const kvf = flash.kv_format;
+const Rig = rig.Rig;
+const Heads = flash.Heads;
+const att_rows = flash.batch_state.att_rows;
+const fused_rows = flash.batch_state.fused_rows;
+const head_dim = 256;
+const cap = 4096;
+const idw = 2052;
+const knob = "TF_FLASHNEXT_ATTN_KV4_LEAN";
+
+/// Every key's magnitude: `.mixed` cycles through 2^-4 .. 2^4 by slot, `.rising` grows along the context (new maxima late).
+const Sizes = enum { mixed, rising };
+
+const Cache = struct { kc: u64, vc: u64 };
+
+fn cache(r: *Rig, hs: Heads, sizes: Sizes) !Cache {
+    const slots = cap * hs.kv;
+    const ks = kvf.keyStride(.nvfp4);
+    const vs = kvf.valueStride(.nvfp4);
+    const kc = try r.a.alloc(u8, slots * ks);
+    const vc = try r.a.alloc(u8, slots * vs);
+    var k: [head_dim]f32 = undefined;
+    var v: [head_dim]f32 = undefined;
+    for (0..slots) |slot| {
+        const pos = slot / hs.kv;
+        const size = switch (sizes) {
+            .mixed => std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(slot * 7 % 9)) - 4),
+            .rising => std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(pos * 6 / cap)) - 3),
+        };
+        for (&k, &v) |*a, *b| {
+            a.* = (r.rng.float(f32) * 2 - 1) * size;
+            b.* = (r.rng.float(f32) * 2 - 1) * size * 0.5;
+        }
+        kvf.pack(.nvfp4, &k, &v, kc[slot * ks ..][0..ks], vc[slot * vs ..][0..vs]);
+    }
+    return .{ .kc = try r.dev(kc), .vc = try r.dev(vc) };
+}
+
+/// One fused group's inputs: `rows` rows from position pos0, row i sparse when i % every != 0 (every 0: all dense, 1: all sparse).
+const Group = struct { q: u64, pos: u64, ids: u64, nk: u64, spr: u64, rows: usize };
+
+fn group(r: *Rig, hs: Heads, rows: usize, pos0: usize, every: usize) !Group {
+    const ids = try r.a.alloc(i32, rows * idw);
+    const nk = try r.a.alloc(i32, rows);
+    const spr = try r.a.alloc(i32, rows);
+    for (0..rows) |row| {
+        const sparse = every != 0 and (every == 1 or row % every != 0) and pos0 + row + 1 > idw;
+        nk[row] = @intCast(if (sparse) idw - 1 - row % 5 else pos0 + row + 1);
+        spr[row] = @intFromBool(sparse);
+        for (0..idw) |i| ids[row * idw + i] = @intCast((i * 1237 + row * 31) % (pos0 + row + 1));
+        if (sparse) std.mem.sort(i32, ids[row * idw ..][0..@intCast(nk[row])], {}, std.sort.asc(i32));
+    }
+    const pos = try r.a.alloc(i32, (rows + att_rows - 1) / att_rows * 4);
+    @memset(pos, 0);
+    for (0..pos.len / 4) |b| pos[b * 4] = @intCast(pos0 + b * att_rows);
+    return .{
+        .q = try r.dev(std.mem.sliceAsBytes(r.bfs(rows * hs.q * head_dim, 1))),
+        .pos = try r.dev(std.mem.sliceAsBytes(pos)),
+        .ids = try r.dev(std.mem.sliceAsBytes(ids)),
+        .nk = try r.dev(std.mem.sliceAsBytes(nk)),
+        .spr = try r.dev(std.mem.sliceAsBytes(spr)),
+        .rows = rows,
+    };
+}
+
+/// cuda_batch's fused launches over a group: fused_rows rows at a time, positions at their att_rows tile.
+fn launch(r: *Rig, g: *const flash.Glue, hs: Heads, c: Cache, gr: Group, out: u64) !void {
+    const qr = hs.q * head_dim * 2;
+    var r0: usize = 0;
+    while (r0 < gr.rows) : (r0 += fused_rows) {
+        const n = @min(fused_rows, gr.rows - r0);
+        try g.attnFusedQuant(.nvfp4, r.s, gr.q + r0 * qr, c.kc, c.vc, gr.pos + (r0 / att_rows) * 16, out + r0 * qr, gr.ids + r0 * idw * 4, gr.nk + r0 * 4, gr.spr + r0 * 4, n, hs);
+    }
+}
+
+fn timeUs(r: *Rig, reps: usize, g: *const flash.Glue, hs: Heads, c: Cache, gr: Group, out: u64) !f64 {
+    try launch(r, g, hs, c, gr, out);
+    try r.s.synchronize();
+    const t0 = check.now(r.gpu.io);
+    for (0..reps) |_| try launch(r, g, hs, c, gr, out);
+    try r.s.synchronize();
+    return @as(f64, @floatFromInt(check.now(r.gpu.io) - t0)) / 1e3 / @as(f64, @floatFromInt(reps));
+}
+
+fn glues(gpu: check.Gpu) ![2]flash.Glue {
+    _ = env.unsetenv(knob);
+    var plain = try flash.Glue.load(gpu.d);
+    errdefer plain.deinit();
+    _ = env.setenv(knob, "1", 1);
+    defer _ = env.unsetenv(knob);
+    const lean = try flash.Glue.load(gpu.d);
+    if (lean.kv4_lean == null or plain.kv4_lean != null) return error.AttnKv4LeanNotLoaded;
+    return .{ plain, lean };
+}
+
+const Case = struct { name: []const u8, rows: usize, pos0: usize, every: usize, sizes: Sizes };
+
+const cases = [_]Case{
+    .{ .name = "dense from position 0", .rows = 1024, .pos0 = 0, .every = 0, .sizes = .mixed },
+    .{ .name = "every third row dense at 2,600", .rows = 1024, .pos0 = 2600, .every = 3, .sizes = .mixed },
+    .{ .name = "sparse at 3,000", .rows = 1000, .pos0 = 3000, .every = 1, .sizes = .mixed },
+    .{ .name = "dense from 1,000, rising rows", .rows = 1024, .pos0 = 1000, .every = 0, .sizes = .rising },
+    .{ .name = "sparse at 3,000, rising rows", .rows = 64, .pos0 = 3000, .every = 1, .sizes = .rising },
+    .{ .name = "one row at 7", .rows = 1, .pos0 = 7, .every = 0, .sizes = .mixed },
+};
+
+/// `flashnext-kv4-lean`: the bytes.
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x4ea9);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var gs = try glues(gpu);
+    defer for (&gs) |*g| g.deinit();
+    var checked: usize = 0;
+    for ([_]Heads{ .half, .full }) |hs| {
+        for (cases) |cs| {
+            comptime std.debug.assert(3000 + 1024 <= cap);
+            const c = try cache(&r, hs, cs.sizes);
+            const gr = try group(&r, hs, cs.rows, cs.pos0, cs.every);
+            const bytes = cs.rows * hs.q * head_dim * 2;
+            const want = try r.out(bytes);
+            try launch(&r, &gs[0], hs, c, gr, want);
+            const got = try r.out(bytes);
+            try launch(&r, &gs[1], hs, c, gr, got);
+            var name_buf: [128]u8 = undefined;
+            const name = try std.fmt.bufPrint(&name_buf, "flashnext-kv4-lean q{d}/kv{d}, {d} rows {s}", .{ hs.q, hs.kv, cs.rows, cs.name });
+            try check.sameBytes(name, try r.back(u8, got, bytes), try r.back(u8, want, bytes));
+            std.debug.print("RESULT {s}: byte-equal\n", .{name});
+            checked += 1;
+        }
+    }
+    check.pass("flashnext-kv4-lean: fn_attn_fused_kv4_lean wrote fn_attn_fused_kv4's bytes in {d} groups (dense, mixed and sparse rows, settled and rising maxima, whole and half heads)", .{checked});
+}
+
+/// `flashnext-kv4-lean-bench [REPS]`: both kernels at a --tp 2 rank's heads over a 3,072-row pass's three fused groups,
+/// deep (every row sparse, 2,048 keys), fresh (from position 0: dense, then sparse past 2,051 keys) and a 900-row fresh
+/// prompt; ms per 36 layers.
+pub fn bench(gpu: check.Gpu, args: []const [:0]const u8) !void {
+    const reps = if (args.len > 0) std.fmt.parseInt(usize, args[0], 10) catch return check.expect(false, "flashnext-kv4-lean-bench: REPS {s} is not a count", .{args[0]}) else 20;
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x4eaa);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var gs = try glues(gpu);
+    defer for (&gs) |*g| g.deinit();
+    const hs: Heads = .half;
+    const shapes = [_]Case{
+        .{ .name = "deep: every row sparse", .rows = 1024, .pos0 = 3000, .every = 1, .sizes = .mixed },
+        .{ .name = "fresh: dense to 2,051 keys, sparse past", .rows = 3072, .pos0 = 0, .every = 1, .sizes = .mixed },
+        .{ .name = "fresh 900 rows", .rows = 900, .pos0 = 0, .every = 1, .sizes = .mixed },
+    };
+    for (shapes) |cs| {
+        const c = try cache(&r, hs, cs.sizes);
+        const gr = try group(&r, hs, cs.rows, cs.pos0, cs.every);
+        const out = try r.out(cs.rows * hs.q * head_dim * 2);
+        const plain = try timeUs(&r, reps, &gs[0], hs, c, gr, out);
+        const lean = try timeUs(&r, reps, &gs[1], hs, c, gr, out);
+        const per: f64 = if (cs.rows == fused_rows) 3.0 else 1.0;
+        std.debug.print("RESULT flashnext-kv4-lean-bench q{d}/kv{d} {s}, {d} rows: fn_attn_fused_kv4 {d:.1} us, _lean {d:.1} us ({d:.1}%); per 36 layers{s} {d:.2} vs {d:.2} ms\n", .{
+            hs.q,                                                     hs.kv,                   cs.name,                cs.rows, plain, lean, (plain - lean) / plain * 100,
+            if (per == 3.0) " (x3 groups: a 3,072-row pass)" else "", plain * 36 * per / 1000, lean * 36 * per / 1000,
+        });
+    }
+    check.pass("flashnext-kv4-lean-bench: {d} reps a shape", .{reps});
+}
diff --git a/zig/tests/cuda/flashnext_kv4_smem_tests.zig b/zig/tests/cuda/flashnext_kv4_smem_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f81a4adb5a937cc0caf8cfb0dd636be1d8103e8d
--- /dev/null
+++ b/zig/tests/cuda/flashnext_kv4_smem_tests.zig
@@ -0,0 +1,393 @@
+//! TF_FLASHNEXT_ATTN_KV4_SMEM on the device: fn_attn_fused_kv4_smem and _kv84_smem write fn_attn_fused_kv4's and _kv84's
+//! bytes for prompt rows over nvfp4 and fp8k_nvfp4v caches, at both heads splits, 64 to 3,072 rows after 1k, 32k and 82k
+//! cached positions, through cuda_batch's fused groups, one launch from a first position and one launch of per-row
+//! sequence bounds (two sequences' rows interleaved in one launch); and both kernels' times on a --tp 2 rank's heads.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+const env = @import("sys").env;
+
+const kvf = flash.kv_format;
+const Rig = rig.Rig;
+const Heads = flash.Heads;
+const att_rows = flash.batch_state.att_rows;
+const fused_rows = flash.batch_state.fused_rows;
+const head_dim = 256;
+const idw = 2052;
+const ratio = 4;
+const top = 512;
+const cap = 82000 + 3072 + 128;
+const patterns = 4099;
+const attn_layers = 12;
+const block_rows = 3;
+const knob = "TF_FLASHNEXT_ATTN_KV4_SMEM";
+
+const Cache = struct { kc: u64, vc: u64, ks: usize, vs: usize };
+
+/// `cap` positions of two KV heads in `format`: each slot one of `patterns` packed rows (hashed by slot), sizes 2^-4 .. 2^4.
+fn cache(r: *Rig, format: kvf.Kv) !Cache {
+    const gpa = r.gpu.gpa;
+    const ks = kvf.keyStride(format);
+    const vs = kvf.valueStride(format);
+    const pk = try gpa.alloc(u8, patterns * ks);
+    defer gpa.free(pk);
+    const pv = try gpa.alloc(u8, patterns * vs);
+    defer gpa.free(pv);
+    var k: [head_dim]f32 = undefined;
+    var v: [head_dim]f32 = undefined;
+    for (0..patterns) |p| {
+        const size = std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(p * 7 % 9)) - 4);
+        for (&k, &v) |*a, *b| {
+            a.* = (r.rng.float(f32) * 2 - 1) * size;
+            b.* = (r.rng.float(f32) * 2 - 1) * size * 0.5;
+        }
+        kvf.pack(format, &k, &v, pk[p * ks ..][0..ks], pv[p * vs ..][0..vs]);
+    }
+    const slots = cap * 2;
+    const kc = try gpa.alloc(u8, slots * ks);
+    defer gpa.free(kc);
+    const vc = try gpa.alloc(u8, slots * vs);
+    defer gpa.free(vc);
+    for (0..slots) |slot| {
+        const p = (slot *% 2654435761) % patterns;
+        @memcpy(kc[slot * ks ..][0..ks], pk[p * ks ..][0..ks]);
+        @memcpy(vc[slot * vs ..][0..vs], pv[p * vs ..][0..vs]);
+    }
+    return .{ .kc = try r.dev(kc), .vc = try r.dev(vc), .ks = ks, .vs = vs };
+}
+
+/// `.picked`: the indexer's shape (dense to 2,051 keys; past it 512 blocks of 4, neighbours sharing all but a block, then
+/// the tail); `.scattered`: every sparse row its own ids (few shared keys, repeats); `.every_third`: `.picked` with every
+/// third row dense however deep.
+const Style = enum { picked, scattered, every_third };
+
+const Group = struct {
+    q: []const u16,
+    ids: []const i32,
+    nk: []const i32,
+    spr: []const i32,
+    pos0: usize,
+    rows: usize,
+    dq: u64,
+    dpos: u64,
+    dids: u64,
+    dnk: u64,
+    dspr: u64,
+
+    fn key(gr: Group, row: usize, ki: usize) i32 {
+        return if (gr.spr[row] != 0) gr.ids[row * idw + ki] else @intCast(ki);
+    }
+};
+
+fn group(r: *Rig, hs: Heads, rows: usize, pos0: usize, style: Style) !Group {
+    const ids = try r.a.alloc(i32, rows * idw);
+    @memset(ids, 0);
+    const nk = try r.a.alloc(i32, rows);
+    const spr = try r.a.alloc(i32, rows);
+    const space = @max((pos0 + 1) / ratio, top);
+    const chosen = try r.a.alloc(bool, @max((pos0 + rows) / ratio + 1, space));
+    @memset(chosen, false);
+    var base: [top]usize = undefined;
+    var nb: usize = 0;
+    while (nb < top) {
+        const b = r.rng.uintLessThan(usize, space);
+        if (!chosen[b]) {
+            chosen[b] = true;
+            base[nb] = b;
+            nb += 1;
+        }
+    }
+    for (0..rows) |row| {
+        const end = pos0 + row + 1;
+        const complete = end / ratio;
+        const sparse = complete > top and (style != .every_third or row % 3 != 0);
+        spr[row] = @intFromBool(sparse);
+        nk[row] = @intCast(end);
+        if (!sparse) continue;
+        const out = ids[row * idw ..][0..idw];
+        var n: usize = 0;
+        switch (style) {
+            .scattered => {
+                n = idw - 1 - row % 5;
+                for (out[0..n], 0..) |*x, i| x.* = @intCast((i * 1237 + row * 31) % end);
+                std.mem.sort(i32, out[0..n], {}, std.sort.asc(i32));
+            },
+            .picked, .every_third => {
+                @memset(chosen[0..complete], false);
+                var count: usize = 0;
+                for (base, 0..) |b, i| {
+                    if (b < complete and i % 61 != row % 61) {
+                        chosen[b] = true;
+                        count += 1;
+                    }
+                }
+                var b = complete;
+                while (count < top) {
+                    b -= 1;
+                    if (!chosen[b]) {
+                        chosen[b] = true;
+                        count += 1;
+                    }
+                }
+                for (0..complete) |x| {
+                    if (!chosen[x]) continue;
+                    for (0..ratio) |e| {
+                        out[n] = @intCast(x * ratio + e);
+                        n += 1;
+                    }
+                }
+                for (complete * ratio..end) |x| {
+                    out[n] = @intCast(x);
+                    n += 1;
+                }
+            },
+        }
+        nk[row] = @intCast(n);
+    }
+    const pos = try r.a.alloc(i32, (rows + att_rows - 1) / att_rows * 4);
+    @memset(pos, 0);
+    for (0..pos.len / 4) |b| pos[b * 4] = @intCast(pos0 + b * att_rows);
+    const q = r.bfs(rows * hs.q * head_dim, 1);
+    return .{
+        .q = q,
+        .ids = ids,
+        .nk = nk,
+        .spr = spr,
+        .pos0 = pos0,
+        .rows = rows,
+        .dq = try r.dev(std.mem.sliceAsBytes(q)),
+        .dpos = try r.dev(std.mem.sliceAsBytes(pos)),
+        .dids = try r.dev(std.mem.sliceAsBytes(ids)),
+        .dnk = try r.dev(std.mem.sliceAsBytes(nk)),
+        .dspr = try r.dev(std.mem.sliceAsBytes(spr)),
+    };
+}
+
+/// Distinct keys a block's step widens, on average (32 when its three rows read the same keys, 96 when none are shared).
+fn distinct(gr: Group) f64 {
+    var total: usize = 0;
+    var steps: usize = 0;
+    var b: usize = 0;
+    while (b < gr.rows) : (b += block_rows) {
+        const rows = @min(b + block_rows, gr.rows);
+        var tiles: usize = 0;
+        for (b..rows) |row| tiles = @max(tiles, (@as(usize, @intCast(gr.nk[row])) + 31) / 32);
+        for (0..tiles) |j| {
+            var keys: [block_rows * 32]i32 = undefined;
+            var n: usize = 0;
+            for (b..rows) |row| {
+                for (0..32) |l| {
+                    const ki = j * 32 + l;
+                    if (ki >= @as(usize, @intCast(gr.nk[row]))) break;
+                    keys[n] = gr.key(row, ki);
+                    n += 1;
+                }
+            }
+            std.mem.sort(i32, keys[0..n], {}, std.sort.asc(i32));
+            for (keys[0..n], 0..) |x, i| total += @intFromBool(i == 0 or keys[i - 1] != x);
+            steps += 1;
+        }
+    }
+    return @as(f64, @floatFromInt(total)) / @as(f64, @floatFromInt(@max(steps, 1)));
+}
+
+/// cuda_batch's fused launches over a group: fused_rows rows at a time, positions at their att_rows tile.
+fn launch(r: *Rig, g: *const flash.Glue, format: kvf.Kv, hs: Heads, c: Cache, gr: Group, out: u64) !void {
+    const qr = hs.q * head_dim * 2;
+    var r0: usize = 0;
+    while (r0 < gr.rows) : (r0 += fused_rows) {
+        const n = @min(fused_rows, gr.rows - r0);
+        try g.attnFusedQuant(format, r.s, gr.dq + r0 * qr, c.kc, c.vc, gr.dpos + (r0 / att_rows) * 16, out + r0 * qr, gr.dids + r0 * idw * 4, gr.dnk + r0 * 4, gr.dspr + r0 * 4, n, hs);
+    }
+}
+
+/// Every row in one launch: from the group's first position (`rs` 0) or each row's {sequence, first slot, slot end, position}.
+fn launchSeqs(r: *Rig, g: *const flash.Glue, format: kvf.Kv, hs: Heads, c: Cache, gr: Group, rs: u64, out: u64) !void {
+    try g.attnFusedSeqs(format, r.s, gr.dq, c.kc, c.vc, gr.dpos, rs, out, gr.dids, gr.dnk, gr.dspr, gr.rows, hs);
+}
+
+fn ownBounds(r: *Rig, gr: Group) !u64 {
+    const rs = try r.a.alloc([4]i32, gr.rows);
+    for (rs, 0..) |*x, row| x.* = .{ 0, 0, cap, @intCast(gr.pos0 + row) };
+    return r.dev(std.mem.sliceAsBytes(rs));
+}
+
+fn timeUs(r: *Rig, reps: usize, g: *const flash.Glue, format: kvf.Kv, hs: Heads, c: Cache, gr: Group, out: u64) !f64 {
+    try launch(r, g, format, hs, c, gr, out);
+    try r.s.synchronize();
+    const t0 = check.now(r.gpu.io);
+    for (0..reps) |_| try launch(r, g, format, hs, c, gr, out);
+    try r.s.synchronize();
+    return @as(f64, @floatFromInt(check.now(r.gpu.io) - t0)) / 1e3 / @as(f64, @floatFromInt(reps));
+}
+
+fn glues(gpu: check.Gpu) ![2]flash.Glue {
+    _ = env.unsetenv(knob);
+    _ = env.unsetenv("TF_FLASHNEXT_ATTN_KV4_LEAN");
+    var plain = try flash.Glue.load(gpu.d);
+    errdefer plain.deinit();
+    _ = env.setenv(knob, "1", 1);
+    defer _ = env.unsetenv(knob);
+    const smem = try flash.Glue.load(gpu.d);
+    if (smem.kv4_smem == null or plain.kv4_smem != null) return error.AttnKv4SmemNotLoaded;
+    return .{ plain, smem };
+}
+
+const Case = struct { rows: usize, pos0: usize, style: Style };
+
+const cases = [_]Case{
+    .{ .rows = 64, .pos0 = 1000, .style = .picked },
+    .{ .rows = 512, .pos0 = 1000, .style = .picked },
+    .{ .rows = 900, .pos0 = 1000, .style = .picked },
+    .{ .rows = 3072, .pos0 = 1000, .style = .picked },
+    .{ .rows = 64, .pos0 = 32000, .style = .picked },
+    .{ .rows = 512, .pos0 = 32000, .style = .picked },
+    .{ .rows = 900, .pos0 = 32000, .style = .picked },
+    .{ .rows = 3072, .pos0 = 32000, .style = .picked },
+    .{ .rows = 64, .pos0 = 82000, .style = .picked },
+    .{ .rows = 512, .pos0 = 82000, .style = .picked },
+    .{ .rows = 900, .pos0 = 82000, .style = .picked },
+    .{ .rows = 3072, .pos0 = 82000, .style = .picked },
+    .{ .rows = 3072, .pos0 = 0, .style = .picked },
+    .{ .rows = 900, .pos0 = 32000, .style = .scattered },
+    .{ .rows = 512, .pos0 = 2600, .style = .every_third },
+    .{ .rows = 1, .pos0 = 7, .style = .picked },
+    .{ .rows = 2, .pos0 = 82000, .style = .picked },
+};
+
+const formats = [_]kvf.Kv{ .nvfp4, .fp8k_nvfp4v };
+
+/// `flashnext-kv4-smem`: the bytes.
+pub fn run(gpu: check.Gpu) !void {
+    comptime std.debug.assert(82000 + 3072 <= cap);
+    var outer: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer outer.deinit();
+    var prng = std.Random.DefaultPrng.init(0x4eab);
+    var rc = try Rig.init(gpu, outer.allocator(), prng.random());
+    defer rc.deinit();
+    var gs = try glues(gpu);
+    defer for (&gs) |*g| g.deinit();
+    var checked: usize = 0;
+    for (formats) |format| {
+        const c = try cache(&rc, format);
+        for ([_]Heads{ .half, .full }) |hs| {
+            for (cases) |cs| {
+                var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+                defer arena.deinit();
+                var r = try Rig.init(gpu, arena.allocator(), prng.random());
+                defer r.deinit();
+                const gr = try group(&r, hs, cs.rows, cs.pos0, cs.style);
+                const bytes = cs.rows * hs.q * head_dim * 2;
+                const want = try r.out(bytes);
+                try launch(&r, &gs[0], format, hs, c, gr, want);
+                const got = try r.out(bytes);
+                try launch(&r, &gs[1], format, hs, c, gr, got);
+                const one = try r.out(bytes);
+                try launchSeqs(&r, &gs[1], format, hs, c, gr, 0, one);
+                const seqs = try r.out(bytes);
+                try launchSeqs(&r, &gs[1], format, hs, c, gr, try ownBounds(&r, gr), seqs);
+                const w = try r.back(u8, want, bytes);
+                var name_buf: [160]u8 = undefined;
+                const name = try std.fmt.bufPrint(&name_buf, "flashnext-kv4-smem {s} q{d}/kv{d}, {d} rows after {d} ({s}, {d:.1} distinct keys a step)", .{ @tagName(format), hs.q, hs.kv, cs.rows, cs.pos0, @tagName(cs.style), distinct(gr) });
+                try check.sameBytes(name, try r.back(u8, got, bytes), w);
+                try check.sameBytes(name, try r.back(u8, one, bytes), w);
+                try check.sameBytes(name, try r.back(u8, seqs, bytes), w);
+                std.debug.print("RESULT {s}: byte-equal (fused groups, one launch, row bounds)\n", .{name});
+                checked += 1;
+            }
+            try packed2(gpu, &prng, &gs, format, hs, c);
+            checked += 1;
+        }
+    }
+    check.pass("flashnext-kv4-smem: fn_attn_fused_kv4_smem and _kv84_smem wrote fn_attn_fused_kv4's and _kv84's bytes in {d} groups (64 to 3,072 rows after 1k, 32k and 82k cached, picked, scattered and mixed rows, two sequences in one launch, both heads splits)", .{checked});
+}
+
+/// Two sequences in one launch, their rows interleaved: A at slots 0.., 300 rows after 1,500 cached; B at slots 2,000..,
+/// 400 rows after 30,000; each against fn_attn_fused_kv4 (_kv84) over its own cache.
+fn packed2(gpu: check.Gpu, prng: *std.Random.DefaultPrng, gs: *const [2]flash.Glue, format: kvf.Kv, hs: Heads, c: Cache) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    const firsts = [2]usize{ 0, 2000 };
+    const grs = [2]Group{ try group(&r, hs, 300, 1500, .picked), try group(&r, hs, 400, 30000, .picked) };
+    const ends = [2]usize{ 1800, 2000 + 30400 };
+    const row_elems = hs.q * head_dim;
+    var wants: [2][]const u16 = undefined;
+    for (grs, firsts, 0..) |gr, first, sq| {
+        const cs: Cache = .{ .kc = c.kc + first * hs.kv * c.ks, .vc = c.vc + first * hs.kv * c.vs, .ks = c.ks, .vs = c.vs };
+        const w = try r.out(gr.rows * row_elems * 2);
+        try launch(&r, &gs[0], format, hs, cs, gr, w);
+        wants[sq] = try r.back(u16, w, gr.rows * row_elems);
+    }
+    const rows = grs[0].rows + grs[1].rows;
+    const from = try r.a.alloc([2]usize, rows);
+    var next = [2]usize{ 0, 0 };
+    for (from, 0..) |*f, p| {
+        const sq: usize = if ((p % 2 == 0 and next[0] < grs[0].rows) or next[1] == grs[1].rows) 0 else 1;
+        f.* = .{ sq, next[sq] };
+        next[sq] += 1;
+    }
+    const q = try r.a.alloc(u16, rows * row_elems);
+    const ids = try r.a.alloc(i32, rows * idw);
+    const nk = try r.a.alloc(i32, rows);
+    const spr = try r.a.alloc(i32, rows);
+    const rs = try r.a.alloc([4]i32, rows);
+    for (from, 0..) |f, p| {
+        const gr = grs[f[0]];
+        const row = f[1];
+        @memcpy(q[p * row_elems ..][0..row_elems], gr.q[row * row_elems ..][0..row_elems]);
+        @memcpy(ids[p * idw ..][0..idw], gr.ids[row * idw ..][0..idw]);
+        nk[p] = gr.nk[row];
+        spr[p] = gr.spr[row];
+        rs[p] = .{ @intCast(f[0]), @intCast(firsts[f[0]]), @intCast(ends[f[0]]), @intCast(gr.pos0 + row) };
+    }
+    const both: Group = .{ .q = q, .ids = ids, .nk = nk, .spr = spr, .pos0 = 0, .rows = rows, .dq = try r.dev(std.mem.sliceAsBytes(q)), .dpos = 0, .dids = try r.dev(std.mem.sliceAsBytes(ids)), .dnk = try r.dev(std.mem.sliceAsBytes(nk)), .dspr = try r.dev(std.mem.sliceAsBytes(spr)) };
+    const got_d = try r.out(rows * row_elems * 2);
+    try launchSeqs(&r, &gs[1], format, hs, c, both, try r.dev(std.mem.sliceAsBytes(rs)), got_d);
+    const got = try r.back(u16, got_d, rows * row_elems);
+    var name_buf: [128]u8 = undefined;
+    const name = try std.fmt.bufPrint(&name_buf, "flashnext-kv4-smem {s} q{d}/kv{d}, two sequences interleaved", .{ @tagName(format), hs.q, hs.kv });
+    for (from, 0..) |f, p| {
+        try check.sameBytes(name, std.mem.sliceAsBytes(got[p * row_elems ..][0..row_elems]), std.mem.sliceAsBytes(wants[f[0]][f[1] * row_elems ..][0..row_elems]));
+    }
+    std.debug.print("RESULT {s}: byte-equal ({d} rows, each against its own sequence's launch)\n", .{ name, rows });
+}
+
+/// `flashnext-kv4-smem-bench [REPS]`: both kernels at a --tp 2 rank's heads (q12/kv1) through cuda_batch's fused groups,
+/// nvfp4 and fp8k_nvfp4v: 3,072 and 900 rows after 82k cached, 3,072 after 32k, a fresh 3,072-row prompt, and 3,072 after
+/// 82k with scattered ids (few keys shared); ms per pass of the 12 attention layers.
+pub fn bench(gpu: check.Gpu, args: []const [:0]const u8) !void {
+    const reps = if (args.len > 0) std.fmt.parseInt(usize, args[0], 10) catch return check.expect(false, "flashnext-kv4-smem-bench: REPS {s} is not a count", .{args[0]}) else 20;
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x4eac);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var gs = try glues(gpu);
+    defer for (&gs) |*g| g.deinit();
+    const hs: Heads = .half;
+    const shapes = [_]Case{
+        .{ .rows = 3072, .pos0 = 82000, .style = .picked },
+        .{ .rows = 900, .pos0 = 82000, .style = .picked },
+        .{ .rows = 3072, .pos0 = 32000, .style = .picked },
+        .{ .rows = 3072, .pos0 = 0, .style = .picked },
+        .{ .rows = 3072, .pos0 = 82000, .style = .scattered },
+    };
+    var grs: [shapes.len]Group = undefined;
+    for (shapes, &grs) |cs, *gr| gr.* = try group(&r, hs, cs.rows, cs.pos0, cs.style);
+    for (formats) |format| {
+        const c = try cache(&r, format);
+        for (shapes, grs) |cs, gr| {
+            const out = try r.out(cs.rows * hs.q * head_dim * 2);
+            const plain = try timeUs(&r, reps, &gs[0], format, hs, c, gr, out);
+            const smem = try timeUs(&r, reps, &gs[1], format, hs, c, gr, out);
+            std.debug.print("RESULT flashnext-kv4-smem-bench {s} q{d}/kv{d}, {d} rows after {d} ({s}, {d:.1} distinct keys a step of 96): fused {d:.1} us, _smem {d:.1} us ({d:.1}%); per pass of {d} attention layers {d:.2} vs {d:.2} ms\n", .{
+                @tagName(format), hs.q, hs.kv, cs.rows, cs.pos0, @tagName(cs.style), distinct(gr), plain, smem, (plain - smem) / plain * 100, attn_layers, plain * attn_layers / 1000, smem * attn_layers / 1000,
+            });
+        }
+    }
+    check.pass("flashnext-kv4-smem-bench: {d} reps a shape", .{reps});
+}
diff --git a/zig/tests/cuda/flashnext_lanes_any_tests.zig b/zig/tests/cuda/flashnext_lanes_any_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2080891650edd4350357f9f6816a97c3071f5296
--- /dev/null
+++ b/zig/tests/cuda/flashnext_lanes_any_tests.zig
@@ -0,0 +1,225 @@
+//! TF_FLASHNEXT_ATTN_LANES_ANY at --tp 2 with the MTP head on rank 0, as served: nvfp4 caches (or TF_TEST_KV_CACHE's),
+//! the indexer keys' window (unless TF_FLASHNEXT_INDEX_WINDOW=0), TF_FLASHNEXT_TP_KEEP_BATCH and KEEP_LANES. 8 and 16
+//! streams decode greedily for ROUNDS rounds in a session with it off, then in the next session (PORT + 1) with it on,
+//! on both ranks: every stream's tokens and every round's window scores are byte-equal, and the on session's rounds took
+//! the one-launch attention. `bench`: rank 0's ms a round at one stream count, REPS alternating off and on sessions.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const keep_early = @import("flashnext_keep_early_tests.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const env = @import("sys").env;
+const Session = flash.rank_engine.Session;
+const Record = keep_early.Record;
+
+const knob = "TF_FLASHNEXT_ATTN_LANES_ANY";
+const context = keep_early.context;
+const max_streams = keep_early.max_streams;
+const row = keep_early.row;
+
+/// One engine and (rank 0) head across sessions; `next` closes the session and opens the following one at the next port
+/// with the knob set as asked, on both ranks.
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: *Session,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+    out: cuda.DeviceBuffer,
+    host: []u8,
+    identity: flash.rank_engine.Identity,
+    rank: usize,
+    port: u16,
+    opened: u16 = 0,
+
+    fn setKnob(on: bool) void {
+        _ = env.setenv(knob, if (on) "1" else "0", 1);
+    }
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, on: bool) !void {
+        _ = env.setenv("TF_FLASHNEXT_TP_KEEP_BATCH", "1", 1);
+        _ = env.setenv("TF_FLASHNEXT_KEEP_LANES", "1", 1);
+        setKnob(on);
+        r.gpu = gpu;
+        r.rank = rank;
+        r.port = port;
+        r.opened = 0;
+        r.head = null;
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        const kv = try kvCache();
+        const window = try flash.index_window.wanted();
+        r.identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        r.identity.mtp = 1;
+        r.identity.kv_cache = @intFromEnum(kv);
+        r.identity.index_window = @intFromBool(window);
+        r.session = try Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, r.identity, flash.rank_engine.linkWait());
+        r.e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank) catch |err| {
+            r.session.poison();
+            r.session.deinit();
+            return err;
+        };
+        errdefer {
+            r.session.poison();
+            r.session.deinit();
+            r.e.deinit();
+        }
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        // as cuda_lanes_load.zig sets a served engine's caches before its first stream
+        r.e.kv = kv;
+        r.e.index_window = if (window) flash.index_window.rows(r.e.chunk) else 0;
+        try r.attach();
+        _ = try r.e.reserve(@min(context, r.e.chunk));
+        r.out = try cuda.DeviceBuffer.alloc(gpu.d, max_streams * mtp.max_rows * row);
+        errdefer r.out.free();
+        r.host = try gpu.gpa.alloc(u8, max_streams * mtp.max_rows * row);
+        errdefer gpu.gpa.free(r.host);
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    fn attach(r: *Rig) !void {
+        r.session.engine = r.e;
+        r.e.collective = &r.session.collective;
+        if (!r.session.keep_batch) return error.KnobUnread;
+        if (flash.knobs.tpRoce()) try r.session.collective.openRoce(r.gpu.gpa, r.gpu.io, r.gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    }
+
+    /// Rank 1 follows the open session to its end; both ranks then open the next one with the knob `on`.
+    fn next(r: *Rig, on: bool) !void {
+        if (r.rank == 1) try r.session.follow(flash.Tri, r.tri(), r.out.ptr);
+        try r.stream.synchronize();
+        r.session.deinit();
+        setKnob(on);
+        r.opened += 1;
+        r.session = try Session.init(r.gpu.gpa, r.gpu.io, @import("flashnext_rank_tests.zig").rankHost(), r.port + r.opened, r.rank, r.identity, flash.rank_engine.linkWait());
+        try r.attach();
+    }
+
+    fn deinit(r: *Rig) void {
+        if (r.rank == 1) r.session.follow(flash.Tri, r.tri(), r.out.ptr) catch {};
+        r.session.deinit();
+        _ = env.unsetenv(knob);
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.gpu.gpa.free(r.host);
+        r.out.free();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    pub fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    pub fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback, .rollback_many = rollbackMany } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+    fn rollbackMany(p: *anyopaque, qs: []const *prompt.Seq, ds: []const *mtp.Draft, keeps: []const usize) anyerror!void {
+        const r = of(p);
+        return r.session.keepMany(flash.Tri, r.tri(), qs, ds, keeps);
+    }
+};
+
+/// TF_TEST_KV_CACHE: the caches' format by --kv-cache name (bf16, fp8, nvfp4, fp8k_nvfp4v); unset, nvfp4 as served.
+fn kvCache() !flash.kv_format.Kv {
+    const v = std.c.getenv("TF_TEST_KV_CACHE") orelse return .nvfp4;
+    return std.meta.stringToEnum(flash.kv_format.Kv, std.mem.span(v)) orelse error.BadKvCache;
+}
+
+/// One arm at `n` streams; the passes it staged for the one-launch attention.
+fn arm(r: *Rig, seed: []const u32, n: usize, rounds: usize, rec: *Record) !usize {
+    const before = flash.batch_lanes.Taken.passes;
+    try keep_early.decode(r, seed, n, rounds, rec);
+    return flash.batch_lanes.Taken.passes - before;
+}
+
+fn bfLanesOn() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_ATTN_LANES") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, rounds: usize) !void {
+    if (rounds <= keep_early.warm_rounds) return error.BadRounds;
+    var seed = try keep_early.seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    const counts = [_]usize{ 8, 16 };
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, false);
+    defer r.deinit();
+    var offs: [counts.len]Record = @splat(.{});
+    defer for (&offs) |*x| x.deinit(gpu.gpa);
+    var ons: [counts.len]Record = @splat(.{});
+    defer for (&ons) |*x| x.deinit(gpu.gpa);
+    var taken_off: [counts.len]usize = @splat(0);
+    var taken_on: [counts.len]usize = @splat(0);
+    if (rank == 0) for (counts, &offs, &taken_off) |n, *rec, *t| {
+        t.* = try arm(&r, seed.items, n, rounds, rec);
+    };
+    try r.next(true);
+    if (rank == 1) return check.pass("rank 1 followed the off and on sessions", .{});
+    for (counts, &ons, &taken_on) |n, *rec, *t| t.* = try arm(&r, seed.items, n, rounds, rec);
+    for (counts, offs, ons, taken_off, taken_on) |n, off, on, t_off, t_on| {
+        for (off.digests.items, on.digests.items, 0..) |a, b, round| {
+            try check.expect(a == b, "{d} streams: round {d}'s window scores differ with {s}", .{ n, round, knob });
+        }
+        for (off.tokens[0..n], on.tokens[0..n], 0..) |a, b, i| {
+            const first = std.mem.indexOfDiff(u32, a.items, b.items);
+            try check.expect(first == null, "{d} streams: stream {d}'s tokens differ from token {?d}", .{ n, i, first });
+        }
+        try check.expect(t_on >= rounds, "{d} streams: only {d} of {d} rounds took the one-launch attention", .{ n, t_on, rounds });
+        if (!bfLanesOn()) try check.expect(t_off == 0, "{d} streams: {d} passes took the one-launch attention with {s}=0", .{ n, t_off, knob });
+        const tokens = off.emitted(n);
+        check.pass("{d} streams, {d} rounds with the MTP head: {d} tokens ({d:.2} a window) and every round's window scores byte-equal with {s} ({d} passes took it)", .{ n, rounds, tokens, @as(f64, @floatFromInt(tokens - n)) / @as(f64, @floatFromInt(off.windows)), knob, t_on });
+        std.debug.print("BENCH lanes-any streams={d} rounds={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - keep_early.warm_rounds, off.ms, on.ms, off.ms - on.ms });
+    }
+}
+
+/// Rank 0's ms a round at `n` streams: `reps` pairs of `rounds`-round arms, an off session then an on one, medians.
+pub fn bench(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, n: usize, rounds: usize, reps: usize) !void {
+    if (n < 2 or n > max_streams or rounds <= keep_early.warm_rounds or reps == 0 or reps > 32) return error.BadBench;
+    var seed = try keep_early.seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, port, false);
+    defer r.deinit();
+    var offs: [32]f64 = undefined;
+    var ons: [32]f64 = undefined;
+    for (0..reps) |rep| {
+        inline for (.{ false, true }) |on| {
+            if (rep > 0 or on) try r.next(on);
+            if (rank == 0) {
+                var rec: Record = .{};
+                defer rec.deinit(gpu.gpa);
+                _ = try arm(&r, seed.items, n, rounds, &rec);
+                if (on) ons[rep] = rec.ms else offs[rep] = rec.ms;
+            }
+        }
+        if (rank == 0) std.debug.print("rep {d}: {d:.2} ms a round off, {d:.2} on\n", .{ rep, offs[rep], ons[rep] });
+    }
+    if (rank == 1) return check.pass("rank 1 followed the bench's {d} sessions", .{2 * reps});
+    const off = check.median(offs[0..reps]);
+    const on = check.median(ons[0..reps]);
+    std.debug.print("BENCH lanes-any-round streams={d} rounds={d} reps={d} off_ms={d:.2} on_ms={d:.2} saved_ms={d:.2}\n", .{ n, rounds - keep_early.warm_rounds, reps, off, on, off - on });
+}
diff --git a/zig/tests/cuda/flashnext_link_bench_tests.zig b/zig/tests/cuda/flashnext_link_bench_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e9dc433c5281ec62b798d2ca194e274f108c6e57
--- /dev/null
+++ b/zig/tests/cuda/flashnext_link_bench_tests.zig
@@ -0,0 +1,120 @@
+//! tf-cuda-test flashnext-link-bench RANK PORT [KIB...]: the --tp 2 link as the engine's collective owner uses it. At
+//! each size (KiB a rank; default 64 1024 5120 10240 40960) an fp32 sum (all-reduce) and a bf16 all-gather, each by the
+//! TF_FLASHNEXT_TP_ROCE path (one-shot RDMA writes, the cap opened at the largest size) and by NCCL (the same owner with
+//! RoCE set aside, as the engine runs a size past the cap): back to back for bandwidth, and one call with a host wait at a
+//! time for latency, medians of three runs. Every call moves a rank's bytes once each way over the link, so GB/s is a
+//! rank's bytes over the back-to-back time a call, against 25 GB/s (200 Gb/s) a direction. Needs both ranks' RoCE up.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rank_tests = @import("flashnext_rank_tests.zig");
+const wire = flash.rank_wire;
+const Collective = flash.collective.Collective;
+
+const default_kib = [_]usize{ 64, 1024, 5120, 10240, 40960 };
+const line_gbps: f64 = 25.0;
+const reps = 3;
+
+const Kind = enum { sum, gather };
+const Path = enum { roce, nccl };
+
+fn meet(link: wire.Link, rank: usize, seq: usize) !void {
+    const h: wire.Header = .{ .kind = .ready, .sequence = seq };
+    const until = wire.deadline(60_000);
+    if (rank == 0) {
+        try link.sendHeader(h, until);
+        const got = try link.receiveHeader(until);
+        try check.expect(got.kind == .ready and got.sequence == seq, "rank 0: peer in step at {d}", .{seq});
+        return;
+    }
+    const got = try link.receiveHeader(until);
+    try check.expect(got.kind == .ready and got.sequence == seq, "rank 1: peer in step at {d}", .{seq});
+    try link.sendHeader(h, until);
+}
+
+fn call(c: *Collective, stream: cuda.Stream, k: Kind, a: u64, out: u64, bytes: usize) !void {
+    switch (k) {
+        .sum => try c.sum(stream, a, bytes / 4),
+        .gather => try c.gather(stream, a, out, bytes / 2),
+    }
+}
+
+fn parseSizes(gpa: std.mem.Allocator, args: []const [:0]const u8) ![]usize {
+    if (args.len == 0) return gpa.dupe(usize, &default_kib);
+    const out = try gpa.alloc(usize, args.len);
+    errdefer gpa.free(out);
+    for (args, out) |s, *o| {
+        o.* = std.fmt.parseInt(usize, s, 10) catch return error.BadSize;
+        if (o.* == 0 or o.* > 65536) return error.BadSize;
+    }
+    return out;
+}
+
+pub fn run(gpu: check.Gpu, rank: usize, port: u16, size_args: []const [:0]const u8) !void {
+    const kibs = try parseSizes(gpu.gpa, size_args);
+    defer gpu.gpa.free(kibs);
+    var most: usize = 0;
+    for (kibs) |k| most = @max(most, k * 1024);
+    const link = try wire.Link.open(gpu.io, rank_tests.rankHost(), port, rank, 60_000);
+    defer link.close();
+    var c = try Collective.init(link, rank, 30_000);
+    defer c.deinit();
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    try c.openRoce(gpu.gpa, gpu.io, gpu.d, true, most);
+    const g = c.roce orelse {
+        std.debug.print("FAIL rank {d}: RoCE did not come up on both ranks (see the RoCE all-gather warning above)\n", .{rank});
+        return error.TestFailed;
+    };
+    check.pass("rank {d}: RoCE up, {d} HCA(s), cap {d} KiB", .{ rank, g.n_hca, g.max_bytes >> 10 });
+    var a = try cuda.DeviceBuffer.alloc(gpu.d, most);
+    defer a.free();
+    var b = try cuda.DeviceBuffer.alloc(gpu.d, 2 * most);
+    defer b.free();
+    try a.fill8(0, stream.handle);
+    try b.fill8(0, stream.handle);
+    try stream.synchronize();
+    if (rank == 0) std.debug.print("link bench: GB/s = a rank's bytes / back-to-back us a call (each way); line {d:.0} GB/s a direction\n", .{line_gbps});
+    var seq: usize = 1;
+    for (kibs) |kib| for ([_]Kind{ .sum, .gather }) |k| for ([_]Path{ .roce, .nccl }) |p| {
+        const bytes = kib * 1024;
+        const calls: usize = std.math.clamp((1 << 30) / bytes, 10, 400);
+        const alone_calls = @min(calls, 50);
+        if (p == .nccl) c.roce = null;
+        defer c.roce = g;
+        const before = g.gathers;
+        var b2b: [reps]f64 = undefined;
+        var alone: [reps]f64 = undefined;
+        for (0..reps) |r| {
+            seq += 1;
+            try meet(link, rank, seq);
+            for (0..3) |_| try call(&c, stream, k, a.ptr, b.ptr, bytes);
+            try c.finish(stream);
+            seq += 1;
+            try meet(link, rank, seq);
+            var t0 = wire.now();
+            for (0..calls) |_| try call(&c, stream, k, a.ptr, b.ptr, bytes);
+            try c.finish(stream);
+            b2b[r] = @as(f64, @floatFromInt(wire.now() - t0)) / 1e3 / @as(f64, @floatFromInt(calls));
+            seq += 1;
+            try meet(link, rank, seq);
+            t0 = wire.now();
+            for (0..alone_calls) |_| {
+                try call(&c, stream, k, a.ptr, b.ptr, bytes);
+                try c.finish(stream);
+            }
+            alone[r] = @as(f64, @floatFromInt(wire.now() - t0)) / 1e3 / @as(f64, @floatFromInt(alone_calls));
+        }
+        const by_roce = g.gathers - before;
+        const want: usize = if (p == .roce) reps * (3 + calls + alone_calls) else 0;
+        try check.expect(by_roce == want, "rank {d}: {s} {s} {d} KiB: {d} calls went by RoCE, expected {d}", .{ rank, @tagName(k), @tagName(p), kib, by_roce, want });
+        const us = check.median(&b2b);
+        const lat = check.median(&alone);
+        const gbps = @as(f64, @floatFromInt(bytes)) / us / 1e3;
+        if (rank == 0) std.debug.print("BENCH link kind={s} path={s} kib={d} bytes={d} calls={d} b2b_us={d:.1} alone_us={d:.1} GBps={d:.2} line_pct={d:.1}\n", .{ @tagName(k), @tagName(p), kib, bytes, calls, us, lat, gbps, 100 * gbps / line_gbps });
+    };
+    seq += 1;
+    try meet(link, rank, seq);
+    check.pass("rank {d}: link bench at {d} sizes, sum and gather, RoCE and NCCL", .{ rank, kibs.len });
+}
diff --git a/zig/tests/cuda/flashnext_mixed_table_tests.zig b/zig/tests/cuda/flashnext_mixed_table_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..dd023145d6d3afff466a5d09b26a309a030a39dc
--- /dev/null
+++ b/zig/tests/cuda/flashnext_mixed_table_tests.zig
@@ -0,0 +1,278 @@
+//! TF_FLASHNEXT_MIXED_TABLE at --tp 2. At 8, 16 and 28 drafted windows, a mixed round with a 512-row piece and with
+//! the widest piece the table can pick leaves the same bytes as the piece's own pass then the windows' shared verify
+//! (every window row's scores, the piece's hidden streams). Then the timing: the windows' verify alone, mixed rounds of
+//! 256 rows to the widest piece against the piece's pass alone (ms saved a 1536-row chunk-equivalent), the round's fit
+//! as a base plus a time a piece row, and the rows cuda_mixed_plan.Fit settles on under the table's limit, with the
+//! prompt and round rates they give. AT > 0 starts each timed piece at that position (both ranks take the same AT).
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const plan = flash.mixed_plan;
+const env = @import("sys").env;
+
+const window_context = 4096;
+const levels = [_]usize{ 8, 16, 28 };
+const max_windows = 28;
+const reps = 3;
+const fit_rounds = 10;
+const piece_room = 64 * 1024;
+const default_table = "8:350,16:450,28:650";
+
+pub const Windows = struct {
+    seqs: [max_windows]prompt.Seq = undefined,
+    drafts: [max_windows]mtp.Draft = undefined,
+    tokens: [max_windows][3]u32 = undefined,
+    qs: [max_windows]*prompt.Seq = undefined,
+    ds: [max_windows]*mtp.Draft = undefined,
+    idss: [max_windows][]const u32 = undefined,
+    n: usize = 0,
+    rows: usize,
+
+    pub fn init(w: *Windows, gpu: check.Gpu, session: *flash.rank_engine.Session, tri: flash.Tri, e: *prompt.Engine, stream: *cuda.Stream, seed: []const u32, count: usize) !void {
+        errdefer w.deinit(session);
+        for (0..count) |i| {
+            w.seqs[i] = try session.create(window_context);
+            w.drafts[i] = mtp.Draft.init(gpu.gpa, e.driver, stream.*, window_context, 1, 32, e.heads) catch |err| {
+                session.drop(&w.seqs[i]);
+                return err;
+            };
+            w.n += 1;
+            var base: [40]u32 = undefined;
+            for (&base, 0..) |*v, k| v.* = seed[(i * 31 + k * 7) % seed.len];
+            try session.forward(flash.Tri, tri, &w.seqs[i], base[0 .. 24 + i % 16], .{});
+            for (&w.tokens[i], 0..) |*v, k| v.* = seed[(i * 3 + k * 17 + 1) % seed.len];
+        }
+        for (0..count) |i| {
+            w.qs[i] = &w.seqs[i];
+            w.ds[i] = &w.drafts[i];
+            w.idss[i] = w.tokens[i][0..w.rows];
+        }
+    }
+
+    pub fn deinit(w: *Windows, session: *flash.rank_engine.Session) void {
+        for (w.seqs[0..w.n], w.drafts[0..w.n]) |*q, *d| {
+            d.deinit();
+            session.drop(q);
+        }
+        w.n = 0;
+    }
+
+    pub fn keepAll(w: *Windows, session: *flash.rank_engine.Session, tri: flash.Tri) !void {
+        for (w.qs[0..w.n], w.ds[0..w.n]) |q, d| try session.keep(flash.Tri, tri, q, d, w.rows);
+    }
+};
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+    ids: []const u32,
+    out: u64,
+    streams: cuda.DeviceBuffer,
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, at_arg: ?[]const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const at = if (at_arg) |v| try std.fmt.parseInt(usize, v, 10) else 0;
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    const table_text = if (std.c.getenv("TF_FLASHNEXT_MIXED_TABLE")) |v| std.mem.span(v) else default_table;
+    const table = (try plan.tableSetting(table_text)).?;
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const context = @max(window_context, at + piece_room + chunk);
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, max_windows * 3 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed the table's mixed and separate rounds", .{});
+        return;
+    }
+    const round_cap = @min(flash.knobs.roundRowsCap(), chunk);
+    const max_np = plan.pieceRows(chunk, chunk, round_cap);
+    if (max_np < 512) return error.RankIdentity;
+    const ids = try gpu.gpa.alloc(u32, context);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, max_np * prompt.hidden_wide * 2);
+    defer streams.free();
+    const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items, .ids = ids, .out = logits.ptr, .streams = streams };
+    std.debug.print("flashnext-mixed-table: passes of {d} rows, round rows at most {d}, pieces of 64 to {d} rows, timed pieces from position {d}, table {s}\n", .{ chunk, round_cap, max_np, at, table_text });
+    for (levels) |d| {
+        const wr = @max(1, @min(3, round_cap / d));
+        for ([_]usize{ 512, max_np }) |np| {
+            if (!plan.fits(np, d * wr, chunk)) return error.RankIdentity;
+            try compare(rig, np, d, wr);
+            check.pass("table mixed round: {d} prompt rows beside {d} windows of {d} rows, the windows' scores and the piece's streams equal the separate passes'", .{ np, d, wr });
+        }
+        try bench(rig, at, max_np, d, wr, table);
+    }
+}
+
+fn compare(r: Rig, np: usize, d: usize, wr: usize) !void {
+    const row = prompt.vocabulary * 2;
+    var got: [2]struct { rows: []u8, streams: []u8 } = undefined;
+    var made: usize = 0;
+    defer for (got[0..made]) |g| {
+        r.gpu.gpa.free(g.rows);
+        r.gpu.gpa.free(g.streams);
+    };
+    for (&got) |*g| {
+        const rows = try r.gpu.gpa.alloc(u8, d * wr * row);
+        g.* = .{ .rows = rows, .streams = r.gpu.gpa.alloc(u8, np * prompt.hidden_wide * 2) catch |err| {
+            r.gpu.gpa.free(rows);
+            return err;
+        } };
+        made += 1;
+    }
+    for (&got, [_]bool{ false, true }) |*g, mixed| {
+        var w: Windows = .{ .rows = wr };
+        try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+        defer w.deinit(r.session);
+        var p = try r.session.create(window_context + np);
+        defer r.session.drop(&p);
+        if (mixed) {
+            try r.session.mixed(flash.Tri, r.tri, .{ .seq = &p, .ids = r.ids[0..np], .streams = r.streams.ptr }, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+        } else {
+            try r.session.forward(flash.Tri, r.tri, &p, r.ids[0..np], .{ .logits = .none, .streams = r.streams.ptr });
+            try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+        }
+        try r.stream.synchronize();
+        const dr = r.e.driver;
+        try dr.check(dr.api.cuMemcpyDtoH_v2(g.rows.ptr, r.out, g.rows.len), "cuMemcpyDtoH");
+        try dr.check(dr.api.cuMemcpyDtoH_v2(g.streams.ptr, r.streams.ptr, g.streams.len), "cuMemcpyDtoH");
+        try w.keepAll(r.session, r.tri);
+    }
+    try check.sameBytes("each window row's scores in a table-sized mixed round equal the shared verify's", got[1].rows, got[0].rows);
+    try check.sameBytes("the table-sized piece's hidden streams in a mixed round equal its own pass's", got[1].streams, got[0].streams);
+}
+
+fn now(io: std.Io) u64 {
+    return @intCast(std.Io.Clock.awake.now(io).toNanoseconds());
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / std.time.ns_per_ms;
+}
+
+const Timer = struct {
+    r: Rig,
+    w: *Windows,
+    p: *prompt.Seq,
+
+    fn verify(t: Timer) !u64 {
+        const t0 = now(t.r.gpu.io);
+        try t.r.session.verifyMany(flash.Tri, t.r.tri, t.w.qs[0..t.w.n], t.w.ds[0..t.w.n], t.w.idss[0..t.w.n], t.r.out);
+        try t.r.stream.synchronize();
+        const ns = now(t.r.gpu.io) - t0;
+        try t.w.keepAll(t.r.session, t.r.tri);
+        return ns;
+    }
+
+    fn mixed(t: Timer, np: usize) !u64 {
+        const t0 = now(t.r.gpu.io);
+        try t.r.session.mixed(flash.Tri, t.r.tri, .{ .seq = t.p, .ids = t.r.ids[t.p.fed..][0..np], .streams = t.r.streams.ptr }, t.w.qs[0..t.w.n], t.w.ds[0..t.w.n], t.w.idss[0..t.w.n], t.r.out);
+        try t.r.stream.synchronize();
+        const ns = now(t.r.gpu.io) - t0;
+        try t.w.keepAll(t.r.session, t.r.tri);
+        return ns;
+    }
+
+    fn alone(t: Timer, np: usize) !u64 {
+        const t0 = now(t.r.gpu.io);
+        try t.r.session.forward(flash.Tri, t.r.tri, t.p, t.r.ids[t.p.fed..][0..np], .{ .logits = .none, .streams = t.r.streams.ptr });
+        try t.r.stream.synchronize();
+        return now(t.r.gpu.io) - t0;
+    }
+
+    fn mean(t: Timer, comptime f: anytype, args: anytype) !u64 {
+        _ = try @call(.auto, f, .{t} ++ args);
+        var sum: u64 = 0;
+        for (0..reps) |_| sum += try @call(.auto, f, .{t} ++ args);
+        return sum / reps;
+    }
+};
+
+fn bench(r: Rig, at: usize, max_np: usize, d: usize, wr: usize, table: plan.Table) !void {
+    var w: Windows = .{ .rows = wr };
+    try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+    defer w.deinit(r.session);
+    var p = try r.session.create(at + piece_room + r.e.chunk);
+    defer r.session.drop(&p);
+    while (p.fed < at) try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..@min(at, p.fed + r.e.chunk)], .{ .logits = .none });
+    try r.stream.synchronize();
+    const t: Timer = .{ .r = r, .w = &w, .p = &p };
+    const from = p.fed;
+    const base = try t.mean(Timer.verify, .{});
+    var xs: [4]f64 = undefined;
+    var ys: [4]f64 = undefined;
+    var k: usize = 0;
+    for ([_]usize{ 256, 512, 1024, max_np }) |want| {
+        const np = @min(want, max_np);
+        if (k > 0 and xs[k - 1] >= @as(f64, @floatFromInt(np))) continue;
+        const mixed_ns = try t.mean(Timer.mixed, .{np});
+        const alone_ns = try t.mean(Timer.alone, .{np});
+        xs[k] = @floatFromInt(np);
+        ys[k] = ms(mixed_ns);
+        k += 1;
+        const scale = 1536 / xs[k - 1];
+        std.debug.print("RESULT flashnext-mixed-table {d} windows x {d} rows, {d} piece rows: verify alone {d:.1} ms, piece alone {d:.1} ms, mixed {d:.1} ms; a 1536-row chunk-equivalent costs {d:.1} ms mixed vs {d:.1} ms alone, {d:.1} ms saved\n", .{ d, wr, np, ms(base), ms(alone_ns), ms(mixed_ns), (ms(mixed_ns) - ms(base)) * scale, ms(alone_ns) * scale, (ms(alone_ns) + ms(base) - ms(mixed_ns)) * scale });
+    }
+    var sx: f64 = 0;
+    var sy: f64 = 0;
+    var sxx: f64 = 0;
+    var sxy: f64 = 0;
+    for (xs[0..k], ys[0..k]) |x, y| {
+        sx += x;
+        sy += y;
+        sxx += x * x;
+        sxy += x * y;
+    }
+    const kn: f64 = @floatFromInt(k);
+    const slope = if (k > 1) (kn * sxy - sx * sy) / (kn * sxx - sx * sx) else 0;
+    std.debug.print("RESULT flashnext-mixed-table {d} windows: mixed round = {d:.1} ms + {d:.1} us a piece row (verify alone {d:.1} ms; pieces from position {d} to {d})\n", .{ d, (sy - slope * sx) / kn, slope * 1000, ms(base), from, p.fed });
+    var f = plan.Fit.init(table, 512, max_np);
+    var n: usize = 0;
+    var ns: u64 = 0;
+    for (0..fit_rounds) |_| {
+        if (p.fed + max_np > p.cap) break;
+        n = f.rows(d);
+        ns = try t.mixed(n);
+        f.observe(d, n, ns);
+    }
+    if (n == 0) return;
+    const limit = table.limit(d);
+    std.debug.print("RESULT flashnext-mixed-table {d} windows, limit {d} ms: the fit settles on {d} piece rows, a round of {d:.1} ms ({s} the limit, learnt row {d:.1} us); {d:.0} prompt tok/s in mixed rounds, {d:.2} rounds/s a window ({d:.0}% of verify alone's)\n", .{ d, limit / std.time.ns_per_ms, n, ms(ns), if (ns <= limit) "within" else "over", @as(f64, @floatFromInt(f.row_ns)) / 1000, @as(f64, @floatFromInt(n)) * 1000 / ms(ns), 1000 / ms(ns), 100 * ms(base) / ms(ns) });
+}
diff --git a/zig/tests/cuda/flashnext_mtp_prompt_tests.zig b/zig/tests/cuda/flashnext_mtp_prompt_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4dd4d311ae8f3dc0de68d34901585df27a246ce7
--- /dev/null
+++ b/zig/tests/cuda/flashnext_mtp_prompt_tests.zig
@@ -0,0 +1,201 @@
+//! TF_FLASHNEXT_MTP_PROMPT: the MTP head over a prompt's chunks as a prompt pass (prompt tiles, fused read-out,
+//! INDEX_MMA's selection when it is on). tf-cuda-test flashnext-mtp-prompt MODEL IDS_FILE: two prompts of two and a half
+//! chunks with the knob off, on twice and on with the side stream; the knob's runs repeat byte for byte, the side
+//! stream's equal the main stream's, and the head's scores after each prompt stay within a bound of the decode tiles'.
+//! flashnext-mtp-prompt-bench MODEL: the head's prompt pass alone, knob off and on, at 546, 1536 and 3072 rows after
+//! 64k and 96k cached keys (zero keys: the cost of the work, not of the values), ms a pass.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const Side = flash.mtp_side.Side;
+const env = @import("sys").env;
+
+const knob = "TF_FLASHNEXT_MTP_PROMPT";
+const bound = 5e-2;
+const reps = 5;
+const wide = 4 * 2560;
+
+fn set(on: bool) void {
+    _ = env.setenv(knob, if (on) "1" else "0", 1);
+}
+
+const Arm = struct {
+    seqs: [2]prompt.Seq = undefined,
+    drafts: [2]mtp.Draft = undefined,
+    made: usize = 0,
+    tokens: [2]u32 = undefined,
+    logits: [2][]u8 = undefined,
+    got: usize = 0,
+    sided: usize = 0,
+
+    fn deinit(a: *Arm, gpa: std.mem.Allocator) void {
+        for (a.logits[0..a.got]) |b| gpa.free(b);
+        for (a.seqs[0..a.made], a.drafts[0..a.made]) |*q, *d| {
+            d.deinit();
+            q.deinit(gpa);
+        }
+    }
+};
+
+fn bf16(b: []const u8, i: usize) f64 {
+    const u: u32 = @as(u32, std.mem.readInt(u16, b[2 * i ..][0..2], .little)) << 16;
+    return @as(f32, @bitCast(u));
+}
+
+fn relL2(got: []const u8, want: []const u8) f64 {
+    var num: f64 = 0;
+    var den: f64 = 0;
+    for (0..want.len / 2) |i| {
+        const a = bf16(got, i);
+        const b = bf16(want, i);
+        if (!std.math.isFinite(a) or !std.math.isFinite(b)) return std.math.inf(f64);
+        num += (a - b) * (a - b);
+        den += b * b;
+    }
+    return @sqrt(num / @max(den, 1e-30));
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, ids_path: []const u8) !void {
+    const gpa = gpu.gpa;
+    defer _ = env.unsetenv(knob);
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpa, .limited(1 << 20));
+    defer gpa.free(source);
+    var base: std.ArrayList(u32) = .empty;
+    defer base.deinit(gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try base.append(gpa, try std.fmt.parseInt(u32, word, 10));
+    if (base.items.len < 16) return error.BadPrompt;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const e = try prompt.Engine.init(gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+    defer e.deinit();
+    const h = try mtp.Head.init(gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+    defer h.deinit();
+    const ops: mtp.Ops(flash.Tri) = .{ .e = e, .tri = tri, .h = h };
+    const n = 2 * e.chunk + e.chunk / 2 + 7;
+    var ids: [2][]u32 = undefined;
+    for (&ids, 0..) |*p, j| {
+        p.* = try gpa.alloc(u32, n - 5 * j);
+        for (p.*, 0..) |*t, i| t.* = base.items[(i * (1 + 6 * j) + 3 * j) % base.items.len];
+    }
+    defer for (ids) |p| gpa.free(p);
+
+    set(false);
+    var off: Arm = .{};
+    defer off.deinit(gpa);
+    try arm(gpu, ops, &stream, ids, &off);
+    set(true);
+    var on: Arm = .{};
+    defer on.deinit(gpa);
+    try arm(gpu, ops, &stream, ids, &on);
+    var again: Arm = .{};
+    defer again.deinit(gpa);
+    try arm(gpu, ops, &stream, ids, &again);
+    h.side = try Side.init(gpa, gpu.d, &e.batch_k, Side.rowsFor(e.chunk, flash.knobs.headPiece(), e.chunk));
+    var side: Arm = .{};
+    defer side.deinit(gpa);
+    try arm(gpu, ops, &stream, ids, &side);
+    try check.expect(side.sided == 2 * 2, "every prompt's two non-final chunks left their head rows on the side stream ({d})", .{side.sided});
+    for (0..2) |j| {
+        try check.sameBytes("the head's scores with the knob, run twice", again.logits[j], on.logits[j]);
+        try check.sameBytes("the head's scores with the knob, side stream against main", side.logits[j], on.logits[j]);
+        try check.expect(again.tokens[j] == on.tokens[j] and side.tokens[j] == on.tokens[j], "prompt {d}: the knob's greedy draft repeats", .{j});
+        const rel = relL2(on.logits[j], off.logits[j]);
+        std.debug.print("RESULT mtp-prompt prompt {d}: scores rel-L2 {e:.3} against the decode tiles', greedy draft {d} (off {d})\n", .{ j, rel, on.tokens[j], off.tokens[j] });
+        try check.expect(rel <= bound, "prompt {d}: the head's scores after the prompt pass within rel-L2 {d} of the decode tiles' ({e:.3})", .{ j, bound, rel });
+    }
+    check.pass("flashnext-mtp-prompt: {d}-row chunks, two prompts: repeats and side stream byte-exact, scores within rel-L2 {d} of the decode tiles'", .{ e.chunk, bound });
+}
+
+fn arm(gpu: check.Gpu, ops: mtp.Ops(flash.Tri), stream: *cuda.Stream, ids: [2][]u32, a: *Arm) !void {
+    const gpa = gpu.gpa;
+    const e = ops.e;
+    for (0..2) |j| {
+        a.seqs[j] = try e.newSeq(ids[j].len + 64);
+        a.drafts[j] = mtp.Draft.init(gpa, e.driver, stream.*, ids[j].len + 64, ops.h.ids.len, e.chunk, e.heads) catch |err| {
+            a.seqs[j].deinit(gpa);
+            return err;
+        };
+        a.made += 1;
+        a.drafts[j].reset();
+    }
+    var at = [2]usize{ 0, 0 };
+    while (at[0] < ids[0].len or at[1] < ids[1].len) {
+        for (0..2) |j| if (at[j] < ids[j].len) {
+            const d = &a.drafts[j];
+            const stop = @min(ids[j].len, at[j] + @min(e.chunk, d.rows_cap));
+            try ops.prefillChunk(&a.seqs[j], d, ids[j], at[j], stop);
+            if (d.side_done != null) a.sided += 1;
+            at[j] = stop;
+        };
+    }
+    for (0..2) |j| {
+        const d = &a.drafts[j];
+        const next = [_]u32{@intCast((41 + 97 * j) % 50_000)};
+        var chain: mtp.Chain = undefined;
+        try ops.draft(d, &next, d.prompt_last, 0, 1, null, 0, &chain);
+        try stream.synchronize();
+        a.tokens[j] = chain.slice()[0];
+        a.logits[j] = try check.download(gpu, d.dlogits);
+        a.got += 1;
+    }
+}
+
+pub fn bench(gpu: check.Gpu, dir: []const u8) !void {
+    const gpa = gpu.gpa;
+    defer _ = env.unsetenv(knob);
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const e = try prompt.Engine.init(gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+    defer e.deinit();
+    const h = try mtp.Head.init(gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+    defer h.deinit();
+    const ops: mtp.Ops(flash.Tri) = .{ .e = e, .tri = tri, .h = h };
+    const most = 3072;
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(gpu.d, true);
+    defer end.deinit();
+    var prng = std.Random.DefaultPrng.init(0x3970);
+    const next = try gpa.alloc(u32, most);
+    defer gpa.free(next);
+    for (next) |*t| t.* = prng.random().uintLessThan(u32, 50_000);
+    const rows_host = try gpa.alloc(u16, most * wide);
+    defer gpa.free(rows_host);
+    for (rows_host) |*v| v.* = @truncate(@as(u32, @bitCast(prng.random().floatNorm(f32))) >> 16);
+    std.debug.print("RESULT mtp-prompt-bench keys rows off_ms on_ms saved_ms (head piece {d})\n", .{flash.knobs.headPiece()});
+    for ([_]usize{ 65536, 98304 }) |keys| {
+        var d = try mtp.Draft.init(gpa, e.driver, stream, keys + most + 64, h.ids.len, most, e.heads);
+        defer d.deinit();
+        for ([_]cuda.DeviceBuffer{ d.kc, d.vc, d.ikc, d.pooled }) |b| try b.fill8(0, stream.handle);
+        try d.streams.upload(0, std.mem.sliceAsBytes(rows_host));
+        for ([_]usize{ 546, 1536, 3072 }) |rows| {
+            var ms: [2]f64 = undefined;
+            for ([_]bool{ false, true }, 0..) |on, i| {
+                set(on);
+                d.reset();
+                d.len = keys;
+                try ops.forwardHeadPieces(&d, next[0..rows], d.streams.ptr, false, flash.knobs.headPiece(), on);
+                try start.record(stream);
+                for (0..reps) |_| {
+                    d.len = keys;
+                    try ops.forwardHeadPieces(&d, next[0..rows], d.streams.ptr, false, flash.knobs.headPiece(), on);
+                }
+                try end.record(stream);
+                try end.synchronize();
+                ms[i] = @as(f64, try start.elapsedMs(end)) / reps;
+            }
+            std.debug.print("RESULT mtp-prompt-bench {d} {d} {d:.2} {d:.2} {d:.2}\n", .{ keys, rows, ms[0], ms[1], ms[0] - ms[1] });
+        }
+    }
+    check.pass("flashnext-mtp-prompt-bench: the head's prompt pass timed knob off and on", .{});
+}
