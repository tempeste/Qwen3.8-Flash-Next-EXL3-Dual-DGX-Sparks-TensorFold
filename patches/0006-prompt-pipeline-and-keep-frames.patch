+        dedup(0);
+        kid[i * TK + lane] = key_at(1);
+    }
+    __syncthreads();
+    fetch(0, 0);
+    qmm_frag::wait<0>();
+    const int tiles = (n + TK - 1) / TK, per_chunk = CH / TK;
+    const int qh = lane & 15, qrow = qh < G ? SL + 1 + i * G + qh : Z;
+    float m[2] = {-INFINITY, -INFINITY}, l[2] = {0.0f, 0.0f}, o[8][4] = {};
+    float mm[2] = {-INFINITY, -INFINITY}, ll[2] = {0.0f, 0.0f}, oo[8][4] = {};
+    float next_m[2] = {}, alpha[2] = {};
+    for (int j = 0; j < steps; ++j) {
+        const int b = j & 1;
+        const bool act = j < tiles;
+        const unsigned char* sl = slots[b] + i * TK;
+        __syncthreads();
+        widen(b, 0);
+        fetch(b, 1);
+        if (dw) {
+            const int nkey = key_at(j + 2);
+            dedup(b ^ 1);
+            kid[i * TK + lane] = nkey;
+        }
+        __syncthreads();
+        float s[4] = {};
+        if (act) {
+            if (j % per_chunk == 0) {
+#pragma unroll
+                for (int h = 0; h < 2; ++h) {
+                    m[h] = -INFINITY;
+                    l[h] = 0.0f;
+                }
+#pragma unroll
+                for (int q = 0; q < 8; ++q)
+#pragma unroll
+                    for (int e = 0; e < 4; ++e) o[q][e] = 0.0f;
+            }
