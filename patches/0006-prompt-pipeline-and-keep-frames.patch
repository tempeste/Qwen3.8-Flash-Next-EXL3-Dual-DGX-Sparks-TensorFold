+        if (f.last_n != 0 and f.last_d == decoders and n != f.last_n and (n > f.last_n) == (ns > f.last_ns)) {
+            const dn: u64 = if (n > f.last_n) n - f.last_n else f.last_n - n;
+            const dt: u64 = if (ns > f.last_ns) ns - f.last_ns else f.last_ns - ns;
+            const seen = std.math.clamp(dt / dn, prior_row_ns / 2, prior_row_ns * 4);
+            f.row_ns = (f.row_ns + seen) / 2;
+        }
+        f.last_d = decoders;
+        f.last_n = n;
+        f.last_ns = ns;
+        const seen = @max(1, ns -| @as(u64, n) * f.row_ns);
+        const b = &f.base[@min(decoders, max_decoders)];
+        b.* = if (b.* == 0) seen else @max(1, (b.* + seen) / 2);
+    }
+};
