+++ b/zig/src/core/lane_host_overlap.zig
@@ -0,0 +1,98 @@
+const std = @import("std");
+
+pub const row_step = 64;
+pub const least_piece: u32 = 512;
+pub const full_wait_ns: u64 = 10 * std.time.ns_per_s;
+pub const idle_share: f64 = 0.5;
+pub const floor_share: f64 = 0.2;
+pub const piece_base_ns: u64 = 33 * std.time.ns_per_ms;
+pub const piece_row_ns: u64 = 330 * std.time.ns_per_us;
+
+pub const Plan = struct {
+    whole_rows: u32,
+
+    pub fn init(whole_rows: u32) Plan {
+        return .{ .whole_rows = whole_rows };
+    }
+
+    pub fn whole(p: Plan, uncached: u64) bool {
+        return uncached < p.whole_rows;
+    }
+
+    pub fn fullRows(p: Plan) u64 {
+        return 4 * @as(u64, p.whole_rows);
+    }
+
+    pub fn pressure(p: Plan, queued_rows: u64, oldest_ns: u64) f64 {
+        const by_rows = @as(f64, @floatFromInt(queued_rows)) / @as(f64, @floatFromInt(@max(p.fullRows(), 1)));
+        const by_wait = @as(f64, @floatFromInt(oldest_ns)) / @as(f64, @floatFromInt(full_wait_ns));
+        return std.math.clamp(@max(by_rows, by_wait), 0, 1);
+    }
+
+    pub fn piece(p: Plan, at: f64) u32 {
+        const top = @max(p.whole_rows, least_piece);
+        const rows = lerp(@floatFromInt(least_piece), @floatFromInt(top), at);
+        return @max(row_step, @as(u32, @intFromFloat(rows)) / row_step * row_step);
+    }
+
+    pub fn burst(p: Plan, at: f64) u64 {
+        return @intFromFloat(lerp(@floatFromInt(p.whole_rows), @floatFromInt(p.fullRows()), at));
+    }
+
+    pub fn share(_: Plan, at: f64) f64 {
+        return lerp(idle_share, floor_share, at);
+    }
+
+    pub fn pieceNs(_: Plan, rows: u64) i64 {
+        return @intCast(piece_base_ns + rows * piece_row_ns);
+    }
+
+    pub fn owed(p: Plan, at: f64, ns: i64) i64 {
+        if (ns <= 0) return 0;
+        const s = p.share(at);
+        return @intFromFloat(@as(f64, @floatFromInt(ns)) * s / (1 - s));
+    }
+};
+
+fn lerp(a: f64, b: f64, at: f64) f64 {
+    return a + (b - a) * std.math.clamp(at, 0, 1);
+}
+
+test "prefill service: overlap pressure rises with queued rows and the oldest wait, capped at 1" {
+    const p = Plan.init(4096);
+    try std.testing.expectEqual(@as(f64, 0), p.pressure(0, 0));
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5), p.pressure(8192, 0), 1e-9);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5), p.pressure(0, 5 * std.time.ns_per_s), 1e-9);
+    try std.testing.expectApproxEqAbs(@as(f64, 0.75), p.pressure(12288, 5 * std.time.ns_per_s), 1e-9);
+    try std.testing.expectEqual(@as(f64, 1), p.pressure(1 << 30, 0));
+    try std.testing.expectEqual(@as(f64, 1), p.pressure(0, 1 << 50));
+}
+
+test "prefill service: overlap pieces grow from 512 rows to the threshold in whole row steps" {
+    const p = Plan.init(4096);
+    try std.testing.expectEqual(@as(u32, 512), p.piece(0));
+    try std.testing.expectEqual(@as(u32, 4096), p.piece(1));
+    try std.testing.expectEqual(@as(u32, 2304), p.piece(0.5));
+    for (0..101) |i| {
+        const r = p.piece(@as(f64, @floatFromInt(i)) / 100);
+        try std.testing.expect(r % row_step == 0 and r >= 512 and r <= 4096);
+    }
+    try std.testing.expectEqual(@as(u32, 512), Plan.init(64).piece(1));
+    try std.testing.expectEqual(@as(u32, 512), Plan.init(64).piece(0));
+}
+
+test "prefill service: overlap bursts and the decode floor scale with pressure" {
+    const p = Plan.init(4096);
+    try std.testing.expectEqual(@as(u64, 4096), p.burst(0));
+    try std.testing.expectEqual(@as(u64, 16384), p.burst(1));
+    try std.testing.expectEqual(@as(i64, 1000), p.owed(0, 1000));
+    try std.testing.expectEqual(@as(i64, 250), p.owed(1, 1000));
+    try std.testing.expectEqual(@as(i64, 0), p.owed(1, -5));
+    try std.testing.expect(p.whole(4095) and !p.whole(4096));
+    try std.testing.expectEqual(@as(i64, 33 * std.time.ns_per_ms + 512 * 330 * std.time.ns_per_us), p.pieceNs(512));
+    try std.testing.expectEqual(@as(i64, 4 * p.pieceNs(2944)), p.owed(1, 4 * p.pieceNs(2944)) * 4);
+}
+
+test {
+    _ = @import("lane_host_overlap_sim_test.zig");
+}
