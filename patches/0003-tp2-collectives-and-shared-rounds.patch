+        hist: [lanes][ple.max_n]i64 = undefined,
+        on: [lanes]bool = @splat(false),
+
+        /// Stream `k` drafts after `history` (its sequence's last n - 1 tokens); another length leaves it unhinted.
+        pub fn lane(a: *@This(), k: usize, history: []const i64) void {
+            const n1 = a.g.hash.n - 1;
+            a.on[k] = history.len == n1;
+            if (a.on[k]) @memcpy(a.hist[k][0..n1], history);
+        }
+
+        /// Stream `k`'s next token: its rows hinted, then it joins the history.
+        pub fn push(a: *@This(), k: usize, token: u32) void {
+            if (!a.on[k]) return;
+            const n1 = a.g.hash.n - 1;
+            const h = a.hist[k][0..n1];
+            var ids: [ple.max_heads]i64 = undefined;
+            ple.lastIds(a.g.hash, h, token, ids[0..a.g.hash.heads]) catch {
+                a.on[k] = false;
