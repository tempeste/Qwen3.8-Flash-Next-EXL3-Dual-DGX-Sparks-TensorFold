+/// TF_FLASHNEXT_PREFILL_TAIL=rows: a prompt's last chunk under this many rows is evened out with the one before it (0, unset or
+/// unparsable: off, the single-Spark recipe's default).
+pub fn prefillTail() usize {
+    const v = std.c.getenv("TF_FLASHNEXT_PREFILL_TAIL") orelse return 0;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch 0;
+}
+
+/// The end of the prompt chunk that starts at row `at`: `chunk` rows, cut at the next cache mark. With `tail` set, a last
+/// chunk that would be under `tail` rows takes half of the one before it instead (rounded up to 16 rows): two chunks of
+/// about equal rows in the scratch a full chunk already sizes (single-Spark recipe 0013). tail 0: `chunk` rows and the marks alone.
+pub fn planStop(chunk: usize, total: usize, at: usize, marks: []const u32, tail: usize) usize {
+    var stop = @min(total, at + chunk);
+    if (tail > 0 and stop < total and total - stop < tail) {
+        const half = (total - at + 1) / 2;
+        const even = (half + 15) / 16 * 16;
+        stop = at + @min(even, chunk);
+    }
+    for (marks) |m| if (m > at and m < stop) {
+        stop = m;
+        break;
+    };
+    return stop;
+}
+
+fn plan(chunk: usize, total: usize, marks: []const u32, tail: usize, out: []usize) []usize {
+    var at: usize = 0;
+    var n: usize = 0;
+    while (at < total) : (n += 1) {
+        const stop = planStop(chunk, total, at, marks, tail);
+        out[n] = stop - at;
+        at = stop;
+    }
+    return out[0..n];
+}
