+    try b.fill8(0, stream.handle);
+    try stream.synchronize();
+    var seq: usize = 1000;
+    std.debug.print("rank {d}: site rows bytes_a_rank calls owner_us raw_us alone_us owner_GBps\n", .{rank});
+    for (cases) |cs| for (bench_rows) |rows| {
+        if (cs.kind == .gather and cs.per_row > 4096 and rows > 256) continue;
+        const count = rows * cs.per_row;
+        const bytes = count * elementBytes(cs.kind);
+        const calls: usize = std.math.clamp(@as(usize, @intCast((2 << 30) / bytes)), 5, 400);
+        seq += 1;
