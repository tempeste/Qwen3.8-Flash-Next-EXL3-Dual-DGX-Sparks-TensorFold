+            try c.finish(stream);
+        }
+        const alone = @as(f64, @floatFromInt(wire.now() - t0)) / 1e3 / @as(f64, @floatFromInt(alone_calls));
+        std.debug.print("rank {d}: {s} {d} {d} {d} {d:.1} {d:.1} {d:.1} {d:.2}\n", .{ rank, cs.site, rows, bytes, calls, owner, direct, alone, @as(f64, @floatFromInt(bytes)) / owner / 1e3 });
+    };
+    seq += 1;
+    try meet(link, rank, seq);
+    check.pass("rank {d}: --tp 2 message sizes timed", .{rank});
+}
