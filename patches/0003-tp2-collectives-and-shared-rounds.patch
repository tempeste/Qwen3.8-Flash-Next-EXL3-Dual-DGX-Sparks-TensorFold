+//! tf-cuda-test flashnext-moe-slot: at --tp 2 the partial MoE sums that skip work give fn_moe_sum's bytes.
+//! fn_moe_sum_own (TF_FLASHNEXT_TP_MOE_OWN) on an uncleared y, and fn_moe_sum_slot (TF_FLASHNEXT_TP_SHARED_SLOT) reading
+//! the shared rows where the down projection wrote them, each against the cleared y, the copy into the last slot and
+//! fn_moe_sum the pass makes without them.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const d = 2560;
+const slots = 11;
+const experts = 512;
+/// Decode rows, a stage of 16, a 64-row round and the default chunk.
+const counts = [_]usize{ 1, 16, 64, 1536 };
+
+const Fns = struct { sum: cuda.Function, own: cuda.Function, slot: cuda.Function, copy: cuda.Function, picks: cuda.Function };
+
+fn sum(r: *rig.Rig, f: cuda.Function, y: u64, wts: u64, own: ?u64, skip: i32, shared: ?u64, out: u64, n: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(y);
+    a.add(wts);
+    if (own != null or shared != null) {
+        a.add(own orelse 0);
+        a.add(skip);
+    }
+    if (shared) |p| a.add(p);
+    a.add(out);
+    a.add(@as(c_int, d));
+    a.add(@as(c_int, slots));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(n), .y = d / 256 }, .block = .{ .x = 256 } }, r.s, &a);
+}
+
+/// cuda_shared_split.partial's copy: the shared rows' fp32 values into y's last slot as 16-bit words.
+fn copyShared(r: *rig.Rig, f: cuda.Function, shared: u64, y: u64, n: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(shared);
+    a.add(@as(c_longlong, 2 * d));
+    a.add(y + (slots - 1) * d * 4);
+    a.add(@as(c_longlong, slots * d * 2));
+    a.add(@as(c_int, 2 * d));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = (2 * d + 255) / 256, .y = @intCast(n) }, .block = .{ .x = 256 } }, r.s, &a);
+}
+
+fn fill(r: *rig.Rig, ptr: u64, bytes: []const u8) !void {
+    const b: cuda.DeviceBuffer = .{ .d = r.gpu.d, .ptr = ptr, .len = bytes.len };
+    try b.upload(0, bytes);
+}
+
+/// One rank's pass rows: y holds its own pairs' rows, every other slot `junk` (zeros as the clear leaves them, or stale).
+fn rankY(a: std.mem.Allocator, rows: []const f32, local: []const i32, skip: i32, n: usize, junk: ?[]const f32) ![]f32 {
+    const y = try a.alloc(f32, n * slots * d);
+    for (0..n * slots) |p| {
+        const mine = p % slots != slots - 1 and local[p] != skip;
+        const src = if (mine) rows[p * d ..][0..d] else if (junk) |j| j[p * d ..][0..d] else null;
+        if (src) |v| @memcpy(y[p * d ..][0..d], v) else @memset(y[p * d ..][0..d], 0);
+    }
+    return y;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rng = std.Random.DefaultPrng.init(0x1792);
+    var r = try rig.Rig.init(gpu, a, rng.random());
+    defer r.deinit();
+    var batch = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer batch.unload();
+    const f: Fns = .{
+        .sum = try batch.function("fn_moe_sum"),
+        .own = try batch.function("fn_moe_sum_own"),
+        .slot = try batch.function("fn_moe_sum_slot"),
+        .copy = try batch.function("fn_copy_cols"),
+        .picks = try batch.function("fn_ep_picks"),
+    };
+    const most = counts[counts.len - 1];
+    const rows = r.f32s(most * slots * d, -4, 4);
+    // signed zeros, a subnormal and huge values in some routed rows; NaN and an infinity in the shared rows of two
+    for (0..d) |c| {
+        rows[(3 * slots + 1) * d + c] = if (c % 2 == 0) -0.0 else 0.0;
+        rows[(5 * slots + 2) * d + c] = if (c % 3 == 0) 1e-40 else 3e38;
+    }
+    const stale = r.f32s(most * slots * d, -1e6, 1e6);
+    const shared = r.f32s(most * d, -8, 8);
+    shared[7 * d + 5] = std.math.nan(f32);
+    shared[9 * d + 11] = -std.math.inf(f32);
+    const wts = r.f32s(most * slots, 0, 1);
+    for (0..most) |row| wts[row * slots + slots - 1] = 1;
+    const picks = try a.alloc(i32, most * slots);
+    for (picks, 0..) |*p, i| p.* = if (i % slots == slots - 1) experts else @intCast(r.rng.uintLessThan(u32, experts));
+    const dw = try r.dev(std.mem.sliceAsBytes(wts));
+    const dp = try r.dev(std.mem.sliceAsBytes(picks));
+    const ds = try r.dev(std.mem.sliceAsBytes(shared));
+    const local = try r.out(most * slots * 4);
+    const y = try r.out(most * slots * d * 4);
+    const want = try r.out(most * d * 4);
+    const got = try r.out(most * d * 4);
+    const half = experts / 2;
+    for (0..2) |rank| {
+        const skip: i32 = half;
+        var pa: cuda.Args = .{};
+        pa.add(dp);
+        pa.add(local);
+        for ([_]usize{ most * slots, rank * half, half }) |v| pa.add(@as(i32, @intCast(v)));
+        try cuda.launch.launch(f.picks, .{ .grid = .{ .x = @intCast((most * slots + 255) / 256) }, .block = .{ .x = 256 } }, r.s, &pa);
+        const lp = try r.back(i32, local, most * slots);
+        const cleared = try rankY(a, rows, lp, skip, most, null);
+        const uncleared = try rankY(a, rows, lp, skip, most, stale);
+        for (counts) |n| {
+            try fill(&r, y, std.mem.sliceAsBytes(cleared[0 .. n * slots * d]));
+            try copyShared(&r, f.copy, ds, y, n);
+            try sum(&r, f.sum, y, dw, null, 0, null, want, n);
+            const base = try r.back(f32, want, n * d);
+            // the shared slot is not copied: the slot sum reads ds, and y's last slot keeps zeros or stale rows
+            try fill(&r, y, std.mem.sliceAsBytes(cleared[0 .. n * slots * d]));
+            try sum(&r, f.slot, y, dw, null, skip, ds, got, n);
+            try check.sameBytes("fn_moe_sum_slot on the cleared y, no shared copy", std.mem.sliceAsBytes(try r.back(f32, got, n * d)), std.mem.sliceAsBytes(base));
+            try fill(&r, y, std.mem.sliceAsBytes(uncleared[0 .. n * slots * d]));
+            try copyShared(&r, f.copy, ds, y, n);
+            try sum(&r, f.own, y, dw, local, skip, null, got, n);
+            try check.sameBytes("fn_moe_sum_own on an uncleared y", std.mem.sliceAsBytes(try r.back(f32, got, n * d)), std.mem.sliceAsBytes(base));
+            try fill(&r, y, std.mem.sliceAsBytes(uncleared[0 .. n * slots * d]));
+            try sum(&r, f.slot, y, dw, local, skip, ds, got, n);
+            try check.sameBytes("fn_moe_sum_slot with own picks on an uncleared y, no shared copy", std.mem.sliceAsBytes(try r.back(f32, got, n * d)), std.mem.sliceAsBytes(base));
+        }
+    }
+    // the control: a stale y summed over every slot is not the base, so the checks above can fail
+    const lp = try r.back(i32, local, most * slots);
+    try fill(&r, y, std.mem.sliceAsBytes(try rankY(a, rows, lp, half, most, stale)));
+    try sum(&r, f.slot, y, dw, null, half, ds, got, 16);
+    const stale_got = try r.back(f32, got, 16 * d);
+    try fill(&r, y, std.mem.sliceAsBytes(try rankY(a, rows, lp, half, most, null)));
+    try copyShared(&r, f.copy, ds, y, 16);
+    try sum(&r, f.sum, y, dw, null, 0, null, want, 16);
+    const clean = try r.back(f32, want, 16 * d);
+    try check.expect(!std.mem.eql(u8, std.mem.sliceAsBytes(stale_got), std.mem.sliceAsBytes(clean)), "control: a stale y read without own picks changes the sum", .{});
+    check.pass("flashnext-moe-slot: fn_moe_sum_own and fn_moe_sum_slot equal the cleared, copied fn_moe_sum byte for byte on both ranks at 1 to 1,536 rows (signed zeros, subnormals, NaN, infinity); the stale control differs", .{});
+}
