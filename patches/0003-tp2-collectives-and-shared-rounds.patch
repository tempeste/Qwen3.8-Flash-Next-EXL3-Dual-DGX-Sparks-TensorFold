+
+/// TF_RANK_HOST: the control link's address (rank 0 listens there); unset, both ranks on one host.
+pub fn rankHost() []const u8 {
+    return if (std.c.getenv("TF_RANK_HOST")) |h| std.mem.span(h) else "127.0.0.1";
