+        seq += 1;
+        try meet(link, rank, seq);
+        t0 = wire.now();
+        for (0..calls) |_| try rawCall(c, stream, cs.kind, a.ptr, b.ptr, count);
+        try c.finish(stream);
+        const direct = @as(f64, @floatFromInt(wire.now() - t0)) / 1e3 / @as(f64, @floatFromInt(calls));
