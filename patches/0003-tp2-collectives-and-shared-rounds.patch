+    try std.testing.expectEqual(@as(u64, 400), s.lent);
+    try std.testing.expectEqual(@as(u64, 200 + 400), s.held);
+    try std.testing.expect(!s.lend(100, l.entry.?.saved, a)); // only the borrowed state is left
+    try std.testing.expectEqual(@as(u64, 2), s.counts.lend_refused);
+    try std.testing.expectEqual(@as(u64, 1), s.counts.lends);
+    s.release(l.entry.?);
+    try std.testing.expect(keepAt(&f, &s, b, 100)); // A goes; what the loan leaves takes B
+    try std.testing.expect(!has(&s, a, 100) and has(&s, b, 100));
+    try std.testing.expectEqual(@as(u64, 400 + 200), s.held);
+    try std.testing.expect(!keepAt(&f, &s, c, 120)); // B goes, and the loan still leaves too little for 220
+    try std.testing.expectEqual(@as(usize, 0), s.entries.items.len);
+    try std.testing.expectEqual(@as(u64, 400), s.held);
+    s.repay(400);
+    try std.testing.expectEqual(@as(u64, 0), s.lent);
+    try std.testing.expect(keepAt(&f, &s, c, 100));
+    try std.testing.expect(s.held <= s.budget);
+    s.repay(10); // more than lent: nothing
