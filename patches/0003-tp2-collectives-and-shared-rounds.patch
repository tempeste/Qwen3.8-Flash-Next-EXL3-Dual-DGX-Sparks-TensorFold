--- /dev/null
+++ b/zig/src/core/prompt_cache_live_test.zig
@@ -0,0 +1,182 @@
+//! TF_FLASHNEXT_PCACHE_LIVE (Store.live): an unfinished request's newest state outlives every superseded and idle one,
+//! the pinned states alone still never pass the budget, and bytes lent to a live stream come out of it. The regression:
+//! on 2026-11-05 a third of a two-Spark pair's cold tokens were conversations whose 12-28 min reply aged their own prefix
+//! out of the LRU, the next request missing a second after the reply ended.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const Fake = @import("prompt_cache_fake.zig").Fake;
+const Store = pc.Store;
+
+/// Conversation `c`'s prompt: its own tokens, `n` of them.
+fn convo(buf: []u32, c: u32, n: usize) []u32 {
+    for (buf[0..n], 0..) |*t, i| t.* = c * 1000 + @as(u32, @intCast(i));
+    return buf[0..n];
+}
+
+fn has(s: *const Store, prompt: []const u32, at: u32) bool {
+    for (s.entries.items) |e| if (e.at == at and std.mem.eql(u32, e.tokens, prompt[0..at])) return true;
+    return false;
+}
+
+fn entry(s: *const Store, prompt: []const u32, at: u32) *pc.Entry {
+    for (s.entries.items) |e| if (e.at == at and std.mem.eql(u32, e.tokens, prompt[0..at])) return e;
+    unreachable;
+}
+
+/// A store for three states of 100 + at bytes (Fake), its oldest A's, then B's and C's.
+fn three(f: *Fake, s: *Store, a: []const u32, b: []const u32, c: []const u32) !void {
+    try std.testing.expect(keepAt(f, s, a, 100));
+    try std.testing.expect(keepAt(f, s, b, 100));
+    try std.testing.expect(keepAt(f, s, c, 100));
+}
+
+/// A keep with the fake family's live state standing at `at` (its save copies only the state it stands at).
+fn keepAt(f: *Fake, s: *Store, prompt: []const u32, at: u32) bool {
+    f.at = at;
+    return s.keep(prompt, at, null, &.{}, &.{});
+}
+
+fn keepBornAt(f: *Fake, s: *Store, prompt: []const u32, born: u32, at: u32) bool {
+    f.at = at;
+    return s.keepBorn(prompt, born, at, null, &.{}, &.{});
+}
+
+test "pcache live: a decoding request's newest state outlives idle ones, and its end touches it" {
+    const gpa = std.testing.allocator;
+    var bufs: [4][128]u32 = undefined;
+    const a = convo(&bufs[0], 1, 128);
+    const b = convo(&bufs[1], 2, 128);
+    const c = convo(&bufs[2], 3, 128);
+    const d = convo(&bufs[3], 4, 128);
+    for ([_]bool{ false, true }) |live| {
+        var f: Fake = .{ .gpa = gpa };
+        var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 3 * 200);
+        defer s.deinit();
+        s.live = live;
+        try three(&f, &s, a, b, c);
+        s.pin(1, entry(&s, a, 100)); // A's reply decodes on: its prompt pass kept that state
+        try std.testing.expect(keepAt(&f, &s, d, 100));
+        // off: A, the oldest, goes; on: B, the oldest idle one
+        try std.testing.expectEqual(!live, !has(&s, a, 100));
+        try std.testing.expectEqual(live, !has(&s, b, 100));
+        try std.testing.expectEqual(@as(u64, 1), s.counts.evicted);
+        if (!live) {
+            try std.testing.expectEqual(@as(usize, 0), s.pins.items.len); // pin does nothing with the flag off
+            continue;
+        }
+        try std.testing.expectEqual(@as(u64, 1), s.counts.evicted_idle);
+        try std.testing.expectEqual(@as(u64, 1), s.counts.pinned);
+        s.unpin(1); // A's request ends: its state is the newest in LRU order, C's the oldest
+        try std.testing.expectEqual(@as(usize, 0), s.pins.items.len);
+        try std.testing.expectEqual(@as(u32, 0), entry(&s, a, 100).live);
+        try std.testing.expect(keepAt(&f, &s, b, 100));
+        try std.testing.expect(has(&s, a, 100) and !has(&s, c, 100) and has(&s, d, 100));
+        try std.testing.expectEqual(@as(u64, 2), s.counts.evicted_idle);
+        try std.testing.expectEqual(@as(u64, 0), s.counts.evicted_live);
+    }
+}
+
+test "pcache live: superseded states go before idle ones, idle ones before live ones" {
+    const gpa = std.testing.allocator;
+    var bufs: [3][128]u32 = undefined;
+    const a = convo(&bufs[0], 1, 128);
+    const b = convo(&bufs[1], 2, 128);
+    const c = convo(&bufs[2], 3, 128);
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 200 + 160 + 200 + 180 + 60);
+    defer s.deinit();
+    s.live = true;
+    try std.testing.expect(keepBornAt(&f, &s, a, 60, 60)); // A's first turn
+    try std.testing.expect(keepAt(&f, &s, b, 100)); // B: idle
+    try std.testing.expect(keepBornAt(&f, &s, a, 100, 100)); // A's next turn, live: A at 60 is superseded
+    try std.testing.expect(keepBornAt(&f, &s, c, 80, 80)); // C, live
+    s.pin(1, entry(&s, a, 100));
+    s.pin(2, entry(&s, c, 80));
+    try std.testing.expect(keepBornAt(&f, &s, c, 120, 120)); // C's pass keeps on: A at 60 goes first
+    try std.testing.expect(!has(&s, a, 60) and has(&s, b, 100));
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted_superseded);
+    s.pin(2, entry(&s, c, 120)); // one pin a request: its newest
+    try std.testing.expectEqual(@as(u32, 0), entry(&s, c, 80).live);
+    try std.testing.expectEqual(@as(usize, 2), s.pins.items.len);
+    try std.testing.expect(keepAt(&f, &s, b, 110)); // C at 80 (superseded by C at 120), then B at 100 (idle)
+    try std.testing.expect(!has(&s, c, 80) and !has(&s, b, 100));
+    try std.testing.expect(has(&s, a, 100) and has(&s, c, 120) and has(&s, b, 110));
+    try std.testing.expectEqual(@as(u64, 2), s.counts.evicted_superseded);
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted_idle);
+    try std.testing.expectEqual(@as(u64, 0), s.counts.evicted_live);
+}
+
+test "pcache live: pinned states that alone fill the budget go in today's order, and the budget holds" {
+    const gpa = std.testing.allocator;
+    var bufs: [4][128]u32 = undefined;
+    const a = convo(&bufs[0], 1, 128);
+    const b = convo(&bufs[1], 2, 128);
+    const c = convo(&bufs[2], 3, 128);
+    const d = convo(&bufs[3], 4, 128);
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 3 * 200);
+    defer s.deinit();
+    s.live = true;
+    try three(&f, &s, a, b, c);
+    s.pin(1, entry(&s, a, 100));
+    s.pin(2, entry(&s, b, 100));
+    s.pin(3, entry(&s, c, 100));
+    try std.testing.expect(keepAt(&f, &s, d, 100)); // every state pinned: the oldest pinned one goes
+    try std.testing.expect(!has(&s, a, 100) and has(&s, b, 100) and has(&s, c, 100) and has(&s, d, 100));
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted_live);
+    try std.testing.expect(s.held <= s.budget);
+    try std.testing.expectEqual(@as(usize, 2), s.pins.items.len); // the evicted state's pin went with it
+    s.unpin(1); // its state is gone: nothing to touch
+    try std.testing.expectEqual(@as(usize, 2), s.pins.items.len);
+    s.pin(4, entry(&s, d, 100));
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const l = try s.lookup(arena.allocator(), b, 128, &.{}, &.{}, &.{}); // a borrowed pinned state never goes
+    try std.testing.expect(l.entry.? == entry(&s, b, 100));
+    try std.testing.expect(keepAt(&f, &s, a, 100));
+    try std.testing.expect(has(&s, b, 100) and !has(&s, c, 100));
+    try std.testing.expectEqual(@as(u64, 2), s.counts.evicted_live);
+    s.release(l.entry.?);
+    s.unpin(2);
+    s.unpin(3);
+    s.unpin(4);
+    try std.testing.expectEqual(@as(usize, 0), s.pins.items.len);
+    for (s.entries.items) |e| try std.testing.expectEqual(@as(u32, 0), e.live);
+}
+
+test "pcache lend: bytes lent to a live stream come out of the budget, never the restored state, and are repaid" {
+    const gpa = std.testing.allocator;
+    var bufs: [3][128]u32 = undefined;
+    const a = convo(&bufs[0], 1, 128);
+    const b = convo(&bufs[1], 2, 128);
+    const c = convo(&bufs[2], 3, 128);
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 3 * 200);
+    defer s.deinit();
+    try three(&f, &s, a, b, c);
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const l = try s.lookup(arena.allocator(), a, 128, &.{}, &.{}, &.{}); // A's next turn restores its state
