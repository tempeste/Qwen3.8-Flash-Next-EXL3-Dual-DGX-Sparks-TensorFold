diff --git a/zig/src/families/flashnext/cuda_batch_gdn_lanes.zig b/zig/src/families/flashnext/cuda_batch_gdn_lanes.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f747fc77dd15f2a618e0185fdae2d343d18631af
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_batch_gdn_lanes.zig
@@ -0,0 +1,99 @@
+//! A shared pass's DeltaNet steps over its lanes in one launch each (fn_gdn_lanes_*, upstream #1942), on the full heads
+//! or a rank's `_h8` half under --tp 2 (TF_FLASHNEXT_GDN_LANES=0: off; TF_FLASHNEXT_GDN_LANE_GROUPS=1: past 16 lanes too).
+const cuda = @import("cuda");
+const gdn = @import("cuda_gdn.zig");
+const parts = @import("cuda_batch_state.zig");
+const Gdn = @import("cuda_batch_kernels.zig").Gdn;
+const Heads = @import("cuda_heads.zig").Heads;
+const LayerKeep = parts.LayerKeep;
+const knobs = @import("cuda_knobs.zig");
+const Layer = @import("cuda_prompt_load.zig").Layer;
+
+fn cint(v: usize) c_int {
+    return @intCast(v);
+}
+
+/// A shared pass's DeltaNet steps, one launch each over its lanes, with the kernels `g` of the layer's heads; false:
+/// the caller loops them (off, more than gdn_lanes_max lanes without TF_FLASHNEXT_GDN_LANE_GROUPS, a lane of 64 rows or
+/// more, unaligned, or a pending-row log on a rank's half heads, which --tp 2 refuses anyway). With the groups, a pass
+/// of more lanes runs the same launches once a table of up to gdn_lanes_max lanes, each lane's rows where they lie.
+pub fn once(self: anytype, g: *const Gdn, lw: *const Layer, layer: usize, li: usize) !bool {
+    if (!parts.gdnLanes()) return false;
+    if (self.lanes.len > parts.gdn_lanes_max and !knobs.gdnLaneGroups()) return false;
+    const whole = lw.heads.eql(Heads.full);
+    const pw = lw.heads.projWidth();
+    const s = self.s;
+    // every lane checked before any launch: a refusal leaves the whole round to the caller's loop
+    var row0: usize = 0;
+    for (self.lanes) |l| {
+        if (l.rows >= 64) return false;
+        const lk: LayerKeep = if (l.keep) |kp| kp.layers[layer] else .{};
+        if (lk.log != 0 and !whole) return false;
+        if (lk.log != 0 and lk.state_out == 0) return error.UnexpectedTensor;
+        const proj = s.proj + row0 * pw * 2;
+        for ([_]u64{ proj, l.seq.conv[li].ptr, lk.proj, lk.hist }) |p| if (p % 16 != 0) return false;
+        row0 += l.rows;
+    }
+    row0 = 0;
+    var at: usize = 0;
+    while (at < self.lanes.len) {
+        const count = @min(parts.gdn_lanes_max, self.lanes.len - at);
+        row0 = try group(self, g, lw, layer, li, self.lanes[at..][0..count], row0);
+        at += count;
+    }
+    return true;
+}
+
+/// One lane table's launches: keep (when a lane keeps), front, chain, shift; its lanes' rows from `first_row` on.
+fn group(self: anytype, g: *const Gdn, lw: *const Layer, layer: usize, li: usize, ls: anytype, first_row: usize) !usize {
+    const h = lw.heads;
+    const pw = h.projWidth();
+    const s = self.s;
+    var t: parts.GdnLanes = .{ .n = @intCast(ls.len) };
+    var row0 = first_row;
+    var widest: usize = 0;
+    var keeps = false;
+    for (ls, t.l[0..ls.len]) |l, *x| {
+        const lk: LayerKeep = if (l.keep) |kp| kp.layers[layer] else .{};
+        const proj = s.proj + row0 * pw * 2;
+        x.* = .{ .proj = proj, .conv = l.seq.conv[li].ptr, .state = l.seq.state[li].ptr, .state_out = lk.state_out, .log = lk.log, .ctl = lk.log_ctl, .keep_proj = lk.proj, .keep_hist = lk.hist, .row0 = @intCast(row0), .rows = @intCast(l.rows) };
+        keeps = keeps or lk.proj != 0 or lk.hist != 0;
+        widest = @max(widest, l.rows);
+        row0 += l.rows;
+    }
+    const n: u32 = @intCast(ls.len);
+    if (keeps) {
+        var a: cuda.Args = .{};
+        a.add(t);
+        try cuda.launch.launch(g.lanes_keep, .{ .grid = .{ .x = 64, .y = n }, .block = .{ .x = 256 } }, self.stream, &a);
+    }
+    var f: cuda.Args = .{};
+    f.add(lw.cw.ptr);
+    f.add(lw.a_log.ptr);
+    f.add(lw.dt.ptr);
+    f.add(s.gq);
+    f.add(s.gk);
+    f.add(s.gv);
+    f.add(s.ggb);
+    f.add(cint(parts.late_rows));
+    f.add(t);
+    try cuda.launch.launch(g.lanes_front, .{ .grid = .{ .x = @intCast(widest), .y = h.nk + h.nv, .z = n }, .block = .{ .x = 256 } }, self.stream, &f);
+    var c: cuda.Args = .{};
+    c.add(s.gq);
+    c.add(s.gk);
+    c.add(s.gv);
+    c.add(s.ggb);
+    c.add(s.ys);
+    c.add(cint(parts.late_rows));
+    c.add(cint(parts.late_store));
+    c.add(t);
+    try cuda.launch.launch(g.lanes_chain, .{ .grid = .{ .x = h.nv, .y = gdn.dv / 16, .z = n }, .block = .{ .x = 128 } }, self.stream, &c);
+    var w: cuda.Args = .{};
+    w.add(t);
+    try cuda.launch.launch(g.lanes_shift, .{ .grid = .{ .x = @intCast((h.convDim() + 255) / 256), .y = n }, .block = .{ .x = 256 } }, self.stream, &w);
+    return row0;
+}
+
+test {
+    _ = @import("cuda_batch_gdn_lanes_test.zig");
+}
