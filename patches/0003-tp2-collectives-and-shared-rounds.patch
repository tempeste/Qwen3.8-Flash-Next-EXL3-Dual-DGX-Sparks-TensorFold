@@ -0,0 +1,194 @@
+//! cuda_batch_gdn_lanes.once with a driver that counts launches: which rounds it takes, on the full heads and on a
+//! rank's half, with the kernels of the set it is given, and none launched on a refusal.
+const std = @import("std");
+const t = std.testing;
+const cuda = @import("cuda");
+const env = @import("sys").env;
+const parts = @import("cuda_batch_state.zig");
+const lanes = @import("cuda_batch_gdn_lanes.zig");
+const Gdn = @import("cuda_batch_kernels.zig").Gdn;
+const Heads = @import("cuda_heads.zig").Heads;
+const Layer = @import("cuda_prompt_load.zig").Layer;
+
+const Mock = struct {
+    var calls: usize = 0;
+    var last: usize = 0;
+    var front_y: c_uint = 0;
+    /// Each front launch's lanes (grid z), its table's count and its first lane's first row, in launch order.
+    var fronts: usize = 0;
+    var front_z: [4]c_uint = @splat(0);
+    var front_n: [4]c_int = @splat(0);
+    var front_row0: [4]c_int = @splat(0);
+    fn launch(f: cuda.abi.Function, _: c_uint, gy: c_uint, gz: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: cuda.abi.Stream, params: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result {
+        calls += 1;
+        last = @intFromPtr(f.?);
+        if (last & 0xff == 1) {
+            front_y = gy;
+            if (fronts < front_z.len) {
+                const table: *const parts.GdnLanes = @ptrCast(@alignCast(params.?[8].?));
+                front_z[fronts] = gz;
+                front_n[fronts] = table.n;
+                front_row0[fronts] = table.l[0].row0;
+            }
+            fronts += 1;
+        }
+        return 0;
+    }
+};
+
+const Scratch = struct { proj: u64, gq: u64 = 0x10000, gk: u64 = 0x20000, gv: u64 = 0x30000, ggb: u64 = 0x40000, ys: u64 = 0x50000 };
+
+/// What once() reads of a batch.Pass: the round's lanes, the projection rows and the stream.
+const Pass = struct {
+    lanes: []const parts.Lane,
+    s: Scratch,
+    stream: cuda.Stream,
+};
+
+var history: [2]i64 = .{ 0, 0 };
+
+fn buf(d: *const cuda.Driver, ptr: u64) cuda.DeviceBuffer {
+    return .{ .d = d, .ptr = ptr, .len = 0 };
+}
+
+/// out.len lanes of `rows` rows each, every lane with its own conv window and state at 16-byte aligned addresses.
+fn round(d: *const cuda.Driver, conv: []cuda.DeviceBuffer, state: []cuda.DeviceBuffer, out: []parts.Lane, rows: usize, keep: ?*const parts.Keep) []parts.Lane {
+    for (out, 0..) |*l, i| {
+        conv[i] = buf(d, 0x100000 + i * 0x1000);
+        state[i] = buf(d, 0x200000 + i * 0x1000);
+        l.* = .{ .seq = .{ .conv = conv[i .. i + 1], .state = state[i .. i + 1], .kc = &.{}, .vc = &.{}, .ikc = &.{}, .pooled = &.{}, .tail = buf(d, 0), .history = &history, .cap = 4096, .scores = 0 }, .pos = 0, .rows = rows, .keep = keep };
+    }
+    return out;
+}
+
+fn pass(d: *const cuda.Driver, ls: []const parts.Lane, proj: u64) Pass {
+    return .{ .lanes = ls, .s = .{ .proj = proj }, .stream = .{ .d = d, .handle = null } };
+}
+
+/// A kernel set whose four lane kernels are handles base + 0..3 (keep, front, chain, shift).
+fn set(d: *const cuda.Driver, base: usize) Gdn {
+    var g: Gdn = undefined;
+    inline for (@typeInfo(Gdn).@"struct".field_names) |name| @field(g, name) = .{ .d = d, .handle = @ptrFromInt(0xf00) };
+    g.lanes_keep = .{ .d = d, .handle = @ptrFromInt(base) };
+    g.lanes_front = .{ .d = d, .handle = @ptrFromInt(base + 1) };
+    g.lanes_chain = .{ .d = d, .handle = @ptrFromInt(base + 2) };
+    g.lanes_shift = .{ .d = d, .handle = @ptrFromInt(base + 3) };
+    return g;
+}
+
+/// once() on `p` answers `took` and launches `launches` kernels.
+fn expectOnce(p: *const Pass, g: *const Gdn, lw: *const Layer, took: bool, launches: usize) !void {
+    Mock.calls = 0;
+    try t.expectEqual(took, try lanes.once(p, g, lw, 0, 0));
+    try t.expectEqual(launches, Mock.calls);
+}
+
+test "lanes' DeltaNet steps: one launch a step when the round fits, on whole or half heads; nothing on a fallback" {
+    var d: cuda.Driver = undefined;
+    d.api.cuLaunchKernel = Mock.launch;
+    var lw: Layer = undefined;
+    @memset(std.mem.asBytes(&lw), 0);
+    lw.heads = Heads.full;
+    const full = set(&d, 0x200);
+    const half = set(&d, 0x300);
+    var conv: [parts.gdn_lanes_max + 1]cuda.DeviceBuffer = undefined;
+    var state: [parts.gdn_lanes_max + 1]cuda.DeviceBuffer = undefined;
+    var ls: [parts.gdn_lanes_max + 1]parts.Lane = undefined;
+    _ = env.unsetenv("TF_FLASHNEXT_GDN_LANES");
+
+    for ([_]usize{ 1, 2, parts.gdn_lanes_max }) |n| {
