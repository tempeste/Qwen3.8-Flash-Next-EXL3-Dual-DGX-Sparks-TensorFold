+/// The same call straight to NCCL: no peer check and no poll unless NCCL reports the call still in progress.
+fn rawCall(c: *flash.collective.Collective, stream: cuda.Stream, k: Kind, a: u64, b: u64, count: usize) !void {
+    const api = c.lib.api;
+    const r = switch (k) {
+        .gather => api.ncclAllGather(a, b, count, .bf16, c.comm, stream.handle),
+        .gather_f32 => api.ncclAllGather(a, b, count, .f32, c.comm, stream.handle),
+        .sum => api.ncclAllReduce(a, a, count, .f32, .sum, c.comm, stream.handle),
+    };
+    if (r == 0) return;
+    if (r != 7) return error.NcclFailed;
+    while (true) {
+        var state: cuda.nccl.Result = 0;
+        if (c.api.ncclCommGetAsyncError(c.comm, &state) != 0) return error.NcclFailed;
+        if (state == 0) return;
+        if (state != 7) return error.NcclFailed;
