+    g.thread = try std.Thread.spawn(.{}, Guard.main, .{g});
+    g.enter();
+    var waited: usize = 0;
+    while (!g.fired.load(.acquire) and waited < 2000) : (waited += 1) wire.nap(std.time.ns_per_ms);
+    try std.testing.expect(g.fired.load(.acquire));
+    try std.testing.expectEqual(@as(u32, Guard.exit_code), Exit.code.load(.acquire));
+    g.end();
+}
+
+test "a blocking (async-coll) owner's sum is one enqueue with no poll; a nonblocking owner's in-progress call polls" {
+    const Fake = struct {
+        var reduces: usize = 0;
+        var polls: usize = 0;
+        var result: nccl.Result = 0;
+        var state: nccl.Result = 0;
+        fn allReduce(_: cuda.abi.DevicePtr, _: cuda.abi.DevicePtr, _: usize, _: nccl.DataType, _: nccl.RedOp, _: nccl.Comm, _: cuda.abi.Stream) callconv(.c) nccl.Result {
+            reduces += 1;
+            return result;
+        }
+        fn asyncError(_: nccl.Comm, s: *nccl.Result) callconv(.c) nccl.Result {
+            polls += 1;
+            s.* = if (polls > 2) 0 else state;
+            return 0;
+        }
+        fn abort(_: nccl.Comm) callconv(.c) nccl.Result {
+            return 0;
+        }
+    };
+    var pair: [2]c_int = undefined;
+    if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &pair) != 0) return error.SocketPair;
+    defer for (pair) |fd| {
+        _ = std.c.close(fd);
+    };
+    var g: Guard = .{ .link = .{ .fd = pair[0] }, .rank = 0, .timeout_ns = std.time.ns_per_s };
+    var c: Collective = undefined;
+    c.rank = 0;
+    c.site = .other;
+    c.profile = null;
+    c.roce = null;
+    c.roce_stage = null;
+    c.failed = false;
+    c.comm = @ptrFromInt(0x1000);
+    c.link = .{ .fd = pair[0] };
+    c.timeout_ms = 1000;
+    c.lib.api.ncclAllReduce = Fake.allReduce;
+    c.api.ncclCommGetAsyncError = Fake.asyncError;
+    c.api.ncclCommAbort = Fake.abort;
+    const stream: cuda.Stream = .{ .d = undefined, .handle = null };
+    c.guard = &g;
+    try c.sum(stream, 0x10, 4);
+    try std.testing.expectEqual(@as(usize, 1), Fake.reduces);
+    try std.testing.expectEqual(@as(usize, 1), Fake.polls);
+    try std.testing.expectEqual(@as(u64, 0), g.since.load(.acquire));
+    c.guard = null;
+    Fake.polls = 0;
+    Fake.result = nccl.in_progress;
+    Fake.state = nccl.in_progress;
+    try c.sum(stream, 0x10, 4);
+    try std.testing.expectEqual(@as(usize, 2), Fake.reduces);
+    try std.testing.expectEqual(@as(usize, 3), Fake.polls);
+}
+
+test "TP_ROCE: the size alone picks the path, so both ranks take the same one; no RoCE, NCCL" {
+    const cap: usize = 4096 * 1024;
+    try std.testing.expect(!roceTakes(null, 10240));
+    try std.testing.expect(!roceTakes(cap, 0));
+    try std.testing.expect(roceTakes(cap, 16));
+    try std.testing.expect(roceTakes(cap, 2560 * 4));
+    try std.testing.expect(roceTakes(cap, 409 * 2560 * 4));
+    try std.testing.expect(!roceTakes(cap, 410 * 2560 * 4));
+    try std.testing.expect(roceTakes(cap, cap));
+    try std.testing.expect(!roceTakes(cap, cap + 16));
+    try std.testing.expect(!roceTakes(cap, 2561 * 4));
+    try std.testing.expect(roceTakes(cap, 16 * 124_160 * 2));
+    try std.testing.expect(!roceTakes(cap, 17 * 124_160 * 2));
+}
+
+test "TP_ROCE: the setup exchange over the control link returns each rank the other's value" {
+    var pair: [2]c_int = undefined;
+    if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &pair) != 0) return error.SocketPair;
+    defer for (pair) |fd| {
+        _ = std.c.close(fd);
+    };
+    const Blob = extern struct { a: u64, b: [3]u32, c: u32 };
+    const Peer = struct {
+        fn run(fd: c_int, out: *Blob, err: *?anyerror) void {
+            const x: LinkSwap = .{ .link = .{ .fd = fd }, .rank = 1, .timeout_ms = 5000 };
+            out.* = x.swap(Blob, .{ .a = 11, .b = .{ 1, 2, 3 }, .c = 1 }) catch |e| {
+                err.* = e;
+                return;
+            };
+        }
+    };
+    var got1: Blob = undefined;
+    var err1: ?anyerror = null;
+    const t = try std.Thread.spawn(.{}, Peer.run, .{ pair[1], &got1, &err1 });
+    const x0: LinkSwap = .{ .link = .{ .fd = pair[0] }, .rank = 0, .timeout_ms = 5000 };
+    const got0 = try x0.swap(Blob, .{ .a = 7, .b = .{ 4, 5, 6 }, .c = 0 });
+    t.join();
+    try std.testing.expect(err1 == null);
+    try std.testing.expectEqual(@as(u64, 11), got0.a);
+    try std.testing.expectEqual(@as(u32, 1), got0.c);
+    try std.testing.expectEqual(@as(u64, 7), got1.a);
+    try std.testing.expectEqualSlices(u32, &.{ 4, 5, 6 }, &got1.b);
+}
+
+test "TP_ROCE: a collective owner without RoCE sends every sum and gather to NCCL" {
+    const Fake = struct {
+        var reduces: usize = 0;
+        var gathers: usize = 0;
+        fn allReduce(_: cuda.abi.DevicePtr, _: cuda.abi.DevicePtr, _: usize, _: nccl.DataType, _: nccl.RedOp, _: nccl.Comm, _: cuda.abi.Stream) callconv(.c) nccl.Result {
+            reduces += 1;
+            return 0;
+        }
+        fn allGather(_: cuda.abi.DevicePtr, _: cuda.abi.DevicePtr, _: usize, _: nccl.DataType, _: nccl.Comm, _: cuda.abi.Stream) callconv(.c) nccl.Result {
+            gathers += 1;
+            return 0;
+        }
+        fn asyncError(_: nccl.Comm, s: *nccl.Result) callconv(.c) nccl.Result {
+            s.* = 0;
+            return 0;
+        }
+    };
+    var pair: [2]c_int = undefined;
+    if (std.c.socketpair(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0, &pair) != 0) return error.SocketPair;
+    defer for (pair) |fd| {
+        _ = std.c.close(fd);
+    };
+    var c: Collective = .{ .lib = undefined, .api = undefined, .link = .{ .fd = pair[0] }, .timeout_ms = 1000, .comm = @ptrFromInt(0x1000) };
+    c.lib.api.ncclAllReduce = Fake.allReduce;
+    c.lib.api.ncclAllGather = Fake.allGather;
+    c.api.ncclCommGetAsyncError = Fake.asyncError;
+    const stream: cuda.Stream = .{ .d = undefined, .handle = null };
+    try c.sum(stream, 0x10, 2560);
+    try c.gather(stream, 0x10, 0x20, 3072);
+    try c.gatherF32(stream, 0x10, 0x20, 1280);
+    try std.testing.expectEqual(@as(usize, 1), Fake.reduces);
+    try std.testing.expectEqual(@as(usize, 2), Fake.gathers);
+}
diff --git a/zig/src/families/flashnext/cuda_head_kv_test.zig b/zig/src/families/flashnext/cuda_head_kv_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2233e4e5ea435af9ded0645650d25433f2e81129
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_head_kv_test.zig
@@ -0,0 +1,61 @@
+//! The 2026-11-05 RestoreRejected band (26 of 30 on a two-Spark pair, prompts of 147,964-154,401 tokens): at --kv-cache
+//! nvfp4, --context 229,376 and 32,768 reply tokens a stream up to cap 180,712 (a 147,912-token prompt) keeps its MTP
+//! head's cache in bf16, a longer one in nvfp4 (mtp.headFormatIn). A conversation's states kept below that hold bf16
+//! head rows, and its next turn past it refused them all (HeadKvFormat, logged as a bare RestoreRejected) and prefilled
+//! from 0. TF_FLASHNEXT_RESTORE_HEAD_KV keeps the kept state's format, its bytes past the charge lent by the cache.
+const std = @import("std");
+const t = std.testing;
+const mtp = @import("cuda_mtp.zig");
+const draft = @import("cuda_mtp_draft.zig");
+const snaps = @import("cuda_snap.zig");
+const window_rows = @import("cuda_index_window.zig").rows;
+
+const context = 229_376;
+const window = context + mtp.max_rows;
+const reply = 32_768;
+const draft_n = 4096;
+const chunk = 3072;
+
+fn capOf(prompt: usize) usize {
+    return prompt + reply + mtp.max_rows;
+}
+
+test "the nvfp4 head-format boundary sits at a 147,912-token prompt: the 11-05 band's kept states below, its prompts above" {
+    const iw = window_rows(chunk);
+    const last = draft.bf16HeadCap(.nvfp4, window, draft_n, chunk, .half, iw);
+    try t.expectEqual(@as(usize, 180_712), last);
+    try t.expectEqual(@as(usize, 147_912), last - reply - mtp.max_rows);
+    try t.expectEqual(.bf16, draft.headFormatIn(.nvfp4, last, window, draft_n, chunk, .half, iw));
+    try t.expectEqual(.nvfp4, draft.headFormatIn(.nvfp4, last + 1, window, draft_n, chunk, .half, iw));
+    // the log's pairs: each kept state from a stream below, each prompt that refused it above
+    for ([_][2]usize{ .{ 147_619, 147_964 }, .{ 147_785, 148_734 }, .{ 145_226, 154_401 } }) |pair| {
+        try t.expectEqual(.nvfp4, draft.headFormatIn(.nvfp4, capOf(pair[1]), window, draft_n, chunk, .half, iw));
+        try t.expect(pair[0] <= 147_912); // its stream's prompt was at most the state's own length
+    }
+    // the draft vocabulary and the pass rows are the same on both sides: the boundary ignores them (the raw-key
+    // window does not: without it each position's raw keys move the boundary to cap 195,890)
+    try t.expectEqual(last, draft.bf16HeadCap(.nvfp4, window, 1, 16, .half, iw));
+    try t.expectEqual(@as(usize, 195_890), draft.bf16HeadCap(.nvfp4, window, draft_n, chunk, .half, 0));
+    try t.expectEqual(window, draft.bf16HeadCap(.bf16, window, draft_n, chunk, .half, iw));
+}
+
+test "a stream past the boundary refuses a bf16-head state by name, and adopting it costs at most 315 MiB past the charge" {
+    const iw = window_rows(chunk);
+    const kept: snaps.Snap = .{ .buf = undefined, .at = 147_619, .history = .{ 0, 0 }, .head = true, .heads = .half, .kv = .nvfp4, .head_kv = .bf16 };
+    try t.expectError(error.HeadKvFormat, snaps.headFits(.nvfp4, capOf(147_964), &kept));
+    try snaps.headFits(.bf16, capOf(147_964), &kept);
+    var no_head = kept;
+    no_head.head = false;
+    try t.expectError(error.NoHeadState, snaps.headFits(.bf16, capOf(147_964), &no_head));
+    // the flag's choice: the kept format, and what it holds past the charge (0 at the boundary, most at the window)
+    const at = draft.adoptHead(.nvfp4, .nvfp4, .bf16, capOf(147_964), window, draft_n, chunk, .half, iw).?;
+    try t.expectEqual(.bf16, at.kv);
+    try t.expect(at.over > 0 and at.over < 1 << 20);
+    const full = draft.adoptHead(.nvfp4, .nvfp4, .bf16, window, window, draft_n, chunk, .half, iw).?;
+    try t.expect(full.over > 314 << 20 and full.over < 316 << 20);
+    try t.expectEqual(@as(usize, 0), draft.adoptHead(.nvfp4, .nvfp4, .bf16, 180_712, window, draft_n, chunk, .half, iw).?.over);
+    // a cheaper kept format costs nothing past the charge; the same format, or no head rows, keeps the picked one
+    try t.expectEqual(@as(usize, 0), draft.adoptHead(.nvfp4, .bf16, .nvfp4, 100_000, window, draft_n, chunk, .half, iw).?.over);
+    try t.expect(draft.adoptHead(.nvfp4, .bf16, .bf16, 100_000, window, draft_n, chunk, .half, iw) == null);
+    try t.expect(draft.adoptHead(.nvfp4, .bf16, null, 100_000, window, draft_n, chunk, .half, iw) == null);
+}
diff --git a/zig/src/families/flashnext/cuda_knobs.zig b/zig/src/families/flashnext/cuda_knobs.zig
index c927060fe9a6c6acf8fa3762c8819fd109a53837..a48b244cc62fd156f7d337d57bed4605b8a5efbf 100644
--- a/zig/src/families/flashnext/cuda_knobs.zig
+++ b/zig/src/families/flashnext/cuda_knobs.zig
@@ -15,6 +15,25 @@ pub fn mx128MinN() usize {
     return std.fmt.parseInt(usize, std.mem.span(v), 10) catch 1024;
 }
 
+/// TF_FLASHNEXT_PCACHE_LIVE=1: the prompt cache pins each unfinished request's newest state (the one it resumed, or the
+/// newest its prompt pass kept) and evicts superseded states, then idle ones in LRU order, before any pinned one; a
+/// request's end touches its pinned state. When the pinned states alone fill the budget they go in today's order, so
+/// the budget holds and no keep waits. Unset or 0: today's order (superseded, then LRU touched only on keep and resume).
+pub fn pcacheLive() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_PCACHE_LIVE") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_RESTORE_HEAD_KV=1: a drafting stream that restores a kept state takes the format of that state's MTP
+/// head cache when it differs from the one its length would pick (mtp.headFormatIn: bf16 up to about 79% of the
+/// window at nvfp4, the main format past it). A cheaper format always; a bf16 one past the stream's charge only with
+/// the extra bytes lent from the prompt cache's budget (kept states giving them back), repaid when the stream ends.
+/// Unset or 0: the length decides, and a kept state whose head format differs is refused (NoHeadState).
+pub fn restoreHeadKv() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_RESTORE_HEAD_KV") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
 /// TF_FLASHNEXT_GATHER_EARLY=1: a shared pass gathers every stream's n-gram rows in one pool call (not one call a stream).
 pub fn gatherEarly() bool {
     const v = std.c.getenv("TF_FLASHNEXT_GATHER_EARLY") orelse return false;
@@ -68,3 +87,237 @@ pub fn promptGemm2() bool {
     const v = std.c.getenv("TF_FLASHNEXT_PROMPT_GEMM2") orelse return false;
     return std.mem.eql(u8, std.mem.span(v), "1");
 }
+
+/// TF_FLASHNEXT_TP_MOE_PARTIAL=1 (--tp 2): each rank sums its own routed slots and its shared columns into one fp32 row
+/// and the ranks add those rows (n x 2560 fp32), instead of adding every slot's row (n x 11 x 2560). Eleven times fewer
+/// bytes a layer; the two ranks' partial sums are added in a different order than one GPU's, so replies are not one GPU's
+/// bytes. Both ranks must agree (rank identity). Unset or 0: the exact slot sum.
+pub fn tpMoePartial() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_TP_MOE_PARTIAL") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_TP_MOE_OWN=1 (--tp 2, with TF_FLASHNEXT_TP_MOE_PARTIAL=1 and TF_FLASHNEXT_TP_FUSE_REDUCE >= 1): the partial
+/// sum reads only this rank's slots (fn_moe_sum_own), so the n x 11 x 2560 fp32 clear of y before the experts goes. Same
+/// bits as the partial sum it replaces and the same all-reduce message, so a rank-local choice: not in the identity.
+pub fn tpMoeOwn() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_TP_MOE_OWN") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_TP_SHARED_SLOT=1 (--tp 2, with TF_FLASHNEXT_TP_MOE_PARTIAL=1 and TF_FLASHNEXT_TP_FUSE_REDUCE >= 1): the
+/// partial sum reads the shared down projection's fp32 rows where they were written (fn_moe_sum_slot), so their copy into
+/// y's shared slot goes (upstream #1792's idea on the split MXFP8 path). Same bits and the same all-reduce message, so a
+/// rank-local choice: not in the identity.
+pub fn tpSharedSlot() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_TP_SHARED_SLOT") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_TP_PROMPT_RELAXED=1 (--tp 2): prompt passes take the relaxed prompt paths one rank takes by default
+/// (TF_FLASHNEXT_PROMPT_MX128 tiles, TF_FLASHNEXT_PROMPT_HC2) on each rank's half heads. Unset or 0: the exact kernels.
+pub fn tpPromptRelaxed() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_TP_PROMPT_RELAXED") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_TP_HEAD_ONCE=1 (--tp 2): a pass's LM-head rows cross the ranks in one gather and are put back in row order
+/// on the device (cuda_batch_head.projectHead), instead of one gather a row. The same bytes; fewer collectives, so both
+/// ranks must agree (rank identity). Unset or 0: a gather a row.
+pub fn tpHeadOnce() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_TP_HEAD_ONCE") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_TP_FUSE_REDUCE=<level> (--tp 2 with the dense split): fewer collectives a layer by summing partial
+/// products where two exchanges feed the same residual add. 0 or unset: off (4 a layer: dense_in, dense_out, shared, moe).
+/// 1: each rank keeps its own input columns of the shared expert's down projection and adds its partial output into the
+/// MoE all-reduce (no shared gather): 3 a layer. 2: level 1, and the out projection (DeltaNet out_proj, attention
+/// o_proj) also keeps each rank's input columns, so one fp32 all-reduce of the partial outputs replaces the BF16 input
+/// gather and the FP32 output gather: 2 a layer. A dot product's two halves are added across the ranks, so replies are
+/// not one GPU's bytes. Decided at load (it picks the weights' cut); both ranks must agree (rank identity). Other
+/// values refuse to start.
+pub fn tpFuseReduce() !u2 {
+    return fuseReduceSetting(if (std.c.getenv("TF_FLASHNEXT_TP_FUSE_REDUCE")) |v| std.mem.span(v) else null);
+}
+
+pub fn fuseReduceSetting(value: ?[]const u8) !u2 {
+    const v = value orelse return 0;
+    if (v.len == 1 and v[0] >= '0' and v[0] <= '2') return @intCast(v[0] - '0');
+    return error.BadFuseReduce;
+}
+
+/// TF_FLASHNEXT_TP_ASYNC_COLL=1 (--tp 2): the rank owner's NCCL communicator is a blocking one, so a collective returns
+/// once it is enqueued on the stream; the host no longer polls (and sleeps) after each call. Peer, NCCL async-error and
+/// timeout checks stay at the host boundaries (finish), and a guard thread ends the process (exit 70, as the fabric's
+/// fail-fast does) when an NCCL host call stays inside NCCL past the timeout or the peer's control link closes during
+/// one. The same bytes and collectives; a local choice, so the identity does not carry it. Unset or 0: the nonblocking
+/// communicator with a poll after every call.
+pub fn tpAsyncColl() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_TP_ASYNC_COLL") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_TP_ROCE=1 (--tp 2): the rank owner's all-gathers and fp32 sums of up to TF_FLASHNEXT_TP_ROCE_MAX_KB a
+/// rank go by one-shot RDMA writes over the ranks' RoCE link (cuda/roce.zig, as GLM's gathers) instead of NCCL; a sum is
+/// one exchange and rank 0's value + rank 1's in one IEEE round-to-nearest add an element, NCCL's FuncSum of two ranks,
+/// so the bytes do not change. Larger collectives, the broadcast and every collective when RoCE fails to come up on
+/// either rank stay on NCCL; TF_ROCE=0 vetoes it as for GLM. Both ranks run its setup exchange, so the identity carries
+/// it (bit 8 of tp_flags). Unset or 0: NCCL carries every collective.
+pub fn tpRoce() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_TP_ROCE") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// TF_FLASHNEXT_TP_ROCE_MAX_KB=<KiB> (1 to 65536; unset: 4096, GLM's TF_ROCE_MAX_KB default): the largest collective a
+/// rank sends by RoCE; the ranks take the smaller of their two. Other values refuse to start (BadRoceCap).
+pub fn tpRoceMaxBytes() !usize {
+    return roceMaxSetting(if (std.c.getenv("TF_FLASHNEXT_TP_ROCE_MAX_KB")) |v| std.mem.span(v) else null);
+}
+
+pub fn roceMaxSetting(value: ?[]const u8) !usize {
+    const v = value orelse return 4096 * 1024;
+    const n = std.fmt.parseInt(usize, v, 10) catch return error.BadRoceCap;
+    if (n == 0 or n > 65536) return error.BadRoceCap;
+    return n * 1024;
+}
+
+test "the RoCE cap is 4 MiB unset, 1 to 65536 KiB as given, and refuses anything else" {
+    try std.testing.expectEqual(@as(usize, 4096 * 1024), try roceMaxSetting(null));
+    try std.testing.expectEqual(@as(usize, 1024), try roceMaxSetting("1"));
+    try std.testing.expectEqual(@as(usize, 65536 * 1024), try roceMaxSetting("65536"));
+    for ([_][]const u8{ "", "0", "65537", "x", "-1", " 64" }) |bad| try std.testing.expectError(error.BadRoceCap, roceMaxSetting(bad));
+}
+
+/// TF_FLASHNEXT_DRAFT_LANES=<n> (2 to 32; unset: 16): the most drafting streams of a shared round whose MTP head runs
+/// as one batched pass a step (cuda_lanes_draft.batched). A round with more drafting streams drafts each stream alone:
+/// a head pass over the whole MTP layer and the draft head (~1.8 ms at one row) and a host wait for every draft, one
+/// stream after another, while rank 1 waits at --tp 2. The batched head gives every lane the drafts it would get alone
+/// (each lane's rows and sums as a lone head pass's), so the target's replies do not change; only time does. Other
+/// values refuse to start (BadDraftLanes). Rank 0 alone drafts, so the identity does not carry it.
+pub fn draftLanes() !usize {
+    return draftLanesSetting(if (std.c.getenv("TF_FLASHNEXT_DRAFT_LANES")) |v| std.mem.span(v) else null);
+}
+
+pub const draft_lanes_default: usize = 16;
+pub const draft_lanes_max: usize = 32;
+
+pub fn draftLanesSetting(value: ?[]const u8) !usize {
+    const v = value orelse return draft_lanes_default;
+    const n = std.fmt.parseInt(usize, v, 10) catch return error.BadDraftLanes;
+    if (n < 2 or n > draft_lanes_max) return error.BadDraftLanes;
+    return n;
+}
+
+/// TF_FLASHNEXT_GDN_LANE_GROUPS=1: a shared pass of more lanes than one DeltaNet lane table holds (16) runs the
+/// one-launch steps (TF_FLASHNEXT_GDN_LANES) once a group of up to 16 lanes, instead of five launches a lane a layer.
+/// Each lane's kernels, rows and sums are the one-launch path's, so the bits do not change. A local choice: the
+/// identity does not carry it. Unset or 0: more than 16 lanes go lane by lane.
+pub fn gdnLaneGroups() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_GDN_LANE_GROUPS") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+test "the draft-lane limit is 16 unset, 2 to 32 as given, and refuses anything else" {
+    try std.testing.expectEqual(@as(usize, 16), try draftLanesSetting(null));
+    try std.testing.expectEqual(@as(usize, 2), try draftLanesSetting("2"));
+    try std.testing.expectEqual(@as(usize, 24), try draftLanesSetting("24"));
+    try std.testing.expectEqual(@as(usize, 32), try draftLanesSetting("32"));
+    for ([_][]const u8{ "", "0", "1", "33", "64", "x", " 32", "-2" }) |bad| try std.testing.expectError(error.BadDraftLanes, draftLanesSetting(bad));
+}
+
+/// TF_FLASHNEXT_ROUND_ROWS_PER_STREAM=<k> (2 to 4; unset or 0: off): a drafting round's rows at most are k a stream,
+/// from the 64 a round always takes up to 128 (round_rows_max), instead of 64 whatever the streams. With 64 rows, 32
+/// streams verify one draft each where 16 streams verify three; with k = 3 they verify up to three a stream (96 rows).
+/// The rows a stream verifies change, not how a row is computed: each row's bits are a one-row pass's, and the target
+/// picks every token, so replies do not change. It widens the frame rank 1 accepts, so both ranks must agree (bits 5-7
+/// of tp_flags). Other values refuse to start (BadRoundRows).
+pub fn roundRowsPerStream() !u32 {
+    return roundRowsSetting(if (std.c.getenv("TF_FLASHNEXT_ROUND_ROWS_PER_STREAM")) |v| std.mem.span(v) else null);
+}
+
+pub fn roundRowsSetting(value: ?[]const u8) !u32 {
+    const v = value orelse return 0;
+    if (v.len == 1 and (v[0] == '0' or (v[0] >= '2' and v[0] <= '4'))) return v[0] - '0';
+    return error.BadRoundRows;
+}
+
+/// A drafting round's rows at most: 64, or 128 with TF_FLASHNEXT_ROUND_ROWS_PER_STREAM (a bad value: 64, refused at load).
+pub fn roundRowsCap() usize {
+    const k = roundRowsPerStream() catch 0;
+    return if (k == 0) 64 else 128;
+}
+
+test "the per-stream round rows are off unset or 0, 2 to 4 as given, and refuse anything else" {
+    try std.testing.expectEqual(@as(u32, 0), try roundRowsSetting(null));
+    try std.testing.expectEqual(@as(u32, 0), try roundRowsSetting("0"));
+    for ([_]u32{ 2, 3, 4 }) |k| try std.testing.expectEqual(k, try roundRowsSetting(&.{@as(u8, @intCast('0' + k))}));
+    for ([_][]const u8{ "", "1", "5", "8", "x", "33", " 3" }) |bad| try std.testing.expectError(error.BadRoundRows, roundRowsSetting(bad));
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_FLASHNEXT_ROUND_ROWS_PER_STREAM");
+    _ = env.unsetenv("TF_FLASHNEXT_ROUND_ROWS_PER_STREAM");
+    try std.testing.expectEqual(@as(usize, 64), roundRowsCap());
+    try std.testing.expectEqual(@as(u64, 0), tpFlags() >> 5);
+    _ = env.setenv("TF_FLASHNEXT_ROUND_ROWS_PER_STREAM", "3", 1);
+    try std.testing.expectEqual(@as(usize, 128), roundRowsCap());
+    try std.testing.expectEqual(@as(u64, 3), tpFlags() >> 5);
+    _ = env.setenv("TF_FLASHNEXT_ROUND_ROWS_PER_STREAM", "9", 1);
+    try std.testing.expectEqual(@as(usize, 64), roundRowsCap());
+    try std.testing.expectEqual(@as(u64, 7), tpFlags() >> 5);
+}
+
+/// The --tp 2 settings that change what crosses the ranks or what each computes: bit 0 TF_FLASHNEXT_TP_MOE_PARTIAL,
+/// bit 1 TF_FLASHNEXT_TP_PROMPT_RELAXED, bit 2 TF_FLASHNEXT_TP_HEAD_ONCE, bits 3-4 TF_FLASHNEXT_TP_FUSE_REDUCE's level
+/// (a bad level counts as 3, which no rank that started can hold), bits 5-7 TF_FLASHNEXT_ROUND_ROWS_PER_STREAM (a bad
+/// value counts as 7), bit 8 TF_FLASHNEXT_TP_ROCE (its setup exchange). Both ranks' identities carry it.
+pub fn tpFlags() u64 {
+    const fuse: u64 = tpFuseReduce() catch 3;
+    const rows: u64 = roundRowsPerStream() catch 7;
+    return @as(u64, @intFromBool(tpMoePartial())) | @as(u64, @intFromBool(tpPromptRelaxed())) << 1 | @as(u64, @intFromBool(tpHeadOnce())) << 2 | fuse << 3 | rows << 5 | @as(u64, @intFromBool(tpRoce())) << 8;
+}
+
+test "the fuse-reduce level is 0 unset, 0 to 2 as given, and refuses anything else" {
+    try std.testing.expectEqual(@as(u2, 0), try fuseReduceSetting(null));
+    try std.testing.expectEqual(@as(u2, 0), try fuseReduceSetting("0"));
+    try std.testing.expectEqual(@as(u2, 1), try fuseReduceSetting("1"));
+    try std.testing.expectEqual(@as(u2, 2), try fuseReduceSetting("2"));
+    for ([_][]const u8{ "", "3", "on", "12", "-1", " 1" }) |bad| try std.testing.expectError(error.BadFuseReduce, fuseReduceSetting(bad));
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_FLASHNEXT_TP_FUSE_REDUCE");
+    defer _ = env.unsetenv("TF_FLASHNEXT_TP_ASYNC_COLL");
+    _ = env.unsetenv("TF_FLASHNEXT_TP_FUSE_REDUCE");
+    _ = env.unsetenv("TF_FLASHNEXT_TP_ASYNC_COLL");
+    try std.testing.expect(!tpAsyncColl());
+    _ = env.setenv("TF_FLASHNEXT_TP_ASYNC_COLL", "1", 1);
+    try std.testing.expect(tpAsyncColl());
+    _ = env.setenv("TF_FLASHNEXT_TP_FUSE_REDUCE", "2", 1);
+    try std.testing.expectEqual(@as(u64, 2 << 3), tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_TP_FUSE_REDUCE", "x", 1);
+    try std.testing.expectEqual(@as(u64, 3 << 3), tpFlags());
+}
+
+test "the --tp 2 flags are off unless set to 1, and the identity bits follow them" {
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_FLASHNEXT_TP_MOE_PARTIAL");
+    defer _ = env.unsetenv("TF_FLASHNEXT_TP_PROMPT_RELAXED");
+    _ = env.unsetenv("TF_FLASHNEXT_TP_MOE_PARTIAL");
+    _ = env.unsetenv("TF_FLASHNEXT_TP_PROMPT_RELAXED");
+    try std.testing.expectEqual(@as(u64, 0), tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "0", 1);
+    try std.testing.expectEqual(@as(u64, 0), tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    try std.testing.expectEqual(@as(u64, 1), tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_TP_PROMPT_RELAXED", "1", 1);
+    try std.testing.expectEqual(@as(u64, 3), tpFlags());
+    _ = env.unsetenv("TF_FLASHNEXT_TP_MOE_PARTIAL");
+    try std.testing.expectEqual(@as(u64, 2), tpFlags());
+    defer _ = env.unsetenv("TF_FLASHNEXT_TP_HEAD_ONCE");
+    _ = env.setenv("TF_FLASHNEXT_TP_HEAD_ONCE", "1", 1);
+    try std.testing.expectEqual(@as(u64, 6), tpFlags());
+    defer _ = env.unsetenv("TF_FLASHNEXT_TP_ROCE");
+    _ = env.setenv("TF_FLASHNEXT_TP_ROCE", "1", 1);
+    try std.testing.expect(tpRoce());
+    try std.testing.expectEqual(@as(u64, 6 | 1 << 8), tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_TP_ROCE", "0", 1);
+    try std.testing.expectEqual(@as(u64, 6), tpFlags());
+}
