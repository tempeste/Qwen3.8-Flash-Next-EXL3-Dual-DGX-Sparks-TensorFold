--- /dev/null
+++ b/zig/tests/cuda/flashnext_roce_tests.zig
@@ -0,0 +1,257 @@
+//! tf-cuda-test flashnext-roce RANK PORT: TF_FLASHNEXT_TP_ROCE's all-gathers and fp32 sums give NCCL's bytes on two ranks.
+//! Each --tp 2 message kind at decode, round and prompt row counts: the owner's path (RoCE where it fits) against the
+//! same call straight to NCCL on a copy of the same rows, byte for byte; the sums against the host's IEEE f32 add of the
+//! two ranks' rows (NaN by class: NCCL and the GPU add give the canonical NaN), and each result's digest against the
+//! peer's. Rows hold signed zeros, subnormals, infinities, NaNs, overflow and exact cancellation. Misaligned rows (the
+//! staging path), sizes past the cap and not a multiple of 16 bytes (NCCL), and chains without a host wait between
+//! calls are cases too. Needs both ranks' RoCE up (/dev/infiniband, IPC_LOCK, NCCL_IB_HCA or TF_ROCE_HCA).
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rank_tests = @import("flashnext_rank_tests.zig");
+const wire = flash.rank_wire;
+const Collective = flash.collective.Collective;
+
+const cap: usize = 4096 * 1024;
+
+const Kind = enum { gather, gather_f32, sum };
+const Case = struct { site: []const u8, kind: Kind, per_row: usize, rows: []const usize };
+
+/// Flash Next's messages (flashnext_rank_tests' bench table) at the rows a decode, a round and a prompt chunk take, with
+/// the rows past the 4 MiB cap that must stay on NCCL; dense_sum and moe_shared (fuse level 2) are the 2560-wide sums.
+const cases = [_]Case{
+    .{ .site = "dense_sum/moe_shared", .kind = .sum, .per_row = 2560, .rows = &.{ 1, 2, 7, 8, 16, 21, 28, 32, 48, 64, 84, 96, 128, 256, 409, 410, 1536 } },
+    .{ .site = "moe", .kind = .sum, .per_row = 11 * 2560, .rows = &.{ 1, 7, 14, 15 } },
+    .{ .site = "odd sum", .kind = .sum, .per_row = 2561, .rows = &.{ 1, 3, 4 } },
+    .{ .site = "dense_in", .kind = .gather, .per_row = 3072, .rows = &.{ 1, 8, 64, 128 } },
+    .{ .site = "dense_out", .kind = .gather_f32, .per_row = 1280, .rows = &.{ 1, 8, 64, 128 } },
+    .{ .site = "shared", .kind = .gather, .per_row = 320, .rows = &.{ 1, 8, 64, 128 } },
+    .{ .site = "head", .kind = .gather, .per_row = 124_160, .rows = &.{ 1, 4, 16, 17 } },
+};
+
+fn elementBytes(k: Kind) usize {
+    return if (k == .gather) 2 else 4;
+}
+
+/// Rank `rank`'s word `i` of a case: special values on a fixed pattern, the rest random bits with a bounded exponent
+/// (so most sums are finite and exercise rounding); every 13th word on rank 1 cancels rank 0's exactly.
+fn word32(seed: u64, rank: usize, i: usize) u32 {
+    const specials = [_]u32{ 0x00000000, 0x80000000, 0x00000001, 0x80000001, 0x007fffff, 0x00800000, 0x7f7fffff, 0xff7fffff, 0x7f800000, 0xff800000, 0x7fc00000, 0x7fa00001, 0x00400000, 0x3f800000, 0x33800000 };
+    if (rank == 1 and i % 13 == 5) return word32(seed, 0, i) ^ 0x80000000;
+    var h = std.hash.Wyhash.init(seed);
+    h.update(std.mem.asBytes(&rank));
+    h.update(std.mem.asBytes(&i));
+    const r = h.final();
+    if (r % 17 == 0) return specials[(r >> 8) % specials.len];
+    const sign: u32 = @intCast((r >> 40) & 1);
+    const exp: u32 = @intCast(64 + (r >> 41) % 128);
+    return sign << 31 | exp << 23 | @as(u32, @truncate(r & 0x7fffff));
+}
+
+fn word16(seed: u64, rank: usize, i: usize) u16 {
+    return @truncate(word32(seed, rank, i) >> 16);
+}
+
+fn fill(host: []u8, k: Kind, seed: u64, rank: usize) void {
+    if (k == .gather) {
+        const w = std.mem.bytesAsSlice(u16, host);
+        for (w, 0..) |*v, i| v.* = word16(seed, rank, i);
+    } else {
+        const w = std.mem.bytesAsSlice(u32, host);
+        for (w, 0..) |*v, i| v.* = word32(seed, rank, i);
+    }
+}
+
+fn rawNccl(c: *Collective, stream: cuda.Stream, k: Kind, a: u64, b: u64, count: usize) !void {
+    const api = c.lib.api;
+    const r = switch (k) {
+        .gather => api.ncclAllGather(a, b, count, .bf16, c.comm, stream.handle),
+        .gather_f32 => api.ncclAllGather(a, b, count, .f32, c.comm, stream.handle),
+        .sum => api.ncclAllReduce(a, a, count, .f32, .sum, c.comm, stream.handle),
+    };
+    if (r == 0) return;
+    if (r != 7) return error.NcclFailed;
+    while (true) {
+        var state: cuda.nccl.Result = 0;
+        if (c.api.ncclCommGetAsyncError(c.comm, &state) != 0) return error.NcclFailed;
+        if (state == 0) return;
+        if (state != 7) return error.NcclFailed;
+    }
+}
+
+fn owner(c: *Collective, stream: cuda.Stream, k: Kind, a: u64, b: u64, count: usize) !void {
+    switch (k) {
+        .gather => try c.gather(stream, a, b, count),
+        .gather_f32 => try c.gatherF32(stream, a, b, count),
+        .sum => try c.sum(stream, a, count),
+    }
+}
+
+fn meet(link: wire.Link, rank: usize, seq: usize, arg: u64) !u64 {
+    const h: wire.Header = .{ .kind = .ready, .sequence = seq, .arg = arg };
+    const until = wire.deadline(60_000);
+    if (rank == 0) {
+        try link.sendHeader(h, until);
+        const got = try link.receiveHeader(until);
+        try check.expect(got.kind == .ready and got.sequence == seq, "rank 0: peer in step at {d}", .{seq});
+        return got.arg;
+    }
+    const got = try link.receiveHeader(until);
+    try check.expect(got.kind == .ready and got.sequence == seq, "rank 1: peer in step at {d}", .{seq});
+    try link.sendHeader(h, until);
+    return got.arg;
+}
+
+fn digest(bytes: []const u8) u64 {
+    return std.hash.Wyhash.hash(0x5eed, bytes);
+}
+
+/// The host's expected sum: rank 0's value + rank 1's in f32 (IEEE, subnormals kept); NaN compared by class.
+fn checkSum(rank: usize, what: []const u8, got: []const u8, seed: u64) !void {
+    const w = std.mem.bytesAsSlice(u32, got);
+    var bad: usize = 0;
+    var first: usize = 0;
+    for (w, 0..) |g, i| {
+        const a: f32 = @bitCast(word32(seed, 0, i));
+        const b: f32 = @bitCast(word32(seed, 1, i));
+        const want: f32 = a + b;
+        const gf: f32 = @bitCast(g);
+        const ok = if (std.math.isNan(want)) std.math.isNan(gf) else g == @as(u32, @bitCast(want));
+        if (!ok) {
+            if (bad == 0) first = i;
+            bad += 1;
+        }
+    }
+    if (bad != 0) {
+        const a = word32(seed, 0, first);
+        const b = word32(seed, 1, first);
+        const want: f32 = @as(f32, @bitCast(a)) + @as(f32, @bitCast(b));
+        std.debug.print("FAIL rank {d}: {s}: {d} words differ from the host's f32 add; first at {d}: 0x{x:0>8} + 0x{x:0>8} = 0x{x:0>8}, got 0x{x:0>8}\n", .{ rank, what, bad, first, a, b, @as(u32, @bitCast(want)), w[first] });
+        return error.TestFailed;
+    }
+}
+
+fn checkGather(rank: usize, what: []const u8, got: []const u8, k: Kind, seed: u64, count: usize) !void {
+    const want = try std.heap.page_allocator.alloc(u8, got.len);
+    defer std.heap.page_allocator.free(want);
+    const half = count * elementBytes(k);
+    fill(want[0..half], k, seed, 0);
+    fill(want[half..], k, seed, 1);
+    check.sameBytes(what, got, want) catch |e| {
+        std.debug.print("FAIL rank {d}: {s}: not both ranks' rows in rank order\n", .{ rank, what });
+        return e;
+    };
+}
+
+pub fn run(gpu: check.Gpu, rank: usize, port: u16) !void {
+    const link = try wire.Link.open(gpu.io, rank_tests.rankHost(), port, rank, 60_000);
+    defer link.close();
+    var c = try Collective.init(link, rank, 30_000);
+    defer c.deinit();
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    try c.openRoce(gpu.gpa, gpu.io, gpu.d, true, cap);
+    const g = c.roce orelse {
+        std.debug.print("FAIL rank {d}: RoCE did not come up on both ranks (see the RoCE all-gather warning above)\n", .{rank});
+        return error.TestFailed;
+    };
+    check.pass("rank {d}: RoCE up, {d} HCA(s), cap {d} KiB", .{ rank, g.n_hca, g.max_bytes >> 10 });
+    var most: usize = 0;
+    for (cases) |cs| for (cs.rows) |rows| {
+        most = @max(most, rows * cs.per_row * elementBytes(cs.kind));
+    };
+    var a = try cuda.DeviceBuffer.alloc(gpu.d, most + 16);
+    defer a.free();
+    var b = try cuda.DeviceBuffer.alloc(gpu.d, most + 16);
+    defer b.free();
+    var ao = try cuda.DeviceBuffer.alloc(gpu.d, 2 * most + 16);
+    defer ao.free();
+    var bo = try cuda.DeviceBuffer.alloc(gpu.d, 2 * most + 16);
+    defer bo.free();
+    const host = try gpu.gpa.alloc(u8, 2 * most);
+    defer gpu.gpa.free(host);
+    const ref = try gpu.gpa.alloc(u8, 2 * most);
+    defer gpu.gpa.free(ref);
+    var seq: usize = 1;
+    var checked: usize = 0;
+    var by_roce: usize = 0;
+    for (cases, 0..) |cs, ci| for (cs.rows) |rows| for ([_]usize{ 0, 1 }) |skew| {
+        const eb = elementBytes(cs.kind);
+        const count = rows * cs.per_row;
+        const bytes = count * eb;
+        const off: usize = skew * eb;
+        const seed: u64 = ci * 1_000_003 + rows * 7 + skew;
+        const label = try std.fmt.allocPrint(gpu.gpa, "{s} {d} rows ({d} B a rank{s})", .{ cs.site, rows, bytes, if (skew == 1) ", misaligned" else "" });
+        defer gpu.gpa.free(label);
+        fill(host[0..bytes], cs.kind, seed, rank);
+        try a.upload(off, host[0..bytes]);
+        try b.upload(off, host[0..bytes]);
+        try ao.fill8(0xa5, stream.handle);
+        try bo.fill8(0x5a, stream.handle);
+        try stream.synchronize();
+        seq += 1;
+        _ = try meet(link, rank, seq, 0);
+        const before = g.gathers;
+        try rawNccl(&c, stream, cs.kind, a.ptr + off, ao.ptr + off, count);
+        try c.finish(stream);
+        try owner(&c, stream, cs.kind, b.ptr + off, bo.ptr + off, count);
+        try c.finish(stream);
+        const went = g.gathers != before;
+        const should = flash.collective.roceTakes(g.max_bytes, bytes);
+        try check.expect(went == should, "rank {d}: {s}: path {s}, expected {s}", .{ rank, label, if (went) "RoCE" else "NCCL", if (should) "RoCE" else "NCCL" });
+        if (went) by_roce += 1;
+        const out_bytes = if (cs.kind == .sum) bytes else 2 * bytes;
+        if (cs.kind == .sum) {
+            try a.download(off, ref[0..out_bytes]);
+            try b.download(off, host[0..out_bytes]);
+            try checkSum(rank, label, ref[0..out_bytes], seed);
+        } else {
+            try ao.download(off, ref[0..out_bytes]);
+            try bo.download(off, host[0..out_bytes]);
+            try checkGather(rank, label, ref[0..out_bytes], cs.kind, seed, count);
+        }
+        check.sameBytes(label, host[0..out_bytes], ref[0..out_bytes]) catch |e| {
+            std.debug.print("FAIL rank {d}: {s}: the owner's {s} path differs from NCCL\n", .{ rank, label, if (went) "RoCE" else "NCCL" });
+            return e;
+        };
+        seq += 1;
+        const mine = digest(host[0..out_bytes]);
+        const theirs = try meet(link, rank, seq, mine);
+        try check.expect(mine == theirs, "rank {d}: {s}: both ranks hold the same bytes", .{ rank, label });
+        checked += 1;
+    };
+    try chain(gpu, &c, stream, link, rank, &seq, a, b, ao, bo, host, ref);
+    seq += 1;
+    _ = try meet(link, rank, seq, 0);
+    check.pass("rank {d}: {d} cases ({d} by RoCE) equal NCCL's bytes, the host's IEEE f32 sums and the peer's digests", .{ rank, checked, by_roce });
+}
+
+/// A layer's pattern without a host wait: sum, gather, sum, f32 gather, sum past the cap, sum, on one stream; the RoCE
+/// sequence interleaves with NCCL's calls. Each step's NCCL twin runs the same chain on copies.
+fn chain(gpu: check.Gpu, c: *Collective, stream: cuda.Stream, link: wire.Link, rank: usize, seq: *usize, a: cuda.DeviceBuffer, b: cuda.DeviceBuffer, ao: cuda.DeviceBuffer, bo: cuda.DeviceBuffer, host: []u8, ref: []u8) !void {
+    _ = gpu;
+    const steps = [_]struct { Kind, usize }{ .{ .sum, 84 * 2560 }, .{ .gather, 84 * 3072 }, .{ .sum, 84 * 2560 }, .{ .gather_f32, 84 * 1280 }, .{ .sum, 420 * 2560 }, .{ .sum, 84 * 2560 }, .{ .gather, 8 * 124_160 } };
+    const n = 420 * 2560 * 4;
+    fill(host[0..n], .sum, 77, rank);
+    try a.upload(0, host[0..n]);
+    try b.upload(0, host[0..n]);
+    try stream.synchronize();
+    seq.* += 1;
+    _ = try meet(link, rank, seq.*, 0);
+    for (steps) |st| try rawNccl(c, stream, st[0], a.ptr, ao.ptr, st[1]);
+    try c.finish(stream);
+    for (steps) |st| try owner(c, stream, st[0], b.ptr, bo.ptr, st[1]);
+    try c.finish(stream);
+    try a.download(0, ref[0..n]);
+    try b.download(0, host[0..n]);
+    try check.sameBytes("chained sums (rows)", host[0..n], ref[0..n]);
+    const m = 2 * 8 * 124_160 * 2;
+    try ao.download(0, ref[0..m]);
+    try bo.download(0, host[0..m]);
+    try check.sameBytes("chained gathers (the last one's rows)", host[0..m], ref[0..m]);
+    seq.* += 1;
+    const mine = digest(host[0..m]);
+    try check.expect(mine == try meet(link, rank, seq.*, mine), "rank {d}: chain: both ranks hold the same bytes", .{rank});
+    check.pass("rank {d}: a chain of {d} sums and gathers without a host wait equals NCCL's", .{ rank, steps.len });
+}
