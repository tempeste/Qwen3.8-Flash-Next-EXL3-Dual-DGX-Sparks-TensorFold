+    defer _ = std.c.close(pair[0]);
+    var g: Guard = .{ .link = .{ .fd = pair[0] }, .rank = 1, .timeout_ns = 50 * std.time.ns_per_ms };
+    const t = wire.now();
+    try std.testing.expect(g.verdict(t) == null);
+    g.enter();
+    try std.testing.expect(g.verdict(wire.now()) == null);
+    try std.testing.expect(g.verdict(wire.now() + 60 * std.time.ns_per_ms) != null);
+    g.leave();
+    try std.testing.expect(g.verdict(wire.now() + 60 * std.time.ns_per_ms) == null);
+    _ = std.c.close(pair[1]);
+    try std.testing.expect(g.verdict(wire.now()) == null);
+    g.enter();
+    try std.testing.expect(g.verdict(wire.now()) != null);
+}
