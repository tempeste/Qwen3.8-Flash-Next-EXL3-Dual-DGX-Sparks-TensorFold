+// ---- a shared pass's lanes, one launch a step (#1942's fn_gdn_lanes_*, on the full heads or a rank's _h8 half) ----
+namespace fn_lanes {
+constexpr int MAXL = 16;
+struct Lane {
+    const __nv_bfloat16* proj;  // the lane's projection rows in the pass
+    __nv_bfloat16* conv;        // its conv window
+    float* state;               // its DeltaNet state (the chain's start)
+    float* state_out;           // the window's end state (a spare); null: in place
+    float* log;                 // its pending-row log (fn_late, whole heads only); null: none
+    const unsigned* ctl;
+    __nv_bfloat16* keep_proj;   // where its rollback keeps the rows and the conv window before them; null: none
+    __nv_bfloat16* keep_hist;
+    int row0, rows;             // its first row in the pass, its rows
+};
+struct Lanes {
+    Lane l[MAXL];
+    int n;
+};
+
+// Each lane's rows and conv window into its keep (the lone pass's two copies), 16 bytes a thread.
+template <int NK, int NV>
+static __device__ __forceinline__ void keep(const Lanes& t) {
+    using namespace fn_gdn;
+    constexpr int C = G<NK, NV>::C, PW = G<NK, NV>::PW;
+    const Lane& l = t.l[blockIdx.y];
+    const long long nproj = (long long)l.rows * PW * 2 / 16, nhist = (long long)(TAPS - 1) * C * 2 / 16;
+    for (long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x; i < nproj + nhist; i += (long long)gridDim.x * blockDim.x) {
+        if (i < nproj) {
+            if (l.keep_proj) reinterpret_cast<uint4*>(l.keep_proj)[i] = reinterpret_cast<const uint4*>(l.proj)[i];
+        } else if (l.keep_hist) reinterpret_cast<uint4*>(l.keep_hist)[i - nproj] = reinterpret_cast<const uint4*>(l.conv)[i - nproj];
+    }
+}
+
+// fn_gdn_front (or, with a log, fn_gdn_front_log) of every lane: grid (the widest lane's rows, NK + NV, lanes).
+template <int NK, int NV, bool LOGS>
+static __device__ __forceinline__ void front(
+        const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        float* __restrict__ qn, float* __restrict__ kn, float* __restrict__ v, float* __restrict__ gb, int log_rows,
+        const Lanes& t) {
+    using namespace fn_gdn;
+    const Lane& l = t.l[blockIdx.z];
+    if ((int)blockIdx.x >= l.rows) return;
+    float* q = qn + (size_t)l.row0 * NK * DK;
+    if constexpr (LOGS) {
+        if (l.log) {
+            float* vl = l.log + (size_t)log_rows * NK * DK;
+            gdn_front<NK, NV, true>(l.proj, l.conv, cw, a_log, dt_bias, q, l.log, vl, vl + (size_t)log_rows * NV * DV, l.ctl, log_rows);
+            return;
+        }
+    }
+    gdn_front<NK, NV, false>(l.proj, l.conv, cw, a_log, dt_bias, q, kn + (size_t)l.row0 * NK * DK, v + (size_t)l.row0 * NV * DV,
+                             gb + (size_t)l.row0 * NV * 2, nullptr, 1);
+}
+
+// Every lane's chain (with a log fn_gdn_rows_late, else fn_gdn_rows_to or in place): grid (NV, DV / 16, lanes).
+template <int NK, int NV, bool LOGS>
+static __device__ __forceinline__ void chain(
+        const float* __restrict__ qn, const float* __restrict__ kn, const float* __restrict__ v, const float* __restrict__ gb,
+        float* __restrict__ ys, int log_rows, int store_above, const Lanes& t) {
+    using namespace fn_gdn;
+    const Lane& l = t.l[blockIdx.z];
+    const float* q = qn + (size_t)l.row0 * NK * DK;
+    float* y = ys + (size_t)l.row0 * NV * DV;
+    if constexpr (LOGS) {
+        if (l.log) {
+            gdn_rows_late(q, l.log, l.ctl, log_rows, store_above, l.state, l.state_out, l.rows, y);
+            return;
+        }
+    }
+    gdn_rows<NK, NV>(q, kn + (size_t)l.row0 * NK * DK, v + (size_t)l.row0 * NV * DV, gb + (size_t)l.row0 * NV * 2, l.state,
+                     l.state_out ? l.state_out : l.state, l.rows, y);
+}
+
+// Every lane's conv window moved on past its rows: grid (C / 256 rounded up, lanes).
+template <int NK, int NV>
+static __device__ __forceinline__ void shift(const Lanes& t) {
+    using namespace fn_gdn;
+    constexpr int C = G<NK, NV>::C, PW = G<NK, NV>::PW;
+    const Lane& l = t.l[blockIdx.y];
+    shift_window(l.conv, l.proj, PW, l.rows, TAPS - 1, C);
+}
+}  // namespace fn_lanes
+
+extern "C" __global__ void fn_gdn_lanes_keep(const fn_lanes::Lanes t) { fn_lanes::keep<16, 48>(t); }
+extern "C" __global__ void __launch_bounds__(256) fn_gdn_lanes_front(
+        const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        float* __restrict__ qn, float* __restrict__ kn, float* __restrict__ v, float* __restrict__ gb, int log_rows,
+        const fn_lanes::Lanes t) {
+    fn_lanes::front<16, 48, true>(cw, a_log, dt_bias, qn, kn, v, gb, log_rows, t);
+}
+extern "C" __global__ void __launch_bounds__(128) fn_gdn_lanes_chain(
+        const float* __restrict__ qn, const float* __restrict__ kn, const float* __restrict__ v, const float* __restrict__ gb,
+        float* __restrict__ ys, int log_rows, int store_above, const fn_lanes::Lanes t) {
+    fn_lanes::chain<16, 48, true>(qn, kn, v, gb, ys, log_rows, store_above, t);
+}
+extern "C" __global__ void fn_gdn_lanes_shift(const fn_lanes::Lanes t) { fn_lanes::shift<16, 48>(t); }
+
+// The same on one rank's 8 key and 24 value heads (--tp 2); a log is refused there, so no lane carries one.
+extern "C" __global__ void fn_gdn_lanes_keep_h8(const fn_lanes::Lanes t) { fn_lanes::keep<8, 24>(t); }
+extern "C" __global__ void __launch_bounds__(256) fn_gdn_lanes_front_h8(
+        const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        float* __restrict__ qn, float* __restrict__ kn, float* __restrict__ v, float* __restrict__ gb, int log_rows,
+        const fn_lanes::Lanes t) {
+    fn_lanes::front<8, 24, false>(cw, a_log, dt_bias, qn, kn, v, gb, log_rows, t);
+}
+extern "C" __global__ void __launch_bounds__(128) fn_gdn_lanes_chain_h8(
+        const float* __restrict__ qn, const float* __restrict__ kn, const float* __restrict__ v, const float* __restrict__ gb,
+        float* __restrict__ ys, int log_rows, int store_above, const fn_lanes::Lanes t) {
+    fn_lanes::chain<8, 24, false>(qn, kn, v, gb, ys, log_rows, store_above, t);
+}
+extern "C" __global__ void fn_gdn_lanes_shift_h8(const fn_lanes::Lanes t) { fn_lanes::shift<8, 24>(t); }
+
 // ---- sparse attention (QSA): each row's blocks ----------------------------------------------------------------------
 
 // attention._select's order-preserving key of a block score: negative floats flipped, positive ones topped.
@@ -511,6 +623,41 @@ extern "C" __global__ void fn_moe_sum(const float* __restrict__ y, const float*
     out[static_cast<long long>(r) * d + col] = acc;
 }
 
+// fn_moe_sum over this rank's slots only (--tp, TF_FLASHNEXT_TP_MOE_OWN): a routed slot whose rank-local pick is `skip`
+// (another rank's expert) is passed over, the shared slot (slots - 1) always taken. Those slots are the only ones this
+// rank's down kernel and shared partial wrote, so y needs no clear. The terms passed over were fma(+0, w >= 0, acc) in
+// fn_moe_sum, which leave acc unchanged; the sum's order is fn_moe_sum's, so the bits are its own (an exact zero sum may
+// keep its sign).
+extern "C" __global__ void fn_moe_sum_own(const float* __restrict__ y, const float* __restrict__ wts,
+                                          const int* __restrict__ own, int skip, float* __restrict__ out, int d,
+                                          int slots) {
+    const int r = blockIdx.x, col = blockIdx.y * blockDim.x + threadIdx.x;
+    if (col >= d) return;
+    float acc = 0.0f;
+    for (int k = 0; k < slots; ++k) {
+        if (k < slots - 1 && own[r * slots + k] == skip) continue;
+        acc = __fmaf_rn(y[(static_cast<long long>(r) * slots + k) * d + col], wts[r * slots + k], acc);
+    }
+    out[static_cast<long long>(r) * d + col] = acc;
+}
+
+// fn_moe_sum or fn_moe_sum_own (own non-null) with the shared slot's row read from `shared` [rows, d] fp32 where the
+// shared down projection wrote it, not from y's last slot (--tp, TF_FLASHNEXT_TP_SHARED_SLOT): the copy of those rows
+// into y goes. Same values in the same fma order as the sum it replaces, so the same bits.
+extern "C" __global__ void fn_moe_sum_slot(const float* __restrict__ y, const float* __restrict__ wts,
+                                           const int* __restrict__ own, int skip, const float* __restrict__ shared,
+                                           float* __restrict__ out, int d, int slots) {
+    const int r = blockIdx.x, col = blockIdx.y * blockDim.x + threadIdx.x;
+    if (col >= d) return;
+    float acc = 0.0f;
+    for (int k = 0; k < slots - 1; ++k) {
+        if (own != nullptr && own[r * slots + k] == skip) continue;
+        acc = __fmaf_rn(y[(static_cast<long long>(r) * slots + k) * d + col], wts[r * slots + k], acc);
+    }
+    acc = __fmaf_rn(shared[static_cast<long long>(r) * d + col], wts[r * slots + slots - 1], acc);
+    out[static_cast<long long>(r) * d + col] = acc;
+}
+
 // dst [rows, width] (rows dst_pitch apart) = the columns src [rows, width] (src_pitch apart), 16-bit values.
 extern "C" __global__ void fn_copy_cols(const uint16_t* __restrict__ src, long long src_pitch, uint16_t* __restrict__ dst,
                                         long long dst_pitch, int width) {
