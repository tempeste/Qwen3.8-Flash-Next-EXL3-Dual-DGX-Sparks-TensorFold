+/// TF_FLASHNEXT_TP_ROCE's setup exchange (cuda.roce.Gather.initWith) over the control link: rank 0 sends first.
+const LinkSwap = struct {
+    link: wire.Link,
+    rank: usize,
+    timeout_ms: u64,
+
+    pub fn swap(x: LinkSwap, comptime T: type, mine: T) !T {
+        var theirs: T = undefined;
+        const until = wire.deadline(x.timeout_ms);
+        if (x.rank == 0) {
+            try x.link.send(std.mem.asBytes(&mine), until);
+            try x.link.receive(std.mem.asBytes(&theirs), until);
+        } else {
+            try x.link.receive(std.mem.asBytes(&theirs), until);
+            try x.link.send(std.mem.asBytes(&mine), until);
+        }
+        return theirs;
+    }
+};
