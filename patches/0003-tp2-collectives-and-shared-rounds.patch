+/// TF_FLASHNEXT_TP_ASYNC_COLL: a blocking communicator's host calls return only once NCCL has enqueued (or, the first
+/// time a path is used, connected to the peer), so nothing polls them. This thread watches the calls instead: one that
+/// stays inside NCCL past the timeout, or the peer's control link closing during one, ends the process with exit 70,
+/// as the fabric's fail-fast ends a rank (fabric/tp/fate.zig). Between calls it reads nothing.
+const Guard = struct {
+    link: wire.Link,
+    rank: usize,
+    timeout_ns: u64,
+    /// Monotonic ns at which the host entered an NCCL call; 0: not in one.
+    since: std.atomic.Value(u64) = .init(0),
+    stop: std.atomic.Value(bool) = .init(false),
+    thread: ?std.Thread = null,
+    /// The process exit; tests replace it (it may return there).
+    exit_fn: *const fn (u8) void = exitNow,
+    fired: std.atomic.Value(bool) = .init(false),
+
+    pub const exit_code: u8 = 70;
+    const period_ns: u64 = 1_000_000;
+    /// `since` once the guard has claimed the call it judged: leave() then never returns, so the verdict and the exit
+    /// are about the same call, never one that has ended (or a shutdown after it).
+    const claimed: u64 = std.math.maxInt(u64);
+
+    fn start(link: wire.Link, rank: usize, timeout_ms: u64) !*Guard {
+        const g = try std.heap.page_allocator.create(Guard);
+        errdefer std.heap.page_allocator.destroy(g);
+        g.* = .{ .link = link, .rank = rank, .timeout_ns = timeout_ms *| std.time.ns_per_ms };
+        g.thread = try std.Thread.spawn(.{}, main, .{g});
+        return g;
+    }
+
+    fn end(g: *Guard) void {
+        g.stop.store(true, .release);
+        if (g.thread) |t| t.join();
+        std.heap.page_allocator.destroy(g);
+    }
+
+    fn enter(g: *Guard) void {
+        g.since.store(@max(wire.now(), 1), .release);
+    }
+
+    /// A call's end. If the guard already claimed this call (`fired`), the process is ending: wait for the exit.
+    fn leave(g: *Guard) void {
+        if (g.since.swap(0, .acq_rel) == claimed) while (true) wire.nap(period_ns);
+    }
+
+    /// One look: null while the host is out of NCCL, inside it within the timeout, and the peer's link is open.
+    fn verdict(g: *Guard, now: u64) ?[]const u8 {
+        return g.verdictOf(g.since.load(.acquire), now);
+    }
+
+    fn verdictOf(g: *Guard, t: u64, now: u64) ?[]const u8 {
+        if (t == 0 or t == claimed) return null;
+        if (now -| t > g.timeout_ns) return "an NCCL call stayed in NCCL past the rank timeout";
+        g.link.checkPeer() catch return "the peer's control link closed during an NCCL call";
+        return null;
+    }
+
+    fn main(g: *Guard) void {
+        while (!g.stop.load(.acquire)) {
+            wire.nap(period_ns);
+            const t = g.since.load(.acquire);
+            const why = g.verdictOf(t, wire.now()) orelse continue;
+            if (g.stop.load(.acquire)) return;
+            if (g.since.cmpxchgStrong(t, claimed, .acq_rel, .acquire) != null) continue;
+            g.fired.store(true, .release);
+            std.debug.print("tp rank {d}: {s} (TF_FLASHNEXT_TP_ASYNC_COLL); ending the process with exit {d}\n", .{ g.rank, why, exit_code });
+            g.exit_fn(exit_code);
+            return;
+        }
+    }
+};
+
+fn exitNow(code: u8) void {
+    std.c._exit(code);
+}
