+        try std.testing.expectEqualDeep(h, try link.receiveHeader(wire.deadline(30_000)));
+    } else {
+        try std.testing.expectEqualDeep(h, try link.receiveHeader(wire.deadline(30_000)));
+        try link.sendHeader(h, wire.deadline(30_000));
+    }
+}
+
+/// Each --tp 2 message at decode and prompt row counts: back to back through the engine's owner (its peer check and
+/// polls), back to back straight to NCCL, and one call at a time with the stream drained after each.
+fn bench(gpu: check.Gpu, rank: usize, c: *flash.collective.Collective, stream: cuda.Stream, link: wire.Link) !void {
+    var most: usize = 0;
+    for (cases) |cs| for (bench_rows) |rows| {
