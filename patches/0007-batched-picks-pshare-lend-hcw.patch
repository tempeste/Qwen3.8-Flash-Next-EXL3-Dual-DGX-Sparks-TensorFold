+test "a draft pass frame round-trips and refuses a repeated slot, a wide step, a bad token and short ids" {
+    var raw: [max_bytes]u8 = undefined;
+    const a = [_]u32{ 5, 6, 7 };
+    const b = [_]u32{8};
+    const nexts = [_][]const u32{ &a, &b };
+    const bytes = try encode(&.{ 3, 0 }, &nexts, &raw);
+    try std.testing.expectEqual(@as(usize, 4 + 8 * 2 + 4 * 4), bytes.len);
+    var out: [max_lanes]Entry = undefined;
+    const got = try decode(bytes, true, &out);
+    try std.testing.expectEqual(@as(usize, 2), got.entries.len);
+    try std.testing.expectEqual(@as(usize, 3), got.entries[0].slot);
+    try std.testing.expectEqual(@as(usize, 3), got.entries[0].rows);
+    try std.testing.expectEqual(@as(usize, 4), got.total);
+    try std.testing.expectEqual(@as(u32, 8), std.mem.readInt(u32, got.ids[12..16], .little));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes, false, &out));
+    try std.testing.expect(shapeOk(.{ .kind = .draft_pass, .arg = 64, .flags = flag_absorb | flag_first, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .draft_pass, .arg = 64, .flags = flag_first, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .draft_pass, .arg = 64, .flags = 4, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .draft_pass, .arg = 0, .bytes = @intCast(bytes.len) }));
+    try std.testing.expect(!shapeOk(.{ .kind = .draft_pass, .object = 1, .arg = 64, .bytes = @intCast(bytes.len) }));
+    var spare: [max_bytes]u8 = undefined;
+    try std.testing.expectError(error.BadRankFrame, encode(&.{ 3, 3 }, &nexts, &spare));
+    try std.testing.expectError(error.BadRankFrame, encode(&.{ max_lanes, 0 }, &nexts, &spare));
+    var bad: [max_bytes]u8 = undefined;
+    @memcpy(bad[0..bytes.len], bytes);
+    std.mem.writeInt(u32, bad[bytes.len - 4 ..][0..4], wt.vocab, .little);
+    try std.testing.expectError(error.InvalidToken, decode(bad[0..bytes.len], true, &out));
+    try std.testing.expectError(error.BadRankFrame, decode(bytes[0 .. bytes.len - 4], true, &out));
