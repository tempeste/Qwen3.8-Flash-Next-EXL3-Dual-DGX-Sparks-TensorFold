+    const down = hc_w.down.native.?;
+    const sk = cuda.qmmf.splitK(down.n, down.k);
+    const blk = if (hw.blk == 0) n else hw.blk;
+    const up_v = hw.upAt(n);
+    var b0: usize = 0;
+    while (b0 < n) : (b0 += blk) {
+        const r = r0 + b0;
+        const m = @min(blk, n - b0);
+        try tk.hcfWbdn(&k.tiles, stream, wb - 1, mode, hw.wbc, s.h + r * wide * 2, s.pss + r * pss_n * 4, hc_w.scale.ptr, down.codes, s.hc_part, s.rinv + r * streams * 4, br + b0 * dims * 4, s.inj + r * streams * 2, rs, m, down.n, down.k, sk, dims, streams, eps);
+        try reduceUp(tri, k, stream, s, hc_w, r, m, up_v, true);
+    }
+}
+
+pub fn decodeTakes(hc_w: HcW, n: usize) bool {
+    if (n == 0 or n > tk.hcd_rows or !nativeFused(hc_w)) return false;
+    const pd = cuda.qmmf.planFor(n, hc_w.down.native.?, true);
+    const pu = cuda.qmmf.planFor(n, hc_w.up.native.?, true);
+    return !pd.fused and pd.sk <= 32 and (hc_w.down.native.?.k / cuda.qmmf.group) % pd.sk == 0 and pu.sk == 1 and low / cuda.qmmf.group == 5;
+}
+
+fn pickHcd(n: usize, name: [:0]const u8, all_rows: bool) usize {
+    const want = knobs.hc2Tile(name);
+    for (tk.hcd_mt, 0..) |mt, i| if (mt == want and (!all_rows or 16 * mt >= n)) return i;
+    for (tk.hcd_mt, 0..) |mt, i| if (16 * mt >= n) return i;
+    return tk.hcd_mt.len - 1;
+}
+
+pub fn readoutDecode(tri: anytype, k: *const Kernels, stream: cuda.Stream, s: *Scratch, hc_w: HcW, r0: usize, n: usize) !void {
+    const down = hc_w.down.native.?;
