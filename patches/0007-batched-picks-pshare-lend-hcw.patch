+template <int OP, int BM, int BN, int WN, int STAGES, bool F32>
+__device__ __forceinline__ void dtile_body(
+        const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ w, const uint8_t* __restrict__ bs,
+        const unsigned char* __restrict__ w2, const uint8_t* __restrict__ bs2, float scale, float scale2,
+        void* __restrict__ out, int M, int N, int K, int SK, int ldx, int group) {
+    using T = Tile<MXFP8, BM, BN, 1, WN, STAGES>;
+    constexpr bool GU = OP == DGU;
+    constexpr int TILE_BYTES = 64 * GS;
+    constexpr int TILE_S = 64 * 2;
+    constexpr int AU = BM * T::CHUNKS / T::THREADS;
+    constexpr int WU = T::W / 16 / T::THREADS;
+    constexpr int A_STEP = T::THREADS / T::CHUNKS;
+    constexpr int OUT_BN = GU ? BN / 2 : BN;
+    static_assert(BN % 64 == 0 && T::MT >= 1 && T::NT >= 1 && STAGES >= 2, "whole 64-column weight tiles, at least two stages");
+    static_assert(AU >= 1 && AU * T::THREADS == BM * T::CHUNKS && WU >= 1 && WU * T::THREADS == T::W / 16 &&
+                  T::S / 16 <= T::THREADS && A_STEP % T::CHUNKS == 0, "every thread feeds the same chunks each K group");
+    static_assert(!GU || (BN == 128 && T::THREADS == TILE_BYTES / 16 && WN % 2 == 0), "a gate and up block holds one tile of each");
+    extern __shared__ __align__(128) unsigned char buf[];
+    const int tid = threadIdx.x, lane = tid & 31, wn = tid >> 5;
+    const int KG = K / GS;
+    const int2 at = tile_of(blockIdx.x, M, N, BM, OUT_BN, group);
+    const int m0 = at.x, n0 = at.y;
+    const int last = (N + 63) / 64 - 1;
+
+    const int a_dst = (tid / T::CHUNKS) * T::ROW + swz<T::CHUNKS>(tid / T::CHUNKS, tid % T::CHUNKS) * 16;
+    int a_src[AU];
+    bool a_ok[AU];
+#pragma unroll
+    for (int u = 0; u < AU; ++u) {
+        const int r = tid / T::CHUNKS + u * A_STEP;
+        a_src[u] = min(m0 + r, M - 1) * ldx + (tid % T::CHUNKS) * 8;
+        a_ok[u] = m0 + r < M;
+    }
+    int w_src[WU];
+#pragma unroll
+    for (int u = 0; u < WU; ++u) {
+        const int c = tid + u * T::THREADS;
+        const int tc = GU ? n0 / 64 : min(n0 / 64 + c / (TILE_BYTES / 16), last);
+        w_src[u] = tc * KG * TILE_BYTES + (c % (TILE_BYTES / 16)) * 16;
+    }
+    const int s_t = tid / (TILE_S / 16);
+    const int s_src = (GU ? n0 / 64 : min(n0 / 64 + s_t, last)) * KG * TILE_S + (tid % (TILE_S / 16)) * 16;
