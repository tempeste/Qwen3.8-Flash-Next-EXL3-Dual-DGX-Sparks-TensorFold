+        forget(gpa, &cuts_of, &store);
+
+        const marks = try gpa.dupe(u32, full.items[0 .. full.items.len - 1]);
+        defer gpa.free(marks);
+        var cold_ran: std.ArrayList(u32) = .empty;
+        defer cold_ran.deinit(gpa);
+        var cold = try lanes.Stream.init(gpa, .{ .id = "cold", .prompt = toks, .max_new = reply, .reuse = .{ .marks = marks } });
+        defer cold.deinit(gpa);
+        _ = try fillBeside(&engine, &cold, 0, &cold_ran, gpa);
+        try check.expect(std.mem.eql(u32, cold_ran.items, full.items), "flashnext-pshare-ride: the cold prefill of turn {d} of conversation {d} took other passes ({any}) than the resumed one ({any}); the gate needs the same cuts", .{ t, c, cold_ran.items, full.items });
+        var want = try image(gpa, cu, &cold);
+        defer want.deinit(gpa);
+        try same("a turn resumed from a kept state beside decoders equals a cold prefill with the same passes", &got, &want);
+        while (!r.finished or !cold.finished) try engine.step();
+        if (std.mem.eql(u32, r.emitted(), cold.emitted())) same_tokens += 1;
+        checked += 1;
+
+        held_peak = @max(held_peak, store.held + store.orphans());
+        if (cu.engine.early.kept) |*rows| {
+            try check.expect(store.held + store.orphans() <= store.budget, "flashnext-pshare-ride: held and orphan bytes stay inside the budget", .{});
+            try check.expect(rows.held_bytes <= store.held + store.orphans(), "flashnext-pshare-ride: shared rows the store has not charged: {d} > {d}", .{ rows.held_bytes, store.held + store.orphans() });
+            for (store.entries.items) |x| {
+                const k: *Snap = @ptrCast(@alignCast(x.saved));
+                if (k.share) |sh| deepest = @max(deepest, share.Rows.depth(sh.top, @intCast(k.at)));
+            }
+        }
+    };
+    if (sharing and anchor_tokens > 0) {
+        try check.expect(anchors > 0, "flashnext-pshare-ride: no anchor was kept at a riding piece's end", .{});
+        try check.expect(past_head > 0, "flashnext-pshare-ride: no turn resumed past the shared head (the branch-point keep)", .{});
+    }
+    try restoreBench(gpu, cu, &store);
+    try copyBench(gpu, cu.stream);
+    while (engine.activeCount() > 0) try engine.step();
+    const grafts = if (cu.engine.early.kept) |*rows| rows.grafts else 0;
+    check.pass("share {}, anchors every {d}, beside {d} decoders with the head drafting: {d} turns byte-equal to cold prefills through the same riding passes (DeltaNet states, tail, keys, values, index blocks and head rows); first {d} tokens the same in {d}; resumed {d} ({d} from anchors, {d} past the shared head), prefilled {d} tokens; keeps {d}, anchors {d}; {d} states, peak {d} MiB of {d} MiB, deepest chain {d}, grafts {d}; evicted {d} (cheap {d}); anchors refused {d}", .{ sharing, anchor_tokens, decoders, checked, reply, same_tokens, resumed, from_anchor, past_head, prefilled, keeps, anchors, store.entries.items.len, held_peak >> 20, store.budget >> 20, deepest, grafts, store.counts.evicted, store.counts.evicted_anchor, store.counts.anchor_refused });
+}
diff --git a/zig/tests/cuda/flashnext_pshare_tests.zig b/zig/tests/cuda/flashnext_pshare_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..90a84ade4112460ba9cc1fa406f40ed7dc4938a4
--- /dev/null
+++ b/zig/tests/cuda/flashnext_pshare_tests.zig
@@ -0,0 +1,235 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const pc = @import("engine_api").prompt_cache;
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const knobs = flash.knobs;
+const Session = flash.rank_engine.Session;
+const Snap = flash.snap.Snap;
+const share = flash.snap.share;
+
+const context = 4096;
+const head = 600;
+const common = 1500;
+const convs = 5;
+const turns = 4;
+const piece = 256;
+const rewritten = 0;
+const rewrite_turn = 2;
+
+const Copies = struct {
+    session: *Session,
+
+    fn of(p: *anyopaque) *Copies {
+        return @ptrCast(@alignCast(p));
+    }
+    fn seqOf(owner: ?*anyopaque) !*prompt.Seq {
+        return @ptrCast(@alignCast(owner orelse return error.NoStream));
+    }
+    fn bytes(p: *anyopaque, at: u32) u64 {
+        const e = of(p).session.engine;
+        return flash.snap.bytesIn(e.kv, null, at, e.heads, e.index_window != 0);
+    }
+    fn added(p: *anyopaque, owner: ?*anyopaque, at: u32) u64 {
+        const rows = if (of(p).session.engine.early.kept) |*r| r else return bytes(p, at);
+        const q = seqOf(owner) catch return bytes(p, at);
+        if (!share.applies(q, null)) return bytes(p, at);
+        return share.added(rows, q, null, at);
+    }
+    fn charged(p: *anyopaque, saved: pc.Saved) u64 {
+        const kept: *Snap = @ptrCast(@alignCast(saved));
+        if (kept.share != null) return share.charged(kept);
+        return bytes(p, @intCast(kept.at));
+    }
+    fn orphans(p: *anyopaque) u64 {
+        return if (of(p).session.engine.early.kept) |*r| r.orphan_bytes else 0;
+    }
+    fn save(p: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const q = try seqOf(owner);
+        if (q.fed != at) return error.NotAtMark;
+        return @ptrCast(try of(p).session.save(q, null));
+    }
+    fn restore(p: *anyopaque, owner: ?*anyopaque, saved: pc.Saved) anyerror!void {
+        try of(p).session.restore(try seqOf(owner), null, @ptrCast(@alignCast(saved)));
+    }
+    fn drop(p: *anyopaque, saved: pc.Saved) void {
+        of(p).session.dropSaved(@ptrCast(@alignCast(saved)));
+    }
+    fn snapshots(c: *Copies) pc.Snapshots {
+        return .{ .ptr = c, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop, .charged = charged, .added = added, .orphans = orphans } };
+    }
+};
+
+const hooks: prompt.batch.Hooks = .{ .prompt = true };
+
+fn promptLen(c: usize, t: usize) usize {
+    return (if (c < 3) @as(usize, 900) else 1800) + 300 * t;
+}
+
+const longest = 1800 + 300 * (turns - 1);
+
+fn stream(out: []u32, ids: []const u32, c: usize) void {
+    for (out, 0..) |*t, i| {
+        const shared = if (c < 3) i < head else i < common;
+        t.* = if (shared) ids[i % ids.len] else ids[(i * 7 + c * 31 + 1) % ids.len];
+    }
+}
+
+fn replayCuts(session: *Session, toks: []const u32, tri: flash.Tri, cuts: []const u32) !prompt.Seq {
+    var r = try session.create(context);
+    errdefer session.drop(&r);
+    var pos: usize = 0;
+    for (cuts) |c| {
+        try session.forward(flash.Tri, tri, &r, toks[pos..c], hooks);
+        pos = c;
+    }
+    return r;
+}
+
+const Cuts = std.AutoHashMapUnmanaged(usize, []u32);
+
+fn remember(gpa: std.mem.Allocator, cuts_of: *Cuts, store: *const pc.Store, cuts: []const u32) !void {
+    const k = store.last_kept orelse return;
+    if (cuts_of.contains(@intFromPtr(k.saved))) return;
+    try cuts_of.put(gpa, @intFromPtr(k.saved), try gpa.dupe(u32, cuts));
+}
+
+fn forget(gpa: std.mem.Allocator, cuts_of: *Cuts, store: *const pc.Store) void {
+    var it = cuts_of.iterator();
+    while (it.next()) |kv| {
+        const live = for (store.entries.items) |x| {
+            if (@intFromPtr(x.saved) == kv.key_ptr.*) break true;
+        } else false;
+        if (!live) {
+            gpa.free(kv.value_ptr.*);
+            cuts_of.removeByPtr(kv.key_ptr);
+            it = cuts_of.iterator();
+        }
+    }
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const gpa = gpu.gpa;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpa, .limited(1 << 20));
+    defer gpa.free(source);
+    var ids: std.ArrayList(u32) = .empty;
+    defer ids.deinit(gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try ids.append(gpa, try std.fmt.parseInt(u32, word, 10));
+    if (ids.items.len < 16) return error.BadPrompt;
+    const sharing = try knobs.pcacheShare();
+    const anchor_tokens = try knobs.pcacheAnchorTokens();
+    var cuda_stream = try cuda.Stream.init(gpu.d, true);
+    defer cuda_stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = cuda_stream, .own = &glue };
+    const e = try prompt.Engine.initRank(gpa, gpu.io, @constCast(gpu.d), &cuda_stream, dir, 2, rank);
+    defer e.deinit();
+    const identity = try flash.rank_engine.identity(gpa, gpu.io, dir, context, e.chunk);
+    const session = try Session.init(gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    defer {
+        e.collective = null;
+        session.deinit();
+    }
+    session.engine = e;
+    e.collective = &session.collective;
+    if (knobs.tpRoce()) try session.collective.openRoce(gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed every save, restore and drop (share {}, anchors every {d})", .{ sharing, anchor_tokens });
+        return;
+    }
+    if (sharing != (e.early.kept != null)) return error.ShareNotLoaded;
+    var streams: [convs][longest]u32 = undefined;
+    for (&streams, 0..) |*s, c| stream(s, ids.items, c);
+    var copies: Copies = .{ .session = session };
+    const per_state = Copies.bytes(&copies, @intCast(longest));
+    var store = pc.Store.init(gpa, copies.snapshots(), .{ .lookahead = 1, .min_gap = 256, .min_prompt = 512 }, 4 * per_state);
+    store.share = sharing;
+    store.branch = sharing and anchor_tokens > 0;
+    var cuts_of: Cuts = .empty;
+    defer {
+        var it = cuts_of.valueIterator();
+        while (it.next()) |v| gpa.free(v.*);
+        cuts_of.deinit(gpa);
+        store.deinit();
+    }
+    var prefilled: u64 = 0;
+    var resumed: u64 = 0;
+    var checked: usize = 0;
+    var held_peak: u64 = 0;
+    var deepest: usize = 0;
+    for (0..turns) |t| for (0..convs) |c| {
+        if (c == rewritten and t == rewrite_turn) {
+            const from = promptLen(c, t - 1) - 400;
+            for (streams[c][from..], from..) |*x, i| x.* = ids.items[(i * 11 + 5) % ids.items.len];
+        }
+        const toks = streams[c][0..promptLen(c, t)];
+        const history: u32 = @intCast(toks.len - 3);
+        const shared_cut: u32 = if (c < 3) head else common;
+        const l = try store.lookupUser(gpa, toks, @intCast(toks.len), history, shared_cut + 3, if (t == 0) history else 0, &.{shared_cut}, &.{}, &.{});
+        defer gpa.free(l.marks);
+        var q = try session.create(context);
+        defer session.drop(&q);
+        var cuts: std.ArrayList(u32) = .empty;
+        defer cuts.deinit(gpa);
+        var pos: usize = 0;
+        if (l.entry) |entry| {
+            try session.restore(&q, null, @ptrCast(@alignCast(entry.saved)));
+            try cuts.appendSlice(gpa, cuts_of.get(@intFromPtr(entry.saved)) orelse return error.UnknownCuts);
+            pos = entry.at;
+            store.resumed(entry, toks, true);
+            resumed += 1;
+        }
+        prefilled += toks.len - pos;
+        var anchored = pos;
+        for (l.marks) |m| {
+            if (m <= pos) continue;
+            while (anchor_tokens > 0 and m - pos > piece) {
+                const stop = pos + piece;
+                try session.forward(flash.Tri, tri, &q, toks[pos..stop], hooks);
+                try cuts.append(gpa, @intCast(stop));
+                pos = stop;
+                if (stop - anchored >= anchor_tokens and store.keepAnchor(toks, @intCast(toks.len), @intCast(stop), &q, &.{}, &.{})) {
+                    anchored = stop;
+                    try remember(gpa, &cuts_of, &store, cuts.items);
+                }
+            }
+            try session.forward(flash.Tri, tri, &q, toks[pos..m], hooks);
+            try cuts.append(gpa, m);
+            pos = m;
+            if (store.keep(toks, m, &q, &.{}, &.{})) {
+                anchored = m;
+                try remember(gpa, &cuts_of, &store, cuts.items);
+            }
+        }
+        forget(gpa, &cuts_of, &store);
+        if (pos < toks.len) {
+            try session.forward(flash.Tri, tri, &q, toks[pos..], hooks);
+            try cuts.append(gpa, @intCast(toks.len));
+        }
+        held_peak = @max(held_peak, store.held + store.orphans());
+        if (e.early.kept) |*rows| {
+            try check.expect(store.held + store.orphans() <= store.budget, "held and orphan bytes stay inside the budget", .{});
+            try check.expect(rows.held_bytes <= store.held + store.orphans(), "shared rows the store has not charged: {d} > {d}", .{ rows.held_bytes, store.held + store.orphans() });
+            for (store.entries.items) |x| {
+                const k: *Snap = @ptrCast(@alignCast(x.saved));
+                if (k.share) |sh| deepest = @max(deepest, share.Rows.depth(sh.top, @intCast(k.at)));
+            }
+        }
+        var r = try replayCuts(session, toks, tri, cuts.items);
+        defer session.drop(&r);
+        try check.sameBytes("a turn resumed from the kept state equals a cold prefill with the same passes", q.logits, r.logits);
+        try check.expect(std.mem.eql(i64, &q.history, &r.history), "n-gram history after the resumed turn matches the cold prefill", .{});
+        const next = ids.items[(t * 5 + c) % ids.items.len];
+        try session.forward(flash.Tri, tri, &q, &.{next}, hooks);
+        try session.forward(flash.Tri, tri, &r, &.{next}, hooks);
+        try check.sameBytes("the row after a resumed turn equals the cold prefill's", q.logits, r.logits);
+        checked += 1;
+    };
+    check.pass("share {}, anchors every {d}: {d} turns byte-equal to cold prefills; resumed {d}, prefilled {d} tokens; {d} states, peak {d} MiB of {d} MiB, deepest chain {d}; evicted {d} (cheap {d}, superseded {d}, idle {d}); anchors {d}, refused {d}", .{ sharing, anchor_tokens, checked, resumed, prefilled, store.entries.items.len, held_peak >> 20, store.budget >> 20, deepest, store.counts.evicted, store.counts.evicted_anchor, store.counts.evicted_superseded, store.counts.evicted_idle, store.counts.anchors, store.counts.anchor_refused });
+}
diff --git a/zig/tests/cuda/flashnext_route_beside_tests.zig b/zig/tests/cuda/flashnext_route_beside_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..60a743f5f2f44bd153618e4e175a00d29a09d320
--- /dev/null
+++ b/zig/tests/cuda/flashnext_route_beside_tests.zig
@@ -0,0 +1,133 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+
+const knob = "TF_FLASHNEXT_TP_ROUTE_BESIDE";
+const passes = [_]usize{ 1536, 2048, 3072 };
+const reps = 5;
+
+const Arm = struct { name: []const u8, on: bool };
+const arms = [_]Arm{ .{ .name = "off", .on = false }, .{ .name = "route-beside", .on = true } };
+
+const Case = enum { pass, next };
+const cases = std.enums.values(Case);
+
+fn cachedChunks(chunk: usize) !usize {
+    const want = if (std.c.getenv("TF_ROUTE_BESIDE_TEST_CACHED")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else 81920;
+    return std.math.divCeil(usize, @max(want, 1), chunk) catch unreachable;
+}
+
+fn setArm(a: Arm) void {
+    _ = env.setenv(knob, if (a.on) "1" else "0", 1);
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const knobs = flash.knobs;
+    const given = try knobs.tpRouteBeside();
+    defer _ = env.setenv(knob, if (given) "1" else "0", 1);
+    if (!try knobs.tpSplitSum() or !try knobs.tpSeqPar()) {
+        std.debug.print("FAIL flashnext-route-beside needs TF_FLASHNEXT_TP_SEQPAR=1 and TF_FLASHNEXT_TP_SPLIT_SUM=1 on both ranks\n", .{});
+        return error.TestFailed;
+    }
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const cached = chunk * try cachedChunks(chunk);
+    var longest: usize = 0;
+    for (passes) |n| if (n <= chunk) {
+        longest = @max(longest, n);
+    };
+    if (longest == 0) {
+        std.debug.print("FAIL flashnext-route-beside needs a solo chunk of 1536 rows or more (TF_FLASHNEXT_CHUNK_SOLO=3072)\n", .{});
+        return error.TestFailed;
+    }
+    const context = cached + longest + 64;
+    if (context > prompt.max_tokens) return error.BadPrompt;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, cached + longest + 1);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*a, i| a.* = seed.items[i % seed.items.len];
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    setArm(arms[0]);
+    const e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank);
+    defer e.deinit();
+    if (e.chunk != chunk) return error.EngineChunk;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    const row = prompt.vocabulary * 2;
+    var want: [passes.len][cases.len][]u8 = undefined;
+    for (&want) |*w| for (w) |*r| {
+        r.* = try gpu.gpa.alloc(u8, row);
+    };
+    defer for (want) |w| for (w) |r| gpu.gpa.free(r);
+    var ms: [arms.len][passes.len]f64 = @splat(@splat(0));
+    var compared: usize = 0;
+    for (arms, 0..) |a, ai| {
+        setArm(a);
+        const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port + @as(u16, @intCast(ai)), rank, identity, flash.rank_engine.linkWait());
+        defer {
+            e.collective = null;
+            session.deinit();
+        }
+        session.engine = e;
+        e.collective = &session.collective;
+        if (knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+        if (rank == 1) {
+            try session.follow(flash.Tri, tri, logits.ptr);
+            check.pass("rank 1 followed the {s} arm", .{a.name});
+            continue;
+        }
+        var q = try session.create(context);
+        defer session.drop(&q);
+        var at: usize = 0;
+        while (at < cached) : (at += chunk) try session.forward(flash.Tri, tri, &q, ids[at .. at + chunk], .{ .logits = .none, .prompt = true });
+        const kept = try session.save(&q, null);
+        defer session.dropSaved(kept);
+        for (passes, 0..) |n, pi| {
+            if (n > chunk) continue;
+            var t: [reps]f64 = undefined;
+            for (0..reps + 1) |r| {
+                try session.restore(&q, null, kept);
+                const t0 = check.now(gpu.io);
+                try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true });
+                if (r > 0) t[r - 1] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+                if (r != 1) continue;
+                try compare(ai, a.name, n, .pass, q.logits, &want[pi], &compared);
+                try session.forward(flash.Tri, tri, &q, ids[cached + n ..][0..1], .{});
+                try compare(ai, a.name, n, .next, q.logits, &want[pi], &compared);
+            }
+            ms[ai][pi] = check.median(&t);
+        }
+    }
+    if (rank == 1) return;
+    try check.expect(compared > 0, "no flag-on row was compared", .{});
+    std.debug.print("RESULT flashnext-route-beside {d} rows compared byte for byte\n", .{compared});
+    for (passes, 0..) |n, pi| {
+        if (n > chunk) continue;
+        const f = @as(f64, @floatFromInt(n));
+        std.debug.print("RESULT flashnext-route-beside-bench cached {d} rows {d}: off {d:.2} ms, on {d:.2} ms, saves {d:.2} ms ({d:.1}%); per 3072-row chunk off {d:.2} on {d:.2} ms; per 1536-row pass off {d:.2} on {d:.2} ms; median of {d}\n", .{ cached, n, ms[0][pi], ms[1][pi], ms[0][pi] - ms[1][pi], 100.0 * (ms[0][pi] - ms[1][pi]) / ms[0][pi], 3072.0 / f * ms[0][pi], 3072.0 / f * ms[1][pi], 1536.0 / f * ms[0][pi], 1536.0 / f * ms[1][pi], reps });
+    }
+}
+
+fn compare(ai: usize, name: []const u8, n: usize, c: Case, got: []const u8, want: *[cases.len][]u8, compared: *usize) !void {
+    const slot = want[@backingInt(c)];
+    if (ai == 0) {
+        @memcpy(slot, got);
+        return;
+    }
+    try check.sameBytes(@tagName(c), got, slot);
+    compared.* += 1;
+    check.pass("{s} arm, {d} rows: {s} row equals the off arm's byte for byte", .{ name, n, @tagName(c) });
+}
diff --git a/zig/tests/cuda/flashnext_seqpar_exact_tests.zig b/zig/tests/cuda/flashnext_seqpar_exact_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..77c55174fbf16c73b6ea2a4627eae0ded84ef0dc
--- /dev/null
+++ b/zig/tests/cuda/flashnext_seqpar_exact_tests.zig
@@ -0,0 +1,176 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+
+const exact_knob = "TF_FLASHNEXT_TP_SEQPAR_EXACT";
+const overlap_knob = "TF_FLASHNEXT_TP_SUM_OVERLAP";
+const rows_knob = "TF_FLASHNEXT_TP_SEQPAR_MIN_ROWS";
+const passes = [_]usize{ 300, 512, 700, 993, 1000, 1535, 1536, 3072 };
+const bench_rows = 1000;
+const tail = 7;
+const reps = 5;
+
+const Arm = struct { name: []const u8, exact: bool, overlap: bool };
+const arms = [_]Arm{
+    .{ .name = "off", .exact = false, .overlap = false },
+    .{ .name = "sum-overlap", .exact = false, .overlap = true },
+    .{ .name = "seqpar-exact", .exact = true, .overlap = false },
+    .{ .name = "seqpar-exact+sum-overlap", .exact = true, .overlap = true },
+};
+
+const Case = enum { pass, next, mark_tail, mark_next };
+const cases = std.enums.values(Case);
+
+fn cachedChunks(chunk: usize) !usize {
+    const want = if (std.c.getenv("TF_SEQPAR_EXACT_TEST_CACHED")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else 81920;
+    return std.math.divCeil(usize, @max(want, 1), chunk) catch unreachable;
+}
+
+fn setArm(a: Arm) void {
+    _ = env.setenv(exact_knob, if (a.exact) "1" else "0", 1);
+    _ = env.setenv(overlap_knob, if (a.overlap) "1" else "0", 1);
+}
+
+const Shape = struct { seqpar: bool, split: bool, bf16: bool };
+
+fn shapeOf(n: usize) !Shape {
+    const k = flash.knobs;
+    const ss = flash.split_sum;
+    const min_half = ss.minHalf();
+    const split = ss.takes(true, false, true, true, 0, false, n, min_half);
+    const seqpar = flash.seq_par.takes(true, false, true, true, 0, false, n, min_half, true);
+    return .{ .seqpar = seqpar, .split = split, .bf16 = seqpar and flash.seq_par.peerBf16(try k.tpScatterBf16(), try k.tpSeqParExact(), split, n) };
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const knobs = flash.knobs;
+    const exact_given = try knobs.tpSeqParExact();
+    const overlap_given = try knobs.tpSumOverlap();
+    const rows_given: ?[:0]const u8 = if (std.c.getenv(rows_knob)) |v| std.mem.span(v) else null;
+    defer {
+        _ = env.setenv(exact_knob, if (exact_given) "1" else "0", 1);
+        _ = env.setenv(overlap_knob, if (overlap_given) "1" else "0", 1);
+        if (rows_given) |v| _ = env.setenv(rows_knob, v, 1);
+    }
+    if (!try knobs.tpSeqPar() or !try knobs.tpSplitSum()) {
+        std.debug.print("FAIL flashnext-seqpar-exact needs TF_FLASHNEXT_TP_SEQPAR=1 and TF_FLASHNEXT_TP_SPLIT_SUM=1 on both ranks\n", .{});
+        return error.TestFailed;
+    }
+    _ = env.unsetenv(rows_knob);
+    const bf16 = try knobs.tpScatterBf16();
+    const marks = (try knobs.markInPass()) > 0;
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const cached = chunk * try cachedChunks(chunk);
+    var longest: usize = 0;
+    for (passes) |n| if (n <= chunk) {
+        longest = @max(longest, n);
+    };
+    const context = cached + longest + 64;
+    if (context > prompt.max_tokens) return error.BadPrompt;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, cached + longest + 1);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*a, i| a.* = seed.items[i % seed.items.len];
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    setArm(arms[0]);
+    const e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank);
+    defer e.deinit();
+    if (e.chunk != chunk) return error.EngineChunk;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    const row = prompt.vocabulary * 2;
+    var want: [passes.len][cases.len][]u8 = undefined;
+    for (&want) |*w| for (w) |*r| {
+        r.* = try gpu.gpa.alloc(u8, row);
+    };
+    defer for (want) |w| for (w) |r| gpu.gpa.free(r);
+    var ms: [arms.len][passes.len]f64 = @splat(@splat(0));
+    var compared: usize = 0;
+    var exact_seqpar: usize = 0;
+    for (arms, 0..) |a, ai| {
+        setArm(a);
+        const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port + @as(u16, @intCast(ai)), rank, identity, flash.rank_engine.linkWait());
+        defer {
+            e.collective = null;
+            session.deinit();
+        }
+        session.engine = e;
+        e.collective = &session.collective;
+        if (knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+        if (rank == 1) {
+            try session.follow(flash.Tri, tri, logits.ptr);
+            check.pass("rank 1 followed the {s} arm", .{a.name});
+            continue;
+        }
+        var q = try session.create(context);
+        defer session.drop(&q);
+        var at: usize = 0;
+        while (at < cached) : (at += chunk) try session.forward(flash.Tri, tri, &q, ids[at .. at + chunk], .{ .logits = .none, .prompt = true });
+        const kept = try session.save(&q, null);
+        defer session.dropSaved(kept);
+        for (passes, 0..) |n, pi| {
+            if (n > chunk) continue;
+            const shape = try shapeOf(n);
+            if (a.exact and shape.seqpar and n < knobs.split_sum_min_rows) exact_seqpar += 1;
+            var t: [reps]f64 = undefined;
+            for (0..reps + 1) |r| {
+                try session.restore(&q, null, kept);
+                const t0 = check.now(gpu.io);
+                try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true });
+                if (r > 0) t[r - 1] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+                if (r != 1) continue;
+                try compare(ai, a.name, n, shape, .pass, q.logits, &want[pi], &compared);
+                try session.forward(flash.Tri, tri, &q, ids[cached + n ..][0..1], .{});
+                try compare(ai, a.name, n, shape, .next, q.logits, &want[pi], &compared);
+            }
+            ms[ai][pi] = check.median(&t);
+            if (!marks or n <= tail) continue;
+            try session.restore(&q, null, kept);
+            try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true, .mark = n - tail });
+            const marked = try session.saveAt(&q, null, cached + n - tail);
+            defer session.dropSaved(marked);
+            try session.restore(&q, null, marked);
+            try session.forward(flash.Tri, tri, &q, ids[cached + n - tail .. cached + n], .{ .logits = .last, .prompt = true });
+            try compare(ai, a.name, n, shape, .mark_tail, q.logits, &want[pi], &compared);
+            try session.forward(flash.Tri, tri, &q, ids[cached + n ..][0..1], .{});
+            try compare(ai, a.name, n, shape, .mark_next, q.logits, &want[pi], &compared);
+        }
+    }
+    if (rank == 1) return;
+    try check.expect(compared > 0, "no flag-on row was compared", .{});
+    try check.expect(exact_seqpar > 0, "no pass under {d} rows took the exact seqpar path (check TF_FLASHNEXT_HC2_MIN <= 256, TF_FLASHNEXT_TP_FUSE_REDUCE=2, TF_FLASHNEXT_TP_MOE_PARTIAL=1)", .{flash.knobs.split_sum_min_rows});
+    std.debug.print("RESULT flashnext-seqpar-exact {d} rows compared byte for byte against the off arm; {d} exact-arm passes under {d} rows exchanged rows (scatter_bf16 {d}, marks {s})\n", .{ compared, exact_seqpar, flash.knobs.split_sum_min_rows, @intFromBool(bf16), if (marks) "on" else "off" });
+    for (passes, 0..) |n, pi| {
+        if (n > chunk) continue;
+        const per = 1536.0 / @as(f64, @floatFromInt(n));
+        for (arms[1..], 1..) |a, ai| std.debug.print("RESULT flashnext-seqpar-exact-bench cached {d} rows {d} arm {s}: off {d:.2} ms, on {d:.2} ms, saves {d:.2} ms ({d:.1}%); per 1536-row chunk-equivalent off {d:.2} on {d:.2} ms; median of {d}\n", .{ cached, n, a.name, ms[0][pi], ms[ai][pi], ms[0][pi] - ms[ai][pi], 100.0 * (ms[0][pi] - ms[ai][pi]) / ms[0][pi], per * ms[0][pi], per * ms[ai][pi], reps });
+    }
+    for (passes, 0..) |n, pi| if (n == bench_rows and n <= chunk) {
+        std.debug.print("RESULT flashnext-seqpar-exact-pf1000 cached {d} rows {d}: off {d:.2} ms, sum-overlap {d:.2}, seqpar-exact {d:.2}, both {d:.2}; seqpar-exact saves {d:.2} ms alone and {d:.2} ms over sum-overlap\n", .{ cached, n, ms[0][pi], ms[1][pi], ms[2][pi], ms[3][pi], ms[0][pi] - ms[2][pi], ms[1][pi] - ms[3][pi] });
+    };
+}
+
+fn compare(ai: usize, name: []const u8, n: usize, shape: Shape, c: Case, got: []const u8, want: *[cases.len][]u8, compared: *usize) !void {
+    const slot = want[@backingInt(c)];
+    if (ai == 0) {
+        @memcpy(slot, got);
+        return;
+    }
+    try check.sameBytes(@tagName(c), got, slot);
+    compared.* += 1;
+    check.pass("{s} arm, {d} rows (seqpar {s}, split {s}, bf16 peer {s}): {s} row equals the off arm's byte for byte", .{ name, n, if (shape.seqpar) "on" else "off", if (shape.split) "on" else "off", if (shape.bf16) "on" else "off", @tagName(c) });
+}
