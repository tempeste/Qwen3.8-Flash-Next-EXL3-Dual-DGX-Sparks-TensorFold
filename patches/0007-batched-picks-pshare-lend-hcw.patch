+
+fn pickShadowed(s: *const pc.Store, skip: ?*pc.Entry, prompt: []const u32, among: Among) ?usize {
+    var best: ?usize = null;
+    for (s.entries.items, 0..) |e, i| {
+        if (!among_(e, among) or e.borrowers > 0 or e == skip or e.shared or e.branched or e.expired) continue;
+        if (best != null and e.used >= s.entries.items[best.?].used) continue;
+        if (rewindOn(s, e, prompt) or !keeping.shadowed(s, e)) continue;
+        best = i;
+    }
+    return best;
+}
+
+fn pickValue(s: *const pc.Store, skip: ?*pc.Entry, prompt: []const u32, among: Among) ?usize {
+    var best: ?usize = null;
+    var best_worth: f64 = 0;
+    var best_rewind = false;
+    for (s.entries.items, 0..) |e, i| {
+        if (!among_(e, among) or e.borrowers > 0 or e == skip) continue;
+        const rewind = rewindOn(s, e, prompt);
+        const w = keeping.worth(s, e);
+        if (best == null or (if (rewind != best_rewind) best_rewind else w < best_worth)) {
+            best = i;
+            best_worth = w;
+            best_rewind = rewind;
+        }
+    }
+    return best;
+}
