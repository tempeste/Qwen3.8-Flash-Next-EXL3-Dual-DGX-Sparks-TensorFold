+template <int MT, bool F32, bool CLUSTER>
+__device__ __forceinline__ void dec_body(const __nv_bfloat16* __restrict__ x, const unsigned char* __restrict__ w,
+                                         const uint8_t* __restrict__ bs, float scale, void* __restrict__ out, int M, int N,
