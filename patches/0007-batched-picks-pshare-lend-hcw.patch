+    return share.rowBytes(rows, seq, head_format, at);
 }
 
 test "an fp8 state's bytes: the DeltaNet's and the n-gram tail as in bf16, then 1,056 + 256 bytes a layer and token" {
diff --git a/zig/src/families/flashnext/cuda_snap_early.zig b/zig/src/families/flashnext/cuda_snap_early.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5d0f22bfd73c11503ab989b925a242208c5e5982
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_snap_early.zig
@@ -0,0 +1,185 @@
+//! A prompt-cache keep's work moved off the mark (cuda_snap.zig takes and fills the copy):
+//! - TF_FLASHNEXT_SNAP_EARLY=1: the keep's buffer is allocated while the marked pass still runs on the device (after the
+//!   host has queued its last layer, before it waits for it), so the save at the mark only copies. The same buffer of the
+//!   same bytes: no byte of the copy changes.
+//! - TF_FLASHNEXT_MARK_IN_PASS=N: a mark at most N rows before the end of the pass that would stop at it is no longer a
+//!   cut. The pass runs on past it and stores, at the mark's row, each DeltaNet layer's state and conv window and the
+//!   n-gram tail in `Early.cap`; the keep then takes those with the attention rows before the mark. The tail rows after
+//!   the mark run in the big pass instead of a pass of their own, so their bits are an unmarked prompt's, not today's.
+//! One `Early` an engine: one spare buffer and one captured mark at a time, each for the next keep only.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const sizes = @import("cuda_seq_bytes.zig");
+const Heads = @import("cuda_heads.zig").Heads;
+
+const tail_bytes = wt.ple_tail_n * wt.wide * 2;
+
+/// Where a pass stores a mark's states: each DeltaNet layer's conv window and state, then the n-gram tail.
+pub const Bufs = struct {
+    base: u64,
+    heads: Heads,
+
+    pub fn conv(b: Bufs, li: usize) u64 {
+        return b.base + li * sizes.convBytes(b.heads);
+    }
+
+    pub fn state(b: Bufs, li: usize) u64 {
+        return b.base + wt.linear_n * sizes.convBytes(b.heads) + li * sizes.stateBytes(b.heads);
+    }
+
+    pub fn tail(b: Bufs) u64 {
+        return b.base + wt.linear_n * (sizes.convBytes(b.heads) + sizes.stateBytes(b.heads));
+    }
+};
+
+/// Bytes of a mark's captured states at heads `h`: a state's DeltaNet pieces and its n-gram tail.
+pub fn capBytes(h: Heads) usize {
+    return wt.linear_n * (sizes.convBytes(h) + sizes.stateBytes(h)) + tail_bytes;
+}
+
+/// The mark a pass captured: its sequence, position and n-gram history, and the sequence's position after the pass.
+pub const Mark = struct {
+    seq: usize,
+    at: usize,
+    fed: usize,
+    history: [2]i64,
+
+    /// Whether this capture is `seq`'s state at `at`, the sequence still where the capturing pass left it.
+    pub fn of(m: Mark, seq: *const anyopaque, at: usize, fed: usize) bool {
+        return m.seq == @intFromPtr(seq) and m.at == at and m.fed == fed and at < fed;
+    }
+};
+
+/// The n-gram history (the last two tokens) after `ids` from `before`, as the pass's gather moves it.
+pub fn historyAfter(before: [2]i64, ids: []const u32) [2]i64 {
+    var h = before;
+    for (ids) |t| {
+        h[0] = h[1];
+        h[1] = t;
+    }
+    return h;
+}
+
+pub const Early = struct {
+    kept: ?@import("cuda_snap_share.zig").Rows = null,
+    spare: ?cuda.DeviceBuffer = null,
+    spare_rows: ?cuda.DeviceBuffer = null,
+    cap: ?cuda.DeviceBuffer = null,
+    cap_heads: Heads = .full,
+    mark: ?Mark = null,
+
+    /// The next keep's buffer of `bytes`, allocated now; a failed allocation leaves none (the keep allocates its own
+    /// and fails or skips as it does today).
+    pub fn reserve(e: *Early, d: *const cuda.Driver, bytes: usize, rows: usize) void {
+        e.reserveRows(d, rows);
+        if (e.spare) |b| if (b.len == bytes) return;
+        if (e.spare) |*b| b.free();
+        e.spare = cuda.DeviceBuffer.alloc(d, bytes) catch null;
+    }
+
+    fn reserveRows(e: *Early, d: *const cuda.Driver, rows: usize) void {
+        if (e.spare_rows) |b| if (b.len == rows) return;
+        if (e.spare_rows) |*b| b.free();
+        e.spare_rows = if (rows == 0) null else cuda.DeviceBuffer.alloc(d, rows) catch null;
+    }
+
+    pub fn takeRows(e: *Early, bytes: usize) ?cuda.DeviceBuffer {
+        const b = e.spare_rows orelse return null;
+        e.spare_rows = null;
+        if (b.len == bytes) return b;
+        var x = b;
+        x.free();
+        return null;
+    }
+
+    /// The spare buffer if it has exactly `bytes`; a spare of other bytes is freed.
+    pub fn take(e: *Early, bytes: usize) ?cuda.DeviceBuffer {
+        const b = e.spare orelse return null;
+        e.spare = null;
+        if (b.len == bytes) return b;
+        var x = b;
+        x.free();
+        return null;
+    }
+
+    pub fn drop(e: *Early) void {
+        if (e.spare) |*b| b.free();
+        e.spare = null;
+        if (e.spare_rows) |*b| b.free();
+        e.spare_rows = null;
+    }
+
+    /// The capture buffers at heads `h`, allocated at the first marked pass and kept for the engine's life.
+    pub fn bufs(e: *Early, d: *const cuda.Driver, h: Heads) !Bufs {
+        if (e.cap != null and !e.cap_heads.eql(h)) {
+            e.cap.?.free();
+            e.cap = null;
+        }
+        if (e.cap == null) {
+            e.cap = try cuda.DeviceBuffer.alloc(d, capBytes(h));
+            e.cap_heads = h;
+        }
+        return .{ .base = e.cap.?.ptr, .heads = h };
+    }
+
+    /// The captured mark if it is `seq`'s state at `at`, `seq` standing at `fed`.
+    pub fn marked(e: *const Early, seq: *const anyopaque, at: usize, fed: usize) ?Bufs {
+        const m = e.mark orelse return null;
+        if (!m.of(seq, at, fed)) return null;
+        const c = e.cap orelse return null;
+        return .{ .base = c.ptr, .heads = e.cap_heads };
+    }
+
+    pub fn deinit(e: *Early) void {
+        if (e.kept) |*r| if (r.live() == 0) r.deinit();
+        e.drop();
+        if (e.cap) |*b| b.free();
+        e.cap = null;
+        e.mark = null;
+    }
+};
+
+/// A forward frame's `arg` (--tp 2): bit 0 reserve the keep's buffer (SNAP_EARLY), bit 1 capture a mark
+/// (MARK_IN_PASS), and from bit 2 the mark's row in the frame's rows (the rows themselves for a cut at the end).
+pub const FrameArg = struct {
+    reserve: bool = false,
+    capture: bool = false,
+    row: usize = 0,
+
+    pub fn encode(a: FrameArg) u64 {
+        if (!a.reserve and !a.capture) return 0;
+        return @as(u64, a.row) << 2 | @as(u64, @intFromBool(a.capture)) << 1 | @intFromBool(a.reserve);
+    }
+
+    /// `arg` of a forward of `rows` rows, refused unless this rank turned on what it asks (`early`, `in_pass`).
+    pub fn decode(arg: u64, rows: usize, early: bool, in_pass: bool) !FrameArg {
+        if (arg == 0) return .{};
+        const a: FrameArg = .{ .reserve = arg & 1 != 0, .capture = arg & 2 != 0, .row = @intCast(arg >> 2) };
+        if (!a.reserve and !a.capture) return error.BadRankFrame;
+        if ((a.reserve and !early) or (a.capture and !in_pass)) return error.BadRankFrame;
+        if (a.row == 0 or a.row > rows or (a.capture and a.row == rows)) return error.BadRankFrame;
+        return a;
+    }
+};
+
+test "a forward frame's arg carries the reserve and capture bits and the mark's row, and refuses what this rank did not turn on" {
+    const both: FrameArg = .{ .reserve = true, .capture = true, .row = 993 };
+    try std.testing.expectEqual(both, try FrameArg.decode(both.encode(), 1000, true, true));
+    try std.testing.expectEqual(@as(u64, 0), (FrameArg{ .row = 5 }).encode());
+    try std.testing.expectEqual(FrameArg{}, try FrameArg.decode(0, 1000, false, false));
+    const cut: FrameArg = .{ .reserve = true, .row = 993 };
+    try std.testing.expectEqual(cut, try FrameArg.decode(cut.encode(), 993, true, false));
+    try std.testing.expectError(error.BadRankFrame, FrameArg.decode(cut.encode(), 993, false, false));
+    try std.testing.expectError(error.BadRankFrame, FrameArg.decode(both.encode(), 1000, true, false));
+    try std.testing.expectError(error.BadRankFrame, FrameArg.decode((FrameArg{ .capture = true, .row = 1000 }).encode(), 1000, true, true));
+    try std.testing.expectError(error.BadRankFrame, FrameArg.decode((FrameArg{ .reserve = true, .row = 1001 }).encode(), 1000, true, true));
+    try std.testing.expectError(error.BadRankFrame, FrameArg.decode(1 << 2, 1000, true, true));
+    try std.testing.expectError(error.BadRankFrame, FrameArg.decode(1, 1000, true, true));
+}
+
+test "a mark's history is the last two tokens before it, as the gather moves it" {
+    try std.testing.expectEqual([2]i64{ 7, 8 }, historyAfter(.{ 1, 2 }, &.{ 5, 6, 7, 8 }));
+    try std.testing.expectEqual([2]i64{ 2, 9 }, historyAfter(.{ 1, 2 }, &.{9}));
+    try std.testing.expectEqual([2]i64{ 1, 2 }, historyAfter(.{ 1, 2 }, &.{}));
+}
diff --git a/zig/src/families/flashnext/cuda_snap_share.zig b/zig/src/families/flashnext/cuda_snap_share.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fcfda25ee8f2635eaa91cf61fbbb4625054da9d0
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_snap_share.zig
@@ -0,0 +1,326 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const sizes = @import("cuda_seq_bytes.zig");
+const Heads = @import("cuda_heads.zig").Heads;
+const Kv = @import("cuda_kv.zig").Kv;
+const Draft = @import("cuda_mtp_draft.zig").Draft;
+const index_window = @import("cuda_index_window.zig");
+const early = @import("cuda_snap_early.zig");
+const snaps = @import("cuda_snap.zig");
+const kept_rows = @import("engine_api").prompt_cache.kept_rows;
+
+pub const Rows = kept_rows.Rows(cuda.DeviceBuffer);
+pub const Seg = Rows.Seg;
+pub const Base = kept_rows.Base;
+pub const Shared = struct { rows: *Rows, top: *Seg, created: bool };
+
+const index_row = wt.index_dim * 2;
+const tail_bytes = wt.ple_tail_n * wt.wide * 2;
+const head_heads: Heads = .full;
+const most_segments = 4096;
+
+pub const copy_ns_estimate: u64 = 5 * std.time.ns_per_us;
+pub const chain_restore_ns: u64 = 5 * std.time.ns_per_ms;
+
+pub fn segmentCopies(window: bool) usize {
+    const ps = pieces(.nvfp4, .bf16, .full, window);
+    var n: usize = 0;
+    for (ps.p[0..ps.len]) |p| n += p.layers;
+    return n;
+}
+
+pub fn fixedCopies(window: bool) usize {
+    return 2 * wt.linear_n + 1 + if (window) wt.attn_n else 0;
+}
+
+pub fn chainCap(window: bool) u32 {
+    return @intCast(1 + chain_restore_ns / (segmentCopies(window) * copy_ns_estimate));
+}
+
+pub fn rowsFor(gpa: std.mem.Allocator) Rows {
+    var r = Rows.init(gpa);
+    r.chain_cap = chainCap(false);
+    return r;
+}
+
+pub fn form(head: ?Kv, window: bool) u8 {
+    const h: u8 = if (head) |k| 1 + @as(u8, @intFromEnum(k)) else 0;
+    return h | @as(u8, if (window) 0x80 else 0);
+}
+
+pub fn fixedBytes(at: usize, h: Heads, window: bool) usize {
+    const carry = if (window) index_window.carry(at).count * index_row * wt.attn_n else 0;
+    return wt.linear_n * (sizes.convBytes(h) + sizes.stateBytes(h)) + tail_bytes + carry;
+}
+
+const Part = enum { key, value, raw, pooled };
+
+pub const Piece = struct { part: Part, head: bool, layers: usize, row: usize, per: usize };
+
+pub const Pieces = struct { p: [8]Piece, len: usize };
+
+pub fn pieces(format: Kv, head: ?Kv, h: Heads, window: bool) Pieces {
+    var out: Pieces = .{ .p = undefined, .len = 0 };
+    add(&out, format, false, wt.attn_n, h, window);
+    if (head) |f| add(&out, f, true, 1, head_heads, false);
+    return out;
+}
+
+fn add(out: *Pieces, format: Kv, head: bool, layers: usize, h: Heads, window: bool) void {
+    const kv = format.keyRow() / wt.kv_heads * h.kv;
+    const vv = format.valueRow() / wt.kv_heads * h.kv;
+    out.p[out.len] = .{ .part = .key, .head = head, .layers = layers, .row = kv, .per = 1 };
+    out.p[out.len + 1] = .{ .part = .value, .head = head, .layers = layers, .row = vv, .per = 1 };
+    out.len += 2;
+    if (!window) {
+        out.p[out.len] = .{ .part = .raw, .head = head, .layers = layers, .row = index_row, .per = 1 };
+        out.len += 1;
+    }
+    out.p[out.len] = .{ .part = .pooled, .head = head, .layers = layers, .row = index_row, .per = wt.index_ratio };
+    out.len += 1;
+}
+
+fn first(p: Piece, lo: usize) usize {
+    return lo / p.per;
+}
+
+fn count(p: Piece, lo: usize, hi: usize) usize {
+    return hi / p.per - lo / p.per;
+}
+
+pub fn segBytes(format: Kv, head: ?Kv, lo: usize, hi: usize, h: Heads, window: bool) usize {
+    const ps = pieces(format, head, h, window);
+    var n: usize = 0;
+    for (ps.p[0..ps.len]) |p| n += p.layers * count(p, lo, hi) * p.row;
+    return n;
+}
+
+pub fn added(rows: *const Rows, seq: *const prompt.Seq, head: ?Kv, at: usize) usize {
+    return fixedBytes(at, seq.heads, seq.window.on()) + rowBytes(rows, seq, head, at);
+}
+
+pub fn rowBytes(rows: *const Rows, seq: *const prompt.Seq, head: ?Kv, at: usize) usize {
+    return switch (rows.step(seq.kept, @intCast(at), form(head, seq.window.on()))) {
+        .cold => segBytes(seq.kv, head, 0, at, seq.heads, seq.window.on()),
+        .reuse => 0,
+        .extend => |x| segBytes(seq.kv, head, x.lo, at, seq.heads, seq.window.on()),
+    };
+}
+
+pub fn applies(seq: *const prompt.Seq, d: ?*const Draft) bool {
+    if (seq.paged != null) return false;
+    if (d) |x| if (x.pg.pt != 0) return false;
+    return true;
+}
+
+pub fn take(gpa: std.mem.Allocator, driver: *const cuda.Driver, seq: *const prompt.Seq, d: ?*const Draft, at: usize, history: [2]i64, spare: *early.Early, rows: *Rows) !*snaps.Snap {
+    const window = seq.window.on();
+    const head: ?Kv = if (d) |x| x.kv else null;
+    const fm = form(head, window);
+    const n = fixedBytes(at, seq.heads, window);
+    var buf = spare.take(n) orelse try cuda.DeviceBuffer.alloc(driver, n);
+    errdefer buf.free();
+    const st = rows.step(seq.kept, @intCast(at), fm);
+    const Pick = struct { top: *Seg, created: bool };
+    const pick: Pick = switch (st) {
+        .reuse => |x| reuse: {
+            rows.retain(x);
+            break :reuse .{ .top = x, .created = false };
+        },
+        .cold, .extend => fresh: {
+            const prev: ?*Seg = if (st == .extend) st.extend.prev else null;
+            const lo: usize = if (st == .extend) st.extend.lo else 0;
+            const bytes = segBytes(seq.kv, head, lo, at, seq.heads, window);
+            var rb = spare.takeRows(bytes) orelse try cuda.DeviceBuffer.alloc(driver, bytes);
+            errdefer rb.free();
+            const made = try rows.make(prev, @intCast(lo), @intCast(at), bytes, fm, rb);
+            rows.noteGraft(st, seq.kept);
+            break :fresh .{ .top = made, .created = true };
+        },
+    };
+    const top = pick.top;
+    const created = pick.created;
+    errdefer release(rows, top, created);
+    const snap = try gpa.create(snaps.Snap);
+    snap.* = .{ .buf = buf, .at = at, .history = history, .head = d != null, .heads = seq.heads, .kv = seq.kv, .head_kv = head orelse .bf16, .window = window, .share = .{ .rows = rows, .top = top, .created = created } };
+    return snap;
+}
+
+fn freeSeg(_: void, b: cuda.DeviceBuffer) void {
+    var x = b;
+    x.free();
+}
+
+fn release(rows: *Rows, top: *Seg, created: bool) void {
+    rows.release(top, created, {}, freeSeg);
+}
+
+pub fn charged(snap: *const snaps.Snap) u64 {
+    const sh = snap.share.?;
+    return snap.buf.len + if (sh.created) sh.top.bytes else 0;
+}
+
+const Way = enum { save, restore };
+
+fn lane(seq: *prompt.Seq, d: ?*Draft, p: Piece, layer: usize) cuda.DeviceBuffer {
+    if (p.head) {
+        const x = d.?;
+        return switch (p.part) {
+            .key => x.kc,
+            .value => x.vc,
+            .raw => x.ikc,
+            .pooled => x.pooled,
+        };
+    }
+    return switch (p.part) {
+        .key => seq.kc[layer],
+        .value => seq.vc[layer],
+        .raw => seq.ikc[layer],
+        .pooled => seq.pooled[layer],
+    };
+}
+
+fn copy(stream: cuda.Stream, dst: u64, src: u64, n: usize) !void {
+    if (n == 0) return;
+    const dr = stream.d;
+    try dr.check(dr.api.cuMemcpyDtoDAsync_v2(dst, src, n, stream.handle), "cuMemcpyDtoDAsync");
+}
+
+fn moveRows(stream: cuda.Stream, seq: *prompt.Seq, d: ?*Draft, seg: *const Seg, upto: usize, way: Way) !void {
+    const head: ?Kv = if (seg.form & 0x7f != 0) @enumFromInt((seg.form & 0x7f) - 1) else null;
+    if (way == .save and head != null and d == null) return error.SnapShape;
+    const window = seg.form & 0x80 != 0;
+    if (window != seq.window.on()) return error.SnapShape;
+    const ps = pieces(seq.kv, head, seq.heads, window);
+    var off: u64 = 0;
+    for (ps.p[0..ps.len]) |p| {
+        if (p.head and d == null) {
+            off += p.layers * count(p, seg.lo, seg.hi) * p.row;
+            continue;
+        }
+        for (0..p.layers) |layer| {
+            const b = lane(seq, d, p, layer);
+            const at_row: u64 = first(p, seg.lo) * p.row;
+            const n = count(p, seg.lo, if (way == .save) seg.hi else upto) * p.row;
+            const dst, const src = if (way == .save) .{ seg.data.ptr + off, b.ptr + at_row } else .{ b.ptr + at_row, seg.data.ptr + off };
+            try copy(stream, dst, src, n);
+            off += count(p, seg.lo, seg.hi) * p.row;
+        }
+    }
+    std.debug.assert(off == seg.bytes);
+}
+
+fn moveFixed(stream: cuda.Stream, seq: *prompt.Seq, base: u64, at: usize, way: Way, mark: ?early.Bufs) !void {
+    if (mark) |m| if (!m.heads.eql(seq.heads)) return error.SnapShape;
+    var off: u64 = 0;
+    const conv = sizes.convBytes(seq.heads);
+    const state = sizes.stateBytes(seq.heads);
+    for (seq.conv, 0..) |b, layer| {
+        const live = if (mark) |m| m.conv(layer) else b.ptr;
+        try copy(stream, if (way == .save) base + off else b.ptr, if (way == .save) live else base + off, conv);
+        off += conv;
+    }
+    for (seq.state, 0..) |b, layer| {
+        const live = if (mark) |m| m.state(layer) else b.ptr;
+        try copy(stream, if (way == .save) base + off else b.ptr, if (way == .save) live else base + off, state);
+        off += state;
+    }
+    const tail = if (mark) |m| m.tail() else seq.tail.ptr;
+    try copy(stream, if (way == .save) base + off else seq.tail.ptr, if (way == .save) tail else base + off, tail_bytes);
+    off += tail_bytes;
+    if (seq.window.on()) {
+        const c = index_window.carry(at);
+        for (seq.ikc, 0..) |b, layer| {
+            const n = c.count * index_row;
+            if (way == .save) {
+                const row = try index_window.carryRow(seq.window.rows, seq.window.base[layer], at);
+                try copy(stream, base + off, b.ptr + row * index_row, n);
+            } else try copy(stream, b.ptr, base + off, n);
+            off += n;
+        }
+        if (way == .restore) seq.window.base = @splat(c.first);
+    }
+    std.debug.assert(off == fixedBytes(at, seq.heads, seq.window.on()));
+}
+
+pub fn fill(stream: cuda.Stream, seq: *prompt.Seq, d: ?*Draft, snap: *snaps.Snap, src: snaps.Src) !void {
+    const sh = snap.share.?;
+    const split = src.split;
+    if (!split) if (d) |x| try x.joinSide(stream);
+    try moveFixed(stream, seq, snap.buf.ptr, snap.at, .save, src.mark);
+    if (split) if (d) |x| try x.joinSide(stream);
+    if (sh.created) try moveRows(stream, seq, d, sh.top, sh.top.hi, .save);
+    try stream.synchronize();
+    if (sh.created) seq.kept = .{ .id = sh.top.id, .valid = sh.top.hi };
+}
+
+pub fn restore(stream: cuda.Stream, seq: *prompt.Seq, d: ?*Draft, snap: *const snaps.Snap) !void {
+    const sh = snap.share.?;
+    if (d) |x| try x.joinSide(stream);
+    try moveFixed(stream, seq, snap.buf.ptr, snap.at, .restore, null);
+    var limit = snap.at;
+    var s: ?*const Seg = sh.top;
+    var n: usize = 0;
+    while (s) |x| : (s = x.prev) {
+        if (limit <= x.lo) continue;
+        n += 1;
+        if (n > most_segments) return error.RowsChainLong;
+        try moveRows(stream, seq, d, x, @min(x.hi, limit), .restore);
+        limit = x.lo;
+    }
+    if (limit != 0) return error.RowsGap;
+    if (!(@import("cuda_knobs.zig").restoreAsync() catch false)) try stream.synchronize();
+    seq.history = snap.history;
+    seq.fed = snap.at;
