+        try decNewReduce(c, inj, 0);
+        try decNewUp(c, inj, 4);
+        c.rows = 1000;
+        try c.wideDown(1);
+        try c.reduce();
+        try c.wideUp(0);
+        try c.wideUpGrid(0, dt);
+        try r.s.synchronize();
+        return;
+    }
+    const Case = struct { r0: usize, m: usize };
+    const cases = [_]Case{ .{ .r0 = 0, .m = 1 }, .{ .r0 = 0, .m = 2 }, .{ .r0 = 0, .m = 15 }, .{ .r0 = 0, .m = 16 }, .{ .r0 = 0, .m = 17 }, .{ .r0 = 0, .m = 28 }, .{ .r0 = 0, .m = 33 }, .{ .r0 = 0, .m = 56 }, .{ .r0 = 0, .m = 64 }, .{ .r0 = 0, .m = 65 }, .{ .r0 = 0, .m = 74 }, .{ .r0 = 0, .m = 84 }, .{ .r0 = 0, .m = 96 }, .{ .r0 = 7, .m = 28 }, .{ .r0 = 1000, .m = 84 }, .{ .r0 = 2990, .m = 56 } };
+    for (cases) |k| for ([_]Dec{ inj, plain }) |w| {
