+__device__ __forceinline__ void wbdn_body(__nv_bfloat16* H, float* PSS, const float* __restrict__ SCALE,
+                                          const uint2* __restrict__ W, float* __restrict__ PART, float* __restrict__ RINV,
+                                          const float* __restrict__ BR, const __nv_bfloat16* __restrict__ INJ, long long RS,
+                                          int M, int N, int K, int SK, int D, int NC, int SS, float eps) {
+#if __CUDA_ARCH__ < 900
+    __trap();
+#else
+    using A = DaShape<MT, 2, 5>;
+    using S = WbShape<MT>;
+    constexpr int BM = S::BM, T = S::T, WARPS = S::WARPS, RPC = S::RPC, STAGES = 5, NSL = A::NSL;
+    extern __shared__ __align__(128) unsigned char buf[];
+    float* rinv_s = reinterpret_cast<float*>(buf + S::BODY);
+    float* red = reinterpret_cast<float*>(buf + S::PARTIALS);
+    auto cluster = cooperative_groups::this_cluster();
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5, g8 = lane >> 2, t4 = lane & 3;
+    const int KG = K / 64, per = KG / SK, slice = static_cast<int>(cluster.block_rank()), g0 = slice * per;
+    const int ct = warp / DN_WARPS, wl = warp % DN_WARPS;
+    const int s_lo = (g0 * 64) / D, s_hi = ((g0 + per) * 64 - 1) / D;
+    const int units = RPC * NC * 8, tiles = (M + BM - 1) / BM;
+    if (SK != WB_SLICES || SS != 4 || NC * 4 > WB_CELLS || units > WARPS * per * UPS) __trap();
+    unsigned short* hb = reinterpret_cast<unsigned short*>(H);
+    const float* oth32 = BR + RS;
+    const unsigned short* oth16 = reinterpret_cast<const unsigned short*>(BR + RS);
+
+    auto unit_at = [&](int t, int u, int& row, int& col, int& cell) {
+        const int rr = u / (NC * 8), c = (u >> 3) % NC;
+        row = t * BM + slice * RPC + rr;
+        col = c * 256 + (u & 7) * 32;
+        cell = rr * NC + c;
+    };
+    auto fetch = [&](int row, int d, WbUnit& x) {
+        const size_t rd = static_cast<size_t>(row) * D + d;
+        x.own = __ldcg(BR + rd);
+        if constexpr (MODE == 5) x.oth = bf(__ushort_as_bfloat16(__ldcg(oth16 + rd)));
+        else x.oth = __ldcg(oth32 + rd);
+        x.inj = __ldcg(reinterpret_cast<const uint2*>(INJ + static_cast<size_t>(row) * 4));
+        const size_t hr = static_cast<size_t>(row) * 4 * D + d;
+#pragma unroll
+        for (int s = 0; s < 4; ++s) x.h[s] = __ldcg(hb + hr + static_cast<size_t>(s) * D);
+    };
+    auto apply = [&](int row, int d, int cell, int w, const WbUnit& x) {
+        const float branch = rbf(__fadd_rn(x.own, x.oth));
+        const __nv_bfloat16* inj = reinterpret_cast<const __nv_bfloat16*>(&x.inj);
+        const size_t hr = static_cast<size_t>(row) * 4 * D + d;
+#pragma unroll
+        for (int s = 0; s < 4; ++s) {
+            const float hv = rbf(__fmaf_rn(branch, bf(inj[s]), bf(__ushort_as_bfloat16(x.h[s]))));
+            hb[hr + static_cast<size_t>(s) * D] = __bfloat16_as_ushort(__float2bfloat16_rn(hv));
+            const float ss = tf_glue::warp_sum(__fmul_rn(hv, hv));
+            if (lane == 0) red[(cell * 4 + s) * 8 + w] = ss;
+        }
+    };
+    auto prefetch = [&](int t, int step) {
+        const int k = lane / 6, j = lane % 6;
+        if (k >= UPS) return;
+        const int u = (step * UPS + k) * WARPS + warp;
+        if (u >= units) return;
+        int row, col, cell;
+        unit_at(t, u, row, col, cell);
+        if (row >= M) return;
+        const size_t rd = static_cast<size_t>(row) * D + col;
+        const void* p;
+        if (j < 4) p = hb + static_cast<size_t>(row) * 4 * D + static_cast<size_t>(j) * D + col;
+        else if (j == 4) p = BR + rd;
+        else if constexpr (MODE == 5) p = oth16 + rd;
+        else p = oth32 + rd;
+        asm volatile("prefetch.global.L2 [%0];\n" ::"l"(p));
+    };
+    auto run_units = [&](int t, int step) {
+        if constexpr (MT > 2) {
+#pragma unroll 1
+            for (int k = 0; k < UPS; ++k) {
+                const int u = (step * UPS + k) * WARPS + warp;
+                if (u >= units) return;
+                int row, col, cell;
+                unit_at(t, u, row, col, cell);
+                if (row >= M) return;
+                WbUnit x;
+                fetch(row, col + lane, x);
+                apply(row, col + lane, cell, u & 7, x);
+            }
+        } else {
+            int u = (step * UPS) * WARPS + warp;
+            int row = 0, col = 0, cell = 0;
+            WbUnit x = {};
+            bool have = false;
+            if (u < units) {
+                unit_at(t, u, row, col, cell);
+                if (row < M) {
+                    fetch(row, col + lane, x);
+                    have = true;
+                }
+            }
+#pragma unroll
+            for (int k = 0; k < UPS; ++k) {
+                const int un = u + WARPS;
+                int rown = 0, coln = 0, celln = 0;
+                WbUnit y = {};
+                bool next = false;
+                if (k + 1 < UPS && un < units) {
+                    unit_at(t, un, rown, coln, celln);
+                    if (rown < M) {
+                        fetch(rown, coln + lane, y);
+                        next = true;
+                    }
+                }
+                if (have) apply(row, col + lane, cell, u & 7, x);
+                u = un;
+                row = rown;
+                col = coln;
+                cell = celln;
+                x = y;
+                have = next;
+            }
+        }
+    };
+    auto finish_pss = [&](int t) {
+        for (int i = tid; i < RPC * NC * 4; i += T) {
+            const int row = t * BM + slice * RPC + i / (NC * 4);
+            if (row >= M) continue;
+            float total = 0.0f;
+            for (int w = 0; w < 8; ++w) total = __fadd_rn(total, red[i * 8 + w]);
+            PSS[static_cast<size_t>(row) * NC * 4 + i % (NC * 4)] = total;
+        }
+    };
+
+    const uint2* wp[3];
+    bool valid[3];
+#pragma unroll
+    for (int j = 0; j < 3; ++j) {
+        const int n8 = ct * DN_SPLIT + wl * 3 + j;
+        valid[j] = n8 * 8 < N && (ct == 1 || n8 < DN_SPLIT);
+        wp[j] = W + static_cast<size_t>(n8 >> 3) * KG * 1024 + (n8 & 7) * 128 + lane;
+    }
+
+    int t = blockIdx.x;
+    if (t >= tiles) return;
+    prefetch(t, 0);
+    for (int step = 0; step * UPS * WARPS < units; ++step) {
+        prefetch(t, step + 1);
+        run_units(t, step);
+    }
+    __syncthreads();
+    finish_pss(t);
+    __threadfence();
+    cluster.sync();
+
+    for (; t < tiles; t += gridDim.x) {
+        const int tn = t + gridDim.x, m0 = t * BM;
+        const bool more = tn < tiles;
+        for (int i = tid; i < BM * SS; i += T) {
+            const int st = i % SS, r = m0 + i / SS;
+            if (st >= s_lo && st <= s_hi) {
+                const float v = rinv_cg(PSS, min(r, M - 1), st, NC, SS, D, eps);
+                rinv_s[(i / SS) * DN_SS + st] = v;
+                if (RINV != nullptr && r < M && st * D >= g0 * 64 && st * D < (g0 + per) * 64) RINV[static_cast<size_t>(r) * SS + st] = v;
+            }
+        }
+        auto stage = [&](int s) { return buf + s * A::STAGE; };
+        auto load = [&](int s, int g) {
+            unsigned char* p = stage(s);
+            for (int c = tid; c < BM * 8; c += T) {
+                const int r = c >> 3, ch = c & 7, row = min(m0 + r, M - 1);
+                cp16z(p + r * 128 + swz<8>(r, ch) * 16, H + static_cast<size_t>(row) * K + g * 64 + ch * 8, m0 + r < M);
+            }
+        };
+        auto loadb = [&](int g, uint2 (&b)[3][4]) {
+#pragma unroll
+            for (int j = 0; j < 3; ++j)
+#pragma unroll
+                for (int kt = 0; kt < 4; ++kt) b[j][kt] = valid[j] ? __ldg(wp[j] + static_cast<size_t>(g) * 1024 + kt * 32) : make_uint2(0u, 0u);
+        };
+        auto norm_slot = [&](unsigned char* p, int g, int j) {
+            const int c = tid + j * T;
+            if (c >= BM * 8) return;
+            const int r = c >> 3, ch = c & 7;
+            uint4* cell = reinterpret_cast<uint4*>(p + r * 128 + swz<8>(r, ch) * 16);
+            const uint4 raw = *cell;
+            const __nv_bfloat16* hv = reinterpret_cast<const __nv_bfloat16*>(&raw);
+            const float rv = rinv_s[r * DN_SS + (g * 64) / D];
+            const float4 sa = __ldg(reinterpret_cast<const float4*>(SCALE + g * 64 + ch * 8));
+            const float4 sb = __ldg(reinterpret_cast<const float4*>(SCALE + g * 64 + ch * 8 + 4));
+            const float sv[8] = {sa.x, sa.y, sa.z, sa.w, sb.x, sb.y, sb.z, sb.w};
+            __nv_bfloat16 o8[8];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) o8[i] = __float2bfloat16_rn(__fmul_rn(__fmul_rn(bf(hv[i]), rv), sv[i]));
+            *cell = *reinterpret_cast<const uint4*>(o8);
+        };
+
+        float acc[MT][3][4];
+#pragma unroll
+        for (int i = 0; i < MT; ++i)
+#pragma unroll
+            for (int j = 0; j < 3; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) acc[i][j][e] = 0.0f;
+
+#pragma unroll
+        for (int s = 0; s < STAGES - 1; ++s) {
+            if (s < per) load(s, g0 + s);
+            commit();
+        }
+        uint2 bufa[3][4], bufb[3][4];
+        loadb(g0, bufa);
+        if (more) prefetch(tn, 0);
+        wait<STAGES - 2>();
+        __syncthreads();
+#pragma unroll
+        for (int j = 0; j < NSL; ++j) norm_slot(stage(0), g0, j);
+
+        auto body = [&](int it, uint2 (&cur)[3][4], uint2 (&nxt)[3][4]) {
+            wait<STAGES - 3>();
+            __syncthreads();
+            if (it + STAGES - 1 < per) load((it + STAGES - 1) % STAGES, g0 + it + STAGES - 1);
+            commit();
+            if (it + 1 < per) loadb(g0 + it + 1, nxt);
+            if (more && it + 1 < per) prefetch(tn, it + 1);
+            const unsigned char* p = stage(it % STAGES);
+            unsigned char* q = stage((it + 1) % STAGES);
+            const bool ahead = it + 1 < per;
+#pragma unroll
+            for (int kt = 0; kt < 4; ++kt) {
+                uint32_t a[MT][4];
+#pragma unroll
+                for (int i = 0; i < MT; ++i) {
+                    const int r = i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
+                    const int ch = kt * 2 + (lane >> 4);
+                    ldmatrix4(a[i], p + r * 128 + swz<8>(r, ch) * 16);
+                }
+#pragma unroll
+                for (int j = 0; j < 3; ++j)
+                    if (valid[j]) {
+#pragma unroll
+                        for (int i = 0; i < MT; ++i) mma(acc[i][j], a[i], cur[j][kt].x, cur[j][kt].y);
+                    }
+                if (ahead) {
+#pragma unroll
+                    for (int j = kt; j < NSL; j += 4) norm_slot(q, g0 + it + 1, j);
+                }
+            }
+            if (more) run_units(tn, it);
+        };
+        for (int it = 0; it < per; it += 2) {
+            body(it, bufa, bufb);
+            if (it + 1 < per) body(it + 1, bufb, bufa);
+        }
+        wait<0>();
+        __syncthreads();
+        if (more) finish_pss(tn);
+        __syncthreads();
+
+        float2* mine = reinterpret_cast<float2*>(buf);
+#pragma unroll
+        for (int i = 0; i < MT; ++i)
+#pragma unroll
+            for (int j = 0; j < 3; ++j)
+#pragma unroll
+                for (int h = 0; h < 2; ++h) mine[((i * 3 + j) * 2 + h) * T + tid] = make_float2(acc[i][j][2 * h], acc[i][j][2 * h + 1]);
+        __threadfence();
+        cluster.sync();
+        for (int f = slice; f < A::SLOTS; f += SK) {
+            const int i = f / 6, j = (f >> 1) % 3, h = f & 1;
+            const int n8 = ct * DN_SPLIT + wl * 3 + j;
+            const int row = m0 + i * 16 + g8 + h * 8, col = n8 * 8 + 2 * t4;
+            if (n8 * 8 >= N || (ct == 0 && n8 >= DN_SPLIT) || row >= M) continue;
+            float2 v = cluster.map_shared_rank(mine, 0)[f * T + tid];
+            for (int peer = 1; peer < SK; ++peer) {
+                const float2 x = cluster.map_shared_rank(mine, peer)[f * T + tid];
+                v.x = __fadd_rn(v.x, x.x);
+                v.y = __fadd_rn(v.y, x.y);
+            }
+            float* dst = PART + static_cast<size_t>(row) * N + col;
+            if (col + 1 < N) {
+                if ((N & 1) == 0) *reinterpret_cast<float2*>(dst) = v;
+                else {
+                    dst[0] = v.x;
+                    dst[1] = v.y;
+                }
+            } else if (col < N) dst[0] = v.x;
+        }
+        cluster.sync();
+    }
+#endif
+}
+
+template <int MT, int KG>
+struct DpShape {
+    using U = UpShape<MT, KG>;
+    static constexpr int HB = MT <= 5 ? 2 : 1;
+    static constexpr int MX = U::BM * 32 * 2;
+    static constexpr int SMEM = U::A + HB * U::HS + MX + U::RV;
+};
+
+template <int MT, int KG>
+__device__ __forceinline__ void upmix_dp_body(const __nv_bfloat16* __restrict__ ACT, const uint2* __restrict__ W,
+                                              const __nv_bfloat16* __restrict__ H, const float* __restrict__ RINV,
+                                              const float* __restrict__ SCALE, const __nv_bfloat16* __restrict__ SIG,
+                                              __nv_bfloat16* __restrict__ MIXED, float* __restrict__ XSM, int M, int D) {
+    using U = UpShape<MT, KG>;
+    using S = DpShape<MT, KG>;
+    constexpr int BM = U::BM, K = U::K, SS = 4;
+    extern __shared__ __align__(128) unsigned char buf[];
+    unsigned char* As = buf;
+    unsigned char* hbase = buf + U::A;
+    __nv_bfloat16* mixed_s = reinterpret_cast<__nv_bfloat16*>(hbase + S::HB * U::HS);
+    float* rinv_s = reinterpret_cast<float*>(hbase + S::HB * U::HS + S::MX);
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5, g8 = lane >> 2, t4 = lane & 3;
+    const int dt = D / 32;
+    const int sw = warp >> 1, q0 = (warp & 1) * 2;
+    if (M > BM) __trap();
+
+    auto h_of = [&](int n) { return hbase + (S::HB == 2 ? (n & 1) : 0) * U::HS; };
+    auto issue_h = [&](int item, int n) {
+        const int d0 = item * 32;
+        unsigned char* Hb = h_of(n);
+        for (int c = tid; c < BM * SS * 4; c += 256) {
+            const int r = c / (SS * 4), s = (c >> 2) % SS, q = c & 3, row = min(r, M - 1);
+            cp16z(Hb + ((r * SS + s) * 32 + q * 8) * 2, H + static_cast<size_t>(row) * (SS * D) + s * D + d0 + q * 8, r < M);
+        }
+    };
+    uint2 b[KG][4][2];
+    float scv[2][2];
+    auto load_w = [&](int item) {
+        const int d0 = item * 32;
+#pragma unroll
+        for (int j = 0; j < 2; ++j) {
+            const int c8 = sw * D + d0 + (q0 + j) * 8;
+            const uint2* wp = W + static_cast<size_t>(c8 >> 6) * KG * 1024 + ((c8 >> 3) & 7) * 128 + lane;
+#pragma unroll
+            for (int g = 0; g < KG; ++g)
+#pragma unroll
+                for (int kt = 0; kt < 4; ++kt) b[g][kt][j] = __ldg(wp + g * 1024 + kt * 32);
+        }
+    };
+    auto load_scale = [&](int item) {
+        const int d0 = item * 32;
+#pragma unroll
+        for (int j = 0; j < 2; ++j)
+#pragma unroll
+            for (int c = 0; c < 2; ++c) scv[j][c] = __ldg(SCALE + sw * D + d0 + (q0 + j) * 8 + 2 * t4 + c);
+    };
+
+    int item = blockIdx.x;
+    if (item >= dt) return;
+    for (int c = tid; c < BM * (K / 8); c += 256) {
+        const int r = c / (K / 8), cc = c % (K / 8), g = cc >> 3, ch = cc & 7, row = min(r, M - 1);
+        cp16z(As + r * (K * 2) + g * 128 + swz<8>(r, ch) * 16, ACT + static_cast<size_t>(row) * K + cc * 8, r < M);
+    }
+    for (int c = tid; c < BM; c += 256) cp16z(rinv_s + c * SS, RINV + static_cast<size_t>(min(c, M - 1)) * SS, c < M);
+    issue_h(item, 0);
+    commit();
+    load_w(item);
+    load_scale(item);
+
+    for (int n = 0; item < dt; ++n, item += gridDim.x) {
+        const int d0 = item * 32, next = item + gridDim.x;
+        wait<0>();
+        __syncthreads();
+        float acc[MT][2][4];
+#pragma unroll
+        for (int i = 0; i < MT; ++i)
+#pragma unroll
+            for (int j = 0; j < 2; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) acc[i][j][e] = 0.0f;
+#pragma unroll
+        for (int g = 0; g < KG; ++g)
+#pragma unroll
+            for (int kt = 0; kt < 4; ++kt) {
+                uint32_t a[MT][4];
+#pragma unroll
+                for (int i = 0; i < MT; ++i) {
+                    const int r = i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
+                    const int ch = kt * 2 + (lane >> 4);
+                    ldmatrix4(a[i], As + r * (K * 2) + g * 128 + swz<8>(r, ch) * 16);
+                }
+#pragma unroll
+                for (int j = 0; j < 2; ++j)
+#pragma unroll
+                    for (int i = 0; i < MT; ++i) mma(acc[i][j], a[i], b[g][kt][j].x, b[g][kt][j].y);
+            }
+        if (next < dt) load_w(next);
+        if (S::HB == 2 && next < dt) issue_h(next, n + 1);
+        commit();
+        __nv_bfloat16* hp = reinterpret_cast<__nv_bfloat16*>(h_of(n));
+#pragma unroll
+        for (int i = 0; i < MT; ++i)
+#pragma unroll
+            for (int j = 0; j < 2; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) {
+                    const int rr = i * 16 + g8 + 8 * (e >> 1), dd = (q0 + j) * 8 + 2 * t4 + (e & 1);
+                    __nv_bfloat16* cell = hp + (rr * SS + sw) * 32 + dd;
+                    const float nv = rbf(__fmul_rn(__fmul_rn(bf(*cell), rinv_s[rr * SS + sw]), scv[j][e & 1]));
+                    *cell = __float2bfloat16_rn(rbf(__fmul_rn(sig_of(SIG, acc[i][j][e]), nv)));
+                }
+        __syncthreads();
+        for (int e = tid; e < BM * 32; e += 256) {
+            const int rr = e >> 5, dd = e & 31;
+            float total = 0.0f;
+#pragma unroll
+            for (int s = 0; s < SS; ++s) total = __fadd_rn(total, bf(hp[(rr * SS + s) * 32 + dd]));
+            const float m = rbf(__fdiv_rn(total, static_cast<float>(SS)));
+            mixed_s[e] = __float2bfloat16_rn(m);
+            if (rr < M) MIXED[static_cast<size_t>(rr) * D + d0 + dd] = __float2bfloat16_rn(m);
+        }
+        __syncthreads();
+        if (tid < BM && tid < M) {
+            float sum = 0.0f;
+            for (int k = 0; k < 32; ++k) sum = __fadd_rn(sum, bf(mixed_s[tid * 32 + k]));
+            XSM[static_cast<size_t>(tid) * dt + d0 / 32] = sum;
+        }
+        if (S::HB == 1 && next < dt) issue_h(next, n + 1);
+        commit();
+        if (next < dt) load_scale(next);
+    }
+    wait<0>();
+}
+
