+    const slices = try back(c.r, f32, c.spart, sk * m * w.nd);
+    const flat_y = try back(c.r, f32, c.up, m * w.nd);
+    try decOld(c, w, 0);
+    const folded = try back(c.r, f32, c.part, m * w.nd);
+    try check.sameBytes("decode: the lane's slices folded apart = in its cluster", std.mem.sliceAsBytes(flat_y), std.mem.sliceAsBytes(folded));
+    const want = try DecOuts.of(c, w);
