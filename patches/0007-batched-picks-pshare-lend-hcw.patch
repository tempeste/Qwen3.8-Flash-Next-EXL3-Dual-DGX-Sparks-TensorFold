+
+pub fn lendSetting(value: ?[]const u8) error{BadLend}!usize {
+    const v = value orelse return 0;
+    if (std.mem.eql(u8, v, "0")) return 0;
+    for (lend_sizes) |b| {
+        var buf: [8]u8 = undefined;
+        if (std.mem.eql(u8, v, std.fmt.bufPrint(&buf, "{d}", .{b}) catch unreachable)) return b;
