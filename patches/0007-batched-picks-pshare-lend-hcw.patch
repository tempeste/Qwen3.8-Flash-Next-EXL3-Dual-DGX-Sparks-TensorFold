+    const ttft = (first - mix_send_ms) / 1000;
+    return .{ .ttft = ttft, .prefill = @as(f64, @floatFromInt(mix_long)) / ttft, .decode = s.mix_tokens / ttft, .gap99 = quantile(s.gaps.items, 0.99) };
