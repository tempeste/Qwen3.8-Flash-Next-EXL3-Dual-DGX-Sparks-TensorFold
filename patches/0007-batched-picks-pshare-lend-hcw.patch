+    const deep = try s.lookupUser(gpa, cont, 6000, 5990, 0, 0, &.{}, &.{}, &.{});
+    defer gpa.free(deep.marks);
+    try std.testing.expectEqual(@as(u32, 5000), deep.entry.?.at);
+    s.release(deep.entry.?);
+    try std.testing.expectEqual(@as(u64, 3), s.explained.counts.shallow);
+}
+
+test "pcache keeping: block chains tell a prefix exactly as comparing the tokens does" {
+    const gpa = std.testing.allocator;
+    const keeping = @import("prompt_cache_keeping.zig");
+    var buf: [2000]u32 = undefined;
+    const p = convo(&buf, 1, 0);
+    for ([_]usize{ 1, 255, 256, 257, 511, 512, 1000 }) |n| for ([_]bool{ false, true }) |differ| {
+        var q: [2000]u32 = undefined;
+        @memcpy(&q, p);
+        if (differ) q[n - 1] +%= 1;
+        var short: pc.Entry = .{ .tokens = p[0..n], .at = @intCast(n - 1), .saved = undefined, .bytes = 0, .born = 0, .used = 0, .last = &.{} };
+        var long: pc.Entry = .{ .tokens = &q, .at = 1999, .saved = undefined, .bytes = 0, .born = 0, .used = 0, .last = &.{} };
+        short.chain = try keeping.chain(gpa, short.tokens);
+        defer gpa.free(short.chain);
+        long.chain = try keeping.chain(gpa, long.tokens);
+        defer gpa.free(long.chain);
+        try std.testing.expectEqual(!differ, keeping.prefixOf(&short, &long));
+        try std.testing.expect(!keeping.prefixOf(&long, &short));
+    };
+}
