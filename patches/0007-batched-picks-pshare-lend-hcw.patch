+        std.debug.print("RESULT hc-decode prompt rows {d}: down {d:.1} us + reduce_act {d:.1} us + up+mix {d:.1} us = {d:.2} ms a pass of 96 read-outs; with the dimension-tile grid up+mix {d:.1} us, {d:.2} ms a pass ({d:.2} ms saved)\n", .{ m, best_d, ra, best_u, (best_d + ra + best_u) * 96 / 1e3, best_t, (best_d + ra + best_t) * 96 / 1e3, (best_u - best_t) * 96 / 1e3 });
+    }
+}
