+        try tk.hcdUp(c.t, c.r.s, ti, c.act, c.wup.codes, c.h, c.pss, c.scale, c.mixed, c.xsm, c.rows, dims, eps);
+    }
+
+    fn decNew(w: *Hcw, ti: usize) !void {
+        const c = &w.c;
+        try tk.hcwDecDown(c.t, c.r.s, ti, c.h, c.pss, c.scale, c.wdown.codes, c.part, w.rinv, c.rows, n_down, wide, w.decSk(), dims, streams, eps);
+        try c.g.hcReduceAct(c.r.s, c.part, c.act, c.xs, c.inj, w.decSk(), c.rows, streams, low, n_down, 1);
