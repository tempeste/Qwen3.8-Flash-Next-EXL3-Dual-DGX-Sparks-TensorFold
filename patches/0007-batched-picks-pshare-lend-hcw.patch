+const env = @import("sys").env;
+const share = flash.snap.share;
+const Snap = flash.snap.Snap;
+
+const context = 16384;
+const piece_rows = 2944;
+const head = 3000;
+const common = 4000;
+const convs = 3;
+const turns = 3;
+const first_len = 5200;
+const turn_len = 1700;
+const rewritten = 0;
+const rewrite_turn = 2;
+const rewrite_at = 6000;
+const reply = 4;
+const decoders = 4;
