+const Lane28 = struct {
+    mode: @import("cuda_knobs.zig").MixedLast,
+    len: usize,
+    piece: usize,
+    marks: []const u32,
+    reports: bool,
+    lane: bool = false,
+    filled: ?usize = null,
+    prompt_in_unreported: bool = false,
+    waiting: Waiting(u32) = .{},
+    rows_run: usize = 0,
+    opens: usize = 0,
+    rode: usize = 0,
+    rode_last: usize = 0,
+
+    fn hostStep(x: *Lane28) !bool {
+        const n = if (x.reports) next(x.lane, x.filled != null, x.prompt_in_unreported) else (if (x.lane and x.filled != null) Next.step else Next.open);
+        switch (n) {
+            .report => {
+                x.prompt_in_unreported = false;
+                return true;
+            },
+            .open => {
+                x.lane = true;
+                x.filled = 0;
+                x.prompt_in_unreported = false;
+                x.opens += 1;
