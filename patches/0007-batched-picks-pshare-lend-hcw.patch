+    for (tk.hcd_mt, 0..) |mt, di| {
+        if (16 * mt < m) continue;
+        try decPoison(c, w);
+        try decNewDown(c, w, di);
+        const got = try back(c.r, f32, c.part, sk * m * w.nd);
+        try check.sameBytes("decode down slices", std.mem.sliceAsBytes(got), std.mem.sliceAsBytes(slices));
+        const fold = try c.r.a.alloc(f32, m * w.nd);
+        for (fold, 0..) |*f, i| {
