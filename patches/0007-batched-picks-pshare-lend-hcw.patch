+                try p.copy(s.h + i * wide * 2, s.h + last * wide * 2, wide * 2);
+                try p.copy(s.pss + i * pss_n * 4, s.pss + last * pss_n * 4, pss_n * 4);
+            }
+            if (own) |o| o.ds[i].len += rows;
+            at += rows;
+        }
+        try p.readout(h.mixer, 0, n_l);
+        _ = try p.lane(s.mixed, s.xsm, st.half, st.local.ptr, s.dummy, n_l, 1);
+        try st.coll.at(.head).gather(p.stream, st.local.ptr, st.joined.ptr, n_l * cut);
+        const o = own orelse return;
+        const rest = st.n_ids - cut;
+        try p.copyCols(st.joined.ptr, cut, s.head_local, st.n_ids, cut, n_l);
+        try p.copyCols(st.joined.ptr + n_l * cut * 2, rest, s.head_local + cut * 2, st.n_ids, rest, n_l);
+        for (o.ds, 0..) |d, i| try p.copy(d.dlogits.ptr, s.head_local + i * st.n_ids * 2, st.n_ids * 2);
+    }
+
+    fn moe(st: *State, comptime Tri: type, p: *batch.Pass(Tri), n: usize) !void {
+        const s = p.s;
+        const lw = &st.head.layer;
+        const shared = lw.native_experts orelse return error.DraftSplitNeedsExl3;
+        const pairs = n * slots;
+        try p.tri.routerMany(s.mixed, lw.router.ptr, s.router_l, dims, n);
+        try p.tri.topkMany(s.router_l, s.picks, s.wts, n);
+        const d = p.stream.d;
+        try d.check(d.api.cuMemsetD8Async(s.y, 0, pairs * dims * 4, p.stream.handle), "cuMemsetD8Async");
+        const x: ?side.Side = if (st.rank == 0 and !p.hooks.prompt) s.side else null;
+        if (x) |sx| {
+            try sx.fork.record(p.stream);
+            try sx.stream.wait(sx.fork);
+            try side.run(p, sx.stream, &shared, n);
+            try sx.join.record(sx.stream);
+        }
+        const owned = &st.experts;
+        const picks = try moe_native.ownPicks(p, s.picks, s.picks_ep, pairs, owned.first, owned.count, owned.stride);
+        const pl: cuda.grouped.Plan = .{ .members = s.members, .items = s.items, .counts = s.counts, .rank = s.rank, .hist = s.hist };
+        try moe_native.exl3(p, picks, owned, pl, pairs, n, owned.count + 1, @intCast(owned.count));
+        if (x) |sx| {
+            try p.stream.wait(sx.join);
+        } else if (st.rank == 0) try side.run(p, p.stream, &shared, n);
+        try st.coll.at(.moe).sum(p.stream, s.y, pairs * dims);
