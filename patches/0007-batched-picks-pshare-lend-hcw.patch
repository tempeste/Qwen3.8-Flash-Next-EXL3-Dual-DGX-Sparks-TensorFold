 /// The entry to free first, never `skip` or a borrowed one: with Store.live, every unpinned state before any pinned one,
 /// each group in today's order (superseded, then the oldest, the active rewind state last).
 pub fn victim(s: *const pc.Store, skip: ?*pc.Entry, prompt: []const u32, born: u32) ?Victim {
