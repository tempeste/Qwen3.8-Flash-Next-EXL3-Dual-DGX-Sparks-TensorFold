+const std = @import("std");
+
+pub const Base = struct { id: u64 = 0, valid: u32 = 0 };
+
+pub const Range = struct { lo: u32, hi: u32 };
+
+pub const default_chain_cap: u32 = 0;
+
+pub fn Rows(comptime Data: type) type {
+    return struct {
+        const Self = @This();
+
+        pub const Seg = struct {
+            id: u64,
+            lo: u32,
+            hi: u32,
+            bytes: u64,
+            prev: ?*Seg,
+            form: u8,
+            refs: u32 = 1,
+            orphan: bool = false,
+            data: Data,
+        };
+
+        pub const Extend = struct { prev: *Seg, lo: u32 };
+
+        pub const Step = union(enum) {
+            cold,
+            reuse: *Seg,
+            extend: Extend,
+        };
+
+        gpa: std.mem.Allocator,
+        segs: std.AutoHashMapUnmanaged(u64, *Seg) = .empty,
+        next_id: u64 = 1,
+        held_bytes: u64 = 0,
+        orphan_bytes: u64 = 0,
+        chain_cap: u32 = default_chain_cap,
+        grafts: u64 = 0,
+
+        pub fn init(gpa: std.mem.Allocator) Self {
+            return .{ .gpa = gpa };
+        }
+
+        pub fn deinit(r: *Self) void {
+            r.segs.deinit(r.gpa);
+            r.* = .{ .gpa = r.gpa, .chain_cap = r.chain_cap };
+        }
+
+        pub fn live(r: *const Self) usize {
+            return r.segs.count();
+        }
+
+        pub fn step(r: *const Self, base: Base, at: u32, form: u8) Step {
+            if (base.id == 0) return .cold;
+            const s = r.segs.get(base.id) orelse return .cold;
+            if (s.form != form or base.valid == 0) return .cold;
+            if (at <= base.valid) return .{ .reuse = s };
+            return graft(s, base.valid, r.chain_cap);
+        }
+
+        pub fn graft(top: *Seg, valid: u32, cap: u32) Step {
+            const d = depth(top, valid);
+            if (cap == 0 or d < cap) return .{ .extend = .{ .prev = top, .lo = valid } };
+            const keep = cap / 2;
+            if (keep == 0) return .cold;
+            var limit = valid;
+            var s: ?*Seg = top;
+            var seen: usize = 0;
+            while (s) |x| : (s = x.prev) {
+                if (limit <= x.lo) continue;
+                if (seen == d - keep) return .{ .extend = .{ .prev = x, .lo = @min(x.hi, limit) } };
+                seen += 1;
+                limit = x.lo;
+            }
+            return .cold;
+        }
+
+        pub fn noteGraft(r: *Self, st: Step, base: Base) void {
+            switch (st) {
+                .extend => |x| if (x.lo != base.valid) {
+                    r.grafts += 1;
+                },
+                else => {},
+            }
+        }
+
+        pub fn make(r: *Self, prev: ?*Seg, lo: u32, hi: u32, bytes: u64, form: u8, data: Data) !*Seg {
+            if (hi <= lo) return error.EmptyRows;
+            if (prev == null and lo != 0) return error.RowsGap;
+            if (prev) |p| if (p.form != form or p.hi < lo) return error.RowsGap;
+            try r.segs.ensureUnusedCapacity(r.gpa, 1);
+            const s = try r.gpa.create(Seg);
+            s.* = .{ .id = r.next_id, .lo = lo, .hi = hi, .bytes = bytes, .prev = prev, .form = form, .data = data };
+            r.next_id += 1;
+            if (prev) |p| p.refs += 1;
+            r.segs.putAssumeCapacity(s.id, s);
+            r.held_bytes += bytes;
+            return s;
+        }
+
+        pub fn retain(_: *Self, s: *Seg) void {
+            s.refs += 1;
+        }
+
+        pub fn release(r: *Self, seg: *Seg, creator: bool, ctx: anytype, comptime free: fn (@TypeOf(ctx), Data) void) void {
+            if (creator and seg.refs > 1 and !seg.orphan) {
+                seg.orphan = true;
+                r.orphan_bytes += seg.bytes;
+            }
+            var at: ?*Seg = seg;
+            while (at) |s| {
+                s.refs -= 1;
+                if (s.refs > 0) return;
+                at = s.prev;
+                if (s.orphan) r.orphan_bytes -= s.bytes;
+                r.held_bytes -= s.bytes;
+                _ = r.segs.remove(s.id);
+                free(ctx, s.data);
+                r.gpa.destroy(s);
+            }
+        }
+
+        pub fn chain(top: *const Seg, at: u32, out: []Range) ![]Range {
+            var n: usize = 0;
+            var limit = at;
+            var s: ?*const Seg = top;
+            while (s) |x| : (s = x.prev) {
+                if (limit <= x.lo) continue;
+                if (n == out.len) return error.RowsChainLong;
+                out[n] = .{ .lo = x.lo, .hi = @min(x.hi, limit) };
+                n += 1;
+                limit = x.lo;
+            }
+            if (limit != 0) return error.RowsGap;
+            return out[0..n];
+        }
+
+        pub fn depth(top: *const Seg, at: u32) usize {
+            var n: usize = 0;
+            var limit = at;
+            var s: ?*const Seg = top;
+            while (s) |x| : (s = x.prev) {
+                if (limit <= x.lo) continue;
+                n += 1;
+                limit = x.lo;
+            }
+            return n;
+        }
+    };
+}
