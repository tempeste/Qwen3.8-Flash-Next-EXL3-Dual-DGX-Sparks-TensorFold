@@ -0,0 +1,113 @@
+const std = @import("std");
+const lanes = @import("lanes");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const env = @import("sys").env;
+
+const context = 16384;
+const piece_rows = 2944;
+const decoder_rows = 200;
+const decoder_tokens = 256;
+const default_decoders = 8;
+const max_decoders = 27;
+
+const Marks = struct {
+    calls: usize = 0,
+    fn at(ptr: *anyopaque, _: *lanes.Stream, _: u32) void {
+        const m: *Marks = @ptrCast(@alignCast(ptr));
+        m.calls += 1;
+    }
+};
+
+const Filled = struct { first: u32, rows: u64, calls: usize, marks: usize };
+
+fn fillLong(engine: *lanes.Engine, ids: []const u32, marks: []const u32, limit: usize) !Filled {
+    const gpa = engine.gpa;
+    var seen: Marks = .{};
+    var s = try lanes.Stream.init(gpa, .{ .id = "long", .prompt = ids, .max_new = 2, .reuse = .{ .marks = marks, .hook = .{ .ptr = &seen, .at = Marks.at } } });
+    defer s.deinit(gpa);
+    const before = lanes.prefill_rows_run.load(.monotonic);
+    var calls: usize = 0;
+    while (true) {
+        calls += 1;
+        if (try engine.fillStreamCommitted(&s, calls == 1, null, piece_rows)) break;
+        const rows = lanes.prefill_rows_run.load(.monotonic) - before;
+        if (calls > limit or rows > ids.len) {
+            std.debug.print("FAIL flashnext-mixed-last-fill: the {d}-row prompt is not in after {d} fill calls and {d} rows run (it restarted)\n", .{ ids.len, calls, rows });
+            return error.TestFailed;
+        }
+        try engine.step();
+    }
+    const rows = lanes.prefill_rows_run.load(.monotonic) - before;
+    while (engine.activeCount() > 0) try engine.step();
+    if (s.emitted().len == 0) return error.NoFirstToken;
+    return .{ .first = s.emitted()[0], .rows = rows, .calls = calls, .marks = seen.calls };
+}
+
+fn openDecoder(engine: *lanes.Engine, s: *lanes.Stream) !void {
+    var first = true;
+    while (!try engine.fillStreamCommitted(s, first, null, piece_rows)) {
+        first = false;
+        try engine.step();
+    }
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, decoders_arg: ?[]const u8) !void {
+    const gpa = gpu.gpa;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpa, .limited(1 << 20));
+    defer gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const n_decoders = if (decoders_arg) |v| try std.fmt.parseInt(usize, v, 10) else default_decoders;
+    if (n_decoders == 0 or n_decoders > max_decoders) return error.BadDecoders;
+    if (std.c.getenv("TF_FLASHNEXT_OVERLAP") == null) _ = env.setenv("TF_FLASHNEXT_OVERLAP", "4096", 1);
+    if (std.c.getenv("TF_FLASHNEXT_MIXED_LAST") == null) _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "1", 1);
+    const mode = try flash.knobs.mixedLast();
+    if (mode == .off or (try flash.knobs.overlap()) == 0) return error.BadOverlap;
+
+    var loaded = try flash.native.open(gpa, gpu.io, gpu.ctx, dir, null, .{ .context = context, .drafts = true, .tp = 2, .rank = rank, .master = @import("flashnext_rank_tests.zig").rankHost(), .master_port = port });
+    defer loaded.deinit(loaded.ctx);
+    if (rank == 1) {
+        try loaded.follow.?(loaded.ctx);
+        check.pass("rank 1 followed the mixed-last fills", .{});
+        return;
+    }
+    var cfg = try lanes.Config.init(gpa, loaded.facts, loaded.rows, loaded.rows - 1);
+    defer cfg.deinit(gpa);
+    var clock: lanes.fake.FixedClock = .{};
+    var engine = lanes.Engine.init(gpa, &cfg, loaded.backend, clock.clock());
+    defer engine.deinit();
+    try check.expect(engine.fills(), "flashnext-mixed-last-fill: the backend steps its prompt passes", .{});
+
+    const len = 3 * piece_rows + 200;
+    const ids = try gpa.alloc(u32, len);
+    defer gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    const marks = [_]u32{ 7, len - 3 };
+    const limit = 2 * (len / 512 + marks.len) + 8;
+    std.debug.print("flashnext-mixed-last-fill: MIXED_LAST {s}, a {d}-row prompt marked at {any} in pieces of {d} beside {d} decoders\n", .{ @tagName(mode), len, marks, piece_rows, n_decoders });
+
+    const alone = try fillLong(&engine, ids, &marks, limit);
+    try check.expect(alone.rows == len, "flashnext-mixed-last-fill: alone, the prompt ran {d} rows of {d}", .{ alone.rows, len });
+
+    var streams: [max_decoders]lanes.Stream = undefined;
+    var opened: usize = 0;
+    defer for (streams[0..opened]) |*s| s.deinit(gpa);
+    var prompts: [max_decoders][decoder_rows]u32 = undefined;
+    for (0..n_decoders) |d| {
+        for (&prompts[d], 0..) |*v, i| v.* = seed.items[(i * 7 + d * 131 + 3) % seed.items.len];
+        streams[d] = try lanes.Stream.init(gpa, .{ .id = "decoder", .prompt = &prompts[d], .max_new = decoder_tokens });
+        opened += 1;
+        try openDecoder(&engine, &streams[d]);
+    }
+    try check.expect(engine.activeCount() == n_decoders, "flashnext-mixed-last-fill: {d} decoders live, want {d}", .{ engine.activeCount(), n_decoders });
+
+    const mixed = try fillLong(&engine, ids, &marks, limit);
+    try check.expect(mixed.rows == len, "flashnext-mixed-last-fill: beside decoders, the prompt ran {d} rows of {d} (a riding last piece re-opened the lane)", .{ mixed.rows, len });
+    try check.expect(mixed.marks == alone.marks, "flashnext-mixed-last-fill: beside decoders the marks were kept {d} times, alone {d}", .{ mixed.marks, alone.marks });
+    check.pass("a {d}-row prompt beside {d} decoders came in once ({d} fill calls, {d} rows) under MIXED_LAST {s}", .{ len, n_decoders, mixed.calls, mixed.rows, @tagName(mode) });
+    std.debug.print("RESULT flashnext-mixed-last-fill first token beside decoders {d}, alone {d}: {s}\n", .{ mixed.first, alone.first, if (mixed.first == alone.first) "same" else "DIFFER" });
+}
