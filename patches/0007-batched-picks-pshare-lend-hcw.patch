+            std.debug.print("RESULT hc-decode prompt rows {d}: {s}: {d} CTAs {d:.1} us ({d:.0} GB/s), {d} CTAs (a dimension tile each) {d:.1} us ({d:.0} GB/s of weights, act, streams and mixed)\n", .{ m, tk.hcn_uw_names[ui], @min(items, c.t.hcn_uw_blocks[ui]), us, up_b / us / 1e3, @min(items, dt), ut, up_b / ut / 1e3 });
