+fn subset(a: std.mem.Allocator, d: *const cuda.Driver, full: routed.Owned, first: usize) !struct { owned: routed.Owned, tables: cuda.DeviceBuffer } {
+    _ = a;
+    const x = full.exl3.?;
+    const count_all = x.experts;
+    const count = (count_all - first + 1) / 2;
+    const dm = x.dims;
+    const w = x.width;
+    const srcs = [12]u64{ x.gate, x.up, x.down, x.gate_k2, x.up_k2, x.down_k2, x.suh_g, x.suh_u, x.svh_g, x.svh_u, x.suh_d, x.svh_d };
+    const rows = [12]usize{ 8, 8, 8, 4, 4, 4, dm * 2, dm * 2, w * 2, w * 2, w * 2, dm * 2 };
+    var offs: [12]usize = undefined;
+    var total: usize = 0;
+    for (rows, 0..) |r, i| {
+        offs[i] = total;
+        total += std.mem.alignForward(usize, count * r, 256);
+    }
+    const host = try std.heap.page_allocator.alloc(u8, total);
+    defer std.heap.page_allocator.free(host);
+    @memset(host, 0);
+    var widest: usize = 0;
+    for (rows) |r| widest = @max(widest, r);
+    const full_rows = try std.heap.page_allocator.alloc(u8, count_all * widest);
+    defer std.heap.page_allocator.free(full_rows);
+    for (srcs, rows, offs) |src, r, off| {
+        const view: cuda.DeviceBuffer = .{ .d = d, .ptr = src, .len = count_all * r };
+        try view.download(0, full_rows[0 .. count_all * r]);
+        for (0..count) |j| @memcpy(host[off + j * r ..][0..r], full_rows[(first + 2 * j) * r ..][0..r]);
+    }
+    var tables = try cuda.DeviceBuffer.fromHost(d, host);
+    errdefer tables.free();
+    const base = tables.ptr;
+    var l = x;
+    l.gate = base + offs[0];
+    l.up = base + offs[1];
+    l.down = base + offs[2];
+    l.gate_k2 = base + offs[3];
+    l.up_k2 = base + offs[4];
+    l.down_k2 = base + offs[5];
+    l.suh_g = base + offs[6];
+    l.suh_u = base + offs[7];
+    l.svh_g = base + offs[8];
+    l.svh_u = base + offs[9];
+    l.suh_d = base + offs[10];
+    l.svh_d = base + offs[11];
+    l.experts = count;
+    const empty: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+    return .{ .owned = .{ .up = empty, .down = empty, .up_scale = empty, .down_scale = empty, .width = full.width, .dims = full.dims, .count = count, .first = first, .stride = 2, .format = .exl3, .image = null, .exl3 = l, .exl3_prompt = full.exl3_prompt }, .tables = tables };
+}
+
+pub fn shapeOk(h: wire.Header) bool {
+    return h.object == 0 and h.flags & ~(flag_absorb | flag_first) == 0 and (h.flags & flag_first == 0 or h.flags & flag_absorb != 0) and h.arg > 0 and h.arg <= prompt.batch.max_chunk and h.bytes >= 4 + entry_bytes + 4 and h.bytes <= max_bytes and h.bytes % 4 == 0;
+}
+
+pub const Entry = struct { slot: usize, rows: usize };
+pub const Decoded = struct { entries: []const Entry, ids: []const u8, total: usize };
+
+pub fn decode(payload: []const u8, absorb: bool, out: *[max_lanes]Entry) !Decoded {
+    if (payload.len < 4 or payload.len > max_bytes or payload.len % 4 != 0) return error.BadRankFrame;
+    const n_l = std.mem.readInt(u32, payload[0..4], .little);
+    if (n_l == 0 or n_l > max_lanes or payload.len < 4 + entry_bytes * n_l) return error.BadRankFrame;
+    const ids = payload[4 + entry_bytes * n_l ..];
+    var seen: [max_lanes]bool = @splat(false);
+    var total: usize = 0;
+    for (out[0..n_l], 0..) |*x, i| {
+        const raw = payload[4 + i * entry_bytes ..][0..entry_bytes];
+        const slot = std.mem.readInt(u32, raw[0..4], .little);
+        const rows = std.mem.readInt(u32, raw[4..8], .little);
+        if (slot >= max_lanes or seen[slot] or rows == 0 or rows > piece_rows or (!absorb and rows != 1)) return error.BadRankFrame;
+        seen[slot] = true;
+        x.* = .{ .slot = slot, .rows = rows };
+        total += rows;
+    }
+    if (total > piece_rows or ids.len != total * 4) return error.BadRankFrame;
+    for (0..total) |i| if (std.mem.readInt(u32, ids[i * 4 ..][0..4], .little) >= wt.vocab) return error.InvalidToken;
+    return .{ .entries = out[0..n_l], .ids = ids, .total = total };
+}
+
+pub fn encode(lane_slots: []const usize, nexts: []const []const u32, out: *[max_bytes]u8) ![]const u8 {
+    if (lane_slots.len != nexts.len or nexts.len == 0 or nexts.len > max_lanes) return error.BadRankFrame;
+    std.mem.writeInt(u32, out[0..4], @intCast(nexts.len), .little);
+    var n: usize = 4 + entry_bytes * nexts.len;
+    var absorb = false;
+    for (lane_slots, nexts, 0..) |slot, nx, i| {
+        if (slot >= max_lanes or n + 4 * nx.len > out.len) return error.BadRankFrame;
+        const raw = out[4 + i * entry_bytes ..][0..entry_bytes];
+        std.mem.writeInt(u32, raw[0..4], @intCast(slot), .little);
+        std.mem.writeInt(u32, raw[4..8], @intCast(nx.len), .little);
+        for (nx, 0..) |token, j| std.mem.writeInt(u32, out[n + j * 4 ..][0..4], token, .little);
+        n += 4 * nx.len;
+        absorb = absorb or nx.len != 1;
+    }
+    var check: [max_lanes]Entry = undefined;
+    _ = try decode(out[0..n], true, &check);
+    return out[0..n];
+}
