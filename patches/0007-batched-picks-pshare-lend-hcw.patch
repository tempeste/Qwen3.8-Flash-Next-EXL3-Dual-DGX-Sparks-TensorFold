new file mode 100644
index 0000000000000000000000000000000000000000..1af31d7fc13976e39d0ee3c9488977cbfc542b82
--- /dev/null
+++ b/zig/src/core/prompt_cache_keeping_test.zig
@@ -0,0 +1,164 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const Fake = @import("prompt_cache_fake.zig").Fake;
+const Store = pc.Store;
+
+fn convo(buf: []u32, c: u32, head: usize) []u32 {
+    for (buf, 0..) |*t, i| t.* = if (i < head) @intCast(i) else c * 100_000 + @as(u32, @intCast(i));
+    return buf;
+}
+
+fn keepBornAt(f: *Fake, s: *Store, prompt: []const u32, born: u32, at: u32) bool {
+    f.at = at;
+    return s.keepBorn(prompt, born, at, null, &.{}, &.{});
+}
+
+fn has(s: *const Store, prompt: []const u32, at: u32) bool {
+    for (s.entries.items) |e| if (e.at == at and e.tokens.len <= prompt.len and std.mem.eql(u32, e.tokens, prompt[0..e.tokens.len])) return true;
+    return false;
+}
+
+test "pcache keeping: one_copy evicts a request's shorter state beside its longer one before an older conversation" {
+    const gpa = std.testing.allocator;
+    var bufs: [3][2000]u32 = undefined;
+    const b = convo(&bufs[0], 2, 0);
+    const a = convo(&bufs[1], 1, 0);
+    const c = convo(&bufs[2], 3, 0);
+    for ([_]bool{ false, true }) |on| {
+        var f: Fake = .{ .gpa = gpa };
+        var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .lookahead = 1 }, (100 + 1500) + (100 + 1200) + (100 + 1500) + 50);
+        defer s.deinit();
+        s.keeping.one_copy = on;
+        try std.testing.expect(keepBornAt(&f, &s, b, 1999, 1500));
+        try std.testing.expect(keepBornAt(&f, &s, a, 1999, 1200));
+        try std.testing.expect(keepBornAt(&f, &s, a, 1999, 1500));
+        try std.testing.expect(keepBornAt(&f, &s, c, 1999, 1100));
+        try std.testing.expectEqual(on, has(&s, b, 1500));
+        try std.testing.expectEqual(!on, has(&s, a, 1200));
+        try std.testing.expect(has(&s, a, 1500) and has(&s, c, 1100));
+        try std.testing.expectEqual(@as(u64, if (on) 1 else 0), s.counts.evicted_shadowed);
+    }
+}
+
+test "pcache keeping: a warm end that the next turns pass by is the copy one_copy drops, a warm end they resume keeps it" {
+    const gpa = std.testing.allocator;
+    var bufs: [3][3000]u32 = undefined;
+    const a = convo(&bufs[0], 1, 0);
+    const other = convo(&bufs[1], 2, 0);
+    const edited = convo(&bufs[2], 1, 0);
+    for (edited[1600..]) |*t| t.* +%= 7;
+    for ([_]bool{ false, true }) |warm_serves| {
+        var f: Fake = .{ .gpa = gpa };
+        var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .lookahead = 1 }, 1 << 30);
+        defer s.deinit();
