+        try ttfts.appendSlice(gpa, s.ttfts.items);
+        span += (s.dur_ms - warm_ms) / 1000;
+        r.decode += s.decoded;
+        r.prefill += s.filled;
+        r.turns += s.turns;
+        r.fused += s.fused;
+    }
+    for (gaps.items) |g| r.over_1s += @floatFromInt(@intFromBool(g > 1000));
