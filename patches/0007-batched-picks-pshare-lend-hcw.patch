+fn decPack(r: *Rig, nd: usize) !cuda.qmmf.Weight {
+    const w = r.bfs(nd * wide, 0.04);
+    const p = try r.a.alloc(u16, cuda.nvfp4.padded(nd) * wide);
+    cuda.qmmf.packBf16(p, w, nd, wide);
+    return cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(p)), nd, wide);
