+    pub fn deinit(st: *State) void {
+        if (st.marks) |*m| for (m) |*x| x.deinit();
+        for ([_]*cuda.DeviceBuffer{ &st.local, &st.joined, &st.stage, &st.stage_joined, &st.rows_joined, &st.outs, &st.tables }) |b| b.free();
+        st.half.free();
+        if (st.owns_head) st.head.deinit();
+        st.gpa.destroy(st);
+    }
+
+    pub fn bytes(st: *const State) usize {
+        return st.half.w.len + st.half.s.len + st.half.b.len + st.tables.len + st.local.len + st.joined.len + st.stage.len + st.stage_joined.len + st.rows_joined.len + st.outs.len;
+    }
+
+    pub fn headMany(st: *State, comptime Tri: type, tri: Tri, ds: []const *Draft, nexts: []const []const u32, rows: []const u64, lane_slots: []const usize, absorb: bool) !void {
+        if (st.rank != 0) return error.BadRank;
+        const e = st.e;
+        const s = st.session;
+        const n_l = ds.len;
+        if (n_l == 0) return;
+        if (n_l > max_lanes or lane_slots.len != n_l or nexts.len != n_l or rows.len != n_l) return error.UnexpectedTensor;
+        for (ds) |d| try d.joinSide(e.stream.*);
+        var total: usize = 0;
+        var cap: usize = 0;
+        for (ds, nexts) |d, nx| {
+            if (nx.len == 0 or nx.len > piece_rows or d.media != null) return error.UnexpectedTensor;
+            if (!absorb and nx.len != 1) return error.UnexpectedTensor;
+            if (d.len + nx.len > d.cap) return error.PromptTooLong;
+            total += nx.len;
+            cap = @max(cap, d.cap);
+        }
+        const pl = plan.plan(e.admittedRows(), total);
+        const sc = try e.reserve(pl.pass_rows);
+        const score_rows = try e.reserveScores(cap, pl.score_rows);
+        var lane_rows: [max_lanes]usize = undefined;
+        for (nexts, 0..) |nx, i| lane_rows[i] = nx.len;
+        var group_sizes: [max_lanes]usize = undefined;
+        const n_groups = plan.groups(lane_rows[0..n_l], pl.piece, group_sizes[0..]);
+        var raw: [max_bytes]u8 = undefined;
+        var at: usize = 0;
+        for (group_sizes[0..n_groups], 0..) |g, gi| {
+            const gn = nexts[at..][0..g];
+            const gs = lane_slots[at..][0..g];
+            const flags: u32 = (if (absorb) flag_absorb else 0) | (if (absorb and gi == 0) flag_first else 0);
+            const payload = try encode(gs, gn, &raw);
+            const sent = try s.command(.{ .kind = .draft_pass, .arg = pl.pass_rows, .flags = flags, .bytes = @intCast(payload.len) }, payload);
+            errdefer s.poison();
+            try s.later(sent);
+            var ids: [max_ids]u32 = undefined;
+            var group_rows: [max_lanes]usize = undefined;
+            var n: usize = 0;
+            for (gn, 0..) |nx, i| {
+                group_rows[i] = nx.len;
+                @memcpy(ids[n..][0..nx.len], nx);
+                n += nx.len;
+            }
+            try st.pass(Tri, tri, sc, .{ .ds = ds[at..][0..g], .rows = rows[at..][0..g], .score_rows = score_rows }, ids[0..n], group_rows[0..g], gs, absorb);
+            at += g;
+        }
+    }
+
+    pub fn receive(st: *State, comptime Tri: type, tri: Tri, h: wire.Header, payload: []const u8) !void {
+        if (st.rank != 1) return error.BadRank;
+        var entries: [max_lanes]Entry = undefined;
+        const got = try decode(payload, h.flags & flag_absorb != 0, &entries);
+        if (h.arg > prompt.batch.max_chunk or got.total > h.arg) return error.BadRankFrame;
+        if (h.flags & flag_first != 0) st.have = @splat(false);
+        if (h.flags & flag_absorb == 0) {
+            for (got.entries) |x| if (!st.have[x.slot]) return error.BadRankFrame;
+        }
+        const sc = try st.e.reserve(@intCast(h.arg));
+        var ids: [max_ids]u32 = undefined;
+        var lane_rows: [max_lanes]usize = undefined;
+        var lane_slots: [max_lanes]usize = undefined;
+        var n: usize = 0;
+        for (got.entries, 0..) |x, i| {
+            lane_rows[i] = x.rows;
+            lane_slots[i] = x.slot;
+            for (0..x.rows) |r| ids[n + r] = std.mem.readInt(u32, got.ids[(n + r) * 4 ..][0..4], .little);
+            n += x.rows;
+        }
+        const stream = st.e.stream.*;
+        if (st.timing) {
+            if (st.marks == null) st.marks = .{ try cuda.Event.init(stream.d, true), try cuda.Event.init(stream.d, true) };
+            try st.settleMark();
+            if (h.flags & flag_first != 0) st.stats.close();
+            try st.marks.?[0].record(stream);
+        }
+        try st.pass(Tri, tri, sc, null, ids[0..n], lane_rows[0..got.entries.len], lane_slots[0..got.entries.len], h.flags & flag_absorb != 0);
+        for (got.entries) |x| st.have[x.slot] = true;
+        if (st.timing) {
+            try st.marks.?[1].record(stream);
+            st.open_mark = true;
+            st.stats.cur_open = true;
+        }
+    }
+
+    pub fn settleMark(st: *State) !void {
+        if (!st.open_mark) return;
+        const m = st.marks.?;
+        try m[1].synchronize();
+        const ms = try cuda.Event.elapsedMs(m[0], m[1]);
+        st.stats.gpu_ms += ms;
+        st.stats.cur += ms;
+        st.stats.passes += 1;
+        st.open_mark = false;
+    }
+
+    pub fn finishStats(st: *State) !void {
+        try st.settleMark();
+        st.stats.close();
+    }
+
+    const Own = struct {
+        ds: []const *Draft,
+        rows: []const u64,
+        score_rows: u64,
+    };
+
+    fn afterGate(ctx: *anyopaque, stream: cuda.Stream, gated: u64, xs: u64, n: usize) anyerror!void {
+        const st: *State = @ptrCast(@alignCast(ctx));
+        const width = @as(usize, st.head.layer.heads.q) * head_dim;
+        const d = stream.d;
+        try d.check(d.api.cuMemcpyDtoDAsync_v2(st.stage.ptr, gated, n * width * 2, stream.handle), "cuMemcpyDtoDAsync");
+        try d.check(d.api.cuMemcpyDtoDAsync_v2(st.stage.ptr + n * width * 2, xs, n * (width / 32) * 4, stream.handle), "cuMemcpyDtoDAsync");
+        try st.coll.at(.other).gather(stream, st.stage.ptr, st.stage_joined.ptr, n * gateBytes(&st.head.layer) / 2);
+    }
+
+    fn pass(st: *State, comptime Tri: type, tri: Tri, s: *batch.Scratch, own: ?Own, ids: []const u32, lane_rows: []const usize, lane_slots: []const usize, absorb: bool) !void {
+        const e = st.e;
+        const h = st.head;
+        const n_l = lane_rows.len;
+        const total = ids.len;
+        if (total == 0 or total > s.cap or total > piece_rows or n_l == 0 or n_l > max_lanes) return error.UnexpectedTensor;
+        if ((own != null) != (st.rank == 0)) return error.BadRank;
+        var lane_buf: [max_lanes]batch.Lane = undefined;
+        if (own) |o| for (o.ds, lane_rows, 0..) |d, r, i| {
+            lane_buf[i] = .{ .seq = .{ .media = null, .conv = &.{}, .state = &.{}, .kc = (&d.kc)[0..1], .vc = (&d.vc)[0..1], .ikc = (&d.ikc)[0..1], .pooled = (&d.pooled)[0..1], .tail = d.kc, .history = &d.unused_history, .cap = d.cap, .scores = o.score_rows, .kv = d.kv }, .pos = d.len, .rows = r };
+        };
+        var p: batch.Pass(Tri) = .{
+            .gpa = e.gpa,
+            .io = e.io,
+            .stream = e.stream.*,
+            .tri = tri,
+            .k = &e.batch_k,
+            .s = s,
+            .m = .{ .table_w = e.table.w.ptr, .table_s = e.table.s.ptr, .table_b = e.table.b.ptr, .table_dense = e.table.dense, .layers = (&h.layer)[0..1], .mixer = h.mixer, .head = h.draft, .ngram = &e.ngram },
+            .seq = if (own != null) lane_buf[0].seq else undefined,
+            .hooks = .{ .logits = .none },
+            .lanes = if (own != null) lane_buf[0..n_l] else &.{},
+        };
+        p.rows = total;
+        p.pos0 = 0;
+        p.pending = null;
+        try p.stage(ids);
+        if (e.table.dense) {
+            try tri.embedDense(s.ids, e.table.w.ptr, s.ple_keys, dims, streams, total);
+        } else {
+            try tri.embed(s.ids, e.table.w.ptr, e.table.s.ptr, e.table.b.ptr, s.ple_keys, dims, streams, total);
+        }
+        try tri.rmsnorm(s.ple_keys, h.norm_e.ptr, s.mixed, s.xsm, eps, wide, total, dims, dims);
+        const esk = try p.lane(s.mixed, s.xsm, h.fc_e, s.dummy, s.part, total, fc_sk);
+        try p.sumSlices(s.part, s.branch, true, total * dims, esk);
+        var at: usize = 0;
+        if (own) |o| {
+            for (o.rows, lane_rows) |r, rows| {
+                try p.copy(s.ple_nrow + at * wide * 2, r, rows * wide * 2);
+                at += rows;
+            }
+        } else if (!absorb) for (lane_slots, 0..) |slot, i| try p.copy(s.ple_nrow + i * wide * 2, st.outs.ptr + slot * wide * 2, wide * 2);
+        if (absorb) {
+            try st.coll.at(.other).gather(p.stream, s.ple_nrow, st.rows_joined.ptr, total * wide);
+            if (own == null) try p.copy(s.ple_nrow, st.rows_joined.ptr, total * wide * 2);
+        }
+        try tri.rmsnorm(s.ple_nrow, h.norm_h.ptr, s.norm, s.gq, eps, wide, total, wide, wide);
+        const hsk = try p.lane(s.norm, s.gq, h.fc_h, s.dummy, s.part, streams * total, fc_sk);
+        try p.sumSlices(s.part, s.ple_gated, true, streams * total * dims, hsk);
+        try tri.addStreams(s.branch, s.ple_gated, s.h, total, dims, streams);
+        try p.writeback(0, total);
+        try p.readout(h.layer.attn_hc, 0, total);
+        if (own != null) {
+            p.after_gate = .{ .ctx = st, .f = afterGate };
+            try p.attnBlock(&h.layer, 0);
+            p.after_gate = null;
+        } else {
+            const width = @as(usize, h.layer.heads.q) * head_dim;
+            try st.coll.at(.other).gather(p.stream, st.stage.ptr, st.stage_joined.ptr, total * gateBytes(&h.layer) / 2);
