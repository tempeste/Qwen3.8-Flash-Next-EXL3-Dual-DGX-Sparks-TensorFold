diff --git a/zig/src/core/prompt_cache_trace.zig b/zig/src/core/prompt_cache_trace.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2401902af24622883e7ae0f4b7782d63660ee6b0
--- /dev/null
+++ b/zig/src/core/prompt_cache_trace.zig
@@ -0,0 +1,191 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const replay = @import("prompt_cache_replay.zig");
+
+pub const Req = struct {
+    conv: u32,
+    client: u32,
+    head: u32,
+    start: u64,
+    first: u64,
+    prompt: u32,
+    cached: u32,
+    edit: u32,
+    here: bool,
+};
+
+pub const Trace = struct {
+    reqs: []Req,
+    convs: u32,
+
+    pub fn deinit(t: Trace, gpa: std.mem.Allocator) void {
+        gpa.free(t.reqs);
+    }
+};
+
+pub fn parse(gpa: std.mem.Allocator, text: []const u8) !Trace {
+    var out: std.ArrayList(Req) = .empty;
+    errdefer out.deinit(gpa);
+    var convs: u32 = 0;
+    var lines = std.mem.tokenizeScalar(u8, text, '\n');
+    while (lines.next()) |line| {
+        if (line.len == 0 or line[0] == '#') continue;
+        var f = std.mem.tokenizeAny(u8, line, " \t");
+        var v: [9]u64 = undefined;
+        for (&v) |*x| x.* = try std.fmt.parseInt(u64, f.next() orelse return error.BadTrace, 10);
+        if (v[2] >= 1 << 20 or v[5] < v[2] + 8) return error.BadTrace;
+        try out.append(gpa, .{ .conv = @intCast(v[0]), .client = @intCast(v[1]), .head = @intCast(v[2]), .start = v[3], .first = @max(v[3], v[4]), .prompt = @intCast(v[5]), .cached = @intCast(v[6]), .edit = @intCast(v[7]), .here = v[8] != 0 });
+        convs = @max(convs, @as(u32, @intCast(v[0])) + 1);
+    }
+    std.mem.sort(Req, out.items, {}, struct {
+        fn lt(_: void, a: Req, b: Req) bool {
+            return a.start < b.start;
+        }
+    }.lt);
+    return .{ .reqs = try out.toOwnedSlice(gpa), .convs = convs };
+}
+
+const Edits = std.ArrayList([2]u32);
+
+fn token(conv: u32, client: u32, head: u32, edits: []const [2]u32, pos: u32) u32 {
+    if (pos < head) return 0x4000_0000 | (client & 0x3ff) << 20 | pos;
+    if (pos < head + 3) return 0x7000_0000 + pos - head;
+    var epoch: u32 = 0;
+    for (edits) |e| if (pos >= e[0]) {
+        epoch = e[1];
+    };
+    const h = std.hash.Wyhash.hash(@as(u64, conv) << 32 | epoch, std.mem.asBytes(&pos));
+    return 0x8000_0000 | @as(u32, @truncate(h));
+}
+
+const Pending = struct {
+    at: u64,
+    prompt: []u32,
+    from: u32,
+    marks: []const u32,
+    owner: *u8,
+};
+
+pub fn run(gpa: std.mem.Allocator, cfg: replay.Config, t: Trace) !replay.Result {
+    var sim = replay.Sim.initFor(gpa, cfg);
+    defer sim.deinit();
+    var store = pc.Store.init(gpa, sim.snapshots(), .{ .lookahead = 1, .min_gap = 256, .min_prompt = 512, .chunk = 3072, .chunk_starts = false, .repeat_min = 16 }, cfg.budget);
+    defer store.deinit();
+    store.keeping = cfg.keeping;
+    store.share = cfg.share;
+    store.branch = cfg.share and cfg.anchor_tokens > 0;
+    const edits = try gpa.alloc(Edits, t.convs);
+    defer {
+        for (edits) |*e| e.deinit(gpa);
+        gpa.free(edits);
+    }
+    for (edits) |*e| e.* = .empty;
+    const turns = try gpa.alloc(u32, t.convs);
+    defer gpa.free(turns);
+    @memset(turns, 0);
+    const owners = try gpa.alloc(u8, t.reqs.len);
+    defer gpa.free(owners);
+    var pending: std.ArrayList(Pending) = .empty;
+    defer {
+        for (pending.items) |p| {
+            gpa.free(p.prompt);
+            gpa.free(p.marks);
+        }
+        pending.deinit(gpa);
+    }
+    var res: replay.Result = .{};
+    const sc = @max(1, cfg.scale);
+    for (t.reqs, 0..) |r, ri| {
+        try settle(gpa, &store, &sim, cfg, &pending, r.start, &res);
+        const head = r.head / sc;
+        if (r.edit > 0) try edits[r.conv].append(gpa, .{ @max(head + 3, r.edit / sc), @intCast(edits[r.conv].items.len + 1) });
+        defer turns[r.conv] += 1;
+        if (!r.here) continue;
+        const n = @max(head + 8, r.prompt / sc);
+        const prompt = try gpa.alloc(u32, n);
+        errdefer gpa.free(prompt);
+        for (prompt, 0..) |*x, i| x.* = token(r.conv, r.client, head, edits[r.conv].items, @intCast(i));
+        const sys = head + 3;
+        var shared: [3]u32 = undefined;
+        var ns: usize = 0;
+        for ([_]i64{ @as(i64, sys) - 2048 / sc, @as(i64, sys) - 512 / sc, sys }) |cut| if (cut >= 512 / sc and cut > 0) {
+            shared[ns] = @intCast(cut);
+            ns += 1;
+        };
+        const history = n - 3;
+        const user_end: u32 = if (turns[r.conv] == 0) history else 0;
+        const owner = &owners[ri];
+        const l = try store.lookupUser(gpa, prompt, n, history, sys, user_end, shared[0..ns], &.{}, &.{});
+        const from: u32 = if (l.entry) |e| e.at else 0;
+        sim.fresh(owner);
+        if (l.entry) |e| {
+            store.family.vtable.restore(store.family.ptr, owner, e.saved) catch {};
+            store.resumed(e, prompt, true);
+        }
+        res.requests += 1;
+        res.agent_requests += 1;
+        res.prompt_tokens += n;
+        res.prefilled += n - from;
+        res.agent_prefilled += n - from;
+        res.measured += r.prompt -| r.cached;
+        if (history >= 30000 / sc) {
+            res.long += 1;
+            if (from <= sys + 4096 / sc) {
+                res.long_cold += 1;
+                res.long_cold_tokens += n - from;
+            }
+            if (r.cached <= r.head + 3 + 4096) res.measured_long_cold += 1;
+        }
+        try pending.append(gpa, .{ .at = r.first, .prompt = prompt, .from = from, .marks = l.marks, .owner = owner });
+    }
+    try settle(gpa, &store, &sim, cfg, &pending, std.math.maxInt(u64), &res);
+    res.hits = store.counts.hits;
+    res.misses = store.counts.misses;
+    res.evicted_superseded = store.counts.evicted_superseded;
+    res.evicted_shadowed = store.counts.evicted_shadowed;
+    res.evicted_idle = store.counts.evicted_idle;
+    replay.finish(&res, &store, &sim);
+    if (sc > 1) {
+        res.prompt_tokens *= sc;
+        res.prefilled *= sc;
+        res.long_cold_tokens *= sc;
+        res.agent_prefilled *= sc;
+    }
+    return res;
+}
+
+fn settle(gpa: std.mem.Allocator, store: *pc.Store, sim: *replay.Sim, cfg: replay.Config, pending: *std.ArrayList(Pending), now: u64, res: *replay.Result) !void {
+    _ = sim;
+    while (true) {
+        var pick: ?usize = null;
+        for (pending.items, 0..) |p, i| if (p.at <= now and (pick == null or p.at < pending.items[pick.?].at)) {
+            pick = i;
+        };
+        const i = pick orelse return;
+        const p = pending.swapRemove(i);
+        replay.keepPass(store, cfg, p.prompt, p.from, p.marks, p.owner);
+        replay.sampleHeld(res, store);
+        gpa.free(p.prompt);
+        gpa.free(p.marks);
+    }
+}
+
+test "pcache share: a trace parses, keeps the shared head and resumes each turn where the last one ended" {
+    const gpa = std.testing.allocator;
+    const text =
+        \\# conv client head start first prompt cached edit here
+        \\0 0 2000 0 100 5000 0 0 1
+        \\0 0 2000 200 300 7000 4990 0 1
+        \\1 0 2000 250 350 6000 2000 0 1
+        \\0 0 2000 400 500 6500 2000 4000 1
+    ;
+    const t = try parse(gpa, text);
+    defer t.deinit(gpa);
+    try std.testing.expectEqual(@as(usize, 4), t.reqs.len);
+    var cfg: replay.Config = .{ .budget = 1 << 30 };
+    cfg.share = true;
+    const r = try run(gpa, cfg, t);
+    try std.testing.expectEqual(@as(u64, 4), r.requests);
+    try std.testing.expect(r.hits >= 2);
+    try std.testing.expect(r.prefilled < 5000 + 7000 + 6000 + 6500);
+}
