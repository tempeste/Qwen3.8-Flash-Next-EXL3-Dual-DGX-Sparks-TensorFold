+        try std.testing.expect(keepBornAt(&f, &s, a, 1600, 1500));
+        try std.testing.expect(keepBornAt(&f, &s, a, 1600, 2500));
+        const l = try s.lookup(gpa, if (warm_serves) a else edited, 2900, &.{}, &.{}, &.{});
+        defer gpa.free(l.marks);
+        s.resumed(l.entry.?, if (warm_serves) a else edited, true);
+        try std.testing.expectEqual(@as(u64, if (warm_serves) 1 else 0), s.counts.warm_hits);
