+
+test "prefill pace: on the agent bench's arrivals (12 agents in bursts of 4) paced rides keep decode, turns and prefill, cut TTFT p95 and the round gap tail, and fuse while prompts fill" {
+    const seeds = 6;
+    var r: [std.enums.values(Schedule).len]Result = undefined;
+    for (std.enums.values(Schedule), 0..) |sch, i| {
+        r[i] = try simulate(sch, seeds);
+        std.debug.print("pace sim {s:<9} decode {d:>6.1} prefill {d:>6.1} tok/s | turns/h {d:>5.0} | ttft p50 {d:>5.2} p95 {d:>6.2} s | round gap p50 {d:>5.0} p99 {d:>5.0} ms, over 1 s {d:>5.0}/h | fused {d:>4.2}/s\n", .{ @tagName(sch), r[i].decode, r[i].prefill, r[i].turns, r[i].ttft50, r[i].ttft95, r[i].gap50, r[i].gap99, r[i].over_1s, r[i].fused });
+    }
+    const prod = r[@backingInt(Schedule.prod)];
+    const pace = r[@backingInt(Schedule.pace)];
+    const ride = r[@backingInt(Schedule.ride4096)];
+    try std.testing.expect(pace.decode >= prod.decode);
+    try std.testing.expect(pace.turns >= prod.turns);
+    try std.testing.expect(pace.prefill >= prod.prefill);
+    try std.testing.expect(pace.ttft95 <= prod.ttft95);
+    try std.testing.expect(pace.gap99 <= prod.gap99);
+    try std.testing.expect(pace.over_1s < 0.1 * ride.over_1s);
+    try std.testing.expect(pace.fused > 0.5);
+}
+
+test "prefill pace: in the 28-lane mix (27 decoders, one cold 95k prompt) a paced piece fills faster than the default schedule without costing decode, and short of the mixed rounds' unpaced rides" {
+    var m: [std.enums.values(Schedule).len]Mix = undefined;
+    for (std.enums.values(Schedule), 0..) |sch, i| {
+        m[i] = try mixprobe(sch);
+        std.debug.print("mix sim {s:<9} ttft {d:>6.1} s prefill {d:>6.0} tok/s decode {d:>6.1} tok/s gap p99 {d:>5.0} ms\n", .{ @tagName(sch), m[i].ttft, m[i].prefill, m[i].decode, m[i].gap99 });
+    }
+    const prod = m[@backingInt(Schedule.prod)];
+    const pace = m[@backingInt(Schedule.pace)];
+    const ride = m[@backingInt(Schedule.ride4096)];
+    try std.testing.expect(pace.prefill > 1.1 * prod.prefill);
+    try std.testing.expect(pace.decode >= prod.decode);
+    try std.testing.expect(pace.gap99 < prod.gap99);
+    try std.testing.expect(ride.decode < 0.5 * prod.decode);
+    try std.testing.expect(pace.decode > 2 * ride.decode);
+}
