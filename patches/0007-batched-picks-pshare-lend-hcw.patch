+++ b/zig/tests/pcache_replay.zig
@@ -0,0 +1,182 @@
+const std = @import("std");
+const api = @import("engine_api");
+const replay = api.prompt_cache.replay;
+
+pub const std_options: std.Options = .{ .log_level = .err };
+
+const Scenario = struct { name: []const u8, cfg: replay.Config };
+const Arm = struct { name: []const u8, keeping: api.prompt_cache.Keeping, share: bool = false, anchors: bool = false, piece_anchors: bool = true };
+
+const keeping_arms = [_]Arm{
+    .{ .name = "off", .keeping = .{ .explain = true } },
+    .{ .name = "one_copy", .keeping = .{ .explain = true, .one_copy = true } },
+    .{ .name = "value", .keeping = .{ .explain = true, .value = true } },
+    .{ .name = "both", .keeping = .{ .explain = true, .one_copy = true, .value = true } },
+};
+
+const share_arms = [_]Arm{
+    .{ .name = "off", .keeping = .{ .explain = true } },
+    .{ .name = "share", .keeping = .{ .explain = true }, .share = true },
+    .{ .name = "sh+branch", .keeping = .{ .explain = true }, .share = true, .anchors = true, .piece_anchors = false },
+    .{ .name = "sh+anch", .keeping = .{ .explain = true }, .share = true, .anchors = true },
+};
+
+const Opts = struct { anchor_tokens: u32, scale: u32, token_bytes: u64, piece: u32, chain_cap: u32 };
+
+fn apply(cfg: *replay.Config, arm: Arm, o: Opts) void {
+    cfg.keeping = arm.keeping;
+    cfg.share = arm.share;
+    cfg.anchor_tokens = if (arm.anchors) o.anchor_tokens else 0;
+    cfg.piece_anchors = arm.piece_anchors;
+    cfg.chain_cap = o.chain_cap;
+    if (o.piece > 0) cfg.chunk = o.piece;
+}
+
+const segment_copies = 40;
+const fixed_copies = 85;
+const copy_us = 5.0;
+
+fn restoreLine(name: []const u8, t: replay.Result) void {
+    if (t.restores == 0) return;
+    const mean = @as(f64, @floatFromInt(t.depth_sum)) / @as(f64, @floatFromInt(t.restores));
+    const p99 = t.depthAt(0.99);
+    const extra_ms = struct {
+        fn f(d: u64) f64 {
+            return @as(f64, @floatFromInt((d -| 1) * segment_copies)) * copy_us / 1000;
+        }
+    }.f;
+    std.debug.print("  {s:<9} restores {d}, chain depth mean {d:.2} p50 {d} p99 {d} max {d}; copies a restore mean {d:.0} max {d} ({d} fixed + {d} a segment); chain copies past one segment at {d:.0} us each: p99 {d:.2} ms, max {d:.2} ms; grafts {d}; depth histogram", .{ name, t.restores, mean, t.depthAt(0.5), p99, t.depth_max, fixed_copies + segment_copies * mean, fixed_copies + segment_copies * t.depth_max, fixed_copies, segment_copies, copy_us, extra_ms(p99), extra_ms(t.depth_max), t.grafts });
+    for (t.depth_hist, replay.Result.depth_buckets) |n, top| {
+        if (n == 0) continue;
+        if (top == std.math.maxInt(u64)) std.debug.print(" >64:{d}", .{n}) else std.debug.print(" <={d}:{d}", .{ top, n });
+    }
+    std.debug.print("\n", .{});
+}
+
+fn mt(n: u64) f64 {
+    return @as(f64, @floatFromInt(n)) / 1e6;
+}
+
+pub fn main(init: std.process.Init) !void {
+    const gpa = init.gpa;
+    var seeds: u64 = 3;
+    var hours: f64 = 5;
+    var only: ?usize = null;
+    var share = false;
+    var anchor_tokens: u32 = 4096;
+    var trace: ?[]const u8 = null;
+    var scale: u32 = 1;
+    var token_bytes: u64 = 9_856;
+    var piece: u32 = 0;
+    var chain_cap: u32 = 20;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    var i: usize = 1;
+    while (i + 1 < args.len) : (i += 2) {
+        if (std.mem.eql(u8, args[i], "--seeds")) seeds = try std.fmt.parseInt(u64, args[i + 1], 10);
+        if (std.mem.eql(u8, args[i], "--hours")) hours = try std.fmt.parseFloat(f64, args[i + 1]);
+        if (std.mem.eql(u8, args[i], "--only")) only = try std.fmt.parseInt(usize, args[i + 1], 10);
+        if (std.mem.eql(u8, args[i], "--share")) share = std.mem.eql(u8, args[i + 1], "1");
+        if (std.mem.eql(u8, args[i], "--anchor-tokens")) anchor_tokens = try std.fmt.parseInt(u32, args[i + 1], 10);
+        if (std.mem.eql(u8, args[i], "--trace")) trace = args[i + 1];
+        if (std.mem.eql(u8, args[i], "--scale")) scale = try std.fmt.parseInt(u32, args[i + 1], 10);
+        if (std.mem.eql(u8, args[i], "--token-bytes")) token_bytes = try std.fmt.parseInt(u64, args[i + 1], 10);
+        if (std.mem.eql(u8, args[i], "--piece")) piece = try std.fmt.parseInt(u32, args[i + 1], 10);
+        if (std.mem.eql(u8, args[i], "--chain-cap")) chain_cap = try std.fmt.parseInt(u32, args[i + 1], 10);
+    }
+    const opts: Opts = .{ .anchor_tokens = anchor_tokens, .scale = scale, .token_bytes = token_bytes, .piece = piece, .chain_cap = chain_cap };
+    const arms: []const Arm = if (share or trace != null) &share_arms else &keeping_arms;
+    if (trace) |path| return traceMain(init, path, arms, opts);
+    const base: replay.Config = .{ .seconds = hours * 3600, .scale = scale, .token_bytes = token_bytes };
+    var scenarios = [_]Scenario{
+        .{ .name = "12 agents, tool-role results", .cfg = base },
+        .{ .name = "12 agents, user-role results", .cfg = base },
+        .{ .name = "24 agents, tool-role results", .cfg = base },
+        .{ .name = "24 agents, user-role results", .cfg = base },
+        .{ .name = "12 agents + 120 chats/h", .cfg = base },
+        .{ .name = "12 agents, 5%/turn history rewrite", .cfg = base },
+        .{ .name = "36 agents, tool-role results", .cfg = base },
+        .{ .name = "12 agents + 60 short conversations/h on a 20k common head", .cfg = base },
+        .{ .name = "24 agents + 120 short conversations/h on a 20k common head", .cfg = base },
+    };
+    scenarios[1].cfg.user_role_tools = true;
+    scenarios[2].cfg.agents = 24;
+    scenarios[3].cfg.agents = 24;
+    scenarios[3].cfg.user_role_tools = true;
+    scenarios[4].cfg.chats_per_hour = 120;
+    scenarios[5].cfg.rewrite = 0.05;
+    scenarios[6].cfg.agents = 36;
+    scenarios[7].cfg.chats_per_hour = 60;
+    scenarios[7].cfg.chat_common = 18000;
+    scenarios[8].cfg.agents = 24;
+    scenarios[8].cfg.chats_per_hour = 120;
+    scenarios[8].cfg.chat_common = 18000;
+    if (only == null) std.debug.print("{d} seeds x {d:.1} h, 30 GiB, Flash Next TP=2 rank-0 state bytes (57.9 MB + {d} B a token), pieces of {d} rows (0: chunks of 3072), chain cap {d} (0: none)\n", .{ seeds, hours, token_bytes, piece, chain_cap });
+    for (scenarios, 0..) |sc, si| {
+        if (only) |o| if (o != si) continue;
+        if (share) {
+            std.debug.print("\n{s}\n", .{sc.name});
+            header();
+        } else std.debug.print("\n{s}\n  {s:<9} {s:>7} {s:>7} {s:>9} {s:>9} {s:>9} {s:>8} {s:>8} {s:>6} {s:>6} {s:>6} {s:>6} {s:>6} {s:>6} {s:>6}\n", .{ sc.name, "arm", "reqs", "hit%", "prompt M", "prefill M", "agent M", "longcold", "lc tok M", "e.sup", "e.shd", "e.idle", "copies", "x.evic", "x.part", "x.new" });
+        for (arms) |arm| {
+            var t: replay.Result = .{};
+            var copies: f64 = 0;
+            for (0..seeds) |seed| {
+                var cfg = sc.cfg;
+                cfg.seed = seed + 1;
+                apply(&cfg, arm, opts);
+                const r = try replay.run(gpa, cfg);
+                add(&t, r);
+                t.explain.evicted += r.explain.evicted;
+                t.explain.parted += r.explain.parted;
+                t.explain.fresh += r.explain.fresh;
+                copies += r.copies();
+            }
+            const hit = 100 * @as(f64, @floatFromInt(t.hits)) / @as(f64, @floatFromInt(@max(1, t.hits + t.misses)));
+            if (share) {
+                row(arm.name, t, seeds);
+                restoreLine(arm.name, t);
+                continue;
+            }
+            std.debug.print("  {s:<9} {d:>7} {d:>7.1} {d:>9.1} {d:>9.2} {d:>9.2} {d:>8} {d:>8.2} {d:>6} {d:>6} {d:>6} {d:>6.2} {d:>6} {d:>6} {d:>6}\n", .{ arm.name, t.requests, hit, mt(t.prompt_tokens), mt(t.prefilled), mt(t.agent_prefilled), t.long_cold, mt(t.long_cold_tokens), t.evicted_superseded, t.evicted_shadowed, t.evicted_idle, copies / @as(f64, @floatFromInt(seeds)), t.explain.evicted, t.explain.parted, t.explain.fresh });
+        }
+    }
+}
+
+fn add(t: *replay.Result, r: replay.Result) void {
+    inline for (.{ "requests", "prompt_tokens", "prefilled", "agent_prefilled", "long_cold", "long_cold_tokens", "hits", "misses", "evicted_superseded", "evicted_shadowed", "evicted_idle", "evicted_anchor", "chat_requests", "chat_prefilled", "agent_requests", "anchors", "anchor_refused", "held_sum", "held_n", "states_sum", "saves", "saved_bytes", "restores", "depth_sum", "grafts" }) |f| @field(t, f) += @field(r, f);
+    for (&t.depth_hist, r.depth_hist) |*x, y| x.* += y;
+    t.depth_max = @max(t.depth_max, r.depth_max);
+    t.held_peak = @max(t.held_peak, r.held_peak);
+    t.explain.evicted += r.explain.evicted;
+    t.explain.parted += r.explain.parted;
+    t.explain.fresh += r.explain.fresh;
+}
+
+fn header() void {
+    std.debug.print("  {s:<9} {s:>7} {s:>9} {s:>9} {s:>9} {s:>9} {s:>8} {s:>8} {s:>7} {s:>7} {s:>7} {s:>7} {s:>7} {s:>7} {s:>8} {s:>8} {s:>9}\n", .{ "arm", "reqs", "prompt M", "prefill M", "pf/agent", "pf/chat", "longcold", "lc tok M", "e.sup", "e.idle", "e.cheap", "anchors", "a.ref", "states", "held GiB", "peak GiB", "kept GiB" });
+}
+
+fn row(name: []const u8, t: replay.Result, runs: u64) void {
+    const n: f64 = @floatFromInt(@max(1, runs));
+    const per_agent = @as(f64, @floatFromInt(t.agent_prefilled)) / @as(f64, @floatFromInt(@max(1, t.agent_requests)));
+    const per_chat = @as(f64, @floatFromInt(t.chat_prefilled)) / @as(f64, @floatFromInt(@max(1, t.chat_requests)));
+    std.debug.print("  {s:<9} {d:>7} {d:>9.1} {d:>9.2} {d:>9.0} {d:>9.0} {d:>8} {d:>8.2} {d:>7} {d:>7} {d:>7} {d:>7} {d:>7} {d:>7.0} {d:>8.1} {d:>8.1} {d:>9.0}\n", .{ name, t.requests, mt(t.prompt_tokens), mt(t.prefilled), per_agent, per_chat, t.long_cold, mt(t.long_cold_tokens), t.evicted_superseded, t.evicted_idle, t.evicted_anchor, t.anchors, t.anchor_refused, t.states(), t.heldGib(), @as(f64, @floatFromInt(t.held_peak)) / (1 << 30), @as(f64, @floatFromInt(t.saved_bytes)) / (1 << 30) / n });
+}
+
+fn traceMain(init: std.process.Init, path: []const u8, arms: []const Arm, o: Opts) !void {
+    const gpa = init.gpa;
+    const text = try std.Io.Dir.cwd().readFileAlloc(init.io, path, gpa, .unlimited);
+    defer gpa.free(text);
+    const t = try replay.trace.parse(gpa, text);
+    defer t.deinit(gpa);
+    std.debug.print("trace {s}: {d} requests, {d} conversations, scale {d}, 30 GiB, Flash Next TP=2 rank-0 state bytes (57.9 MB + {d} B a token), pieces of {d} rows (0: chunks of 3072), chain cap {d} (0: none)\n", .{ path, t.reqs.len, t.convs, o.scale, o.token_bytes, o.piece, o.chain_cap });
+    header();
+    for (arms) |arm| {
+        var cfg: replay.Config = .{ .scale = o.scale, .token_bytes = o.token_bytes };
+        apply(&cfg, arm, o);
+        const r = try replay.trace.run(gpa, cfg, t);
+        row(arm.name, r, 1);
+        restoreLine(arm.name, r);
+        if (!arm.share) std.debug.print("  {s:<9} {d:>7} {s:>9} {d:>9.2} {s:>9} {s:>9} {d:>8}  (prompt minus cached tokens the engine reported; long cold: cached within 4k of the head)\n", .{ "measured", r.requests, "", mt(r.measured), "", "", r.measured_long_cold });
+    }
+}
