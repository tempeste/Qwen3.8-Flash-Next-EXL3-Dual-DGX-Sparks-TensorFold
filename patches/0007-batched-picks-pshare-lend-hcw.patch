+
+fn decUpPack(r: *Rig) !cuda.qmmf.Weight {
+    const w = r.bfs(wide * low, 0.4);
+    const p = try r.a.alloc(u16, cuda.nvfp4.padded(wide) * low);
+    cuda.qmmf.packBf16(p, w, wide, low);
+    return cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(p)), wide, low);
+}
+
+fn decSk(c: *const Chain, w: Dec) usize {
+    return cuda.qmmf.planFor(c.rows, w.wd, true).sk;
