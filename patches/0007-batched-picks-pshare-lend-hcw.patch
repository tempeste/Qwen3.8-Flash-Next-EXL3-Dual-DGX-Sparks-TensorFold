+pub fn parseHcw(v: []const u8) error{BadHcw}!Hcw {
+    var h: Hcw = .{};
+    if (std.mem.eql(u8, v, "0")) return h;
+    if (v.len == 0) return error.BadHcw;
+    var seen: [10]bool = @splat(false);
+    var it = std.mem.splitScalar(u8, v, ',');
+    while (it.next()) |item| {
+        const eq = std.mem.indexOfScalar(u8, item, '=') orelse return error.BadHcw;
+        const key = item[0..eq];
+        const text = item[eq + 1 ..];
+        if (text.len == 0 or text.len > 6) return error.BadHcw;
+        for (text) |ch| if (ch < '0' or ch > '9') return error.BadHcw;
+        const n = std.fmt.parseInt(usize, text, 10) catch return error.BadHcw;
+        const keys = [_][]const u8{ "dn", "up", "blk", "dec", "lo", "dnlo", "uplo", "wb", "wblo", "wbc" };
+        const ki = for (keys, 0..) |k, i| {
+            if (std.mem.eql(u8, k, key)) break i;
+        } else return error.BadHcw;
+        if (seen[ki]) return error.BadHcw;
+        seen[ki] = true;
+        switch (ki) {
+            0, 5 => if (n >= hcw_downs) return error.BadHcw,
+            1, 6 => if (n >= hcw_ups) return error.BadHcw,
+            2 => if (n != 0 and (n < 256 or n > 4096 or n % 64 != 0)) return error.BadHcw,
+            3 => if (n >= hcw_decs) return error.BadHcw,
+            4 => if (n == 0 or n > 65536) return error.BadHcw,
+            7, 8 => if (n >= hcw_wbs) return error.BadHcw,
+            9 => if (n > 64) return error.BadHcw,
+            else => unreachable,
+        }
+        switch (ki) {
+            0 => h.dn = @intCast(n),
+            1 => h.up = @intCast(n),
+            2 => h.blk = n,
+            3 => h.dec = @intCast(n),
+            4 => h.lo = n,
+            5 => h.dnlo = @intCast(n),
+            6 => h.uplo = @intCast(n),
+            7 => h.wb = @intCast(n),
+            8 => h.wblo = @intCast(n),
+            9 => h.wbc = n,
+            else => unreachable,
+        }
+    }
+    return h;
+}
