diff --git a/zig/src/core/lane_host_ledger.zig b/zig/src/core/lane_host_ledger.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fbf6aad5285c7aa23e63aca2ed725f73e96a0bde
--- /dev/null
+++ b/zig/src/core/lane_host_ledger.zig
@@ -0,0 +1,212 @@
+const std = @import("std");
+const lanes = @import("lanes");
+
+pub const env_name = "TENSORFOLD_LANE_LEDGER_MS";
+pub const max_period_ms: u64 = 600_000;
+
+pub fn setting(v: ?[]const u8) error{BadLaneLedger}!u64 {
+    const s = v orelse return 0;
+    const ms = std.fmt.parseInt(u64, s, 10) catch return error.BadLaneLedger;
+    if (ms > max_period_ms) return error.BadLaneLedger;
+    return ms * std.time.ns_per_ms;
+}
+
+pub fn fromEnv() error{BadLaneLedger}!Ledger {
+    const v: ?[]const u8 = if (std.c.getenv(env_name)) |p| std.mem.span(p) else null;
+    return .{ .period_ns = try setting(v) };
+}
+
+pub const Kind = enum { long, short, many };
+
+pub const Calls = struct { n: u64 = 0, rows: u64 = 0, ns: u64 = 0 };
+
+pub const Mark = struct { at: i96, rows: u64, calls: u64 };
+
+pub const Ledger = struct {
+    period_ns: u64 = 0,
+    t0: ?i96 = null,
+    tokens0: u64 = 0,
+    rounds: u64 = 0,
+    round_ns: u64 = 0,
+    mixed: u64 = 0,
+    rode: u64 = 0,
+    decoders: u64 = 0,
+    calls: [3]Calls = @splat(.{}),
+    visits: u64 = 0,
+    worked: u64 = 0,
+    visit_ns: u64 = 0,
+    switches: u64 = 0,
+    wait_ns: u64 = 0,
+    after_work: bool = false,
+
+    pub fn on(l: *const Ledger) bool {
+        return l.period_ns > 0;
+    }
+
+    fn callCount(l: *const Ledger) u64 {
+        var n: u64 = 0;
+        for (l.calls) |c| n += c.n;
+        return n;
+    }
+
+    pub fn markAt(l: *const Ledger, at: i96, rows: u64) Mark {
+        return .{ .at = at, .rows = rows, .calls = l.callCount() };
+    }
+
+    pub fn mark(l: *const Ledger, io: std.Io) ?Mark {
+        if (!l.on()) return null;
+        return l.markAt(std.Io.Clock.awake.now(io).toNanoseconds(), lanes.prefill_rows_run.load(.monotonic));
+    }
+
+    fn span(from: Mark, at: i96) u64 {
+        return @intCast(@max(0, at - from.at));
+    }
+
+    pub fn calledAt(l: *Ledger, from: Mark, at: i96, rows: u64, kind: Kind) void {
+        const c = &l.calls[@intFromEnum(kind)];
+        c.n += 1;
+        c.rows += rows -| from.rows;
+        c.ns += span(from, at);
+    }
+
+    pub fn called(l: *Ledger, io: std.Io, m: ?Mark, kind: Kind) void {
+        const from = m orelse return;
+        l.calledAt(from, std.Io.Clock.awake.now(io).toNanoseconds(), lanes.prefill_rows_run.load(.monotonic), kind);
+    }
+
+    pub fn visitedAt(l: *Ledger, from: Mark, at: i96) void {
+        l.visits += 1;
+        l.visit_ns += span(from, at);
+        if (l.callCount() != from.calls) {
+            l.worked += 1;
+            l.after_work = true;
+        }
+    }
+
+    pub fn visited(l: *Ledger, io: std.Io, m: ?Mark) void {
+        const from = m orelse return;
+        l.visitedAt(from, std.Io.Clock.awake.now(io).toNanoseconds());
+    }
+
+    pub fn roundedAt(l: *Ledger, from: Mark, at: i96, rows: u64, decoders: usize) void {
+        l.rounds += 1;
+        l.round_ns += span(from, at);
+        l.decoders += decoders;
+        const rode = rows -| from.rows;
+        if (rode > 0) {
+            l.mixed += 1;
+            l.rode += rode;
+        }
+        if (l.after_work) l.switches += 1;
+        l.after_work = false;
+    }
+
+    pub fn rounded(l: *Ledger, io: std.Io, m: ?Mark, decoders: usize) void {
+        const from = m orelse return;
+        l.roundedAt(from, std.Io.Clock.awake.now(io).toNanoseconds(), lanes.prefill_rows_run.load(.monotonic), decoders);
+    }
+
+    pub fn waitedAt(l: *Ledger, from: Mark, at: i96) void {
+        l.wait_ns += span(from, at);
+    }
+
+    pub fn waited(l: *Ledger, io: std.Io, m: ?Mark) void {
+        const from = m orelse return;
+        l.waitedAt(from, std.Io.Clock.awake.now(io).toNanoseconds());
+    }
+
+    fn busy(l: *const Ledger) bool {
+        return l.rounds > 0 or l.callCount() > 0;
+    }
+
+    fn reset(l: *Ledger, at: i96, tokens: u64) void {
+        l.* = .{ .period_ns = l.period_ns, .t0 = at, .tokens0 = tokens, .after_work = l.after_work };
+    }
+
+    pub fn tickAt(l: *Ledger, at: i96, tokens: u64, buf: []u8) ?[]const u8 {
+        const t0 = l.t0 orelse {
+            l.reset(at, tokens);
+            return null;
+        };
+        const wall: u64 = @intCast(@max(0, at - t0));
+        if (wall < l.period_ns) return null;
+        const line = if (l.busy()) l.format(wall, tokens -| l.tokens0, buf) else null;
+        l.reset(at, tokens);
+        return line;
+    }
+
+    pub fn tick(l: *Ledger, io: std.Io, tokens: u64) void {
+        if (!l.on()) return;
+        var buf: [768]u8 = undefined;
+        if (l.tickAt(std.Io.Clock.awake.now(io).toNanoseconds(), tokens, &buf)) |line| std.log.info("{s}", .{line});
+    }
+
+    fn ms(ns: u64) u64 {
+        return (ns + std.time.ns_per_ms / 2) / std.time.ns_per_ms;
+    }
+
+    pub fn format(l: *const Ledger, wall: u64, tokens: u64, buf: []u8) []const u8 {
+        const per_round = if (l.rounds > 0) @as(f64, @floatFromInt(l.decoders)) / @as(f64, @floatFromInt(l.rounds)) else 0;
+        const rest = wall -| l.round_ns -| l.visit_ns -| l.wait_ns;
+        const lg = l.calls[@intFromEnum(Kind.long)];
+        const sh = l.calls[@intFromEnum(Kind.short)];
+        const mn = l.calls[@intFromEnum(Kind.many)];
+        return std.fmt.bufPrint(buf, "lane ledger: {d} ms, {d} tokens; rounds {d} in {d} ms ({d} mixed carrying {d} prompt rows, {d:.1} decoders a round); prompt calls: long {d} ({d} rows, {d} ms), short {d} ({d} rows, {d} ms), many {d} ({d} rows, {d} ms); visits {d} in {d} ms, {d} with prompt calls, {d} switches to a round; waiting {d} ms; rest {d} ms", .{
+            ms(wall),    tokens,      l.rounds,  ms(l.round_ns), l.mixed,  l.rode,     per_round,
+            lg.n,        lg.rows,     ms(lg.ns), sh.n,           sh.rows,  ms(sh.ns),  mn.n,
+            mn.rows,     ms(mn.ns),   l.visits,  ms(l.visit_ns), l.worked, l.switches, ms(l.wait_ns),
+            ms(rest),
+        }) catch buf[0..0];
+    }
+};
+
+test "TENSORFOLD_LANE_LEDGER_MS: unset and 0 are off, whole milliseconds up to ten minutes, anything else refused" {
+    try std.testing.expectEqual(@as(u64, 0), try setting(null));
+    try std.testing.expectEqual(@as(u64, 0), try setting("0"));
+    try std.testing.expectEqual(@as(u64, 1000 * std.time.ns_per_ms), try setting("1000"));
+    try std.testing.expectEqual(max_period_ms * std.time.ns_per_ms, try setting("600000"));
+    for ([_][]const u8{ "", "-1", "1.5", "1s", " 1000", "600001", "18446744073709551616" }) |bad| try std.testing.expectError(error.BadLaneLedger, setting(bad));
+    const off: Ledger = .{};
+    try std.testing.expect(!off.on());
+    try std.testing.expect(off.mark(std.testing.io) == null);
+}
+
+test "a period's line: rounds, rows that rode, calls by kind, visits, switches, waiting and the rest" {
+    const ms_ns: i96 = std.time.ns_per_ms;
+    var l: Ledger = .{ .period_ns = 1000 * std.time.ns_per_ms };
+    var buf: [768]u8 = undefined;
+    try std.testing.expect(l.tickAt(0, 100, &buf) == null);
+    var v = l.markAt(0, 0);
+    l.calledAt(l.markAt(0, 0), 505 * ms_ns, 1536, .long);
+    l.visitedAt(v, 506 * ms_ns);
+    l.roundedAt(l.markAt(506 * ms_ns, 1536), 653 * ms_ns, 1536, 27);
+    v = l.markAt(653 * ms_ns, 1536);
+    l.calledAt(l.markAt(653 * ms_ns, 1536), 923 * ms_ns, 1766, .short);
+    l.visitedAt(v, 924 * ms_ns);
+    l.roundedAt(l.markAt(924 * ms_ns, 1766), 1071 * ms_ns, 2066, 28);
+    v = l.markAt(1071 * ms_ns, 2066);
+    l.visitedAt(v, 1072 * ms_ns);
+    l.waitedAt(l.markAt(1072 * ms_ns, 2066), 1080 * ms_ns);
+    try std.testing.expect(l.tickAt(999 * ms_ns, 160, &buf) == null);
+    const line = l.tickAt(1100 * ms_ns, 230, &buf).?;
+    try std.testing.expectEqualStrings("lane ledger: 1100 ms, 130 tokens; rounds 2 in 294 ms (1 mixed carrying 300 prompt rows, 27.5 decoders a round); prompt calls: long 1 (1536 rows, 505 ms), short 1 (230 rows, 270 ms), many 0 (0 rows, 0 ms); visits 3 in 778 ms, 2 with prompt calls, 2 switches to a round; waiting 8 ms; rest 20 ms", line);
+    try std.testing.expectEqual(@as(u64, 0), l.rounds);
+    try std.testing.expectEqual(@as(?i96, 1100 * ms_ns), l.t0);
+    try std.testing.expect(l.tickAt(2200 * ms_ns, 230, &buf) == null);
+}
+
+test "a visit without prompt calls is no switch; the switch is counted once, at the round after the work" {
+    const ms_ns: i96 = std.time.ns_per_ms;
+    var l: Ledger = .{ .period_ns = std.time.ns_per_ms };
+    l.visitedAt(l.markAt(0, 0), ms_ns);
+    l.roundedAt(l.markAt(ms_ns, 0), 2 * ms_ns, 0, 1);
+    try std.testing.expectEqual(@as(u64, 0), l.switches);
+    const v = l.markAt(2 * ms_ns, 0);
+    l.calledAt(l.markAt(2 * ms_ns, 0), 3 * ms_ns, 64, .many);
+    l.visitedAt(v, 3 * ms_ns);
+    l.roundedAt(l.markAt(3 * ms_ns, 64), 4 * ms_ns, 64, 1);
+    l.roundedAt(l.markAt(4 * ms_ns, 64), 5 * ms_ns, 64, 1);
+    try std.testing.expectEqual(@as(u64, 1), l.switches);
+    try std.testing.expectEqual(@as(u64, 0), l.mixed);
+    try std.testing.expectEqual(@as(u64, 64), l.calls[@intFromEnum(Kind.many)].rows);
+}
