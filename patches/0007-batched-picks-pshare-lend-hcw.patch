+    try decOldDown(c, w, 0);
+    try decOldReduce(c, w, 0);
+    try decOldUp(c, w, 0);
+    try decOldMix(c, w, 0);
+}
+fn decNewDown(c: *Chain, w: Dec, di: usize) !void {
