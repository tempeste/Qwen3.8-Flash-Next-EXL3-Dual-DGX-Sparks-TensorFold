+        const runs = try decCase(&s, &flat, w);
+        check.pass("hc-decode: rows [{d}, {d}), {d} down columns: every K slice's fp32 sums = the lane's, folded = its cluster's, and act, inject, mixed and their sums = the five-launch chain's ({d} tile pairs)", .{ k.r0, k.r0 + k.m, w.nd, runs });
+    };
+    for ([_]usize{ 300, 512, 1000, 1536 }) |m| {
+        var s = c.shifted(0, m);
+        const want = try chainOuts(&s);
+        for (0..tk.hcn_dw_mt.len) |di| for (0..tk.hcn_uw_mt.len) |ui| try (try wideOuts(&s, di, ui, dt)).same(want);
+        check.pass("hc-decode: prompt rows {d}: wide down tiles x wide up tiles at {d} CTAs (one a 32-dimension tile, TF_FLASHNEXT_HCW_UP_CTAS={d}) = the five-launch chain, every output byte", .{ m, dt, dt });
+    }
+
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(gpu.d, true);
+    defer end.deinit();
+    var ws: [8]Dec = undefined;
+    for (&ws) |*w| w.* = .{ .wd = try decPack(r, n_down), .wu = try decUpPack(r), .nd = n_down, .inj = 1 };
+    const kb = @as(f64, @floatFromInt(wide * 2));
+    const wd_bytes = @as(f64, @floatFromInt(n_down)) * kb;
+    const wu_bytes = @as(f64, @floatFromInt(low)) * kb;
+    for ([_]usize{ 28, 56, 74, 84, 96 }) |m| {
