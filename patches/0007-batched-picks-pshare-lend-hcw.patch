+pub fn mixprobe(schedule: Schedule) !Mix {
+    const gpa = std.testing.allocator;
+    var prng = std.Random.DefaultPrng.init(0x3970_28);
+    var s: Sim = .{ .gpa = gpa, .rng = prng.random(), .schedule = schedule, .mode = .mix, .n = mix_decoders + 1, .plan = .init(wholeRows(schedule)), .dur_ms = 900 * 1000, .warm = mix_send_ms };
