+
+pub fn lendMinRowsSetting(value: ?[]const u8) error{BadLendMinRows}!usize {
+    const v = value orelse return lend_floors[0];
+    for (lend_floors) |f| {
+        var buf: [8]u8 = undefined;
+        if (std.mem.eql(u8, v, std.fmt.bufPrint(&buf, "{d}", .{f}) catch unreachable)) return f;
