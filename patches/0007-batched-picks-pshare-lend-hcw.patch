diff --git a/zig/src/core/prompt_cache_replay.zig b/zig/src/core/prompt_cache_replay.zig
new file mode 100644
index 0000000000000000000000000000000000000000..97f236ef4e7469f83d1899e8f404653cca1c076d
--- /dev/null
+++ b/zig/src/core/prompt_cache_replay.zig
@@ -0,0 +1,565 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const Store = pc.Store;
+pub const trace = @import("prompt_cache_trace.zig");
+
+pub const Config = struct {
+    agents: u32 = 12,
+    seconds: f64 = 5 * 3600,
+    budget: u64 = 30 << 30,
+    head: u32 = 12000,
+    min_conv: u32 = 60000,
+    max_conv: u32 = 130000,
+    user_role_tools: bool = false,
+    rewrite: f64 = 0,
+    rewrite_after: u32 = 40000,
+    chats_per_hour: f64 = 0,
+    lanes: u32 = 28,
+    seed: u64 = 1,
+    keeping: pc.Keeping = .{},
+    live: bool = false,
+    fixed_bytes: u64 = 57_913_344,
+    token_bytes: u64 = 9_856,
+    scale: u32 = 1,
+    prefill_tps: f64 = 2500,
+    decode_tps: f64 = 25,
+    share: bool = false,
+    anchor_tokens: u32 = 0,
+    chunk: u32 = 3072,
+    chat_head: u32 = 2000,
+    chat_common: u32 = 0,
+    piece_anchors: bool = true,
+    chain_cap: u32 = 0,
+};
+
+pub const Result = struct {
+    requests: u64 = 0,
+    agent_requests: u64 = 0,
+    prompt_tokens: u64 = 0,
+    prefilled: u64 = 0,
+    agent_prefilled: u64 = 0,
+    long: u64 = 0,
+    long_cold: u64 = 0,
+    long_cold_tokens: u64 = 0,
+    hits: u64 = 0,
+    misses: u64 = 0,
+    evicted_superseded: u64 = 0,
+    evicted_shadowed: u64 = 0,
+    evicted_idle: u64 = 0,
+    copies_sum: f64 = 0,
+    copies_n: u64 = 0,
+    peak_states: usize = 0,
+    explain: @import("prompt_cache_explain.zig").Counts = .{},
+    waits: u64 = 0,
+    evicted_anchor: u64 = 0,
+    chat_requests: u64 = 0,
+    measured: u64 = 0,
+    measured_long_cold: u64 = 0,
+    chat_prefilled: u64 = 0,
+    anchors: u64 = 0,
+    anchor_refused: u64 = 0,
+    held_sum: f64 = 0,
+    held_n: u64 = 0,
+    held_peak: u64 = 0,
+    states_sum: f64 = 0,
+    saves: u64 = 0,
+    saved_bytes: u64 = 0,
+    restores: u64 = 0,
+    depth_sum: u64 = 0,
+    depth_max: u64 = 0,
+    depth_hist: [depth_buckets.len]u64 = @splat(0),
+    grafts: u64 = 0,
+
+    pub const depth_buckets = [_]u64{ 1, 2, 4, 8, 16, 32, 64, std.math.maxInt(u64) };
+
+    pub fn note(r: *Result, depth: u64) void {
+        r.restores += 1;
+        r.depth_sum += depth;
+        r.depth_max = @max(r.depth_max, depth);
+        for (depth_buckets, 0..) |top, i| if (depth <= top) {
+            r.depth_hist[i] += 1;
+            break;
+        };
+    }
+
+    pub fn depthAt(r: Result, q: f64) u64 {
+        const want: u64 = @intFromFloat(@ceil(q * @as(f64, @floatFromInt(r.restores))));
+        var seen: u64 = 0;
+        for (r.depth_hist, depth_buckets) |n, top| {
+            seen += n;
+            if (seen >= want) return @min(top, r.depth_max);
+        }
+        return r.depth_max;
+    }
+
+    pub fn copies(r: Result) f64 {
+        return if (r.copies_n == 0) 0 else r.copies_sum / @as(f64, @floatFromInt(r.copies_n));
+    }
+
+    pub fn heldGib(r: Result) f64 {
+        return if (r.held_n == 0) 0 else r.held_sum / @as(f64, @floatFromInt(r.held_n)) / (1 << 30);
+    }
+
+    pub fn states(r: Result) f64 {
+        return if (r.held_n == 0) 0 else r.states_sum / @as(f64, @floatFromInt(r.held_n));
+    }
+};
+
+const Rows = @import("kept_rows.zig").Rows(void);
+const Base = @import("kept_rows.zig").Base;
+
+pub const Sim = struct {
+    gpa: std.mem.Allocator,
+    fixed: u64,
+    per: u64,
+    share: bool = false,
+    saves: u64 = 0,
+    saved_bytes: u64 = 0,
+    rows: Rows,
+    bases: std.AutoHashMapUnmanaged(usize, Base) = .empty,
+    depths: Result = .{},
+
+    const Kept = struct { at: u32, top: ?*Rows.Seg = null, created: bool = false, bytes: u64 };
+
+    pub fn init(gpa: std.mem.Allocator, fixed: u64, per: u64, share: bool) Sim {
+        return .{ .gpa = gpa, .fixed = fixed, .per = per, .share = share, .rows = Rows.init(gpa) };
+    }
+
+    pub fn initFor(gpa: std.mem.Allocator, cfg: Config) Sim {
+        var s = init(gpa, cfg.fixed_bytes, cfg.token_bytes * cfg.scale, cfg.share);
+        s.rows.chain_cap = cfg.chain_cap;
+        return s;
+    }
+
+    pub fn deinit(s: *Sim) void {
+        s.bases.deinit(s.gpa);
+        s.rows.deinit();
+    }
+
+    fn of(p: *anyopaque) *Sim {
+        return @ptrCast(@alignCast(p));
+    }
+    fn bytes(p: *anyopaque, at: u32) u64 {
+        const s = of(p);
+        return s.fixed + s.per * at;
+    }
+    fn base(s: *const Sim, owner: ?*anyopaque) Base {
+        const o = owner orelse return .{};
+        return s.bases.get(@intFromPtr(o)) orelse .{};
+    }
+    fn added(p: *anyopaque, owner: ?*anyopaque, at: u32) u64 {
+        const s = of(p);
+        const b = s.base(owner);
+        return switch (s.rows.step(b, at, 0)) {
+            .cold => s.fixed + s.per * at,
+            .reuse => s.fixed,
+            .extend => |x| s.fixed + s.per * (at - x.lo),
+        };
+    }
+    fn save(p: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const s = of(p);
+        const k = try s.gpa.create(Kept);
+        errdefer s.gpa.destroy(k);
+        k.* = .{ .at = at, .bytes = s.fixed + s.per * at };
+        if (s.share) {
+            const b = s.base(owner);
+            const st = s.rows.step(b, at, 0);
+            switch (st) {
+                .cold => {
+                    k.top = try s.rows.make(null, 0, at, s.per * at, 0, {});
+                    k.created = true;
+                },
+                .reuse => |seg| {
+                    s.rows.retain(seg);
+                    k.top = seg;
+                    k.bytes = s.fixed;
+                },
+                .extend => |x| {
+                    k.top = try s.rows.make(x.prev, x.lo, at, s.per * (at - x.lo), 0, {});
+                    k.created = true;
+                    k.bytes = s.fixed + s.per * (at - x.lo);
+                    s.rows.noteGraft(st, b);
+                },
+            }
+            if (k.created) if (owner) |o| s.bases.put(s.gpa, @intFromPtr(o), .{ .id = k.top.?.id, .valid = at }) catch {};
+        }
+        s.saves += 1;
+        s.saved_bytes += k.bytes;
+        return k;
+    }
+    fn restore(p: *anyopaque, owner: ?*anyopaque, saved: pc.Saved) anyerror!void {
+        const s = of(p);
+        const k: *Kept = @ptrCast(@alignCast(saved));
+        if (!s.share) return s.depths.note(1);
+        s.depths.note(Rows.depth(k.top.?, k.at));
+        const o = owner orelse return;
+        try s.bases.put(s.gpa, @intFromPtr(o), .{ .id = k.top.?.id, .valid = k.at });
+    }
+    pub fn fresh(s: *Sim, owner: *anyopaque) void {
+        _ = s.bases.remove(@intFromPtr(owner));
+    }
+    fn noFree(_: void, _: void) void {}
+    fn drop(p: *anyopaque, saved: pc.Saved) void {
+        const s = of(p);
+        const k: *Kept = @ptrCast(@alignCast(saved));
+        if (k.top) |t| s.rows.release(t, k.created, {}, noFree);
+        s.gpa.destroy(k);
+    }
+    fn charged(_: *anyopaque, saved: pc.Saved) u64 {
+        const k: *Kept = @ptrCast(@alignCast(saved));
+        return k.bytes;
+    }
+    fn orphans(p: *anyopaque) u64 {
+        return of(p).rows.orphan_bytes;
+    }
+    pub fn snapshots(s: *Sim) pc.Snapshots {
+        return .{ .ptr = s, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop, .charged = charged, .added = added, .orphans = orphans } };
+    }
+};
+
+const chat_tag: u32 = 1 << 20;
+
+const Conv = struct {
+    id: u32,
+    head: u32,
+    len: u32 = 0,
+    target: u32,
+    edits: std.ArrayList([2]u32) = .empty,
+    user_at: u32,
+    turns: u32 = 0,
+    chat: bool = false,
+    common: u32 = 0,
+
+    fn token(c: *const Conv, pos: u32) u32 {
+        if (c.chat and pos < c.head + 3 + c.common) return chat_tag | pos;
+        if (pos < c.head) return if (c.chat) chat_tag | pos else pos;
+        if (pos < c.head + 3) return 0x7000_0000 + pos - c.head;
+        var epoch: u32 = 0;
+        for (c.edits.items) |e| if (pos >= e[0]) {
+            epoch = e[1];
+        };
+        const h = std.hash.Wyhash.hash(@as(u64, c.id) << 32 | epoch, std.mem.asBytes(&pos));
+        return 0x8000_0000 | @as(u32, @truncate(h));
+    }
+
+    fn fill(c: *const Conv, out: []u32) void {
+        for (out, 0..) |*t, i| t.* = c.token(@intCast(i));
+    }
+};
+
+const Phase = enum { start, pass_end, idle };
+
+const Actor = struct {
+    conv: ?Conv = null,
+    next: f64 = 0,
+    phase: Phase = .start,
+    prompt: []u32 = &.{},
+    history: u32 = 0,
+    rewind: u32 = 0,
+    user_end: u32 = 0,
+    marks: []const u32 = &.{},
+    chat: bool = false,
+    done: bool = false,
+    reply: u32 = 0,
+    from: u32 = 0,
+};
+
+fn uniform(r: std.Random, lo: f64, hi: f64) f64 {
+    return lo + (hi - lo) * r.float(f64);
+}
+
+fn pause(r: std.Random) f64 {
+    const u = r.float(f64);
+    if (u < 0.70) return uniform(r, 2, 20);
+    if (u < 0.95) return uniform(r, 20, 120);
+    return uniform(r, 120, 900);
+}
+
+fn toolTokens(r: std.Random) u32 {
+    const u = r.float(f64);
+    if (u < 0.70) return @intFromFloat(uniform(r, 100, 1500));
+    if (u < 0.95) return @intFromFloat(uniform(r, 1500, 6000));
+    return @intFromFloat(uniform(r, 6000, 15000));
+}
+
+const Run = struct {
+    const Self = @This();
+    gpa: std.mem.Allocator,
+    cfg: Config,
+    store: *Store,
+    sim: *Sim,
+    rng: std.Random,
+    res: Result = .{},
+    next_id: u32 = 1,
+    in_flight: u32 = 0,
+
+    fn sc(self: *const Run, n: u32) u32 {
+        return @max(1, n / self.cfg.scale);
+    }
+
+    fn newConv(self: *Run, chat: bool) Conv {
+        const r = self.rng;
+        const id = self.next_id;
+        self.next_id += 1;
+        if (chat) {
+            const head = self.sc(self.cfg.chat_head);
+            const common = self.sc(self.cfg.chat_common);
+            const first = common + self.sc(@intFromFloat(uniform(r, 300, 6000)));
+            return .{ .id = id, .head = head, .len = head + 3 + first, .target = head + 3 + first + self.sc(@intFromFloat(uniform(r, 500, 8000))), .user_at = head + 3, .chat = true, .common = common };
+        }
+        const head = self.sc(self.cfg.head);
+        const first = self.sc(@intFromFloat(uniform(r, 200, 3000)));
+        return .{ .id = id, .head = head, .len = head + 3 + first, .target = self.sc(@intFromFloat(uniform(r, @floatFromInt(self.cfg.min_conv), @floatFromInt(self.cfg.max_conv)))), .user_at = head + 3 };
+    }
+
+    fn begin(self: *Run, a: *Actor, now: f64) !void {
+        const c = &a.conv.?;
+        const opener = 3;
+        self.gpa.free(a.prompt);
+        a.prompt = try self.gpa.alloc(u32, c.len + opener);
+        c.fill(a.prompt);
+        a.history = c.len;
+        a.rewind = c.user_at;
+        a.user_end = if (c.user_at > c.head + 3 or c.turns == 0) c.len else 0;
+        const sys = c.head + 3;
+        var shared: [3]u32 = undefined;
+        var ns: usize = 0;
+        for ([_]i64{ @as(i64, sys) - 2048, @as(i64, sys) - 512, sys }) |cut| if (cut >= 512) {
+            shared[ns] = @intCast(cut);
+            ns += 1;
+        };
+        const l = try self.store.lookupUser(self.gpa, a.prompt, @intCast(a.prompt.len), a.history, a.rewind, a.user_end, shared[0..ns], &.{}, &.{});
+        const from: u32 = if (l.entry) |e| e.at else 0;
+        self.sim.fresh(a);
+        if (l.entry) |e| {
+            Sim.restore(self.sim, a, e.saved) catch {};
+            self.store.resumed(e, a.prompt, true);
+        }
+        a.marks = l.marks;
+        a.from = from;
+        const n: u64 = a.prompt.len;
+        self.res.requests += 1;
+        self.res.prompt_tokens += n;
+        self.res.prefilled += n - from;
+        if (a.chat) {
+            self.res.chat_requests += 1;
+            self.res.chat_prefilled += n - from;
+        }
+        if (!a.chat) {
+            self.res.agent_requests += 1;
+            self.res.agent_prefilled += n - from;
+            if (a.history >= self.sc(30000)) {
+                self.res.long += 1;
+                if (from <= sys + self.sc(4096)) {
+                    self.res.long_cold += 1;
+                    self.res.long_cold_tokens += n - from;
+                }
+            }
+        }
+        a.phase = .pass_end;
+        a.next = now + @as(f64, @floatFromInt(n - from)) * @as(f64, @floatFromInt(self.cfg.scale)) / self.cfg.prefill_tps;
+        self.in_flight += 1;
+    }
+
+    fn passEnd(self: *Run, a: *Actor, now: f64) void {
+        keepPass(self.store, self.cfg, a.prompt, a.from, a.marks, a);
+        self.gpa.free(a.marks);
+        a.marks = &.{};
+        self.in_flight -= 1;
+        self.res.peak_states = @max(self.res.peak_states, self.store.entries.items.len);
+        self.sampleCopies();
+        const r = self.rng;
+        const c = &a.conv.?;
+        a.reply = self.sc(@intFromFloat(uniform(r, 150, 2500)));
+        const decode = @as(f64, @floatFromInt(a.reply)) * @as(f64, @floatFromInt(self.cfg.scale)) / self.cfg.decode_tps;
+        c.turns += 1;
+        c.len = @intCast(a.prompt.len);
+        c.len += a.reply;
+        if (a.chat) {
+            const more = self.sc(@intFromFloat(uniform(r, 50, 1500)));
+            c.user_at = c.len + 3;
+            c.len += 3 + more;
+            a.next = now + decode + uniform(r, 20, 600);
+            if (c.len >= c.target or c.turns >= 3) a.done = true;
+            a.phase = .idle;
+            return;
+        }
+        const tool = self.sc(toolTokens(r));
+        if (self.cfg.user_role_tools) c.user_at = c.len + 3;
+        c.len += 3 + tool;
+        if (self.cfg.rewrite > 0 and c.len > self.sc(self.cfg.rewrite_after) and r.float(f64) < self.cfg.rewrite) {
+            const lo = c.head + 3 + self.sc(1000);
+            const hi = @max(lo + 1, c.len / 2);
+            const at: u32 = lo + r.uintLessThan(u32, hi - lo);
+            c.edits.append(self.gpa, .{ at, @intCast(c.edits.items.len + 1) }) catch {};
+        }
+        var wait = decode + pause(r);
+        if (c.len >= c.target) {
+            a.done = true;
+            wait = decode + uniform(r, 30, 300);
+        }
+        a.next = now + wait;
+        a.phase = .idle;
+    }
+
+    fn sampleCopies(self: *Self) void {
+        sampleHeld(&self.res, self.store);
+        const items = self.store.entries.items;
+        var keys: [1024]u32 = undefined;
+        if (items.len > keys.len) return;
+        for (items, 0..) |e, i| keys[i] = if (e.expired) 0 else convOf(e);
+        var ids: [1024]u32 = undefined;
+        var newest: [1024]u64 = undefined;
+        var n: usize = 0;
+        var held: u64 = 0;
+        for (items, 0..) |e, i| {
+            const key = keys[i];
+            if (key == 0) continue;
+            const later = for (items, 0..) |o, j| {
+                if (j != i and keys[j] == key and o.born > e.born and o.tokens.len > e.tokens.len) break true;
+            } else false;
+            if (later) continue;
+            held += e.bytes;
+            const k = for (ids[0..n], 0..) |x, m| {
+                if (x == key) break m;
+            } else blk: {
+                ids[n] = key;
+                newest[n] = 0;
+                n += 1;
+                break :blk n - 1;
+            };
+            newest[k] = @max(newest[k], e.bytes);
+        }
+        var sum: u64 = 0;
+        for (newest[0..n]) |b| sum += b;
+        if (sum == 0) return;
+        self.res.copies_sum += @as(f64, @floatFromInt(held)) / @as(f64, @floatFromInt(sum));
+        self.res.copies_n += 1;
+    }
+
+    fn convOf(e: *const pc.Entry) u32 {
+        for (e.tokens) |t| if (t & 0x8000_0000 != 0) return t;
+        return 0;
+    }
+};
+
+pub fn run(gpa: std.mem.Allocator, cfg: Config) !Result {
+    var prng = std.Random.DefaultPrng.init(cfg.seed);
+    var sim = Sim.initFor(gpa, cfg);
+    defer sim.deinit();
+    var store = Store.init(gpa, sim.snapshots(), .{ .lookahead = 1, .min_gap = 256, .min_prompt = 512, .chunk = 3072, .chunk_starts = false, .repeat_min = 16 }, cfg.budget);
+    defer store.deinit();
+    store.keeping = cfg.keeping;
+    store.live = cfg.live;
+    store.share = cfg.share;
+    store.branch = cfg.share and cfg.anchor_tokens > 0;
+    var r: Run = .{ .gpa = gpa, .cfg = cfg, .store = &store, .sim = &sim, .rng = prng.random() };
+    const chats: u32 = @intFromFloat(@ceil(cfg.chats_per_hour * cfg.seconds / 3600));
+    const actors = try gpa.alloc(Actor, cfg.agents + chats);
+    defer {
+        for (actors) |*a| {
+            gpa.free(a.prompt);
+            gpa.free(a.marks);
+            if (a.conv) |*c| c.edits.deinit(gpa);
+        }
+        gpa.free(actors);
+    }
+    for (actors, 0..) |*a, i| {
+        a.* = .{};
+        if (i < cfg.agents) {
+            a.next = uniform(r.rng, 0, 60);
+        } else {
+            a.chat = true;
+            a.next = uniform(r.rng, 0, cfg.seconds);
+        }
+    }
+    while (true) {
+        var pick: ?usize = null;
+        for (actors, 0..) |a, i| {
+            if (a.chat and a.done) continue;
+            if (a.phase == .start or a.phase == .idle) if (r.in_flight >= cfg.lanes) continue;
+            if (pick == null or a.next < actors[pick.?].next) pick = i;
+        }
+        const i = pick orelse break;
+        const a = &actors[i];
+        const now = a.next;
+        if (now > cfg.seconds and a.phase != .pass_end) {
+            a.done = true;
+            a.chat = true;
+            continue;
+        }
+        switch (a.phase) {
+            .start, .idle => {
+                if (a.conv == null or a.done) {
+                    if (a.conv) |*c| c.edits.deinit(gpa);
+                    if (a.done and a.chat) continue;
+                    a.conv = r.newConv(a.chat);
+                    a.done = false;
+                }
+                try r.begin(a, now);
+            },
+            .pass_end => r.passEnd(a, now),
+        }
+    }
+    r.res.hits = store.counts.hits;
+    r.res.misses = store.counts.misses;
+    r.res.evicted_superseded = store.counts.evicted_superseded;
+    r.res.evicted_shadowed = store.counts.evicted_shadowed;
+    r.res.evicted_idle = store.counts.evicted_idle;
+    r.res.explain = store.explained.counts;
+    finish(&r.res, &store, &sim);
+    return r.res;
+}
+
+pub fn finish(res: *Result, store: *const Store, sim: *const Sim) void {
+    res.evicted_anchor = store.counts.evicted_anchor;
+    res.anchors = store.counts.anchors;
+    res.anchor_refused = store.counts.anchor_refused;
+    res.saves = sim.saves;
+    res.saved_bytes = sim.saved_bytes;
+    res.restores = sim.depths.restores;
+    res.depth_sum = sim.depths.depth_sum;
+    res.depth_max = sim.depths.depth_max;
+    res.depth_hist = sim.depths.depth_hist;
+    res.grafts = sim.rows.grafts;
+}
+
+pub fn sampleHeld(res: *Result, store: *const Store) void {
+    const held = store.held + store.orphans();
+    res.held_sum += @floatFromInt(held);
+    res.states_sum += @floatFromInt(store.entries.items.len);
+    res.held_n += 1;
+    res.held_peak = @max(res.held_peak, held);
+}
+
+pub fn keepPass(store: *Store, cfg: Config, prompt: []const u32, from: u32, marks: []const u32, owner: *anyopaque) void {
+    const born: u32 = @intCast(prompt.len);
+    var walk: Walk = .{ .store = store, .prompt = prompt, .owner = owner, .at = from, .last = from, .every = if (cfg.anchor_tokens == 0 or !cfg.piece_anchors) 0 else @max(1, cfg.anchor_tokens / cfg.scale), .chunk = @max(1, cfg.chunk / cfg.scale) };
+    for (marks) |m| {
+        walk.to(m);
+        _ = store.keepBorn(prompt, born, m, owner, &.{}, &.{});
+        walk.last = @max(walk.last, m);
+    }
+    walk.to(@intCast(prompt.len));
+}
+
+const Walk = struct {
+    store: *Store,
+    prompt: []const u32,
+    owner: *anyopaque,
+    at: u32,
+    last: u32,
+    every: u32,
+    chunk: u32,
+
+    fn to(w: *Walk, end: u32) void {
+        if (end <= w.at) return;
+        if (w.every > 0) while (w.at + w.chunk < end) {
+            w.at += w.chunk;
+            if (w.at - w.last < w.every) continue;
+            _ = w.store.keepAnchor(w.prompt, @intCast(w.prompt.len), w.at, w.owner, &.{}, &.{});
+            w.last = w.at;
+        };
+        w.at = end;
+    }
+};
diff --git a/zig/src/core/prompt_cache_replay_test.zig b/zig/src/core/prompt_cache_replay_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cb67301db4fb41f4c1ca0518242f4b13850412d8
--- /dev/null
+++ b/zig/src/core/prompt_cache_replay_test.zig
@@ -0,0 +1,29 @@
+const std = @import("std");
+const replay = @import("prompt_cache_replay.zig");
+
+fn same(a: replay.Result, b: replay.Result) !void {
+    try std.testing.expectEqual(a.requests, b.requests);
+    try std.testing.expectEqual(a.prefilled, b.prefilled);
+    try std.testing.expectEqual(a.hits, b.hits);
+    try std.testing.expectEqual(a.misses, b.misses);
+    try std.testing.expectEqual(a.evicted_superseded, b.evicted_superseded);
+    try std.testing.expectEqual(a.evicted_idle, b.evicted_idle);
+    try std.testing.expectEqual(a.peak_states, b.peak_states);
+    try std.testing.expectEqual(a.long_cold, b.long_cold);
+}
+
+const small: replay.Config = .{ .agents = 12, .seconds = 3600, .budget = 5 << 30, .scale = 4 };
+
+test "pcache replay: the explain line changes no keep or eviction of an agent trace" {
+    const gpa = std.testing.allocator;
+    for ([_]bool{ false, true }) |user_role| {
+        var cfg = small;
+        cfg.user_role_tools = user_role;
+        const off = try replay.run(gpa, cfg);
+        cfg.keeping.explain = true;
+        const on = try replay.run(gpa, cfg);
+        try same(off, on);
+        try std.testing.expect(off.requests > 200 and off.evicted_idle + off.evicted_superseded > 0);
+        try std.testing.expect(on.explain.shallow > 0);
+    }
+}
diff --git a/zig/src/core/prompt_cache_share.zig b/zig/src/core/prompt_cache_share.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e215f8adea23f5b00d597d2cf6132c97ca47f6f8
--- /dev/null
+++ b/zig/src/core/prompt_cache_share.zig
@@ -0,0 +1,80 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const modes = @import("cache_modes.zig");
+
+pub fn added(s: *const pc.Store, base: u32, at: u32) u64 {
+    const f = s.family.vtable;
+    const fixed = f.bytes(s.family.ptr, 0);
+    if (base == 0) return f.bytes(s.family.ptr, at);
+    if (at <= base) return fixed;
+    return fixed + f.bytes(s.family.ptr, at) - f.bytes(s.family.ptr, base);
+}
+
+pub fn addedFor(s: *const pc.Store, owner: ?*anyopaque, at: u32) u64 {
+    if (s.family.vtable.added) |f| return f(s.family.ptr, owner, at);
+    return s.family.vtable.bytes(s.family.ptr, at);
+}
+
+fn prefixOf(short: *const pc.Entry, long: *const pc.Entry) bool {
+    if (short.at >= long.at or short.tokens.len > long.tokens.len) return false;
+    const n = short.tokens.len;
+    if (n > 0 and long.tokens[n - 1] != short.tokens[n - 1]) return false;
+    if (!std.mem.eql(u32, long.tokens[0..n], short.tokens)) return false;
+    return modes.equal(short.decode_spans, long.decode_spans, short.at);
+}
+
+fn setBelow(o: *pc.Entry, b: ?*pc.Entry) void {
+    if (o.below) |old| old.kids -= 1;
+    o.below = b;
+    if (b) |x| x.kids += 1;
+}
+
+pub fn linkBelow(s: *pc.Store, e: *pc.Entry) void {
+    var best: ?*pc.Entry = null;
+    for (s.entries.items) |o| {
+        if (o == e or o.expired) continue;
+        if (o.at < e.at) {
+            if ((best == null or o.at > best.?.at) and prefixOf(o, e)) best = o;
+        } else if (o.at > e.at) {
+            if ((o.below == null or o.below.?.at < e.at) and prefixOf(e, o)) setBelow(o, e);
+        }
+    }
+    setBelow(e, best);
+}
+
+pub fn unlinkBelow(s: *pc.Store, e: *pc.Entry) void {
+    for (s.entries.items) |o| if (o != e and o.below == e) setBelow(o, e.below);
+    setBelow(e, null);
+}
+
+fn rewindOn(s: *const pc.Store, e: *const pc.Entry, prompt: []const u32) bool {
+    return !e.expired and e.at == s.active_rewind_at and e.tokens.len <= prompt.len and std.mem.eql(u32, prompt[0..e.tokens.len], e.tokens);
+}
+
+pub fn gap(e: *const pc.Entry) u32 {
+    return e.at - if (e.below) |b| b.at else 0;
+}
+
+pub fn cheap(s: *const pc.Store, skip: ?*pc.Entry, prompt: []const u32) ?usize {
+    var best: ?usize = null;
+    for (s.entries.items, 0..) |e, i| {
+        if (e.kids == 0 or e.expired or e.borrowers > 0 or e == skip or e.shared or e.branched or e.live > 0) continue;
+        if (best) |b| {
+            const o = s.entries.items[b];
+            if (gap(e) > gap(o) or (gap(e) == gap(o) and e.used >= o.used)) continue;
+        }
+        if (rewindOn(s, e, prompt)) continue;
+        best = i;
+    }
+    return best;
+}
+
+pub fn evictCheap(s: *pc.Store, prompt: []const u32, born: u32) bool {
+    if (cheap(s, null, prompt) == null) return false;
+    return s.evictBut(null, prompt, born);
+}
+
+pub fn report(s: *const pc.Store) void {
+    if (@import("builtin").is_test) return;
+    std.log.info("prompt cache share: {d} MiB read by later states after theirs went; anchors kept {d}, refused {d}; cheap states evicted {d}", .{ s.orphans() >> 20, s.counts.anchors, s.counts.anchor_refused, s.counts.evicted_anchor });
+}
diff --git a/zig/src/core/prompt_cache_share_test.zig b/zig/src/core/prompt_cache_share_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..deef7a9e943dec7c33ab7b1a41fab227a125882d
--- /dev/null
+++ b/zig/src/core/prompt_cache_share_test.zig
@@ -0,0 +1,207 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const replay = @import("prompt_cache_replay.zig");
+
+const fixed: u64 = 1000;
+const per: u64 = 10;
+const rules: pc.Rules = .{ .lookahead = 1, .min_gap = 256, .min_prompt = 512 };
+
+fn conv(out: []u32, c: u32) void {
+    for (out, 0..) |*t, i| t.* = if (i < 600) @intCast(i) else 0x8000_0000 | c << 20 | @as(u32, @intCast(i));
+}
+
+const Turn = struct { from: u32, kept: usize };
+
+fn turn(store: *pc.Store, sim: *replay.Sim, owner: *anyopaque, prompt: []const u32) !Turn {
+    const gpa = std.testing.allocator;
+    const l = try store.lookupUser(gpa, prompt, @intCast(prompt.len), @intCast(prompt.len - 3), 0, 0, &.{}, &.{}, &.{});
+    defer gpa.free(l.marks);
+    sim.fresh(owner);
+    var from: u32 = 0;
+    if (l.entry) |e| {
+        try store.family.vtable.restore(store.family.ptr, owner, e.saved);
+        store.resumed(e, prompt, true);
+        from = e.at;
+    }
+    var kept: usize = 0;
+    for (l.marks) |m| kept += @intFromBool(store.keepBorn(prompt, @intCast(prompt.len), m, owner, &.{}, &.{}));
+    return .{ .from = from, .kept = kept };
+}
+
+test "pcache share: a conversation's later turn keeps only its new rows and the fixed pieces" {
+    const gpa = std.testing.allocator;
+    var sim = replay.Sim.init(gpa, fixed, per, true);
+    defer sim.deinit();
+    var store = pc.Store.init(gpa, sim.snapshots(), rules, 1 << 30);
+    defer store.deinit();
+    store.share = true;
+    var toks: [3000]u32 = undefined;
+    conv(&toks, 1);
+    var owner: u8 = 0;
+    const a = try turn(&store, &sim, &owner, toks[0..2000]);
+    try std.testing.expectEqual(@as(u32, 0), a.from);
+    try std.testing.expectEqual(fixed + per * 1997, store.held);
+    const b = try turn(&store, &sim, &owner, toks[0..3000]);
+    try std.testing.expectEqual(@as(u32, 1997), b.from);
+    try std.testing.expectEqual(2 * fixed + per * 2997, store.held + store.orphans());
+    try std.testing.expectEqual(@as(usize, 2), store.entries.items.len);
+    try std.testing.expectEqual(@as(usize, 2), sim.rows.live());
+    const older = for (store.entries.items) |e| {
+        if (e.at == 1997) break e;
+    } else unreachable;
+    try std.testing.expectEqual(@as(u32, 1), older.kids);
+}
+
+test "pcache share: off, the same turns hold two full copies and ask no share hook" {
+    const gpa = std.testing.allocator;
+    var sim = replay.Sim.init(gpa, fixed, per, false);
+    defer sim.deinit();
+    var store = pc.Store.init(gpa, sim.snapshots(), rules, 1 << 30);
+    defer store.deinit();
+    var toks: [3000]u32 = undefined;
+    conv(&toks, 1);
+    var owner: u8 = 0;
+    _ = try turn(&store, &sim, &owner, toks[0..2000]);
+    _ = try turn(&store, &sim, &owner, toks[0..3000]);
+    try std.testing.expectEqual(2 * fixed + per * (1997 + 2997), store.held);
+    try std.testing.expectEqual(@as(u64, 0), store.orphans());
+    try std.testing.expectEqual(@as(usize, 0), sim.rows.live());
+}
+
+test "pcache share: an older turn's state goes before any conversation's newest, the smallest gap first" {
+    const gpa = std.testing.allocator;
+    var sim = replay.Sim.init(gpa, fixed, per, true);
+    defer sim.deinit();
+    var store = pc.Store.init(gpa, sim.snapshots(), rules, 1 << 30);
+    defer store.deinit();
+    store.share = true;
+    var x: [4000]u32 = undefined;
+    var y: [4000]u32 = undefined;
