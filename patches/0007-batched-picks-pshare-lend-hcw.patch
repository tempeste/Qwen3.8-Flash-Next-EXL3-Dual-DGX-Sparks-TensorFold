+        try tk.hcwDecUpP(c.t, c.r.s, ti, ctas, c.act, c.wup.codes, c.h, w.rinv, c.scale, c.mixed, c.xsm, c.rows, dims);
+    }
+
+    fn poisonRinv(w: *Hcw) !void {
+        try (cuda.DeviceBuffer{ .d = w.c.r.gpu.d, .ptr = w.rinv, .len = w.c.rows * streams * 4 }).fill8(0xff, w.c.r.s.handle);
+    }
+
+    fn down(w: *Hcw, dn: u8) !void {
