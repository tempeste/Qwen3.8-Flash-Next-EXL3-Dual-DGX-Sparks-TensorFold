+pub const Pace = struct {
+    pub const max_decoders = 64;
+    pub const least_scale: f64 = 0.25;
+    pub const most_scale: f64 = 4;
+    pub const kept_share: f64 = 0.3;
+
+    plain_ns: [max_decoders + 1]i64 = @splat(0),
+    scale: f64 = 1,
+    riding: u64 = 0,
+
+    pub fn plainAt(pc: *const Pace, decoders: usize) i64 {
+        const k = @min(decoders, max_decoders);
+        for (0..max_decoders + 1) |dist| {
+            if (k + dist <= max_decoders and pc.plain_ns[k + dist] != 0) return pc.plain_ns[k + dist];
+            if (k >= dist and pc.plain_ns[k - dist] != 0) return pc.plain_ns[k - dist];
+        }
+        return 0;
+    }
+
+    pub fn share(_: *const Pace, p: Plan, at: f64) f64 {
+        return @max(p.share(at), kept_share);
+    }
+
+    pub fn rows(pc: *const Pace, p: Plan, at: f64, decoders: usize, least: u32, most: u32) u32 {
+        const top = @max(least, most);
+        const plain = pc.plainAt(decoders);
+        if (plain == 0) return least;
+        const s = pc.share(p, at);
+        const room = @as(f64, @floatFromInt(plain)) * (1 - s) / s / pc.scale - @as(f64, @floatFromInt(piece_base_ns));
+        if (!(room > 0)) return least;
+        const n = @min(room / @as(f64, @floatFromInt(piece_row_ns)), @as(f64, @floatFromInt(top)));
+        const whole: u32 = @intFromFloat(n);
+        return std.math.clamp(whole / row_step * row_step, least, top);
+    }
+
+    pub fn round(pc: *Pace, ns: i64, decoders: usize) i64 {
+        const n = pc.riding;
+        pc.riding = 0;
+        if (ns <= 0) return 0;
+        if (n == 0) {
+            const b = &pc.plain_ns[@min(decoders, max_decoders)];
+            b.* = if (b.* == 0) ns else @divTrunc(3 * b.* + ns, 4);
+            return ns;
+        }
+        const model: f64 = @floatFromInt(Plan.init(0).pieceNs(n));
+        const plain = pc.plainAt(decoders);
+        if (plain > 0) {
+            const seen = std.math.clamp(@as(f64, @floatFromInt(ns - plain)) / model, least_scale, most_scale);
+            pc.scale = (3 * pc.scale + seen) / 4;
+        }
+        return @max(0, ns - @as(i64, @intFromFloat(pc.scale * model)));
+    }
+};
+
 fn lerp(a: f64, b: f64, at: f64) f64 {
     return a + (b - a) * std.math.clamp(at, 0, 1);
 }
