+    fn round(x: *Lane28) void {
+        const p = x.waiting.take() orelse return;
+        x.rode += 1;
+        x.rode_last += @intFromBool(p.stop >= x.len);
+        x.rows_run += p.stop - p.at;
+        x.filled = if (p.stop >= x.len) null else p.stop;
+        x.prompt_in_unreported = p.stop >= x.len;
+    }
