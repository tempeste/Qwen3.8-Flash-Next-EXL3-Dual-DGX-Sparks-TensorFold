+    for (cuts) |c| {
+        try session.forward(Tri, tri, &r, toks[pos..c], hooks);
+        pos = c;
+    }
+    return r;
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const gpa = gpu.gpa;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpa, .limited(1 << 20));
+    defer gpa.free(source);
+    var ids: std.ArrayList(u32) = .empty;
+    defer ids.deinit(gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try ids.append(gpa, try std.fmt.parseInt(u32, word, 10));
+    if (ids.items.len < 16) return error.BadPrompt;
+    var cuda_stream = try cuda.Stream.init(gpu.d, true);
+    defer cuda_stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = cuda_stream, .own = &glue };
+    const e = try prompt.Engine.initRank(gpa, gpu.io, @constCast(gpu.d), &cuda_stream, dir, 2, rank);
+    defer e.deinit();
+    const identity = try flash.rank_engine.identity(gpa, gpu.io, dir, context, e.chunk);
+    const session = try Session.init(gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    defer {
+        e.collective = null;
+        session.deinit();
+    }
+    session.engine = e;
+    e.collective = &session.collective;
+    if (knobs.tpRoce()) try session.collective.openRoce(gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed every keeping order's saves, restores and drops", .{});
+        return;
+    }
+    var streams: [convs][promptLen(turns - 1)]u32 = undefined;
+    for (&streams, 0..) |*s, c| stream(s, ids.items, c);
+    var copies: Copies = .{ .session = session };
+    const per_state = Copies.bytes(&copies, @intCast(promptLen(turns - 1)));
+    for (arms) |arm| {
+        var store = pc.Store.init(gpa, copies.snapshots(), .{ .lookahead = 1, .min_gap = 256, .min_prompt = 512 }, 3 * per_state + per_state / 2);
+        store.keeping = arm.keeping;
+        var cuts_of: std.AutoHashMapUnmanaged(usize, []u32) = .empty;
+        defer {
+            var it = cuts_of.valueIterator();
+            while (it.next()) |v| gpa.free(v.*);
+            cuts_of.deinit(gpa);
+            store.deinit();
+        }
+        var prefilled: u64 = 0;
+        var resumed: u64 = 0;
+        var checked: usize = 0;
+        for (0..turns) |t| for (0..convs) |c| {
+            const toks = streams[c][0..promptLen(t)];
+            const history: u32 = @intCast(toks.len - 3);
+            const rewind: u32 = if (t == 0) head + 3 else @intCast(promptLen(t - 1) + 100);
+            const l = try store.lookupUser(gpa, toks, @intCast(toks.len), history, rewind, history, &.{head}, &.{}, &.{});
+            defer gpa.free(l.marks);
+            var q = try session.create(context);
+            defer session.drop(&q);
+            var cuts: std.ArrayList(u32) = .empty;
+            defer cuts.deinit(gpa);
+            var pos: usize = 0;
+            if (l.entry) |entry| {
+                try session.restore(&q, null, @ptrCast(@alignCast(entry.saved)));
+                try cuts.appendSlice(gpa, cuts_of.get(@intFromPtr(entry.saved)) orelse return error.UnknownCuts);
+                pos = entry.at;
+                store.resumed(entry, toks, true);
+                resumed += 1;
+            }
+            prefilled += toks.len - pos;
+            for (l.marks) |m| {
+                if (m <= pos) continue;
+                try session.forward(flash.Tri, tri, &q, toks[pos..m], hooks);
+                try cuts.append(gpa, m);
+                pos = m;
+                if (store.keep(toks, m, &q, &.{}, &.{})) if (store.last_kept) |k| if (!cuts_of.contains(@intFromPtr(k.saved))) {
+                    try cuts_of.put(gpa, @intFromPtr(k.saved), try gpa.dupe(u32, cuts.items));
+                };
+            }
+            var it = cuts_of.iterator();
+            while (it.next()) |kv| {
+                const live = for (store.entries.items) |x| {
+                    if (@intFromPtr(x.saved) == kv.key_ptr.*) break true;
+                } else false;
+                if (!live) {
+                    gpa.free(kv.value_ptr.*);
+                    cuts_of.removeByPtr(kv.key_ptr);
+                    it = cuts_of.iterator();
+                }
+            }
+            if (pos < toks.len) {
+                try session.forward(flash.Tri, tri, &q, toks[pos..], hooks);
+                try cuts.append(gpa, @intCast(toks.len));
+            }
+            var r = try replayCuts(session, flash.Tri, tri, toks, cuts.items);
+            defer session.drop(&r);
+            try check.sameBytes("a turn resumed from the kept state equals a cold prefill with the same passes", q.logits, r.logits);
+            try check.expect(std.mem.eql(i64, &q.history, &r.history), "n-gram history after the resumed turn matches the cold prefill", .{});
+            const next = ids.items[(t * 5 + c) % ids.items.len];
+            try session.forward(flash.Tri, tri, &q, &.{next}, hooks);
+            try session.forward(flash.Tri, tri, &r, &.{next}, hooks);
+            try check.sameBytes("the row after a resumed turn equals the cold prefill's", q.logits, r.logits);
+            checked += 1;
+        };
+        check.pass("{s}: {d} turns byte-equal to cold prefills; resumed {d}, prefilled {d} tokens; evicted {d} (superseded {d}, shadowed {d}, idle {d}); explain shallow {d}", .{ arm.name, checked, resumed, prefilled, store.counts.evicted, store.counts.evicted_superseded, store.counts.evicted_shadowed, store.counts.evicted_idle, store.explained.counts.shallow });
+    }
+}
diff --git a/zig/tests/cuda/flashnext_pidle_tests.zig b/zig/tests/cuda/flashnext_pidle_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9ae3d0359a568ca7b613b312b4c548a426b2739c
--- /dev/null
+++ b/zig/tests/cuda/flashnext_pidle_tests.zig
@@ -0,0 +1,211 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+
+const flags = [_][:0]const u8{ "TF_FLASHNEXT_GATHER_OPEN", "TF_FLASHNEXT_RESTORE_ASYNC", "TF_FLASHNEXT_DRAFT_KEEP" };
+const passes = [_]usize{ 300, 1000 };
+const reps = 5;
+const Arm = enum { off, on };
+const Case = enum { last, next, prefix_rest, other_open, after_cancel };
+const cases = std.enums.values(Case);
+
+fn cachedChunks(chunk: usize) !usize {
+    const want = if (std.c.getenv("TF_PIDLE_TEST_CACHED")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else 81920;
+    return std.math.divCeil(usize, @max(want, 1), chunk) catch unreachable;
+}
+
+fn setArm(a: Arm) void {
+    for (flags) |f| {
+        if (a == .on) _ = env.setenv(f, "1", 1) else _ = env.unsetenv(f);
+    }
+}
+
+fn rows(out: []u32, seed: []const u32, mul: usize, add: usize) void {
+    for (out, 0..) |*t, i| t.* = seed[(i * mul + add) % seed.len];
+}
+
+fn early(e: *prompt.Engine, gpa: std.mem.Allocator, io: std.Io, at: usize, history: []const i64, ids: []const u32, ends: []const usize) !void {
+    if (e.gather_open.busy()) e.gather_open.release();
+    try e.gather_open.start(gpa, io, &e.ngram, at, history, ids, ends);
+}
+
+fn headBlock(gpu: check.Gpu, e: *prompt.Engine, session: *flash.rank_engine.Session, stream: cuda.Stream) !void {
+    const Draft = flash.mtp.Draft;
+    const cap = 4096;
+    const draft_n = 32768;
+    const need = Draft.cachesBytes(e.kv, cap);
+    var parts = try cuda.DeviceBuffer.alloc(gpu.d, Draft.partsBytes(draft_n, e.chunk, e.heads));
+    defer parts.free();
+    var block = try session.blocks.takeHead(gpu.d, need);
+    try block.fill8(0xab, stream.handle);
+    const first = block.ptr;
+    session.blocks.giveHead(block);
+    block = try session.blocks.takeHead(gpu.d, need - need / 8);
+    try check.expect(block.ptr == first, "a head block within a quarter of the need is the kept one", .{});
+    session.blocks.giveHead(block);
+    block = try session.blocks.takeHead(gpu.d, need);
+    try check.expect(block.ptr == first, "the kept head block serves the same need again", .{});
+    var d = try Draft.initPartsWith(e.kv, gpu.gpa, @constCast(gpu.d), stream, cap, draft_n, e.chunk, e.heads, parts, block, null);
+    var plain = try Draft.initPartsFor(e.kv, gpu.gpa, @constCast(gpu.d), stream, cap, draft_n, e.chunk, e.heads, parts);
+    try stream.synchronize();
+    for ([_][2]cuda.DeviceBuffer{ .{ d.kc, plain.kc }, .{ d.vc, plain.vc }, .{ d.ikc, plain.ikc }, .{ d.pooled, plain.pooled } }) |pair| {
+        try check.expect(pair[0].len == pair[1].len, "a kept head cache view has its own buffer's length ({d} vs {d})", .{ pair[0].len, pair[1].len });
+        try check.expect(pair[0].ptr >= block.ptr and pair[0].ptr + pair[0].len <= block.ptr + block.len, "a kept head cache view lies in the kept block", .{});
+        const got = try gpu.gpa.alloc(u8, pair[0].len);
+        defer gpu.gpa.free(got);
+        try pair[0].download(0, got);
+        try check.expect(std.mem.allEqual(u8, got, 0), "a kept head cache view a dirty block backs reads back zero", .{});
+    }
+    plain.deinit();
+    d.deinit();
+    session.blocks.giveHead(block);
+    block = try session.blocks.takeHead(gpu.d, need * 2);
+    try check.expect(block.len == need * 2, "a head block past the kept one's size is a fresh allocation", .{});
+    session.blocks.giveHead(block);
+    session.blocks.release();
+    try check.expect(session.blocks.idle_head == null, "release frees the kept head block", .{});
+    check.pass("kept head caches: reused within a quarter, zero in every view, the same lengths as allocated ones, freed by release", .{});
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    var given: [flags.len]?[:0]const u8 = undefined;
+    for (flags, &given) |f, *g| g.* = if (std.c.getenv(f)) |v| std.mem.span(v) else null;
+    defer for (flags, given) |f, g| {
+        if (g) |v| _ = env.setenv(f, v, 1) else _ = env.unsetenv(f);
+    };
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const cached = chunk * try cachedChunks(chunk);
+    const most = passes[passes.len - 1];
+    const context = cached + 2 * most + 64;
+    if (context > prompt.max_tokens or most > chunk) return error.BadPrompt;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len < 8) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, cached + most);
+    defer gpu.gpa.free(ids);
+    rows(ids, seed.items, 1, 0);
+    const other = try gpu.gpa.alloc(u32, cached + most);
+    defer gpu.gpa.free(other);
+    @memcpy(other[0..cached], ids[0..cached]);
+    rows(other[cached..], seed.items, 7, 3);
+    const cold = try gpu.gpa.alloc(u32, cached + most);
+    defer gpu.gpa.free(cold);
+    @memcpy(cold[0..cached], ids[0..cached]);
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank);
+    defer e.deinit();
+    if (e.chunk != chunk) return error.EngineChunk;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 2 * prompt.vocabulary * 2);
+    defer logits.free();
+    const row = prompt.vocabulary * 2;
+    var want: [passes.len][cases.len][]u8 = undefined;
+    for (&want) |*w| for (w) |*r| {
+        r.* = try gpu.gpa.alloc(u8, row);
+    };
+    defer for (want) |w| for (w) |r| gpu.gpa.free(r);
+    var ms: [2][passes.len]f64 = @splat(@splat(0));
+    const knobs = flash.knobs;
+    const peer = try knobs.tpPlePeer();
+    for (std.enums.values(Arm), 0..) |a, ai| {
+        setArm(a);
+        const on = a == .on;
+        if (try knobs.gatherOpen() != on or try knobs.restoreAsync() != on or try knobs.draftKeep() != on) return error.TestFailed;
+        const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port + @as(u16, @intCast(ai)), rank, identity, flash.rank_engine.linkWait());
+        defer {
+            e.collective = null;
+            session.deinit();
+        }
+        session.engine = e;
+        e.collective = &session.collective;
+        if (knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+        if (rank == 1) {
+            try session.follow(flash.Tri, tri, logits.ptr);
+            check.pass("rank 1 followed the {s} arm", .{@tagName(a)});
+            continue;
+        }
+        if (on) try headBlock(gpu, e, session, stream);
+        var q = try session.create(context);
+        var q_live = true;
+        defer if (q_live) session.drop(&q);
+        var at: usize = 0;
+        while (at < cached) : (at += chunk) try session.forward(flash.Tri, tri, &q, ids[at .. at + chunk], .{ .logits = .none, .prompt = true });
+        const kept = try session.save(&q, null);
+        defer session.dropSaved(kept);
+        const hist = kept.history;
+        for (passes, 0..) |n, pi| {
+            const keep = struct {
+                fn same(arm: Arm, w: []u8, got: []const u8, what: []const u8, nn: usize) !void {
+                    if (arm == .off) {
+                        @memcpy(w, got);
+                        return;
+                    }
+                    try check.sameBytes(what, got, w);
+                    check.pass("on arm, {d} rows: {s} equals the off arm's bytes", .{ nn, what });
+                }
+            };
+            if (on) try early(e, gpu.gpa, gpu.io, cached, &hist, ids[cached .. cached + n], &.{n});
+            try session.restore(&q, null, kept);
+            try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true });
+            try keep.same(a, want[pi][@backingInt(Case.last)], q.logits, "last row", n);
+            if (on and !peer) try check.expect(e.gather_open.claimed, "the {d}-row pass took the rows gathered at open", .{n});
+            try session.forward(flash.Tri, tri, &q, &.{13}, .{});
+            try keep.same(a, want[pi][@backingInt(Case.next)], q.logits, "next row", n);
+
+            const h = n / 2;
+            if (on) try early(e, gpu.gpa, gpu.io, cached, &hist, ids[cached .. cached + n], &.{ h, n });
+            try session.restore(&q, null, kept);
+            try session.forward(flash.Tri, tri, &q, ids[cached .. cached + h], .{ .logits = .none, .prompt = true });
+            try session.forward(flash.Tri, tri, &q, ids[cached + h .. cached + n], .{ .logits = .last, .prompt = true });
+            try keep.same(a, want[pi][@backingInt(Case.prefix_rest)], q.logits, "a pass of the first half's rows from two gathered blocks, then the rest", n);
+
+            if (on) try early(e, gpu.gpa, gpu.io, cached, &hist, other[cached .. cached + n], &.{n});
+            try session.restore(&q, null, kept);
+            try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true });
+            if (on) try check.expect(!e.gather_open.claimed, "a pass of other tokens leaves the rows gathered at open", .{});
+            try keep.same(a, want[pi][@backingInt(Case.other_open)], q.logits, "a pass after another stream's open (its rows not taken)", n);
+            if (on) try check.sameBytes("the pass after another stream's open vs the plain pass", q.logits, want[pi][@backingInt(Case.last)]);
+
+            if (on) try early(e, gpu.gpa, gpu.io, cached, &hist, other[cached .. cached + n], &.{ h, n });
+            try session.restore(&q, null, kept);
+            try session.forward(flash.Tri, tri, &q, other[cached .. cached + h], .{ .logits = .none, .prompt = true });
+            session.drop(&q);
+            q_live = false;
+            q = try session.create(context);
+            q_live = true;
+            if (on) try early(e, gpu.gpa, gpu.io, cached, &hist, ids[cached .. cached + n], &.{n});
+            try session.restore(&q, null, kept);
+            try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true });
+            try keep.same(a, want[pi][@backingInt(Case.after_cancel)], q.logits, "a fresh stream's pass after one cancelled half way", n);
+            if (on) try check.sameBytes("the pass after a cancelled stream vs the plain pass", q.logits, want[pi][@backingInt(Case.last)]);
+
+            var t: [reps]f64 = undefined;
+            for (0..reps) |r| {
+                rows(cold[cached..], seed.items, 2 * (r + reps * ai) + 3, 17 * r + 101 * ai + n);
+                try stream.synchronize();
+                const t0 = check.now(gpu.io);
+                if (on) try early(e, gpu.gpa, gpu.io, cached, &hist, cold[cached .. cached + n], &.{n});
+                try session.restore(&q, null, kept);
+                try session.forward(flash.Tri, tri, &q, cold[cached .. cached + n], .{ .logits = .last, .prompt = true });
+                t[r] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+            }
+            ms[ai][pi] = check.median(&t);
+        }
+        e.gather_open.release();
+    }
+    if (rank == 1) return;
+    for (passes, 0..) |n, pi| {
+        std.debug.print("RESULT flashnext-pidle-bench cached {d} rows {d} (cold n-gram rows each rep): restore + pass median of {d}: off {d:.2} ms, on {d:.2} ms, saves {d:.2} ms\n", .{ cached, n, reps, ms[0][pi], ms[1][pi], ms[0][pi] - ms[1][pi] });
+    }
+}
