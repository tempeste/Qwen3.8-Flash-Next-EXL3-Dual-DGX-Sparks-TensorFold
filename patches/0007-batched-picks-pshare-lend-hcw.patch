+        const fm = @as(f64, @floatFromInt(m));
+        const rows_b = fm * kb;
+        const sk = decSk(c, ws[0]);
+        const nm = try decTime(c, start, end, &ws, decNorm, 0);
+        const od = try decTime(c, start, end, &ws, decOldDown, 0);
+        const ora = try decTime(c, start, end, &ws, decOldReduce, 0);
+        const ou = try decTime(c, start, end, &ws, decOldUp, 0);
+        const om = try decTime(c, start, end, &ws, decOldMix, 0);
