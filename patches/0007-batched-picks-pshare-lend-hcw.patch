+test "pcache share: segments chain on a lane's base, reuse it below its rows, and start cold without one" {
+    var r = Test.init(std.testing.allocator);
+    defer r.deinit();
+    var freed: std.ArrayList(u32) = .empty;
+    defer freed.deinit(std.testing.allocator);
+    try std.testing.expectEqual(Test.Step.cold, r.step(.{}, 100, 0));
+    const a = try r.make(null, 0, 1000, 10, 0, 1);
+    try std.testing.expect(r.step(.{ .id = a.id, .valid = 1000 }, 1200, 0) == .extend);
+    try std.testing.expect(r.step(.{ .id = a.id, .valid = 1000 }, 800, 0) == .reuse);
+    try std.testing.expectEqual(Test.Step.cold, r.step(.{ .id = a.id, .valid = 1000 }, 1200, 1));
+    try std.testing.expectEqual(Test.Step.cold, r.step(.{ .id = a.id + 7, .valid = 1000 }, 1200, 0));
+    const b = try r.make(a, 600, 1500, 9, 0, 2);
+    var buf: [4]Range = undefined;
+    const ranges = try Test.chain(b, 1400, &buf);
+    try std.testing.expectEqual(@as(usize, 2), ranges.len);
+    try std.testing.expectEqual(Range{ .lo = 600, .hi = 1400 }, ranges[0]);
+    try std.testing.expectEqual(Range{ .lo = 0, .hi = 600 }, ranges[1]);
+    const below = try Test.chain(b, 500, &buf);
+    try std.testing.expectEqual(@as(usize, 1), below.len);
