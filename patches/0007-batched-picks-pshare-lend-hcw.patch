     return std.mem.eql(u8, std.mem.span(v), "1");
 }
 
+/// TF_FLASHNEXT_MIXED_LAST (--tp 2 with TF_FLASHNEXT_OVERLAP, else refused at load) lets more pieces wait for the next
+/// decode round and ride it (one piece waits at a time; the lane host ends its visit once one waits). A riding last piece
+/// leaves its last row's scores (the first token's) as its alone pass does. 1 (all): a prompt's last piece, a piece
+/// ending at a cache mark (its keep runs before the lane's next step) and a whole prompt under TF_FLASHNEXT_OVERLAP's
+/// rows, cut at the round's room; TF_FLASHNEXT_MARK_IN_PASS merges only while no stream decodes. 2 (short): only a last
+/// piece of at most TF_FLASHNEXT_MIXED_ROWS rows; marks merge and cut as without it. Rank 1 makes the scores the frame
+/// names (bit 31 of the mixed frame's flags): part of the identity (tp_flags bit 30). Unset or 0: off. Other values
+/// refuse to start (BadMixedLast).
+pub const MixedLast = enum { off, all, short };
+
+pub fn mixedLast() error{BadMixedLast}!MixedLast {
+    return mixedLastSetting(if (std.c.getenv("TF_FLASHNEXT_MIXED_LAST")) |v| std.mem.span(v) else null);
+}
+
+pub fn mixedLastSetting(value: ?[]const u8) error{BadMixedLast}!MixedLast {
+    const v = value orelse return .off;
+    if (std.mem.eql(u8, v, "0")) return .off;
+    if (std.mem.eql(u8, v, "1")) return .all;
+    if (std.mem.eql(u8, v, "2")) return .short;
+    return error.BadMixedLast;
+}
+
+test "TF_FLASHNEXT_MIXED_LAST is off unset or 0, all at 1, short at 2, refuses anything else and sets identity bit 30" {
+    try std.testing.expectEqual(MixedLast.off, try mixedLastSetting(null));
+    try std.testing.expectEqual(MixedLast.off, try mixedLastSetting("0"));
+    try std.testing.expectEqual(MixedLast.all, try mixedLastSetting("1"));
+    try std.testing.expectEqual(MixedLast.short, try mixedLastSetting("2"));
+    for ([_][]const u8{ "", "3", "on", " 1", "1 " }) |bad| try std.testing.expectError(error.BadMixedLast, mixedLastSetting(bad));
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_FLASHNEXT_MIXED_LAST");
+    _ = env.unsetenv("TF_FLASHNEXT_MIXED_LAST");
+    const off = tpFlags();
+    _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "1", 1);
+    try std.testing.expectEqual(off | (@as(u64, 1) << 30), tpFlags());
+    _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "2", 1);
+    try std.testing.expectEqual(off | (@as(u64, 1) << 30), tpFlags());
+}
+
+/// TF_FLASHNEXT_MIXED_SEQPAR=1 (--tp 2 with mixed rounds, else refused at load): a mixed round's piece takes the sums
+/// its alone pass takes (TF_FLASHNEXT_TP_SPLIT_SUM's halves, TF_FLASHNEXT_TP_SEQPAR's row exchanges with
+/// TF_FLASHNEXT_TP_SCATTER_BF16, TF_FLASHNEXT_TP_INDEX_ROWS, TF_FLASHNEXT_TP_PLE_PEER), each on the pass's stream, so
+/// its rows keep their alone bytes. Both ranks must agree (bit 31 of tp_flags). Unset or 0: the piece keeps whole sums.
+/// Other values refuse to start (BadMixedSeqPar).
+pub fn mixedSeqPar() error{BadMixedSeqPar}!bool {
+    return onOff(if (std.c.getenv("TF_FLASHNEXT_MIXED_SEQPAR")) |v| std.mem.span(v) else null) orelse error.BadMixedSeqPar;
+}
+
+test "TF_FLASHNEXT_MIXED_SEQPAR is off unset or 0, on at 1, refuses anything else and sets identity bit 31" {
+    const env = @import("sys").env;
