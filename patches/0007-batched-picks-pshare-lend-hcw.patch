diff --git a/zig/tests/cuda/decode_gemm_tests.zig b/zig/tests/cuda/decode_gemm_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6a037c9cdf7c61f48f3dc18ff0517e125fc93e91
--- /dev/null
+++ b/zig/tests/cuda/decode_gemm_tests.zig
@@ -0,0 +1,354 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const t = @import("prompt_tile2_tests.zig");
+
+const qmmf = cuda.qmmf;
+const rr = cuda.route_rows;
+
+const Shape = struct { name: []const u8, n: usize, k: usize, sk: u32, out: qmmf.Out, per: f64, draft: bool = false };
+
+const shapes = [_]Shape{
+    .{ .name = "DeltaNet in", .n = 8240, .k = 2560, .sk = 1, .out = .bf16, .per = 36 },
+    .{ .name = "attention qkv", .n = 7296, .k = 2560, .sk = 1, .out = .bf16, .per = 12 },
+    .{ .name = "DeltaNet and attention out", .n = 2560, .k = 3072, .sk = 0, .out = .f32, .per = 48 },
+    .{ .name = "shared gate and up", .n = 320, .k = 2560, .sk = 0, .out = .bf16, .per = 96 },
+    .{ .name = "shared down", .n = 2560, .k = 320, .sk = 0, .out = .f32, .per = 48 },
+    .{ .name = "wide columns", .n = 124160, .k = 2560, .sk = 0, .out = .bf16, .per = 0 },
+    .{ .name = "draft-width qkv", .n = 13952, .k = 2560, .sk = 0, .out = .bf16, .per = 0, .draft = true },
+    .{ .name = "draft-width out", .n = 2560, .k = 6144, .sk = 0, .out = .bf16, .per = 0, .draft = true },
+};
+
+const edges = [_]Shape{
+    .{ .name = "odd columns", .n = 70, .k = 512, .sk = 0, .out = .bf16, .per = 0 },
+    .{ .name = "odd columns fp32", .n = 1001, .k = 2560, .sk = 4, .out = .f32, .per = 0 },
+    .{ .name = "two slices", .n = 640, .k = 1024, .sk = 2, .out = .bf16, .per = 0 },
+    .{ .name = "eight slices", .n = 136, .k = 4096, .sk = 8, .out = .f32, .per = 0 },
+};
+
+const rows_checked = [_]usize{ 1, 2, 3, 4, 5, 7, 8, 11, 14, 15, 16, 17, 23, 28, 31, 32, 33, 47, 56, 63, 64, 65, 66, 74, 79, 80, 81, 84, 95, 96 };
+
+const route_e = 513;
+const route_d = 2560;
+const route_rows_checked = [_]usize{ 1, 2, 3, 4, 7, 11, 15, 16, 17, 28, 31, 32, 33, 48, 63, 64, 65, 74, 84, 96, 97, 112, 127, 128 };
+
+fn tobf(v: f32) u16 {
+    const b: u32 = @bitCast(v);
+    return @truncate((b + 0x7fff + ((b >> 16) & 1)) >> 16);
+}
+
+fn lanes(b: usize) [2]usize {
+    return .{ (b * 264 + 50) / 100, b };
+}
+
+const Saved = struct {
+    lane_tile: bool,
+    lane_tile_wide: bool,
+    decode_gemm: bool,
+    dec_warps: usize,
+    route: bool,
+
+    fn take() Saved {
+        return .{ .lane_tile = qmmf.lane_tile, .lane_tile_wide = qmmf.lane_tile_wide, .decode_gemm = qmmf.decode_gemm, .dec_warps = qmmf.dec_warps, .route = rr.decode_rows };
+    }
+    fn restore(s: Saved) void {
+        qmmf.lane_tile = s.lane_tile;
+        qmmf.lane_tile_wide = s.lane_tile_wide;
+        qmmf.decode_gemm = s.decode_gemm;
+        qmmf.dec_warps = s.dec_warps;
+        rr.decode_rows = s.route;
+    }
+};
+
+const Rig = struct {
+    lane: qmmf.Lane,
+    s: cuda.Stream,
+    dx: cuda.DeviceBuffer,
+    dy: cuda.DeviceBuffer,
+    part: cuda.DeviceBuffer,
+    x: []u16,
+    ldx: usize,
+
+    fn init(gpu: check.Gpu, rng: std.Random) !Rig {
+        const major = (try gpu.ctx.capability()) / 10;
+        const ldx = 6144 + 64;
+        const x = try t.activations(gpu, rng, qmmf.dec_rows, 6144, ldx);
+        errdefer gpu.gpa.free(x);
+        var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+        errdefer dx.free();
+        var dy = try cuda.DeviceBuffer.alloc(gpu.d, qmmf.dec_rows * 124160 * 4);
+        errdefer dy.free();
+        var part = try cuda.DeviceBuffer.alloc(gpu.d, 8 * qmmf.dec_rows * 13952 * 4);
+        errdefer part.free();
+        var lane = try qmmf.Lane.load(gpu.d, major);
+        errdefer lane.unload();
+        const s = try cuda.Stream.init(gpu.d, false);
+        return .{ .lane = lane, .s = s, .dx = dx, .dy = dy, .part = part, .x = x, .ldx = ldx };
+    }
+
+    fn deinit(r: *Rig, a: std.mem.Allocator) void {
+        r.s.deinit();
+        r.lane.unload();
+        r.part.free();
+        r.dy.free();
+        r.dx.free();
+        a.free(r.x);
+    }
+
+    fn call(r: *Rig, m: usize, w: qmmf.Weight, out: qmmf.Out) !void {
+        try r.lane.matmulOut(r.s, r.dx.ptr, r.ldx, m, w, r.dy.ptr, out, r.part.ptr);
+    }
+
+    fn result(r: *Rig, dst: []u8) !void {
+        try r.s.synchronize();
+        try r.dy.download(0, dst);
+    }
+};
+
+fn weightFor(h: t.Host, sh: Shape) !qmmf.Weight {
+    return if (sh.sk == 0) h.w else try qmmf.pinned(h.w, sh.sk);
+}
+
+fn outBytes(m: usize, sh: Shape) usize {
+    return m * sh.n * @as(usize, if (sh.out == .f32) 4 else 2);
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const saved = Saved.take();
+    defer saved.restore();
+    var prng = std.Random.DefaultPrng.init(0xdec0_6e33);
+    const rng = prng.random();
+    var r = try Rig.init(gpu, rng);
+    defer r.deinit(a);
+    try check.expect(r.lane.clusters, "the decode tile folds its slices in a cluster: sm_90 or later", .{});
+    var calls: usize = 0;
+    var taken: usize = 0;
+    for (shapes ++ edges) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const w = try weightFor(h, sh);
+        const want = try a.alloc(u8, outBytes(qmmf.dec_rows, sh));
+        defer a.free(want);
+        const got = try a.alloc(u8, outBytes(qmmf.dec_rows, sh));
+        defer a.free(got);
+        for (rows_checked) |m| {
+            const bytes = outBytes(m, sh);
+            for ([_]bool{ false, true }) |lt| {
+                qmmf.decode_gemm = false;
+                qmmf.lane_tile = lt;
+                try r.dy.fill8(0xff, r.s.handle);
+                try r.call(m, w, sh.out);
+                try r.result(want[0..bytes]);
+                qmmf.decode_gemm = true;
+                try check.expect(r.lane.decodeTakes(m, w), "{s}: {d} rows not on the decode tile", .{ sh.name, m });
+                for ([_]usize{ 0, 2, 4, 8 }) |nw| {
+                    qmmf.dec_warps = nw;
+                    try r.dy.fill8(0xa5, r.s.handle);
+                    try r.call(m, w, sh.out);
+                    try r.result(got[0..bytes]);
+                    check.sameBytes("decode tile against the lane kernel", got[0..bytes], want[0..bytes]) catch |err| {
+                        std.debug.print("FAIL at {s} n {d} k {d} sk {d} rows {d} lane_tile {any} warps {d}\n", .{ sh.name, sh.n, sh.k, qmmf.planFor(m, w, true).sk, m, lt, nw });
+                        return err;
+                    };
+                    taken += 1;
+                }
+                qmmf.dec_warps = 0;
+                calls += 1;
+            }
+        }
+        qmmf.decode_gemm = true;
+        try check.expect(!r.lane.decodeTakes(qmmf.dec_rows + 1, w) or qmmf.planFor(qmmf.dec_rows + 1, w, true).fused, "{s}: 97 rows taken", .{sh.name});
+    }
+    check.pass("TF_FLASHNEXT_DECODE_GEMM: the decode tile equals the lane kernel (lane tile off and on) byte for byte at {d} calls, {d} launches: {d} shapes (DeltaNet in, attention qkv, out projections K 3072 in 4 slices, shared expert, 124160 columns, 13952 columns, K 6144 in 8 slices, odd columns, 2 and 8 slices), 1-96 rows, bf16 and fp32, 2/4/8 warps and the engine's pick", .{ calls, taken, shapes.len + edges.len });
+    try routeBytes(gpu, &r, rng);
+}
+
+const Route = struct {
+    rt: rr.RouteRows,
+    dw: cuda.DeviceBuffer,
+    dl: cuda.DeviceBuffer,
+
+    fn init(gpu: check.Gpu, rng: std.Random, copies: usize) !Route {
+        const a = gpu.gpa;
+        const w = try a.alloc(u16, route_e * route_d);
+        defer a.free(w);
+        for (w) |*v| v.* = tobf(@floatCast(rng.floatNorm(f64) * 0.03));
+        var dw = try cuda.DeviceBuffer.alloc(gpu.d, copies * w.len * 2);
+        errdefer dw.free();
+        for (0..copies) |c| try dw.upload(c * w.len * 2, std.mem.sliceAsBytes(w));
+        var dl = try cuda.DeviceBuffer.alloc(gpu.d, rr.decode_most * route_e * 4);
+        errdefer dl.free();
+        var rt = try rr.RouteRows.load(gpu.d);
+        errdefer rt.unload();
+        return .{ .rt = rt, .dw = dw, .dl = dl };
+    }
+
+    fn deinit(g: *Route) void {
+        g.rt.unload();
+        g.dl.free();
+        g.dw.free();
+    }
+
+    fn call(g: *const Route, r: *Rig, m: usize, copy: usize) !void {
+        try g.rt.logits(r.s, r.dx.ptr, r.ldx, g.dw.ptr + copy * route_e * route_d * 2, g.dl.ptr, m, route_d, route_e);
+    }
+};
+
+fn routeBytes(gpu: check.Gpu, r: *Rig, rng: std.Random) !void {
+    const a = gpu.gpa;
+    var g = try Route.init(gpu, rng, 1);
+    defer g.deinit();
+    var rx = try cuda.DeviceBuffer.alloc(gpu.d, rr.decode_most * r.ldx * 2);
+    defer rx.free();
+    const xs = try t.activations(gpu, rng, rr.decode_most, route_d, r.ldx);
+    defer a.free(xs);
+    try rx.upload(0, std.mem.sliceAsBytes(xs));
+    const keep = r.dx;
+    r.dx = rx;
+    defer r.dx = keep;
+    const want = try a.alloc(u8, rr.decode_most * route_e * 4);
+    defer a.free(want);
+    const got = try a.alloc(u8, rr.decode_most * route_e * 4);
+    defer a.free(got);
+    for (route_rows_checked) |m| {
+        const bytes = m * route_e * 4;
+        rr.decode_rows = false;
+        try g.dl.fill8(0xff, r.s.handle);
+        try g.call(r, m, 0);
+        try r.s.synchronize();
+        try g.dl.download(0, want[0..bytes]);
+        rr.decode_rows = true;
+        try g.dl.fill8(0xa5, r.s.handle);
+        try g.call(r, m, 0);
+        try r.s.synchronize();
+        try g.dl.download(0, got[0..bytes]);
+        check.sameBytes("decode router tiles against tf_route_logits*", got[0..bytes], want[0..bytes]) catch |err| {
+            std.debug.print("FAIL at {d} rows\n", .{m});
+            return err;
+        };
+    }
+    check.pass("TF_FLASHNEXT_ROUTE_DECODE: the decode router tiles (tf_route_logits_few16 to 16 rows, tf_route_logits to 128) equal tf_route_logits_few / tf_route_logits / tf_route_logits_wide byte for byte at {d} row counts from 1 to 128 (513 experts, 2560 inputs)", .{route_rows_checked.len});
+}
+
+const Cold = struct {
+    dw: cuda.DeviceBuffer,
+    ds: cuda.DeviceBuffer,
+    w: qmmf.Weight,
+    copies: usize,
+    code_bytes: usize,
+    scale_bytes: usize,
+
+    fn init(gpu: check.Gpu, r: *Rig, h: t.Host, w: qmmf.Weight) !Cold {
+        const code_bytes: usize = @as(usize, w.npad) * w.k;
+        const scale_bytes: usize = @as(usize, w.npad) * (w.k / 32);
+        const copies = @max(1, (160 << 20) / code_bytes);
+        var dw = try cuda.DeviceBuffer.alloc(gpu.d, copies * code_bytes);
+        errdefer dw.free();
+        var ds = try cuda.DeviceBuffer.alloc(gpu.d, copies * scale_bytes);
+        errdefer ds.free();
+        for (0..copies) |c| {
+            try dw.copyFrom(c * code_bytes, h.dw.ptr, code_bytes, r.s.handle);
+            try ds.copyFrom(c * scale_bytes, h.ds.ptr, scale_bytes, r.s.handle);
+        }
+        try r.s.synchronize();
+        return .{ .dw = dw, .ds = ds, .w = w, .copies = copies, .code_bytes = code_bytes, .scale_bytes = scale_bytes };
+    }
+
+    fn deinit(c: *Cold) void {
+        c.ds.free();
+        c.dw.free();
+    }
+
+    fn at(c: Cold, i: usize) qmmf.Weight {
+        var w = c.w;
+        w.codes = c.dw.ptr + (i % c.copies) * c.code_bytes;
+        w.scales = c.ds.ptr + (i % c.copies) * c.scale_bytes;
+        return w;
+    }
+};
+
+fn timeCalls(r: *Rig, t0: *cuda.Event, t1: *cuda.Event, cold: Cold, m: usize, out: qmmf.Out) !f64 {
+    const reps = @max(3 * cold.copies, 24);
+    for (0..cold.copies) |i| try r.call(m, cold.at(i), out);
+    try t0.record(r.s);
+    for (0..reps) |i| try r.call(m, cold.at(i), out);
+    try t1.record(r.s);
+    try t1.synchronize();
+    return @as(f64, try cuda.Event.elapsedMs(t0.*, t1.*)) * 1000 / @as(f64, @floatFromInt(reps));
+}
+
+const variants = [_][]const u8{ "lane", "dec", "dec2w", "dec4w", "dec8w" };
+
+pub fn bench(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const saved = Saved.take();
+    defer saved.restore();
+    var prng = std.Random.DefaultPrng.init(0xbe4c_dec0);
+    const rng = prng.random();
+    var r = try Rig.init(gpu, rng);
+    defer r.deinit(a);
+    var t0 = try cuda.Event.init(gpu.d, true);
+    defer t0.deinit();
+    var t1 = try cuda.Event.init(gpu.d, true);
+    defer t1.deinit();
+    const bs = [_]usize{ 4, 28 };
+    var round = std.mem.zeroes([bs.len][variants.len]f64);
+    var best_round = std.mem.zeroes([bs.len]f64);
+    for (shapes) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const w = try weightFor(h, sh);
+        var cold = try Cold.init(gpu, &r, h, w);
+        defer cold.deinit();
+        const mb = @as(f64, @floatFromInt(cold.code_bytes + cold.scale_bytes)) / 1e6;
+        for (bs, 0..) |b, bi| {
+            const m = lanes(b)[@intFromBool(sh.draft)];
+            std.debug.print("RESULT decode-gemm {s} n {d} k {d} sk {d} rows {d} ({d} lanes, {d:.1} MB):", .{ sh.name, sh.n, sh.k, qmmf.planFor(m, w, true).sk, m, b, mb });
+            var best: f64 = std.math.inf(f64);
+            for (variants, 0..) |name, vi| {
+                qmmf.lane_tile = true;
+                qmmf.decode_gemm = vi != 0;
+                qmmf.dec_warps = switch (vi) {
+                    2 => 2,
+                    3 => 4,
+                    4 => 8,
+                    else => 0,
+                };
+                const us = try timeCalls(&r, &t0, &t1, cold, m, sh.out);
+                round[bi][vi] += us * sh.per / 1000;
+                if (vi != 0) best = @min(best, us);
+                std.debug.print(" {s} {d:.1} us ({d:.0} GB/s)", .{ name, us, mb * 1e3 / us });
+            }
+            best_round[bi] += best * sh.per / 1000;
+            std.debug.print("\n", .{});
+        }
+    }
+    for (bs, 0..) |b, bi| {
+        std.debug.print("RESULT decode-gemm a round at {d} lanes ({d} verify rows, {d} draft rows; 36+12 in, 48 out, 96 shared gate/up, 48 shared down; the bf16 head and draft layer are not MXFP8):", .{ b, lanes(b)[0], lanes(b)[1] });
+        for (variants, round[bi]) |name, ms| std.debug.print(" {s} {d:.2} ms", .{ name, ms });
+        std.debug.print(" best-warps {d:.2} ms; saved {d:.2} ms (engine pick) {d:.2} ms (best warps)\n", .{ best_round[bi], round[bi][0] - round[bi][1], round[bi][0] - best_round[bi] });
+    }
+    try routeBench(gpu, &r, rng, &t0, &t1);
+}
+
+fn routeBench(gpu: check.Gpu, r: *Rig, rng: std.Random, t0: *cuda.Event, t1: *cuda.Event) !void {
+    const copies = 48;
+    var g = try Route.init(gpu, rng, copies);
+    defer g.deinit();
+    for ([_]usize{ 1, 4, 11, 16, 28, 33, 56, 64, 65, 74, 84, 96 }) |m| {
+        var us: [2]f64 = undefined;
+        for (0..2) |vi| {
+            rr.decode_rows = vi == 1;
+            const reps = 3 * copies;
+            for (0..copies) |i| try g.call(r, m, i);
+            try t0.record(r.s);
+            for (0..reps) |i| try g.call(r, m, i % copies);
+            try t1.record(r.s);
+            try t1.synchronize();
+            us[vi] = @as(f64, try cuda.Event.elapsedMs(t0.*, t1.*)) * 1000 / @as(f64, @floatFromInt(reps));
+        }
+        const mb = @as(f64, route_e * route_d * 2) / 1e6;
+        std.debug.print("RESULT route-decode rows {d}: engine {d:.1} us ({d:.0} GB/s), decode tiles {d:.1} us ({d:.0} GB/s); a round's 48 routers {d:.2} -> {d:.2} ms (saved {d:.2})\n", .{ m, us[0], mb * 1e3 / us[0], us[1], mb * 1e3 / us[1], us[0] * 48 / 1000, us[1] * 48 / 1000, (us[0] - us[1]) * 48 / 1000 });
+    }
+}
