+test "pcache keeping: explain finds the evicted state that would have served, and a history that parts early" {
+    const gpa = std.testing.allocator;
+    var bufs: [3][6000]u32 = undefined;
+    const a = convo(&bufs[0], 1, 0);
+    const b = convo(&bufs[1], 2, 0);
+    const rewritten = convo(&bufs[2], 2, 0);
+    for (rewritten[4500..]) |*t| t.* +%= 3;
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .lookahead = 1 }, (100 + 5000) + 50);
+    defer s.deinit();
+    s.keeping.explain = true;
+    try std.testing.expect(keepBornAt(&f, &s, a[0..5100], 5100, 5000));
+    try std.testing.expect(keepBornAt(&f, &s, b[0..5100], 5100, 5000));
+    try std.testing.expect(!has(&s, a, 5000));
+    try std.testing.expectEqual(@as(usize, 1), s.explained.ghosts.items.len);
+    const miss = try s.lookupUser(gpa, a, 6000, 5990, 0, 0, &.{}, &.{}, &.{});
+    defer gpa.free(miss.marks);
+    try std.testing.expect(miss.entry == null);
+    try std.testing.expectEqual(@as(u64, 1), s.explained.counts.evicted);
+    try std.testing.expectEqual(@as(u64, 5000), s.explained.counts.evicted_tokens);
+    const parted = try s.lookupUser(gpa, rewritten, 6000, 5990, 0, 0, &.{}, &.{}, &.{});
+    defer gpa.free(parted.marks);
+    try std.testing.expect(parted.entry == null);
+    try std.testing.expectEqual(@as(u64, 1), s.explained.counts.parted);
+    try std.testing.expectEqual(@as(u64, 4500), s.explained.counts.parted_tokens);
+    var fresh_buf: [6000]u32 = undefined;
+    const fresh = convo(&fresh_buf, 9, 0);
+    const n = try s.lookupUser(gpa, fresh, 6000, 5990, 0, 0, &.{}, &.{}, &.{});
+    defer gpa.free(n.marks);
+    try std.testing.expectEqual(@as(u64, 1), s.explained.counts.fresh);
+    try std.testing.expectEqual(@as(u64, 3), s.explained.counts.shallow);
+    var cont_buf: [6000]u32 = undefined;
