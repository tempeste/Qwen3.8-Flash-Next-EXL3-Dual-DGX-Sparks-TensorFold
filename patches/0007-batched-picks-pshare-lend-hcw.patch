+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const table_tests = @import("flashnext_mixed_table_tests.zig");
+const prompt = flash.prompt;
+const plan = flash.mixed_plan;
+const env = @import("sys").env;
+const Windows = table_tests.Windows;
+
+const window_context = 4096;
+const max_windows = 28;
+const levels = [_]usize{ 4, 28 };
+const reps = 3;
+const next_rows = 64;
+const piece_room = 64 * 1024;
+const knob = "TF_FLASHNEXT_MIXED_RIDE_FAST";
+const beside_knob = "TF_FLASHNEXT_MIXED_RIDE_BESIDE";
+const front_knob = "TF_FLASHNEXT_MIXED_RIDE_FRONT";
+
+const Arm = struct {
+    name: []const u8,
+    fast: bool,
+    beside: bool = false,
+    front: bool = false,
+
+    fn set(a: Arm) void {
+        _ = env.setenv(knob, if (a.fast) "1" else "0", 1);
+        _ = env.setenv(beside_knob, if (a.beside) "1" else "0", 1);
+        _ = env.setenv(front_knob, if (a.front) "1" else "0", 1);
+    }
+
+    fn runs(a: Arm) bool {
+        return !a.beside or (flash.knobs.tpRouteBeside() catch false);
+    }
+};
+
+const arms = [_]Arm{
+    .{ .name = "MRX", .fast = false },
+    .{ .name = "RIDE_FAST", .fast = true },
+    .{ .name = "RIDE_FAST + RIDE_BESIDE", .fast = true, .beside = true },
+    .{ .name = "RIDE_FAST + RIDE_FRONT", .fast = true, .front = true },
+    .{ .name = "RIDE_FAST + RIDE_BESIDE + RIDE_FRONT", .fast = true, .beside = true, .front = true },
+};
+const off_arm = arms[0];
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+    ids: []const u32,
+    out: u64,
+    streams: cuda.DeviceBuffer,
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, at_arg: ?[]const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const at = if (at_arg) |v| try std.fmt.parseInt(usize, v, 10) else 0;
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "1", 1);
+    if (!try flash.knobs.mixedSeqPar()) {
+        std.debug.print("FAIL flashnext-mixed-ride needs TF_FLASHNEXT_MIXED_SEQPAR=1 on both ranks (the MRX flags)\n", .{});
+        return error.TestFailed;
+    }
+    off_arm.set();
+    defer for ([_][:0]const u8{ knob, beside_knob, front_knob }) |k| {
+        _ = env.unsetenv(k);
+    };
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const context = @max(window_context, at + piece_room + chunk);
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+    identity.mtp = 1;
+    const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, rank, identity, flash.rank_engine.linkWait());
+    const e = prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank) catch |err| {
+        session.poison();
+        session.deinit();
+        return err;
+    };
+    session.engine = e;
+    e.collective = &session.collective;
+    if (flash.knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+    defer {
+        session.deinit();
+        e.deinit();
+    }
+    if (e.chunk != chunk) return error.RankIdentity;
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, max_windows * 3 * prompt.vocabulary * 2);
+    defer logits.free();
+    if (rank == 1) {
+        try session.follow(flash.Tri, tri, logits.ptr);
+        check.pass("rank 1 followed the mixed rounds with and without {s}, {s} and {s} (the frame's bits 30, 29 and 28)", .{ knob, beside_knob, front_knob });
+        return;
+    }
+    const round_cap = @min(flash.knobs.roundRowsCap(), chunk);
+    const max_np = plan.pieceRows(chunk, chunk, round_cap);
+    if (max_np < 1536) return error.RankIdentity;
+    const ids = try gpu.gpa.alloc(u32, context);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, max_np * prompt.hidden_wide * 2);
+    defer streams.free();
+    const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items, .ids = ids, .out = logits.ptr, .streams = streams };
+    std.debug.print("flashnext-mixed-ride: passes of {d} rows, round rows at most {d}, pieces of 1536 and {d} rows, timed pieces from position {d}; split sums from {d} rows, seqpar from {d}, bf16 scatter {s}, sum overlap {s}, gather ahead {s}, index ahead {s}, route beside {s}, RoCE {s}\n", .{ chunk, round_cap, max_np, at, try flash.knobs.splitSumMinRows(), try flash.knobs.tpSeqParMinRows(), onWord(try flash.knobs.tpScatterBf16()), onWord(try flash.knobs.tpSumOverlap()), onWord(try flash.knobs.tpGatherAhead()), onWord(try flash.knobs.tpIndexAhead()), onWord(try flash.knobs.tpRouteBeside()), onWord(flash.knobs.tpRoce()) });
+    if (!try flash.knobs.tpRouteBeside()) std.debug.print("flashnext-mixed-ride: TF_FLASHNEXT_TP_ROUTE_BESIDE is off on these ranks, so the {s} arms are skipped\n", .{beside_knob});
+    for (levels) |d| {
+        const wr = @max(1, @min(3, round_cap / d));
+        for ([_]usize{ 1536, max_np }) |np| {
+            if (!plan.fits(np, d * wr, chunk)) return error.RankIdentity;
+            try compare(rig, np, d, wr, false);
+            check.pass("ride fast: {d} prompt rows beside {d} windows of {d} rows, the windows' scores, the piece's streams and both groups' next rows equal the round without {s}", .{ np, d, wr, knob });
+            check.pass("ride2: {d} prompt rows beside {d} windows of {d} rows, every arm with {s} and {s} equals {s} alone", .{ np, d, wr, beside_knob, front_knob, knob });
+        }
+        try compare(rig, 1536, d, wr, true);
+        check.pass("ride fast: a last piece of 1536 rows beside {d} windows of {d} rows, its first-token scores, streams and next rows equal the round without {s}", .{ d, wr, knob });
+    }
+    for (levels) |d| try bench(rig, at, max_np, d, @max(1, @min(3, round_cap / d)));
+}
+
+fn onWord(v: bool) []const u8 {
+    return if (v) "on" else "off";
+}
+
+const Got = struct {
+    rows: []u8,
+    streams: []u8,
+    next: []u8,
+
+    fn alloc(gpa: std.mem.Allocator, rows: usize, streams: usize, next: usize) !Got {
+        const a = try gpa.alloc(u8, rows);
+        errdefer gpa.free(a);
+        const b = try gpa.alloc(u8, streams);
+        errdefer gpa.free(b);
+        return .{ .rows = a, .streams = b, .next = try gpa.alloc(u8, next) };
+    }
+
+    fn free(g: Got, gpa: std.mem.Allocator) void {
+        gpa.free(g.rows);
+        gpa.free(g.streams);
+        gpa.free(g.next);
+    }
+};
+
+fn compare(r: Rig, np: usize, d: usize, wr: usize, last: bool) !void {
+    const row = prompt.vocabulary * 2;
+    const nr = d * wr * row;
+    var got: [arms.len]Got = undefined;
+    var made: usize = 0;
+    defer for (got[0..made]) |g| g.free(r.gpu.gpa);
+    for (&got) |*g| {
+        g.* = try Got.alloc(r.gpu.gpa, nr + row, np * prompt.hidden_wide * 2, nr + row);
+        made += 1;
+    }
+    const dr = r.e.driver;
+    for (&got, arms) |*g, arm| {
+        if (!arm.runs()) continue;
+        var w: Windows = .{ .rows = wr };
+        try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+        defer w.deinit(r.session);
+        var p = try r.session.create(window_context + np + next_rows);
+        defer r.session.drop(&p);
+        arm.set();
+        r.session.mixed(flash.Tri, r.tri, .{ .seq = &p, .ids = r.ids[0..np], .streams = r.streams.ptr, .last = last }, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out) catch |err| {
+            off_arm.set();
+            return err;
+        };
+        off_arm.set();
+        try r.stream.synchronize();
+        @memset(g.rows[nr..], 0);
+        if (last) @memcpy(g.rows[nr..], p.logits[0..row]);
+        try dr.check(dr.api.cuMemcpyDtoH_v2(g.rows.ptr, r.out, nr), "cuMemcpyDtoH");
+        try dr.check(dr.api.cuMemcpyDtoH_v2(g.streams.ptr, r.streams.ptr, g.streams.len), "cuMemcpyDtoH");
+        try w.keepAll(r.session, r.tri);
+        try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+        try r.stream.synchronize();
+        try dr.check(dr.api.cuMemcpyDtoH_v2(g.next.ptr, r.out, nr), "cuMemcpyDtoH");
+        try w.keepAll(r.session, r.tri);
+        try r.session.forward(flash.Tri, r.tri, &p, r.ids[np..][0..next_rows], .{ .logits = .last, .prompt = true });
+        try r.stream.synchronize();
+        @memcpy(g.next[nr..], p.logits[0..row]);
+    }
+    try check.sameBytes("each window row's scores in a mixed round with the piece's sums off the pass's stream equal the round without", got[1].rows[0..nr], got[0].rows[0..nr]);
+    try check.sameBytes("the riding piece's hidden streams with its sums off the pass's stream equal the round without", got[1].streams, got[0].streams);
+    if (last) try check.sameBytes("a riding last piece's first-token scores with its sums off the pass's stream equal the round without", got[1].rows[nr..], got[0].rows[nr..]);
+    try check.sameBytes("the windows' next verify after the round equals the one after the round without", got[1].next[0..nr], got[0].next[0..nr]);
+    try check.sameBytes("the piece's next pass's last-row scores equal the ones after the round without", got[1].next[nr..], got[0].next[nr..]);
+    for (arms[2..], got[2..]) |arm, g| {
+        if (!arm.runs()) continue;
+        std.debug.print("ride2: {s} against RIDE_FAST alone, {d} piece rows, {d} windows{s}\n", .{ arm.name, np, d, if (last) ", last piece" else "" });
+        try check.sameBytes("each window row's scores equal RIDE_FAST alone's", g.rows[0..nr], got[1].rows[0..nr]);
+        try check.sameBytes("the riding piece's hidden streams equal RIDE_FAST alone's", g.streams, got[1].streams);
+        if (last) try check.sameBytes("a riding last piece's first-token scores equal RIDE_FAST alone's", g.rows[nr..], got[1].rows[nr..]);
+        try check.sameBytes("the windows' next verify after the round equals RIDE_FAST alone's", g.next[0..nr], got[1].next[0..nr]);
+        try check.sameBytes("the piece's next pass's last-row scores equal RIDE_FAST alone's", g.next[nr..], got[1].next[nr..]);
+    }
+}
+
+fn now(io: std.Io) u64 {
+    return @intCast(std.Io.Clock.awake.now(io).toNanoseconds());
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) / std.time.ns_per_ms;
+}
+
+const Timer = struct {
+    r: Rig,
+    w: *Windows,
+    p: *prompt.Seq,
+
+    fn verify(t: Timer) !u64 {
+        const t0 = now(t.r.gpu.io);
+        try t.r.session.verifyMany(flash.Tri, t.r.tri, t.w.qs[0..t.w.n], t.w.ds[0..t.w.n], t.w.idss[0..t.w.n], t.r.out);
+        try t.r.stream.synchronize();
+        const ns = now(t.r.gpu.io) - t0;
+        try t.w.keepAll(t.r.session, t.r.tri);
+        return ns;
+    }
+
+    fn mixed(t: Timer, np: usize, arm: Arm) !u64 {
+        arm.set();
+        defer off_arm.set();
+        const t0 = now(t.r.gpu.io);
+        try t.r.session.mixed(flash.Tri, t.r.tri, .{ .seq = t.p, .ids = t.r.ids[t.p.fed..][0..np], .streams = t.r.streams.ptr }, t.w.qs[0..t.w.n], t.w.ds[0..t.w.n], t.w.idss[0..t.w.n], t.r.out);
+        try t.r.stream.synchronize();
+        const ns = now(t.r.gpu.io) - t0;
+        try t.w.keepAll(t.r.session, t.r.tri);
+        return ns;
+    }
+
+    fn alone(t: Timer, np: usize) !u64 {
+        const t0 = now(t.r.gpu.io);
+        try t.r.session.forward(flash.Tri, t.r.tri, t.p, t.r.ids[t.p.fed..][0..np], .{ .logits = .none, .streams = t.r.streams.ptr, .prompt = true });
+        try t.r.stream.synchronize();
+        return now(t.r.gpu.io) - t0;
+    }
+};
+
+fn bench(r: Rig, at: usize, max_np: usize, d: usize, wr: usize) !void {
+    var w: Windows = .{ .rows = wr };
+    try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+    defer w.deinit(r.session);
+    var p = try r.session.create(at + piece_room + r.e.chunk);
+    defer r.session.drop(&p);
+    while (p.fed < at) try r.session.forward(flash.Tri, r.tri, &p, r.ids[p.fed..@min(at, p.fed + r.e.chunk)], .{ .logits = .none, .prompt = true });
+    try r.stream.synchronize();
+    const t: Timer = .{ .r = r, .w = &w, .p = &p };
+    _ = try t.verify();
+    var base: u64 = 0;
+    for (0..reps) |_| base += try t.verify();
+    base /= reps;
+    const from = p.fed;
+    for ([_]usize{ 1536, max_np }) |np| {
+        _ = try t.alone(np);
+        for (arms) |arm| if (arm.runs()) {
+            _ = try t.mixed(np, arm);
+        };
+        var alone_ns: u64 = 0;
+        var arm_ns: [arms.len]u64 = @splat(0);
+        for (0..reps) |_| {
+            alone_ns += try t.alone(np);
+            for (arms, &arm_ns) |arm, *a| if (arm.runs()) {
+                a.* += try t.mixed(np, arm);
+            };
+        }
+        alone_ns /= reps;
+        for (&arm_ns) |*a| a.* /= reps;
+        const off_ns = arm_ns[0];
+        const on_ns = arm_ns[1];
