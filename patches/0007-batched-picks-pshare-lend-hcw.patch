+                const int next = it + DEC_STAGES - 1;
+                if (next < per) load(next % DEC_STAGES, g0 + next);
+                commit();
+                const unsigned char* p = buf + (it % DEC_STAGES) * STAGE;
+                const uint4 cw = wq[u];
+                const uint32_t cs = sq[u];
+                const bool more = valid && it + DEC_PF < per;
+                wq[u] = more ? __ldg(wp + static_cast<size_t>(g0 + it + DEC_PF) * 256) : make_uint4(0u, 0u, 0u, 0u);
+                sq[u] = more ? __ldg(sp + static_cast<size_t>(g0 + it + DEC_PF) * 32) : 0u;
+                if (valid) {
+                    const uint32_t s0w = cs & 0xFFFFu, s1w = cs >> 16;
+                    float d[MT][4];
+#pragma unroll
+                    for (int kt = 0; kt < GS / 16; ++kt) {
+                        const uint32_t word = comp(cw, kt);
+                        const uint32_t b0 = fp8pair(word & 0xFFFFu);
