+    }
+
+    fn decOld(w: *Hcw, ti: usize) !void {
+        const c = &w.c;
+        try tk.hcdDown(c.t, c.r.s, ti, c.h, c.pss, c.scale, c.wdown.codes, c.part, c.rows, n_down, wide, w.decSk(), dims, streams, eps);
