diff --git a/zig/src/families/flashnext/cuda_gather_open.zig b/zig/src/families/flashnext/cuda_gather_open.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a2a950e22c8b7cda7f571868f41a307ff70bb75d
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_gather_open.zig
@@ -0,0 +1,203 @@
+const std = @import("std");
+const ple = @import("cuda_ple.zig");
+const ple_pool = @import("cuda_ple_pool.zig");
+
+pub const max_blocks = 2;
+
+pub const Open = struct {
+    gpa: std.mem.Allocator = undefined,
+    io: std.Io = undefined,
+    ngram: ?ple.Ngram = null,
+    pool: ?*ple_pool.Pool = null,
+    thread: ?std.Thread = null,
+    at: usize = 0,
+    history: [ple.max_n]i64 = undefined,
+    hist_len: usize = 0,
+    ids: []u32 = &.{},
+    emb: []u16 = &.{},
+    xs: []f32 = &.{},
+    ends: [max_blocks]usize = undefined,
+    blocks: usize = 0,
+    done: std.atomic.Value(u32) = .init(0),
+    events: std.atomic.Value(u32) = .init(0),
+    over: std.atomic.Value(bool) = .init(false),
+    stop: std.atomic.Value(bool) = .init(false),
+    claimed: bool = false,
+    live: bool = false,
+    failed: ?anyerror = null,
+
+    pub fn busy(o: *const Open) bool {
+        return o.thread != null and !o.over.load(.acquire);
+    }
+
+    pub fn start(o: *Open, gpa: std.mem.Allocator, io: std.Io, table: *const ple.Ngram, at: usize, history: []const i64, ids: []const u32, ends: []const usize) !void {
+        if (o.busy()) return error.GatherOpenBusy;
+        o.release();
+        if (ids.len == 0 or ends.len == 0 or ends.len > max_blocks or ends[ends.len - 1] != ids.len or history.len != table.hash.n - 1) return error.UnexpectedTensor;
+        for (ends, 0..) |e, i| if (e == 0 or (i > 0 and e <= ends[i - 1])) return error.UnexpectedTensor;
+        o.gpa = gpa;
+        o.io = io;
+        if (o.ngram == null) {
+            o.pool = try ple_pool.Pool.create(gpa, io);
+            var g = table.*;
+            g.pool = o.pool;
+            o.ngram = g;
+        }
+        const w = table.width();
+        o.ids = try gpa.dupe(u32, ids);
+        errdefer o.freeBuffers();
+        o.emb = try gpa.alloc(u16, ids.len * w);
+        o.xs = try gpa.alloc(f32, ids.len * (w / 32));
+        o.at = at;
+        o.hist_len = history.len;
+        @memcpy(o.history[0..history.len], history);
+        @memcpy(o.ends[0..ends.len], ends);
+        o.blocks = ends.len;
+        o.done.store(0, .release);
+        o.events.store(0, .release);
+        o.over.store(false, .release);
+        o.stop.store(false, .release);
+        o.claimed = false;
+        o.failed = null;
+        o.thread = try std.Thread.spawn(.{}, run, .{o});
+        o.live = true;
+    }
+
+    fn run(o: *Open) void {
+        defer {
+            o.over.store(true, .release);
+            _ = o.events.fetchAdd(1, .acq_rel);
+            o.io.futexWake(u32, &o.events.raw, std.math.maxInt(u32));
+        }
+        const g = &o.ngram.?;
+        const w = g.width();
+        var hist: [ple.max_n]i64 = undefined;
+        @memcpy(hist[0..o.hist_len], o.history[0..o.hist_len]);
+        var lo: usize = 0;
+        for (o.ends[0..o.blocks]) |hi| {
+            if (o.stop.load(.acquire)) return;
+            g.rows(hist[0..o.hist_len], o.ids[lo..hi], o.emb[lo * w .. hi * w], o.xs[lo * (w / 32) .. hi * (w / 32)]) catch |err| {
+                o.failed = err;
+                return;
+            };
+            o.done.store(@intCast(hi), .release);
+            _ = o.events.fetchAdd(1, .acq_rel);
+            o.io.futexWake(u32, &o.events.raw, std.math.maxInt(u32));
+            lo = hi;
+        }
+    }
+
+    pub fn matches(o: *const Open, pos: usize, history: []const i64, ids: []const u32) bool {
+        if (!o.live or o.claimed or o.stop.load(.acquire)) return false;
+        if (pos != o.at or history.len != o.hist_len or ids.len == 0 or ids.len > o.ids.len) return false;
+        if (!std.mem.eql(i64, history, o.history[0..o.hist_len])) return false;
+        return std.mem.eql(u32, ids, o.ids[0..ids.len]);
+    }
+
+    pub fn claim(o: *Open) void {
+        o.claimed = true;
+    }
+
+    pub fn take(o: *Open, fallback: *const ple.Ngram, history: []i64, ids: []const u32, emb: []u16, xs: []f32) !void {
+        defer o.stop.store(true, .release);
+        const n: u32 = @intCast(ids.len);
+        while (true) {
+            const ev = o.events.load(.acquire);
+            if (o.done.load(.acquire) >= n or o.over.load(.acquire)) break;
+            o.io.futexWaitUncancelable(u32, &o.events.raw, ev);
+        }
+        if (o.done.load(.acquire) < n) {
+            if (o.failed) |err| return err;
+            return fallback.rows(history, ids, emb, xs);
+        }
+        const w = fallback.width();
+        @memcpy(emb, o.emb[0 .. ids.len * w]);
+        @memcpy(xs, o.xs[0 .. ids.len * (w / 32)]);
+        advance(history, ids);
+    }
+
+    pub fn release(o: *Open) void {
+        if (o.thread) |t| {
+            o.stop.store(true, .release);
+            t.join();
+        }
+        o.thread = null;
+        o.live = false;
+        o.freeBuffers();
+    }
+
+    fn freeBuffers(o: *Open) void {
+        if (o.ids.len != 0) o.gpa.free(o.ids);
+        if (o.emb.len != 0) o.gpa.free(o.emb);
+        if (o.xs.len != 0) o.gpa.free(o.xs);
+        o.ids = &.{};
+        o.emb = &.{};
+        o.xs = &.{};
+    }
+
+    pub fn deinit(o: *Open) void {
+        o.release();
+        if (o.pool) |p| p.destroy();
+        o.pool = null;
+        o.ngram = null;
+    }
+};
+
+pub fn advance(history: []i64, tokens: []const u32) void {
+    if (history.len == 0) return;
+    for (tokens) |token| {
+        for (0..history.len - 1) |i| history[i] = history[i + 1];
+        history[history.len - 1] = token;
+    }
+}
+
+pub fn blockEnds(at: usize, stop: usize, end: usize, out: *[max_blocks]usize) []const usize {
+    if (stop <= at) return out[0..0];
+    out[0] = stop - at;
+    if (end <= stop) return out[0..1];
+    out[1] = end - at;
+    return out[0..2];
+}
+
+test "gather at open: blocks end at the planned stop, then at the merged one" {
+    var buf: [max_blocks]usize = undefined;
+    try std.testing.expectEqualSlices(usize, &.{1000}, blockEnds(81992, 82992, 82992, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 993, 1000 }, blockEnds(81992, 82985, 82992, &buf));
+    try std.testing.expectEqualSlices(usize, &.{3072}, blockEnds(0, 3072, 3000, &buf));
+    try std.testing.expectEqual(@as(usize, 0), blockEnds(5, 5, 9, &buf).len);
+}
+
+test "gather at open: the history moves past the rows as Ngram.rows moves it" {
+    var h: [2]i64 = .{ 1, 2 };
+    advance(&h, &.{});
+    try std.testing.expectEqual([2]i64{ 1, 2 }, h);
+    advance(&h, &.{7});
+    try std.testing.expectEqual([2]i64{ 2, 7 }, h);
+    advance(&h, &.{ 8, 9, 10 });
+    try std.testing.expectEqual([2]i64{ 9, 10 }, h);
+}
+
+test "gather at open: a pass takes the rows only at the same position, history and leading tokens, once" {
+    var o: Open = .{};
+    o.live = true;
+    o.at = 100;
+    o.hist_len = 2;
+    o.history[0] = 5;
+    o.history[1] = 6;
+    var ids = [_]u32{ 1, 2, 3, 4 };
+    o.ids = &ids;
+    try std.testing.expect(o.matches(100, &.{ 5, 6 }, &.{ 1, 2, 3, 4 }));
+    try std.testing.expect(o.matches(100, &.{ 5, 6 }, &.{ 1, 2 }));
+    try std.testing.expect(!o.matches(101, &.{ 5, 6 }, &.{ 1, 2 }));
+    try std.testing.expect(!o.matches(100, &.{ 5, 7 }, &.{ 1, 2 }));
+    try std.testing.expect(!o.matches(100, &.{ 5, 6 }, &.{ 1, 3 }));
+    try std.testing.expect(!o.matches(100, &.{ 5, 6 }, &.{ 1, 2, 3, 4, 5 }));
+    try std.testing.expect(!o.matches(100, &.{ 5, 6 }, &.{}));
+    o.claim();
+    try std.testing.expect(!o.matches(100, &.{ 5, 6 }, &.{ 1, 2 }));
+    o.claimed = false;
+    o.stop.store(true, .release);
+    try std.testing.expect(!o.matches(100, &.{ 5, 6 }, &.{ 1, 2 }));
+    o.live = false;
+    o.ids = &.{};
+}
