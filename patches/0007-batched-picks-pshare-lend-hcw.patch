+++ b/zig/tests/cuda/prompt_dtile_tests.zig
@@ -0,0 +1,389 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const t = @import("prompt_tile2_tests.zig");
+
+const qmmf = cuda.qmmf;
+
+const prompt_rows = [_]usize{ 1536, 1000, 300, 256 + 28, 256 + 84, 448 + 56, 640 + 28, 640 + 84 };
+
+const Saved = struct {
+    min_n: usize,
+    mx2: bool,
+    perm: bool,
+    tile2: bool,
+    fp8: bool,
+    lane: bool,
+    wide: bool,
+    dtile: qmmf.Dtile,
+
+    fn now() Saved {
+        return .{ .min_n = qmmf.prompt_mx_min_n, .mx2 = qmmf.mx2_tile, .perm = qmmf.mx_perm, .tile2 = qmmf.tile2, .fp8 = qmmf.fp8mma, .lane = qmmf.lane_tile, .wide = qmmf.lane_tile_wide, .dtile = qmmf.dtile };
+    }
+
+    fn restore(s: Saved) void {
+        qmmf.prompt_mx_min_n = s.min_n;
+        qmmf.mx2_tile = s.mx2;
+        qmmf.mx_perm = s.perm;
+        qmmf.tile2 = s.tile2;
+        qmmf.fp8mma = s.fp8;
+        qmmf.lane_tile = s.lane;
+        qmmf.lane_tile_wide = s.wide;
+        qmmf.dtile = s.dtile;
+    }
+};
+
+fn production() void {
+    qmmf.prompt_mx_min_n = 1;
+    qmmf.mx2_tile = true;
+    qmmf.mx_perm = true;
+    qmmf.tile2 = false;
+    qmmf.fp8mma = false;
+    qmmf.lane_tile = true;
+    qmmf.lane_tile_wide = false;
+    qmmf.dtile = .off;
+}
+
+const Rig = struct {
+    lane: qmmf.Lane,
+    s: cuda.Stream,
+    dx: cuda.DeviceBuffer,
+    dy: cuda.DeviceBuffer,
+    gate: cuda.DeviceBuffer,
+    up: cuda.DeviceBuffer,
+    part: cuda.DeviceBuffer,
+    swiglu: cuda.Function,
+    hc: cuda.Module,
+
+    fn init(gpu: check.Gpu, x: []const u16, max_m: usize, max_n: usize) !Rig {
+        const major = (try gpu.ctx.capability()) / 10;
+        var lane = try qmmf.Lane.load(gpu.d, major);
+        errdefer lane.unload();
+        var s = try cuda.Stream.init(gpu.d, false);
+        errdefer s.deinit();
+        var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(x));
+        errdefer dx.free();
+        var dy = try cuda.DeviceBuffer.alloc(gpu.d, max_m * max_n * 4);
+        errdefer dy.free();
+        var gate = try cuda.DeviceBuffer.alloc(gpu.d, max_m * 640 * 2);
+        errdefer gate.free();
+        var up = try cuda.DeviceBuffer.alloc(gpu.d, max_m * 640 * 2);
+        errdefer up.free();
+        var part = try cuda.DeviceBuffer.alloc(gpu.d, 8 * max_m * 640 * 4);
+        errdefer part.free();
+        var hc = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_hc);
+        errdefer hc.unload();
+        return .{ .lane = lane, .s = s, .dx = dx, .dy = dy, .gate = gate, .up = up, .part = part, .swiglu = try hc.function("fn_shared_swiglu"), .hc = hc };
+    }
+
+    fn deinit(r: *Rig) void {
+        r.hc.unload();
+        r.part.free();
+        r.up.free();
+        r.gate.free();
+        r.dy.free();
+        r.dx.free();
+        r.s.deinit();
+        r.lane.unload();
+    }
+
+    fn take(r: *Rig, into: []u8) !void {
+        try r.s.synchronize();
+        try r.dy.download(0, into);
+    }
+
+    fn poison(r: *Rig) !void {
+        try r.dy.fill8(0xff, r.s.handle);
+    }
+};
+
+pub fn run(gpu: check.Gpu) !void {
+    const saved = Saved.now();
+    defer saved.restore();
+    try chain(gpu);
+    try block(gpu);
+    try gateUp(gpu);
+}
+
+fn chain(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const k = 2560;
+    const ldx = k + 64;
+    const max_m = 1536;
+    var prng = std.Random.DefaultPrng.init(0xd711_c4a1);
+    const rng = prng.random();
+    const x = try t.activations(gpu, rng, max_m, k, ldx);
+    defer a.free(x);
+    var r = try Rig.init(gpu, x, max_m, 8240);
+    defer r.deinit();
+    const rows = prompt_rows ++ [_]usize{ 128, 77, 2 };
+    for ([_]usize{ 8240, 7296, 1001, 70 }) |n| {
+        var h = try t.Host.init(gpu, rng, n, k);
+        defer h.deinit(a);
+        for (rows) |m| for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+            const bytes = m * n * @as(usize, if (out == .f32) 4 else 2);
+            const want = try a.alloc(u8, bytes);
+            defer a.free(want);
+            const got = try a.alloc(u8, bytes);
+            defer a.free(got);
+            production();
+            try r.poison();
+            try r.lane.matmulPrompt(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, r.part.ptr);
+            try r.take(want);
+            for ([_]bool{ false, true }) |narrow| {
+                try r.poison();
+                try r.lane.promptDtile(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, narrow);
+                try r.take(got);
+                try check.sameBytes(if (narrow) "128-column dtile chain tile against the permuted two-stage prompt tile" else "256-column dtile chain tile against the permuted two-stage prompt tile", got, want);
+            }
+            qmmf.dtile = .all;
+            try r.poison();
+            try r.lane.matmulPrompt(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, r.part.ptr);
+            try r.take(got);
+            try check.sameBytes("matmulPrompt with TF_FLASHNEXT_PROMPT_DTILE=1 against the permuted two-stage prompt tile", got, want);
+            qmmf.mx2_tile = false;
+            qmmf.mx_perm = false;
+            qmmf.dtile = .off;
+            try r.poison();
+            try r.lane.matmulPrompt(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, r.part.ptr);
+            try r.take(got);
+            try check.sameBytes("the three-stage prompt tile against the permuted two-stage prompt tile", got, want);
+        };
+    }
+    check.pass("TF_FLASHNEXT_PROMPT_DTILE chain tiles (128 and 256 columns) equal the prompt tiles byte for byte, bf16 and fp32, n 70 to 8240, rows 2 to 1536 and the mixed-round pieces", .{});
+}
+
+fn block(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const max_k = 3072;
+    const ldx = max_k + 64;
+    const max_m = 1536;
+    var prng = std.Random.DefaultPrng.init(0xd711_b10c);
+    const rng = prng.random();
+    const x = try t.activations(gpu, rng, max_m, max_k, ldx);
+    defer a.free(x);
+    var r = try Rig.init(gpu, x, max_m, 2560);
+    defer r.deinit();
+    const Shape = struct { n: usize, k: usize };
+    const shapes = [_]Shape{ .{ .n = 2560, .k = 3072 }, .{ .n = 2560, .k = 320 }, .{ .n = 2560, .k = 2560 }, .{ .n = 1001, .k = 2560 }, .{ .n = 70, .k = 3072 } };
+    for (shapes) |sh| {
+        var h = try t.Host.init(gpu, rng, sh.n, sh.k);
+        defer h.deinit(a);
+        const rows = prompt_rows ++ [_]usize{ 255, 84, 28 };
+        for (rows) |m| for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+            const bytes = m * sh.n * @as(usize, if (out == .f32) 4 else 2);
+            const want = try a.alloc(u8, bytes);
+            defer a.free(want);
+            const got = try a.alloc(u8, bytes);
+            defer a.free(got);
+            const p = qmmf.planFor(m, h.w, r.lane.clusters);
+            production();
+            qmmf.lane_tile = false;
+            try r.poison();
+            try r.lane.matmulOut(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, r.part.ptr);
+            try r.take(want);
+            qmmf.lane_tile = true;
+            try r.poison();
+            try r.lane.matmulOut(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, r.part.ptr);
+            try r.take(got);
+            try check.sameBytes("the lane tile against the lane kernel", got, want);
+            if (p.bm == 64 and !p.cluster and !p.reduce) {
+                try r.poison();
+                try r.lane.dtileBlock(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, p.sk);
+                try r.take(got);
+                try check.sameBytes("dtile block tile against the lane kernel", got, want);
+            }
+            for ([_]qmmf.Dtile{ .all, .block }) |d| {
+                qmmf.dtile = d;
+                try check.expect(qmmf.dtileBlockTakes(m, h.w, p) == (m >= qmmf.fused_rows and p.bm == 64 and !p.cluster and !p.reduce), "dtile block dispatch at {d} rows", .{m});
+                try check.expect(m < qmmf.fused_rows or qmmf.dtileBlockTakes(m, h.w, p), "dtile block takes every prompt piece: {d} rows, n {d}, k {d}", .{ m, sh.n, sh.k });
+                try r.poison();
+                try r.lane.matmulOut(r.s, r.dx.ptr, ldx, m, h.w, r.dy.ptr, out, r.part.ptr);
+                try r.take(got);
+                try check.sameBytes("matmulOut with TF_FLASHNEXT_PROMPT_DTILE against the lane kernel", got, want);
+            }
+        };
+    }
+    check.pass("TF_FLASHNEXT_PROMPT_DTILE block tile equals the lane kernel byte for byte, bf16 and fp32, out projection 2560 x 3072 (4 slices), shared down 2560 x 320, n 70 to 2560, rows 28 to 1536 and the mixed-round pieces", .{});
+}
+
+fn gateUp(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const k = 2560;
+    const ldx = k + 64;
+    const max_m = 4096;
+    var prng = std.Random.DefaultPrng.init(0xd711_96a1);
+    const rng = prng.random();
+    const x = try t.activations(gpu, rng, max_m, k, ldx);
+    defer a.free(x);
+    var r = try Rig.init(gpu, x, max_m, 640);
+    defer r.deinit();
+    for ([_]usize{ 320, 640, 70 }) |width| {
+        var hg = try t.Host.init(gpu, rng, width, k);
+        defer hg.deinit(a);
+        var hu = try t.Host.init(gpu, rng, width, k);
+        defer hu.deinit(a);
+        const rows = prompt_rows ++ [_]usize{ 256, 4096, 77 };
+        for (rows) |m| {
+            const want = try a.alloc(u8, m * width * 2);
+            defer a.free(want);
+            const got = try a.alloc(u8, m * width * 2);
+            defer a.free(got);
+            const sk = qmmf.planFor(m, hg.w, r.lane.clusters).sk;
+            production();
+            try r.poison();
+            try r.lane.matmul(r.s, r.dx.ptr, ldx, m, hg.w, r.gate.ptr, r.part.ptr);
+            try r.lane.matmul(r.s, r.dx.ptr, ldx, m, hu.w, r.up.ptr, r.part.ptr);
+            try t.swigluLaunch(r.swiglu, r.s, r.gate.ptr, r.up.ptr, r.dy.ptr, m, width);
+            try r.take(want);
+            if (m >= qmmf.fused_rows or sk == 1) for ([_]bool{ false, true }) |wide| {
+                try r.poison();
+                try r.lane.dtileGateUp(r.s, r.dx.ptr, ldx, m, hg.w, hu.w, r.dy.ptr, sk, wide);
+                try r.take(got);
+                try check.sameBytes(if (wide) "64-row dtile gate+up+SwiGLU against two lane matmuls and fn_shared_swiglu" else "32-row dtile gate+up+SwiGLU against two lane matmuls and fn_shared_swiglu", got, want);
+            };
+            if (m < qmmf.fused_rows) continue;
+            try r.poison();
+            try r.lane.sharedGateUp(r.s, r.dx.ptr, ldx, m, hg.w, hu.w, r.dy.ptr);
+            try r.take(got);
+            try check.sameBytes("the fused shared tile against two lane matmuls and fn_shared_swiglu", got, want);
+            for ([_]qmmf.Dtile{ .all, .block }) |d| {
+                qmmf.dtile = d;
+                try check.expect(qmmf.sharedGateUpTakes(m), "dtile takes the shared gate+up at {d} rows", .{m});
+                try r.poison();
+                try r.lane.sharedGateUp(r.s, r.dx.ptr, ldx, m, hg.w, hu.w, r.dy.ptr);
+                try r.take(got);
+                try check.sameBytes("sharedGateUp with TF_FLASHNEXT_PROMPT_DTILE against two lane matmuls and fn_shared_swiglu", got, want);
+            }
+        }
+    }
+    check.pass("TF_FLASHNEXT_PROMPT_DTILE gate+up+SwiGLU (32 and 64 rows) equals two lane matmuls and fn_shared_swiglu byte for byte, widths 70, 320 and 640, rows 256 to 4096 and the mixed-round pieces", .{});
+}
+
+const reps = 20;
+
+const Timer = struct {
+    t0: cuda.Event,
+    t1: cuda.Event,
+
+    fn ms(tm: *Timer, r: *Rig, ctx: anytype, comptime f: anytype) !f64 {
+        var out: f64 = 0;
+        for (0..2) |round| {
+            try tm.t0.record(r.s);
+            for (0..reps) |_| try f(r, ctx);
+            try tm.t1.record(r.s);
+            try tm.t1.synchronize();
+            if (round == 1) out = @as(f64, try cuda.Event.elapsedMs(tm.t0, tm.t1)) / reps;
+        }
+        return out;
+    }
+};
+
+fn tflops(m: usize, n: usize, k: usize, ms: f64) f64 {
+    return 2.0 * @as(f64, @floatFromInt(m)) * @as(f64, @floatFromInt(n)) * @as(f64, @floatFromInt(k)) / (ms * 1e9);
+}
+
+const Call = struct { m: usize, ldx: usize, w: qmmf.Weight, w2: qmmf.Weight = undefined, out: qmmf.Out, alt: bool = false, sk: u32 = 1 };
+
+fn prodPrompt(r: *Rig, c: Call) !void {
+    production();
+    try r.lane.matmulPrompt(r.s, r.dx.ptr, c.ldx, c.m, c.w, r.dy.ptr, c.out, r.part.ptr);
+}
+fn dtileChain(r: *Rig, c: Call) !void {
+    try r.lane.promptDtile(r.s, r.dx.ptr, c.ldx, c.m, c.w, r.dy.ptr, c.out, c.alt);
+}
+fn prodOut(r: *Rig, c: Call) !void {
+    production();
+    try r.lane.matmulOut(r.s, r.dx.ptr, c.ldx, c.m, c.w, r.dy.ptr, c.out, r.part.ptr);
+}
+fn dtileOut(r: *Rig, c: Call) !void {
+    try r.lane.dtileBlock(r.s, r.dx.ptr, c.ldx, c.m, c.w, r.dy.ptr, c.out, c.sk);
+}
+fn prodGateUp(r: *Rig, c: Call) !void {
+    production();
+    try r.lane.matmul(r.s, r.dx.ptr, c.ldx, c.m, c.w, r.gate.ptr, r.part.ptr);
+    try r.lane.matmul(r.s, r.dx.ptr, c.ldx, c.m, c.w2, r.up.ptr, r.part.ptr);
+    try t.swigluLaunch(r.swiglu, r.s, r.gate.ptr, r.up.ptr, r.dy.ptr, c.m, c.w.n);
+}
+fn fusedGateUp(r: *Rig, c: Call) !void {
+    production();
+    try r.lane.sharedGateUp(r.s, r.dx.ptr, c.ldx, c.m, c.w, c.w2, r.dy.ptr);
+}
+fn dtileGateUp(r: *Rig, c: Call) !void {
+    try r.lane.dtileGateUp(r.s, r.dx.ptr, c.ldx, c.m, c.w, c.w2, r.dy.ptr, c.sk, c.alt);
+}
+
+pub fn bench(gpu: check.Gpu) !void {
+    const a = gpu.gpa;
+    const saved = Saved.now();
+    defer saved.restore();
+    const max_m = 1536;
+    const ldx = 3072;
+    var prng = std.Random.DefaultPrng.init(0xd711_be4c);
+    const rng = prng.random();
+    const x = try t.activations(gpu, rng, max_m, ldx, ldx);
+    defer a.free(x);
+    var r = try Rig.init(gpu, x, max_m, 8240);
+    defer r.deinit();
+    var tm: Timer = .{ .t0 = try cuda.Event.init(gpu.d, true), .t1 = try cuda.Event.init(gpu.d, true) };
+    defer tm.t0.deinit();
+    defer tm.t1.deinit();
+    var dn = try t.Host.init(gpu, rng, 8240, 2560);
+    defer dn.deinit(a);
+    var qkv = try t.Host.init(gpu, rng, 7296, 2560);
+    defer qkv.deinit(a);
+    var o = try t.Host.init(gpu, rng, 2560, 3072);
+    defer o.deinit(a);
+    var down = try t.Host.init(gpu, rng, 2560, 320);
+    defer down.deinit(a);
+    var gate = try t.Host.init(gpu, rng, 320, 2560);
+    defer gate.deinit(a);
+    var up = try t.Host.init(gpu, rng, 320, 2560);
+    defer up.deinit(a);
+    std.debug.print("ms a launch (TFLOPS); prod = PROMPT_GEMM2 + PROMPT_MX_PERM + LANE_TILE; a pass = 36 DeltaNet in + 12 qkv + 48 out + 48 shared gate+up + 48 shared down\n", .{});
+    for (prompt_rows) |m| {
+        var prod_pass: f64 = 0;
+        var dtile_pass: f64 = 0;
+        var best_pass: f64 = 0;
+        for ([_]struct { name: []const u8, h: *t.Host, per: f64 }{ .{ .name = "DeltaNet in", .h = &dn, .per = 36 }, .{ .name = "attention qkv", .h = &qkv, .per = 12 } }) |site| {
+            const w = site.h.w;
+            const c: Call = .{ .m = m, .ldx = 2560, .w = w, .out = .bf16 };
+            const p0 = try tm.ms(&r, c, prodPrompt);
+            var cw = c;
+            const c256 = try tm.ms(&r, cw, dtileChain);
+            cw.alt = true;
+            const c128 = try tm.ms(&r, cw, dtileChain);
+            const pick = if (qmmf.dtileChainNarrow(m, w.n)) c128 else c256;
+            prod_pass += p0 * site.per;
+            dtile_pass += pick * site.per;
+            best_pass += @min(p0, @min(c256, c128)) * site.per;
+            std.debug.print("RESULT prompt-dtile {d} rows {s} n {d} k {d}: prod {d:.3} ({d:.0}) c256 {d:.3} ({d:.0}) c128 {d:.3} ({d:.0}) pick {s}\n", .{ m, site.name, w.n, w.k, p0, tflops(m, w.n, w.k, p0), c256, tflops(m, w.n, w.k, c256), c128, tflops(m, w.n, w.k, c128), if (qmmf.dtileChainNarrow(m, w.n)) "c128" else "c256" });
+        }
+        for ([_]struct { name: []const u8, h: *t.Host, ldx: usize }{ .{ .name = "out", .h = &o, .ldx = 3072 }, .{ .name = "shared down", .h = &down, .ldx = 320 } }) |site| {
+            const w = site.h.w;
+            const c: Call = .{ .m = m, .ldx = site.ldx, .w = w, .out = .f32, .sk = qmmf.planFor(m, w, r.lane.clusters).sk };
+            const p0 = try tm.ms(&r, c, prodOut);
+            const b = try tm.ms(&r, c, dtileOut);
+            prod_pass += p0 * 48;
+            dtile_pass += b * 48;
+            best_pass += @min(p0, b) * 48;
+            std.debug.print("RESULT prompt-dtile {d} rows {s} n {d} k {d} slices {d}: prod {d:.3} ({d:.0}) b64 {d:.3} ({d:.0})\n", .{ m, site.name, w.n, w.k, c.sk, p0, tflops(m, w.n, w.k, p0), b, tflops(m, w.n, w.k, b) });
+        }
+        {
+            const c: Call = .{ .m = m, .ldx = 2560, .w = gate.w, .w2 = up.w, .out = .bf16, .sk = qmmf.planFor(m, gate.w, r.lane.clusters).sk };
+            const p0 = try tm.ms(&r, c, prodGateUp);
+            const f = try tm.ms(&r, c, fusedGateUp);
+            var cw = c;
+            cw.alt = true;
+            const g64 = try tm.ms(&r, cw, dtileGateUp);
+            cw.alt = false;
+            const g32 = try tm.ms(&r, cw, dtileGateUp);
+            const wide = qmmf.dtileGuWide(m, gate.w.n);
+            prod_pass += p0 * 48;
+            dtile_pass += (if (wide) g64 else g32) * 48;
+            best_pass += @min(@min(p0, f), @min(g64, g32)) * 48;
+            std.debug.print("RESULT prompt-dtile {d} rows shared gate+up width 320 k 2560: prod lane x2 + SwiGLU {d:.3} ({d:.0}) fused {d:.3} ({d:.0}) gu64 {d:.3} ({d:.0}) gu32 {d:.3} ({d:.0}) pick {s}\n", .{ m, p0, tflops(m, 640, 2560, p0), f, tflops(m, 640, 2560, f), g64, tflops(m, 640, 2560, g64), g32, tflops(m, 640, 2560, g32), if (wide) "gu64" else "gu32" });
+        }
+        std.debug.print("RESULT prompt-dtile {d} rows a pass: prod {d:.2} ms, dtile {d:.2} ms ({d:.2} saved), best of each {d:.2} ms\n", .{ m, prod_pass, dtile_pass, prod_pass - dtile_pass, best_pass });
+    }
+}
diff --git a/zig/tests/pcache_replay.zig b/zig/tests/pcache_replay.zig
