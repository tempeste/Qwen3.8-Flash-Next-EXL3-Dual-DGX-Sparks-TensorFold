+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5, nw = blockDim.x >> 5, threads = blockDim.x;
+    const int KG = K / GS, per = KG / SK, slice = blockIdx.y, g0 = slice * per;
+    const int n8 = blockIdx.x * nw + warp;
+    const bool valid = n8 * 8 < N;
+    const int t = n8 >> 3, jj = n8 & 7;
+    const uint4* wp = reinterpret_cast<const uint4*>(w) + static_cast<size_t>(t) * KG * 256 + jj * 32 + lane;
+    const uint32_t* sp = reinterpret_cast<const uint32_t*>(bs) + static_cast<size_t>(t) * KG * 32 + jj * 4 + (lane & 3);
+
+    auto load = [&](int s, int g) {
+        unsigned char* p = buf + s * STAGE;
+        for (int c = tid; c < BM * CHUNKS; c += threads) {
+            const int r = c / CHUNKS, ch = c % CHUNKS;
+            cp16z(p + r * ROW + swz<CHUNKS>(r, ch) * 16, x + static_cast<size_t>(min(r, M - 1)) * ldx + g * GS + ch * 8, r < M);
+        }
+    };
+
+    float acc[MT][4];
+#pragma unroll
+    for (int i = 0; i < MT; ++i)
+#pragma unroll
+        for (int e = 0; e < 4; ++e) acc[i][e] = 0.0f;
+#pragma unroll
+    for (int s = 0; s < DEC_STAGES - 1; ++s) {
+        if (s < per) load(s, g0 + s);
+        commit();
+    }
+    uint4 wq[DEC_PF];
+    uint32_t sq[DEC_PF];
+#pragma unroll
+    for (int u = 0; u < DEC_PF; ++u) {
+        const bool on = valid && u < per;
+        wq[u] = on ? __ldg(wp + static_cast<size_t>(g0 + u) * 256) : make_uint4(0u, 0u, 0u, 0u);
+        sq[u] = on ? __ldg(sp + static_cast<size_t>(g0 + u) * 32) : 0u;
+    }
+    for (int it0 = 0; it0 < per; it0 += DEC_PF) {
+#pragma unroll
+        for (int u = 0; u < DEC_PF; ++u) {
