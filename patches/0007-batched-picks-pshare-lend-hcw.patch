+}
+
+/// TF_FLASHNEXT_VERIFY_PICK_BATCH: a shared verify pass's windows (`sizes` rows each, side by side) through one launch
+/// against each window's own launch into the same slots: every row the same candidate set and flag; then the time of
+/// both for the 28-stream round's shape.
+fn windows(r: *Rig, mod: cuda.Module, n: usize, sizes: []const usize, count: usize, levels: u8, bad: usize) !void {
+    const f = try mod.function("fn_row_cand");
+    var total: usize = 0;
+    for (sizes) |k| total += k;
+    const host = try r.a.alloc(u16, total * n);
+    for (0..total) |i| tied(r, host[i * n ..][0..n], levels);
+    if (bad < total) host[bad * n + n / 5] = 0x7fc0;
+    const scores = try r.dev(std.mem.sliceAsBytes(host));
+    const stride = mtp.cand_max;
+    var bufs: [2][3]u64 = undefined;
+    for (&bufs) |*b| b.* = .{ try r.out(total * stride * 4), try r.out(total * stride * 4), try r.out(total * 4) };
+    var row: usize = 0;
+    for (sizes) |k| {
+        try candLaunch(f, r, scores + row * n * 2, n, k, count, bufs[0][0] + row * stride * 4, bufs[0][1] + row * stride * 4, bufs[0][2] + row * 4);
+        row += k;
+    }
+    try candLaunch(f, r, scores, n, total, count, bufs[1][0], bufs[1][1], bufs[1][2]);
+    const fa = try r.back(i32, bufs[0][2], total);
+    const fb = try r.back(i32, bufs[1][2], total);
+    const va = try r.back(f32, bufs[0][0], total * stride);
+    const vb = try r.back(f32, bufs[1][0], total * stride);
+    const ca = try r.back(i32, bufs[0][1], total * stride);
+    const cb = try r.back(i32, bufs[1][1], total * stride);
+    const k = @min(count, n);
+    const Pair = struct { c: i32, v: u32 };
+    const less = struct {
+        fn before(_: void, x: Pair, y: Pair) bool {
+            return x.c < y.c;
+        }
+    }.before;
+    for (0..total) |i| {
+        try check.expect(fa[i] == fb[i] and fa[i] == @intFromBool(i == bad), "fn_row_cand windows n={d} count={d} row {d}: flags {d} alone, {d} side by side", .{ n, count, i, fa[i], fb[i] });
+        if (fa[i] != 0) continue;
+        var g: [mtp.cand_max]Pair = undefined;
+        var w: [mtp.cand_max]Pair = undefined;
+        for (0..k) |j| {
+            w[j] = .{ .c = ca[i * stride + j], .v = @bitCast(va[i * stride + j]) };
+            g[j] = .{ .c = cb[i * stride + j], .v = @bitCast(vb[i * stride + j]) };
+        }
+        std.mem.sort(Pair, g[0..k], {}, less);
+        std.mem.sort(Pair, w[0..k], {}, less);
+        for (g[0..k], w[0..k]) |x, y| try check.expect(x.c == y.c and x.v == y.v, "fn_row_cand windows n={d} count={d} levels={d} row {d}: column {d} side by side for column {d} alone", .{ n, count, levels, i, x.c, y.c });
+    }
+    const reps = 200;
+    var us: [2]f64 = undefined;
+    for (0..2) |m| {
+        for (0..reps + 10) |rep| {
+            if (rep == 10) {
+                try r.s.synchronize();
+                us[m] = @floatFromInt(nowNs());
+            }
+            if (m == 1) {
+                try candLaunch(f, r, scores, n, total, count, bufs[1][0], bufs[1][1], bufs[1][2]);
+                continue;
+            }
+            row = 0;
+            for (sizes) |x| {
+                try candLaunch(f, r, scores + row * n * 2, n, x, count, bufs[0][0] + row * stride * 4, bufs[0][1] + row * stride * 4, bufs[0][2] + row * 4);
+                row += x;
+            }
+        }
+        try r.s.synchronize();
+        us[m] = (@as(f64, @floatFromInt(nowNs())) - us[m]) / 1000.0 / reps;
+    }
+    std.debug.print("PERF fn_row_cand windows n={d} windows={d} rows={d} count={d} levels={d}: a launch a window {d:.1} us, one launch {d:.1} us, saves {d:.1} us\n", .{ n, sizes.len, total, count, levels, us[0], us[1], us[0] - us[1] });
+}
+
 const Timespec = extern struct { sec: i64, nsec: i64 };
 extern "c" fn clock_gettime(clk: c_int, ts: *Timespec) c_int;
 
