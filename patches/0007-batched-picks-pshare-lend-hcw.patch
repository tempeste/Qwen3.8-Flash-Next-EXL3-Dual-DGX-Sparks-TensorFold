+
+const Hcw = struct {
+    c: Chain,
+    rinv: u64,
+    br4: u64 = 0,
+    br5: u64 = 0,
+    h0: u64 = 0,
+    inj0: u64 = 0,
+
+    fn at(w: Hcw, r0: usize, m: usize) Hcw {
+        return .{ .c = w.c.shifted(r0, m), .rinv = w.rinv + r0 * streams * 4, .br4 = w.br4 + r0 * dims * 4, .br5 = w.br5 + r0 * dims * 4, .h0 = w.h0 + r0 * wide * 2, .inj0 = w.inj0 + r0 * streams * 2 };
+    }
+
+    fn brOf(w: *const Hcw, mode: usize) u64 {
+        return if (mode == 5) w.br5 else w.br4;
+    }
+
+    fn restore(w: *Hcw) !void {
+        const d = w.c.r.gpu.d;
+        try (cuda.DeviceBuffer{ .d = d, .ptr = w.c.h, .len = w.c.rows * wide * 2 }).copyFrom(0, w.h0, w.c.rows * wide * 2, w.c.r.s.handle);
+        try (cuda.DeviceBuffer{ .d = d, .ptr = w.c.inj, .len = w.c.rows * streams * 2 }).copyFrom(0, w.inj0, w.c.rows * streams * 2, w.c.r.s.handle);
+    }
+
+    fn poisonWb(w: *Hcw) !void {
+        try w.c.part_poison();
+        try w.poisonRinv();
+        try (cuda.DeviceBuffer{ .d = w.c.r.gpu.d, .ptr = w.c.pss, .len = w.c.rows * nc * streams * 4 }).fill8(0xff, w.c.r.s.handle);
+    }
+
+    fn writeback(w: *Hcw, mode: usize) !void {
+        try w.c.g.hcWriteback(w.c.r.s, w.c.h, w.c.h, w.c.pss, w.brOf(mode), w.c.inj, 0, 0, wb_rs, w.c.rows, dims, streams, mode, 1, 1, 2);
+    }
+
+    fn wbSplit(w: *Hcw, mode: usize, dn: u8, up_v: u8) !void {
+        try w.writeback(mode);
+        try w.readout(dn, up_v);
+    }
+
+    fn wbDown(w: *Hcw, mode: usize, dn: u8) !void {
+        try w.writeback(mode);
+        try w.down(dn);
+    }
+
+    fn fusedDown(w: *Hcw, wb: u8, mode: usize, wbc: usize) !void {
+        try tk.hcfWbdn(w.c.t, w.c.r.s, wb - 1, mode, wbc, w.c.h, w.c.pss, w.c.scale, w.c.wdown.codes, w.c.part, w.rinv, w.brOf(mode), w.c.inj, wb_rs, w.c.rows, n_down, wide, qmmf.splitK(n_down, wide), dims, streams, eps);
+    }
+
+    fn fused(w: *Hcw, wb: u8, mode: usize, wbc: usize, up_v: u8, blk: usize) !void {
+        const n = w.c.rows;
+        const step = if (blk == 0) n else blk;
+        var b0: usize = 0;
+        while (b0 < n) : (b0 += step) {
+            var part = w.at(b0, @min(step, n - b0));
+            try part.fusedDown(wb, mode, wbc);
+            try part.c.reduce();
+            try part.up(1, up_v);
+        }
+    }
+
+    fn decP(w: *Hcw, ti: usize, ctas: usize) !void {
