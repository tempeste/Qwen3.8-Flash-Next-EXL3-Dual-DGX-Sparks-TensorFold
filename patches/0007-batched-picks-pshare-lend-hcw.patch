+    const pss = s.pss + r0 * pss_n * 4;
+    const act = s.act + r0 * low * 2;
+    const xs_act = s.xs_act + r0 * (low / 32) * 4;
+    const inj_ptr = if (hc_w.has_inj == 1) s.inj + r0 * streams * 2 else act;
+    const sk = cuda.qmmf.planFor(n, down, true).sk;
+    const dec = (knobs.hcw() catch knobs.Hcw{}).dec;
+    if (dec != 0) {
+        const rinv = s.rinv + r0 * streams * 4;
+        try tk.hcwDecDown(&k.tiles, stream, pickHcd(n, "TF_FLASHNEXT_HCD_DN", true), h, pss, hc_w.scale.ptr, down.codes, s.hc_part, rinv, n, down.n, down.k, sk, dims, streams, eps);
+        try tri.hcReduceAct(s.hc_part, act, xs_act, inj_ptr, sk, n, streams, low, hc_w.n_down, hc_w.has_inj);
+        if (dec == 2) return tk.hcwDecUpP(&k.tiles, stream, pickHcd(n, "TF_FLASHNEXT_HCD_UP", true), 0, act, hc_w.up.native.?.codes, h, rinv, hc_w.scale.ptr, s.mixed + r0 * dims * 2, s.xsm + r0 * (dims / 32) * 4, n, dims);
+        return tk.hcwDecUp(&k.tiles, stream, pickHcd(n, "TF_FLASHNEXT_HCD_UP", false), act, hc_w.up.native.?.codes, h, rinv, hc_w.scale.ptr, s.mixed + r0 * dims * 2, s.xsm + r0 * (dims / 32) * 4, n, dims);
+    }
+    try tk.hcdDown(&k.tiles, stream, pickHcd(n, "TF_FLASHNEXT_HCD_DN", true), h, pss, hc_w.scale.ptr, down.codes, s.hc_part, n, down.n, down.k, sk, dims, streams, eps);
+    try tri.hcReduceAct(s.hc_part, act, xs_act, inj_ptr, sk, n, streams, low, hc_w.n_down, hc_w.has_inj);
+    try tk.hcdUp(&k.tiles, stream, pickHcd(n, "TF_FLASHNEXT_HCD_UP", false), act, hc_w.up.native.?.codes, h, pss, hc_w.scale.ptr, s.mixed + r0 * dims * 2, s.xsm + r0 * (dims / 32) * 4, n, dims, eps);
+}
