diff --git a/zig/src/families/flashnext/cuda_lend.zig b/zig/src/families/flashnext/cuda_lend.zig
new file mode 100644
index 0000000000000000000000000000000000000000..34101938b143add5ff95f231fa739c85d9c09624
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_lend.zig
@@ -0,0 +1,541 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const routed = @import("cuda_modelopt_experts.zig");
+const knobs = @import("cuda_knobs.zig");
+const coll = @import("cuda_collective.zig");
+
+const dims = wt.dims;
+const slots = wt.slots;
+const experts_n = wt.experts_n;
+
+pub const weight_pairs: i32 = 32;
+pub const slot: usize = 1;
+pub const meta_at: usize = experts_n * 4;
+pub const half: usize = experts_n / 2;
+pub const hot_floor: usize = 64;
+pub const count_every: u64 = 8;
+pub const count_rows: usize = 512;
+
+pub const Bufs = struct { b: usize, cap: usize, map: u64, gemm: u64, pick: u64, pair: u64, flags: u64, x: u64, send: u64, recv: u64 };
+
+pub const Sum = struct { map: u64, recv: u64, slot: cuda.Function, slot_bf: cuda.Function };
+
+pub fn cap(rows: usize, b: usize) usize {
+    const routed_pairs = rows * (slots - 1);
+    const want = std.mem.alignForward(usize, std.math.divCeil(usize, routed_pairs * b, experts_n) catch unreachable, 64);
+    return @min(want, routed_pairs);
+}
+
+pub fn capOf(rows: usize, b: usize, hot: bool) usize {
+    return cap(rows, if (hot) @max(b, hot_floor) else b);
+}
+
+pub fn scratchBytes(rows: usize, b: usize) usize {
+    return scratchBytesOf(rows, b, (knobs.tpLendSet() catch null) != null);
+}
+
+pub fn scratchBytesOf(rows: usize, b: usize, hot: bool) usize {
+    if (b == 0) return 0;
+    const c = capOf(rows, b, hot);
+    const pairs = rows * slots;
+    var n: usize = 0;
+    for ([_]usize{ pairs * 4, pairs * 4, c * 4, c * 4, (experts_n + 8) * 4, c * dims * 2, c * dims * 4, c * dims * 4 }) |len| n += @max(len, 256);
+    return n;
+}
+
+pub fn set(count: usize, world: usize, rank: usize, b: usize) !?routed.Experts {
+    if (b == 0) return null;
+    if (world != 2 or rank >= world) return error.LendNeedsTwoRanks;
+    if (try knobs.tpExpertStride()) return error.LendWithExpertStride;
+    const peer = try routed.Experts.split(count, world, 1 - rank, false);
+    if (b > peer.count or peer.count % b != 0) return error.BadLend;
+    return .{ .first = peer.first, .count = b, .stride = peer.count / b };
+}
+
+pub fn checkLoad(own_prompt: bool, prompt_rows: usize, graph: bool, own_slot_sum: bool, split_sum: bool) !void {
+    if (!own_prompt) return error.LendNeedsPromptKernels;
+    if (prompt_rows != 1) return error.LendNeedsPromptRowsOne;
+    if (graph) return error.LendBesideDecodeGraph;
+    if (!own_slot_sum) return error.LendNeedsOwnSlotSum;
+    if (!split_sum) return error.LendNeedsSplitSum;
+}
+
+pub const Counts = struct {
+    layers: usize,
+    passes: u64,
+    n: []u64,
+
+    pub fn free(c: Counts, a: std.mem.Allocator) void {
+        a.free(c.n);
+    }
+
+    pub fn row(c: Counts, layer: usize) []const u64 {
+        return c.n[layer * experts_n ..][0..experts_n];
+    }
+};
+
+pub const header = "tf-lend-counts";
+
+pub fn parseCounts(a: std.mem.Allocator, text: []const u8) !Counts {
+    var it = std.mem.tokenizeAny(u8, text, " \n");
+    const want = [_][]const u8{ header, "1", "layers" };
+    for (want) |w| if (!std.mem.eql(u8, it.next() orelse return error.BadLendSet, w)) return error.BadLendSet;
+    const layers = try number(usize, it.next());
+    if (layers == 0 or layers > 256) return error.BadLendSet;
+    if (!std.mem.eql(u8, it.next() orelse return error.BadLendSet, "experts")) return error.BadLendSet;
+    if (try number(usize, it.next()) != experts_n) return error.BadLendSet;
+    if (!std.mem.eql(u8, it.next() orelse return error.BadLendSet, "passes")) return error.BadLendSet;
+    const passes = try number(u64, it.next());
+    const n = try a.alloc(u64, layers * experts_n);
+    errdefer a.free(n);
+    for (0..layers) |l| {
+        if (try number(usize, it.next()) != l) return error.BadLendSet;
+        for (n[l * experts_n ..][0..experts_n]) |*v| v.* = try number(u64, it.next());
+    }
+    if (it.next() != null) return error.BadLendSet;
+    return .{ .layers = layers, .passes = passes, .n = n };
+}
+
+fn number(comptime T: type, word: ?[]const u8) !T {
+    const w = word orelse return error.BadLendSet;
+    for (w) |ch| if (ch < '0' or ch > '9') return error.BadLendSet;
+    return std.fmt.parseInt(T, w, 10) catch error.BadLendSet;
+}
+
+pub fn formatCounts(a: std.mem.Allocator, layers: usize, passes: u64, n: []const u64) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try out.print(a, "{s} 1 layers {d} experts {d} passes {d}\n", .{ header, layers, experts_n, passes });
+    for (0..layers) |l| {
+        try out.print(a, "{d}", .{l});
+        for (n[l * experts_n ..][0..experts_n]) |v| try out.print(a, " {d}", .{v});
+        try out.append(a, '\n');
+    }
+    return out.toOwnedSlice(a);
+}
+
+pub fn hottest(row: []const u64, h: usize, out: []u16) void {
+    var order: [half]u16 = undefined;
+    for (&order, 0..) |*o, i| o.* = @intCast(h * half + i);
+    const Ctx = struct {
+        row: []const u64,
+        fn more(c: @This(), x: u16, y: u16) bool {
+            return c.row[x] > c.row[y] or (c.row[x] == c.row[y] and x < y);
+        }
+    };
+    std.mem.sort(u16, &order, Ctx{ .row = row }, Ctx.more);
+    @memcpy(out, order[0..out.len]);
+    std.mem.sort(u16, out, {}, std.sort.asc(u16));
+}
+
+pub fn table(c: Counts, layer: usize, b: usize, out: []i32) void {
+    var ids: [2 * 128]u16 = undefined;
+    @memset(out[2 * b ..][0..experts_n], -1);
+    for (0..2) |h| {
+        const part = ids[h * b ..][0..b];
+        hottest(c.row(layer), h, part);
+        for (part, 0..) |e, k| {
+            out[h * b + k] = e;
+            out[2 * b + e] = @intCast(k);
+        }
+    }
+}
+
+pub fn readCounts(a: std.mem.Allocator, io: std.Io, path: []const u8) !Counts {
+    const text = std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 26)) catch return error.BadLendSet;
+    defer a.free(text);
+    return parseCounts(a, text);
+}
+
+pub fn layerOf(prefix: []const u8) ?usize {
+    const at = std.mem.lastIndexOf(u8, prefix, "layers.") orelse return null;
+    var it = std.mem.splitScalar(u8, prefix[at + "layers.".len ..], '.');
+    return std.fmt.parseInt(usize, it.next() orelse return null, 10) catch null;
+}
+
+pub fn hotSet(a: std.mem.Allocator, c: Counts, layer: usize, rank: usize, b: usize) ![]u16 {
+    if (layer >= c.layers) return error.BadLendSet;
+    const ids = try a.alloc(u16, b);
+    hottest(c.row(layer), 1 - rank, ids);
+    return ids;
+}
+
+pub fn loadTable(a: std.mem.Allocator, d: *const cuda.Driver, io: std.Io, prefix: []const u8) !?cuda.DeviceBuffer {
+    const b = try knobs.tpLend();
+    if (b == 0) return null;
+    const path = (try knobs.tpLendSet()) orelse return null;
+    if (@import("cuda_exl3_experts.zig").partOf(prefix) != .main) return null;
+    const layer = layerOf(prefix) orelse return error.BadLendSet;
+    const c = try readCounts(a, io, path);
+    defer c.free(a);
+    if (layer >= c.layers) return error.BadLendSet;
+    const t = try a.alloc(i32, 2 * b + experts_n);
+    defer a.free(t);
+    table(c, layer, b, t);
+    return try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(t));
+}
+
+pub fn load(a: std.mem.Allocator, d: *const cuda.Driver, store: *wt.Store, prefix: []const u8, world: usize, rank: usize, own: *const routed.Owned) !?routed.Owned {
+    const b = try knobs.tpLend();
+    if (b == 0) return null;
+    const exl3 = @import("cuda_exl3_experts.zig");
+    if (exl3.partOf(prefix) != .main) return null;
+    var lent = (try set(wt.experts_n, world, rank, b)).?;
+    var hot: ?[]u16 = null;
+    defer if (hot) |h| a.free(h);
+    if (try knobs.tpLendSet()) |path| {
+        const c = try readCounts(a, store.io, path);
+        defer c.free(a);
+        hot = try hotSet(a, c, layerOf(prefix) orelse return error.BadLendSet, rank, b);
+        lent = .{ .first = lent.first, .count = b, .ids = hot };
+    }
+    const x = store.experts_exl3 orelse return error.LendNeedsExl3;
+    if (own.format != .exl3) return error.LendNeedsExl3;
+    try checkLoad(own.exl3_prompt, try @import("cuda_exl3_prompt.zig").rowsFrom(std.c.getenv("TF_EXL3_PROMPT_ROWS")), @import("cuda_round_graph.zig").enabled(), knobs.tpMoePartial() and knobs.tpMoeOwn() and knobs.tpSharedSlot(), try knobs.tpSplitSum());
+    _ = try knobs.tpLendMinRows();
+    var o = try exl3.loadSet(a, d, x, prefix, lent, wt.dims, wt.moe_w);
+    errdefer o.free();
+    if (!o.exl3_prompt) return error.LendNeedsPromptKernels;
+    return o;
+}
+
+pub fn takes(b: usize, have: bool, partial: bool, own_slot: bool, sums: bool, on_main: bool, ride: usize, ride_ok: bool, route_ahead: bool, n: usize, floor: usize) bool {
+    return b != 0 and have and partial and own_slot and sums and !on_main and (ride == 0 or ride_ok) and !route_ahead and n >= floor;
+}
+
+pub fn passTakes(self: anytype, native: anytype, n: usize, own_sum: bool, slot_sum: bool, route_ahead: bool) bool {
+    const s = self.s;
+    const bufs = s.lend orelse return false;
+    const lent = native.lent orelse return false;
+    if (self.k.lend == null or self.k.exl3 == null or native.world != 2 or native.experts.format != .exl3 or lent.count != bufs.b) return false;
+    const b = knobs.tpLend() catch return false;
+    if (b != bufs.b) return false;
+    const floor = knobs.tpLendMinRows() catch return false;
+    const sums = s.sums != null;
+    const on_main = if (s.sums) |*x| x.on_main else false;
+    const ride_ok = self.ride_fast and (knobs.tpLendRide() catch false);
+    return takes(b, true, self.moe_partial, own_sum and slot_sum, sums, on_main, self.ride, ride_ok, route_ahead, n, floor) and capOf(n, b, native.lend_table != null) <= bufs.cap;
+}
+
+fn ci(v: usize) c_int {
+    return @intCast(v);
+}
+
+pub fn begin(self: anytype, native: anytype, own_picks: u64, n: usize, pairs: usize, plan: cuda.grouped.Plan, skip: i32) !u64 {
+    const s = self.s;
+    const bufs = s.lend.?;
+    const f = self.k.lend.?;
+    const lent = &native.lent.?;
+    const c = self.m.collective orelse return error.TensorParallelUnavailable;
+    const sums = if (s.sums) |*x| x else return error.TensorParallelUnavailable;
+    const tab: u64 = if (native.lend_table) |t| t.ptr else 0;
+    const cp = capOf(n, bufs.b, tab != 0);
+    const step = half / lent.count;
+    var pa: cuda.Args = .{};
+    pa.add(s.picks);
+    for ([_]usize{ pairs, slots, experts_n, step }) |v| pa.add(ci(v));
+    pa.add(tab);
+    pa.add(weight_pairs);
+    pa.add(ci(cp));
+    pa.add(bufs.flags);
+    pa.add(bufs.flags + meta_at);
+    try cuda.launch.launch(f.plan, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 } }, self.stream, &pa);
+    var ma: cuda.Args = .{};
+    ma.add(s.picks);
+    ma.add(own_picks);
+    ma.add(bufs.flags);
+    for ([_]usize{ pairs, slots, experts_n }) |v| ma.add(ci(v));
+    ma.add(skip);
+    for ([_]usize{ (1 - c.rank) * half, half, step }) |v| ma.add(ci(v));
+    ma.add(if (tab != 0) tab + 2 * lent.count * 4 else 0);
+    for ([_]usize{ lent.count, cp }) |v| ma.add(ci(v));
+    for ([_]u64{ bufs.map, bufs.gemm, bufs.pick, bufs.pair }) |v| ma.add(v);
+    try cuda.launch.launch(f.map, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1024 } }, self.stream, &ma);
+    var ga: cuda.Args = .{};
+    ga.add(s.mixed);
+    ga.add(bufs.pair);
+    ga.add(bufs.flags + meta_at);
+    ga.add(ci(slots));
+    ga.add(ci(dims * 2 / 16));
+    ga.add(ci(c.rank));
+    ga.add(bufs.x);
+    try cuda.launch.launch(f.gather, .{ .grid = .{ .x = @intCast(cp) }, .block = .{ .x = 64 } }, self.stream, &ga);
+    const kit = self.k.exl3 orelse return error.FormatNotLoaded;
+    const store = kit.grouped.storage orelse return error.Exl3ScratchShort;
+    const xp = @import("cuda_exl3_prompt.zig");
+    if (cp > kit.grouped.pair_cap) return error.Exl3ScratchShort;
+    const e = lent.count + 1;
+    try self.k.router.route(self.stream, bufs.pick, cp, e, xp.members, plan);
+    const items = cuda.grouped.maxItems(cp, e, xp.members);
+    try xp.run(&kit.experts, self.stream, lent.exl3.?, store.ptr, store.len, kit.grouped.pair_cap, bufs.x, dims, 1, bufs.pick, plan, s.moe_act, bufs.send, cp, items, @intCast(lent.count), kit.prompt_dn, kit.prompt_rot);
+    const p = [_]coll.Piece{.{ .send = bufs.send, .send_n = cp * dims, .recv = bufs.recv, .recv_n = cp * dims, .dtype = .f32 }};
+    try sums.exchange(c, .lend, self.stream, slot, &p);
+    self.lend_sum = .{ .map = bufs.map, .recv = bufs.recv, .slot = f.slot, .slot_bf = f.slot_bf };
+    return bufs.gemm;
+}
+
+pub fn join(self: anytype) !void {
+    if (self.lend_sum == null) return;
+    const sums = if (self.s.sums) |*x| x else return error.TensorParallelUnavailable;
+    try sums.join(self.stream, slot);
+}
+
+pub const Probe = struct {
+    on: bool = false,
+    min_rows: usize = 0,
+    events: [3 * ring]?cuda.Event = @splat(null),
+    rows: [ring]usize = @splat(0),
+    lent_at: [ring]bool = @splat(false),
+    filled: [ring]bool = @splat(false),
+    next: usize = 0,
+    buckets: [8]Bucket = @splat(.{}),
+
+    pub const ring = 128;
+    pub const Bucket = struct { rows: usize = 0, calls: usize = 0, lent: usize = 0, experts_ms: f64 = 0, wait_ms: f64 = 0 };
+
+    pub fn mark(p: *Probe, stream: cuda.Stream, which: usize, rows: usize) !void {
+        if (!p.on or rows < p.min_rows) return;
+        const i = if (which == 0) p.next else (p.next + ring - 1) % ring;
+        if (which == 0) {
+            if (p.filled[i]) try p.harvest(i);
+            p.rows[i] = rows;
+            p.lent_at[i] = false;
+            p.next = (p.next + 1) % ring;
+        }
+        const at = 3 * i + which;
+        if (p.events[at] == null) p.events[at] = try cuda.Event.init(stream.d, true);
+        try p.events[at].?.record(stream);
+        if (which == 2) p.filled[i] = true;
+    }
+
+    pub fn lent(p: *Probe) void {
+        if (p.on) p.lent_at[(p.next + ring - 1) % ring] = true;
+    }
+
+    fn harvest(p: *Probe, i: usize) !void {
+        const a = p.events[3 * i].?;
+        const b = p.events[3 * i + 1].?;
+        const c = p.events[3 * i + 2].?;
+        try c.synchronize();
+        const k = p.bucket(p.rows[i]);
+        k.calls += 1;
+        if (p.lent_at[i]) k.lent += 1;
+        k.experts_ms += try cuda.Event.elapsedMs(a, b);
+        k.wait_ms += try cuda.Event.elapsedMs(b, c);
+        p.filled[i] = false;
+    }
+
+    fn bucket(p: *Probe, rows: usize) *Bucket {
+        for (&p.buckets) |*k| {
+            if (k.calls != 0 and k.rows == rows) return k;
+            if (k.calls == 0) {
+                k.rows = rows;
+                return k;
+            }
+        }
+        return &p.buckets[p.buckets.len - 1];
+    }
+
+    pub fn collect(p: *Probe) !void {
+        for (0..ring) |i| if (p.filled[i]) try p.harvest(i);
+    }
+
+    pub fn reset(p: *Probe) void {
+        p.filled = @splat(false);
+        p.next = 0;
+        p.buckets = @splat(.{});
+    }
+};
+
+pub var probe: Probe = .{};
+
+pub const Capture = struct {
+    buf: ?cuda.DeviceBuffer = null,
+    layers: usize = 0,
+    passes: u64 = 0,
+
+    pub fn add(cp: *Capture, self: anytype, layer: usize, n: usize, pairs: usize) !void {
+        const f = self.k.lend_count orelse return;
+        const path = (try knobs.tpLendCount()) orelse return;
+        if (n < count_rows) return;
+        const layers = self.m.layers.len;
+        if (layer >= layers) return;
+        if (cp.buf == null) {
+            var b = try cuda.DeviceBuffer.alloc(self.stream.d, layers * experts_n * 8);
+            errdefer b.free();
+            try b.fill8(0, self.stream.handle);
+            cp.buf = b;
+            cp.layers = layers;
+        }
+        if (layers != cp.layers) return error.BadLendCount;
+        var a: cuda.Args = .{};
+        a.add(self.s.picks);
+        for ([_]usize{ pairs, slots, experts_n }) |v| a.add(ci(v));
+        a.add(cp.buf.?.ptr + layer * experts_n * 8);
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(std.math.divCeil(usize, pairs, 256) catch unreachable) }, .block = .{ .x = 256 } }, self.stream, &a);
+        if (layer + 1 != layers) return;
+        cp.passes += 1;
+        if (cp.passes % count_every == 0) try cp.flush(self.stream, self.io, self.gpa, path);
+    }
+
+    pub fn flush(cp: *Capture, stream: cuda.Stream, io: std.Io, a: std.mem.Allocator, path: []const u8) !void {
+        const b = cp.buf orelse return;
+        const n = try a.alloc(u64, cp.layers * experts_n);
+        defer a.free(n);
+        try stream.synchronize();
+        try stream.d.check(stream.d.api.cuMemcpyDtoH_v2(std.mem.sliceAsBytes(n).ptr, b.ptr, n.len * 8), "cuMemcpyDtoH");
+        const text = try formatCounts(a, cp.layers, cp.passes, n);
+        defer a.free(text);
+        const tmp = try std.fmt.allocPrint(a, "{s}.tmp", .{path});
+        defer a.free(tmp);
+        try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = tmp, .data = text });
+        try std.Io.Dir.cwd().rename(tmp, std.Io.Dir.cwd(), path, io);
+    }
+};
