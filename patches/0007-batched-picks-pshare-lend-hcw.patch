+    try start.record(c.r.s);
+    for (0..reps) |i| try f(c, ws[i % ws.len], arg);
+    try end.record(c.r.s);
+    try c.r.s.synchronize();
+    return @as(f64, try start.elapsedMs(end)) * 1000 / @as(f64, @floatFromInt(reps));
+}
+
+fn decodeTiles(gpu: check.Gpu, c: *Chain) !void {
