+const decoder_tokens = 1500;
+const longest = first_len + turn_len * (turns - 1);
+
+const Cuts = std.AutoHashMapUnmanaged(usize, []u32);
+
+fn remember(gpa: std.mem.Allocator, cuts_of: *Cuts, store: *const pc.Store, cuts: []const u32) !void {
+    const k = store.last_kept orelse return;
+    if (cuts_of.contains(@intFromPtr(k.saved))) return;
+    try cuts_of.put(gpa, @intFromPtr(k.saved), try gpa.dupe(u32, cuts));
+}
+
+fn forget(gpa: std.mem.Allocator, cuts_of: *Cuts, store: *const pc.Store) void {
+    var it = cuts_of.iterator();
+    while (it.next()) |kv| {
+        const live = for (store.entries.items) |x| {
+            if (@intFromPtr(x.saved) == kv.key_ptr.*) break true;
+        } else false;
+        if (!live) {
+            gpa.free(kv.value_ptr.*);
+            cuts_of.removeByPtr(kv.key_ptr);
+            it = cuts_of.iterator();
+        }
+    }
+}
+
+const Keeper = struct {
+    gpa: std.mem.Allocator,
+    store: *pc.Store,
+    cuts_of: *Cuts,
+    toks: []const u32 = &.{},
+    base: []const u32 = &.{},
+    ran: *std.ArrayList(u32),
+    entry: ?*pc.Entry = null,
+    keeps: usize = 0,
+    anchors: usize = 0,
+    failed: ?anyerror = null,
+
+    fn of(ptr: *anyopaque) *Keeper {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn kept(ptr: *anyopaque, s: *lanes.Stream, at: u32) void {
+        of(ptr).keep(s, at, false);
+    }
+
+    fn anchored(ptr: *anyopaque, s: *lanes.Stream, at: u32) void {
+        of(ptr).keep(s, at, true);
+    }
+
+    fn report(k: *Keeper, s: *const lanes.Stream) void {
+        const e = k.entry orelse return;
+        k.entry = null;
+        k.store.resumed(e, k.toks, !s.reuse_failed and s.cached == e.at);
+    }
+
+    fn keep(k: *Keeper, s: *lanes.Stream, at: u32, anchor: bool) void {
+        k.report(s);
+        s.reuse.saved = null;
+        const born: u32 = @intCast(k.toks.len);
+        const ok = if (anchor) k.store.keepAnchor(k.toks, born, at, s, &.{}, &.{}) else k.store.keepBorn(k.toks, born, at, s, &.{}, &.{});
+        if (!ok) return;
+        if (anchor) k.anchors += 1 else k.keeps += 1;
+        var list: std.ArrayList(u32) = .empty;
+        defer list.deinit(k.gpa);
+        list.appendSlice(k.gpa, k.base) catch |err| return k.fail(err);
+        for (k.ran.items) |c| if (c < at) list.append(k.gpa, c) catch |err| return k.fail(err);
+        list.append(k.gpa, at) catch |err| return k.fail(err);
+        remember(k.gpa, k.cuts_of, k.store, list.items) catch |err| return k.fail(err);
+    }
+
+    fn fail(k: *Keeper, err: anyerror) void {
+        if (k.failed == null) k.failed = err;
+    }
+};
+
+const Fill = struct { cached: u32, failed: bool };
+
+fn fillBeside(engine: *lanes.Engine, s: *lanes.Stream, from: u32, ran: *std.ArrayList(u32), gpa: std.mem.Allocator) !Fill {
+    const before = lanes.prefill_rows_run.load(.monotonic);
+    var at = from;
+    var first = true;
+    var cached: u32 = from;
+    var calls: usize = 0;
+    while (true) : (calls += 1) {
+        if (calls > 4 * (s.prompt().len / 64 + 8)) return error.FillDidNotFinish;
+        const done = try engine.fillStreamCommitted(s, first, null, piece_rows);
+        if (first) {
+            cached = s.cached;
+            at = cached;
+        }
+        first = false;
+        try note(before, cached, &at, ran, gpa);
+        if (done) break;
+        try engine.step();
+        try note(before, cached, &at, ran, gpa);
+    }
+    return .{ .cached = cached, .failed = s.reuse_failed };
+}
+
+fn note(before: u64, cached: u32, at: *u32, ran: *std.ArrayList(u32), gpa: std.mem.Allocator) !void {
+    const rows: u32 = @intCast(lanes.prefill_rows_run.load(.monotonic) - before);
+    const now = cached + rows;
+    if (now == at.*) return;
+    at.* = now;
+    try ran.append(gpa, now);
+}
+
+const Section = struct { what: []const u8, layer: usize, off: usize, len: usize };
+
+const Image = struct {
+    bytes: std.ArrayList(u8) = .empty,
+    sections: std.ArrayList(Section) = .empty,
+    head_kv: ?u8 = null,
+    history: [2]i64 = .{ 0, 0 },
+    fed: usize = 0,
+
+    fn deinit(m: *Image, gpa: std.mem.Allocator) void {
+        m.bytes.deinit(gpa);
+        m.sections.deinit(gpa);
+    }
+
+    fn add(m: *Image, gpa: std.mem.Allocator, what: []const u8, layer: usize, b: cuda.DeviceBuffer, off: usize, n: usize) !void {
+        if (n == 0) return;
+        if (off + n > b.len) return error.ImageShape;
+        const at = m.bytes.items.len;
+        try m.bytes.resize(gpa, at + n);
+        try b.download(off, m.bytes.items[at..][0..n]);
+        try m.sections.append(gpa, .{ .what = what, .layer = layer, .off = at, .len = n });
+    }
+};
+
+fn partName(head_piece: bool, part: anytype) []const u8 {
+    return switch (part) {
+        .key => if (head_piece) "head keys" else "keys",
+        .value => if (head_piece) "head values" else "values",
+        .raw => if (head_piece) "head raw index keys" else "raw index keys",
+        .pooled => if (head_piece) "head pooled index blocks" else "pooled index blocks",
+    };
+}
+
+fn image(gpa: std.mem.Allocator, cu: *flash.native.Cuda, s: *lanes.Stream) !Image {
+    const l = cu.lanes.getPtr(s) orelse return error.NoLane;
+    try cu.stream.synchronize();
+    var m: Image = .{ .history = l.seq.history, .fed = l.seq.fed };
+    errdefer m.deinit(gpa);
+    const q = &l.seq;
+    const len = s.prompt().len;
+    for (q.conv, 0..) |b, i| try m.add(gpa, "DeltaNet conv window", i, b, 0, b.len);
+    for (q.state, 0..) |b, i| try m.add(gpa, "DeltaNet state", i, b, 0, b.len);
+    try m.add(gpa, "n-gram tail", 0, q.tail, 0, q.tail.len);
+    const head_kv = if (l.draft) |*d| d.kv else null;
+    if (head_kv) |k| m.head_kv = @intFromEnum(k);
+    const ps = share.pieces(q.kv, head_kv, q.heads, q.window.on());
+    for (ps.p[0..ps.len]) |p| for (0..p.layers) |layer| {
+        const rows = (if (p.head) len - 1 else len) / p.per;
+        const b = if (p.head) switch (p.part) {
+            .key => l.draft.?.kc,
+            .value => l.draft.?.vc,
+            .raw => l.draft.?.ikc,
+            .pooled => l.draft.?.pooled,
+        } else switch (p.part) {
+            .key => q.kc[layer],
+            .value => q.vc[layer],
+            .raw => q.ikc[layer],
+            .pooled => q.pooled[layer],
+        };
+        try m.add(gpa, partName(p.head, p.part), layer, b, 0, rows * p.row);
+    };
+    return m;
+}
+
+fn same(what: []const u8, got: *const Image, want: *const Image) !void {
+    try check.expect(got.fed == want.fed, "{s}: the resumed lane stands at {d}, the cold one at {d}", .{ what, got.fed, want.fed });
+    try check.expect(std.mem.eql(i64, &got.history, &want.history), "{s}: n-gram history differs", .{what});
+    try check.expect(got.sections.items.len == want.sections.items.len, "{s}: {d} sections against {d} (head formats {any} and {any})", .{ what, got.sections.items.len, want.sections.items.len, got.head_kv, want.head_kv });
+    for (got.sections.items, want.sections.items) |g, w| {
+        try check.expect(g.len == w.len and std.mem.eql(u8, g.what, w.what), "{s}: section {s} {d} against {s} {d}", .{ what, g.what, g.layer, w.what, w.layer });
+        const a = got.bytes.items[g.off..][0..g.len];
+        const b = want.bytes.items[w.off..][0..w.len];
+        if (std.mem.eql(u8, a, b)) continue;
+        std.debug.print("{s}: {s} of layer {d} differs\n", .{ what, g.what, g.layer });
+        try check.sameBytes(what, a, b);
+    }
+}
+
+fn stream(out: []u32, ids: []const u32, c: usize) void {
+    for (out, 0..) |*t, i| {
+        const shared = i < head or (c < 3 and i < common);
+        t.* = if (shared) ids[(i * 13 + 5) % ids.len] else ids[(i * 7 + c * 31 + 1) % ids.len];
+    }
+}
+
+fn promptLen(t: usize) usize {
+    return first_len + turn_len * t;
+}
+
+fn copyBench(gpu: check.Gpu, s: cuda.Stream) !void {
+    const sizes = [_]usize{ 4 << 10, 64 << 10, 1 << 20 };
+    const n = 400;
+    var src = try cuda.DeviceBuffer.alloc(gpu.d, 1 << 20);
+    defer src.free();
+    var dst = try cuda.DeviceBuffer.alloc(gpu.d, 1 << 20);
+    defer dst.free();
+    const dr = s.d;
+    for (sizes) |size| {
+        try dr.check(dr.api.cuMemcpyDtoDAsync_v2(dst.ptr, src.ptr, size, s.handle), "cuMemcpyDtoDAsync");
+        try s.synchronize();
+        const t0 = check.now(gpu.io);
+        for (0..n) |_| try dr.check(dr.api.cuMemcpyDtoDAsync_v2(dst.ptr, src.ptr, size, s.handle), "cuMemcpyDtoDAsync");
+        const queued = check.now(gpu.io);
+        try s.synchronize();
+        const t1 = check.now(gpu.io);
+        std.debug.print("RESULT flashnext-pshare-ride copy: {d} copies of {d} KiB in {d:.3} ms ({d:.2} us a copy; {d:.2} us a copy to queue)\n", .{ n, size >> 10, @as(f64, @floatFromInt(t1 - t0)) / 1e6, @as(f64, @floatFromInt(t1 - t0)) / 1e3 / n, @as(f64, @floatFromInt(queued - t0)) / 1e3 / n });
+    }
+}
+
+fn restoreBench(gpu: check.Gpu, cu: *flash.native.Cuda, store: *const pc.Store) !void {
+    const session = cu.ranks orelse return;
+    for (store.entries.items) |e| {
+        if (e.expired) continue;
+        const kept: *const Snap = @ptrCast(@alignCast(e.saved));
+        const depth: usize = if (kept.share) |sh| share.Rows.depth(sh.top, @intCast(kept.at)) else 1;
+        var q = try session.create(context);
+        defer session.drop(&q);
+        try cu.stream.synchronize();
+        const t0 = check.now(gpu.io);
+        try session.restore(&q, null, kept);
+        try cu.stream.synchronize();
+        const t1 = check.now(gpu.io);
+        std.debug.print("RESULT flashnext-pshare-ride restore: {d} tokens, chain depth {d}, {d} copies on rank 0 without the head, {d:.3} ms\n", .{ kept.at, depth, share.fixedCopies(q.window.on()) + depth * (share.segmentCopies(q.window.on()) - 4), @as(f64, @floatFromInt(t1 - t0)) / 1e6 });
+    }
+}
