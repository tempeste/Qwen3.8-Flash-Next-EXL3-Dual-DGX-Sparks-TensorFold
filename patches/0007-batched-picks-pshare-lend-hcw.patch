+    }
+};
+
+fn pickDw(n: usize, sms: usize) usize {
+    var best: usize = 0;
+    var best_cost: usize = std.math.maxInt(usize);
+    const sk = qmmf.splitK(n_down, wide);
+    for (tk.hcn_dw_mt, 0..) |mt, i| {
+        const cost = ((n + 16 * mt - 1) / (16 * mt) * 2 * sk + 2 * sms - 1) / (2 * sms) * mt;
+        if (cost <= best_cost) {
+            best = i;
+            best_cost = cost;
+        }
+    }
+    return best;
+}
+
+fn decTile(m: usize) usize {
+    for (tk.hcd_mt, 0..) |mt, i| if (16 * mt >= m) return i;
+    return tk.hcd_mt.len - 1;
+}
+
+const DecOuts = struct {
+    act: []u16,
+    xs: []f32,
+    inj: []u16,
+    mixed: []u16,
+    xsm: []f32,
+
+    fn of(c: *Chain) !DecOuts {
+        const m = c.rows;
+        return .{
+            .act = try c.r.back(u16, c.act, m * low),
+            .xs = try c.r.back(f32, c.xs, m * (low / 32)),
+            .inj = try c.r.back(u16, c.inj, m * streams),
+            .mixed = try c.r.back(u16, c.mixed, m * dims),
+            .xsm = try c.r.back(f32, c.xsm, m * (dims / 32)),
+        };
+    }
+
+    fn same(o: DecOuts, want: DecOuts) !void {
+        try check.sameBytes("hcw decode act", std.mem.sliceAsBytes(o.act), std.mem.sliceAsBytes(want.act));
+        try check.sameBytes("hcw decode act sums", std.mem.sliceAsBytes(o.xs), std.mem.sliceAsBytes(want.xs));
+        try check.sameBytes("hcw decode inject", std.mem.sliceAsBytes(o.inj), std.mem.sliceAsBytes(want.inj));
+        try check.sameBytes("hcw decode mixed", std.mem.sliceAsBytes(o.mixed), std.mem.sliceAsBytes(want.mixed));
+        try check.sameBytes("hcw decode mixed sums", std.mem.sliceAsBytes(o.xsm), std.mem.sliceAsBytes(want.xsm));
+    }
+};
+
+fn poisonDecode(c: *Chain) !void {
+    const m = c.rows;
+    const bufs = [_][2]u64{ .{ c.part, 8 * m * n_down * 4 }, .{ c.act, m * low * 2 }, .{ c.xs, m * (low / 32) * 4 }, .{ c.inj, m * streams * 2 }, .{ c.mixed, m * dims * 2 }, .{ c.xsm, m * (dims / 32) * 4 } };
+    for (bufs) |b| try (cuda.DeviceBuffer{ .d = c.r.gpu.d, .ptr = b[0], .len = b[1] }).fill8(0xff, c.r.s.handle);
+}
+
+fn bf16Bytes(r: *Rig, bytes: []const u8) ![]u16 {
+    const v = try r.a.alloc(u16, bytes.len / 2);
+    @memcpy(std.mem.sliceAsBytes(v), bytes);
+    return v;
+}
+
+fn loadSite(r: *Rig, store: *Store, prefix: []const u8) !struct { wdown: qmmf.Weight, wup: qmmf.Weight, scale: u64 } {
+    var buf: [200]u8 = undefined;
+    const down_t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.input_mix_weight_down.weight", .{prefix}));
+    if (!down_t.is(.bf16, &.{ low, wide })) return error.UnexpectedTensor;
+    const wd = try r.a.alloc(u16, n_down * wide);
+    @memcpy(std.mem.sliceAsBytes(wd[0 .. low * wide]), down_t.bytes);
+    const inj_t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.block_inject_weight.weight", .{prefix}));
+    if (!inj_t.is(.bf16, &.{ streams, wide })) return error.UnexpectedTensor;
+    @memcpy(std.mem.sliceAsBytes(wd[low * wide ..]), inj_t.bytes);
+    const up_t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.input_mix_weight_up.weight", .{prefix}));
+    if (!up_t.is(.bf16, &.{ wide, low })) return error.UnexpectedTensor;
+    const wu = try bf16Bytes(r, up_t.bytes);
+    const gamma = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.hc_norm.weight", .{prefix}));
+    const scale = try store.normScale(r.a, gamma);
+    if (scale.len != wide) return error.UnexpectedTensor;
+    const pd = try r.a.alloc(u16, cuda.nvfp4.padded(n_down) * wide);
+    qmmf.packBf16(pd, wd, n_down, wide);
+    const pu = try r.a.alloc(u16, cuda.nvfp4.padded(wide) * low);
+    qmmf.packBf16(pu, wu, wide, low);
+    return .{
+        .wdown = cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(pd)), n_down, wide),
+        .wup = cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(pu)), wide, low),
+        .scale = try r.dev(std.mem.sliceAsBytes(scale)),
+    };
+}
+
+const Timer = struct {
+    start: cuda.Event,
+    end: cuda.Event,
+    s: cuda.Stream,
+
+    fn us(t: Timer, ctx: anytype, comptime f: anytype, args: anytype) !f64 {
+        try @call(.auto, f, .{ctx} ++ args);
+        try t.start.record(t.s);
+        for (0..reps) |_| try @call(.auto, f, .{ctx} ++ args);
+        try t.end.record(t.s);
+        try t.s.synchronize();
+        return @as(f64, try t.start.elapsedMs(t.end)) * 1000 / reps;
+    }
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x4c3);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var g = try flash.Glue.load(gpu.d);
+    defer g.deinit();
+    var lane = try qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+    defer lane.unload();
+    var t = try tk.TileKernels.load(gpu.d);
+    defer t.unload();
+    var store = try Store.open(gpu.gpa, gpu.io, dir);
+    defer store.deinit();
+    try store.detectNorms();
+
+    const h = r.bfs(most * wide, 3);
+    const dh = try r.dev(std.mem.sliceAsBytes(h));
+    const dpss = try r.out(most * nc * streams * 4);
+    try g.hcWriteback(r.s, dh, 0, dpss, 0, 0, 0, 0, most * dims, most, dims, streams, 0, 1, 1, 1);
+    var base: Hcw = .{
+        .c = .{
+            .r = &r,
+            .g = &g,
+            .lane = &lane,
+            .t = &t,
+            .wdown = undefined,
+            .wup = undefined,
+            .h = dh,
+            .pss = dpss,
+            .scale = 0,
+            .norm = try r.out(most * wide * 2),
+            .part = try r.out(8 * most * n_down * 4),
+            .act = try r.out(most * low * 2),
+            .xs = try r.out(most * (low / 32) * 4),
+            .inj = try r.out(most * streams * 2),
+            .up = try r.out(most * wide * 2),
+            .mixed = try r.out(most * dims * 2),
+            .xsm = try r.out(most * (dims / 32) * 4),
+            .spart = try r.out(8 * most * n_down * 4),
+            .rows = most,
+        },
+        .rinv = try r.out(most * streams * 4),
+    };
+    const own = r.f32s(most * dims, -0.5, 0.5);
+    const br4 = try r.a.alloc(f32, 2 * most * dims);
+    @memcpy(br4[0 .. most * dims], own);
+    @memcpy(br4[most * dims ..], r.f32s(most * dims, -0.5, 0.5));
+    const br5 = try r.a.alloc(f32, 2 * most * dims);
+    @memcpy(br5[0 .. most * dims], own);
+    @memcpy(std.mem.sliceAsBytes(br5[most * dims ..])[0 .. most * dims * 2], std.mem.sliceAsBytes(r.bfs(most * dims, 0.5)));
+    base.br4 = try r.dev(std.mem.sliceAsBytes(br4));
+    base.br5 = try r.dev(std.mem.sliceAsBytes(br5));
+    base.h0 = try r.dev(std.mem.sliceAsBytes(h));
+    base.inj0 = try r.dev(std.mem.sliceAsBytes(r.bfs(most * streams, 2)));
+    var tm: Timer = .{ .start = try cuda.Event.init(gpu.d, true), .end = try cuda.Event.init(gpu.d, true), .s = r.s };
+    defer tm.start.deinit();
+    defer tm.end.deinit();
+
+    var name_buf: [120]u8 = undefined;
+    for (layers) |layer| for (sites) |site| {
+        const prefix = try std.fmt.bufPrint(&name_buf, "language_model.model.layers.{d}.{s}", .{ layer, site });
+        const w = try loadSite(&r, &store, prefix);
+        base.c.wdown = w.wdown;
+        base.c.wup = w.wup;
+        base.c.scale = w.scale;
+        try prompt(&base, prefix);
+        try fusedChecks(&base, prefix);
+        try base.restore();
+        try decode(&base, prefix);
+    };
+    try times(&base, tm);
+    r.report("hcw");
+}
+
+fn prompt(base: *Hcw, prefix: []const u8) !void {
+    const Case = struct { r0: usize, m: usize };
+    const cases = [_]Case{ .{ .r0 = 0, .m = 1536 }, .{ .r0 = 768, .m = 768 }, .{ .r0 = 0, .m = 3072 }, .{ .r0 = 1019, .m = 2053 }, .{ .r0 = 0, .m = 300 }, .{ .r0 = 5, .m = 65 } };
+    var checks: usize = 0;
+    for (cases) |k| {
+        var w = base.at(k.r0, k.m);
+        const want = try fuse.chainOuts(&w.c);
+        try (try fuse.wideOuts(&w.c, pickDw(k.m, w.c.t.sms), 0, null)).same(want);
+        for (0..knobsDowns()) |dn| for (0..knobsUps()) |up_v| for (blocks) |blk| {
+            if (dn == 0 and up_v == 0 and blk == 0) continue;
+            try w.c.part_poison();
+            try w.poisonRinv();
+            try w.blocked(@intCast(dn), @intCast(up_v), blk);
+            try (try Outs.of(&w.c)).same(want);
+            checks += 1;
+        };
+    }
+    check.pass("hcw: {s}: {d} read-outs (every dn x up x blk, rows windows incl. offsets and ragged ends) = the five-launch chain = today's wide tiles, every output byte", .{ prefix, checks });
+}
+
+fn fusedChecks(base: *Hcw, prefix: []const u8) !void {
+    const Case = struct { r0: usize, m: usize };
+    const cases = [_]Case{ .{ .r0 = 0, .m = 1536 }, .{ .r0 = 768, .m = 768 }, .{ .r0 = 0, .m = 3072 }, .{ .r0 = 1019, .m = 2053 }, .{ .r0 = 0, .m = 300 }, .{ .r0 = 5, .m = 65 } };
+    var checks: usize = 0;
+    for (cases) |k| for (wb_modes) |mode| {
+        var w = base.at(k.r0, k.m);
+        try w.restore();
+        try w.poisonWb();
+        try w.wbSplit(mode, 0, 0);
+        try w.rinvOf();
+        const want = try WbOuts.of(&w);
+        for ([_]u8{ 1, 2 }) |wb| for ([_]usize{ 0, 1, 3 }) |wbc| for ([_]usize{ 0, 384 }) |blk| for (0..knobsUps()) |up_v| {
+            if (up_v != 0 and (wbc != 0 or blk != 0)) continue;
+            try w.restore();
+            try w.poisonWb();
+            try w.fused(wb, mode, wbc, @intCast(up_v), blk);
+            try (try WbOuts.of(&w)).same(want, up_v == 0);
+            checks += 1;
+        };
+    };
+    check.pass("hcw: {s}: {d} fused write-back + down read-outs (wb=1/2, modes 5 and 4, wbc 0/1/3, blk 0/384, every up) = the write-back + today's wide read-out: streams, pss, rinv and every output byte", .{ prefix, checks });
+}
+
+fn knobsDowns() usize {
+    return tk.hcw_dn_names.len + 1;
+}
+
+fn knobsUps() usize {
+    return tk.hcw_ur_names.len + 1;
+}
+
+fn decode(base: *Hcw, prefix: []const u8) !void {
+    const counts = [_]usize{ 1, 4, 10, 16, 17, 28, 33, 56, 64, 75, 84, 96 };
+    for (counts) |m| {
+        var w = base.at(1, m);
+        const ti = decTile(m);
+        try poisonDecode(&w.c);
+        try w.decOld(ti);
+        const want = try DecOuts.of(&w.c);
+        try poisonDecode(&w.c);
+        try w.poisonRinv();
+        try w.decNew(ti);
+        try (try DecOuts.of(&w.c)).same(want);
+        for ([_]usize{ 0, 40, 7, 80 }) |ctas| {
+            try poisonDecode(&w.c);
+            try w.poisonRinv();
+            try w.decP(ti, ctas);
+            try (try DecOuts.of(&w.c)).same(want);
+        }
+    }
+    check.pass("hcw: {s}: decode down/up with rinv carried and the sigmoid table (dec=1, and dec=2 on 48/40/7/80 CTAs) at {d} row counts (1-96) = fn_hcd_down/up, every output byte", .{ prefix, counts.len });
+}
+
+fn gbs(bytes: usize, us: f64) f64 {
+    return @as(f64, @floatFromInt(bytes)) / us / 1e3;
+}
+
+fn fusedTimes(base: *Hcw, tm: Timer) !void {
+    for ([_]usize{ 3072, 1536, 768 }) |m| {
+        var w = base.at(0, m);
+        const wb_b = m * (wide * 2 * 2 + dims * 4 + dims * 2 + nc * streams * 4);
+        const down_b = m * wide * 2 + n_down * wide * 2 + m * n_down * 4;
+        const fused_b = wb_b + n_down * wide * 2 + m * n_down * 4;
+        const wb5 = try tm.us(&w, Hcw.writeback, .{@as(usize, 5)});
+        std.debug.print("RESULT hcw rows {d}: write-back mode 5 {d:.1} us, {d:.0} GB/s\n", .{ m, wb5, gbs(wb_b, wb5) });
+        for (0..knobsDowns()) |dn| {
+            const us = try tm.us(&w, Hcw.wbDown, .{ @as(usize, 5), @as(u8, @intCast(dn)) });
+            std.debug.print("RESULT hcw rows {d}: write-back + down dn={d}: {d:.1} us, {d:.0} GB/s\n", .{ m, dn, us, gbs(wb_b + down_b, us) });
+        }
+        for ([_]u8{ 1, 2 }) |wb| for ([_]usize{ 0, 2, 3, 4, 5, 6, 8, 12 }) |wbc| {
+            const us = try tm.us(&w, Hcw.fusedDown, .{ wb, @as(usize, 5), wbc });
+            std.debug.print("RESULT hcw rows {d}: fused write-back + down wb={d} wbc={d}: {d:.1} us, {d:.0} GB/s\n", .{ m, wb, wbc, us, gbs(fused_b, us) });
+        };
+        for ([_]u8{ 0, 1, 2 }) |dn| for (0..knobsUps()) |up_v| {
+            const us = try tm.us(&w, Hcw.wbSplit, .{ @as(usize, 5), dn, @as(u8, @intCast(up_v)) });
+            std.debug.print("RESULT hcw rows {d}: write-back + read-out dn={d} up={d}: {d:.1} us, {d:.2} ms a pass of 96 sites\n", .{ m, dn, up_v, us, us * 96 / 1e3 });
+        };
+        for ([_]u8{ 1, 2 }) |wb| for (0..knobsUps()) |up_v| for ([_]usize{ 0, 384 }) |blk| {
+            if (blk != 0 and blk >= m) continue;
+            const us = try tm.us(&w, Hcw.fused, .{ wb, @as(usize, 5), @as(usize, 0), @as(u8, @intCast(up_v)), blk });
+            std.debug.print("RESULT hcw rows {d}: fused read-out wb={d} up={d} blk={d}: {d:.1} us, {d:.2} ms a pass of 96 sites\n", .{ m, wb, up_v, blk, us, us * 96 / 1e3 });
+        };
+    }
+}
+
+fn times(base: *Hcw, tm: Timer) !void {
+    try fusedTimes(base, tm);
+    try base.restore();
+    for ([_]usize{ 3072, 1536, 768 }) |m| {
+        var w = base.at(0, m);
+        const h_b = m * wide * 2;
+        const down_b = h_b + n_down * wide * 2 + m * n_down * 4;
+        const up_b = h_b + m * low * 2 + wide * low * 2 + m * dims * 2;
+        const red = try tm.us(&w.c, Chain.reduce, .{});
+        const rinv = try tm.us(&w, Hcw.rinvOf, .{});
+        var downs: [tk.hcw_dn_names.len + 1]f64 = undefined;
+        var ups: [tk.hcw_ur_names.len + 1]f64 = undefined;
+        for (&downs, 0..) |*d, dn| {
+            d.* = try tm.us(&w, Hcw.down, .{@as(u8, @intCast(dn))});
+            std.debug.print("RESULT hcw rows {d}: down dn={d} ({s}): {d:.1} us, {d:.0} GB/s\n", .{ m, dn, if (dn == 0) tk.hcn_dw_names[pickDw(m, w.c.t.sms)] else tk.hcw_dn_names[dn - 1], d.*, gbs(down_b, d.*) });
+        }
+        try w.down(1);
+        try w.c.reduce();
+        for (&ups, 0..) |*u, up_v| {
+            u.* = try tm.us(&w, Hcw.up, .{ @as(u8, 1), @as(u8, @intCast(up_v)) });
+            std.debug.print("RESULT hcw rows {d}: up up={d} ({s}): {d:.1} us, {d:.0} GB/s\n", .{ m, up_v, if (up_v == 0) tk.hcn_uw_names[0] else tk.hcw_ur_names[up_v - 1], u.*, gbs(up_b, u.*) });
+        }
+        std.debug.print("RESULT hcw rows {d}: reduce_act {d:.1} us, fn_hc_rinv {d:.1} us (paid by up>0 behind dn=0)\n", .{ m, red, rinv });
+        for (0..downs.len) |dn| for (0..ups.len) |up_v| for (blocks) |blk| {
+            if (blk != 0 and blk >= m) continue;
+            const us = try tm.us(&w, Hcw.blocked, .{ @as(u8, @intCast(dn)), @as(u8, @intCast(up_v)), blk });
+            std.debug.print("RESULT hcw rows {d}: read-out dn={d} up={d} blk={d}: {d:.1} us, {d:.2} ms a pass of 96 sites\n", .{ m, dn, up_v, blk, us, us * 96 / 1e3 });
+        };
+    }
+    for ([_]usize{ 75, 10, 28, 96 }) |m| {
+        var w = base.at(0, m);
+        const ti = decTile(m);
+        const old = try tm.us(&w, Hcw.decOld, .{ti});
+        const new = try tm.us(&w, Hcw.decNew, .{ti});
+        const p48 = try tm.us(&w, Hcw.decP, .{ ti, @as(usize, 0) });
+        const p40 = try tm.us(&w, Hcw.decP, .{ ti, @as(usize, 40) });
+        const bytes = 2 * (m * wide * 2 + n_down * wide * 2);
+        std.debug.print("RESULT hcw decode rows {d}: dec=0 {d:.1} us ({d:.0} GB/s), dec=1 {d:.1} us ({d:.0} GB/s), dec=2 {d:.1} us ({d:.0} GB/s), dec=2 on 40 CTAs {d:.1} us: dec=1 saves {d:.2}, dec=2 {d:.2} ms a round of 96 sites\n", .{ m, old, gbs(bytes, old), new, gbs(bytes, new), p48, gbs(bytes, p48), p40, (old - new) * 96 / 1e3, (old - p48) * 96 / 1e3 });
+    }
+}
+
+const OutCase = struct { prefix: []const u8, n: usize, k: usize, cut: bool };
+const out_cases = [_]OutCase{
+    .{ .prefix = "language_model.model.layers.0.linear_attn.out_proj", .n = dims, .k = 6144, .cut = true },
+    .{ .prefix = "language_model.model.layers.3.self_attn.o_proj", .n = dims, .k = 6144, .cut = true },
+    .{ .prefix = "language_model.model.layers.0.mlp.shared_expert.down_proj", .n = dims, .k = 640, .cut = false },
+};
+
+pub fn runOutTile(gpu: check.Gpu, dir: []const u8) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x0b1c);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var lane = try qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+    defer lane.unload();
+    var store = try Store.open(gpu.gpa, gpu.io, dir);
+    defer store.deinit();
+    try store.detectNorms();
+    const saved = .{ qmmf.lane_tile, qmmf.lane_tile_wide, qmmf.dtile, qmmf.out_tile, qmmf.decode_gemm };
+    defer {
+        qmmf.lane_tile = saved[0];
+        qmmf.lane_tile_wide = saved[1];
+        qmmf.dtile = saved[2];
+        qmmf.out_tile = saved[3];
+        qmmf.decode_gemm = saved[4];
+    }
+    qmmf.lane_tile = true;
+    qmmf.lane_tile_wide = false;
+    qmmf.dtile = .off;
+    qmmf.out_tile = 0;
+    qmmf.decode_gemm = false;
+    var tm: Timer = .{ .start = try cuda.Event.init(gpu.d, true), .end = try cuda.Event.init(gpu.d, true), .s = r.s };
+    defer tm.start.deinit();
+    defer tm.end.deinit();
+    const xs = r.bfs(most * 6144, 1);
+    xs[0..3].* = .{ 0x7fc0, 0x7f80, 0xff80 };
+    const x = try r.dev(std.mem.sliceAsBytes(xs));
+    const y0 = try r.out(most * dims * 4);
+    const y1 = try r.out(most * dims * 4);
+    for (out_cases) |oc| {
+        var q = if (oc.cut)
+            try cuts.loadCut(gpu.gpa, gpu.d, &store, oc.prefix, oc.n, oc.k, try flash.modelopt_experts.Cut.init(oc.k, 2, 0), .cols)
+        else
+            try cuts.load(gpu.gpa, @constCast(gpu.d), &store, oc.prefix, oc.n, oc.k);
+        defer q.free();
+        const wt = q.native orelse return error.UnexpectedTensor;
+        if (wt.mode != .mxfp8) {
+            std.debug.print("RESULT out-tile {s}: {s} weights, not MXFP8: the out tile does not take them\n", .{ oc.prefix, @tagName(wt.mode) });
+            continue;
+        }
+        const k = wt.k;
+        for ([_]usize{ 256, 300, 1000, 1536, 2053, 3072 }) |m| {
+            const p = qmmf.planFor(m, wt, lane.clusters);
+            if (p.bm != 64 or p.cluster or p.reduce) return error.OutTileWouldNotTake;
+            for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+                const len = m * oc.n * @as(usize, if (out == .f32) 4 else 2);
+                try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = y0, .len = len }).fill8(0xff, r.s.handle);
+                try lane.laneTile(r.s, x, k, m, wt, y0, out, p.sk, false);
+                const want = try r.back(u8, y0, len);
+                for ([_]u8{ 1, 2 }) |v| {
+                    try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = y1, .len = len }).fill8(0xff, r.s.handle);
+                    try lane.outTileBlock(r.s, x, k, m, wt, y1, out, p.sk, v);
+                    try check.sameBytes("out tile", try r.back(u8, y1, len), want);
+                    qmmf.out_tile = v;
+                    try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = y1, .len = len }).fill8(0xff, r.s.handle);
+                    try lane.matmulOut(r.s, x, k, m, wt, y1, out, 0);
+                    qmmf.out_tile = 0;
+                    try check.sameBytes("out tile through matmulOut", try r.back(u8, y1, len), want);
+                }
+                try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = y1, .len = len }).fill8(0xff, r.s.handle);
+                try lane.dtileBlock(r.s, x, k, m, wt, y1, out, p.sk);
+                try check.sameBytes("dtile b64", try r.back(u8, y1, len), want);
+            }
+        }
+        check.pass("out-tile: {s} [{d} x {d}]: OUT_TILE=1 and 2 (direct and through matmulOut) = lane_mx64 = dtile_b64, bf16 and fp32, NaN and inf inputs, 6 row counts", .{ oc.prefix, oc.n, k });
+        for ([_]usize{ 3072, 1536, 768 }) |m| {
+            const p = qmmf.planFor(m, wt, lane.clusters);
+            const flop = 2.0 * @as(f64, @floatFromInt(m * oc.n * k));
+            for ([_]qmmf.Out{ .bf16, .f32 }) |out| {
+                const lt = try tm.us(lane, qmmf.Lane.laneTile, .{ r.s, x, k, m, wt, y0, out, p.sk, false });
+                const lw = try tm.us(lane, qmmf.Lane.laneTile, .{ r.s, x, k, m, wt, y0, out, p.sk, true });
+                const db = try tm.us(lane, qmmf.Lane.dtileBlock, .{ r.s, x, k, m, wt, y0, out, p.sk });
+                const o1 = try tm.us(lane, qmmf.Lane.outTileBlock, .{ r.s, x, k, m, wt, y0, out, p.sk, @as(u8, 1) });
+                const o2 = try tm.us(lane, qmmf.Lane.outTileBlock, .{ r.s, x, k, m, wt, y0, out, p.sk, @as(u8, 2) });
+                std.debug.print("RESULT out-tile {s} rows {d} {s}: lane_mx64 {d:.3} ms ({d:.1} TF), lane_mx128 {d:.3} ms ({d:.1} TF), dtile_b64 {d:.3} ms ({d:.1} TF), OUT_TILE=1 {d:.3} ms ({d:.1} TF), OUT_TILE=2 {d:.3} ms ({d:.1} TF)\n", .{ oc.prefix, m, @tagName(out), lt / 1e3, flop / lt / 1e6, lw / 1e3, flop / lw / 1e6, db / 1e3, flop / db / 1e6, o1 / 1e3, flop / o1 / 1e6, o2 / 1e3, flop / o2 / 1e6 });
+            }
+        }
+    }
+    r.report("out-tile");
+}
diff --git a/zig/tests/cuda/flashnext_lend_ride_tests.zig b/zig/tests/cuda/flashnext_lend_ride_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..dd4cde6da96b28f1a419aed6df23da090f11775a
--- /dev/null
+++ b/zig/tests/cuda/flashnext_lend_ride_tests.zig
@@ -0,0 +1,228 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const table_tests = @import("flashnext_mixed_table_tests.zig");
+const prompt = flash.prompt;
+const plan = flash.mixed_plan;
+const env = @import("sys").env;
+const Windows = table_tests.Windows;
+
+const knob = "TF_FLASHNEXT_TP_LEND";
+const ride_knob = "TF_FLASHNEXT_TP_LEND_RIDE";
+const fast_knob = "TF_FLASHNEXT_MIXED_RIDE_FAST";
+const window_context = 4096;
+const max_windows = 28;
+const levels = [_]usize{ 4, 28 };
+const reps = 3;
+const next_rows = 64;
+const piece_room = 8 * 1024;
+const cases = levels.len * 2;
+
+const Rig = struct {
+    gpu: check.Gpu,
+    session: *flash.rank_engine.Session,
+    tri: flash.Tri,
+    e: *prompt.Engine,
+    stream: *cuda.Stream,
+    seed: []const u32,
+    ids: []const u32,
+    out: u64,
+    streams: cuda.DeviceBuffer,
+};
+
+const Got = struct {
+    rows: []u8,
+    streams: []u8,
+    next: []u8,
+
+    fn alloc(gpa: std.mem.Allocator, rows: usize, streams: usize, next: usize) !Got {
+        const a = try gpa.alloc(u8, rows);
+        errdefer gpa.free(a);
+        const b = try gpa.alloc(u8, streams);
+        errdefer gpa.free(b);
+        return .{ .rows = a, .streams = b, .next = try gpa.alloc(u8, next) };
+    }
+
+    fn free(g: Got, gpa: std.mem.Allocator) void {
+        gpa.free(g.rows);
+        gpa.free(g.streams);
+        gpa.free(g.next);
+    }
+};
+
+fn restore(name: [:0]const u8, given: ?[*:0]const u8) void {
+    if (given) |v| _ = env.setenv(name, v, 1) else _ = env.unsetenv(name);
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const knobs = flash.knobs;
+    const given = std.c.getenv(knob);
+    const given_ride = std.c.getenv(ride_knob);
+    const given_fast = std.c.getenv(fast_knob);
+    defer {
+        restore(knob, given);
+        restore(ride_knob, given_ride);
+        restore(fast_knob, given_fast);
+    }
+    var b_buf: [8]u8 = undefined;
+    const b_text: [:0]const u8 = if (given) |v| try std.fmt.bufPrintSentinel(&b_buf, "{s}", .{std.mem.span(v)}, 0) else "32";
+    _ = env.setenv(knob, b_text, 1);
+    _ = env.setenv(ride_knob, "1", 1);
+    _ = env.setenv(fast_knob, "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_MIXED_ROUNDS", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_TP_MOE_PARTIAL", "1", 1);
+    _ = env.setenv("TF_FLASHNEXT_MIXED_LAST", "1", 1);
+    const b = try knobs.tpLend();
+    if (b == 0) {
+        std.debug.print("FAIL flashnext-lend-ride needs TF_FLASHNEXT_TP_LEND unset (32) or one of 8, 16, 32, 64, 128\n", .{});
+        return error.TestFailed;
+    }
+    if (!try knobs.mixedSeqPar() or !try knobs.tpSplitSum() or !try knobs.tpSeqPar()) {
+        std.debug.print("FAIL flashnext-lend-ride needs TF_FLASHNEXT_MIXED_SEQPAR=1, TF_FLASHNEXT_TP_SEQPAR=1 and TF_FLASHNEXT_TP_SPLIT_SUM=1 on both ranks (the MRX flags)\n", .{});
+        return error.TestFailed;
+    }
+    const hot = try knobs.tpLendSet() != null;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    const context = window_context + piece_room + chunk;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const t_load = check.now(gpu.io);
+    const e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank);
+    defer e.deinit();
+    std.debug.print("RESULT flashnext-lend-ride rank {d} engine load with {d} lent experts a layer ({s} set): {d:.1} s\n", .{ rank, b, if (hot) "hot" else "even", @as(f64, @floatFromInt(check.now(gpu.io) - t_load)) / 1e9 });
+    if (e.chunk != chunk) return error.EngineChunk;
+    const bs = try e.reserve(chunk);
+    try check.expect(bs.lend != null, "the scratch holds no lend buffers", .{});
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, max_windows * 3 * prompt.vocabulary * 2);
+    defer logits.free();
+    const round_cap = @min(knobs.roundRowsCap(), chunk);
+    const max_np = plan.pieceRows(chunk, chunk, round_cap);
+    if (max_np < 1536) return error.RankIdentity;
+    const ids = try gpu.gpa.alloc(u32, context);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*v, i| v.* = seed.items[(i * 13 + 5) % seed.items.len];
+    var streams = try cuda.DeviceBuffer.alloc(e.driver, max_np * prompt.hidden_wide * 2);
+    defer streams.free();
+    var want: [cases]?Got = @splat(null);
+    defer for (want) |w| if (w) |g| g.free(gpu.gpa);
+    var ms: [2][cases]f64 = @splat(@splat(0));
+    var compared: usize = 0;
+    const probe = &flash.lend.probe;
+    probe.min_rows = 512;
+    defer {
+        probe.on = false;
+        probe.min_rows = 0;
+    }
+    for (0..2) |ai| {
+        const on = ai == 1;
+        const name = if (on) "lend" else "off";
+        _ = env.setenv(knob, if (on) b_text else "0", 1);
+        probe.reset();
+        var identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        identity.mtp = 1;
+        const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port + @as(u16, @intCast(ai)), rank, identity, flash.rank_engine.linkWait());
+        defer {
+            e.collective = null;
+            session.deinit();
+        }
+        session.engine = e;
+        e.collective = &session.collective;
+        if (knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+        probe.on = true;
+        defer probe.on = false;
+        if (rank == 1) {
+            try session.follow(flash.Tri, tri, logits.ptr);
+            try probe.collect();
+            report(rank, name);
+            check.pass("rank 1 followed the {s} arm", .{name});
+            continue;
+        }
+        const rig: Rig = .{ .gpu = gpu, .session = session, .tri = tri, .e = e, .stream = &stream, .seed = seed.items, .ids = ids, .out = logits.ptr, .streams = streams };
+        var ci: usize = 0;
+        for (levels) |d| {
+            const wr = @max(1, @min(3, round_cap / d));
+            for ([_]usize{ 1536, max_np }) |np| {
+                if (!plan.fits(np, d * wr, chunk)) return error.RankIdentity;
+                var t: [reps]f64 = undefined;
+                for (&t, 0..) |*tm, r| {
+                    const g = try round(rig, np, d, wr, tm);
+                    if (r == 0 and !on) {
+                        want[ci] = g;
+                        continue;
+                    }
+                    defer g.free(gpu.gpa);
+                    if (r != 0) continue;
+                    const w = want[ci].?;
+                    try check.sameBytes("each window row's scores in a lent riding round equal the round without lending", g.rows, w.rows);
+                    try check.sameBytes("the riding piece's hidden streams with lending equal the ones without", g.streams, w.streams);
+                    try check.sameBytes("the windows' next verify and the piece's next pass after a lent round equal the ones without", g.next, w.next);
+                    compared += 1;
+                    check.pass("lend arm: {d} prompt rows riding beside {d} windows of {d} rows: window scores, piece streams and next rows equal the off arm's byte for byte", .{ np, d, wr });
+                }
+                ms[ai][ci] = check.median(&t);
+                ci += 1;
+            }
+        }
+        try probe.collect();
+        report(rank, name);
+    }
+    if (rank == 1) return;
+    try check.expect(compared == cases, "{d} of {d} riding rounds compared", .{ compared, cases });
+    std.debug.print("RESULT flashnext-lend-ride {d} riding rounds compared byte for byte (B {d}, {s} set)\n", .{ compared, b, if (hot) "hot" else "even" });
+    var ci: usize = 0;
+    for (levels) |d| {
+        const wr = @max(1, @min(3, round_cap / d));
+        for ([_]usize{ 1536, max_np }) |np| {
+            std.debug.print("RESULT flashnext-lend-ride-bench {d} windows x {d} rows, {d} piece rows: off {d:.2} ms, on {d:.2} ms, saves {d:.2} ms a round; median of {d}\n", .{ d, wr, np, ms[0][ci], ms[1][ci], ms[0][ci] - ms[1][ci], reps });
+            ci += 1;
+        }
+    }
+}
+
+fn round(r: Rig, np: usize, d: usize, wr: usize, t: *f64) !Got {
+    const row = prompt.vocabulary * 2;
+    const nr = d * wr * row;
+    const g = try Got.alloc(r.gpu.gpa, nr, np * prompt.hidden_wide * 2, nr + row);
+    errdefer g.free(r.gpu.gpa);
+    const dr = r.e.driver;
+    var w: Windows = .{ .rows = wr };
+    try w.init(r.gpu, r.session, r.tri, r.e, r.stream, r.seed, d);
+    defer w.deinit(r.session);
+    var p = try r.session.create(window_context + np + next_rows);
+    defer r.session.drop(&p);
+    try r.stream.synchronize();
+    const t0 = check.now(r.gpu.io);
+    try r.session.mixed(flash.Tri, r.tri, .{ .seq = &p, .ids = r.ids[0..np], .streams = r.streams.ptr }, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+    try r.stream.synchronize();
+    t.* = @as(f64, @floatFromInt(check.now(r.gpu.io) - t0)) / 1e6;
+    try dr.check(dr.api.cuMemcpyDtoH_v2(g.rows.ptr, r.out, nr), "cuMemcpyDtoH");
+    try dr.check(dr.api.cuMemcpyDtoH_v2(g.streams.ptr, r.streams.ptr, g.streams.len), "cuMemcpyDtoH");
+    try w.keepAll(r.session, r.tri);
+    try r.session.verifyMany(flash.Tri, r.tri, w.qs[0..d], w.ds[0..d], w.idss[0..d], r.out);
+    try r.stream.synchronize();
+    try dr.check(dr.api.cuMemcpyDtoH_v2(g.next.ptr, r.out, nr), "cuMemcpyDtoH");
+    try w.keepAll(r.session, r.tri);
+    try r.session.forward(flash.Tri, r.tri, &p, r.ids[np..][0..next_rows], .{ .logits = .last, .prompt = true });
+    try r.stream.synchronize();
+    @memcpy(g.next[nr..], p.logits[0..row]);
+    return g;
+}
+
+fn report(rank: usize, name: []const u8) void {
+    for (flash.lend.probe.buckets) |k| {
+        if (k.calls == 0) continue;
+        const c = @as(f64, @floatFromInt(k.calls));
+        std.debug.print("RESULT flashnext-lend-ride-probe rank {d} {s} arm rows {d}: {d} MoE calls ({d} lent), experts {d:.3} ms a call, exchange wait {d:.3} ms a call; x48: experts {d:.2} ms, wait {d:.2} ms\n", .{ rank, name, k.rows, k.calls, k.lent, k.experts_ms / c, k.wait_ms / c, 48.0 * k.experts_ms / c, 48.0 * k.wait_ms / c });
+    }
+}
diff --git a/zig/tests/cuda/flashnext_lend_tests.zig b/zig/tests/cuda/flashnext_lend_tests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7a9c2fcf022648c9f42b64a0138006918456890a
--- /dev/null
+++ b/zig/tests/cuda/flashnext_lend_tests.zig
@@ -0,0 +1,206 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const env = @import("sys").env;
+
+const knob = "TF_FLASHNEXT_TP_LEND";
+const floor_knob = "TF_FLASHNEXT_TP_LEND_MIN_ROWS";
+const passes = [_]usize{ 1536, 3072 };
+const reps = 5;
+const lanes = 28;
+const lane_prompt = 256;
+const rounds = 8;
+
+const Case = enum { pass, next };
+const cases = std.enums.values(Case);
+
+fn cachedRows(chunk: usize) !usize {
+    const want = if (std.c.getenv("TF_LEND_TEST_CACHED")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else 12288;
+    return chunk * (std.math.divCeil(usize, want, chunk) catch unreachable);
+}
+
+fn setArm(on: bool, b: [:0]const u8) void {
+    _ = env.setenv(knob, if (on) b else "0", 1);
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8) !void {
+    const knobs = flash.knobs;
+    const given = std.c.getenv(knob);
+    const given_floor = std.c.getenv(floor_knob);
+    var b_buf: [8]u8 = undefined;
+    const b_text: [:0]const u8 = if (given) |v| try std.fmt.bufPrintSentinel(&b_buf, "{s}", .{std.mem.span(v)}, 0) else "64";
+    defer {
+        if (given) |v| _ = env.setenv(knob, v, 1) else _ = env.unsetenv(knob);
+        if (given_floor) |v| _ = env.setenv(floor_knob, v, 1) else _ = env.unsetenv(floor_knob);
+    }
+    _ = env.setenv(knob, b_text, 1);
+    _ = env.setenv(floor_knob, "1", 1);
+    const b = try knobs.tpLend();
+    if (b == 0) {
+        std.debug.print("FAIL flashnext-lend needs TF_FLASHNEXT_TP_LEND unset (64) or one of 8, 16, 32, 64, 128\n", .{});
+        return error.TestFailed;
+    }
+    if (!try knobs.tpSplitSum() or !try knobs.tpSeqPar()) {
+        std.debug.print("FAIL flashnext-lend needs TF_FLASHNEXT_TP_SEQPAR=1 and TF_FLASHNEXT_TP_SPLIT_SUM=1 on both ranks\n", .{});
+        return error.TestFailed;
+    }
+    const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+    if (chunk < passes[passes.len - 1]) {
+        std.debug.print("FAIL flashnext-lend needs a solo chunk of 3072 rows (TF_FLASHNEXT_CHUNK_SOLO=3072)\n", .{});
+        return error.TestFailed;
+    }
+    const cached = try cachedRows(chunk);
+    const context = cached + chunk + 64;
+    if (context > prompt.max_tokens) return error.BadPrompt;
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    defer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len == 0) return error.BadPrompt;
+    const ids = try gpu.gpa.alloc(u32, cached + chunk + 1);
+    defer gpu.gpa.free(ids);
+    for (ids, 0..) |*a, i| a.* = seed.items[i % seed.items.len];
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const t_load = check.now(gpu.io);
+    const e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir, 2, rank);
+    defer e.deinit();
+    std.debug.print("RESULT flashnext-lend rank {d} engine load with {d} lent experts a layer: {d:.1} s\n", .{ rank, b, @as(f64, @floatFromInt(check.now(gpu.io) - t_load)) / 1e9 });
+    if (e.chunk != chunk) return error.EngineChunk;
+    const bs = try e.reserve(chunk);
+    try check.expect(bs.lend != null, "the scratch holds no lend buffers", .{});
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, 32 * prompt.vocabulary * 2);
+    defer logits.free();
+    const row = prompt.vocabulary * 2;
+    var want: [passes.len][cases.len][]u8 = undefined;
+    for (&want) |*w| for (w) |*r| {
+        r.* = try gpu.gpa.alloc(u8, row);
+    };
+    defer for (want) |w| for (w) |r| gpu.gpa.free(r);
+    const lane0 = try gpu.gpa.alloc(u8, rounds * row);
+    defer gpu.gpa.free(lane0);
+    var lane_hash: [rounds][lanes]u64 = undefined;
+    var ms: [2][passes.len]f64 = @splat(@splat(0));
+    var round_ms: [2]f64 = @splat(0);
+    var compared: usize = 0;
+    const probe = &flash.lend.probe;
+    probe.on = true;
+    defer probe.on = false;
+    for (0..2) |ai| {
+        const on = ai == 1;
+        const name = if (on) "lend" else "off";
+        setArm(on, b_text);
+        probe.reset();
+        const identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        const session = try flash.rank_engine.Session.init(gpu.gpa, gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port + @as(u16, @intCast(ai)), rank, identity, flash.rank_engine.linkWait());
+        defer {
+            e.collective = null;
+            session.deinit();
+        }
+        session.engine = e;
+        e.collective = &session.collective;
+        if (knobs.tpRoce()) try session.collective.openRoce(gpu.gpa, gpu.io, gpu.d, true, try knobs.tpRoceMaxBytes());
+        if (rank == 1) {
+            try session.follow(flash.Tri, tri, logits.ptr);
+            try probe.collect();
+            report(rank, name);
+            check.pass("rank 1 followed the {s} arm", .{name});
+            continue;
+        }
+        var q = try session.create(context);
+        defer session.drop(&q);
+        var at: usize = 0;
+        while (at < cached) : (at += chunk) try session.forward(flash.Tri, tri, &q, ids[at .. at + chunk], .{ .logits = .none, .prompt = true });
+        const kept = try session.save(&q, null);
+        defer session.dropSaved(kept);
+        for (passes, 0..) |n, pi| {
+            var t: [reps]f64 = undefined;
+            for (0..reps + 1) |r| {
+                try session.restore(&q, null, kept);
+                const t0 = check.now(gpu.io);
+                try session.forward(flash.Tri, tri, &q, ids[cached .. cached + n], .{ .logits = .last, .prompt = true });
+                if (r > 0) t[r - 1] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+                if (r != 1) continue;
+                try compare(ai, name, n, .pass, q.logits, &want[pi], &compared);
+                try session.forward(flash.Tri, tri, &q, ids[cached + n ..][0..1], .{});
+                try compare(ai, name, n, .next, q.logits, &want[pi], &compared);
+            }
+            ms[ai][pi] = check.median(&t);
+        }
+        var seqs: [lanes]prompt.Seq = undefined;
+        var made: usize = 0;
+        defer for (seqs[0..made]) |*x| session.drop(x);
+        var ptrs: [lanes]*prompt.Seq = undefined;
+        for (&seqs, 0..) |*x, i| {
+            x.* = try session.create(lane_prompt + rounds + 16);
+            made += 1;
+            ptrs[i] = x;
+            const from = (i * 997) % (ids.len - lane_prompt);
+            try session.forward(flash.Tri, tri, x, ids[from .. from + lane_prompt], .{ .prompt = true });
+        }
+        var tr: [rounds]f64 = undefined;
+        for (0..rounds) |r| {
+            var tokens: [lanes]u32 = undefined;
+            for (&tokens, 0..) |*tk, i| tk.* = seed.items[(i * 7 + r) % seed.items.len];
+            const t0 = check.now(gpu.io);
+            try session.round(flash.Tri, tri, &ptrs, &tokens, logits.ptr);
+            tr[r] = @as(f64, @floatFromInt(check.now(gpu.io) - t0)) / 1e6;
+            for (ptrs, 0..) |x, i| {
+                const h = std.hash.Wyhash.hash(0, x.logits);
+                if (i == 0) {
+                    const slot = lane0[r * row ..][0..row];
+                    if (ai == 0) @memcpy(slot, x.logits) else try check.sameBytes("decode round lane 0", x.logits, slot);
+                }
+                if (ai == 0) {
+                    lane_hash[r][i] = h;
+                } else {
+                    try check.expect(h == lane_hash[r][i], "decode round {d} lane {d}: the lend arm's row differs from the off arm's", .{ r, i });
+                    compared += 1;
+                }
+            }
+        }
+        round_ms[ai] = check.median(&tr);
+        if (ai == 1) check.pass("lend arm, {d}-lane decode rounds: {d} rounds of every lane's row equal the off arm's", .{ lanes, rounds });
+        try probe.collect();
+        report(rank, name);
+    }
+    if (try knobs.tpLendCount()) |path| {
+        try flash.lend.capture.flush(stream, gpu.io, gpu.gpa, path);
+        std.debug.print("RESULT flashnext-lend rank {d} routing counts of {d} passes written to {s}\n", .{ rank, flash.lend.capture.passes, path });
+    }
+    if (rank == 1) return;
+    try check.expect(compared > 0, "no flag-on row was compared", .{});
+    std.debug.print("RESULT flashnext-lend {d} rows compared byte for byte (B {d})\n", .{ compared, b });
+    std.debug.print("RESULT flashnext-lend-set {s}\n", .{if (try knobs.tpLendSet()) |p| p else "even"});
+    for (passes, 0..) |n, pi| {
+        const f = @as(f64, @floatFromInt(n));
+        std.debug.print("RESULT flashnext-lend-bench cached {d} rows {d}: off {d:.2} ms, on {d:.2} ms, saves {d:.2} ms ({d:.1}%); per 3072-row chunk off {d:.2} on {d:.2} ms; per 1536-row pass off {d:.2} on {d:.2} ms; median of {d}\n", .{ cached, n, ms[0][pi], ms[1][pi], ms[0][pi] - ms[1][pi], 100.0 * (ms[0][pi] - ms[1][pi]) / ms[0][pi], 3072.0 / f * ms[0][pi], 3072.0 / f * ms[1][pi], 1536.0 / f * ms[0][pi], 1536.0 / f * ms[1][pi], reps });
+    }
+    std.debug.print("RESULT flashnext-lend-bench {d}-lane round: off {d:.2} ms, on {d:.2} ms, saves {d:.2} ms; median of {d}\n", .{ lanes, round_ms[0], round_ms[1], round_ms[0] - round_ms[1], rounds });
+}
+
+fn report(rank: usize, name: []const u8) void {
+    for (flash.lend.probe.buckets) |k| {
+        if (k.calls == 0) continue;
+        const c = @as(f64, @floatFromInt(k.calls));
+        std.debug.print("RESULT flashnext-lend-probe rank {d} {s} arm rows {d}: {d} MoE calls ({d} lent), experts {d:.3} ms a call, exchange wait {d:.3} ms a call; x48: experts {d:.2} ms, wait {d:.2} ms\n", .{ rank, name, k.rows, k.calls, k.lent, k.experts_ms / c, k.wait_ms / c, 48.0 * k.experts_ms / c, 48.0 * k.wait_ms / c });
+    }
+}
+
+fn compare(ai: usize, name: []const u8, n: usize, c: Case, got: []const u8, want: *[cases.len][]u8, compared: *usize) !void {
+    const slot = want[@backingInt(c)];
+    if (ai == 0) {
+        @memcpy(slot, got);
+        return;
+    }
+    try check.sameBytes(@tagName(c), got, slot);
+    compared.* += 1;
+    check.pass("{s} arm, {d} rows: {s} row equals the off arm's byte for byte", .{ name, n, @tagName(c) });
+}
