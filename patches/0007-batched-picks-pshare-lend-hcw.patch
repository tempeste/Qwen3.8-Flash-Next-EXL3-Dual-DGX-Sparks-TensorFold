diff --git a/zig/src/core/prompt_cache_explain.zig b/zig/src/core/prompt_cache_explain.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c254fe66dc20b9b79c63251a25503861c91c13f9
--- /dev/null
+++ b/zig/src/core/prompt_cache_explain.zig
@@ -0,0 +1,168 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const keeping = @import("prompt_cache_keeping.zig");
+const modes = @import("cache_modes.zig");
+
+pub const shallow_gap: u32 = 4096;
+pub const ghost_bytes_max: u64 = 16 << 20;
+pub const ghosts_max: usize = 4096;
+
+pub const Why = enum { evicted, parted, spans, fresh };
+
+pub const Ghost = struct {
+    chain: []u64,
+    tail: u64,
+    len: u32,
+    at: u32,
+    last: u32,
+    bytes: u64,
+    class: pc.Class,
+    idle_s: u64,
+    gone_ns: i128,
+    gone_clock: u64,
+};
+
+pub const Counts = struct {
+    shallow: u64 = 0,
+    evicted: u64 = 0,
+    evicted_tokens: u64 = 0,
+    parted: u64 = 0,
+    parted_tokens: u64 = 0,
+    spans: u64 = 0,
+    fresh: u64 = 0,
+};
+
+pub const Explain = struct {
+    ghosts: std.ArrayList(Ghost) = .empty,
+    held: u64 = 0,
+    counts: Counts = .{},
+    last_why: ?Why = null,
+
+    pub fn deinit(x: *Explain, gpa: std.mem.Allocator) void {
+        for (x.ghosts.items) |g| gpa.free(g.chain);
+        x.ghosts.deinit(gpa);
+        x.held = 0;
+    }
+
+    fn dropOldest(x: *Explain, gpa: std.mem.Allocator) void {
+        const g = x.ghosts.orderedRemove(0);
+        x.held -= g.chain.len * @sizeOf(u64);
+        gpa.free(g.chain);
+    }
+
+    pub fn record(x: *Explain, s: *const pc.Store, e: *const pc.Entry, class: pc.Class) void {
+        const gpa = s.gpa;
+        const full = if (e.last.len >= e.tokens.len) e.last else e.tokens;
+        const c = keeping.chain(gpa, full) catch return;
+        const now = pc.rows.write.nowNs();
+        const g: Ghost = .{
+            .chain = c,
+            .tail = keeping.tailHash(e.tokens),
+            .len = @intCast(e.tokens.len),
+            .at = e.at,
+            .last = @intCast(full.len),
+            .bytes = e.bytes,
+            .class = class,
+            .idle_s = if (e.touched_ns > 0) @intCast(@divTrunc(@max(0, now - e.touched_ns), std.time.ns_per_s)) else 0,
+            .gone_ns = now,
+            .gone_clock = s.clock,
+        };
+        while (x.ghosts.items.len > 0 and (x.ghosts.items.len >= ghosts_max or x.held + c.len * @sizeOf(u64) > ghost_bytes_max)) x.dropOldest(gpa);
+        x.ghosts.append(gpa, g) catch {
+            gpa.free(c);
+            return;
+        };
+        x.held += c.len * @sizeOf(u64);
+    }
+};
+
+fn serves(g: Ghost, prompt: []const u32, prompt_chain: []const u64) bool {
+    if (g.len > prompt.len or g.at >= prompt.len) return false;
+    const k = g.len / keeping.block;
+    if (k > 0 and (prompt_chain.len < k or g.chain.len < k or prompt_chain[k - 1] != g.chain[k - 1])) return false;
+    return keeping.tailHash(prompt[0..g.len]) == g.tail;
+}
+
+pub const Look = struct {
+    why: Why,
+    from: u32,
+    history: u32,
+    kept_at: u32 = 0,
+    kept_last: u32 = 0,
+    kept_part: u32 = 0,
+    kept_age: u64 = 0,
+    ghost: ?Ghost = null,
+    ghost_serves: bool = false,
+    ghost_part: u32 = 0,
+};
+
+pub fn look(s: *pc.Store, prompt: []const u32, from: ?*const pc.Entry, history_len: u32, spans: []const modes.Span) ?Look {
+    const x = &s.explained;
+    x.last_why = null;
+    const at: u32 = if (from) |e| e.at else 0;
+    const history: u32 = if (history_len > 0 and history_len <= prompt.len) history_len else @intCast(prompt.len);
+    if (history <= at + shallow_gap) return null;
+    var out: Look = .{ .why = .fresh, .from = at, .history = history };
+    var spans_differ = false;
+    for (s.entries.items) |e| {
+        if (e.expired) continue;
+        const part: u32 = @intCast(std.mem.indexOfDiff(u32, e.last, prompt) orelse @min(e.last.len, prompt.len));
+        if (part > out.kept_part) {
+            out.kept_part = part;
+            out.kept_at = e.at;
+            out.kept_last = @intCast(e.last.len);
+            out.kept_age = s.clock -| e.used;
+        }
+        if (e.at > at and e.tokens.len <= prompt.len and e.at < prompt.len and std.mem.eql(u32, prompt[0..e.tokens.len], e.tokens) and !modes.equal(e.decode_spans, spans, e.at)) spans_differ = true;
+    }
+    const prompt_chain: []const u64 = keeping.chain(s.gpa, prompt) catch &.{};
+    defer s.gpa.free(prompt_chain);
+    for (x.ghosts.items) |g| {
+        const ok = g.at > at and serves(g, prompt, prompt_chain);
+        const part: u32 = @intCast(keeping.sharedBlocks(prompt_chain, g.chain) * keeping.block);
+        const better = if (ok != out.ghost_serves) ok else if (ok) g.at > out.ghost.?.at else part > out.ghost_part;
+        if (out.ghost == null or better) {
+            out.ghost = g;
+            out.ghost_serves = ok;
+            out.ghost_part = if (ok) g.at else part;
+        }
+    }
+    if (out.ghost != null and !out.ghost_serves and out.ghost_part <= at) out.ghost = null;
+    const deepest = @max(out.kept_part, if (out.ghost != null) out.ghost_part else 0);
+    if (from != null and !out.ghost_serves and !spans_differ and deepest <= at + shallow_gap) return null;
+    if (out.ghost_serves) {
+        out.why = .evicted;
+        x.counts.evicted += 1;
+        x.counts.evicted_tokens += out.ghost.?.at - at;
+    } else if (spans_differ) {
+        out.why = .spans;
+        x.counts.spans += 1;
+    } else if (deepest > at + shallow_gap) {
+        out.why = .parted;
+        x.counts.parted += 1;
+        x.counts.parted_tokens += deepest - at;
+    } else {
+        x.counts.fresh += 1;
+    }
+    x.counts.shallow += 1;
+    x.last_why = out.why;
+    return out;
+}
+
+pub fn line(s: *const pc.Store, prompt_len: usize, l: Look) void {
+    if (@import("builtin").is_test) return;
+    var kept_buf: [160]u8 = undefined;
+    var ghost_buf: [200]u8 = undefined;
+    const kept = if (l.kept_part > 0) std.fmt.bufPrint(&kept_buf, "kept {d}-token state (prompt {d}, {d} keeps ago) parts at {d}", .{ l.kept_at, l.kept_last, l.kept_age, l.kept_part }) catch "kept ?" else "no kept state shares it";
+    const ghost = if (l.ghost) |g| std.fmt.bufPrint(&ghost_buf, "{s} evicted {d}-token state (prompt {d}, {d} MiB, idle {d} s, gone {d} s and {d} keeps ago) {s} {d}", .{
+        @tagName(g.class), g.at, g.last, g.bytes >> 20, g.idle_s, @divTrunc(@max(0, pc.rows.write.nowNs() - g.gone_ns), std.time.ns_per_s), s.clock -| g.gone_clock, if (l.ghost_serves) "would serve to" else "parts at about", l.ghost_part,
+    }) catch "ghost ?" else "no evicted state shares it";
+    std.log.info("prompt cache explain: {d} tokens, history {d}, resumed at {d}: {s}; {s}; {s}", .{ prompt_len, l.history, l.from, @tagName(l.why), kept, ghost });
+}
+
+pub fn report(s: *const pc.Store) void {
+    if (@import("builtin").is_test) return;
+    const c = s.explained.counts;
+    const copies = keeping.siblingCopies(s);
+    std.log.info("prompt cache explain: shallow {d} (evicted {d} for {d} tokens, parted {d} for {d} tokens, spans {d}, fresh {d}); {d} ghosts ({d} KiB); {d} same-request shorter copies ({d} MiB); evicted {d} superseded, {d} shadowed, {d} idle, {d} live", .{ c.shallow, c.evicted, c.evicted_tokens, c.parted, c.parted_tokens, c.spans, c.fresh, s.explained.ghosts.items.len, s.explained.held >> 10, copies.n, copies.bytes >> 20, s.counts.evicted_superseded, s.counts.evicted_shadowed, s.counts.evicted_idle, s.counts.evicted_live });
+}
diff --git a/zig/src/core/prompt_cache_keeping.zig b/zig/src/core/prompt_cache_keeping.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a685277ef03428aa42a952ff603d702413b4cf13
--- /dev/null
+++ b/zig/src/core/prompt_cache_keeping.zig
@@ -0,0 +1,129 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+
+pub const Keeping = struct {
+    explain: bool = false,
+    one_copy: bool = false,
+    value: bool = false,
+
+    pub fn any(k: Keeping) bool {
+        return k.explain or k.one_copy or k.value;
+    }
+};
+
+pub const block: usize = 256;
+
+pub fn chain(gpa: std.mem.Allocator, tokens: []const u32) ![]u64 {
+    const out = try gpa.alloc(u64, tokens.len / block);
+    var h: u64 = 0;
+    for (out, 0..) |*c, i| {
+        h = std.hash.Wyhash.hash(h, std.mem.sliceAsBytes(tokens[i * block ..][0..block]));
+        c.* = h;
+    }
+    return out;
+}
+
+pub fn tailHash(tokens: []const u32) u64 {
+    const k = tokens.len / block * block;
+    return std.hash.Wyhash.hash(tokens.len, std.mem.sliceAsBytes(tokens[k..]));
+}
+
+pub fn sharedBlocks(a: []const u64, b: []const u64) usize {
+    const n = @min(a.len, b.len);
+    var i: usize = 0;
+    while (i < n and a[i] == b[i]) i += 1;
+    return i;
+}
+
+pub fn prefixOf(short: *const pc.Entry, long: *const pc.Entry) bool {
+    if (short.tokens.len > long.tokens.len) return false;
+    const k = short.tokens.len / block;
+    if (k > 0 and short.chain.len >= k and long.chain.len >= k) {
+        if (short.chain[k - 1] != long.chain[k - 1]) return false;
+        return std.mem.eql(u32, long.tokens[k * block .. short.tokens.len], short.tokens[k * block ..]);
+    }
+    return std.mem.eql(u32, long.tokens[0..short.tokens.len], short.tokens);
+}
+
+pub fn warmEnd(e: *const pc.Entry) bool {
+    return e.at >= e.born;
+}
+
+fn sibling(s: *const pc.Store, e: *const pc.Entry, longer: bool) ?*const pc.Entry {
+    for (s.entries.items) |o| {
+        if (o == e or o.expired or o.born != e.born) continue;
+        if (longer and o.tokens.len > e.tokens.len and prefixOf(e, o)) return o;
+        if (!longer and o.tokens.len < e.tokens.len and prefixOf(o, e)) return o;
+    }
+    return null;
+}
+
+pub fn warmServes(s: *const pc.Store) bool {
+    return s.counts.warm_hits >= s.counts.warm_misses;
+}
+
+pub fn shadowed(s: *const pc.Store, e: *const pc.Entry) bool {
+    if (sibling(s, e, true)) |o| if (!warmEnd(o) or warmServes(s)) return true;
+    if (warmEnd(e) and !warmServes(s)) if (sibling(s, e, false) != null) return true;
+    return false;
+}
+
+pub fn noteResume(s: *pc.Store, e: *pc.Entry, prompt: []const u32) void {
+    e.hits +|= 1;
+    e.base = s.inflation;
+    if (!s.keeping.one_copy) return;
+    if (warmEnd(e)) {
+        s.counts.warm_hits += 1;
+        return;
+    }
+    for (s.entries.items) |o| {
+        if (o == e or o.expired or o.born != e.born or !warmEnd(o) or o.tokens.len <= e.tokens.len) continue;
+        const on = o.tokens.len <= prompt.len and std.mem.eql(u32, prompt[0..o.tokens.len], o.tokens);
+        if (!on and prefixOf(e, o)) {
+            s.counts.warm_misses += 1;
+            return;
+        }
+    }
+}
+
+pub fn under(s: *const pc.Store, e: *const pc.Entry) u32 {
+    var best: u32 = 0;
+    for (s.entries.items) |o| {
+        if (o == e or o.expired or o.at <= best or o.tokens.len >= e.tokens.len or !(o.shared or o.branched)) continue;
+        if (prefixOf(o, e)) best = o.at;
+    }
+    return best;
+}
+
+pub fn worth(s: *const pc.Store, e: *const pc.Entry) f64 {
+    if (!e.shared and !e.branched and shadowed(s, e)) return e.base;
+    const saves: f64 = @floatFromInt(e.at -| under(s, e));
+    const mib: f64 = @max(1.0, @as(f64, @floatFromInt(e.bytes)) / (1 << 20));
+    return e.base + (1.0 + @as(f64, @floatFromInt(e.hits))) * saves / mib;
+}
+
+pub fn kept(s: *pc.Store, e: *pc.Entry) void {
+    e.base = s.inflation;
+    if (!s.keeping.value or e.chain.len > 0 or e.tokens.len < block) return;
+    e.chain = chain(s.gpa, e.tokens) catch &.{};
+}
+
+pub fn touched(s: *pc.Store, e: *pc.Entry) void {
+    e.base = s.inflation;
+}
+
+pub fn superseded(s: *const pc.Store, e: *const pc.Entry) bool {
+    for (s.entries.items) |o| if (o != e and !o.expired and o.born > e.born and o.tokens.len > e.tokens.len and prefixOf(e, o)) return true;
+    return false;
+}
+
+pub const Copies = struct { n: usize = 0, bytes: u64 = 0 };
+
+pub fn siblingCopies(s: *const pc.Store) Copies {
+    var c: Copies = .{};
+    for (s.entries.items) |e| if (!e.expired and sibling(s, e, true) != null) {
+        c.n += 1;
+        c.bytes += e.bytes;
+    };
+    return c;
+}
