+    }
+
+    fn rinvOf(w: *Hcw) !void {
+        try w.c.g.hcRinv(w.c.r.s, w.c.pss, w.rinv, eps, w.c.rows, dims, nc, streams);
+    }
+
+    fn up(w: *Hcw, dn: u8, up_v: u8) !void {
