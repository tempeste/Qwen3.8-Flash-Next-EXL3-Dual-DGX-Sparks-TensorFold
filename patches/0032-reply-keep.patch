index 0000000000000000000000000000000000000000..7a00ba0f102aa23e9f95616c2efca1ab36cf7bdf
--- /dev/null
+++ b/zig/tests/cuda/flashnext_reply_keep_tests.zig
@@ -0,0 +1,338 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+const Session = flash.rank_engine.Session;
+
+const depth = mtp.default_depth;
+const row = prompt.vocabulary * 2;
+const lengths = [_]usize{ 700, 1300, 2100, 3000 };
+const tail = [_]u32{ 151645, 198, 151644, 872, 198, 151644, 77091, 198 };
+const user_tokens = 300;
+const greedy = 64;
+pub const least_context: usize = 262_144;
+
+const Rig = struct {
+    gpu: check.Gpu,
+    stream: cuda.Stream,
+    glue: flash.Glue,
+    session: ?*Session = null,
+    e: *prompt.Engine,
+    head: ?*mtp.Head = null,
+    out: cuda.DeviceBuffer,
+    host: []u8,
+    identity: flash.rank_engine.Identity,
+    rank: usize,
+    context: usize,
+
+    fn init(r: *Rig, gpu: check.Gpu, dir: []const u8, rank: usize, context: usize) !void {
+        r.gpu = gpu;
+        r.rank = rank;
+        r.context = context;
+        r.session = null;
+        r.head = null;
+        r.stream = try cuda.Stream.init(gpu.d, true);
+        errdefer r.stream.deinit();
+        r.glue = try flash.Glue.load(gpu.d);
+        errdefer r.glue.deinit();
+        const chunk = try flash.chunk_rows.soloRows(try flash.chunk_rows.chunkRowsAt(2));
+        r.identity = try flash.rank_engine.identity(gpu.gpa, gpu.io, dir, context, chunk);
+        r.identity.mtp = 1;
+        r.e = try prompt.Engine.initRank(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir, 2, rank);
+        errdefer r.e.deinit();
+        if (r.e.chunk != chunk) return error.EngineChunk;
+        _ = try r.e.reserve(@min(context, r.e.chunk));
+        r.out = try cuda.DeviceBuffer.alloc(gpu.d, mtp.max_rows * row);
+        errdefer r.out.free();
+        r.host = try gpu.gpa.alloc(u8, mtp.max_rows * row);
+        errdefer gpu.gpa.free(r.host);
+        if (rank == 0) r.head = try mtp.Head.init(gpu.gpa, gpu.io, @constCast(gpu.d), &r.stream, dir);
+    }
+
+    fn open(r: *Rig, port: u16) !void {
+        mtp.Draft.late_on = mtp.Draft.lateWanted() orelse true;
+        const s = try Session.init(r.gpu.gpa, r.gpu.io, @import("flashnext_rank_tests.zig").rankHost(), port, r.rank, r.identity, flash.rank_engine.linkWait());
+        errdefer {
+            s.poison();
+            s.deinit();
+        }
+        s.engine = r.e;
+        r.e.collective = &s.collective;
+        if (flash.knobs.tpRoce()) try s.collective.openRoce(r.gpu.gpa, r.gpu.io, r.gpu.d, true, try flash.knobs.tpRoceMaxBytes());
+        r.session = s;
+    }
+
+    fn close(r: *Rig) void {
+        if (r.session) |s| s.deinit();
+        r.session = null;
+        mtp.Draft.late_on = false;
+    }
+
+    fn deinit(r: *Rig) void {
+        r.close();
+        if (r.head) |h| h.deinit();
+        r.e.deinit();
+        r.gpu.gpa.free(r.host);
+        r.out.free();
+        r.glue.deinit();
+        r.stream.deinit();
+    }
+
+    fn tri(r: *Rig) flash.Tri {
+        return .{ .s = r.stream, .own = &r.glue };
+    }
+
+    fn ops(r: *Rig) mtp.Ops(flash.Tri) {
+        return .{ .e = r.e, .tri = r.tri(), .h = r.head.?, .main = .{ .ptr = r, .forward = forward, .verify = verify, .rollback = rollback, .rollback_many = rollbackMany } };
+    }
+
+    fn of(p: *anyopaque) *Rig {
+        return @ptrCast(@alignCast(p));
+    }
+    fn forward(p: *anyopaque, q: *prompt.Seq, ids: []const u32, hooks: prompt.batch.Hooks) anyerror!void {
+        const r = of(p);
+        return r.session.?.forward(flash.Tri, r.tri(), q, ids, hooks);
+    }
+    fn verify(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, ids: []const u32) anyerror!void {
+        const r = of(p);
+        return r.session.?.verify(flash.Tri, r.tri(), q, d, ids);
+    }
+    fn rollback(p: *anyopaque, q: *prompt.Seq, d: *mtp.Draft, keep: usize) anyerror!void {
+        const r = of(p);
+        return r.session.?.keep(flash.Tri, r.tri(), q, d, keep);
+    }
+    fn rollbackMany(p: *anyopaque, qs: []const *prompt.Seq, ds: []const *mtp.Draft, keeps: []const usize) anyerror!void {
+        const r = of(p);
+        return r.session.?.keepMany(flash.Tri, r.tri(), qs, ds, keeps);
+    }
+};
+
+const Lane = struct {
+    q: prompt.Seq,
+    d: mtp.Draft,
+
+    fn make(r: *Rig) !Lane {
+        const s = r.session.?;
+        var q = try s.create(r.context);
+        errdefer s.drop(&q);
+        const d = try mtp.Draft.init(r.gpu.gpa, r.e.driver, r.stream, r.context, r.head.?.ids.len, r.e.chunk, r.e.heads);
+        return .{ .q = q, .d = d };
+    }
+
+    fn free(l: *Lane, r: *Rig) void {
+        l.d.deinit();
+        r.session.?.drop(&l.q);
+    }
+};
+
+fn seedOf(gpu: check.Gpu, ids_path: []const u8) !std.ArrayList(u32) {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var seed: std.ArrayList(u32) = .empty;
+    errdefer seed.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try seed.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (seed.items.len < 16) return error.BadPrompt;
+    return seed;
+}
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+fn best(bytes: []const u8) u32 {
+    const v = std.mem.bytesAsSlice(u16, bytes);
+    var at: usize = 0;
+    var top = -std.math.inf(f32);
+    for (v, 0..) |x, i| {
+        const f = bf16(x);
+        if (f > top) {
+            top = f;
+            at = i;
+        }
+    }
+    return @intCast(at);
+}
+
+const Compare = struct { same: bool, max_abs: f64, kl: f64, top1: bool };
+
+fn compare(a: []const u8, b: []const u8) Compare {
+    const va = std.mem.bytesAsSlice(u16, a);
+    const vb = std.mem.bytesAsSlice(u16, b);
+    var ma: f64 = -std.math.inf(f64);
+    var mb: f64 = -std.math.inf(f64);
+    var max_abs: f64 = 0;
+    for (va, vb) |x, y| {
+        const fx: f64 = bf16(x);
+        const fy: f64 = bf16(y);
+        ma = @max(ma, fx);
+        mb = @max(mb, fy);
+        max_abs = @max(max_abs, @abs(fx - fy));
+    }
+    var za: f64 = 0;
+    var zb: f64 = 0;
+    for (va, vb) |x, y| {
+        za += @exp(@as(f64, bf16(x)) - ma);
+        zb += @exp(@as(f64, bf16(y)) - mb);
+    }
+    var kl: f64 = 0;
+    for (va, vb) |x, y| {
+        const la = @as(f64, bf16(x)) - ma - @log(za);
+        const lb = @as(f64, bf16(y)) - mb - @log(zb);
+        kl += @exp(lb) * (lb - la);
+    }
+    return .{ .same = std.mem.eql(u8, a, b), .max_abs = max_abs, .kl = @max(0, kl), .top1 = best(a) == best(b) };
+}
+
+fn readRest(r: *Rig, l: *Lane, ids: []const u32, from: usize) !void {
+    return readRange(r, l, ids, from, ids.len);
+}
+
+fn readRange(r: *Rig, l: *Lane, ids: []const u32, from: usize, to: usize) !void {
+    const ops = r.ops();
+    var at = from;
+    while (at < to) {
+        const stop = @min(to, at + @min(r.e.chunk, l.d.rows_cap));
+        try ops.prefillChunk(&l.q, &l.d, ids, at, stop);
+        at = stop;
+    }
+}
+
+fn decodeReply(r: *Rig, l: *Lane, p: []const u32, n: usize, reply: *std.ArrayList(u32)) !void {
+    const gpa = r.gpu.gpa;
+    const s = r.session.?;
+    const ops = r.ops();
+    try ops.prefill(&l.q, &l.d, p);
+    var follow: [mtp.max_rows]u32 = undefined;
+    follow[0] = best(l.q.logits[0..row]);
+    var nf: usize = 1;
+    try reply.append(gpa, follow[0]);
+    var chain: mtp.Chain = .{};
+    var fresh = true;
+    var window: [mtp.max_rows]u32 = undefined;
+    while (reply.items.len < n) {
+        const count = @min(depth, l.q.cap - l.q.fed - 1);
+        try ops.draft(&l.d, follow[0..nf], if (fresh) l.d.prompt_last else l.d.streams.ptr, l.q.fed + 1, count, null, mtp.default_confidence, &chain);
+        fresh = false;
+        window[0] = follow[nf - 1];
+        @memcpy(window[1..][0..chain.n], chain.slice());
+        const nw = 1 + chain.n;
+        var qs = [_]*prompt.Seq{&l.q};
+        var ds = [_]*mtp.Draft{&l.d};
+        const idss = [_][]const u32{window[0..nw]};
+        try s.verifyMany(flash.Tri, r.tri(), &qs, &ds, &idss, r.out.ptr);
+        try r.stream.synchronize();
+        const scores = r.host[0 .. nw * row];
+        try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoH_v2(scores.ptr, r.out.ptr, scores.len), "cuMemcpyDtoH");
+        var kept: usize = 0;
+        while (true) {
+            const g = best(scores[kept * row ..][0..row]);
+            follow[kept] = g;
+            kept += 1;
+            if (kept == nw or window[kept] != g) break;
+        }
+        kept = @min(kept, n - reply.items.len);
+        try reply.appendSlice(gpa, follow[0..kept]);
+        nf = kept;
+        var keeps = [_]usize{kept};
+        try s.keepMany(flash.Tri, r.tri(), &qs, &ds, &keeps);
+    }
+    const at = p.len + reply.items.len - 1;
+    if (l.q.fed != at) return error.ReplyPosition;
+    if (l.d.len -| l.d.drafted < at) try ops.absorb(&l.d, follow[0..nf], l.d.streams.ptr, false);
+    if (l.d.len -| l.d.drafted != at) return error.HeadBehind;
+    if (l.d.pending != 0) try ops.flushLate(&l.q, &l.d);
+}
+
+fn greedyRun(r: *Rig, l: *Lane, out: []u32) !void {
+    const s = r.session.?;
+    var t = best(l.q.logits[0..row]);
+    for (out) |*o| {
+        o.* = t;
+        var qs = [_]*prompt.Seq{&l.q};
+        try s.round(flash.Tri, r.tri(), &qs, &.{t}, r.out.ptr);
+        try r.stream.synchronize();
+        try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoH_v2(r.host.ptr, r.out.ptr, row), "cuMemcpyDtoH");
+        t = best(r.host[0..row]);
+    }
+}
+
+pub fn run(gpu: check.Gpu, dir: []const u8, rank: usize, port: u16, ids_path: []const u8, reply_len: usize, context: usize) !void {
+    if (context < least_context) return error.ContextUnder262144;
+    if (reply_len < 2 or reply_len > 2048) return error.BadReply;
+    var seed = try seedOf(gpu, ids_path);
+    defer seed.deinit(gpu.gpa);
+    var r: Rig = undefined;
+    try r.init(gpu, dir, rank, context);
+    defer r.deinit();
+    try r.open(port);
+    defer r.close();
+    const s = r.session.?;
+    if (rank == 1) {
+        try s.follow(flash.Tri, r.tri(), r.out.ptr);
+        check.pass("rank 1 followed every reply's decode, save, restore and both follow-up reads", .{});
+        return;
+    }
+    const gpa = gpu.gpa;
+    var same_logits: usize = 0;
+    var top1: usize = 0;
+    var greedy_same: usize = 0;
+    var kl_sum: f64 = 0;
+    var kl_max: f64 = 0;
+    var abs_max: f64 = 0;
+    var first_diff_sum: usize = 0;
+    var kept_bytes: u64 = 0;
+    for (lengths, 0..) |len, c| {
+        const p = try gpa.alloc(u32, len);
+        defer gpa.free(p);
+        for (p, 0..) |*t, j| t.* = seed.items[(c * 31 + j * 7) % seed.items.len];
+        var reply: std.ArrayList(u32) = .empty;
+        defer reply.deinit(gpa);
+        var live = try Lane.make(&r);
+        defer live.free(&r);
+        try decodeReply(&r, &live, p, reply_len, &reply);
+        const at = live.q.fed;
+        const snap = try s.save(&live.q, &live.d);
+        defer s.dropSaved(snap);
+        kept_bytes = @max(kept_bytes, snap.buf.len);
+        var follow_up: std.ArrayList(u32) = .empty;
+        defer follow_up.deinit(gpa);
+        try follow_up.appendSlice(gpa, p);
+        try follow_up.appendSlice(gpa, reply.items);
+        try follow_up.appendSlice(gpa, &tail);
+        for (0..user_tokens) |j| try follow_up.append(gpa, seed.items[(c * 17 + j * 13 + 5) % seed.items.len]);
+        const f = follow_up.items;
+        var kept = try Lane.make(&r);
+        defer kept.free(&r);
+        try s.restore(&kept.q, &kept.d, snap);
+        if (kept.q.fed != at or kept.d.len != at) return error.RestorePosition;
+        try readRest(&r, &kept, f, at);
+        try readRest(&r, &live, f, at);
+        try check.sameBytes("the live lane read on equals the kept state restored and read on", live.q.logits[0..row], kept.q.logits[0..row]);
+        var reread = try Lane.make(&r);
+        defer reread.free(&r);
+        reread.d.reset();
+        try readRange(&r, &reread, f, 0, p.len - 1);
+        try readRest(&r, &reread, f, p.len - 1);
+        const cmp = compare(kept.q.logits[0..row], reread.q.logits[0..row]);
+        var a: [greedy]u32 = undefined;
+        var b: [greedy]u32 = undefined;
+        try greedyRun(&r, &kept, &a);
+        try greedyRun(&r, &reread, &b);
+        const diff = std.mem.indexOfDiff(u32, &a, &b);
+        same_logits += @intFromBool(cmp.same);
+        top1 += @intFromBool(cmp.top1);
+        greedy_same += @intFromBool(diff == null);
+        first_diff_sum += diff orelse greedy;
+        kl_sum += cmp.kl;
+        kl_max = @max(kl_max, cmp.kl);
+        abs_max = @max(abs_max, cmp.max_abs);
+        std.debug.print("REPLY-KEEP conv={d} prompt={d} reply={d} at={d} follow_up={d} logits_equal={} max_abs={d:.5} kl={e:.3} top1={} greedy64_equal={} first_diff={?d} kept_mib={d:.1}\n", .{ c, p.len, reply.items.len, at, f.len, cmp.same, cmp.max_abs, cmp.kl, cmp.top1, diff == null, diff, @as(f64, @floatFromInt(snap.buf.len)) / (1 << 20) });
+    }
+    const n = lengths.len;
+    const verdict = if (same_logits == n and greedy_same == n) "exact" else "relaxed";
+    check.pass("{d} replies of {d} tokens: the kept decode state against the re-read: first-token logits byte-equal {d}/{d}, top-1 {d}/{d}, 64 greedy tokens equal {d}/{d}", .{ n, reply_len, same_logits, n, top1, n, greedy_same, n });
+    std.debug.print("BENCH reply-keep verdict={s} convs={d} reply={d} logits_equal={d} top1={d} greedy64_equal={d} kl_mean={e:.3} kl_max={e:.3} max_abs={d:.5} first_diff_mean={d:.1} kept_mib_max={d:.1}\n", .{ verdict, n, reply_len, same_logits, top1, greedy_same, kl_sum / @as(f64, @floatFromInt(n)), kl_max, abs_max, @as(f64, @floatFromInt(first_diff_sum)) / @as(f64, @floatFromInt(n)), @as(f64, @floatFromInt(kept_bytes)) / (1 << 20) });
+}
