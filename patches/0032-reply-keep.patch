diff --git a/zig/src/core/prompt_cache_reply.zig b/zig/src/core/prompt_cache_reply.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d537310a06566c3a4b121736a06a97fac35b047e
--- /dev/null
+++ b/zig/src/core/prompt_cache_reply.zig
@@ -0,0 +1,95 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+
+pub const Why = enum { prompt_open, position, drafts_open, head_behind, failed, image, refused };
+
+pub const tail_words: usize = 64;
+const ring_len = 64;
+
+pub const Kind = enum { evicted, unkept };
+pub const Gone = struct { born: u32 = 0, len: u32 = 0, tail: u64 = 0, why: Kind = .evicted, used: bool = false };
+
+pub const Reply = struct {
+    on: bool = false,
+    kept: u64 = 0,
+    kept_rows: u64 = 0,
+    hits: u64 = 0,
+    hit_rows: u64 = 0,
+    diverged: u64 = 0,
+    short: u64 = 0,
+    evicted: u64 = 0,
+    missed_evicted: u64 = 0,
+    missed_unkept: u64 = 0,
+    unkept: std.EnumArray(Why, u64) = .initFill(0),
+    ring: [ring_len]Gone = @splat(.{}),
+    next: usize = 0,
+};
+
+pub fn tailOf(tokens: []const u32, born: u32) u64 {
+    const from = born -| @as(u32, @intCast(tail_words));
+    return std.hash.Wyhash.hash(born, std.mem.sliceAsBytes(tokens[from..born]));
+}
+
+fn remember(r: *Reply, born: u32, len: u32, tail: u64, why: Kind) void {
+    r.ring[r.next] = .{ .born = born, .len = len, .tail = tail, .why = why, .used = true };
+    r.next = (r.next + 1) % ring_len;
+}
+
+pub fn kept(s: *pc.Store, e: *pc.Entry) void {
+    if (!e.reply) {
+        e.reply = true;
+        s.reply.kept += 1;
+        s.reply.kept_rows += e.at -| e.born;
+    }
+}
+
+pub fn unkept(s: *pc.Store, tokens: []const u32, born: u32, why: Why) void {
+    if (!s.reply.on) return;
+    s.reply.unkept.getPtr(why).* += 1;
+    if (born == 0 or born > tokens.len) return;
+    remember(&s.reply, born, @intCast(tokens.len), tailOf(tokens, born), .unkept);
+}
+
+pub fn evicted(s: *pc.Store, e: *const pc.Entry) void {
+    if (!s.reply.on or !e.reply) return;
+    s.reply.evicted += 1;
+    if (e.born == 0 or e.born > e.tokens.len) return;
+    remember(&s.reply, e.born, @intCast(e.tokens.len), tailOf(e.tokens, e.born), .evicted);
+}
+
+fn extendsBorn(prompt: []const u32, born: u32, tail: u64) bool {
+    return born < prompt.len and tailOf(prompt, born) == tail;
+}
+
+pub fn looked(s: *pc.Store, prompt: []const u32, found: ?*const pc.Entry) void {
+    if (!s.reply.on) return;
+    if (found) |e| if (e.reply) {
+        s.reply.hits += 1;
+        s.reply.hit_rows += e.at -| e.born;
+        return;
+    };
+    const from = if (found) |e| e.at else 0;
+    for (s.entries.items) |o| {
+        if (o.expired or !o.reply or o.at <= from or o.born == 0) continue;
+        if (!extendsBorn(prompt, o.born, tailOf(o.tokens, o.born))) continue;
+        if (prompt.len < o.tokens.len and std.mem.eql(u32, prompt[o.born..], o.tokens[o.born..prompt.len])) s.reply.short += 1 else s.reply.diverged += 1;
+        return;
+    }
+    for (&s.reply.ring) |*g| {
+        if (!g.used or g.len > prompt.len or !extendsBorn(prompt, g.born, g.tail)) continue;
+        if (from >= g.len -| 1) continue;
+        switch (g.why) {
+            .evicted => s.reply.missed_evicted += 1,
+            .unkept => s.reply.missed_unkept += 1,
+        }
+        g.used = false;
+        return;
+    }
+}
+
+pub fn report(s: *const pc.Store) void {
+    if (@import("builtin").is_test or !s.reply.on) return;
+    const r = &s.reply;
+    const u = &r.unkept;
+    std.log.info("prompt cache reply ends: kept {d} ({d} reply rows), hits {d} ({d} rows not read again); a later turn missed one: diverged {d}, shorter {d}, evicted {d} (of {d} evicted), not kept {d}; not kept: prompt open {d}, position {d}, drafts open {d}, head behind {d}, failed {d}, image {d}, refused {d}", .{ r.kept, r.kept_rows, r.hits, r.hit_rows, r.diverged, r.short, r.missed_evicted, r.evicted, r.missed_unkept, u.get(.prompt_open), u.get(.position), u.get(.drafts_open), u.get(.head_behind), u.get(.failed), u.get(.image), u.get(.refused) });
+}
diff --git a/zig/src/core/prompt_cache_reply_test.zig b/zig/src/core/prompt_cache_reply_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7dfe7c85d6470c7274e0a4b0376285172e277906
--- /dev/null
+++ b/zig/src/core/prompt_cache_reply_test.zig
@@ -0,0 +1,56 @@
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const reply = pc.reply;
+
+const Copies = struct {
+    live: usize = 0,
+    fn bytes(_: *anyopaque, at: u32) u64 {
+        return 16 + @as(u64, at);
+    }
+    fn save(p: *anyopaque, _: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const c: *Copies = @ptrCast(@alignCast(p));
+        c.live += 1;
+        return @ptrFromInt(0x1000 + @as(usize, at));
+    }
+    fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {}
+    fn drop(p: *anyopaque, _: pc.Saved) void {
+        const c: *Copies = @ptrCast(@alignCast(p));
+        c.live -= 1;
+    }
+};
+
+test "pcache reply: a lookup that resumes a reply end is a hit; one that extends its prompt but not its reply is counted once; a gone reply end's follow-up is counted by why it went" {
+    const gpa = std.testing.allocator;
+    var copies: Copies = .{};
+    var store = pc.Store.init(gpa, .{ .ptr = &copies, .vtable = &.{ .bytes = Copies.bytes, .save = Copies.save, .restore = Copies.restore, .drop = Copies.drop } }, .{ .lookahead = 1 }, 1 << 20);
+    defer store.deinit();
+    store.reply.on = true;
+    var words: [300]u32 = undefined;
+    for (&words, 0..) |*t, i| t.* = @intCast(i * 3 + 1);
+    const ended = words[0..131];
+    try std.testing.expect(store.keepBorn(ended, 100, 130, null, &.{}, &.{}));
+    reply.kept(&store, store.last_kept.?);
+    try std.testing.expectEqual(@as(u64, 30), store.reply.kept_rows);
+    const l = try store.lookup(gpa, words[0..200], 190, &.{}, &.{}, &.{});
+    defer gpa.free(l.marks);
+    try std.testing.expect(l.entry != null);
+    store.release(l.entry.?);
+    try std.testing.expectEqual(@as(u64, 1), store.reply.hits);
+    var other: [200]u32 = undefined;
+    @memcpy(other[0..110], words[0..110]);
+    for (other[110..], 0..) |*t, i| t.* = @intCast(900_000 + i);
+    const d = try store.lookup(gpa, &other, 190, &.{}, &.{}, &.{});
+    defer gpa.free(d.marks);
+    if (d.entry) |e| store.release(e);
+    try std.testing.expectEqual(@as(u64, 1), store.reply.diverged);
+    var third: [300]u32 = undefined;
+    for (&third, 0..) |*t, i| t.* = @intCast(500_000 + i * 5);
+    reply.unkept(&store, third[0..161], 140, .refused);
+    try std.testing.expectEqual(@as(u64, 1), store.reply.unkept.get(.refused));
+    for (0..2) |_| {
+        const g = try store.lookup(gpa, third[0..250], 240, &.{}, &.{}, &.{});
+        defer gpa.free(g.marks);
+        if (g.entry) |e| store.release(e);
+    }
+    try std.testing.expectEqual(@as(u64, 1), store.reply.missed_unkept);
+}
