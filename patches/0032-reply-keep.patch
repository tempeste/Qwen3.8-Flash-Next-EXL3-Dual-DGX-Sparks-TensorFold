diff --git a/zig/src/core/lane_host_reply.zig b/zig/src/core/lane_host_reply.zig
new file mode 100644
index 0000000000000000000000000000000000000000..39d84369f42eef792218c8aa4f155cca2ec11e97
--- /dev/null
+++ b/zig/src/core/lane_host_reply.zig
@@ -0,0 +1,62 @@
+const std = @import("std");
+const lanes = @import("lanes");
+const pc = @import("prompt_cache.zig");
+const modes = @import("cache_modes.zig");
+const LaneHost = @import("lane_host.zig").LaneHost;
+const Job = LaneHost.Job;
+const be = lanes.backend.Backend;
+
+pub fn install(h: *LaneHost) void {
+    const store = h.cache orelse return;
+    if (!h.core.backend.reply_keep or h.core.backend.vtable.reply_end == null) return;
+    store.reply.on = true;
+    h.core.reply = .{ .ctx = h, .kept = kept };
+    std.log.info("prompt cache: a finished reply keeps its state for the turn that extends it (TF_FLASHNEXT_REPLY_KEEP)", .{});
+}
+
+fn jobOf(h: *LaneHost, s: *lanes.Stream) ?*Job {
+    for (h.admitted.items) |j| if (&j.stream == s) return j;
+    return null;
+}
+
+fn why(m: be.ReplyMiss) ?pc.reply.Why {
+    return switch (m) {
+        .off => null,
+        .prompt_open => .prompt_open,
+        .position => .position,
+        .drafts_open => .drafts_open,
+        .head_behind => .head_behind,
+        .failed => .failed,
+    };
+}
+
+pub fn kept(ctx: *anyopaque, s: *lanes.Stream) void {
+    const h: *LaneHost = @ptrCast(@alignCast(ctx));
+    const store = h.cache orelse return;
+    const end = h.core.backend.vtable.reply_end orelse return;
+    const job = jobOf(h, s) orelse return;
+    keepEnd(h, store, job, s, end);
+}
+
+pub fn keepEnd(h: *LaneHost, store: *pc.Store, job: *Job, s: *lanes.Stream, end: *const fn (*anyopaque, *lanes.Stream) be.ReplyEnd) void {
+    const r = job.request;
+    const key = job.cacheKey();
+    const prompt = s.prompt_len;
+    const tokens = s.context.items;
+    if (r.untaught or tokens.len <= prompt) return;
+    if (r.images.len > 0 or key.len != prompt) return pc.reply.unkept(store, tokens, r.bornLen(), .image);
+    const at = switch (end(h.core.backend.ptr, s)) {
+        .miss => |m| return if (why(m)) |w| pc.reply.unkept(store, tokens, r.bornLen(), w),
+        .at => |a| a,
+    };
+    if (@as(usize, at) + 1 != tokens.len or at < prompt or store.rules.lookahead > 1) return pc.reply.unkept(store, tokens, r.bornLen(), .position);
+    const words = h.gpa.alloc(u32, at + store.rules.lookahead) catch return pc.reply.unkept(store, tokens, r.bornLen(), .failed);
+    defer h.gpa.free(words);
+    @memcpy(words[0..prompt], key);
+    @memcpy(words[prompt..], tokens[prompt..words.len]);
+    const spans = if (h.decoded_rows) modes.reply(h.gpa, r.decode_spans, @intCast(prompt), at) catch return pc.reply.unkept(store, tokens, r.bornLen(), .failed) else &.{};
+    defer if (h.decoded_rows) h.gpa.free(spans);
+    job.reported();
+    if (!store.keepBornFrame(words, r.bornLen(), at, s, r.chunks, spans, r.images, job.frame)) return pc.reply.unkept(store, tokens, r.bornLen(), .refused);
+    if (store.last_kept) |e| pc.reply.kept(store, e);
+}
diff --git a/zig/src/core/lane_host_reply_test.zig b/zig/src/core/lane_host_reply_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..811acc4a149f4ffe1157a18aa693c5ffecd6891b
--- /dev/null
+++ b/zig/src/core/lane_host_reply_test.zig
@@ -0,0 +1,307 @@
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const pc = @import("prompt_cache.zig");
+const LaneHost = api.LaneHost;
+const Id = api.Id;
+const Event = api.Event;
+const Request = api.Request;
+const Reason = api.Reason;
+const gpa = std.testing.allocator;
+
+const Snaps = struct {
+    fn bytes(_: *anyopaque, at: u32) u64 {
+        return 64 + 4 * @as(u64, at);
+    }
+    fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        return f.save(@ptrCast(@alignCast(owner.?)), at);
+    }
+    fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+        return error.BackendRestores;
+    }
+    fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        f.drop(saved);
+    }
+};
+
+const Box = struct {
+    mutex: std.Io.Mutex = .init,
+    tokens: std.ArrayList(u32) = .empty,
+    cached: ?u32 = null,
+    done: ?Reason = null,
+    fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+        const b: *@This() = @ptrCast(@alignCast(ctx));
+        b.mutex.lockUncancelable(std.testing.io);
+        defer b.mutex.unlock(std.testing.io);
+        switch (e.*) {
+            .prefilled => |c| b.cached = c,
+            .logprobs, .prompt_logprobs, .audio => {},
+            .tokens => |t| b.tokens.appendSlice(gpa, t) catch {},
+            .finished => |f| b.done = f.reason,
+        }
+    }
+    fn wait(b: *@This()) Reason {
+        while (true) {
+            b.mutex.lockUncancelable(std.testing.io);
+            const d = b.done;
+            b.mutex.unlock(std.testing.io);
+            if (d) |r| return r;
+            std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+    }
+};
+
+const Rig = struct {
+    cfg: lanes.Config,
+    target: lanes.fake.Fake,
+    clock: lanes.fake.FixedClock = .{},
+    core: lanes.Engine,
+    store: pc.Store,
+    host: LaneHost,
+    next_id: Id = 1,
+
+    fn init(r: *Rig, on: bool, budget: u64, streams: u32) !void {
+        r.cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = false, .hidden_rows = true }, 8, 7);
+        r.target = .{ .gpa = gpa };
+        r.clock = .{};
+        r.core = lanes.Engine.init(gpa, &r.cfg, if (on) r.target.replying() else r.target.backend(), r.clock.clock());
+        r.store = pc.Store.init(gpa, .{ .ptr = &r.target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, budget);
+        r.host = LaneHost.init(gpa, std.testing.io, &r.core, .{ .lanes = streams });
+        r.host.cache = &r.store;
+        r.next_id = 1;
+        try r.host.start();
+    }
+
+    fn deinit(r: *Rig) void {
+        r.host.stop();
+        r.store.deinit();
+        r.core.deinit();
+        r.target.deinit();
+        r.cfg.deinit(gpa);
+    }
+
+    fn turn(r: *Rig, prompt: []const u32, max_tokens: u32, b: *Box) !Reason {
+        const req = try gpa.create(Request);
+        defer gpa.destroy(req);
+        req.* = .{ .prompt = prompt, .max_tokens = max_tokens, .history_len = @intCast(prompt.len - 2) };
+        const id = r.next_id;
+        r.next_id += 1;
+        try r.host.engine().submit(id, req, .{ .ctx = b, .event = Box.event });
+        return b.wait();
+    }
+};
+
+fn replyOf(history: []const u32, n: usize, out: *std.ArrayList(u32)) !void {
+    var h: std.ArrayList(u32) = .empty;
+    defer h.deinit(gpa);
+    try h.appendSlice(gpa, history);
+    for (0..n) |_| {
+        const t = lanes.fake.next(h.items, null, h.items.len);
+        try h.append(gpa, t);
+        try out.append(gpa, t);
+    }
+}
+
+fn expectReplies(prompt: []const u32, got: []const u32) !void {
+    var want: std.ArrayList(u32) = .empty;
+    defer want.deinit(gpa);
+    try replyOf(prompt, got.len, &want);
+    try std.testing.expectEqualSlices(u32, want.items, got);
+}
+
+fn conversation(c: u32, len: usize, out: []u32) []u32 {
+    for (out[0..len], 0..) |*t, i| t.* = c * 1000 + @as(u32, @intCast((i * 7 + 3) % 97));
+    return out[0..len];
+}
+
+fn followUp(prompt: []const u32, reply: []const u32, tail: []const u32, out: *std.ArrayList(u32)) !void {
+    try out.appendSlice(gpa, prompt);
+    try out.appendSlice(gpa, reply);
+    try out.appendSlice(gpa, tail);
+}
+
+const template_tail = [_]u32{ 151645, 198, 151644, 872, 198, 41, 42, 43 };
+
+test "pcache reply: a follow-up whose prompt extends prompt and reply resumes past the reply, through the template tail, with the tokens a full read gives" {
+    var r: Rig = undefined;
+    try r.init(true, 1 << 20, 2);
+    defer r.deinit();
+    var buf: [40]u32 = undefined;
+    const t1 = conversation(1, 20, &buf);
+    var b1: Box = .{};
+    defer b1.tokens.deinit(gpa);
+    try std.testing.expectEqual(Reason.length, try r.turn(t1, 6, &b1));
+    try expectReplies(t1, b1.tokens.items);
+    try std.testing.expect(r.store.reply.on);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.kept);
+    try std.testing.expectEqual(@as(u64, 5), r.store.reply.kept_rows);
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try followUp(t1, b1.tokens.items, &template_tail, &t2);
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    try std.testing.expectEqual(Reason.length, try r.turn(t2.items, 8, &b2));
+    try std.testing.expectEqual(@as(?u32, 20 + 6 - 1), b2.cached);
+    try expectReplies(t2.items, b2.tokens.items);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.hits);
+    try std.testing.expectEqual(@as(u64, 5), r.store.reply.hit_rows);
+    try std.testing.expectEqual(@as(u64, 2), r.store.reply.kept);
+}
+
+test "pcache reply: flag off keeps no reply end and resumes at the prompt's history, as before" {
+    var r: Rig = undefined;
+    try r.init(false, 1 << 20, 2);
+    defer r.deinit();
+    var buf: [40]u32 = undefined;
+    const t1 = conversation(1, 20, &buf);
+    var b1: Box = .{};
+    defer b1.tokens.deinit(gpa);
+    _ = try r.turn(t1, 6, &b1);
+    try std.testing.expect(!r.store.reply.on);
+    try std.testing.expectEqual(@as(usize, 1), r.store.entries.items.len);
+    try std.testing.expectEqual(@as(usize, 0), r.target.reply_ends);
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try followUp(t1, b1.tokens.items, &template_tail, &t2);
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    _ = try r.turn(t2.items, 8, &b2);
+    try std.testing.expectEqual(@as(?u32, 18), b2.cached);
+    try expectReplies(t2.items, b2.tokens.items);
+    try std.testing.expectEqual(@as(u64, 0), r.store.reply.hits);
+}
+
+test "pcache reply: a follow-up whose reply differs (a re-serialized tool call) or stops inside it resumes at the prompt's history, counted diverged or shorter" {
+    var r: Rig = undefined;
+    try r.init(true, 1 << 20, 2);
+    defer r.deinit();
+    var buf: [40]u32 = undefined;
+    const t1 = conversation(2, 24, &buf);
+    var b1: Box = .{};
+    defer b1.tokens.deinit(gpa);
+    _ = try r.turn(t1, 6, &b1);
+    var changed = try gpa.dupe(u32, b1.tokens.items);
+    defer gpa.free(changed);
+    changed[3] +%= 1;
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try followUp(t1, changed, &template_tail, &t2);
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    _ = try r.turn(t2.items, 4, &b2);
+    try std.testing.expectEqual(@as(?u32, 22), b2.cached);
+    try expectReplies(t2.items, b2.tokens.items);
+    try std.testing.expectEqual(@as(u64, 0), r.store.reply.hits);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.diverged);
+    var t3: std.ArrayList(u32) = .empty;
+    defer t3.deinit(gpa);
+    try followUp(t1, b1.tokens.items[0..2], &.{}, &t3);
+    var b3: Box = .{};
+    defer b3.tokens.deinit(gpa);
+    _ = try r.turn(t3.items, 3, &b3);
+    try expectReplies(t3.items, b3.tokens.items);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.short);
+}
+
+test "pcache reply: a lane whose drafts were not settled keeps nothing for the reply, and its follow-up counts the miss as not kept" {
+    var r: Rig = undefined;
+    try r.init(true, 1 << 20, 2);
+    defer r.deinit();
+    r.target.reply_miss = .drafts_open;
+    var buf: [40]u32 = undefined;
+    const t1 = conversation(3, 20, &buf);
+    var b1: Box = .{};
+    defer b1.tokens.deinit(gpa);
+    _ = try r.turn(t1, 6, &b1);
+    try std.testing.expectEqual(@as(u64, 0), r.store.reply.kept);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.unkept.get(.drafts_open));
+    try std.testing.expectEqual(@as(usize, 1), r.store.entries.items.len);
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try followUp(t1, b1.tokens.items, &template_tail, &t2);
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    _ = try r.turn(t2.items, 4, &b2);
+    try std.testing.expectEqual(@as(?u32, 18), b2.cached);
+    try expectReplies(t2.items, b2.tokens.items);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.missed_unkept);
+}
+
+test "pcache reply: the kept state outlives its lane: another conversation reuses the lane before the follow-up resumes past the reply" {
+    var r: Rig = undefined;
+    try r.init(true, 1 << 20, 1);
+    defer r.deinit();
+    var buf_a: [40]u32 = undefined;
+    var buf_b: [40]u32 = undefined;
+    const a = conversation(4, 20, &buf_a);
+    const b = conversation(5, 30, &buf_b);
+    var ba: Box = .{};
+    defer ba.tokens.deinit(gpa);
+    _ = try r.turn(a, 6, &ba);
+    var bb: Box = .{};
+    defer bb.tokens.deinit(gpa);
+    _ = try r.turn(b, 9, &bb);
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try followUp(a, ba.tokens.items, &template_tail, &t2);
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    _ = try r.turn(t2.items, 5, &b2);
+    try std.testing.expectEqual(@as(?u32, 25), b2.cached);
+    try expectReplies(t2.items, b2.tokens.items);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.hits);
+}
+
+test "pcache reply: under memory pressure the budget evicts reply ends like any state, and the follow-up of an evicted one counts it and reads the reply again" {
+    var r: Rig = undefined;
+    try r.init(true, 3 * (64 + 4 * 40), 2);
+    defer r.deinit();
+    var bufs: [4][40]u32 = undefined;
+    var replies: [4]Box = @splat(.{});
+    defer for (&replies) |*x| x.tokens.deinit(gpa);
+    var prompts: [4][]u32 = undefined;
+    for (0..4) |c| {
+        prompts[c] = conversation(@intCast(10 + c), 24, &bufs[c]);
+        _ = try r.turn(prompts[c], 6, &replies[c]);
+    }
+    try std.testing.expect(r.store.reply.evicted > 0);
+    try std.testing.expect(r.store.held <= r.store.budget);
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try followUp(prompts[0], replies[0].tokens.items, &template_tail, &t2);
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    _ = try r.turn(t2.items, 4, &b2);
+    try expectReplies(t2.items, b2.tokens.items);
+    try std.testing.expectEqual(@as(u64, 0), r.store.reply.hits);
+    try std.testing.expectEqual(@as(u64, 1), r.store.reply.missed_evicted);
