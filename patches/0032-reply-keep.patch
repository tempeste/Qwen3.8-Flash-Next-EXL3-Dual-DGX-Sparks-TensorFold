index 0000000000000000000000000000000000000000..137f07601d929498934c66eee9f95faf85137504
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_reply_end.zig
@@ -0,0 +1,54 @@
+const std = @import("std");
+const lanes = @import("lanes");
+const Miss = lanes.backend.Backend.ReplyMiss;
+
+pub const Draft = struct { open: bool, fed0: usize, rows: usize, len: usize, drafted: usize };
+pub const Lane = struct { prompt_open: bool, fed: usize, cache_len: u64, context: usize, draft: ?Draft = null };
+pub const At = struct { at: u32, roll: usize = 0, absorb: usize = 0 };
+pub const Step = union(enum) { miss: Miss, at: At };
+
+pub fn plan(l: Lane) Step {
+    if (l.prompt_open) return .{ .miss = .prompt_open };
+    const at = l.cache_len;
+    if (at == 0 or at > std.math.maxInt(u32) or l.context != at + 1) return .{ .miss = .position };
+    const d = l.draft orelse return if (l.fed == at) .{ .at = .{ .at = @intCast(at) } } else .{ .miss = .position };
+    var out: At = .{ .at = @intCast(at) };
+    if (d.open) {
+        if (at <= d.fed0 or at - d.fed0 > d.rows) return .{ .miss = .drafts_open };
+        out.roll = @intCast(at - d.fed0);
+    } else if (l.fed != at) return .{ .miss = .position };
+    const head = d.len -| d.drafted;
+    if (head == at) return .{ .at = out };
+    if (head > at) return .{ .miss = .position };
+    if (head != d.fed0 or at - head > d.rows) return .{ .miss = .head_behind };
+    out.absorb = @intCast(at - head);
+    return .{ .at = out };
+}
+
+test "a reply's lane: settled at its last fed row, its open window rolled back to the kept rows, its head brought up from the window's rows" {
+    try std.testing.expectEqual(Step{ .miss = .prompt_open }, plan(.{ .prompt_open = true, .fed = 10, .cache_len = 10, .context = 11 }));
+    try std.testing.expectEqual(Step{ .at = .{ .at = 10 } }, plan(.{ .prompt_open = false, .fed = 10, .cache_len = 10, .context = 11 }));
+    try std.testing.expectEqual(Step{ .miss = .position }, plan(.{ .prompt_open = false, .fed = 10, .cache_len = 10, .context = 12 }));
+    try std.testing.expectEqual(Step{ .miss = .position }, plan(.{ .prompt_open = false, .fed = 9, .cache_len = 10, .context = 11 }));
+    try std.testing.expectEqual(Step{ .miss = .position }, plan(.{ .prompt_open = false, .fed = 0, .cache_len = 0, .context = 1 }));
+    const settled: Draft = .{ .open = false, .fed0 = 7, .rows = 4, .len = 10, .drafted = 0 };
+    try std.testing.expectEqual(Step{ .at = .{ .at = 10 } }, plan(.{ .prompt_open = false, .fed = 10, .cache_len = 10, .context = 11, .draft = settled }));
+    var chained = settled;
+    chained.len = 13;
+    chained.drafted = 3;
+    try std.testing.expectEqual(Step{ .at = .{ .at = 10 } }, plan(.{ .prompt_open = false, .fed = 10, .cache_len = 10, .context = 11, .draft = chained }));
+    const open: Draft = .{ .open = true, .fed0 = 7, .rows = 6, .len = 7, .drafted = 0 };
+    try std.testing.expectEqual(Step{ .at = .{ .at = 10, .roll = 3, .absorb = 3 } }, plan(.{ .prompt_open = false, .fed = 13, .cache_len = 10, .context = 11, .draft = open }));
+    var past = open;
+    past.rows = 2;
+    try std.testing.expectEqual(Step{ .miss = .drafts_open }, plan(.{ .prompt_open = false, .fed = 9, .cache_len = 10, .context = 11, .draft = past }));
+    var behind = settled;
+    behind.len = 5;
+    try std.testing.expectEqual(Step{ .miss = .head_behind }, plan(.{ .prompt_open = false, .fed = 10, .cache_len = 10, .context = 11, .draft = behind }));
+    var kept_rows = settled;
+    kept_rows.len = 7;
+    try std.testing.expectEqual(Step{ .at = .{ .at = 10, .absorb = 3 } }, plan(.{ .prompt_open = false, .fed = 10, .cache_len = 10, .context = 11, .draft = kept_rows }));
+    var ahead = settled;
+    ahead.len = 12;
+    try std.testing.expectEqual(Step{ .miss = .position }, plan(.{ .prompt_open = false, .fed = 10, .cache_len = 10, .context = 11, .draft = ahead }));
+}
